# Build output
dist/
.output/
.astro/
.cache/

# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---------------------------------------------------------------------------
# Environment variables
#
# `.env.*` is a catch-all: it covers .env.local, .env.production, .env.staging,
# .env.development, .env.backup*, and any future variant. The single negation
# below re-includes the tracked public template.
#
# Keep `!.env.example` AFTER `.env.*`, and do not add any later rule that
# matches `.env.example` — a negation cannot be re-negated by a later pattern.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Credential material must never be committed.
# Google / OAuth service-account and client-secret files
*service-account*.json
*service_account*.json
*credential*.json
credentials.json
client_secret*.json
client-secret*.json
*-key.json
*_key.json

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
private.key
id_rsa
id_ed25519

# Local provider / deployment state
.gcloud/
.firebase/

# Database migrations (optional - you might want to keep these)
drizzle/

# macOS-specific files
.DS_Store

# IDE files
.idea/
.vscode/

# Temporary user creation scripts
create-user*.mjs
create-user*.js

# OS files
Thumbs.db
.vercel
# `*.env` catches files that END in .env (e.g. prod.env); the .env.* rule above
# catches files that START with .env. Both are needed.
*.env
usrad-medicare-pricing/
check-structure.cjs
node
*.backup
*.docx
logo-sizing-context-report-astro.md
.venv/

# scratch (do not commit)
# Note: .env.backup* variants are covered by the `.env.*` rule above.
supabase/.temp/
