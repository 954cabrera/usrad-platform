<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>USRad - MRI Scans in 48 Hours, 70% Less</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .hero-gradient {
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        }

        .text-gradient {
            background: linear-gradient(135deg, #003087 0%, #002266 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hover-lift {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .hover-lift:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px -10px rgba(0, 48, 135, 0.15);
        }

        .smooth-scroll {
            scroll-behavior: smooth;
        }
    </style>
</head>

<body class="antialiased text-gray-900 smooth-scroll">
    <!-- Simple Header - Carbon Health Style -->
    <header class="fixed top-0 w-full bg-white/95 backdrop-blur-sm z-50 border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex items-center">
                    <span class="text-2xl font-bold text-[#003087]">USRad</span>
                    <span class="ml-2 text-xs bg-[#cc9933] text-white px-2 py-1 rounded-full font-medium">BETA</span>
                </div>

                <!-- Simple Nav -->
                <nav class="hidden md:flex items-center space-x-8">
                    <a href="#how" class="text-sm font-medium text-gray-700 hover:text-[#003087] transition">How it
                        works</a>
                    <a href="#pricing"
                        class="text-sm font-medium text-gray-700 hover:text-[#003087] transition">Pricing</a>
                    <a href="#locations"
                        class="text-sm font-medium text-gray-700 hover:text-[#003087] transition">Locations</a>
                    <a href="#about" class="text-sm font-medium text-gray-700 hover:text-[#003087] transition">About</a>
                </nav>

                <!-- CTA -->
                <div class="flex items-center space-x-4">
                    <button class="hidden sm:block text-sm font-medium text-[#003087] hover:text-[#002266] transition">
                        Sign in
                    </button>
                    <button
                        class="bg-[#003087] text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-[#002266] transition">
                        Book scan
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Hero Section - Ultra Clean -->
    <section class="pt-24 pb-16 px-4 sm:px-6 hero-gradient">
        <div class="max-w-7xl mx-auto">
            <div class="max-w-3xl mx-auto text-center">
                <!-- Trust Badge -->
                <div
                    class="inline-flex items-center gap-2 bg-green-50 border border-green-200 rounded-full px-4 py-2 mb-8">
                    <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
                    <span class="text-sm font-medium text-green-700">Appointments available tomorrow</span>
                </div>

                <!-- Main Headline -->
                <h1 class="text-5xl sm:text-6xl font-bold mb-6 leading-tight">
                    Get your MRI in
                    <span class="text-gradient">48 hours</span>,
                    not 6 weeks
                </h1>

                <!-- Subheadline -->
                <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
                    Same board-certified radiologists. Same quality imaging.
                    <span class="font-semibold text-gray-900">70% less than hospitals.</span>
                </p>

                <!-- Search Form - Simplified -->
                <div class="bg-white rounded-2xl shadow-lg p-2 max-w-xl mx-auto mb-6">
                    <div class="flex flex-col sm:flex-row gap-2">
                        <input type="text" placeholder="Enter your ZIP code"
                            class="flex-1 px-4 py-3 rounded-lg text-gray-900 placeholder-gray-500 focus:outline-none" />
                        <button
                            class="bg-[#003087] text-white px-6 py-3 rounded-lg font-medium hover:bg-[#002266] transition whitespace-nowrap">
                            Check prices →
                        </button>
                    </div>
                </div>

                <!-- Trust Indicators -->
                <div class="flex flex-wrap justify-center gap-6 text-sm text-gray-600">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd" />
                        </svg>
                        <span>No insurance required</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd" />
                        </svg>
                        <span>Upfront pricing</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd" />
                        </svg>
                        <span>1,500+ locations</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Social Proof Bar -->
    <section class="bg-gray-50 py-8 px-4 sm:px-6 border-y border-gray-100">
        <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
                <div>
                    <div class="text-2xl font-bold text-[#003087]">400K+</div>
                    <div class="text-sm text-gray-600">Patients served</div>
                </div>
                <div>
                    <div class="text-2xl font-bold text-[#003087]">$400M+</div>
                    <div class="text-sm text-gray-600">Saved for patients</div>
                </div>
                <div>
                    <div class="text-2xl font-bold text-[#003087]">48hr</div>
                    <div class="text-sm text-gray-600">Average wait time</div>
                </div>
                <div>
                    <div class="text-2xl font-bold text-[#003087]">4.9★</div>
                    <div class="text-sm text-gray-600">Patient rating</div>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works - Simple 3 Steps -->
    <section id="how" class="py-20 px-4 sm:px-6 bg-white">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl sm:text-4xl font-bold mb-4">Healthcare made simple</h2>
                <p class="text-xl text-gray-600">Book your scan in under 2 minutes</p>
            </div>

            <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
                <!-- Step 1 -->
                <div class="text-center">
                    <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <span class="text-2xl font-bold text-[#003087]">1</span>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">Compare prices</h3>
                    <p class="text-gray-600">See upfront costs from quality centers near you. No hidden fees.</p>
                </div>

                <!-- Step 2 -->
                <div class="text-center">
                    <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <span class="text-2xl font-bold text-[#003087]">2</span>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">Book instantly</h3>
                    <p class="text-gray-600">Choose your time and location. Most appointments within 48 hours.</p>
                </div>

                <!-- Step 3 -->
                <div class="text-center">
                    <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <span class="text-2xl font-bold text-[#003087]">3</span>
                    </div>
                    <h3 class="text-lg font-semibold mb-2">Get results fast</h3>
                    <p class="text-gray-600">Board-certified radiologists review your scan. Results in 24-48 hours.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing Section - Transparent -->
    <section id="pricing" class="py-20 px-4 sm:px-6 bg-gray-50">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl sm:text-4xl font-bold mb-4">Clear, upfront pricing</h2>
                <p class="text-xl text-gray-600">No insurance? No problem. Save up to 70% vs hospital prices.</p>
            </div>

            <!-- Price Comparison -->
            <div class="max-w-4xl mx-auto">
                <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
                    <div class="grid md:grid-cols-2 divide-x divide-gray-100">
                        <!-- Hospital Price -->
                        <div class="p-8">
                            <div class="text-center">
                                <p class="text-sm font-medium text-gray-500 mb-2">Hospital price</p>
                                <p class="text-4xl font-bold text-gray-400 line-through mb-4">$3,200</p>
                                <div class="space-y-2 text-sm text-gray-500">
                                    <div class="flex items-center justify-center gap-2">
                                        <span class="text-red-500">✕</span>
                                        <span>6-8 week wait</span>
                                    </div>
                                    <div class="flex items-center justify-center gap-2">
                                        <span class="text-red-500">✕</span>
                                        <span>Surprise bills</span>
                                    </div>
                                    <div class="flex items-center justify-center gap-2">
                                        <span class="text-red-500">✕</span>
                                        <span>Insurance hassles</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- USRad Price -->
                        <div class="p-8 bg-blue-50/30">
                            <div class="text-center">
                                <p class="text-sm font-medium text-[#cc9933] mb-2">USRad price</p>
                                <p class="text-4xl font-bold text-[#003087] mb-4">$475</p>
                                <div class="space-y-2 text-sm text-gray-700">
                                    <div class="flex items-center justify-center gap-2">
                                        <span class="text-green-500">✓</span>
                                        <span>48 hour booking</span>
                                    </div>
                                    <div class="flex items-center justify-center gap-2">
                                        <span class="text-green-500">✓</span>
                                        <span>Price guaranteed</span>
                                    </div>
                                    <div class="flex items-center justify-center gap-2">
                                        <span class="text-green-500">✓</span>
                                        <span>No insurance needed</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CTA -->
                    <div class="bg-gray-50 px-8 py-6 text-center">
                        <button
                            class="bg-[#003087] text-white px-8 py-3 rounded-lg font-medium hover:bg-[#002266] transition">
                            See prices in your area →
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Locations Map - Simple -->
    <section id="locations" class="py-20 px-4 sm:px-6 bg-white">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-12">
                <h2 class="text-3xl sm:text-4xl font-bold mb-4">1,500+ locations nationwide</h2>
                <p class="text-xl text-gray-600">Quality imaging centers competing for your business</p>
            </div>

            <!-- Simple Map Placeholder -->
            <div class="max-w-5xl mx-auto">
                <div class="bg-gray-100 rounded-2xl h-96 flex items-center justify-center relative overflow-hidden">
                    <!-- Simplified map visualization -->
                    <div class="absolute inset-0 opacity-10">
                        <img src="/api/placeholder/1200/600" alt="US Map" class="w-full h-full object-cover" />
                    </div>
                    <div class="relative text-center">
                        <p class="text-6xl mb-4">🗺️</p>
                        <p class="text-xl font-semibold text-gray-700">Available in all 50 states</p>
                        <button class="mt-4 text-[#003087] font-medium hover:underline">
                            Find centers near you →
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About/Trust Section -->
    <section id="about" class="py-20 px-4 sm:px-6 bg-gray-50">
        <div class="max-w-7xl mx-auto">
            <div class="max-w-3xl mx-auto text-center">
                <h2 class="text-3xl sm:text-4xl font-bold mb-6">Built by healthcare pioneers</h2>
                <p class="text-xl text-gray-600 mb-8">
                    We created America's first managed care imaging network, serving 400,000+ patients and saving
                    $400M+.
                    Now we're using that proven model to fix healthcare pricing for everyone.
                </p>

                <!-- Credentials -->
                <div class="grid sm:grid-cols-3 gap-6 mb-12">
                    <div class="bg-white rounded-xl p-6 hover-lift">
                        <div class="text-3xl mb-3">🏥</div>
                        <h3 class="font-semibold mb-2">Medical excellence</h3>
                        <p class="text-sm text-gray-600">All centers meet strict quality standards</p>
                    </div>
                    <div class="bg-white rounded-xl p-6 hover-lift">
                        <div class="text-3xl mb-3">🛡️</div>
                        <h3 class="font-semibold mb-2">Price protection</h3>
                        <p class="text-sm text-gray-600">What you see is what you pay, guaranteed</p>
                    </div>
                    <div class="bg-white rounded-xl p-6 hover-lift">
                        <div class="text-3xl mb-3">⚡</div>
                        <h3 class="font-semibold mb-2">Fast results</h3>
                        <p class="text-sm text-gray-600">24-48 hour turnaround from expert radiologists</p>
                    </div>
                </div>

                <button class="bg-[#003087] text-white px-8 py-3 rounded-lg font-medium hover:bg-[#002266] transition">
                    Read our story →
                </button>
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section class="py-20 px-4 sm:px-6 bg-[#003087] text-white">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl sm:text-4xl font-bold mb-6">Stop overpaying for medical imaging</h2>
            <p class="text-xl mb-8 opacity-90">
                Join thousands getting the same quality care for 70% less
            </p>
            <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-2 max-w-md mx-auto">
                <div class="flex flex-col sm:flex-row gap-2">
                    <input type="text" placeholder="Enter your ZIP code"
                        class="flex-1 px-4 py-3 rounded-lg text-gray-900 placeholder-gray-500 focus:outline-none" />
                    <button
                        class="bg-white text-[#003087] px-6 py-3 rounded-lg font-medium hover:bg-gray-100 transition whitespace-nowrap">
                        Get started →
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Simple Footer -->
    <footer class="bg-white py-12 px-4 sm:px-6 border-t border-gray-100">
        <div class="max-w-7xl mx-auto">
            <div class="grid md:grid-cols-4 gap-8 mb-8">
                <!-- Logo/Mission -->
                <div>
                    <span class="text-2xl font-bold text-[#003087]">USRad</span>
                    <p class="mt-2 text-sm text-gray-600">
                        Making medical imaging affordable and accessible for everyone.
                    </p>
                </div>

                <!-- Links -->
                <div>
                    <h4 class="font-semibold mb-3">Product</h4>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li><a href="#" class="hover:text-[#003087] transition">How it works</a></li>
                        <li><a href="#" class="hover:text-[#003087] transition">Pricing</a></li>
                        <li><a href="#" class="hover:text-[#003087] transition">Locations</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="font-semibold mb-3">Company</h4>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li><a href="#" class="hover:text-[#003087] transition">About</a></li>
                        <li><a href="#" class="hover:text-[#003087] transition">Blog</a></li>
                        <li><a href="#" class="hover:text-[#003087] transition">Careers</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="font-semibold mb-3">Support</h4>
                    <ul class="space-y-2 text-sm text-gray-600">
                        <li><a href="#" class="hover:text-[#003087] transition">Help center</a></li>
                        <li><a href="#" class="hover:text-[#003087] transition">Contact</a></li>
                        <li><a href="#" class="hover:text-[#003087] transition">Privacy</a></li>
                    </ul>
                </div>
            </div>

            <!-- Bottom -->
            <div
                class="pt-8 border-t border-gray-100 flex flex-col sm:flex-row justify-between items-center text-sm text-gray-600">
                <p>© 2025 USRad. All rights reserved.</p>
                <p class="mt-2 sm:mt-0">Built by the team that saved patients $400M+</p>
            </div>
        </div>
    </footer>

    <!-- Simple Chat Widget -->
    <div class="fixed bottom-6 right-6 z-50">
        <button
            class="bg-[#003087] text-white w-14 h-14 rounded-full shadow-lg hover:bg-[#002266] transition flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-4l-4 4v-4z">
                </path>
            </svg>
        </button>
    </div>
</body>

</html>