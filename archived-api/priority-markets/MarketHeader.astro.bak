---
// src/components/provider/priority-markets/MarketHeader.astro
export interface Props {
  showScarcity?: boolean;
}

const { showScarcity = true } = Astro.props;
---

<div class="text-center mb-12">
  <div
    class="inline-flex items-center gap-3 backdrop-blur-sm bg-white/5 rounded-full px-4 py-2 mb-8 border border-white/10"
    data-aos="fade-up"
  >
    <div class="relative">
      <span
        class="absolute inline-flex h-3 w-3 rounded-full bg-[#cc9933] opacity-75 animate-ping"
      ></span>
      <span class="relative inline-flex h-3 w-3 rounded-full bg-[#cc9933]"
      ></span>
    </div>
    <span class="text-[#cc9933] text-sm font-medium uppercase tracking-wider"
      >Priority Markets Active Recruitment</span
    >
  </div>

  {
    showScarcity && (
      <div
        class="bg-[#cc9933]/10 backdrop-blur-sm border border-[#cc9933]/30 rounded-2xl p-6 mb-12 max-w-3xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="250"
      >
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0">
            <div class="w-12 h-12 bg-[#cc9933]/20 rounded-full flex items-center justify-center">
              <svg
                class="w-6 h-6 text-[#cc9933]"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                  clip-rule="evenodd"
                />
              </svg>
            </div>
          </div>
          <div>
            <p class="text-[#cc9933] font-bold mb-1">
              Limited Network Slots Available
            </p>
            <p class="text-sm text-gray-300 leading-relaxed">
              Just as we carefully selected centers for AnciCare to ensure
              quality and maintain volume commitments, we're accepting only{" "}
              <strong class="text-[#cc9933]">5-6 centers per market</strong> for
              USRad. Early partners will capture the most market share.
            </p>
          </div>
        </div>
      </div>
    )
  }

  <h2
    class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-8 leading-tight"
    data-aos="fade-up"
    data-aos-delay="100"
  >
    High-volume<br />
    <span
      class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] via-[#FFA500] to-[#cc9933] animate-gradient"
    >
      opportunity markets
    </span>
  </h2>

  <p
    class="text-lg md:text-xl text-gray-300 mb-12 leading-relaxed max-w-3xl mx-auto"
    data-aos="fade-up"
    data-aos-delay="200"
  >
    From our Fort Lauderdale headquarters, we're actively recruiting imaging
    centers in 10 high-demand markets where our patient acquisition programs
    show the strongest results.
  </p>
</div>

<style>
  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .animate-gradient {
    background-size: 200% 200%;
    animation: gradient 3s ease infinite;
  }
</style>
