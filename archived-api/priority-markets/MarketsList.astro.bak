---
// src/components/provider/priority-markets/MarketsList.astro
---

<div
  class="bg-white/5 backdrop-blur-md rounded-2xl p-8 border border-white/10"
  data-aos="fade-up"
  data-aos-delay="500"
>
  <h3 class="text-2xl font-bold text-white mb-6">10 Priority Markets</h3>

  <div class="grid grid-cols-2 gap-4">
    <!-- Top Tier Markets -->
    <div class="space-y-3">
      <h4 class="text-sm text-[#cc9933] uppercase tracking-wider">
        Tier 1 Markets
      </h4>
      <div
        class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30 cursor-pointer hover:bg-[#cc9933]/20 transition-colors group"
        data-market="miami"
      >
        <div class="flex justify-between items-start">
          <div>
            <div class="font-medium text-white">Florida</div>
            <div class="text-xs text-[#cc9933]">HQ • Miami-Ft. Lauderdale</div>
          </div>
          <div class="flex items-center gap-1">
            <span
              class="text-[10px] text-[#cc9933] opacity-0 group-hover:opacity-100 transition-opacity"
              >View Analysis →</span
            >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#cc9933] opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-[#cc9933]"
              ></span>
            </span>
          </div>
        </div>
      </div>
      <div
        class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30 cursor-pointer hover:bg-[#cc9933]/20 transition-colors group"
        data-market="dallas"
      >
        <div class="flex justify-between items-start">
          <div>
            <div class="font-medium text-white">Texas</div>
            <div class="text-xs text-gray-400">Houston • Dallas • Austin</div>
          </div>
          <div class="flex items-center gap-1">
            <span
              class="text-[10px] text-[#cc9933] opacity-0 group-hover:opacity-100 transition-opacity"
              >View Analysis →</span
            >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#cc9933] opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-[#cc9933]"
              ></span>
            </span>
          </div>
        </div>
      </div>
      <div class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30">
        <div class="font-medium text-white">California</div>
        <div class="text-xs text-gray-400">LA • San Diego • Bay Area</div>
      </div>
      <div class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30">
        <div class="font-medium text-white">New York</div>
        <div class="text-xs text-gray-400">NYC Metro • Long Island</div>
      </div>
    </div>

    <!-- Secondary Markets -->
    <div class="space-y-3">
      <h4 class="text-sm text-[#4A90E2] uppercase tracking-wider">
        Expansion Markets
      </h4>
      <div class="bg-white/5 rounded-lg p-3 border border-gray-700">
        <div class="font-medium text-white">Pennsylvania</div>
        <div class="text-xs text-gray-400">Philadelphia • Pittsburgh</div>
      </div>
      <div class="bg-white/5 rounded-lg p-3 border border-gray-700">
        <div class="font-medium text-white">Illinois</div>
        <div class="text-xs text-gray-400">Chicago Metro</div>
      </div>
      <div class="bg-white/5 rounded-lg p-3 border border-gray-700">
        <div class="font-medium text-white">Ohio</div>
        <div class="text-xs text-gray-400">Cleveland • Columbus</div>
      </div>
      <div
        class="bg-white/5 rounded-lg p-3 border border-gray-700 cursor-pointer hover:bg-white/10 transition-colors group"
        data-market="atlanta"
      >
        <div class="flex justify-between items-start">
          <div>
            <div class="font-medium text-white">Georgia</div>
            <div class="text-xs text-gray-400">Atlanta Metro</div>
          </div>
          <div class="flex items-center gap-1">
            <span
              class="text-[10px] text-blue-400 opacity-0 group-hover:opacity-100 transition-opacity"
              >View Analysis →</span
            >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-blue-400"
              ></span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Additional Markets -->
  <div class="mt-4 grid grid-cols-2 gap-2">
    <div class="bg-white/5 rounded p-2 text-center">
      <div class="text-sm text-white">N. Carolina</div>
    </div>
    <div class="bg-white/5 rounded p-2 text-center">
      <div class="text-sm text-white">New Jersey</div>
    </div>
  </div>
</div>

<script>
  // MarketScope integration - dispatch event when market is clicked
  document.querySelectorAll("[data-market]").forEach((card) => {
    card.addEventListener("click", () => {
      const market = card.dataset.market;
      if (market) {
        window.dispatchEvent(
          new CustomEvent("usrad:selectMarket", {
            detail: { market },
          })
        );
      }
    });
  });
</script>
