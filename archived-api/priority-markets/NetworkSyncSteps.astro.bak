---
// src/components/provider/priority-markets/NetworkSyncSteps.astro
---

<div
  class="max-w-6xl mx-auto bg-black/40 backdrop-blur-sm rounded-2xl p-8 border border-white/10"
  data-aos="fade-up"
>
  <h3 class="text-2xl font-bold text-white text-center mb-12">
    How Network Sync Works
  </h3>

  <div class="grid md:grid-cols-4 gap-8">
    <!-- Step 1 -->
    <div class="text-center">
      <div
        class="w-16 h-16 mx-auto mb-4 bg-gradient-to-br from-[#003087] to-[#0052cc] rounded-full flex items-center justify-center text-white font-bold text-xl"
      >
        1
      </div>
      <h4 class="font-bold text-white mb-2">Centers Update Availability</h4>
      <p class="text-sm text-gray-400">
        Imaging centers continuously sync their open slots with our Fort
        Lauderdale hub
      </p>
    </div>

    <!-- Step 2 -->
    <div class="text-center">
      <div
        class="w-16 h-16 mx-auto mb-4 bg-gradient-to-br from-[#003087] to-[#0052cc] rounded-full flex items-center justify-center text-white font-bold text-xl"
      >
        2
      </div>
      <h4 class="font-bold text-white mb-2">AI Matches Patients</h4>
      <p class="text-sm text-gray-400">
        Our system finds the optimal match in under 60 seconds
      </p>
    </div>

    <!-- Step 3 -->
    <div class="text-center">
      <div
        class="w-16 h-16 mx-auto mb-4 bg-gradient-to-br from-[#003087] to-[#0052cc] rounded-full flex items-center justify-center text-white font-bold text-xl"
      >
        3
      </div>
      <h4 class="font-bold text-white mb-2">Referral Sent</h4>
      <p class="text-sm text-gray-400">
        Pre-qualified patient referral instantly sent to matched center
      </p>
    </div>

    <!-- Step 4 -->
    <div class="text-center">
      <div
        class="w-16 h-16 mx-auto mb-4 bg-gradient-to-br from-[#cc9933] to-[#FFA500] rounded-full flex items-center justify-center text-white font-bold text-xl"
      >
        4
      </div>
      <h4 class="font-bold text-white mb-2">Center Confirms</h4>
      <p class="text-sm text-gray-400">
        Imaging center confirms receipt and updates their schedule
      </p>
    </div>
  </div>

  <div class="text-center mt-8">
    <p class="text-[#FFA500] font-bold">
      Average end-to-end process time: <span class="text-2xl">47 seconds</span>
    </p>
  </div>
</div>
