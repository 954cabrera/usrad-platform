  heart: ["cardiac", "myocardial", "coronary"],  // ← Add this
};

// 2. Verify expansion is called
const q = normalizeInput(expandQueryWithAliases(query));  // ← Correct

// 3. Test expansion directly
console.log(expandQueryWithAliases("heart scan"));
// Should output: "heart scan cardiac myocardial coronary"
```

