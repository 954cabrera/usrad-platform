9.3 Priority 3: Enhanced Search Intelligence
Contextual Search:

Detect gestational age in pregnancy searches: "20 week ultrasound" → CPT 76805
Parse anatomical modifiers: "left leg doppler" → Specify laterality
Recognize urgency keywords: "urgent", "stat", "emergency"

Implementation:
javascript// In search-engine.ts
function parseUltrasoundContext(query) {
  // Detect gestational week
  const weekMatch = query.match(/(\d+)\s*week/i);
  if (weekMatch) {
    const weeks = parseInt(weekMatch[1]);
    if (weeks <= 13) return { trimester: 1, cpt: '76801' };
    return { trimester: 2, cpt: '76805' };
  }
  
  // Detect laterality
  if (query.includes('left') || query.includes('right')) {
    return { laterality: query.includes('left') ? 'L' : 'R' };
  }
}
