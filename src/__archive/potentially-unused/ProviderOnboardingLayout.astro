---
// src/layouts/ProviderOnboardingLayout.astro
export interface Props {
  title: string;
  currentStep?: number;
  totalSteps?: number;
}

const { title, currentStep = 1, totalSteps = 3 } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Prevent zoom on iOS -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />

    <style>
      /* Custom colors for provider portal */
      :root {
        --usrad-blue: #003087;
        --usrad-gold: #cc9933;
        --provider-bg: #f8fafc;
      }

      /* Prevent text selection on UI elements */
      .no-select {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
      }

      /* Focus states for accessibility */
      button:focus,
      input:focus,
      select:focus,
      textarea:focus {
        outline: 2px solid var(--usrad-blue);
        outline-offset: 2px;
      }

      /* Mobile optimizations */
      @media (max-width: 768px) {
        input,
        select,
        textarea {
          font-size: 16px; /* Prevents zoom on iOS */
        }
      }

      /* Loading spinner */
      .spinner {
        border: 3px solid #f3f3f3;
        border-top: 3px solid var(--usrad-blue);
        border-radius: 50%;
        width: 24px;
        height: 24px;
        animation: spin 1s linear infinite;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
    </style>
  </head>

  <body class="h-full bg-gray-50 font-sans antialiased">
    <!-- Provider Header -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex justify-between items-center h-16">
          <!-- Logo & Portal Branding -->
          <div class="flex items-center space-x-4">
            <a href="/providers" class="flex items-center space-x-2">
              <img
                src="/images/usrad-logo.svg"
                alt="USRad"
                class="h-8 w-auto"
              />
              <span class="text-sm font-medium text-gray-600"
                >Provider Portal</span
              >
            </a>

            <!-- Progress Indicator -->
            <div class="hidden sm:flex items-center space-x-2 ml-8">
              <span class="text-sm text-gray-500"
                >Step {currentStep} of {totalSteps}</span
              >
              <div class="flex space-x-1">
                {
                  Array.from({ length: totalSteps }, (_, i) => (
                    <div
                      class={`w-2 h-2 rounded-full ${
                        i + 1 <= currentStep ? "bg-blue-600" : "bg-gray-300"
                      }`}
                    />
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center space-x-4">
            <!-- Mobile Progress -->
            <div class="sm:hidden text-xs text-gray-500">
              {currentStep}/{totalSteps}
            </div>

            <!-- Help Link -->
            <button
              onclick="document.getElementById('help-modal').classList.remove('hidden')"
              class="text-sm text-gray-600 hover:text-gray-800 transition-colors"
            >
              Need Help?
            </button>

            <!-- Save & Exit -->
            <button
              onclick="handleSaveAndExit()"
              class="text-sm text-gray-600 hover:text-gray-800 px-3 py-1.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition-all"
            >
              Save & Exit
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 min-h-screen pb-16">
      <slot />
    </main>

    <!-- Minimal Footer -->
    <footer class="bg-white border-t border-gray-200 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
        <div
          class="flex flex-col sm:flex-row justify-between items-center space-y-3 sm:space-y-0"
        >
          <!-- Support Info -->
          <div class="flex items-center space-x-6 text-sm text-gray-600">
            <a
              href="tel:1-866-872-7324"
              class="hover:text-gray-800 transition-colors"
            >
              📞 (800) USR-ADIO
            </a>
            <a
              href="mailto:providers@usrad.com"
              class="hover:text-gray-800 transition-colors"
            >
              ✉️ providers@usrad.com
            </a>
          </div>

          <!-- Security Badge -->
          <div class="flex items-center space-x-2 text-xs text-gray-500">
            <span class="flex items-center space-x-1">
              <span>🔒</span>
              <span>256-bit SSL</span>
            </span>
            <span>•</span>
            <span class="flex items-center space-x-1">
              <span>🏥</span>
              <span>HIPAA Compliant</span>
            </span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Help Modal -->
    <div
      id="help-modal"
      class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4"
    >
      <div class="bg-white rounded-xl max-w-md w-full p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold text-gray-900">Need Assistance?</h3>
          <button
            onclick="document.getElementById('help-modal').classList.add('hidden')"
            class="text-gray-400 hover:text-gray-600"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <div class="space-y-4">
          <p class="text-gray-600">
            Our provider relations team is available to help with your
            onboarding process.
          </p>

          <div class="grid grid-cols-1 gap-3">
            <a
              href="tel:1-866-872-7324"
              class="flex items-center justify-center space-x-2 bg-blue-600 text-white px-4 py-3 rounded-lg hover:bg-blue-700 transition-colors"
            >
              <span>📞</span>
              <span>Call (800) USR-ADIO</span>
            </a>

            <a
              href="mailto:providers@usrad.com?subject=Provider Onboarding Help"
              class="flex items-center justify-center space-x-2 bg-gray-100 text-gray-700 px-4 py-3 rounded-lg hover:bg-gray-200 transition-colors"
            >
              <span>✉️</span>
              <span>Email Support</span>
            </a>
          </div>

          <p class="text-xs text-gray-500 text-center">
            Average response time: Under 30 minutes during business hours
          </p>
        </div>
      </div>
    </div>

    <!-- Save & Exit Confirmation Modal -->
    <div
      id="save-exit-modal"
      class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4"
    >
      <div class="bg-white rounded-xl max-w-md w-full p-6">
        <div class="text-center">
          <div
            class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">⚠️</span>
          </div>

          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            Save Your Progress?
          </h3>
          <p class="text-gray-600 mb-6">
            Your information will be saved and you can return to complete the
            onboarding process anytime.
          </p>

          <div class="grid grid-cols-2 gap-3">
            <button
              onclick="document.getElementById('save-exit-modal').classList.add('hidden')"
              class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors"
            >
              Keep Going
            </button>
            <button
              onclick="confirmSaveAndExit()"
              class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
            >
              Save & Exit
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Back to Provider Home Confirmation -->
    <div
      id="back-confirmation-modal"
      class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4"
    >
      <div class="bg-white rounded-xl max-w-md w-full p-6">
        <div class="text-center">
          <div
            class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">🏠</span>
          </div>

          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            Return to Provider Home?
          </h3>
          <p class="text-gray-600 mb-6">
            Your onboarding progress will be saved automatically. You can
            continue where you left off anytime.
          </p>

          <div class="grid grid-cols-2 gap-3">
            <button
              onclick="document.getElementById('back-confirmation-modal').classList.add('hidden')"
              class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors"
            >
              Stay Here
            </button>
            <button
              onclick="goToProviderHome()"
              class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
            >
              Go to Provider Home
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Save and Exit functionality
      function handleSaveAndExit() {
        document.getElementById("save-exit-modal").classList.remove("hidden");
      }

      function confirmSaveAndExit() {
        try {
          // Trigger save event that components can listen to
          window.dispatchEvent(new CustomEvent("saveProgress"));

          // Show saving indicator
          document.getElementById("save-exit-modal").innerHTML =
            '<div class="text-center p-6">' +
            '<div class="spinner mx-auto mb-4"></div>' +
            '<p class="text-gray-600">Saving your progress...</p>' +
            "</div>";

          // Wait a moment for save operations
          setTimeout(function () {
            // Redirect to provider dashboard or home
            window.location.href = "/providers/dashboard";
          }, 2000);
        } catch (error) {
          console.error("Error saving progress:", error);
          alert("Error saving progress. Please try again.");
          document.getElementById("save-exit-modal").classList.add("hidden");
        }
      }

      // Back to provider home
      function showBackConfirmation() {
        document
          .getElementById("back-confirmation-modal")
          .classList.remove("hidden");
      }

      function goToProviderHome() {
        // Auto-save progress
        window.dispatchEvent(new CustomEvent("saveProgress"));

        // Small delay for save operations
        setTimeout(function () {
          window.location.href = "/providers";
        }, 500);
      }

      // Handle browser back button
      window.addEventListener("beforeunload", function (e) {
        // Auto-save when user tries to leave
        window.dispatchEvent(new CustomEvent("saveProgress"));
      });

      // Close modals when clicking outside
      document.addEventListener("click", function (e) {
        if (e.target.classList.contains("fixed")) {
          e.target.classList.add("hidden");
        }
      });

      // Prevent accidental form submission on Enter
      document.addEventListener("keydown", function (e) {
        if (
          e.key === "Enter" &&
          e.target.tagName !== "TEXTAREA" &&
          e.target.tagName !== "BUTTON"
        ) {
          e.preventDefault();
        }
      });

      // Auto-save functionality (components can implement)
      var autoSaveTimeout;
      function scheduleAutoSave() {
        clearTimeout(autoSaveTimeout);
        autoSaveTimeout = setTimeout(function () {
          window.dispatchEvent(new CustomEvent("autoSave"));
        }, 30000); // Auto-save every 30 seconds
      }

      // Listen for input changes to schedule auto-save
      document.addEventListener("input", scheduleAutoSave);
      document.addEventListener("change", scheduleAutoSave);
    </script>
  </body>
</html>
