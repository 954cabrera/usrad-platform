// src/components/PatientManagementDashboard.jsx
import { useState } from 'react';

const PatientManagementDashboard = () => {
  const [activeTab, setActiveTab] = useState('pending');
  const [searchTerm, setSearchTerm] = useState('');
  const [filterPriority, setFilterPriority] = useState('all');

  // Sample data - this would come from your Supabase database
  const pendingRequests = [
    {
      id: '001',
      patient: 'Sarah Johnson',
      procedure: 'MRI Lumbar Spine w/o contrast',
      priority: 'urgent',
      priorityScore: 95,
      timeframe: 'ASAP',
      waitingDays: 2,
      phone: '(555) 123-4567',
      email: 'sarah.j@email.com',
      revenue: 485,
      prescriptionUploaded: true
    },
    {
      id: '002',
      patient: 'Michael Chen',
      procedure: 'MRI Brain w/ contrast',
      priority: 'routine',
      priorityScore: 35,
      timeframe: 'Within 1 week',
      waitingDays: 1,
      phone: '(555) 987-6543',
      email: 'mchen@email.com',
      revenue: 725,
      prescriptionUploaded: true
    },
    {
      id: '003',
      patient: 'Emily Rodriguez',
      procedure: 'MRI Knee w/o contrast',
      priority: 'routine',
      priorityScore: 20,
      timeframe: 'Flexible',
      waitingDays: 3,
      phone: '(555) 456-7890',
      email: 'emily.r@email.com',
      revenue: 395,
      prescriptionUploaded: false
    }
  ];

  const scheduledAppointments = [
    {
      id: 'S001',
      patient: 'David Williams',
      procedure: 'MRI Shoulder w/o contrast',
      date: '2025-07-02T10:00:00',
      facility: 'Miami Imaging Center',
      confirmationCode: 'USR-789456',
      amount: 445,
      canReschedule: true,
      canCancel: true
    },
    {
      id: 'S002',
      patient: 'Lisa Thompson',
      procedure: 'MRI Cervical Spine w/ contrast',
      date: '2025-07-01T14:30:00',
      facility: 'Coral Gables Diagnostic',
      confirmationCode: 'USR-123789',
      amount: 695,
      canReschedule: false, // Too close to appointment
      canCancel: false
    }
  ];

  const awaitingReports = [
    {
      id: 'C001',
      patient: 'Robert Martinez',
      procedure: 'MRI Lumbar Spine w/ contrast',
      facility: 'Downtown Imaging',
      hoursElapsed: 50,
      status: 'overdue',
      urgencyIcon: '🚨'
    },
    {
      id: 'C002',
      patient: 'Jennifer Park',
      procedure: 'MRI Knee w/o contrast',
      facility: 'Westside Radiology',
      hoursElapsed: 26,
      status: 'due-soon',
      urgencyIcon: '⚠️'
    },
    {
      id: 'C003',
      patient: 'Mark Thompson',
      procedure: 'MRI Brain w/o contrast',
      facility: 'Miami Imaging Center',
      hoursElapsed: 6,
      status: 'recent',
      urgencyIcon: '🕐'
    },
    {
      id: 'C004',
      patient: 'Susan Davis',
      procedure: 'MRI Shoulder w/ contrast',
      facility: 'Elite Diagnostics',
      status: 'available',
      urgencyIcon: '✅'
    }
  ];

  const patientFeedback = [
    {
      id: 'F001',
      patient: 'Susan Davis',
      rating: 5,
      status: 'received',
      comments: 'Excellent service! Much better than going through insurance.',
      actionRequired: false
    },
    {
      id: 'F002',
      patient: 'Michael Stevens',
      rating: 2,
      status: 'received',
      comments: 'Long wait time, staff seemed overwhelmed.',
      actionRequired: true
    },
    {
      id: 'F003',
      patient: 'Robert Martinez',
      status: 'pending',
      remindersSent: 2,
      actionRequired: false
    },
    {
      id: 'F004',
      patient: 'Jennifer Park',
      status: 'pending',
      remindersSent: 0,
      actionRequired: false
    }
  ];

  // Business action handlers
  const handleBusinessAction = (action, patientName, details = '') => {
    const actions = {
      schedule: `🎯 SCHEDULING WORKFLOW\n\nPatient: ${patientName}\n\n📋 Next Steps:\n• Select facility from network\n• Check real-time availability\n• Process payment ($${details})\n• Generate confirmation\n• Send notifications\n\n✅ Revenue impact: +$${details}`,
      contact: `📞 PATIENT COMMUNICATION\n\nPatient: ${patientName}\n\n💬 Channels Available:\n• SMS (preferred)\n• Email\n• Phone call\n• In-app messaging\n\n📊 Response rate: 95%`,
      reschedule: `📅 RESCHEDULING PROTOCOL\n\nPatient: ${patientName}\n\n🔄 Process:\n• Check availability\n• No additional fees\n• Instant confirmation\n• Auto-notifications\n\n⚡ Avg rebooking: 24 hours`,
      cancel: `❌ CANCELLATION & REFUND\n\nPatient: ${patientName}\n\n💰 Automatic refund: $${details}\n• Payment gateway processing\n• Facility notification\n• Slot released to network\n\n📈 Inventory optimization`,
      followUp: `🏥 PROVIDER SLA ENFORCEMENT\n\nPatient: ${patientName}\n\n⚡ Escalation:\n• Automated reminder sent\n• Manager notification\n• Performance tracking\n• Contract compliance\n\n📊 Current SLA: 85%`,
      sendReminder: `📬 FEEDBACK COLLECTION\n\nPatient: ${patientName}\n\n📝 Smart Survey:\n• Personalized 2-min survey\n• Mobile optimized\n• $5 credit incentive\n• Multi-channel delivery\n\n📈 Response rate: 73%`,
      addressIssues: `⚠️ SERVICE RECOVERY\n\nPatient: ${patientName}\nRating: ${details}⭐\n\n🔧 Actions:\n• Personal follow-up call\n• $50 credit applied\n• Facility escalation\n• Quality improvement\n\n🎯 89% satisfaction recovery`
    };

    alert(actions[action] || `Action: ${action} for ${patientName}`);
  };

  // Filter pending requests
  const filteredRequests = pendingRequests
    .filter(req => {
      const matchesSearch = req.patient.toLowerCase().includes(searchTerm.toLowerCase()) ||
                           req.procedure.toLowerCase().includes(searchTerm.toLowerCase());
      const matchesPriority = filterPriority === 'all' || req.priority === filterPriority;
      return matchesSearch && matchesPriority;
    })
    .sort((a, b) => b.priorityScore - a.priorityScore);

  const formatDate = (dateString) => {
    const date = new Date(dateString);
    return date.toLocaleDateString() + ' at ' + date.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
  };

  const getStatusInfo = (status) => {
    const statuses = {
      overdue: { class: 'bg-red-100 text-red-800', text: 'OVERDUE (48+ hrs)' },
      'due-soon': { class: 'bg-yellow-100 text-yellow-800', text: 'Due Soon (24+ hrs)' },
      recent: { class: 'bg-green-100 text-green-800', text: 'Recent (Under 24hrs)' },
      available: { class: 'bg-blue-100 text-blue-800', text: 'Report Available' }
    };
    return statuses[status] || { class: 'bg-gray-100 text-gray-800', text: status };
  };

  const getRatingDisplay = (rating) => {
    if (!rating) return null;
    if (rating >= 5) return <span className="px-2 py-1 bg-green-600 text-white rounded text-xs font-medium">{rating}⭐ Excellent</span>;
    if (rating >= 4) return <span className="px-2 py-1 bg-green-500 text-white rounded text-xs font-medium">{rating}⭐ Good</span>;
    if (rating >= 3) return <span className="px-2 py-1 bg-yellow-500 text-white rounded text-xs font-medium">{rating}⭐ Fair</span>;
    return <span className="px-2 py-1 bg-red-600 text-white rounded text-xs font-medium">{rating}⭐ Poor</span>;
  };

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header */}
      <div className="bg-white shadow-sm border-b">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between items-center py-4">
            <div>
              <h1 className="text-2xl font-bold text-gray-900">USRad Patient Management</h1>
              <p className="text-sm text-gray-600">Complete Patient Lifecycle Dashboard</p>
            </div>
            <div className="flex items-center space-x-4">
              <div className="text-sm text-gray-600">
                <span className="font-medium">{pendingRequests.length}</span> pending requests
              </div>
              <div className="text-sm text-gray-600">
                <span className="font-medium">{scheduledAppointments.length}</span> scheduled
              </div>
              <div className="text-sm text-gray-600">
                <span className="font-medium">{awaitingReports.length}</span> awaiting reports
              </div>
              <div className="text-sm text-gray-600">
                <span className="font-medium">{patientFeedback.length}</span> feedback pending
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Tab Navigation */}
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="border-b border-gray-200">
          <nav className="-mb-px flex space-x-8">
            {[
              { key: 'pending', label: 'Pending Requests', count: pendingRequests.length },
              { key: 'scheduled', label: 'Scheduled Appointments', count: scheduledAppointments.length },
              { key: 'reports', label: 'Awaiting Reports', count: awaitingReports.length },
              { key: 'feedback', label: 'Patient Feedback', count: patientFeedback.length }
            ].map(tab => (
              <button
                key={tab.key}
                onClick={() => setActiveTab(tab.key)}
                className={`py-4 px-1 border-b-2 font-medium text-sm ${
                  activeTab === tab.key
                    ? 'border-blue-500 text-blue-600'
                    : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'
                }`}
              >
                {tab.label} ({tab.count})
              </button>
            ))}
          </nav>
        </div>
      </div>

      {/* Content Area */}
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        
        {/* Pending Requests Tab */}
        {activeTab === 'pending' && (
          <div>
            {/* Search and Filter */}
            <div className="mb-6 flex flex-col sm:flex-row gap-4">
              <div className="flex-1">
                <input
                  type="text"
                  placeholder="Search patients..."
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                />
              </div>
              <select
                value={filterPriority}
                onChange={(e) => setFilterPriority(e.target.value)}
                className="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              >
                <option value="all">All Priorities</option>
                <option value="urgent">Urgent Only</option>
                <option value="routine">Routine Only</option>
              </select>
            </div>

            {/* Requests List */}
            <div className="bg-white shadow-sm rounded-lg overflow-hidden">
              <div className="px-6 py-4 border-b border-gray-200">
                <h2 className="text-lg font-medium text-gray-900">Pending MRI Requests</h2>
                <p className="text-sm text-gray-600">Sorted by priority score (urgency + wait time)</p>
              </div>
              
              <div className="divide-y divide-gray-200">
                {filteredRequests.map((request) => (
                  <div key={request.id} className="p-6 hover:bg-gray-50">
                    <div className="flex items-start justify-between">
                      <div className="flex-1">
                        <div className="flex items-center gap-3 mb-2">
                          <h3 className="text-lg font-medium text-gray-900">{request.patient}</h3>
                          <span className={`px-2 py-1 rounded-full text-xs font-medium ${
                            request.priority === 'urgent' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'
                          }`}>
                            {request.priority}
                          </span>
                          <span className="text-sm text-gray-500">Priority Score: {request.priorityScore}</span>
                        </div>
                        
                        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                          <div>
                            <p className="text-sm font-medium text-gray-700">Procedure</p>
                            <p className="text-sm text-gray-600">{request.procedure}</p>
                          </div>
                          <div>
                            <p className="text-sm font-medium text-gray-700">Timeframe</p>
                            <p className="text-sm text-gray-600">{request.timeframe}</p>
                          </div>
                          <div>
                            <p className="text-sm font-medium text-gray-700">Waiting</p>
                            <p className="text-sm text-gray-600">{request.waitingDays} day(s)</p>
                          </div>
                        </div>
                        
                        <div className="flex items-center gap-6 text-sm text-gray-600">
                          <span>📞 {request.phone}</span>
                          <span>📧 {request.email}</span>
                          <span>💰 ${request.revenue}</span>
                          <span>
                            {request.prescriptionUploaded ? '✅' : '❌'} 
                            Prescription {request.prescriptionUploaded ? 'Uploaded' : 'Missing'}
                          </span>
                        </div>
                      </div>
                      
                      <div className="flex flex-col gap-2 ml-4">
                        <button 
                          onClick={() => handleBusinessAction('schedule', request.patient, request.revenue)}
                          className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
                        >
                          Schedule Now
                        </button>
                        <button 
                          onClick={() => handleBusinessAction('contact', request.patient)}
                          className="px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition-colors"
                        >
                          Contact Patient
                        </button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* Scheduled Appointments Tab */}
        {activeTab === 'scheduled' && (
          <div className="bg-white shadow-sm rounded-lg overflow-hidden">
            <div className="px-6 py-4 border-b border-gray-200">
              <h2 className="text-lg font-medium text-gray-900">Scheduled Appointments</h2>
              <p className="text-sm text-gray-600">Manage existing patient appointments</p>
            </div>
            
            <div className="divide-y divide-gray-200">
              {scheduledAppointments.map((appointment) => (
                <div key={appointment.id} className="p-6">
                  <div className="flex items-start justify-between">
                    <div className="flex-1">
                      <div className="flex items-center gap-3 mb-2">
                        <h3 className="text-lg font-medium text-gray-900">{appointment.patient}</h3>
                        <span className="px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                          Confirmed
                        </span>
                      </div>
                      
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                          <p className="text-sm font-medium text-gray-700">Procedure</p>
                          <p className="text-sm text-gray-600">{appointment.procedure}</p>
                        </div>
                        <div>
                          <p className="text-sm font-medium text-gray-700">Date & Time</p>
                          <p className="text-sm text-gray-600">{formatDate(appointment.date)}</p>
                        </div>
                        <div>
                          <p className="text-sm font-medium text-gray-700">Facility</p>
                          <p className="text-sm text-gray-600">{appointment.facility}</p>
                        </div>
                        <div>
                          <p className="text-sm font-medium text-gray-700">Confirmation</p>
                          <p className="text-sm text-gray-600 font-mono">{appointment.confirmationCode}</p>
                        </div>
                      </div>
                      
                      <div className="flex items-center gap-6 text-sm text-gray-600">
                        <span>💰 ${appointment.amount} paid</span>
                        <span>📍 {appointment.facility}</span>
                      </div>
                    </div>
                    
                    <div className="flex flex-col gap-2 ml-4">
                      <button 
                        className={`px-4 py-2 rounded-md transition-colors ${
                          appointment.canReschedule 
                            ? 'bg-yellow-600 text-white hover:bg-yellow-700' 
                            : 'bg-gray-300 text-gray-500 cursor-not-allowed'
                        }`}
                        disabled={!appointment.canReschedule}
                        onClick={() => handleBusinessAction('reschedule', appointment.patient)}
                      >
                        {appointment.canReschedule ? 'Reschedule' : 'Cannot Reschedule'}
                      </button>
                      <button 
                        className={`px-4 py-2 rounded-md transition-colors ${
                          appointment.canCancel 
                            ? 'border border-red-300 text-red-700 hover:bg-red-50' 
                            : 'border border-gray-300 text-gray-500 cursor-not-allowed'
                        }`}
                        disabled={!appointment.canCancel}
                        onClick={() => handleBusinessAction('cancel', appointment.patient, appointment.amount)}
                      >
                        {appointment.canCancel ? 'Cancel' : 'Cannot Cancel'}
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Awaiting Reports Tab */}
        {activeTab === 'reports' && (
          <div className="bg-white shadow-sm rounded-lg overflow-hidden">
            <div className="px-6 py-4 border-b border-gray-200">
              <h2 className="text-lg font-medium text-gray-900">Completed Appointments - Awaiting Reports</h2>
              <p className="text-sm text-gray-600">Track report delivery and SLA compliance (24-48 hours)</p>
            </div>
            
            <div className="divide-y divide-gray-200">
              {awaitingReports.map((report) => {
                const statusInfo = getStatusInfo(report.status);
                return (
                  <div key={report.id} className="p-6 hover:bg-gray-50">
                    <div className="flex justify-between">
                      <div className="flex-1">
                        <div className="flex items-center gap-3 mb-2">
                          <h3 className="text-lg font-medium text-gray-900">{report.patient}</h3>
                          <span className={`px-2 py-1 rounded-full text-xs font-medium ${statusInfo.class}`}>
                            {statusInfo.text}
                          </span>
                          <span className="text-lg">{report.urgencyIcon}</span>
                          {report.hoursElapsed && (
                            <span className="text-sm text-gray-500">{report.hoursElapsed} hours elapsed</span>
                          )}
                        </div>
                        
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                          <div>
                            <p className="text-sm font-medium text-gray-700">Procedure</p>
                            <p className="text-sm text-gray-600">{report.procedure}</p>
                          </div>
                          <div>
                            <p className="text-sm font-medium text-gray-700">Facility</p>
                            <p className="text-sm text-gray-600">{report.facility}</p>
                          </div>
                        </div>
                      </div>
                      
                      <div className="flex flex-col gap-2 ml-4">
                        {report.status === 'available' ? (
                          <button 
                            className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
                            onClick={() => handleBusinessAction('viewReport', report.patient)}
                          >
                            View Report
                          </button>
                        ) : (
                          <button 
                            className="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition-colors"
                            onClick={() => handleBusinessAction('followUp', report.patient)}
                          >
                            Follow Up Provider
                          </button>
                        )}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* Patient Feedback Tab */}
        {activeTab === 'feedback' && (
          <div className="bg-white shadow-sm rounded-lg overflow-hidden">
            <div className="px-6 py-4 border-b border-gray-200">
              <h2 className="text-lg font-medium text-gray-900">Patient Satisfaction Management</h2>
              <p className="text-sm text-gray-600">Track feedback collection and service recovery</p>
            </div>
            
            <div className="divide-y divide-gray-200">
              {patientFeedback.map((feedback) => (
                <div key={feedback.id} className="p-6 hover:bg-gray-50">
                  <div className="flex justify-between">
                    <div className="flex-1">
                      <div className="flex items-center gap-3 mb-2">
                        <h3 className="text-lg font-medium text-gray-900">{feedback.patient}</h3>
                        {feedback.rating && getRatingDisplay(feedback.rating)}
                        <span className={`px-2 py-1 rounded-full text-xs font-medium ${
                          feedback.status === 'received' 
                            ? feedback.actionRequired ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'
                            : 'bg-yellow-100 text-yellow-800'
                        }`}>
                          {feedback.status === 'received' 
                            ? feedback.actionRequired ? 'Action Required' : 'Feedback Received'
                            : `Pending (${feedback.remindersSent} reminders)`
                          }
                        </span>
                      </div>
                      
                      {feedback.comments && (
                        <div className="mb-4">
                          <p className="text-sm font-medium text-gray-700">Patient Comments:</p>
                          <p className="text-sm text-gray-600 italic">"{feedback.comments}"</p>
                        </div>
                      )}
                    </div>
                    
                    <div className="flex flex-col gap-2 ml-4">
                      {feedback.status === 'pending' ? (
                        <button 
                          className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
                          onClick={() => handleBusinessAction('sendReminder', feedback.patient)}
                        >
                          Send Reminder
                        </button>
                      ) : feedback.actionRequired ? (
                        <button 
                          className="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition-colors"
                          onClick={() => handleBusinessAction('addressIssues', feedback.patient, feedback.rating)}
                        >
                          Address Issues
                        </button>
                      ) : (
                        <button 
                          className="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition-colors"
                          onClick={() => handleBusinessAction('sharePositive', feedback.patient, feedback.rating)}
                        >
                          Share with Provider
                        </button>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default PatientManagementDashboard;