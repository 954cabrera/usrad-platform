---
// src/components/BlogPreviewSection.astro

const featuredArticles = [
  {
    title: "Uninsured? Get Quality Imaging for 70% Less",
    excerpt: "Save hundreds—sometimes thousands—on your next MRI, CT scan, or ultrasound.",
    image: "/images/blog/trust-duo.webp",
    category: "Cost & Savings",
    readTime: "5 min",
    slug: "/blog/uninsured-imaging-guide"
  },
  {
    title: "How to Prepare for Your First MRI",
    excerpt: "Everything you need to know before your MRI appointment.",
    image: "/images/blog/tech-patient.webp",
    category: "Patient Guide",
    readTime: "6 min",
    slug: "/blog/first-mri-preparation-guide"
  },
  {
    title: "The Real Cost of an MRI",
    excerpt: "What hospitals don't want you to know about MRI pricing.",
    image: "/images/blog/cost-comparison.webp",
    category: "Cost & Savings",
    readTime: "6 min",
    slug: "/blog/real-cost-of-mri"
  }
];
---

<section class="py-16 sm:py-24 px-4 sm:px-6 bg-gradient-to-b from-gray-50 to-white">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header -->
    <div class="text-center mb-12" data-aos="fade-up">
      <span class="inline-block px-4 py-2 bg-[#003087]/10 text-[#003087] rounded-full text-sm font-semibold mb-4">
        📚 Patient Education
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold mb-4 text-gray-900">
        Healthcare Insights from Industry Veterans
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        30 years of experience helping patients save on medical imaging
      </p>
    </div>

    <!-- Featured Articles Grid -->
    <div class="grid md:grid-cols-3 gap-8 mb-12">
      {featuredArticles.map((article, index) => (
        <article 
          class="group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay={index * 100}
        >
          <!-- Image -->
          <a href={article.slug} class="block relative overflow-hidden h-48">
            <img 
              src={article.image} 
              alt={article.title}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <div class="absolute top-4 left-4">
              <span class="bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-semibold text-[#003087]">
                {article.category}
              </span>
            </div>
          </a>

          <!-- Content -->
          <div class="p-6">
            <a href={article.slug} class="block">
              <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-[#003087] transition-colors line-clamp-2">
                {article.title}
              </h3>
            </a>
            <p class="text-gray-600 mb-4 line-clamp-2">
              {article.excerpt}
            </p>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">{article.readTime} read</span>
              <a 
                href={article.slug}
                class="inline-flex items-center gap-2 text-[#003087] font-semibold hover:gap-3 transition-all"
              >
                Read more
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- View All CTA -->
    <div class="text-center" data-aos="fade-up">
      <a 
        href="/blog"
        class="inline-flex items-center gap-3 bg-[#003087] text-white px-8 py-4 rounded-full font-semibold text-lg hover:bg-[#002066] transition-all transform hover:scale-105 shadow-lg hover:shadow-xl"
      >
        View All 11 Articles
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>