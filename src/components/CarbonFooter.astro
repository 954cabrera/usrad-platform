---
// CarbonFooter.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-white py-12 px-4 sm:px-6 border-t border-gray-100">
  <div class="max-w-7xl mx-auto">
    <!-- Main Footer Content -->
    <div class="grid md:grid-cols-4 gap-8 mb-8">
      <!-- Logo/Mission Column -->
      <div>
        <div class="flex items-center mb-3">
          <a href="/index-carbon">
            <img
              src="/logo/USRad-Logo-final-rev.png"
              alt="USRad"
              class="h-8 w-auto"
            />
          </a>
        </div>
        <p class="text-sm text-gray-600 mb-4">
          Making medical imaging affordable and accessible for everyone.
        </p>
        <!-- Contact -->
        <div class="space-y-2">
          <a
            href="tel:1-800-877-2324"
            class="flex items-center gap-2 text-sm text-gray-600 hover:text-[#003087] transition"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <span>1-800-USRad-24</span>
          </a>
          <a
            href="mailto:hello@usrad.com"
            class="flex items-center gap-2 text-sm text-gray-600 hover:text-[#003087] transition"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>hello@usrad.com</span>
          </a>
        </div>
      </div>

      <!-- Product Links -->
      <div>
        <h4 class="font-semibold mb-3 text-gray-900">Product</h4>
        <ul class="space-y-2 text-sm text-gray-600">
          <li>
            <a
              href="/how-it-works"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              How it works
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
          <li>
            <a
              href="/pricing"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              Pricing
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
          <li>
            <a
              href="/locations"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              Find locations
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
          <li>
            <a
              href="/faq"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              FAQ
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h4 class="font-semibold mb-3 text-gray-900">Company</h4>
        <ul class="space-y-2 text-sm text-gray-600">
          <li>
            <a
              href="/about"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              About us
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
          <li>
            <a
              href="/blog"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              Blog
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
          <li>
            <a
              href="/careers"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              Careers
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              Contact
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="font-semibold mb-3 text-gray-900">Resources</h4>
        <ul class="space-y-2 text-sm text-gray-600">
          <li>
            <a
              href="/employer"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              For Employers
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
          <li>
            <a
              href="/managed-care"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              For Imaging Centers
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
          <li>
            <a
              href="/help"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              Help center
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
          <li>
            <a
              href="/education/what-is-an-mri"
              class="hover:text-[#003087] transition relative group inline-block"
            >
              What is an MRI?
              <span
                class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-[#cc9933] transition-all duration-300 group-hover:w-full"
              ></span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Newsletter Section - Simplified -->
    <div class="bg-gray-50 rounded-xl p-6 mb-8">
      <div class="max-w-xl mx-auto text-center">
        <h3 class="text-lg font-semibold mb-2 text-gray-900">Stay informed</h3>
        <p class="text-sm text-gray-600 mb-4">
          Get healthcare insights and USRad updates.
        </p>
        <form class="flex gap-2 max-w-md mx-auto" action="#" method="POST">
          <input
            type="email"
            placeholder="Enter your email"
            class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#003087] focus:border-transparent"
            required
          />
          <button
            type="submit"
            class="bg-[#003087] text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-[#002266] transition whitespace-nowrap"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Section -->
    <div
      class="pt-8 border-t border-gray-100 flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-gray-600"
    >
      <div class="flex items-center gap-6">
        <p>&copy; {currentYear} USRad</p>
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1 text-xs">
            <svg
              class="w-3 h-3 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            HIPAA Compliant
          </span>
          <span class="inline-flex items-center gap-1 text-xs">
            <svg
              class="w-3 h-3 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            SOC 2 Certified
          </span>
        </div>
      </div>

      <div class="flex items-center gap-6">
        <a href="/privacy-policy" class="hover:text-[#003087] transition"
          >Privacy</a
        >
        <a href="/terms-of-service" class="hover:text-[#003087] transition"
          >Terms</a
        >
        <a href="/accessibility" class="hover:text-[#003087] transition"
          >Accessibility</a
        >
      </div>
    </div>

    <!-- Social Links -->
    <div class="flex justify-center gap-4 mt-8">
      <a
        href="https://linkedin.com/company/usrad"
        class="text-gray-400 hover:text-[#003087] transition"
        aria-label="LinkedIn"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>
      <a
        href="https://twitter.com/usrad"
        class="text-gray-400 hover:text-[#003087] transition"
        aria-label="Twitter"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    font-family:
      "Inter",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
  }
</style>
