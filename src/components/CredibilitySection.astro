---
/**
 * CredibilitySection.astro
 *
 * Clinical credibility section reinforcing accreditation, radiologist
 * credentials, and pricing transparency.
 * Placed between HowItWorksSection and PricingSection on the homepage.
 */
---

<section class="py-20 px-4 sm:px-6 bg-white" data-aos="fade-up">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">
        Trusted by accredited imaging centers nationwide
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        USRad connects patients with ACR-accredited imaging facilities and
        board-certified radiologists across the United States.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-16">
      <div
        class="text-center flex flex-col items-center"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div
          class="w-24 h-24 bg-gray-50 rounded-2xl flex items-center justify-center mb-6"
        >
          <img
            src="/images/icons/social.svg"
            alt="ACR-accredited facilities"
            class="w-12 h-12"
          />
        </div>
        <h3
          class="text-lg font-semibold tracking-tight text-gray-900 mb-3 min-h-[3rem]"
        >
          ACR-Accredited Facilities
        </h3>
        <p class="text-gray-500 leading-relaxed">
          All imaging centers meet nationally recognized accreditation
          standards.
        </p>
      </div>

      <div
        class="text-center flex flex-col items-center"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div
          class="w-24 h-24 bg-gray-50 rounded-2xl flex items-center justify-center mb-6"
        >
          <img
            src="/images/icons/consumer-protection.svg"
            alt="Board-certified radiologists"
            class="w-12 h-12"
          />
        </div>
        <h3
          class="text-lg font-semibold tracking-tight text-gray-900 mb-3 min-h-[3rem]"
        >
          Board-Certified Radiologists
        </h3>
        <p class="text-gray-500 leading-relaxed">
          Your scan is interpreted by experienced radiologists.
        </p>
      </div>

      <div
        class="text-center flex flex-col items-center"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div
          class="w-24 h-24 bg-gray-50 rounded-2xl flex items-center justify-center mb-6"
        >
          <img
            src="/images/icons/trophy.svg"
            alt="Transparent pricing"
            class="w-12 h-12"
          />
        </div>
        <h3
          class="text-lg font-semibold tracking-tight text-gray-900 mb-3 min-h-[3rem]"
        >
          Transparent Pricing
        </h3>
        <p class="text-gray-500 leading-relaxed">
          Clear, upfront pricing with no surprise billing.
        </p>
      </div>
    </div>
  </div>
</section>
