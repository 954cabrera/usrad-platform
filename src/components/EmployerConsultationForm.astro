---
// src/components/EmployerConsultationForm.astro
---

<div class="employer-form-wrapper" id="employerFormWrapper">
  <!-- ─── STAGE 1: Short Lead Form ─── -->
  <div id="formStage">
    <div class="form-header">
      <div class="form-badge">
        <span class="badge-dot"></span>
        <span>Complimentary Executive Briefing</span>
      </div>
      <h3 class="form-title">Request Your Briefing</h3>
      <p class="form-subtitle">
        Speak directly with Michael Cabrera, USRad founder, about reducing your
        imaging costs 50–70%.
      </p>
    </div>

    <form id="employerConsultationForm" class="form" novalidate>
      <!-- Row: First + Last -->
      <div class="form-row">
        <div class="form-group">
          <label for="firstName" class="form-label"
            >First Name <span class="required">*</span></label
          >
          <input
            type="text"
            id="firstName"
            name="firstName"
            class="form-input"
            required
            placeholder="First name"
            autocomplete="given-name"
          />
        </div>
        <div class="form-group">
          <label for="lastName" class="form-label"
            >Last Name <span class="required">*</span></label
          >
          <input
            type="text"
            id="lastName"
            name="lastName"
            class="form-input"
            required
            placeholder="Last name"
            autocomplete="family-name"
          />
        </div>
      </div>

      <!-- Job Title -->
      <div class="form-group">
        <label for="jobTitle" class="form-label"
          >Job Title <span class="required">*</span></label
        >
        <input
          type="text"
          id="jobTitle"
          name="jobTitle"
          class="form-input"
          required
          placeholder="e.g., VP Benefits, HR Director, CFO"
          autocomplete="organization-title"
        />
      </div>

      <!-- Company -->
      <div class="form-group">
        <label for="companyName" class="form-label"
          >Company <span class="required">*</span></label
        >
        <input
          type="text"
          id="companyName"
          name="companyName"
          class="form-input"
          required
          placeholder="Your company name"
          autocomplete="organization"
        />
      </div>

      <!-- Company Size -->
      <div class="form-group">
        <label for="companySize" class="form-label"
          >Company Size <span class="required">*</span></label
        >
        <select
          id="companySize"
          name="companySize"
          class="form-select"
          required
        >
          <option value="">Select employee count</option>
          <option value="500-1000">500–1,000 employees</option>
          <option value="1001-5000">1,001–5,000 employees</option>
          <option value="5001-10000">5,001–10,000 employees</option>
          <option value="10000+">10,000+ employees</option>
        </select>
      </div>

      <!-- Row: Email + Phone -->
      <div class="form-row">
        <div class="form-group">
          <label for="email" class="form-label"
            >Business Email <span class="required">*</span></label
          >
          <input
            type="email"
            id="email"
            name="email"
            class="form-input"
            required
            placeholder="you@company.com"
            autocomplete="work email"
          />
        </div>
        <div class="form-group">
          <label for="phone" class="form-label"
            >Phone <span class="required">*</span></label
          >
          <input
            type="tel"
            id="phone"
            name="phone"
            class="form-input"
            required
            placeholder="(555) 123-4567"
            autocomplete="tel"
          />
        </div>
      </div>

      <!-- Timeline (optional) -->
      <div class="form-group">
        <label for="timeline" class="form-label"
          >Implementation Timeline <span class="optional">(optional)</span
          ></label
        >
        <select id="timeline" name="timeline" class="form-select">
          <option value="">When are you looking to implement?</option>
          <option value="immediate">Immediately</option>
          <option value="1-3-months">1–3 months</option>
          <option value="3-6-months">3–6 months</option>
          <option value="6-12-months">6–12 months</option>
          <option value="exploring">Just exploring options</option>
        </select>
      </div>

      <!-- Error Message -->
      <div id="formError" class="form-error" style="display:none;">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="10"></circle><line
            x1="12"
            y1="8"
            x2="12"
            y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span id="formErrorMsg">Something went wrong. Please try again.</span>
      </div>

      <!-- Submit -->
      <button type="submit" class="submit-btn" id="submitBtn">
        <span class="btn-text">Request Executive Briefing</span>
        <svg
          class="btn-arrow"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </button>

      <p class="submit-note">
        No sales team. You'll schedule directly with Michael Cabrera, USRad
        Founder &amp; President.
      </p>
    </form>
  </div>

  <!-- ─── STAGE 2: Confirmation + Inline Calendly ─── -->
  <div id="schedulingStage" style="display:none;">
    <!-- Two-column layout -->
    <div class="scheduling-grid">
      <!-- LEFT: Confirmation Panel -->
      <div class="confirmation-panel">
        <!-- Status indicators -->
        <div class="status-steps">
          <div class="status-step completed">
            <div class="status-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <span>Request received</span>
          </div>
          <div class="status-step completed">
            <div class="status-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <span>Savings analysis being prepared</span>
          </div>
          <div class="status-step active">
            <div class="status-icon pulse-dot"></div>
            <span>Choose your briefing time</span>
          </div>
        </div>

        <!-- Personalized message -->
        <div class="confirmation-message">
          <h3 class="confirmation-title">
            Consultation Request<br />Received
          </h3>
          <p class="confirmation-body">
            Thank you, <strong id="confirmFirstName">there</strong>. We'll
            prepare a quick analysis of potential imaging savings for <strong
              id="confirmCompany">your organization</strong
            >
            before our discussion.
          </p>
          <p class="confirmation-subtext">
            Select a time below for your <strong
              >30-minute executive briefing</strong
            >.
          </p>
        </div>

        <!-- What we'll cover -->
        <div class="agenda-box">
          <p class="agenda-label">What we'll cover</p>
          <ul class="agenda-list">
            <li>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
              Imaging cost reduction strategies for your workforce
            </li>
            <li>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
              USRad national network overview
            </li>
            <li>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
              30-day implementation path
            </li>
          </ul>
        </div>

        <!-- Founder card -->
        <div class="founder-card">
          <div class="founder-avatar" id="founderAvatar">
            <img
              src="/images/mac-website-sm-profile.webp"
              alt="Michael Cabrera"
              style="width:40px;height:40px;border-radius:50%;object-fit:cover;display:block;"
              onerror="this.style.display='none';document.getElementById('founderInitials').style.display='flex';"
            />
            <span
              id="founderInitials"
              style="display:none;width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#003087 0%,#0050c8 100%);color:#fff;font-size:13px;font-weight:700;align-items:center;justify-content:center;"
              >MC</span
            >
          </div>
          <div>
            <p class="founder-name">Michael Cabrera</p>
            <p class="founder-title">President &amp; Founder, USRad</p>
            <p class="founder-note">
              Founded the managed imaging category · 150,000+ cases managed
            </p>
          </div>
        </div>

        <!-- Reassurance -->
        <p class="reassurance">
          No preparation required. We'll walk you through exactly how USRad
          reduces imaging costs 50–70%.
        </p>
      </div>

      <!-- RIGHT: Floating Calendly Card -->
      <div class="calendly-card" id="calendlyCard">
        <p class="calendly-label">Select a time for your briefing</p>
        <!-- Calendly inline widget — initialized dynamically via initCalendly() -->
        <div id="calendlyContainer" style="min-width:280px;height:660px;"></div>
      </div>
    </div>

    <!-- Fail-safe: shown only if API failed but we still reveal scheduler -->
    <div id="apiFailNotice" style="display:none;" class="api-fail-notice">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="12" cy="12" r="10"></circle><line
          x1="12"
          y1="8"
          x2="12"
          y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span
        >There was an issue submitting your form. Your briefing is still
        available — please book below and we'll follow up directly.</span
      >
    </div>
  </div>
</div>

<script>
  const CALENDLY_BASE = "https://calendly.com/mcabrera-usrad/30min";
  const CALENDLY_SCRIPT =
    "https://assets.calendly.com/assets/external/widget.js";

  function buildCalendlyUrl(name, email, phone) {
    const p = new URLSearchParams({
      hide_event_type_details: "1",
      hide_gdpr_banner: "1",
      primary_color: "003087",
    });
    if (name) p.set("name", name);
    if (email) p.set("email", email);
    if (phone) p.set("a2", phone);
    return `${CALENDLY_BASE}?${p.toString()}`;
  }

  function injectCalendly(name, email, phone) {
    const container = document.getElementById("calendlyContainer");
    if (!container) return;
    // Clear any previous instance
    container.innerHTML = "";
    // Build widget div
    const widget = document.createElement("div");
    widget.className = "calendly-inline-widget";
    widget.setAttribute("data-url", buildCalendlyUrl(name, email, phone));
    widget.style.minWidth = "280px";
    widget.style.height = "660px";
    container.appendChild(widget);
    // Inject script fresh — remove old one first
    const oldScript = document.getElementById("calendlyScript");
    if (oldScript) oldScript.remove();
    const script = document.createElement("script");
    script.id = "calendlyScript";
    script.src = CALENDLY_SCRIPT;
    script.async = true;
    document.body.appendChild(script);
  }

  const form = document.getElementById("employerConsultationForm");
  const formStage = document.getElementById("formStage");
  const schedulingStage = document.getElementById("schedulingStage");
  const submitBtn = document.getElementById("submitBtn");
  const formError = document.getElementById("formError");
  const formErrorMsg = document.getElementById("formErrorMsg");
  const apiFailNotice = document.getElementById("apiFailNotice");

  // Phone auto-format
  document.getElementById("phone")?.addEventListener("input", function (e) {
    const digits = e.target.value.replace(/\D/g, "").slice(0, 10);
    if (digits.length >= 7) {
      e.target.value = `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
    } else if (digits.length >= 4) {
      e.target.value = `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
    } else if (digits.length >= 1) {
      e.target.value = `(${digits}`;
    }
  });

  function showSchedulingStage(apiSucceeded, skipCalendlyInit) {
    // Populate personalized fields
    const firstName = document.getElementById("firstName")?.value?.trim() || "";
    const lastName = document.getElementById("lastName")?.value?.trim() || "";
    const company = document.getElementById("companyName")?.value?.trim() || "";
    const email = document.getElementById("email")?.value?.trim() || "";
    const phone = document.getElementById("phone")?.value?.trim() || "";
    if (firstName)
      document.getElementById("confirmFirstName").textContent = firstName;
    if (company)
      document.getElementById("confirmCompany").textContent = company;

    // Initialize Calendly only if not already done (e.g. continue=1 path does it first)
    if (!skipCalendlyInit) {
      const _fullName = (
        lastName ? `${firstName} ${lastName}` : firstName
      ).replace(/\+/g, " ");
      const _phone = phone.replace(/\+/g, " ");
      initCalendly(_fullName, email, _phone);
    }

    // Hide form
    formStage.style.display = "none";

    // Show scheduling stage
    schedulingStage.style.display = "block";
    schedulingStage.style.opacity = "0";

    // If API failed, show fail notice
    if (!apiSucceeded) {
      apiFailNotice.style.display = "flex";
    }

    // Staggered reveal: confirmation panel fades in first
    requestAnimationFrame(() => {
      schedulingStage.style.transition = "opacity 0.5s ease";
      schedulingStage.style.opacity = "1";
    });

    // Calendly card fades in after 800ms
    const calendlyCard = document.getElementById("calendlyCard");
    calendlyCard.style.opacity = "0";
    calendlyCard.style.transform = "translateY(16px)";
    setTimeout(() => {
      calendlyCard.style.transition = "opacity 0.6s ease, transform 0.6s ease";
      calendlyCard.style.opacity = "1";
      calendlyCard.style.transform = "translateY(0)";
    }, 800);

    // Scroll to scheduling stage with navbar offset
    setTimeout(() => {
      const target = document.getElementById("schedulingStage");
      if (target) {
        const top =
          target.getBoundingClientRect().top + window.scrollY - 88 - 24;
        window.scrollTo({ top, behavior: "smooth" });
      }
    }, 400);

    // Dispatch event so parent page can expand the layout
    window.dispatchEvent(new CustomEvent("usrad:schedulingReady"));
  }

  // ?continue=1 — skip form, show scheduler directly (email CTA return flow)
  const _urlParams = new URLSearchParams(window.location.search);
  if (_urlParams.get("continue") === "1") {
    const _fn = _urlParams.get("fn");
    const _co = _urlParams.get("co");
    const _em = _urlParams.get("em");
    const _ph = _urlParams.get("ph");
    if (_fn) document.getElementById("confirmFirstName").textContent = _fn;
    if (_co) document.getElementById("confirmCompany").textContent = _co;

    // Initialize Calendly dynamically with URL param prefill data
    const _fullName = _fn
      ? _urlParams.get("ln")
        ? `${_fn} ${_urlParams.get("ln")}`
        : _fn
      : "";
    initCalendly(
      _fullName.replace(/\+/g, " "),
      _em || "",
      (_ph || "").replace(/\+/g, " "),
    );

    // Dispatch early so schedule.astro can expand layout before reveal
    window.dispatchEvent(new CustomEvent("usrad:schedulingReady"));
    showSchedulingStage(true, true);
  }

  form?.addEventListener("submit", async function (e) {
    e.preventDefault();
    formError.style.display = "none";

    // Validate phone
    const phoneDigits = document
      .getElementById("phone")
      .value.replace(/\D/g, "");
    if (phoneDigits.length !== 10) {
      formErrorMsg.textContent = "Please enter a valid 10-digit phone number.";
      formError.style.display = "flex";
      document.getElementById("phone").focus();
      return;
    }

    // Loading state
    submitBtn.disabled = true;
    submitBtn.querySelector(".btn-text").textContent = "Submitting...";
    submitBtn.querySelector(".btn-arrow").style.display = "none";

    // Collect form data
    const formData = new FormData(form);
    const data = {};
    formData.forEach((value, key) => {
      data[key] = value;
    });

    // Add derived fields for compatibility with existing API
    data.industry = "not-disclosed";
    data.imagingChallenges = [];
    data.annualBudget = "not-disclosed";
    data.specificNeeds = "";

    try {
      const response = await fetch("/api/employer-consultation", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (!response.ok) throw new Error("API error");

      // SUCCESS — lead captured, show scheduling
      showSchedulingStage(true);
    } catch (err) {
      // FAIL-SAFE — show scheduler anyway, show fail notice
      console.error("Employer consultation API error:", err);
      showSchedulingStage(false);
    }
  });
  function initCalendly(name, email, phone) {
    const container = document.getElementById("calendlyContainer");
    if (!container) return;
    container.innerHTML = "";

    const params = new URLSearchParams({
      hide_event_type_details: "1",
      hide_gdpr_banner: "1",
      primary_color: "003087",
    });
    if (name) params.set("name", name.replace(/\+/g, " ").trim());
    if (email) params.set("email", email);
    // Phone cannot be prefilled via Calendly URL params

    const calendlyUrl =
      "https://calendly.com/mcabrera-usrad/30min?" + params.toString();

    if (!window.Calendly) {
      const script = document.createElement("script");
      script.src = "https://assets.calendly.com/assets/external/widget.js";
      script.onload = () => {
        Calendly.initInlineWidget({
          url: calendlyUrl,
          parentElement: container,
        });
      };
      document.body.appendChild(script);
    } else {
      Calendly.initInlineWidget({
        url: calendlyUrl,
        parentElement: container,
      });
    }
  }
</script>

<style>
  /* ── Wrapper ── */
  .employer-form-wrapper {
    width: 100%;
  }

  /* ── Form Stage ── */
  .form-header {
    margin-bottom: 28px;
  }

  .form-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #f0f7ff;
    border: 1px solid #c3dafe;
    color: #003087;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 100px;
    margin-bottom: 14px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background: #22c55e;
    border-radius: 50%;
    animation: blink 1.8s ease-in-out infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .form-title {
    font-size: 22px;
    font-weight: 700;
    color: #003087;
    margin: 0 0 6px;
  }

  .form-subtitle {
    font-size: 14px;
    color: #555;
    margin: 0;
    line-height: 1.5;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-size: 13px;
    font-weight: 600;
    color: #003087;
  }

  .required {
    color: #cc3333;
  }
  .optional {
    color: #888;
    font-weight: 400;
  }

  .form-input,
  .form-select {
    width: 100%;
    padding: 11px 14px;
    border: 1.5px solid #dde3ed;
    border-radius: 8px;
    font-size: 15px;
    color: #1a1a2e;
    background: #fff;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
    font-family: inherit;
    box-sizing: border-box;
  }

  .form-input:focus,
  .form-select:focus {
    outline: none;
    border-color: #cc9933;
    box-shadow: 0 0 0 3px rgba(204, 153, 51, 0.12);
  }

  .form-input::placeholder {
    color: #aab;
  }

  .form-error {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff5f5;
    border: 1px solid #fecaca;
    color: #dc2626;
    font-size: 13px;
    padding: 10px 14px;
    border-radius: 8px;
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: linear-gradient(135deg, #cc9933 0%, #b8861f 100%);
    color: #fff;
    border: none;
    padding: 15px 28px;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    box-shadow: 0 4px 16px rgba(204, 153, 51, 0.35);
    width: 100%;
    font-family: inherit;
  }

  .submit-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(204, 153, 51, 0.45);
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .submit-note {
    font-size: 12px;
    color: #888;
    text-align: center;
    margin: 0;
    line-height: 1.5;
  }

  /* ── Scheduling Stage ── */
  .scheduling-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 40px;
    align-items: start;
  }

  /* ── Confirmation Panel (left) ── */
  .confirmation-panel {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 4px;
  }

  .status-steps {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .status-step {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: #555;
  }

  .status-step.completed {
    color: #16a34a;
  }
  .status-step.active {
    color: #003087;
    font-weight: 600;
  }

  .status-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #dcfce7;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #16a34a;
  }

  .status-step.active .status-icon {
    background: #003087;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #fff;
    border-radius: 50%;
    animation: blink 1.4s ease-in-out infinite;
  }

  .confirmation-message {
    border-left: 3px solid #cc9933;
    padding-left: 16px;
