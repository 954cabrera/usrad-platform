---
export interface Props {
  image: string;
  name: string;
  title: string;
  highlights: { label: string; value: string }[];
  bio: string[];
  cta: { label: string; href: string };
}

const { image, name, title, highlights, bio, cta } = Astro.props;
---

<div class="bg-white rounded-3xl p-8 shadow-xl" data-aos="fade-up">
  <div class="text-center mb-6">
    <img
      src={image}
      alt={name}
      class="w-48 h-48 object-cover rounded-full mx-auto shadow-xl mb-6"
    />
    <h3 class="text-2xl md:text-3xl font-bold text-[#003087] mb-2">{name}</h3>
    <p class="text-lg text-[#cc9933] font-bold mb-4">{title}</p>

    <div class="grid grid-cols-2 gap-4 mb-6">
      {
        highlights.map((h) => (
          <div class="bg-[#f0f4f9] rounded-xl p-4">
            <div class="text-2xl font-bold text-[#cc9933]">{h.value}</div>
            <div class="text-sm text-[#003087]">{h.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="space-y-4 text-[#003087]/90">
    {bio.map((p) => <p set:html={p} />)}
  </div>

  <div class="mt-8 text-center">
    <a
      href={cta.href}
      class="inline-block px-8 py-4 bg-[#003087] text-white rounded-full font-bold hover:bg-[#002266] transition-colors border-l-4 border-[#cc9933]"
    >
      {cta.label} →
    </a>
  </div>
</div>
