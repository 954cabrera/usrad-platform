---
import FounderCard from "./FounderCard.astro";
---

<!-- Founders Section - CONCISE VERSION -->
<section class="py-20 px-4 sm:px-6 bg-gradient-to-br from-[#fefbf5] to-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h2
        class="text-4xl md:text-5xl font-bold text-gray-900 mb-4"
        data-aos="fade-up"
      >
        Meet the Healthcare Innovators
      </h2>
      <p class="text-xl text-gray-600" data-aos="fade-up" data-aos-delay="100">
        The visionary team that revolutionized medical imaging access and
        delivered $400 Million+ in healthcare savings
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12 max-w-4xl mx-auto">
      <!-- Michael Cabrera -->
      <div class="text-center" data-aos="zoom-in" data-aos-delay="100">
        <img
          src="/images/michael.jpg"
          alt="Michael Cabrera"
          class="w-48 h-48 rounded-full mx-auto mb-6 shadow-xl object-cover"
        />
        <h3 class="text-2xl font-bold text-gray-900 mb-2">Michael Cabrera</h3>
        <p class="text-[#cc9933] font-semibold mb-4">Founder & CEO</p>

        <!-- Just the impact numbers -->
        <div class="flex justify-center gap-8 mb-6">
          <div>
            <p class="text-3xl font-bold text-[#003087]">1,236%</p>
            <p class="text-sm text-gray-600">Growth Achieved</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-[#cc9933]">$400M+</p>
            <p class="text-sm text-gray-600">Value Created</p>
          </div>
        </div>

        <a
          href="/about/michael-cabrera"
          class="inline-block bg-[#003087] text-white px-6 py-3 rounded-lg font-medium hover:bg-[#002266] transition"
        >
          Read Michael's Full Story →
        </a>
      </div>

      <!-- Donna Cabrera -->
      <div class="text-center" data-aos="zoom-in" data-aos-delay="200">
        <img
          src="/images/donna.webp"
          alt="Donna Cabrera"
          class="w-48 h-48 rounded-full mx-auto mb-6 shadow-xl object-cover"
        />
        <h3 class="text-2xl font-bold text-gray-900 mb-2">Donna Cabrera</h3>
        <p class="text-[#cc9933] font-semibold mb-4">
          Co-Founder & Patient Advocacy Advisor
        </p>

        <!-- Just the impact numbers -->
        <div class="flex justify-center gap-8 mb-6">
          <div>
            <p class="text-3xl font-bold text-[#003087]">400K+</p>
            <p class="text-sm text-gray-600">Patients Served</p>
          </div>
          <div>
            <p class="text-3xl font-bold text-[#cc9933]">99.8%</p>
            <p class="text-sm text-gray-600">Satisfaction Rate</p>
          </div>
        </div>

        <a
          href="/about/donna-cabrera"
          class="inline-block bg-[#003087] text-white px-6 py-3 rounded-lg font-medium hover:bg-[#002266] transition"
        >
          Learn About Donna's Role →
        </a>
      </div>
    </div>
  </div>
</section>
