  // ============================================
  // Optimized Search with Caching + Smooth Transitions
  // ============================================
  // ============================================
  // Optimized Search (Anti-Flicker Version)
  // ============================================
  let lastQuery = "";
  let lastResults = [];
  let isLoading = false;

  async function performSearch(query) {
    if (!query || query.length < 2) {
      showPopularProceduresFromLibrary();
      return;
    }

    // Reuse cache instantly
    if (query === lastQuery && lastResults.length > 0) {
      renderResults(lastResults, true);
      return;
    }

    // Prevent overlapping searches
    if (isLoading) return;
    isLoading = true;

    // Keep old results visible during fetch (no opacity = 0 here)
    if (popularSection) popularSection.classList.add("hidden");
    if (searchSection) searchSection.classList.remove("hidden");
    if (emptyState) emptyState.classList.add("hidden");

    // Subtle shimmer overlay instead of blank state
    if (searchList) {
      const shimmer = document.createElement("div");
      shimmer.className =
        "absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent animate-pulse pointer-events-none";
      shimmer.style.borderRadius = "inherit";
      searchList.appendChild(shimmer);
    }

    try {
      currentQuery = query;
      const results = await hybridSearch(query);
      lastQuery = query;
      lastResults = results;

      // Render new results smoothly
      renderResults(results);
      if (searchList) {
        searchList.style.opacity = 0.9;
        requestAnimationFrame(() => (searchList.style.opacity = 1));
      }
    } catch (err) {
      console.error("Search error:", err);
    } finally {
      isLoading = false;
      const shimmer = searchList?.querySelector(".animate-pulse");
      if (shimmer) shimmer.remove();
    }
  }

  function renderResults(results, fromCache = false) {
    if (results.length === 0) {
      searchSection?.classList.add("hidden");
      emptyState?.classList.remove("hidden");
      return;
    }

    if (resultsCount) resultsCount.textContent = results.length;

    if (searchList) {
      // Only update if content actually changed
      const html = renderGroupedResults(results);
      if (searchList.innerHTML !== html) {
        searchList.innerHTML = html;
        attachResultHandlers();
      }
    }

    // Cached draws skip fade entirely
    if (fromCache && searchList) {
      searchList.style.opacity = 1;
    }
  }

