---
// HeroSection.astro - Hybrid Progressive Disclosure Hero
// Pure JavaScript implementation - No TypeScript in scripts
interface Props {
  remixUrl: string;
}

const { remixUrl } = Astro.props;
---

<section
  class="relative pt-40 pb-24 px-4 sm:px-6 bg-[#003087] text-white overflow-hidden"
  style="margin-top: -32px;"
  data-aos="fade-up"
>
  <!-- Video Background -->
  <div class="absolute inset-0 z-0">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover"
      poster="/images/home-hero-mri.webp?v=2.1"
    >
      <source
        src="/videos/home-hero-mri-mobile.mp4"
        type="video/mp4"
        media="(max-width: 768px)"
      />
      <source src="/videos/home-hero-mri.mp4" type="video/mp4" />
      <source src="/videos/home-hero-mri.webm" type="video/webm" />
    </video>
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/40"
    >
    </div>
  </div>

  <!-- Gradient blobs -->
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-full blur-3xl opacity-30 z-10"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-96 h-96 bg-gradient-to-br from-[#cc9933]/20 to-orange-500/20 rounded-full blur-3xl opacity-20 z-10"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-20">
    <div class="max-w-5xl mx-auto text-center">
      <!-- Main Headline -->
      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-8 text-white leading-tight tracking-tight"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <span class="block">Same Radiologists.</span>
        <span class="block">Same Scanners.</span>
        <span class="text-[#cc9933] relative inline-block">
          70% Less
          <svg
            class="absolute -bottom-2 sm:-bottom-3 left-0 w-full"
            height="20"
            viewBox="0 0 200 20"
            preserveAspectRatio="none"
          >
            <path
              d="M 2 14 Q 50 4 100 14 Q 150 24 198 14"
              stroke="#cc9933"
              stroke-width="5"
              fill="none"
              class="animate-draw-line drop-shadow-md"
              stroke-linecap="round"
              opacity="0.8"></path>
          </svg>
        </span>
        <span class="text-white">.</span>
      </h1>

      <!-- Subheadline -->
      <p
        class="text-xl sm:text-2xl md:text-3xl text-white/90 max-w-3xl mx-auto leading-relaxed drop-shadow-lg mb-12"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <span class="block">Book in minutes. Get scanned this week.</span>
        <span class="block">Pay hundreds, not thousands.</span>
      </p>

      <!-- STEP 1: Inline Search with Dropdown -->
      <div
        id="hero-step-1"
        class="relative z-[9999] max-w-3xl mx-auto mb-16 sm:mb-24 transition-all duration-500"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <!-- Search Input Container -->
        <div class="relative">
          <div
            class="bg-white/90 backdrop-blur-md border-2 border-white/60 shadow-lg rounded-xl flex flex-col sm:flex-row items-stretch overflow-hidden"
          >
            <!-- Real Search Input (not readonly anymore) -->
            <input
              type="text"
              id="hero-search-input"
              placeholder="Type MRI, CT, Ultrasound..."
              autocomplete="off"
              class="flex-1 px-6 py-4 sm:py-5 text-base sm:text-lg text-gray-900 placeholder-gray-500 bg-transparent focus:outline-none focus:ring-2 focus:ring-[#003087]/20 transition-all"
              aria-label="Search for medical procedures"
              aria-autocomplete="list"
              aria-controls="search-dropdown"
              aria-expanded="false"
            />
            <button
              type="button"
              id="hero-find-button"
              class="bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-8 py-4 sm:py-5 font-bold text-base sm:text-lg transition-all duration-300 hover:brightness-110"
            >
              <span class="flex items-center justify-center gap-2">
                Find
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </span>
            </button>
          </div>
        </div>
      </div>

      <!-- STEP 2: Horizontal Compact Layout (Hidden Initially) -->
      <div
        id="hero-step-2"
        class="hidden relative z-50 max-w-4xl mx-auto mb-16 sm:mb-24 transition-all duration-500"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <form
          action={`${remixUrl}/pbs/search`}
          method="GET"
          id="hero-search-form"
        >
          <!-- Compact Horizontal Row -->
          <div
            class="bg-white/90 backdrop-blur-md border-2 border-white/60 shadow-lg rounded-xl overflow-hidden"
          >
            <!-- Mobile: Stack Vertically -->
            <div class="flex flex-col sm:hidden">
              <!-- Selected Procedure Pill - Mobile -->
              <div class="p-4 border-b border-gray-200">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2 flex-1 min-w-0">
                    <div
                      class="flex-shrink-0 w-8 h-8 bg-green-500 rounded-full flex items-center justify-center"
                    >
                      <svg
                        class="w-5 h-5 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="3"
                          d="M5 13l4 4L19 7"></path>
                      </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-xs font-medium text-gray-500 mb-0.5">
                        Selected
                      </p>
                      <p
                        id="selected-procedure-display-mobile"
                        class="text-sm font-semibold text-gray-900 truncate"
                      >
                      </p>
                    </div>
                  </div>
                  <button
                    type="button"
                    id="change-procedure-button-mobile"
                    class="flex-shrink-0 text-xs font-medium text-[#003087] hover:text-[#cc9933] transition-colors px-3 py-1.5 rounded-lg hover:bg-gray-100"
                  >
                    Change
                  </button>
                </div>
              </div>

              <!-- ZIP Input - Mobile -->
              <div class="relative p-4 border-b border-gray-200">
                <label
                  for="hero-zip-input-mobile"
                  class="block text-xs font-medium text-gray-500 mb-2"
                  >ZIP Code</label
                >
                <div class="relative">
                  <input
                    type="text"
                    id="hero-zip-input-mobile"
                    name="zip"
                    placeholder="Enter ZIP code"
                    inputmode="numeric"
                    pattern="[0-9]{5}"
                    maxlength="5"
                    class="w-full px-4 py-3 text-base text-gray-900 placeholder-gray-400 border border-gray-300 rounded-lg focus:outline-none focus:border-[#003087] focus:ring-2 focus:ring-[#003087]/20 transition-all pr-10"
                  />
                  <button
                    type="button"
                    id="hero-detect-location-mobile"
                    class="absolute inset-y-0 right-0 pr-3 flex items-center text-[#003087] hover:text-[#cc9933] transition-all"
                    title="Detect location"
                  >
                    <svg
                      id="location-icon-mobile"
                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                      ></path>
                    </svg>
                    <svg
                      id="location-loading-mobile"
                      class="w-5 h-5 animate-spin hidden"
                      fill="none"
                      viewBox="0 0 24 24"
                    >
                      <circle
                        class="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="4"></circle>
                      <path
                        class="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                      ></path>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Submit Button - Mobile -->
              <div class="p-4 relative">
                <button
                  type="submit"
                  id="hero-search-button-mobile"
                  class="w-full bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-6 py-4 rounded-lg font-bold text-base transition-all duration-300 hover:brightness-110 hover:shadow-lg hover:from-[#d7a53f] hover:to-[#b98c2f] disabled:opacity-50 disabled:cursor-not-allowed"
                  disabled
                >
                  <span
                    class="flex items-center justify-center gap-2 relative z-10"
                  >
                    <span id="button-text">Find Centers</span>
                    <svg
                      class="w-5 h-5 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                  </span>
                </button>
              </div>
            </div>

            <!-- Desktop: Refined Unified Hero Search Bar (with fade-in container) -->
            <div id="hero-search-container"></div>
            <div
              class="hidden sm:flex items-stretch bg-white/90 backdrop-blur-md rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.04)] border border-gray-200 overflow-hidden w-full max-w-4xl mx-auto"
            >
              <!-- Selected Procedure -->
              <div
                class="flex flex-col justify-center flex-1 px-6 py-3 border-r border-gray-200"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="flex-shrink-0 w-10 h-10 bg-green-500 rounded-full flex items-center justify-center shadow-sm"
                  >
                    <svg
                      class="w-6 h-6 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="3"
                        d="M5 13l4 4L19 7"></path>
                    </svg>
                  </div>

                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-medium text-gray-500 mb-0.5">
                      Selected Procedure
                    </p>
                    <p
                      id="selected-procedure-display"
                      class="text-base font-semibold text-gray-900 truncate"
                    >
                    </p>
                    <p class="text-xs text-gray-500 mt-1 leading-snug">
                      You’ll compare prices and book instantly — no payment
                      until appointment is confirmed.
                    </p>
                  </div>

                  <button
                    type="button"
                    id="change-procedure-button"
                    class="flex-shrink-0 flex items-center gap-1.5 text-[#003087] hover:text-[#cc9933] font-medium text-sm transition-all px-3 py-1.5 rounded-lg hover:bg-gray-100"
                  >
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                      ></path>
                    </svg>
                    Change
                  </button>
                </div>
              </div>

              <!-- ZIP Input -->
              <div
                class="flex flex-col justify-center px-6 py-3 border-r border-gray-200 min-w-[180px]"
              >
                <label
                  for="hero-zip-input"
                  class="block text-xs font-medium text-gray-500 mb-1"
                  >ZIP Code</label
                >
                <div class="relative">
                  <input
                    type="text"
                    id="hero-zip-input"
                    name="zip"
                    placeholder="12345"
                    inputmode="numeric"
                    pattern="[0-9]{5}"
                    maxlength="5"
                    class="w-full px-3 py-2 text-center text-lg font-semibold text-gray-900 placeholder-gray-400 border border-gray-300 rounded-lg focus:outline-none focus:border-[#003087] focus:ring-2 focus:ring-[#003087]/20 transition-all"
                  />
                  <button
                    type="button"
                    id="hero-detect-location"
                    class="absolute right-2 top-1/2 -translate-y-1/2 text-[#003087] hover:text-[#cc9933] transition-transform hover:scale-110"
                    title="Detect location"
                  >
                    <svg
                      id="location-icon"
                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                      ></path>
                    </svg>
                    <svg
                      id="location-loading"
                      class="w-5 h-5 animate-spin hidden"
                      fill="none"
                      viewBox="0 0 24 24"
                    >
                      <circle
                        class="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="4"></circle>
                      <path
                        class="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                      ></path>
                    </svg>
                  </button>
                </div>
                <p id="zip-hint" class="text-gray-500 text-xs mt-1">
                  Enter ZIP to continue
                </p>
              </div>

              <!-- Find Centers Button -->
              <div class="flex items-center justify-center p-3.5">
                <button
                  type="submit"
                  id="hero-search-button"
                  class="relative h-full bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-6 py-3.5 font-bold text-lg transition-all duration-300 hover:brightness-110 hover:shadow-lg hover:from-[#d7a53f] hover:to-[#b98c2f] disabled:opacity-50 disabled:cursor-not-allowed overflow-hidden group rounded-lg"
                  disabled
                >
                  <span
                    class="flex items-center justify-center gap-2 relative z-10"
                  >
                    <span id="button-text">Find Centers</span>
                    <svg
                      class="w-5 h-5 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                  </span>
                </button>
              </div>
            </div>
          </div>
        </form>
        <!-- /#hero-search-container -->

        <!-- Status Message Below -->
        <div id="zip-status-message" class="mt-3 text-center">
          <p class="text-sm text-white/80"></p>
        </div>

        <!-- Hidden Form Fields -->
        <input
          type="hidden"
          name="procedure"
          id="hero-selected-procedure"
          value=""
        />
        <input type="hidden" name="cpt" id="hero-selected-cpt" value="" />
        <input type="hidden" name="state" value="" />
        <input type="hidden" name="radius" value="10" />
      </div>
    </div>

    <!-- Trust Indicators -->
    <div
      class="flex flex-wrap justify-center gap-4 sm:gap-6 md:gap-8 text-sm sm:text-base text-white font-semibold drop-shadow-lg"
      data-aos="fade-up"
      data-aos-delay="500"
    >
      <div class="flex items-center gap-2">
        <svg
          class="flex-shrink-0 w-5 h-5 text-green-400"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        <span>No insurance required</span>
      </div>
      <div class="flex items-center gap-2">
        <svg
          class="flex-shrink-0 w-5 h-5 text-green-400"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        <span>Upfront pricing</span>
      </div>
      <div class="flex items-center gap-2">
        <svg
          class="flex-shrink-0 w-5 h-5 text-green-400"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        <span>1,500+ locations</span>
      </div>
    </div>
  </div>
</section>

<!-- DROPDOWN PORTAL - Positioned outside hero section for proper z-index -->
<div
  id="search-dropdown"
  class="hidden fixed bg-white rounded-xl shadow-[0_4px_12px_rgba(0,0,0,0.08),0_12px_28px_rgba(0,0,0,0.10)] border border-gray-200 overflow-hidden max-h-[70vh] z-[9999] backdrop-blur-sm"
  role="listbox"
  aria-label="Procedure search results"
>
  <!-- Popular Procedures Section -->
  <div id="popular-procedures-section" class="hidden relative">
    <div
      class="px-4 py-3 bg-gradient-to-r from-[#fff5e3] via-[#fffaf5] to-white border-b border-[#f5e4c3] flex items-center justify-between"
    >
      <div>
        <h3
          class="text-sm font-semibold text-[#b8862d] flex items-center gap-2"
        >
          ⭐ Popular Procedures
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Or start typing to search...</p>
      </div>
      <span class="text-xs text-[#b8862d]/80 font-medium">Curated by USRad</span
      >
    </div>

    <div
      id="popular-procedures-list"
      class="overflow-y-auto max-h-[420px] px-3 py-2.5"
    >
      <!-- Popular procedures rendered here -->
    </div>

    <!-- Gentle fade indicator -->
    <div
      class="pointer-events-none absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-white to-transparent rounded-b-xl"
    >
    </div>
  </div>

  <!-- Search Results Section -->
  <div id="search-results-section" class="hidden relative">
    <div
      class="px-4 py-3 bg-gradient-to-r from-blue-50 to-white border-b border-gray-200"
    >
      <h3 class="text-sm font-semibold text-gray-700">
        <span id="results-count">0</span> Results
      </h3>
    </div>

    <div
      id="search-results-list"
      class="overflow-y-auto max-h-[420px] px-3 py-2.5"
    >
      <!-- Search results rendered here -->
    </div>

    <!-- Gentle fade indicator -->
    <div
      class="pointer-events-none absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-white to-transparent rounded-b-xl"
    >
    </div>
  </div>

  <!-- Empty State -->
  <div id="empty-state" class="hidden text-center py-12 px-4">
    <svg
      class="w-16 h-16 mx-auto mb-4 text-gray-300"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <p class="text-base font-semibold text-gray-700 mb-1">
      No procedures found
    </p>
    <p class="text-sm text-gray-500">Try a different search term</p>
  </div>
</div>

<!-- Soft gradient fade at dropdown bottom -->
<div
  class="pointer-events-none absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-[#fff8ee] to-transparent rounded-b-xl z-[10000]"
>
</div>

<!-- Search Backdrop Blur - only affects content below hero -->
<div
  id="search-backdrop"
  class="hidden fixed inset-0 pointer-events-none"
  style="z-index: 9998;"
  aria-hidden="true"
>
</div>

<script>
  // Calculate scrollbar width to prevent layout shift when locking scroll
  if (typeof window !== "undefined") {
    const scrollbarWidth =
      window.innerWidth - document.documentElement.clientWidth;
    document.documentElement.style.setProperty(
      "--scrollbar-width",
      `${scrollbarWidth}px`
    );
  }

  // ========================================
  // SELF-CONTAINED INLINE SEARCH
  // No external imports needed
  // ========================================

  const MODALITY_COLORS = {
    MRI: {
      bg: "bg-blue-500",
      text: "text-blue-600",
      lightBg: "bg-blue-50",
      border: "border-blue-200",
    },
    CT: {
      bg: "bg-teal-500",
      text: "text-teal-600",
      lightBg: "bg-teal-50",
      border: "border-teal-200",
    },
    "X-Ray": {
      bg: "bg-amber-500",
      text: "text-amber-600",
      lightBg: "bg-amber-50",
      border: "border-amber-200",
    },
    Ultrasound: {
      bg: "bg-sky-500",
      text: "text-sky-600",
      lightBg: "bg-sky-50",
      border: "border-sky-200",
    },
  };

  // Universal search engine (self-contained)
  function normalizeText(str) {
    return (str || "")
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, "")
      .replace(/\s+/g, " ")
      .trim();
  }

  function searchUniversalProcedures(query, limit = 12) {
    if (!query || query.length < 2) return [];

    // --- Normalize reversed modality order (e.g., "knee MRI" → "MRI knee") ---
    const modalitySwapMap = {
      mri: ["mri", "mr"],
      ct: ["ct"],
      xray: ["xray", "x-ray", "x ray"],
      ultrasound: ["ultrasound", "sono", "sonogram"],
    };

    for (const [modality, variants] of Object.entries(modalitySwapMap)) {
      for (const v of variants) {
        const regex = new RegExp(`^(\\w+)\\s+${v}$`, "i");
        if (regex.test(query.trim())) {
          query = `${v} ${RegExp.$1}`.trim();
          break;
        }
      }
    }

    const lib = window.ProcedureLibrary;
    if (!lib) return [];

    const results = [];
    const lowerQuery = normalizeText(query);
    const queryWords = lowerQuery.split(/\s+/).filter((w) => w.length > 0);

    for (const modality in lib) {
      for (const region in lib[modality]) {
        const entry = lib[modality][region];
        const procedures = entry.procedures || entry.viewOptions || [];

        procedures.forEach((proc) => {
          const searchText = normalizeText(
            `${proc.label} ${modality} ${region} ${proc.cpt} ${(entry.matchKeywords || []).join(" ")}`
          );

          // Check if all query words exist in searchText
          const allWordsMatch = queryWords.every((word) =>
            searchText.includes(word)
          );

          if (allWordsMatch) {
            // Score based on how early the first match appears
            const firstWordIndex = searchText.indexOf(queryWords[0]);
            const score =
              firstWordIndex === 0 ? 100 : 50 - Math.min(firstWordIndex, 40);
            results.push({
              label: proc.label,
              cpt: proc.cpt,
              modality: modality,
              bodyPart: region,
              score: score,
            });
          }
        });
      }
    }

    return results.sort((a, b) => b.score - a.score).slice(0, limit);
  }

  // Popular procedures generator
  function getPopularProcedures(limit = 50) {
    const lib = window.ProcedureLibrary;
    if (!lib) {
      console.error("ProcedureLibrary not loaded");
      return [];
    }

    const items = [];
    for (const modality in lib) {
      for (const region in lib[modality]) {
        const entry = lib[modality][region];
        const procedures = entry.procedures || [];

        procedures.slice(0, 2).forEach((proc) => {
          items.push({
            label: proc.label,
            cpt: proc.cpt,
            modality: modality,
            bodyPart: region,
          });
        });
      }
    }

    return items.sort(() => Math.random() - 0.5).slice(0, limit);
  }

  // Local search
  function searchLocalProcedures(query, limit = 12) {
    if (!query || query.length < 2) return [];

    const lib = window.ProcedureLibrary;
    if (!lib) return [];

    const results = [];
    const lowerQuery = query.toLowerCase();

    for (const modality in lib) {
      for (const region in lib[modality]) {
        const entry = lib[modality][region];
        const procedures = entry.procedures || [];

        procedures.forEach((proc) => {
          const searchText =
            `${proc.label} ${modality} ${region} ${proc.cpt} ${(entry.matchKeywords || []).join(" ")}`.toLowerCase();
          if (searchText.includes(lowerQuery)) {
            results.push({
              label: proc.label,
              cpt: proc.cpt,
              modality: modality,
              bodyPart: region,
              score: searchText.indexOf(lowerQuery) === 0 ? 10 : 1,
            });
          }
        });
      }
    }

    return results.sort((a, b) => b.score - a.score).slice(0, limit);
  }

  // Hybrid search
  async function hybridSearch(query) {
    console.log("Hybrid search:", query);

    const localResults = searchLocalProcedures(query, 12);
    console.log("Local results:", localResults.length);

    if (localResults.length < 6) {
      console.log("Adding universal search results");
      const universalResults = searchUniversalProcedures(query, 12);

      const merged = [...localResults];
      universalResults.forEach((uResult) => {
        if (!merged.find((m) => m.cpt === uResult.cpt)) {
          merged.push(uResult);
        }
      });

      return merged.slice(0, 12);
    }

    return localResults;
  }

  // ✅ Highlight matched query in labels
  function highlightMatch(label, query) {
    if (!query) return label;
    const safeQuery = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const regex = new RegExp(`(${safeQuery})`, "ig");
    return label.replace(
      regex,
      '<mark class="bg-yellow-200 text-gray-900">$1</mark>'
    );
  }

