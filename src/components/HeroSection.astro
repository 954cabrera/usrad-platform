  @keyframes draw-line {
    from {
      stroke-dashoffset: 200;
      opacity: 0;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 0.8;
    }
  }

  .animate-draw-line {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: draw-line 1.5s ease-out 0.8s forwards;
  }
</style>
