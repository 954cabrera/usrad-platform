---
interface Props {
  remixUrl: string;
}
const { remixUrl } = Astro.props;
---

<section
  class="relative py-24 px-4 sm:px-6 bg-[#003087] text-white overflow-hidden"
  data-aos="fade-up"
>
  <!-- Video Background -->
  <div class="absolute inset-0 z-0">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover"
      poster="/images/home-hero-mri.webp?v=2.1"
    >
      <source
        src="/videos/home-hero-mri-mobile.mp4"
        type="video/mp4"
        media="(max-width: 768px)"
      />
      <source src="/videos/home-hero-mri.mp4" type="video/mp4" />
      <source src="/videos/home-hero-mri.webm" type="video/webm" />
    </video>
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/40"
    >
    </div>
  </div>

  <!-- Decorative gradient blobs -->
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-full blur-3xl opacity-30 z-10"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-96 h-96 bg-gradient-to-br from-[#cc9933]/20 to-orange-500/20 rounded-full blur-3xl opacity-20 z-10"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-20">
    <div class="max-w-5xl mx-auto text-center">
      <!-- Headline -->
      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-8 text-white leading-tight tracking-tight"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <span class="block">Same Radiologists.</span>
        <span class="block">Same Scanners.</span>
        <span class="text-[#cc9933] relative inline-block">
          70% Less
          <svg
            class="absolute -bottom-2 sm:-bottom-3 left-0 w-full"
            height="20"
            viewBox="0 0 200 20"
            preserveAspectRatio="none"
          >
            <path
              d="M 2 14 Q 50 4 100 14 Q 150 24 198 14"
              stroke="#cc9933"
              stroke-width="5"
              fill="none"
              class="animate-draw-line drop-shadow-md"
              stroke-linecap="round"
              opacity="0.8"></path>
          </svg>
        </span>
        <span class="text-white">.</span>
      </h1>

      <!-- Subheadline -->
      <p
        class="text-xl sm:text-2xl md:text-3xl text-white/90 max-w-3xl mx-auto leading-relaxed drop-shadow-lg mb-12"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <span class="block">Book in minutes. Get scanned this week.</span>
        <span class="block">Pay hundreds, not thousands.</span>
      </p>

      <!-- Step 1: Procedure Selection -->
      <div id="hero-step-1" class="transition-all duration-500">
        <div
          class="max-w-3xl mx-auto bg-white/90 backdrop-blur-md border-2 border-white/60 shadow-lg rounded-xl flex flex-col sm:flex-row items-stretch overflow-hidden"
        >
          <input
            type="text"
            id="hero-search-trigger"
            placeholder="Type MRI, CT, Ultrasound..."
            readonly
            class="flex-1 px-6 py-4 text-gray-900 placeholder-gray-500 bg-transparent focus:outline-none cursor-pointer"
          />
          <button
            id="hero-find-button"
            class="bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-8 py-4 font-semibold transition hover:brightness-110"
          >
            Find →
          </button>
        </div>
      </div>

      <!-- Step 2: Confirm Procedure + ZIP + Submit to Remix -->
      <div id="hero-step-2" class="hidden transition-all duration-500">
        <form
          id="hero-search-form"
          action={`${remixUrl}/pbs/search`}
          method="GET"
          class="max-w-3xl mx-auto bg-white/90 backdrop-blur-md border-2 border-white/60 shadow-lg rounded-xl flex flex-col sm:flex-row items-center gap-3 px-6 py-4"
        >
          <div
            class="flex-1 flex items-center justify-between gap-2 bg-white/60 rounded-lg px-4 py-2"
          >
            <!-- hidden fields sent to Remix -->
            <input type="hidden" id="selected-cpt" name="cpt" />
            <input type="hidden" id="selected-label" name="label" />
            <span
              id="selected-procedure"
              class="font-semibold text-gray-900 truncate"></span>
            <button
              id="change-procedure"
              type="button"
              class="text-[#003087] hover:text-[#cc9933]"
            >
              ↻ Change
            </button>
          </div>

          <div class="flex items-center gap-2">
            <input
              id="zip-input"
              name="zip"
              type="text"
              maxlength="5"
              placeholder="ZIP"
              class="w-24 text-center px-3 py-2 border border-gray-300 rounded-lg text-gray-900 focus:ring-2 focus:ring-[#003087]/40 focus:outline-none"
            />
            <button
              id="find-centers"
              type="submit"
              class="bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-6 py-3 font-semibold rounded-lg transition hover:brightness-110"
            >
              Find Centers →
            </button>
          </div>
        </form>
        <p id="zip-status" class="text-xs text-gray-300 mt-2"></p>
      </div>

      <!-- Trust Indicators -->
      <div
        class="flex flex-wrap justify-center gap-6 mt-10 text-sm font-semibold text-white/95"
      >
        <span>✅ No insurance required</span>
        <span>✅ Upfront pricing</span>
        <span>✅ 1,500+ locations</span>
      </div>
    </div>
  </div>

  <script type="module">
    // Use the alias path if configured in tsconfig/vite. If not, change to "../lib/events/search-events".
    import {
      openSearchModal,
      onProcedureSelected,
    } from "../../lib/events/search-events";

    window.addEventListener("DOMContentLoaded", () => {
      console.log("✅ HeroSection initialized");

      const step1 = document.getElementById("hero-step-1");
      const step2 = document.getElementById("hero-step-2");
      const trigger = document.getElementById("hero-search-trigger");
      const heroBtn = document.getElementById("hero-find-button");
      const changeBtn = document.getElementById("change-procedure");
      const procSpan = document.getElementById("selected-procedure");
      const zipInput = document.getElementById("zip-input");
      const zipStatus = document.getElementById("zip-status");
      const cptField = document.getElementById("selected-cpt");
      const lblField = document.getElementById("selected-label");
      const findBtn = document.getElementById("find-centers");
      const form = document.getElementById("hero-search-form");

      // Step 1: open modal (field or button)
      const open = () => {
        console.log("🟢 Hero field clicked → opening modal");
        openSearchModal();
      };
      trigger.addEventListener("click", open);
      heroBtn.addEventListener("click", open);

      // Step 2: when a procedure is selected from the modal
      onProcedureSelected((procedure) => {
        console.log("📋 Procedure selected:", procedure.label);

        const cpt = procedure.cpt || procedure.cpt_code || "";
        cptField.value = cpt;
        lblField.value = procedure.label;
        procSpan.textContent = procedure.label;

        step1.classList.add("hidden");
        step2.classList.remove("hidden");

        detectZIP().finally(updateSubmitState);
      });

      // Change → go back
      changeBtn.addEventListener("click", () => {
        step2.classList.add("hidden");
        step1.classList.remove("hidden");
        cptField.value = "";
        lblField.value = "";
        procSpan.textContent = "";
        zipInput.value = "";
        updateSubmitState();
        trigger.focus();
      });

      // Enable/disable Find Centers
      const isValidZip = (v) => /^\d{5}$/.test(v);
      function updateSubmitState() {
        const ready = !!cptField.value && isValidZip(zipInput.value);
        findBtn.disabled = !ready;
        findBtn.classList.toggle("opacity-50", !ready);
        findBtn.classList.toggle("cursor-not-allowed", !ready);
      }
      zipInput.addEventListener("input", updateSubmitState);

      // Prevent empty submission
      form.addEventListener("submit", (e) => {
        if (!cptField.value || !isValidZip(zipInput.value)) {
          e.preventDefault();
          updateSubmitState();
          if (!isValidZip(zipInput.value)) {
            zipStatus.textContent = "📍 Please enter a valid 5-digit ZIP.";
          }
        }
      });

      // Auto-detect ZIP
      async function detectZIP() {
        zipStatus.textContent = "📍 Finding your location...";
        try {
          const pos = await new Promise((resolve, reject) => {
            navigator.geolocation.getCurrentPosition(resolve, reject, {
              timeout: 5000,
              maximumAge: 300000,
            });
          });
          const { latitude, longitude } = pos.coords;
          const res = await fetch(
            `/api/geocode?lat=${latitude}&lng=${longitude}`
          );
          const data = await res.json();
          const zip = data.zip || "";
          if (zip) {
            zipInput.value = zip;
            zipStatus.textContent = `📍 Detected your location • ${zip}`;
          } else {
            zipStatus.textContent = "📍 Enter ZIP manually";
          }
        } catch {
          zipStatus.textContent = "📍 Enter ZIP manually";
        }
      }
    }); // 👈 closes window.addEventListener("DOMContentLoaded", ...)
  </script>
</section>
