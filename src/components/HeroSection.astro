    const buttons = [
      document.getElementById("hero-search-button"),
      document.getElementById("hero-search-button-mobile"),
    ].filter(Boolean);

    buttons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        if (btn.disabled) return;

        // Remove old overlay if any
        btn.querySelectorAll(".finding-overlay").forEach((el) => el.remove());

        const overlay = document.createElement("div");
        overlay.className = "finding-overlay";
        btn.appendChild(overlay);

        // Clean up after animation completes
        setTimeout(() => overlay.remove(), 1100);
      });
    });
  }
  setupFindCentersShimmer();
</script>

