    from {
      stroke-dashoffset: 200;
      opacity: 0;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 0.8;
    }
  }

  .animate-draw-line {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: draw-line 1.5s ease-out 0.8s forwards;
  }

  /* Force dropdown above everything */
  #search-dropdown {
    z-index: 9999 !important;
    isolation: isolate;
  }

  /* Animated gold highlight for matched text */
  @keyframes fade-highlight {
    from {
      background-color: rgba(204, 153, 51, 0);
      color: #cc9933;
      opacity: 0;
    }
    to {
      background-color: rgba(204, 153, 51, 0.25);
      color: #1a1a1a;
      opacity: 1;
    }
  }

  mark {
    background-color: rgba(204, 153, 51, 0.25); /* USRad gold tone */
    color: #1a1a1a;
    font-weight: 600;
    border-radius: 3px;
    padding: 0 2px;
    animation: fade-highlight 0.25s ease-out;
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  mark:hover {
    background-color: rgba(204, 153, 51, 0.45);
    box-shadow: 0 0 8px rgba(204, 153, 51, 0.3);
  }

  /* Smooth list updates for dynamic search results */
  #search-results-list {
    transition: opacity 0.25s ease-in-out;
  }
</style>
