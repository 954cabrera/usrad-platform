    // Get the hero section
    const heroSection = document.querySelector('section[class*="pt-40"]');
    if (!heroSection) return;

    // Get all sections after hero
    let nextSection = heroSection.nextElementSibling;
    while (nextSection) {
      if (nextSection.tagName === "SECTION") {
        if (shouldBlur) {
          nextSection.style.filter = "blur(4px)";
          nextSection.style.opacity = "0.5";
          nextSection.style.transition = "filter 0.3s ease, opacity 0.3s ease";
          nextSection.style.pointerEvents = "none";
          nextSection.style.userSelect = "none";
