  async function detectZIP() {
    const inputs = [zipInput, zipInputMobile].filter(Boolean);
    if (inputs.length === 0) return;

    if (locationIcon) locationIcon.classList.add("hidden");
    if (locationIconMobile) locationIconMobile.classList.add("hidden");
    if (locationLoading) locationLoading.classList.remove("hidden");
    if (locationLoadingMobile) locationLoadingMobile.classList.remove("hidden");

    const statusP = zipStatus?.querySelector("p");
    if (statusP) statusP.textContent = "Finding your location...";

    try {
      const pos = await new Promise((resolve, reject) => {
        if (!navigator.geolocation)
          reject(new Error("Geolocation not supported"));
        navigator.geolocation.getCurrentPosition(resolve, reject, {
          timeout: 5000,
          maximumAge: 300000,
        });
      });

      const lat = pos.coords.latitude;
      const lng = pos.coords.longitude;

      const res = await fetch(`/api/geocode?lat=${lat}&lng=${lng}`);
      const data = await res.json();

      if (data.postalCode) {
        inputs.forEach((input) => {
          if (input) input.value = data.postalCode;
        });

        if (statusP) {
          statusP.textContent = `Detected your location${data.city ? ` in ${data.city}` : ""} • Change`;
        }
        checkFormReady();
      } else {
        throw new Error("No postal code found");
      }
    } catch (err) {
      console.error("Location detection error:", err);
      if (statusP) {
        statusP.textContent = "Could not detect location • Enter ZIP manually";
      }
      if (zipInput) {
        zipInput.focus();
      }
    } finally {
      if (locationIcon) locationIcon.classList.remove("hidden");
      if (locationLoading) locationLoading.classList.add("hidden");
      if (locationIconMobile) locationIconMobile.classList.remove("hidden");
      if (locationLoadingMobile) locationLoadingMobile.classList.add("hidden");
    }
  }

