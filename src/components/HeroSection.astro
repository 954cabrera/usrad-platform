---
// HeroSection.astro - Hybrid Progressive Disclosure Hero
// Pure JavaScript implementation - No TypeScript in scripts
interface Props {
  remixUrl: string;
}

const { remixUrl } = Astro.props;
---

<section
  class="relative pt-40 pb-24 px-4 sm:px-6 bg-[#003087] text-white overflow-hidden"
  style="margin-top: -32px;"
  data-aos="fade-up"
>
  <!-- Video Background -->
  <div class="absolute inset-0 z-0">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover"
      poster="/images/home-hero-mri.webp?v=2.1"
    >
      <source
        src="/videos/home-hero-mri-mobile.mp4"
        type="video/mp4"
        media="(max-width: 768px)"
      />
      <source src="/videos/home-hero-mri.mp4" type="video/mp4" />
      <source src="/videos/home-hero-mri.webm" type="video/webm" />
    </video>
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/40"
    >
    </div>
  </div>

  <!-- Gradient blobs -->
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-full blur-3xl opacity-30 z-10"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-96 h-96 bg-gradient-to-br from-[#cc9933]/20 to-orange-500/20 rounded-full blur-3xl opacity-20 z-10"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-20">
    <div class="max-w-5xl mx-auto text-center">
      <!-- Main Headline -->
      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-8 text-white leading-tight tracking-tight"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <span class="block">Same Radiologists.</span>
        <span class="block">Same Scanners.</span>
        <span class="text-[#cc9933] relative inline-block">
          70% Less
          <svg
            class="absolute -bottom-2 sm:-bottom-3 left-0 w-full"
            height="20"
            viewBox="0 0 200 20"
            preserveAspectRatio="none"
          >
            <path
              d="M 2 14 Q 50 4 100 14 Q 150 24 198 14"
              stroke="#cc9933"
              stroke-width="5"
              fill="none"
              class="animate-draw-line drop-shadow-md"
              stroke-linecap="round"
              opacity="0.8"></path>
          </svg>
        </span>
        <span class="text-white">.</span>
      </h1>

      <!-- Subheadline -->
      <p
        class="text-xl sm:text-2xl md:text-3xl text-white/90 max-w-3xl mx-auto leading-relaxed drop-shadow-lg mb-12"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <span class="block">Book in minutes. Get scanned this week.</span>
        <span class="block">Pay hundreds, not thousands.</span>
      </p>

      <!-- STEP 1: Inline Search with Dropdown -->
      <div
        id="hero-step-1"
        class="relative z-[9999] max-w-3xl mx-auto mb-16 sm:mb-24 transition-all duration-500"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <!-- Search Input Container -->
        <div class="relative">
          <div
            class="bg-white/90 backdrop-blur-md border-2 border-white/60 shadow-lg rounded-xl flex flex-col sm:flex-row items-stretch overflow-hidden"
          >
            <!-- Real Search Input (not readonly anymore) -->
            <input
              type="text"
              id="hero-search-input"
              placeholder="Type MRI, CT, Ultrasound..."
              autocomplete="off"
              class="flex-1 px-6 py-4 sm:py-5 text-base sm:text-lg text-gray-900 placeholder-gray-500 bg-transparent focus:outline-none focus:ring-2 focus:ring-[#003087]/20 transition-all"
              aria-label="Search for medical procedures"
              aria-autocomplete="list"
              aria-controls="search-dropdown"
              aria-expanded="false"
            />
            <button
              type="button"
              id="hero-find-button"
              class="bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-8 py-4 sm:py-5 font-bold text-base sm:text-lg transition-all duration-300 hover:brightness-110"
            >
              <span class="flex items-center justify-center gap-2">
                Find
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </span>
            </button>
          </div>
        </div>
      </div>

      <!-- STEP 2: Horizontal Compact Layout (Hidden Initially) -->
      <div
        id="hero-step-2"
        class="hidden relative z-50 max-w-4xl mx-auto mb-16 sm:mb-24 transition-all duration-500"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <form
          action={`${remixUrl}/pbs/search`}
          method="GET"
          id="hero-search-form"
        >
          <!-- Compact Horizontal Row -->
          <div
            class="bg-white/90 backdrop-blur-md border-2 border-white/60 shadow-lg rounded-xl overflow-hidden"
          >
            <!-- Mobile: Stack Vertically -->
            <div class="flex flex-col sm:hidden">
              <!-- Selected Procedure Pill - Mobile -->
              <div class="p-4 border-b border-gray-200">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2 flex-1 min-w-0">
                    <div
                      class="flex-shrink-0 w-8 h-8 bg-green-500 rounded-full flex items-center justify-center"
                    >
                      <svg
                        class="w-5 h-5 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="3"
                          d="M5 13l4 4L19 7"></path>
                      </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-xs font-medium text-gray-500 mb-0.5">
                        Selected
                      </p>
                      <p
                        id="selected-procedure-display-mobile"
                        class="text-sm font-semibold text-gray-900 truncate"
                      >
                      </p>
                    </div>
                  </div>
                  <button
                    type="button"
                    id="change-procedure-button-mobile"
                    class="flex-shrink-0 text-xs font-medium text-[#003087] hover:text-[#cc9933] transition-colors px-3 py-1.5 rounded-lg hover:bg-gray-100"
                  >
                    Change
                  </button>
                </div>
              </div>

              <!-- ZIP Input - Mobile -->
              <div class="relative p-4 border-b border-gray-200">
                <label
                  for="hero-zip-input-mobile"
                  class="block text-xs font-medium text-gray-500 mb-2"
                  >ZIP Code</label
                >
                <div class="relative">
                  <input
                    type="text"
                    id="hero-zip-input-mobile"
                    name="zip"
                    placeholder="Enter ZIP code"
                    inputmode="numeric"
                    pattern="[0-9]{5}"
                    maxlength="5"
                    class="w-full px-4 py-3 text-base text-gray-900 placeholder-gray-400 border border-gray-300 rounded-lg focus:outline-none focus:border-[#003087] focus:ring-2 focus:ring-[#003087]/20 transition-all pr-10"
                  />
                  <button
                    type="button"
                    id="hero-detect-location-mobile"
                    class="absolute inset-y-0 right-0 pr-3 flex items-center text-[#003087] hover:text-[#cc9933] transition-all"
                    title="Detect location"
                  >
                    <svg
                      id="location-icon-mobile"
                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                      ></path>
                    </svg>
                    <svg
                      id="location-loading-mobile"
                      class="w-5 h-5 animate-spin hidden"
                      fill="none"
                      viewBox="0 0 24 24"
                    >
                      <circle
                        class="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="4"></circle>
                      <path
                        class="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                      ></path>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Submit Button - Mobile -->
              <div class="p-4">
                <button
                  type="submit"
                  id="hero-search-button-mobile"
                  class="w-full bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-6 py-4 rounded-lg font-bold text-base transition-all duration-300 hover:brightness-110 disabled:opacity-50 disabled:cursor-not-allowed"
                  disabled
                >
                  <span class="flex items-center justify-center gap-2">
                    <span>Find Centers</span>
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                  </span>
                </button>
              </div>
            </div>

            <!-- Desktop: Single Horizontal Row -->
            <div class="hidden sm:flex items-center">
              <!-- Selected Procedure Pill -->
              <div
                class="flex-1 flex items-center gap-3 px-6 py-4 border-r border-gray-200"
              >
                <div
                  class="flex-shrink-0 w-10 h-10 bg-green-500 rounded-full flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="3"
                      d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-medium text-gray-500 mb-0.5">
                    Selected Procedure
                  </p>
                  <p
                    id="selected-procedure-display"
                    class="text-base font-semibold text-gray-900 truncate"
                  >
                  </p>
                </div>
                <button
                  type="button"
                  id="change-procedure-button"
                  class="flex-shrink-0 flex items-center gap-1.5 text-[#003087] hover:text-[#cc9933] font-medium text-sm transition-all px-3 py-2 rounded-lg hover:bg-gray-100"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    ></path>
                  </svg>
                  Change
                </button>
              </div>

              <!-- ZIP Input -->
              <div class="relative px-6 py-4 border-r border-gray-200">
                <label
                  for="hero-zip-input"
                  class="block text-xs font-medium text-gray-500 mb-2"
                  >ZIP Code</label
                >
                <div class="relative">
                  <input
                    type="text"
                    id="hero-zip-input"
                    name="zip"
                    placeholder="12345"
                    inputmode="numeric"
                    pattern="[0-9]{5}"
                    maxlength="5"
                    class="w-32 px-3 py-2 text-center text-lg font-semibold text-gray-900 placeholder-gray-400 border border-gray-300 rounded-lg focus:outline-none focus:border-[#003087] focus:ring-2 focus:ring-[#003087]/20 transition-all"
                  />
                  <button
                    type="button"
                    id="hero-detect-location"
                    class="absolute -right-8 top-1/2 -translate-y-1/2 text-[#003087] hover:text-[#cc9933] transition-all hover:scale-110"
                    title="Detect location"
                  >
                    <svg
                      id="location-icon"
                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                      ></path>
                    </svg>
                    <svg
                      id="location-loading"
                      class="w-5 h-5 animate-spin hidden"
                      fill="none"
                      viewBox="0 0 24 24"
                    >
                      <circle
                        class="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="4"></circle>
                      <path
                        class="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                      ></path>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Submit Button -->
              <div class="flex-shrink-0">
                <button
                  type="submit"
                  id="hero-search-button"
                  class="h-full bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-8 py-4 font-bold text-lg transition-all duration-300 hover:brightness-110 disabled:opacity-50 disabled:cursor-not-allowed relative overflow-hidden group"
                  disabled
                >
                  <span
                    class="flex items-center justify-center gap-2 relative z-10"
                  >
                    <span id="button-text">Find Centers</span>
                    <svg
                      class="w-5 h-5 transition-transform group-hover:translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                  </span>
                  <div
                    class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -skew-x-12 translate-x-[-200%] group-hover:translate-x-[200%] transition-transform duration-1000"
                  >
                  </div>
                </button>
              </div>
            </div>
          </div>

          <!-- Status Message Below -->
          <div id="zip-status-message" class="mt-3 text-center">
            <p class="text-sm text-white/80"></p>
          </div>

          <!-- Hidden Form Fields -->
          <input
            type="hidden"
            name="procedure"
            id="hero-selected-procedure"
            value=""
          />
          <input type="hidden" name="cpt" id="hero-selected-cpt" value="" />
          <input type="hidden" name="state" value="" />
          <input type="hidden" name="radius" value="10" />
        </form>
      </div>

      <!-- Trust Indicators -->
      <div
        class="flex flex-wrap justify-center gap-4 sm:gap-6 md:gap-8 text-sm sm:text-base text-white font-semibold drop-shadow-lg"
        data-aos="fade-up"
        data-aos-delay="500"
      >
        <div class="flex items-center gap-2">
          <svg
            class="flex-shrink-0 w-5 h-5 text-green-400"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span>No insurance required</span>
        </div>
        <div class="flex items-center gap-2">
          <svg
            class="flex-shrink-0 w-5 h-5 text-green-400"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span>Upfront pricing</span>
        </div>
        <div class="flex items-center gap-2">
          <svg
            class="flex-shrink-0 w-5 h-5 text-green-400"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span>1,500+ locations</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- DROPDOWN PORTAL - Positioned outside hero section for proper z-index -->
<div
  id="search-dropdown"
  class="hidden fixed bg-white rounded-xl shadow-[0_4px_12px_rgba(0,0,0,0.08),0_12px_28px_rgba(0,0,0,0.10)] border border-gray-200 overflow-hidden max-h-[70vh] z-[9999] backdrop-blur-sm"
  role="listbox"
  aria-label="Procedure search results"
>
  <!-- Popular Procedures Section -->
  <div id="popular-procedures-section" class="hidden relative">
    <div
      class="px-4 py-3 bg-gradient-to-r from-[#fff5e3] via-[#fffaf5] to-white border-b border-[#f5e4c3] flex items-center justify-between"
    >
      <div>
        <h3
          class="text-sm font-semibold text-[#b8862d] flex items-center gap-2"
        >
          ⭐ Popular Procedures
        </h3>
        <p class="text-xs text-gray-500 mt-0.5">Or start typing to search...</p>
      </div>
      <span class="text-xs text-[#b8862d]/80 font-medium">Curated by USRad</span
      >
    </div>

    <div
      id="popular-procedures-list"
      class="overflow-y-auto max-h-[420px] px-3 py-2.5"
    >
      <!-- Popular procedures rendered here -->
    </div>

    <!-- Gentle fade indicator -->
    <div
      class="pointer-events-none absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-white to-transparent rounded-b-xl"
    >
    </div>
  </div>

  <!-- Search Results Section -->
  <div id="search-results-section" class="hidden relative">
    <div
      class="px-4 py-3 bg-gradient-to-r from-blue-50 to-white border-b border-gray-200"
    >
      <h3 class="text-sm font-semibold text-gray-700">
        <span id="results-count">0</span> Results
      </h3>
    </div>

    <div
      id="search-results-list"
      class="overflow-y-auto max-h-[420px] px-3 py-2.5"
    >
      <!-- Search results rendered here -->
    </div>

    <!-- Gentle fade indicator -->
    <div
      class="pointer-events-none absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-white to-transparent rounded-b-xl"
    >
    </div>
  </div>

  <!-- Empty State -->
  <div id="empty-state" class="hidden text-center py-12 px-4">
    <svg
      class="w-16 h-16 mx-auto mb-4 text-gray-300"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <p class="text-base font-semibold text-gray-700 mb-1">
      No procedures found
    </p>
    <p class="text-sm text-gray-500">Try a different search term</p>
  </div>
</div>

<!-- Soft gradient fade at dropdown bottom -->
<div
  class="pointer-events-none absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-[#fff8ee] to-transparent rounded-b-xl z-[10000]"
>
</div>

<script>
  // ========================================
  // SELF-CONTAINED INLINE SEARCH
  // No external imports needed
  // ========================================

  const MODALITY_COLORS = {
    MRI: {
      bg: "bg-blue-500",
      text: "text-blue-600",
      lightBg: "bg-blue-50",
      border: "border-blue-200",
    },
    CT: {
      bg: "bg-teal-500",
      text: "text-teal-600",
      lightBg: "bg-teal-50",
      border: "border-teal-200",
    },
    "X-Ray": {
      bg: "bg-amber-500",
      text: "text-amber-600",
      lightBg: "bg-amber-50",
      border: "border-amber-200",
    },
    Ultrasound: {
      bg: "bg-sky-500",
      text: "text-sky-600",
      lightBg: "bg-sky-50",
      border: "border-sky-200",
    },
  };

  // Universal search engine (self-contained)
  function normalizeText(str) {
    return (str || "")
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, "")
      .replace(/\s+/g, " ")
      .trim();
  }

  function searchUniversalProcedures(query, limit = 8) {
    if (!query || query.length < 2) return [];

    const lib = window.ProcedureLibrary;
    if (!lib) return [];

    const results = [];
    const lowerQuery = normalizeText(query);

    for (const modality in lib) {
      for (const region in lib[modality]) {
        const entry = lib[modality][region];
        const procedures = entry.procedures || entry.viewOptions || [];

        procedures.forEach((proc) => {
          const searchText = normalizeText(
            `${proc.label} ${modality} ${region} ${proc.cpt} ${(entry.matchKeywords || []).join(" ")}`
          );

          if (searchText.includes(lowerQuery)) {
            const score = searchText.indexOf(lowerQuery) === 0 ? 100 : 50;
            results.push({
              label: proc.label,
              cpt: proc.cpt,
              modality: modality,
              bodyPart: region,
              score: score,
            });
          }
        });
      }
    }

    return results.sort((a, b) => b.score - a.score).slice(0, limit);
  }

  // Popular procedures generator
  function getPopularProcedures(limit = 50) {
    const lib = window.ProcedureLibrary;
    if (!lib) {
      console.error("ProcedureLibrary not loaded");
      return [];
    }

    const items = [];
    for (const modality in lib) {
      for (const region in lib[modality]) {
        const entry = lib[modality][region];
        const procedures = entry.procedures || [];

        procedures.slice(0, 2).forEach((proc) => {
          items.push({
            label: proc.label,
            cpt: proc.cpt,
            modality: modality,
            bodyPart: region,
          });
        });
      }
    }

    return items.sort(() => Math.random() - 0.5).slice(0, limit);
  }

  // Local search
  function searchLocalProcedures(query, limit = 8) {
    if (!query || query.length < 2) return [];

    const lib = window.ProcedureLibrary;
    if (!lib) return [];

    const results = [];
    const lowerQuery = query.toLowerCase();

    for (const modality in lib) {
      for (const region in lib[modality]) {
        const entry = lib[modality][region];
        const procedures = entry.procedures || [];

        procedures.forEach((proc) => {
          const searchText =
            `${proc.label} ${modality} ${region} ${proc.cpt} ${(entry.matchKeywords || []).join(" ")}`.toLowerCase();
          if (searchText.includes(lowerQuery)) {
            results.push({
              label: proc.label,
              cpt: proc.cpt,
              modality: modality,
              bodyPart: region,
              score: searchText.indexOf(lowerQuery) === 0 ? 10 : 1,
            });
          }
        });
      }
    }

    return results.sort((a, b) => b.score - a.score).slice(0, limit);
  }

  // Hybrid search
  async function hybridSearch(query) {
    console.log("Hybrid search:", query);

    const localResults = searchLocalProcedures(query, 8);
    console.log("Local results:", localResults.length);

    if (localResults.length < 6) {
      console.log("Adding universal search results");
      const universalResults = searchUniversalProcedures(query, 8);

      const merged = [...localResults];
      universalResults.forEach((uResult) => {
        if (!merged.find((m) => m.cpt === uResult.cpt)) {
          merged.push(uResult);
        }
      });

      return merged.slice(0, 12);
    }

    return localResults;
  }

  // ✅ Highlight matched query in labels
  function highlightMatch(label, query) {
    if (!query) return label;
    const safeQuery = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const regex = new RegExp(`(${safeQuery})`, "ig");
    return label.replace(
      regex,
      '<mark class="bg-yellow-200 text-gray-900">$1</mark>'
    );
  }

  // Render functions
  function renderProcedureButton(procedure) {
    const colors = MODALITY_COLORS[procedure.modality] || MODALITY_COLORS.MRI;

    return `
      <button
        type="button"
        class="w-full text-left p-3 rounded-lg border ${colors.border} hover:${colors.lightBg} transition-all duration-200 group procedure-result"
        data-cpt="${procedure.cpt || ""}"
        data-label="${(procedure.label || "").replace(/"/g, "&quot;")}"
        data-modality="${procedure.modality || ""}"
        data-bodypart="${procedure.bodyPart || ""}"
      >
        <div class="flex items-center gap-3">
          <span class="flex-shrink-0 px-2.5 py-1 rounded-full text-xs font-semibold ${colors.bg} text-white">
            ${procedure.modality || "Scan"}
          </span>
          <div class="flex-1 min-w-0">
            <div class="font-semibold text-gray-900 text-sm group-hover:${colors.text} transition-colors truncate">
              ${highlightMatch(procedure.label || "", currentQuery)}
            </div>

            <div class="flex items-center gap-2 text-xs text-gray-500 mt-0.5">
              <span>${procedure.bodyPart || ""}</span>
              <span class="text-gray-300">•</span>
              <span class="font-mono">CPT ${procedure.cpt || ""}</span>
            </div>
          </div>
          <svg class="w-4 h-4 text-gray-400 group-hover:${colors.text} transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </button>
    `;
  }

  function groupByModality(procedures) {
    const groups = {};
    procedures.forEach((proc) => {
      const modality = proc.modality || "Other";
      if (!groups[modality]) groups[modality] = [];
      groups[modality].push(proc);
    });
    return groups;
  }

  // ============================================
  // ENHANCED GROUPED RENDERER — ZOCDOC STYLE (Sticky Headers)
  // ============================================
  function renderGroupedResults(procedures) {
    const groups = groupByModality(procedures);
    const modalityOrder = ["MRI", "CT", "X-Ray", "Ultrasound", "Other"];

    const ICONS = {
      MRI: "🧠",
      CT: "🦵",
      "X-Ray": "💀",
      Ultrasound: "🩺",
      Other: "📋",
    };

    const html = modalityOrder
      .map((modality) => {
        const group = groups[modality];
        if (!group || group.length === 0) return "";

        const colors = MODALITY_COLORS[modality] || MODALITY_COLORS.MRI;
        const icon = ICONS[modality] || "📋";

        return `
        <div class="mb-4 border border-gray-100 rounded-lg overflow-hidden shadow-sm">
          <div class="sticky top-0 z-10 px-4 py-2 bg-gradient-to-r from-[#fff8ee] to-white border-b border-[#f5e4c3] flex items-center justify-between backdrop-blur-sm">
            <h4 class="text-sm font-semibold text-[#b8862d] flex items-center gap-2">
              <span>${icon}</span> ${modality}
            </h4>
            <span class="text-xs text-gray-500">${group.length} procedures</span>
          </div>
          <div class="divide-y divide-gray-100 max-h-[220px] overflow-y-auto">
            ${group
              .map(
                (proc) => `
              <button
                type="button"
                class="w-full text-left flex items-center justify-between px-4 py-2.5 hover:bg-gray-50 cursor-pointer transition procedure-result"
                data-cpt="${proc.cpt || ""}"
                data-label="${(proc.label || "").replace(/"/g, "&quot;")}"
                data-modality="${proc.modality || ""}"
                data-bodypart="${proc.bodyPart || ""}"
              >
                <div class="flex flex-col">
                  <span class="text-[15px] font-medium text-gray-900 leading-tight">
                    ${proc.label}
                  </span>
                </div>
                <span
                  class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-md text-[11px] font-semibold uppercase tracking-wide
                  ${
                    modality === "MRI"
                      ? "bg-[#e7f0ff] text-[#003087]"
                      : modality === "CT"
                        ? "bg-[#fff8ee] text-[#b8862d]"
                        : modality === "X-Ray"
                          ? "bg-[#f3f4f6] text-gray-700"
                          : "bg-[#eefaf1] text-[#006d3b]"
                  }"
                >
                  ${modality}
                </span>

              </button>
            `
              )
              .join("")}
          </div>
        </div>
      `;
      })
      .join("");

    return (
      html || '<p class="text-center py-4 text-gray-500">No results found</p>'
    );
  }

  // DOM elements
  const step1 = document.getElementById("hero-step-1");
  const step2 = document.getElementById("hero-step-2");
  const searchInput = document.getElementById("hero-search-input");
  const dropdown = document.getElementById("search-dropdown");
  const popularSection = document.getElementById("popular-procedures-section");
  const popularList = document.getElementById("popular-procedures-list");
  const searchSection = document.getElementById("search-results-section");
  const searchList = document.getElementById("search-results-list");
  const emptyState = document.getElementById("empty-state");
  const resultsCount = document.getElementById("results-count");

  const changeBtn = document.getElementById("change-procedure-button");
  const changeBtnMobile = document.getElementById(
    "change-procedure-button-mobile"
  );
  const procDisplay = document.getElementById("selected-procedure-display");
  const procDisplayMobile = document.getElementById(
    "selected-procedure-display-mobile"
  );
  const zipInput = document.getElementById("hero-zip-input");
  const zipInputMobile = document.getElementById("hero-zip-input-mobile");
  const submitBtn = document.getElementById("hero-search-button");
  const submitBtnMobile = document.getElementById("hero-search-button-mobile");
  const detectBtn = document.getElementById("hero-detect-location");
  const detectBtnMobile = document.getElementById(
    "hero-detect-location-mobile"
  );
  const locationIcon = document.getElementById("location-icon");
  const locationIconMobile = document.getElementById("location-icon-mobile");
  const locationLoading = document.getElementById("location-loading");
  const locationLoadingMobile = document.getElementById(
    "location-loading-mobile"
  );
  const cptHidden = document.getElementById("hero-selected-cpt");
  const procedureHidden = document.getElementById("hero-selected-procedure");
  const zipStatus = document.getElementById("zip-status-message");

  // Position dropdown relative to search input (for fixed positioning)
  function positionDropdown() {
    const dropdown = document.getElementById("search-dropdown");
    const searchInput = document.getElementById("hero-search-input");

    if (!dropdown || !searchInput) return;

    const inputRect = searchInput.getBoundingClientRect();

    // DEBUG: Log values to console
    console.log({
      inputBottom: inputRect.bottom,
      inputLeft: inputRect.left,
      inputWidth: inputRect.width,
      windowScrollY: window.scrollY,
    });

    const topOffset = inputRect.bottom + 8;
    const leftOffset = inputRect.left;
    const widthMatch = inputRect.width;

    dropdown.style.top = `${inputRect.bottom + 8}px`; // ✅ CORRECT - no window.scrollY
    dropdown.style.left = `${inputRect.left}px`;
    dropdown.style.width = `${inputRect.width}px`;

    // DEBUG: Log final position
    console.log("Dropdown positioned at:", {
      top: topOffset,
      left: leftOffset,
      width: widthMatch,
    });
  }

  // Show dropdown function
  function showDropdown() {
    const dropdown = document.getElementById("search-dropdown");
    if (!dropdown) return;

    positionDropdown();
    dropdown.classList.remove("hidden");
    isDropdownOpen = true;
  }

  // Hide dropdown function
  function hideDropdown() {
    const dropdown = document.getElementById("search-dropdown");
    if (!dropdown) return;
    dropdown.classList.add("hidden");
    dropdown.classList.add("hidden");
    isDropdownOpen = false;
  }

  let searchTimeout;
  let isDropdownOpen = false;

  // Track current query for highlighting
  let currentQuery = "";

  console.log("Inline search initialized");

  // Dropdown functions

  // ============================================
  // USE PREDEFINED "POPULAR_PROCEDURES" LIST
  // ============================================

  function showPopularProceduresFromLibrary() {
    const lib = window.ProcedureLibrary;
    if (!lib || !lib.Popular) {
      console.warn("Popular procedures not found in ProcedureLibrary");
      return;
    }

    const popular = lib.Popular;

    if (popularSection && popularList) {
      popularSection.classList.remove("hidden");
      searchSection?.classList.add("hidden");
      emptyState?.classList.add("hidden");

      // Render with grouped layout (Zocdoc style)
      popularList.innerHTML = renderGroupedResults(popular);
      attachResultHandlers();
    }
  }

  function showPopularProcedures() {
    const popular = getPopularProcedures(50);

    if (popularSection && popularList) {
      popularSection.classList.remove("hidden");
      searchSection?.classList.add("hidden");
      emptyState?.classList.add("hidden");

      popularList.innerHTML = renderGroupedResults(popular);
      attachResultHandlers();
    }
  }

  async function performSearch(query) {
    if (!query || query.length < 2) {
      showPopularProceduresFromLibrary(); // ✅ use curated list
      return;
    }

    if (popularSection) popularSection.classList.add("hidden");
    if (searchSection) searchSection.classList.remove("hidden");
    if (emptyState) emptyState.classList.add("hidden");
    if (searchList)
      searchList.innerHTML =
        '<div class="text-center py-4 text-gray-500">Searching...</div>';

    try {
      // ✅ Save the active search term for highlighting
      currentQuery = query;
      const results = await hybridSearch(query);

      if (results.length === 0) {
        searchSection?.classList.add("hidden");
        emptyState?.classList.remove("hidden");
      } else {
        if (resultsCount) resultsCount.textContent = results.length;
        if (searchList) searchList.innerHTML = renderGroupedResults(results);
        attachResultHandlers();
      }
    } catch (error) {
      console.error("Search error:", error);
    }
  }

  function attachResultHandlers() {
    dropdown?.querySelectorAll(".procedure-result").forEach((btn) => {
      btn.addEventListener("click", () => {
        const procedure = {
          cpt_code: btn.getAttribute("data-cpt"),
          label: btn.getAttribute("data-label"),
          modality: btn.getAttribute("data-modality"),
          bodyPart: btn.getAttribute("data-bodypart"),
        };

        handleProcedureSelection(procedure);
        hideDropdown();
      });
    });
  }

  function handleProcedureSelection(procedure) {
    if (!step1 || !step2 || !cptHidden || !procedureHidden) return;

    step1.classList.add("hidden");
    step2.classList.remove("hidden");

    if (procDisplay) procDisplay.textContent = procedure.label || "";
    if (procDisplayMobile)
      procDisplayMobile.textContent = procedure.label || "";

    cptHidden.value = procedure.cpt_code || "";
    procedureHidden.value = procedure.label || "";

    detectZIP();
  }

  // Event listeners
  if (searchInput) {
    searchInput.addEventListener("focus", () => {
      showDropdown();
      if (!searchInput.value || searchInput.value.trim().length === 0) {
        showPopularProceduresFromLibrary(); // ✅ use curated list
      }
    });

    searchInput.addEventListener("input", (e) => {
      clearTimeout(searchTimeout);
      showDropdown();

      const query = e.target.value.trim();
      searchTimeout = setTimeout(() => performSearch(query), 200);
    });
  }

  document.addEventListener("click", (e) => {
    if (
      dropdown &&
      searchInput &&
      !dropdown.contains(e.target) &&
      !searchInput.contains(e.target)
    ) {
      hideDropdown();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isDropdownOpen) {
      hideDropdown();
      searchInput?.blur();
    }
  });

  if (changeBtn) {
    changeBtn.addEventListener("click", () => {
      if (step2 && step1) {
        step2.classList.add("hidden");
        step1.classList.remove("hidden");
      }
      searchInput?.focus();
    });
  }

  if (changeBtnMobile) {
    changeBtnMobile.addEventListener("click", () => {
      if (step2 && step1) {
        step2.classList.add("hidden");
        step1.classList.remove("hidden");
      }
      searchInput?.focus();
    });
  }

  if (detectBtn) {
    detectBtn.addEventListener("click", detectZIP);
  }

  if (detectBtnMobile) {
    detectBtnMobile.addEventListener("click", detectZIP);
  }

  if (zipInput) {
    zipInput.addEventListener("input", () => {
      if (zipInputMobile) zipInputMobile.value = zipInput.value;
      checkFormReady();
    });
  }

  if (zipInputMobile) {
    zipInputMobile.addEventListener("input", () => {
      if (zipInput) zipInput.value = zipInputMobile.value;
      checkFormReady();
    });
  }

  // Reposition dropdown on window resize
  window.addEventListener("resize", () => {
    if (isDropdownOpen) {
      positionDropdown();
    }
  });

  // Reposition dropdown on scroll
  window.addEventListener("scroll", () => {
    if (isDropdownOpen) {
      hideDropdown(); // ✅ This is CORRECT
    }
  });

  async function detectZIP() {
    const inputs = [zipInput, zipInputMobile].filter(Boolean);
    if (inputs.length === 0) return;

    if (locationIcon) locationIcon.classList.add("hidden");
    if (locationIconMobile) locationIconMobile.classList.add("hidden");
    if (locationLoading) locationLoading.classList.remove("hidden");
    if (locationLoadingMobile) locationLoadingMobile.classList.remove("hidden");

    const statusP = zipStatus?.querySelector("p");
    if (statusP) statusP.textContent = "Finding your location...";

    try {
      const pos = await new Promise((resolve, reject) => {
        if (!navigator.geolocation)
          reject(new Error("Geolocation not supported"));
        navigator.geolocation.getCurrentPosition(resolve, reject, {
          timeout: 5000,
          maximumAge: 300000,
        });
      });

      const lat = pos.coords.latitude;
      const lng = pos.coords.longitude;

      const res = await fetch(`/api/geocode?lat=${lat}&lng=${lng}`);
      const data = await res.json();

      if (data.postalCode) {
        inputs.forEach((input) => {
          if (input) input.value = data.postalCode;
        });

        if (statusP) {
          statusP.textContent = `Detected your location${data.city ? ` in ${data.city}` : ""} • Change`;
        }
        checkFormReady();
      } else {
        throw new Error("No postal code found");
      }
    } catch (err) {
      console.error("Location detection error:", err);
      if (statusP) {
        statusP.textContent = "Could not detect location • Enter ZIP manually";
      }
      if (zipInput) {
        zipInput.focus();
      }
    } finally {
      if (locationIcon) locationIcon.classList.remove("hidden");
      if (locationLoading) locationLoading.classList.add("hidden");
      if (locationIconMobile) locationIconMobile.classList.remove("hidden");
      if (locationLoadingMobile) locationLoadingMobile.classList.add("hidden");
    }
  }

  function checkFormReady() {
    if (!cptHidden) return;

    const hasCpt = cptHidden.value && cptHidden.value.length > 0;
    const zipValue = zipInput?.value || zipInputMobile?.value || "";
    const hasZip = zipValue.length === 5;
    const isReady = hasCpt && hasZip;

    if (submitBtn) submitBtn.disabled = !isReady;
    if (submitBtnMobile) submitBtnMobile.disabled = !isReady;

    if (isReady) {
      console.log("Form ready to submit");
    }
  }

  const form = document.getElementById("hero-search-form");
  if (form) {
    form.addEventListener("submit", (e) => {
      console.log("Submitting form:", {
        cpt: cptHidden ? cptHidden.value : "",
        procedure: procedureHidden ? procedureHidden.value : "",
        zip: zipInput ? zipInput.value : "",
        action: form.action,
      });
    });
  }

  // DEBUG: Check layout on load
  window.addEventListener("load", () => {
    const header = document.querySelector("header");
    const heroSection = document.querySelector("section");

    console.log("🔍 Layout Debug:", {
      headerHeight: header?.offsetHeight,
      heroTop: heroSection?.getBoundingClientRect().top,
      heroPaddingTop: window.getComputedStyle(heroSection).paddingTop,
      scrollPosition: window.scrollY,
      viewportHeight: window.innerHeight,
    });
  });
</script>

<style>
