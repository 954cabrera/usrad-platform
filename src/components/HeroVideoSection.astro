---
import HeroSearchForm from "./HeroSearchForm.astro";

export interface Props {
  headlineText: string;
  subText: string;
  credibilityText: string;
  videoSources: { src: string; type: string; media?: string }[];
  posterUrl: string;
  primaryCTA: { label: string; href: string };
  secondaryCTA: { label: string; id: string };
  showSearchForm?: boolean;
  trustIndicators?: { icon?: string; text: string }[];
}

const {
  headlineText,
  subText,
  credibilityText,
  videoSources,
  posterUrl,
  primaryCTA,
  secondaryCTA,
  showSearchForm = true,
  trustIndicators = [],
} = Astro.props;
---

<section class="relative h-[80vh] overflow-hidden hero-section-mobile">
  <video
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover z-0"
    poster={posterUrl}
  >
    {
      videoSources.map((source) => (
        <source src={source.src} type={source.type} media={source.media} />
      ))
    }
    <img src={posterUrl} alt="Hero Poster" class="w-full h-full object-cover" />
  </video>

  <div
    class="absolute inset-0 bg-[#003087]/75 flex flex-col justify-center items-center text-white text-center px-4"
  >
    <div class="animate-fade-in-up mb-6">
      <div
        class="bg-white/10 backdrop-blur-md rounded-full px-6 py-2 border border-white/20"
      >
        <span class="text-[#cc9933] font-bold text-sm">{credibilityText}</span>
      </div>
    </div>

    <h1
      class="text-3xl sm:text-5xl lg:text-6xl font-semibold mb-4 drop-shadow-lg animate-fade-in-up"
      set:html={headlineText}
    />

    <p
      class="max-w-2xl text-lg sm:text-xl mb-6 drop-shadow animate-fade-in-up animation-delay-300"
    >
      <span set:html={subText} />
    </p>

    <div class="animate-fade-in-up animation-delay-600">
      <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
        <a
          href={primaryCTA.href}
          class="group bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-semibold px-8 py-5 sm:py-4 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center gap-2"
        >
          {primaryCTA.label}
          <svg
            class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>

        <button
          id={secondaryCTA.id}
          class="group border-2 border-white text-white font-semibold px-6 py-5 sm:py-4 rounded-xl hover:bg-white hover:text-[#003087] transition-all duration-300 inline-flex items-center gap-2 backdrop-blur-sm"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z"
            ></path>
          </svg>
          {secondaryCTA.label}
        </button>
      </div>

      {showSearchForm && <HeroSearchForm />}

      {
        trustIndicators.length > 0 && (
          <div class="mt-6 animate-fade-in-up animation-delay-900">
            <div class="flex flex-wrap justify-center items-center gap-6 text-base sm:text-sm opacity-90">
              {trustIndicators.map(({ icon, text }) => (
                <div class="flex items-center gap-2">
                  {icon && <span class="w-4 h-4" set:html={icon} />}
                  <span>{text}</span>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
