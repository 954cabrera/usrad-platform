---
export interface ComfortItem {
  title: string;
  icon: string;
  description: string;
}

export interface Props {
  items: ComfortItem[];
}

const { items } = Astro.props;
---

<section class="py-20 bg-white px-6">
  <div class="max-w-7xl mx-auto">
    <h2
      class="text-3xl md:text-4xl font-bold text-[#003087] mb-12 text-center"
      data-aos="fade-up"
    >
      Designed for Comfort and Clarity
    </h2>

    <div
      class="grid md:grid-cols-3 gap-10"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      {
        items.map(({ title, icon, description }) => (
          <div class="bg-[#f0f4f9] rounded-2xl p-6 shadow-md">
            <div class="text-3xl text-[#cc9933] mb-4">{icon}</div>
            <h3 class="text-xl font-semibold text-[#003087] mb-2">{title}</h3>
            <p class="text-[#003087]/80 text-sm leading-relaxed">
              {description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
