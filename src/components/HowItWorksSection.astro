---
// HowItWorksSection.astro - Homepage teaser (preview, not duplicate)
---

<section
  class="py-16 sm:py-24 px-4 sm:px-6 bg-gradient-to-br from-white via-blue-50/20 to-white"
  data-aos="fade-up"
>
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-14" data-aos="fade-up">
      <div
        class="inline-flex items-center gap-2 bg-[#003087]/8 rounded-full px-4 py-2 mb-5"
      >
        <span class="w-1.5 h-1.5 bg-[#003087] rounded-full"></span>
        <span
          class="text-xs font-bold tracking-[0.15em] text-[#003087] uppercase"
          >Four guided steps</span
        >
      </div>
      <h2
        class="text-4xl sm:text-5xl md:text-6xl font-black text-gray-900 mb-4 leading-tight"
      >
        Getting your scan<br class="hidden sm:block" /> is this simple
      </h2>
      <p class="text-xl text-gray-500 max-w-xl mx-auto">
        No insurance navigation. No surprise bills.<br
          class="hidden sm:block"
        />USRad guides every step.
      </p>
    </div>

    <!-- Steps — compact teaser rows -->
    <div class="relative mb-12">
      <!-- Vertical connector line -->
      <div
        class="absolute left-[27px] top-10 bottom-10 w-px bg-gradient-to-b from-[#003087]/20 via-[#003087]/10 to-transparent hidden sm:block"
      >
      </div>

      <div class="space-y-3">
        <!-- Step 1 -->
        <div
          class="hiw-step group flex items-start gap-5 p-5 rounded-2xl transition-all duration-200 hover:bg-white hover:shadow-md hover:shadow-gray-100/80 cursor-default"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div
            class="hiw-num flex-shrink-0 w-14 h-14 rounded-2xl bg-[#003087] flex items-center justify-center shadow-lg shadow-[#003087]/20 transition-transform duration-200 group-hover:scale-105"
          >
            <span class="text-white font-black text-lg">1</span>
          </div>
          <div class="pt-1 flex-1">
            <div class="flex items-center gap-3 mb-1 flex-wrap">
              <h3 class="text-lg font-bold text-gray-900">Search</h3>
              <span
                class="text-xs font-semibold text-teal-600 bg-teal-50 border border-teal-100 px-2.5 py-0.5 rounded-full"
                >Under 30 seconds</span
              >
            </div>
            <p class="text-gray-500 text-sm leading-relaxed">
              Choose your scan, enter your ZIP code — instantly see your
              top-ranked imaging option with all-inclusive pricing shown
              upfront.
            </p>
          </div>
          <svg
            class="w-4 h-4 text-gray-200 flex-shrink-0 mt-1.5 group-hover:text-[#003087] transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path></svg
          >
        </div>

        <!-- Step 2 -->
        <div
          class="hiw-step group flex items-start gap-5 p-5 rounded-2xl transition-all duration-200 hover:bg-white hover:shadow-md hover:shadow-gray-100/80 cursor-default"
          data-aos="fade-up"
          data-aos-delay="175"
        >
          <div
            class="hiw-num flex-shrink-0 w-14 h-14 rounded-2xl bg-[#003087] flex items-center justify-center shadow-lg shadow-[#003087]/20 transition-transform duration-200 group-hover:scale-105"
          >
            <span class="text-white font-black text-lg">2</span>
          </div>
          <div class="pt-1 flex-1">
            <div class="flex items-center gap-3 mb-1 flex-wrap">
              <h3 class="text-lg font-bold text-gray-900">Review Your Match</h3>
              <span
                class="text-xs font-semibold text-[#C4982A] bg-[#C4982A]/8 border border-[#C4982A]/20 px-2.5 py-0.5 rounded-full"
                >67% avg. savings</span
              >
            </div>
            <p class="text-gray-500 text-sm leading-relaxed">
              USRad's system surfaces your top-ranked imaging option — selected
              by price, proximity, and verified quality. All-inclusive pricing
              shown upfront. No hidden fees. No billing surprises.
            </p>
          </div>
          <svg
            class="w-4 h-4 text-gray-200 flex-shrink-0 mt-1.5 group-hover:text-[#003087] transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path></svg
          >
        </div>

        <!-- Step 3 -->
        <div
          class="hiw-step group flex items-start gap-5 p-5 rounded-2xl transition-all duration-200 hover:bg-white hover:shadow-md hover:shadow-gray-100/80 cursor-default"
          data-aos="fade-up"
          data-aos-delay="250"
        >
          <div
            class="hiw-num flex-shrink-0 w-14 h-14 rounded-2xl bg-[#003087] flex items-center justify-center shadow-lg shadow-[#003087]/20 transition-transform duration-200 group-hover:scale-105"
          >
            <span class="text-white font-black text-lg">3</span>
          </div>
          <div class="pt-1 flex-1">
            <div class="flex items-center gap-3 mb-1 flex-wrap">
              <h3 class="text-lg font-bold text-gray-900">Request</h3>
              <span
                class="text-xs font-semibold text-gray-500 bg-gray-100 border border-gray-200 px-2.5 py-0.5 rounded-full"
                >No payment today</span
              >
            </div>
            <p class="text-gray-500 text-sm leading-relaxed">
              Submit a booking request — USRad handles all coordination with the
              imaging center on your behalf.
            </p>
          </div>
          <svg
            class="w-4 h-4 text-gray-200 flex-shrink-0 mt-1.5 group-hover:text-[#003087] transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path></svg
          >
        </div>

        <!-- Step 4 — USRad secures appointment -->
        <div
          class="hiw-step group flex items-start gap-5 p-5 rounded-2xl bg-[#003087]/[0.03] border border-[#003087]/10 transition-all duration-200 hover:bg-white hover:shadow-md hover:shadow-[#003087]/8 cursor-default"
          data-aos="fade-up"
          data-aos-delay="325"
        >
          <div
            class="hiw-num flex-shrink-0 w-14 h-14 rounded-2xl bg-gradient-to-br from-teal-500 to-teal-600 flex items-center justify-center shadow-lg shadow-teal-500/25 transition-transform duration-200 group-hover:scale-105"
          >
            <svg
              class="w-6 h-6 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path></svg
            >
          </div>
          <div class="pt-1 flex-1">
            <div class="flex items-center gap-3 mb-1 flex-wrap">
              <h3 class="text-lg font-bold text-gray-900">
                USRad Secures Your Appointment
              </h3>
              <span
                class="text-xs font-semibold text-teal-700 bg-teal-50 border border-teal-200 px-2.5 py-0.5 rounded-full"
                >Within 4 hours</span
              >
            </div>
            <p class="text-gray-500 text-sm leading-relaxed">
              Confirmed date, facility, and a secure payment link — then just
              show up. Zero payment at the facility. Results delivered directly
              to you.
            </p>
          </div>
          <svg
            class="w-4 h-4 text-gray-200 flex-shrink-0 mt-1.5 group-hover:text-teal-500 transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path></svg
          >
        </div>
      </div>
    </div>

    <!-- CTA — the key addition -->
    <div class="text-center" data-aos="fade-up" data-aos-delay="400">
      <a
        href="/how-it-works"
        class="inline-flex items-center gap-3 bg-[#003087] hover:bg-[#002070] text-white font-bold px-8 py-4 rounded-xl text-base transition-all transform hover:scale-[1.02] shadow-xl shadow-[#003087]/20 group"
      >
        See the full walkthrough
        <svg
          class="w-4 h-4 transition-transform group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
        >
      </a>
      <p class="text-xs text-gray-400 mt-3">
        Takes about 30 seconds to understand · Screenshots of the actual
        platform
      </p>
    </div>
  </div>
</section>
