---
export interface Props {
  steps: {
    number: string;
    title: string;
    description: string;
  }[];
}

const { steps } = Astro.props;
---

<div class="space-y-8">
  {
    steps.map((step) => (
      <div class="flex items-start">
        <div class="bg-[#cc9933] text-white rounded-full w-12 h-12 flex items-center justify-center font-bold text-xl mr-6 flex-shrink-0">
          {step.number}
        </div>
        <div>
          <h3 class="text-xl font-bold text-[#003087] mb-2">{step.title}</h3>
          <p class="text-[#003087]/80">{step.description}</p>
        </div>
      </div>
    ))
  }
</div>
