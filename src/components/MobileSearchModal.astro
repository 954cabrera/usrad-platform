---
// MobileSearchModal.astro - Simplified version for Astro compatibility
---

<!-- Mobile Search Modal - Full Screen Overlay -->
<div
  id="mobile-search-modal"
  class="mobile-search-modal hidden fixed inset-0 z-[10000] bg-white"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-search-title"
>
  <!-- Header: Fixed at top -->
  <div
    class="mobile-modal-header sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm"
  >
    <div class="flex items-center gap-3 p-4">
      <!-- Close Button -->
      <button
        type="button"
        id="mobile-modal-close"
        class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors"
        aria-label="Close search"
      >
        <svg
          class="w-6 h-6 text-gray-600"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Title -->
      <div class="flex-1">
        <h2
          id="mobile-search-title"
          class="text-lg font-semibold text-gray-900"
        >
          What are you searching for?
        </h2>
      </div>
    </div>

    <!-- Search Input -->
    <div class="px-4 pb-4">
      <div class="relative">
        <div
          class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
        >
          <svg
            class="w-5 h-5 text-gray-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          type="text"
          id="mobile-modal-search-input"
          placeholder="Type MRI, CT, Ultrasound..."
          autocomplete="off"
          class="w-full pl-12 pr-4 py-3.5 text-base text-gray-900 placeholder-gray-500 bg-gray-50 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#003087] focus:border-transparent transition-all"
        />
      </div>
    </div>
  </div>

  <!-- Results Container -->
  <div
    id="mobile-modal-results"
    class="mobile-modal-body overflow-y-auto"
    style="height: calc(100vh - 140px);"
  >
    <!-- Popular Procedures Section -->
    <div id="mobile-popular-section" class="px-4 py-3">
      <div class="mb-3">
        <div class="flex items-center justify-between mb-2">
          <h3
            class="text-sm font-semibold text-[#b8862d] flex items-center gap-2"
          >
            ⭐ Popular Procedures
          </h3>
          <span class="text-xs text-[#b8862d]/80 font-medium"
            >Curated by USRad</span
          >
        </div>
        <p class="text-xs text-gray-500">Or start typing to search...</p>
      </div>
      <div id="mobile-popular-list" class="space-y-2"></div>
    </div>

    <!-- Search Results Section -->
    <div id="mobile-search-section" class="hidden px-4 py-3">
      <div class="mb-3">
        <h3 class="text-sm font-semibold text-gray-700">
          <span id="mobile-results-count">0</span> Results
        </h3>
      </div>
      <div id="mobile-search-list" class="space-y-2"></div>
    </div>

    <!-- Empty State -->
    <div id="mobile-empty-state" class="hidden text-center py-16 px-4">
      <svg
        class="w-16 h-16 mx-auto mb-4 text-gray-300"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <p class="text-base font-semibold text-gray-700 mb-1">
        No procedures found
      </p>
      <p class="text-sm text-gray-500">Try a different search term</p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    // Wait for DOM to be ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMobileModal);
    } else {
      initMobileModal();
    }

    function initMobileModal() {
      const modal = document.getElementById("mobile-search-modal");
      const closeBtn = document.getElementById("mobile-modal-close");
      const searchInput = document.getElementById("mobile-modal-search-input");
      const popularSection = document.getElementById("mobile-popular-section");
      const popularList = document.getElementById("mobile-popular-list");
      const searchSection = document.getElementById("mobile-search-section");
      const searchList = document.getElementById("mobile-search-list");
      const emptyState = document.getElementById("mobile-empty-state");
      const resultsCount = document.getElementById("mobile-results-count");

      let searchTimeout = null;
      let currentQuery = "";

      // Modal API
      window.mobileSearchModal = {
        open: function () {
          if (!modal) return;
          modal.classList.remove("hidden");
          modal.classList.add("modal-enter");
          document.body.style.overflow = "hidden";
          setTimeout(() => searchInput?.focus(), 300);
          showPopularProcedures();
        },
        close: function () {
          if (!modal) return;
          modal.classList.remove("modal-enter");
          modal.classList.add("modal-exit");
          setTimeout(() => {
            modal.classList.add("hidden");
            modal.classList.remove("modal-exit");
            document.body.style.overflow = "";
            if (searchInput) searchInput.value = "";
            showPopularProcedures();
          }, 250);
        },
      };

      // Event listeners
      closeBtn?.addEventListener("click", () =>
        window.mobileSearchModal.close()
      );
      modal?.addEventListener("click", (e) => {
        if (e.target === modal) window.mobileSearchModal.close();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
          window.mobileSearchModal.close();
        }
      });

      searchInput?.addEventListener("input", (e) => {
        clearTimeout(searchTimeout);
        const query = e.target.value.trim();
        searchTimeout = setTimeout(() => performSearch(query), 200);
      });

      function showPopularProcedures() {
        if (!popularSection || !popularList) return;
        popularSection.classList.remove("hidden");
        searchSection?.classList.add("hidden");
        emptyState?.classList.add("hidden");

        const lib = window.ProcedureLibrary;
        if (!lib || !lib.Popular) return;

        popularList.innerHTML = renderGroupedResults(lib.Popular);
        attachResultHandlers();
      }

      function performSearch(query) {
        if (!query || query.length < 2) {
          showPopularProcedures();
          return;
        }

        currentQuery = query;
        popularSection?.classList.add("hidden");
        searchSection?.classList.remove("hidden");
        emptyState?.classList.add("hidden");

        const lib = window.ProcedureLibrary;
        if (!lib) return;

        const results = searchProcedures(query, lib);

        if (results.length === 0) {
          searchSection?.classList.add("hidden");
          emptyState?.classList.remove("hidden");
          return;
        }

        if (resultsCount) resultsCount.textContent = results.length.toString();
        if (searchList) {
          searchList.innerHTML = renderGroupedResults(results);
          attachResultHandlers();
        }
      }

      function searchProcedures(query, lib) {
        const results = [];
        const lowerQuery = query.toLowerCase();

        for (const modality in lib) {
          if (modality === "Popular") continue;
          for (const region in lib[modality]) {
            const entry = lib[modality][region];
            const procedures = entry.procedures || [];

            procedures.forEach((proc) => {
              const searchText =
                `${proc.label} ${modality} ${region} ${proc.cpt}`.toLowerCase();
              if (searchText.includes(lowerQuery)) {
                results.push({
                  label: proc.label,
                  cpt: proc.cpt,
                  modality: modality,
                  bodyPart: region,
                });
              }
            });
          }
        }

        return results.slice(0, 12);
      }

      function renderGroupedResults(procedures) {
        const groups = {};
        procedures.forEach((proc) => {
          const modality = proc.modality || "Other";
          if (!groups[modality]) groups[modality] = [];
          groups[modality].push(proc);
        });

        const modalityOrder = ["MRI", "CT", "X-Ray", "Ultrasound", "Other"];
        const ICONS = {
          MRI: "🧠",
          CT: "🦴",
          "X-Ray": "👀",
          Ultrasound: "🩺",
          Other: "📋",
        };

        return modalityOrder
          .map((modality) => {
            const group = groups[modality];
            if (!group || group.length === 0) return "";

            const icon = ICONS[modality] || "📋";
            return `
            <div class="mb-4 border border-gray-100 rounded-xl overflow-hidden shadow-sm">
              <div class="sticky top-0 z-10 px-4 py-2.5 bg-gradient-to-r from-[#fff8ee] to-white border-b border-[#f5e4c3]">
                <h4 class="text-sm font-semibold text-[#b8862d]">${icon} ${modality}</h4>
              </div>
              <div class="divide-y divide-gray-100">
                ${group
                  .map(
                    (proc) => `
                  <button type="button" class="w-full text-left flex items-center justify-between px-4 py-3 hover:bg-gray-50 mobile-procedure-result"
                    data-cpt="${proc.cpt}" data-label="${proc.label}" data-modality="${proc.modality}" data-bodypart="${proc.bodyPart}">
                    <span class="text-[15px] font-medium text-gray-900">${proc.label}</span>
                    <span class="text-xs px-2 py-1 rounded ${modality === "MRI" ? "bg-blue-100 text-blue-600" : "bg-gray-100 text-gray-600"}">${modality}</span>
                  </button>
                `
                  )
                  .join("")}
              </div>
            </div>
          `;
          })
          .join("");
      }

      function attachResultHandlers() {
        document.querySelectorAll(".mobile-procedure-result").forEach((btn) => {
          btn.addEventListener("click", () => {
            const procedure = {
              cpt_code: btn.getAttribute("data-cpt"),
              label: btn.getAttribute("data-label"),
              modality: btn.getAttribute("data-modality"),
              bodyPart: btn.getAttribute("data-bodypart"),
            };

            document.dispatchEvent(
              new CustomEvent("mobile-procedure-selected", {
                detail: procedure,
                bubbles: true,
              })
            );

            window.mobileSearchModal.close();
          });
        });
      }
    }
  })();
</script>

<style>
  @keyframes slideUp {
    from {
      transform: translateY(100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes slideDown {
    from {
      transform: translateY(0);
      opacity: 1;
    }
    to {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  .modal-enter {
    animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  .modal-exit {
    animation: slideDown 0.25s cubic-bezier(0.4, 0, 0.6, 1) forwards;
  }

  .mobile-modal-body {
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }
  .mobile-procedure-result:active {
    transform: scale(0.98);
    transition: transform 0.1s ease;
  }

  @media (min-width: 768px) {
    .mobile-search-modal {
      display: none !important;
    }
  }
</style>
