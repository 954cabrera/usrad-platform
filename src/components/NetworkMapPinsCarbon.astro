---
// NetworkMapPinsCarbon.astro - Enhanced Version with Strategic Messaging
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`relative overflow-hidden ${className}`}>
  <!-- Animated gradient background -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-[#003087] to-[#001a4d] opacity-95"
  >
  </div>

  <!-- Animated particles background -->
  <canvas id="particle-canvas" class="absolute inset-0 opacity-30"></canvas>

  <div
    class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 py-12 sm:py-16 lg:py-20"
  >
    <!-- Enhanced Header with Strategic Messaging -->
    <div class="text-center mb-12 sm:mb-16 animate-fade-in">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
        <span
          class="bg-gradient-to-r from-[#e6c378] via-[#ffd700] to-[#cc9933] bg-clip-text text-transparent animate-gradient"
        >
          A New Way to Get Your MRI
        </span>
      </h2>
      <p class="text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto">
        Top imaging centers competing to serve you faster and for less
      </p>
    </div>

    <!-- Enhanced Map Container -->
    <div class="relative">
      <!-- Single subtle glow layer -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#e6c378]/10 to-transparent blur-2xl"
      >
      </div>

      <!-- Map wrapper with enhanced glassmorphism -->
      <div
        class="relative bg-white/5 backdrop-blur-xl rounded-2xl sm:rounded-3xl p-4 sm:p-6 lg:p-8 border border-white/10 shadow-2xl overflow-hidden"
      >
        <!-- Animated corner accents - hidden on mobile -->
        <div
          class="hidden sm:block absolute top-0 left-0 w-20 h-20 border-t-2 border-l-2 border-[#e6c378] rounded-tl-3xl animate-corner-pulse"
        >
        </div>
        <div
          class="hidden sm:block absolute top-0 right-0 w-20 h-20 border-t-2 border-r-2 border-[#e6c378] rounded-tr-3xl animate-corner-pulse"
          style="animation-delay: 0.5s"
        >
        </div>
        <div
          class="hidden sm:block absolute bottom-0 left-0 w-20 h-20 border-b-2 border-l-2 border-[#e6c378] rounded-bl-3xl animate-corner-pulse"
          style="animation-delay: 1s"
        >
        </div>
        <div
          class="hidden sm:block absolute bottom-0 right-0 w-20 h-20 border-b-2 border-r-2 border-[#e6c378] rounded-br-3xl animate-corner-pulse"
          style="animation-delay: 1.5s"
        >
        </div>

        <!-- 3D perspective wrapper -->
        <div
          class="relative w-full max-w-4xl mx-auto transform perspective-1000"
        >
          <!-- Animated wave overlay -->
          <div class="absolute inset-0 overflow-hidden rounded-2xl">
            <div class="wave-overlay"></div>
          </div>

          <!-- US Map with enhanced styling -->
          <img
            src="/images/usa-transparent.svg"
            alt="US Map"
            loading="lazy"
            class="w-full h-auto filter drop-shadow-2xl relative z-10"
            style="filter: brightness(1.2) contrast(1.1);"
          />

          <!-- Enhanced Pin Container -->
          <div class="absolute inset-0 z-20">
            <!-- Florida -->
            <div
              class="pin-wrapper absolute"
              style="top: 83%; left: 83.5%;"
              data-state="Florida"
              data-status="Launching Q1 2025"
              data-delay="100"
            >
              <div class="pin-glow"></div>
              <img src="/images/logo/brand/usrad-pin.svg" class="pin-icon" />
              <div class="pin-tooltip">
                <h4 class="font-bold text-lg">Florida</h4>
                <p class="text-sm opacity-90">Launching Q1 2025</p>
                <p class="text-xs text-[#e6c378] mt-1">Join Early Access</p>
                <div class="tooltip-arrow"></div>
              </div>
            </div>

            <!-- Texas -->
            <div
              class="pin-wrapper absolute"
              style="top: 77%; left: 45%;"
              data-state="Texas"
              data-status="Opening Q2 2025"
              data-delay="500"
            >
              <div class="pin-glow"></div>
              <img src="/images/logo/brand/usrad-pin.svg" class="pin-icon" />
              <div class="pin-tooltip">
                <h4 class="font-bold text-lg">Texas</h4>
                <p class="text-sm opacity-90">Opening Q2 2025</p>
                <p class="text-xs text-[#e6c378] mt-1">Join Waitlist</p>
                <div class="tooltip-arrow"></div>
              </div>
            </div>

            <!-- Georgia -->
            <div
              class="pin-wrapper absolute"
              style="top: 62%; left: 77%;"
              data-state="Georgia"
              data-status="Opening Q2 2025"
              data-delay="300"
            >
              <div class="pin-glow"></div>
              <img src="/images/logo/brand/usrad-pin.svg" class="pin-icon" />
              <div class="pin-tooltip">
                <h4 class="font-bold text-lg">Georgia</h4>
                <p class="text-sm opacity-90">Opening Q2 2025</p>
                <p class="text-xs text-[#e6c378] mt-1">Join Waitlist</p>
                <div class="tooltip-arrow"></div>
              </div>
            </div>

            <!-- South Carolina -->
            <div
              class="pin-wrapper absolute"
              style="top: 57%; left: 82%;"
              data-state="South Carolina"
              data-status="Coming Soon"
              data-delay="500"
            >
              <div class="pin-glow"></div>
              <img src="/images/logo/brand/usrad-pin.svg" class="pin-icon" />
              <div class="pin-tooltip">
                <h4 class="font-bold text-lg">South Carolina</h4>
                <p class="text-sm opacity-90">Coming Soon</p>
                <p class="text-xs text-[#e6c378] mt-1">Be First to Know</p>
                <div class="tooltip-arrow"></div>
              </div>
            </div>

            <!-- North Carolina -->
            <div
              class="pin-wrapper absolute"
              style="top: 49%; left: 84%;"
              data-state="North Carolina"
              data-status="Coming Soon"
              data-delay="700"
            >
              <div class="pin-glow"></div>
              <img src="/images/logo/brand/usrad-pin.svg" class="pin-icon" />
              <div class="pin-tooltip">
                <h4 class="font-bold text-lg">North Carolina</h4>
                <p class="text-sm opacity-90">Coming Soon</p>
                <p class="text-xs text-[#e6c378] mt-1">Be First to Know</p>
                <div class="tooltip-arrow"></div>
              </div>
            </div>

            <!-- New York -->
            <div
              class="pin-wrapper absolute"
              style="top: 19%; left: 86%;"
              data-state="New York"
              data-status="Opening Q3 2025"
              data-delay="900"
            >
              <div class="pin-glow"></div>
              <img src="/images/logo/brand/usrad-pin.svg" class="pin-icon" />
              <div class="pin-tooltip">
                <h4 class="font-bold text-lg">New York</h4>
                <p class="text-sm opacity-90">Opening Q3 2025</p>
                <p class="text-xs text-[#e6c378] mt-1">Join Waitlist</p>
                <div class="tooltip-arrow"></div>
              </div>
            </div>

            <!-- New Jersey -->
            <div
              class="pin-wrapper absolute"
              style="top: 30%; left: 90%;"
              data-state="New Jersey"
              data-status="Coming Soon"
              data-delay="1100"
            >
              <div class="pin-glow"></div>
              <img src="/images/logo/brand/usrad-pin.svg" class="pin-icon" />
              <div class="pin-tooltip">
                <h4 class="font-bold text-lg">New Jersey</h4>
                <p class="text-sm opacity-90">Coming Soon</p>
                <p class="text-xs text-[#e6c378] mt-1">Be First to Know</p>
                <div class="tooltip-arrow"></div>
              </div>
            </div>

            <!-- Pennsylvania -->
            <div
              class="pin-wrapper absolute"
              style="top: 29%; left: 83%;"
              data-state="Pennsylvania"
              data-status="Coming Soon"
              data-delay="1300"
            >
              <div class="pin-glow"></div>
              <img src="/images/logo/brand/usrad-pin.svg" class="pin-icon" />
              <div class="pin-tooltip">
                <h4 class="font-bold text-lg">Pennsylvania</h4>
                <p class="text-sm opacity-90">Coming Soon</p>
                <p class="text-xs text-[#e6c378] mt-1">Be First to Know</p>
                <div class="tooltip-arrow"></div>
              </div>
            </div>

            <!-- Illinois -->
            <div
              class="pin-wrapper absolute"
              style="top: 35%; left: 63%;"
              data-state="Illinois"
              data-status="Opening Q2 2025"
              data-delay="1500"
            >
              <div class="pin-glow"></div>
              <img src="/images/logo/brand/usrad-pin.svg" class="pin-icon" />
              <div class="pin-tooltip">
                <h4 class="font-bold text-lg">Illinois</h4>
                <p class="text-sm opacity-90">Opening Q2 2025</p>
                <p class="text-xs text-[#e6c378] mt-1">Join Waitlist</p>
                <div class="tooltip-arrow"></div>
              </div>
            </div>

            <!-- California -->
            <div
              class="pin-wrapper absolute"
              style="top: 45%; left: 5%;"
              data-state="California"
              data-status="Launching Q1 2025"
              data-delay="500"
            >
              <div class="pin-glow"></div>
              <img src="/images/logo/brand/usrad-pin.svg" class="pin-icon" />
              <div class="pin-tooltip">
                <h4 class="font-bold text-lg">California</h4>
                <p class="text-sm opacity-90">Launching Q1 2025</p>
                <p class="text-xs text-[#e6c378] mt-1">Join Early Access</p>
                <div class="tooltip-arrow"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Enhanced Strategic Stats Cards -->
        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mt-8 sm:mt-12"
        >
          <div class="stat-card group">
            <div class="stat-icon-wrapper">
              <img
                src="/images/icons/mri.svg"
                alt="Centers"
                class="stat-icon-svg stat-icon-white"
              />
            </div>
            <p class="stat-number" data-target="1500">1,500</p>
            <p class="stat-label">Premium Centers Joining</p>
            <div class="stat-glow"></div>
          </div>
          <div class="stat-card group">
            <div class="stat-icon-wrapper">
              <img src="/images/logo/brand/usrad-pin.svg" alt="States" class="stat-icon-svg" />
            </div>
            <p class="stat-number" data-target="10">10</p>
            <p class="stat-label">States Opening 2026</p>
            <div class="stat-glow"></div>
          </div>
          <div class="stat-card group">
            <div class="stat-icon-wrapper">
              <img
                src="/images/icons/flash.svg"
                alt="Speed"
                class="stat-icon-svg stat-icon-white"
              />
            </div>
            <p class="stat-number">48-72</p>
            <p class="stat-label">Hour Appointment Goal</p>
            <div class="stat-glow"></div>
          </div>
          <div class="stat-card group">
            <div class="stat-icon-wrapper">
              <img
                src="/images/icons/expenses.svg"
                alt="Savings"
                class="stat-icon-svg stat-icon-white"
              />
            </div>
            <p class="stat-number" data-target="70">70</p>
            <p class="stat-label">% Lower Than Hospitals</p>
            <div class="stat-glow"></div>
          </div>
        </div>

        <!-- Dynamic Network Status Indicator -->
        <div class="network-status mt-8 sm:mt-12">
          <div class="flex items-center justify-center gap-3 mb-4">
            <span class="status-dot active"></span>
            <span
              class="text-white font-medium text-center text-sm sm:text-base"
              >Network Building: Phase 1 of 3</span
            >
          </div>
          <div class="status-bar-container">
            <div class="status-bar">
              <div class="status-progress"></div>
            </div>
          </div>
          <p
            class="status-text text-center text-gray-300 mt-4 text-sm sm:text-base"
          >
            Accepting select centers in priority markets
          </p>
        </div>
      </div>
    </div>

    <!-- Enhanced CTA Section -->
    <div class="text-center mt-8 sm:mt-12">
      <button
        type="button"
        onclick="document.getElementById('hero-section').scrollIntoView({ behavior: 'smooth', block: 'center' }); setTimeout(function() { document.getElementById('hero-section').focus(); }, 800);"
        class="cta-button group cursor-pointer"
      >
        <div class="cta-bg"></div>
        <span class="cta-text relative z-10">Find Centers Near You</span>
        <svg
          class="cta-arrow relative z-10"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
        >
          <path
            d="M 5 12 h 14 M 12 5 l 7 7 l -7 7"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <p
        class="text-gray-400 mt-4 animate-fade-in text-sm sm:text-base"
        style="animation-delay: 2s"
      >
        Building America's first <span class="text-[#e6c378] font-semibold"
          >transparent</span
        > imaging marketplace
      </p>
    </div>
  </div>

  <style>
    /* Enhanced animations */
    @keyframes float-pin {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }

    @keyframes wave-animation {
      0% {
        transform: translateX(-100%);
      }
      100% {
        transform: translateX(100%);
      }
    }

    @keyframes corner-pulse {
      0%,
      100% {
        opacity: 0.3;
      }
      50% {
        opacity: 1;
      }
    }

    @keyframes gradient-animation {
      0% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
      100% {
        background-position: 0% 50%;
      }
    }

    @keyframes pulse-slow {
      0%,
      100% {
        opacity: 0.3;
      }
      50% {
        opacity: 0.5;
      }
    }

    @keyframes progress-animation {
      0% {
        width: 0%;
      }
      100% {
        width: 33%;
      }
    }

    .animate-gradient {
      background-size: 200% 200%;
      animation: gradient-animation 3s ease infinite;
    }

    .animate-pulse-slow {
      animation: pulse-slow 4s ease-in-out infinite;
    }

    .animate-corner-pulse {
      animation: corner-pulse 3s ease-in-out infinite;
    }

    .wave-overlay {
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(
        45deg,
        transparent 40%,
        rgba(230, 195, 120, 0.1) 50%,
        transparent 60%
      );
      animation: wave-animation 8s linear infinite;
    }

    .pin-wrapper {
      cursor: pointer;
      z-index: 10;
      opacity: 0;
      animation: fade-in-up 0.8s ease-out forwards;
      animation-delay: var(--animation-delay, 0ms);
    }

    .pin-glow {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 24px;
      height: 24px;
      background: #e6c378;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      filter: blur(12px);
      opacity: 0.4;
      transition: all 0.3s ease;
    }

    .pin-wrapper:hover .pin-glow {
      width: 32px;
      height: 32px;
      opacity: 0.6;
    }

    .pin-icon {
      width: 36px;
      height: auto;
      position: relative;
      z-index: 2;
      transition: all 0.3s ease;
      filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
      animation: float-pin 4s ease-in-out infinite;
      animation-delay: var(--animation-delay, 0ms);
    }

    .pin-wrapper:hover .pin-icon {
      transform: scale(1.15) translateY(-5px);
      filter: drop-shadow(0 8px 16px rgba(230, 195, 120, 0.4));
    }

    .pin-tooltip {
      position: absolute;
      bottom: 100%;
      left: 50%;
      transform: translateX(-50%) translateY(-10px);
      background: linear-gradient(135deg, #003087 0%, #002266 100%);
      color: white;
      padding: 14px 18px;
      border-radius: 14px;
      white-space: nowrap;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(230, 195, 120, 0.3);
      backdrop-filter: blur(10px);
    }

    .pin-wrapper:hover .pin-tooltip {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(-15px);
    }

    .tooltip-arrow {
      position: absolute;
      bottom: -6px;
      left: 50%;
      transform: translateX(-50%);
      width: 12px;
      height: 12px;
      background: #002266;
      transform: translateX(-50%) rotate(45deg);
      border-right: 1px solid rgba(230, 195, 120, 0.3);
      border-bottom: 1px solid rgba(230, 195, 120, 0.3);
    }

    .stat-card {
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 20px;
      text-align: center;
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
    }

    .stat-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(
        circle at center,
        rgba(230, 195, 120, 0.1) 0%,
        transparent 70%
      );
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .stat-card:hover::before {
      opacity: 1;
    }

    .stat-card:hover {
      background: rgba(255, 255, 255, 0.08);
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
      border-color: rgba(230, 195, 120, 0.3);
    }

    .stat-icon-wrapper {
      width: 48px;
      height: 48px;
      margin: 0 auto 12px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
      backdrop-filter: blur(10px);
    }

    .stat-card:hover .stat-icon-wrapper {
      background: rgba(255, 255, 255, 0.15);
      transform: scale(1.05);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }

    .stat-icon-svg {
      width: 24px;
      height: 24px;
      filter: brightness(0) saturate(100%) invert(84%) sepia(28%)
        saturate(1245%) hue-rotate(5deg) brightness(97%) contrast(94%);
      transition: all 0.3s ease;
    }

    /* White icons (for mri, flash and expenses) */
    .stat-icon-white {
      filter: brightness(0) saturate(100%) invert(100%) sepia(0%) saturate(0%)
        hue-rotate(0deg) brightness(100%) contrast(100%) !important;
    }

    .stat-card:hover .stat-icon-svg {
      transform: scale(1.1);
    }

    .stat-number {
      font-size: 2rem;
      font-weight: 700;
      color: #e6c378;
      margin-bottom: 4px;
      text-shadow: 0 0 30px rgba(230, 195, 120, 0.5);
    }

    .stat-label {
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.8);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      line-height: 1.2;
    }

    .stat-glow {
      position: absolute;
      bottom: -50%;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 100px;
      background: radial-gradient(circle, #e6c378 0%, transparent 70%);
      opacity: 0;
      transition: all 0.3s ease;
      filter: blur(30px);
    }

    .stat-card:hover .stat-glow {
      opacity: 0.3;
      bottom: -20%;
    }

    /* Network Status Styles */
    .network-status {
      padding: 16px;
      background: rgba(255, 255, 255, 0.02);
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .status-dot {
      width: 10px;
      height: 10px;
      background: #e6c378;
      border-radius: 50%;
      display: inline-block;
      position: relative;
    }

    .status-dot.active::before {
      content: "";
      position: absolute;
      inset: -4px;
      background: #e6c378;
      border-radius: 50%;
      opacity: 0.3;
      animation: pulse-slow 2s ease-in-out infinite;
    }

    .status-bar-container {
      max-width: 400px;
      margin: 0 auto;
    }

    .status-bar {
      height: 8px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 4px;
      overflow: hidden;
      position: relative;
    }

    .status-progress {
      height: 100%;
      background: linear-gradient(90deg, #e6c378, #ffd700);
      border-radius: 4px;
      animation: progress-animation 2s ease-out forwards;
      animation-delay: 1s;
      width: 0%;
      position: relative;
      overflow: hidden;
    }

    .status-progress::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.3) 50%,
        transparent 100%
      );
      animation: wave-animation 2s linear infinite;
    }

    .status-text {
      font-size: 0.9rem;
      opacity: 0.8;
    }

    .cta-button {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 16px 32px;
      border-radius: 60px;
      font-weight: 600;
      font-size: 1rem;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      color: #003087;
      background: transparent;
      isolation: isolate;
    }

    .cta-bg {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        135deg,
        #e6c378 0%,
        #ffd700 50%,
        #cc9933 100%
      );
      background-size: 200% 200%;
      animation: gradient-animation 3s ease infinite;
      z-index: -1;
      border-radius: 60px;
    }

    .cta-button::before {
      content: "";
      position: absolute;
      inset: -2px;
      background: linear-gradient(
        135deg,
        #e6c378 0%,
        #ffd700 50%,
        #cc9933 100%
      );
      border-radius: 60px;
      z-index: -2;
      opacity: 0;
      transition: opacity 0.3s ease;
      filter: blur(20px);
    }

    .cta-button:hover::before {
      opacity: 0.8;
    }

    .cta-button:hover {
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 25px 50px rgba(230, 195, 120, 0.4);
    }

    .cta-arrow {
      width: 20px;
      height: 20px;
      transition: transform 0.3s ease;
    }

    .cta-button:hover .cta-arrow {
      transform: translateX(5px);
    }

    /* Mobile optimizations */
    @media (max-width: 768px) {
      .pin-icon {
        width: 24px;
      }

      .pin-glow {
        width: 16px;
        height: 16px;
      }

      .pin-tooltip {
        display: none !important;
      }

      .stat-icon-wrapper {
        width: 40px;
        height: 40px;
      }

      .stat-icon-svg {
        width: 20px;
        height: 20px;
      }

      .stat-number {
        font-size: 1.5rem;
      }

      .stat-card {
        padding: 16px;
      }

      .cta-button {
        padding: 14px 24px;
        font-size: 0.9rem;
      }
    }

    @media (min-width: 768px) {
      .stat-card {
        padding: 28px;
      }

      .stat-icon-wrapper {
        width: 64px;
        height: 64px;
      }

      .stat-icon-svg {
        width: 36px;
        height: 36px;
      }

      .stat-number {
        font-size: 3rem;
      }

      .stat-label {
        font-size: 0.9rem;
        letter-spacing: 1px;
      }

      .network-status {
        padding: 24px;
      }

      .cta-button {
        padding: 18px 40px;
        font-size: 1.125rem;
      }
    }

    @keyframes fade-in-up {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fade-in {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in {
      animation: fade-in 1s ease-out;
    }
  </style>

  <script>
    // Set animation delays based on data-delay attribute
    document.querySelectorAll(".pin-wrapper").forEach((pin) => {
      const delay = pin.getAttribute("data-delay") || "0";
      pin.style.setProperty("--animation-delay", delay + "ms");
    });

    // Particle animation
    const canvas = document.getElementById("particle-canvas");
    if (canvas) {
      const ctx = canvas.getContext("2d");
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;

      const particles = [];
      for (let i = 0; i < 50; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          size: Math.random() * 2 + 1,
          speedX: Math.random() * 0.5 - 0.25,
          speedY: Math.random() * 0.5 - 0.25,
        });
      }

      function animateParticles() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "#e6c378";

        particles.forEach((particle) => {
          particle.x += particle.speedX;
          particle.y += particle.speedY;

          if (particle.x < 0 || particle.x > canvas.width)
            particle.speedX *= -1;
          if (particle.y < 0 || particle.y > canvas.height)
            particle.speedY *= -1;

          ctx.beginPath();
          ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
          ctx.fill();
        });

        requestAnimationFrame(animateParticles);
      }
      animateParticles();
    }

    // Animated counter - only animate numeric values
    function animateCounter(element, target) {
      // Skip if the content contains non-numeric characters (like "48-72")
      if (isNaN(target)) return;

      const duration = 2000;
      const start = 0;
      const increment = target / (duration / 16);
      let current = start;

      const timer = setInterval(() => {
        current += increment;
        if (current >= target) {
          current = target;
          clearInterval(timer);
        }
        element.textContent = Math.floor(current);
      }, 16);
    }

    // Initialize counters when in view
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const counters = entry.target.querySelectorAll("[data-target]");
          counters.forEach((counter) => {
            const target = parseInt(counter.dataset.target);
            animateCounter(counter, target);
          });
          observer.unobserve(entry.target);
        }
      });
    });

    const statsGrid = document.querySelector(".grid");
    if (statsGrid) observer.observe(statsGrid);

    // Mobile touch interaction for pins
    if ("ontouchstart" in window) {
      document.querySelectorAll(".pin-wrapper").forEach((pin) => {
        pin.addEventListener("touchstart", function (e) {
          // Show tooltip on mobile tap
          const tooltip = this.querySelector(".pin-tooltip");
          if (tooltip) {
            tooltip.style.display = "block";
            tooltip.style.opacity = "1";
            tooltip.style.visibility = "visible";

            // Hide after 3 seconds
            setTimeout(() => {
              tooltip.style.display = "none";
            }, 3000);
          }
        });
      });
    }
  </script>
</div>
