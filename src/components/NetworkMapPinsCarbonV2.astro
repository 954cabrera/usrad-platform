---
// NetworkMapPinsCarbon.astro
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`${className}`}>
  <div class="max-w-5xl mx-auto px-6 sm:px-12">
    <!-- Map Container with relative positioning -->
    <div
      id="map-container"
      class="relative bg-gradient-to-br from-gray-50 to-blue-50 rounded-3xl p-8 shadow-lg"
    >
      <!-- Map wrapper with relative positioning -->
      <div class="relative w-full max-w-3xl mx-auto">
        <!-- Transparent US Map -->
        <img
          src="/images/usa-transparent.svg"
          alt="US Map"
          loading="lazy"
          class="w-full h-auto"
        />

        <!-- Interactive Pin Container - positioned absolutely over the map -->
        <div class="absolute inset-0">
          <!-- Each pin is wrapped for hover tooltip + scale effect -->
          <div
            class="group absolute pin"
            style="top: 83%; left: 83.5%;"
            data-delay="100"
          >
            <img
              src="/images/logo/brand/usrad-pin.svg"
              class="w-6 sm:w-7 md:w-8 h-auto transition-transform duration-200 group-hover:scale-125"
            />
            <div
              class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex px-2 py-1 bg-[#003087] text-white text-xs rounded shadow"
            >
              Florida
            </div>
          </div>
          <div
            class="group absolute pin"
            style="top: 77%; left: 45%;"
            data-delay="500"
          >
            <img
              src="/images/logo/brand/usrad-pin.svg"
              class="w-6 sm:w-7 md:w-8 h-auto transition-transform duration-200 group-hover:scale-125"
            />
            <div
              class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex px-2 py-1 bg-[#003087] text-white text-xs rounded shadow"
            >
              Texas
            </div>
          </div>
          <div
            class="group absolute pin"
            style="top: 62%; left: 77%;"
            data-delay="300"
          >
            <img
              src="/images/logo/brand/usrad-pin.svg"
              class="w-6 sm:w-7 md:w-8 h-auto transition-transform duration-200 group-hover:scale-125"
            />
            <div
              class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex px-2 py-1 bg-[#003087] text-white text-xs rounded shadow"
            >
              Georgia
            </div>
          </div>
          <div
            class="group absolute pin"
            style="top: 57%; left: 82%;"
            data-delay="500"
          >
            <img
              src="/images/logo/brand/usrad-pin.svg"
              class="w-6 sm:w-7 md:w-8 h-auto transition-transform duration-200 group-hover:scale-125"
            />
            <div
              class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex px-2 py-1 bg-[#003087] text-white text-xs rounded shadow"
            >
              South Carolina
            </div>
          </div>
          <div
            class="group absolute pin"
            style="top: 49%; left: 84%;"
            data-delay="700"
          >
            <img
              src="/images/logo/brand/usrad-pin.svg"
              class="w-6 sm:w-7 md:w-8 h-auto transition-transform duration-200 group-hover:scale-125"
            />
            <div
              class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex px-2 py-1 bg-[#003087] text-white text-xs rounded shadow"
            >
              North Carolina
            </div>
          </div>
          <div
            class="group absolute pin"
            style="top: 19%; left: 86%;"
            data-delay="900"
          >
            <img
              src="/images/logo/brand/usrad-pin.svg"
              class="w-6 sm:w-7 md:w-8 h-auto transition-transform duration-200 group-hover:scale-125"
            />
            <div
              class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex px-2 py-1 bg-[#003087] text-white text-xs rounded shadow"
            >
              New York
            </div>
          </div>
          <div
            class="group absolute pin"
            style="top: 30%; left: 90%;"
            data-delay="1100"
          >
            <img
              src="/images/logo/brand/usrad-pin.svg"
              class="w-6 sm:w-7 md:w-8 h-auto transition-transform duration-200 group-hover:scale-125"
            />
            <div
              class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex px-2 py-1 bg-[#003087] text-white text-xs rounded shadow"
            >
              New Jersey
            </div>
          </div>
          <div
            class="group absolute pin"
            style="top: 29%; left: 83%;"
            data-delay="1300"
          >
            <img
              src="/images/logo/brand/usrad-pin.svg"
              class="w-6 sm:w-7 md:w-8 h-auto transition-transform duration-200 group-hover:scale-125"
            />
            <div
              class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex px-2 py-1 bg-[#003087] text-white text-xs rounded shadow"
            >
              Pennsylvania
            </div>
          </div>
          <div
            class="group absolute pin"
            style="top: 35%; left: 63%;"
            data-delay="1500"
          >
            <img
              src="/images/logo/brand/usrad-pin.svg"
              class="w-6 sm:w-7 md:w-8 h-auto transition-transform duration-200 group-hover:scale-125"
            />
            <div
              class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex px-2 py-1 bg-[#003087] text-white text-xs rounded shadow"
            >
              Illinois
            </div>
          </div>
          <div
            class="group absolute pin"
            style="top: 45%; left: 5%;"
            data-delay="500"
          >
            <img
              src="/images/logo/brand/usrad-pin.svg"
              class="w-6 sm:w-7 md:w-8 h-auto transition-transform duration-200 group-hover:scale-125"
            />
            <div
              class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex px-2 py-1 bg-[#003087] text-white text-xs rounded shadow"
            >
              California
            </div>
          </div>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
        <div class="text-center">
          <p class="text-2xl font-bold text-[#003087]">50</p>
          <p class="text-sm text-gray-600">States coming</p>
        </div>
        <div class="text-center">
          <p class="text-2xl font-bold text-[#003087]">1,500+</p>
          <p class="text-sm text-gray-600">Expanding Network</p>
        </div>
        <div class="text-center">
          <p class="text-2xl font-bold text-[#003087]">48hr</p>
          <p class="text-sm text-gray-600">Booking</p>
        </div>
        <div class="text-center">
          <p class="text-2xl font-bold text-[#003087]">95%</p>
          <p class="text-sm text-gray-600">Coverage</p>
        </div>
      </div>

      <!-- CTA Button -->
      <!-- CTA Button Section -->
      <div class="bg-gray-50 px-8 py-6 text-center">
        <a
          href="/search-results"
          class="inline-block bg-[#003087] text-white px-8 py-3 rounded-lg font-medium hover:bg-[#002266] transition"
        >
          Find Centers Near You →
        </a>
      </div>

      <style>
        @keyframes floatUp {
          from {
            opacity: 0;
            transform: translateY(30px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        .pin {
          opacity: 0;
          transform: translateY(30px);
        }

        .pin-visible {
          animation: floatUp 0.8s ease-out forwards;
        }
      </style>

      <script>
        // Intersection Observer for scroll-triggered animations
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const pins = entry.target.querySelectorAll(".pin");
                pins.forEach((pin) => {
                  const delay = pin.getAttribute("data-delay") || "0";
                  setTimeout(() => {
                    pin.classList.add("pin-visible");
                  }, parseInt(delay));
                });
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.3, // Trigger when 30% of the map is visible
          }
        );

        // Observe the map container
        const mapContainer = document.getElementById("map-container");
        if (mapContainer) {
          observer.observe(mapContainer);
        }
      </script>
    </div>
  </div>
</div>
