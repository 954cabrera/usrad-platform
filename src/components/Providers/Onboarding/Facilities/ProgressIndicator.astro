---
// src/components/Providers/Onboarding/Facilities/ProgressIndicator.astro
const { currentStep = 2 } = Astro.props;

const steps = [
  {
    id: 1,
    label: "Account",
    status:
      currentStep > 1 ? "completed" : currentStep === 1 ? "active" : "pending",
  },
  {
    id: 2,
    label: "Centers",
    status:
      currentStep > 2 ? "completed" : currentStep === 2 ? "active" : "pending",
  },
  {
    id: 3,
    label: "Pricing",
    status:
      currentStep > 3 ? "completed" : currentStep === 3 ? "active" : "pending",
  },
  {
    id: 4,
    label: "Review",
    status:
      currentStep > 4 ? "completed" : currentStep === 4 ? "active" : "pending",
  },
  {
    id: 5,
    label: "Sign",
    status:
      currentStep > 5 ? "completed" : currentStep === 5 ? "active" : "pending",
  },
];
---

<div class="progress-container">
  <div class="progress-steps">
    {
      steps.map((step) => (
        <div class={`step ${step.status}`}>
          <div class="step-number">
            {step.status === "completed" ? "✓" : step.id}
          </div>
          <div class="step-label">{step.label}</div>
        </div>
      ))
    }
  </div>
</div>
