---
// src/components/Providers/Onboarding/Facilities/QuickStats.astro
---

<div class="quick-stats">
  <div class="stat-card">
    <div class="stat-icon">
      <img src="/images/icons/check-mark.svg" alt="Hospital icon" />
    </div>
    <div class="stat-content">
      <div class="stat-number" id="center-count">0</div>
      <div class="stat-label">Centers Added</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon">
      <img src="/images/icons/usa-map.svg" alt="Location icon" />
    </div>
    <div class="stat-content">
      <div class="stat-number" id="state-count">0</div>
      <div class="stat-label">States Covered</div>
    </div>
  </div>
  <div class="stat-card highlight">
    <div class="stat-icon">
      <img src="/images/icons/revenue.svg" alt="Revenue icon" />
    </div>
    <div class="stat-content">
      <div class="stat-number">$150M+</div>
      <div class="stat-label">Revenue Delivered</div>
    </div>
  </div>
</div>
