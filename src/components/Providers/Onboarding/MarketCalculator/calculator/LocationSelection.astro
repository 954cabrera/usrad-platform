---
// src/components/Providers/Onboarding/MarketCalculator/calculator/LocationSelection.astro
---

<div class="calculator-section">
  <label class="input-label">Your Location</label>
  <div class="location-inputs">
    <select id="state-select" class="location-select">
      <option value="">Select State</option>
      <option value="FL">Florida</option>
      <option value="GA">Georgia</option>
      <option value="TX">Texas</option>
      <option value="CA">California</option>
      <option value="NY">New York</option>
    </select>
    <select id="county-select" class="location-select">
      <option value="">Select County</option>
    </select>
  </div>
</div>
