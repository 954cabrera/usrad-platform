---
// src/components/Providers/Onboarding/MarketCalculator/calculator/RevenueProjection.astro
---

<div
  class="revenue-projection-card"
  id="revenue-projection"
  style="display: none;"
>
  <h3>Your Annual Revenue Potential</h3>
  <div class="projection-metrics">
    <div class="projection-item">
      <span class="projection-label">Avg Rate/Scan</span>
      <span class="projection-value" id="avg-rate">$450</span>
    </div>
    <div class="projection-item">
      <span class="projection-label">Est. Volume</span>
      <span class="projection-value" id="est-volume">15-20/week</span>
    </div>
    <div class="projection-item highlight">
      <span class="projection-label">Annual Revenue</span>
      <span class="projection-value" id="annual-revenue">$351,000</span>
    </div>
  </div>
</div>
