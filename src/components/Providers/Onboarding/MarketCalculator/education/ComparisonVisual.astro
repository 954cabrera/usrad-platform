---
// src/components/Providers/Onboarding/MarketCalculator/education/ComparisonVisual.astro
---

<div class="comparison-visual">
  <div class="center-comparison">
    <div class="center-card winning">
      <div class="center-label">Center A</div>
      <div class="price-badge">$450</div>
      <div class="medicare-rate">100% Medicare</div>
      <div class="outcome-badge success">
        <span class="volume-number">15-20</span>
        <span class="volume-text">patients/week</span>
      </div>
      <div class="revenue-projection">
        Projected: <strong>$351,000/year</strong>
      </div>
    </div>

    <div class="vs-divider">VS</div>

    <div class="center-card losing">
      <div class="center-label">Center B</div>
      <div class="price-badge">$675</div>
      <div class="medicare-rate">150% Medicare</div>
      <div class="outcome-badge low">
        <span class="volume-number">2-3</span>
        <span class="volume-text">patients/week</span>
      </div>
      <div class="revenue-projection">
        Projected: <strong>$87,750/year</strong>
      </div>
    </div>
  </div>
</div>
