---
// src/components/Providers/Onboarding/MarketCalculator/education/InsightsSection.astro
const insights = [
  {
    icon: "/images/icons/money.svg",
    title: "Patients Save Money",
    description: "Average savings of $500+ per scan drives patient choice",
  },
  {
    icon: "/images/icons/trend.svg",
    title: "Volume Beats Margin",
    description: "4x more patients at competitive rates = higher total revenue",
  },
  {
    icon: "/images/icons/shield.svg",
    title: "Guaranteed Payment",
    description: "10-day payment with zero collection risk",
  },
];
---

<div class="insights-section">
  <h3 class="insights-title">Why This Works</h3>
  <div class="insight-cards">
    {
      insights.map((insight) => (
        <div class="insight-card">
          <img src={insight.icon} alt={insight.title} width="48" height="48" />
          <div class="insight-content">
            <h4>{insight.title}</h4>
            <p>{insight.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
