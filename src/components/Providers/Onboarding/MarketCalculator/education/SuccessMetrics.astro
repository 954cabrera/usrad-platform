---
// src/components/Providers/Onboarding/MarketCalculator/education/SuccessMetrics.astro
const metrics = [
  {
    value: "$150M+",
    label: "Delivered through AnciCare",
  },
  {
    value: "10 Days",
    label: "Payment guarantee",
  },
  {
    value: "0%",
    label: "Collection risk",
  },
];
---

<div class="success-metrics">
  {
    metrics.map((metric) => (
      <div class="metric">
        <div class="metric-value">{metric.value}</div>
        <div class="metric-label">{metric.label}</div>
      </div>
    ))
  }
</div>
