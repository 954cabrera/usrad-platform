---
// src/components/Providers/Onboarding/RoleSection.astro
// Fixed role selection - saves role but doesn't redirect immediately
---

<section class="role-selection-container">
  <div class="role-header">
    <h2 class="role-title">What describes your role?</h2>
    <p class="role-subtitle">
      This helps us customize your onboarding experience and set up the right
      features for your organization.
    </p>
  </div>

  <div class="role-grid">
    <!-- Center Administrator -->
    <div class="role-card" data-role="center-admin">
      <div class="role-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
          <path
            d="M12 2L2 7v10c0 5.55 3.84 9.74 9 11 5.16-1.26 9-5.45 9-11V7l-10-5z"
            stroke="currentColor"
            stroke-width="2"
            fill="none"></path>
          <path
            d="M9 12l2 2 4-4"
            stroke="currentColor"
            stroke-width="2"
            fill="none"></path>
        </svg>
      </div>
      <h3 class="role-name">Center Administrator</h3>
      <p class="role-description">
        I manage a single imaging center and need straightforward setup to start
        receiving referrals quickly.
      </p>
      <div class="role-features">
        <div class="feature">✓ Simple rate setup</div>
        <div class="feature">✓ Quick onboarding</div>
        <div class="feature">✓ Single facility focus</div>
      </div>
      <div class="role-badge single">Single Location</div>
    </div>

    <!-- Multi-Center -->
    <div class="role-card" data-role="multi-center">
      <div class="role-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
          <path
            d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"
            stroke="currentColor"
            stroke-width="2"
            fill="none"></path>
          <polyline
            points="9,22 9,12 15,12 15,22"
            stroke="currentColor"
            stroke-width="2"
            fill="none"></polyline>
          <circle cx="6" cy="6" r="1" fill="currentColor"></circle>
          <circle cx="18" cy="6" r="1" fill="currentColor"></circle>
          <circle cx="12" cy="18" r="1" fill="currentColor"></circle>
        </svg>
      </div>
      <h3 class="role-name">Multi-Center</h3>
      <p class="role-description">
        I oversee multiple imaging centers across different locations and want
        to optimize rates by market.
      </p>
      <div class="role-features">
        <div class="feature">✓ State-based pricing</div>
        <div class="feature">✓ Portfolio analytics</div>
        <div class="feature">✓ Bulk management</div>
      </div>
      <div class="role-badge multi">Multiple Locations</div>
    </div>

    <!-- Executive/Corporate -->
    <div class="role-card" data-role="executive">
      <div class="role-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
          <rect
            x="3"
            y="4"
            width="18"
            height="18"
            rx="2"
            ry="2"
            stroke="currentColor"
            stroke-width="2"
            fill="none"></rect>
          <line
            x1="16"
            y1="2"
            x2="16"
            y2="6"
            stroke="currentColor"
            stroke-width="2"></line>
          <line
            x1="8"
            y1="2"
            x2="8"
            y2="6"
            stroke="currentColor"
            stroke-width="2"></line>
          <line
            x1="3"
            y1="10"
            x2="21"
            y2="10"
            stroke="currentColor"
            stroke-width="2"></line>
          <circle cx="8" cy="15" r="1" fill="currentColor"></circle>
          <circle cx="12" cy="15" r="1" fill="currentColor"></circle>
          <circle cx="16" cy="15" r="1" fill="currentColor"></circle>
        </svg>
      </div>
      <h3 class="role-name">Executive/Corporate</h3>
      <p class="role-description">
        I'm setting up enterprise-level partnerships with complex rate
        structures and need advanced configuration.
      </p>
      <div class="role-features">
        <div class="feature">✓ Custom rate structures</div>
        <div class="feature">✓ Market intelligence</div>
        <div class="feature">✓ Enterprise analytics</div>
      </div>
      <div class="role-badge enterprise">Enterprise Level</div>
    </div>
  </div>

  <!-- Role Confirmation Section (appears after selection) -->
  <div id="role-confirmation" class="role-confirmation" style="display: none;">
    <div class="confirmation-content">
      <div class="confirmation-icon">✓</div>
      <h3 id="confirmation-title">Role Selected</h3>
      <p id="confirmation-message">
        We'll customize your experience for this role type.
      </p>
    </div>
  </div>

  <div class="role-note">
    <p>
      <strong>Note:</strong> Your role selection helps us customize your onboarding
      experience. You can change this later in your account preferences.
    </p>
  </div>
</section>

<style>
  .role-selection-container {
    background: white;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    border: 1px solid rgba(14, 165, 233, 0.15);
    margin-bottom: 2rem;
  }

  .role-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .role-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: #0c4a6e;
    margin: 0 0 0.75rem;
  }

  .role-subtitle {
    font-size: 1.125rem;
    color: #64748b;
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .role-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .role-card {
    border: 2px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
    background: #f9fafb;
    position: relative;
  }

  .role-card:hover {
    border-color: #0ea5e9;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(14, 165, 233, 0.15);
    background: white;
  }

  .role-card.selected {
    border-color: #059669;
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    box-shadow: 0 8px 24px rgba(5, 150, 105, 0.2);
  }

  .role-icon {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    margin-bottom: 1rem;
    transition: background 0.2s ease;
  }

  .role-card.selected .role-icon {
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
  }

  .role-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0c4a6e;
    margin: 0 0 0.5rem;
  }

  .role-description {
    color: #475569;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .role-features {
    margin-bottom: 1rem;
  }

  .feature {
    font-size: 0.875rem;
    color: #059669;
    margin-bottom: 0.25rem;
    font-weight: 600;
  }

  .role-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  .role-badge.single {
    background: #dbeafe;
    color: #1e40af;
  }

  .role-badge.multi {
    background: #d1fae5;
    color: #065f46;
  }

  .role-badge.enterprise {
    background: #fef3c7;
    color: #92400e;
  }

  .role-confirmation {
    margin: 2rem 0;
    padding: 1.5rem;
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    border: 2px solid #059669;
    border-radius: 1rem;
    text-align: center;
    animation: fadeInSlideUp 0.4s ease-out;
  }

  @keyframes fadeInSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .confirmation-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .confirmation-icon {
    width: 48px;
    height: 48px;
    background: #059669;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .confirmation-content h3 {
    color: #065f46;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .confirmation-content p {
    color: #16a34a;
    margin: 0;
    font-weight: 600;
  }

  .role-note {
    text-align: center;
    padding: 1rem;
    background: #f8fafc;
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
  }

  .role-note p {
    color: #64748b;
    font-size: 0.875rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .role-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .role-selection-container {
      padding: 1.5rem;
    }

    .role-title {
      font-size: 1.5rem;
    }

    .confirmation-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

<script>
  // Role selection logic - NO immediate redirect
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof window === "undefined") return;

    const roleCards = document.querySelectorAll(".role-card");
    const roleConfirmation = document.getElementById("role-confirmation");
    const confirmationTitle = document.getElementById("confirmation-title");
    const confirmationMessage = document.getElementById("confirmation-message");
    let selectedRole = null;

    // Load previously selected role if any
    try {
      const savedRole = localStorage.getItem("usrad_role");
      if (savedRole) {
        selectedRole = savedRole;
        updateSelection();
        showConfirmation(savedRole);
      }
    } catch (error) {
      console.warn("Could not load saved role:", error);
    }

    // Handle role card clicks
    roleCards.forEach((card) => {
      card.addEventListener("click", () => {
        const role = card.dataset.role;
        selectedRole = role;
        updateSelection();
        saveRole(role);
        showConfirmation(role);
      });
    });

    function updateSelection() {
      // Update visual selection
      roleCards.forEach((card) => {
        card.classList.toggle("selected", card.dataset.role === selectedRole);
      });
    }

    function saveRole(role) {
      try {
        localStorage.setItem("usrad_role", role);
        console.log("Role saved:", role);
      } catch (error) {
        console.warn("Could not save role:", error);
      }
    }

    function showConfirmation(role) {
      const roleNames = {
        "center-admin": "Center Administrator",
        "multi-center": "Multi-Center",
        executive: "Executive/Corporate",
      };

      const messages = {
        "center-admin":
          "Perfect for single facility operations with streamlined setup.",
        "multi-center":
          "Great choice for managing multiple locations with market-based pricing.",
        executive:
          "Ideal for enterprise-level partnerships with advanced configuration options.",
      };

      confirmationTitle.textContent = `${roleNames[role]} Selected`;
      confirmationMessage.textContent = messages[role];

      roleConfirmation.style.display = "block";

      // Scroll to show confirmation
      roleConfirmation.scrollIntoView({
        behavior: "smooth",
        block: "center",
      });
    }

    // Make role available globally for other scripts
    window.getSelectedRole = () => selectedRole;
  });
</script>
