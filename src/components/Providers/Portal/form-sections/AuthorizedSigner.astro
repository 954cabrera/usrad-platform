---
// form-sections/AuthorizedSigner.astro
---

<div class="form-section">
  <h3 class="section-title">Authorized Signer Information</h3>
  <p class="section-description">
    This person will sign the Provider Service Agreement on behalf of the
    organization
  </p>
  <div class="form-grid">
    <div class="form-group">
      <label class="form-label">
        First Name <span class="required">*</span>
      </label>
      <input
        type="text"
        name="signerFirstName"
        class="form-input"
        placeholder="John"
        required
      />
    </div>

    <div class="form-group">
      <label class="form-label">
        Last Name <span class="required">*</span>
      </label>
      <input
        type="text"
        name="signerLastName"
        class="form-input"
        placeholder="Smith"
        required
      />
    </div>

    <div class="form-group">
      <label class="form-label">
        Title <span class="required">*</span>
      </label>
      <input
        type="text"
        name="signerTitle"
        class="form-input"
        placeholder="CEO"
        required
      />
    </div>

    <div class="form-group">
      <label class="form-label">
        Email <span class="required">*</span>
      </label>
      <input
        type="email"
        name="signerEmail"
        class="form-input"
        placeholder="john.smith@company.com"
        pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"
        title="Please enter a valid email address"
        required
      />
    </div>

    <div class="form-group">
      <label class="form-label">
        Direct Phone <span class="required">*</span>
      </label>
      <input
        type="tel"
        name="signerPhone"
        class="form-input"
        placeholder="(305) 555-0100"
        required
      />
    </div>
  </div>
</div>
