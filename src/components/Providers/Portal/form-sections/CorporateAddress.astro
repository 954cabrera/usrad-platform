---
// form-sections/CorporateAddress.astro
import { states } from "../../shared/data/statesData.js";

// Filter out common states from all states to avoid duplicates
const otherStates = states.all.filter(
  (state) => !states.common.find((common) => common.value === state.value)
);
---

<div class="form-section">
  <h3 class="section-title">Corporate Address</h3>
  <div class="form-grid">
    <div class="form-group full-width">
      <label class="form-label">
        Street Address <span class="required">*</span>
      </label>
      <input
        type="text"
        name="corpAddress"
        class="form-input"
        placeholder="123 Corporate Blvd, Suite 100"
        required
      />
    </div>

    <div class="form-group">
      <label class="form-label">
        City <span class="required">*</span>
      </label>
      <input
        type="text"
        name="corpCity"
        class="form-input"
        placeholder="Miami"
        required
      />
    </div>

    <div class="form-group">
      <label class="form-label">
        State <span class="required">*</span>
      </label>
      <select name="corpState" class="form-input" required>
        <option value="">Select State</option>
        <optgroup label="Common States">
          {
            states.common.map((state) => (
              <option value={state.value}>{state.label}</option>
            ))
          }
        </optgroup>
        <optgroup label="All States">
          {
            otherStates.map((state) => (
              <option value={state.value}>{state.label}</option>
            ))
          }
        </optgroup>
      </select>
    </div>

    <div class="form-group">
      <label class="form-label">
        ZIP Code <span class="required">*</span>
      </label>
      <input
        type="text"
        name="corpZip"
        class="form-input"
        placeholder="33101"
        pattern="[0-9]{5}"
        maxlength="5"
        required
      />
    </div>
  </div>
</div>
