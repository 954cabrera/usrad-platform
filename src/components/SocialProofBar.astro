---
// SocialProofBar.astro - Social proof statistics section
---

<!-- Social Proof Bar -->
<section
  class="bg-gray-50 py-8 sm:py-10 px-4 sm:px-6 border-y border-gray-100 relative z-10"
  data-aos="fade-up"
>
  <div class="max-w-7xl mx-auto">
    <p
      class="text-xs font-semibold uppercase tracking-wide text-gray-400 text-center mb-6"
    >
      Built on a proven imaging network
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-8 text-center">
      <div data-aos="fade-up" data-aos-delay="100">
        <div class="text-3xl md:text-4xl font-bold text-[#003087]">168,244</div>
        <div class="text-base text-gray-600">
          Patients served across our prior imaging network
        </div>
      </div>
      <div data-aos="fade-up" data-aos-delay="200">
        <div class="text-3xl md:text-4xl font-bold text-[#003087]">
          $246 Million
        </div>
        <div class="text-base text-gray-600">Patient savings delivered</div>
      </div>
      <div data-aos="fade-up" data-aos-delay="300">
        <div class="text-3xl md:text-4xl font-bold text-[#003087]">1,200+</div>
        <div class="text-base text-gray-600">
          Imaging centers previously connected
        </div>
      </div>
      <div data-aos="fade-up" data-aos-delay="400">
        <div class="text-3xl md:text-4xl font-bold text-[#003087]">4.9★</div>
        <div class="text-base text-gray-600">Average patient satisfaction</div>
      </div>
    </div>
  </div>
</section>
