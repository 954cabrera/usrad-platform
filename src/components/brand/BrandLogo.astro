---
/**
 * BrandLogo — Full USRad logo (symbol + wordmark).
 *
 * USRad Cross-Repo Brand Logo Contract v1.2
 * Canonical path: /images/logo/brand/
 *
 * Props:
 *   variant   – "primary" | "white" | "navy" | "black"
 *   size      – "compact" | "navbar" | "header" | "footer" | "login" | "login-lg"
 *   printSize – "compact" | "navbar" | "header"
 *   branding  – "sm" | "md" | "lg" | "xl"
 *   alt       – alt text override
 *   class     – additional classes
 *
 * size and branding are mutually exclusive.
 * If both are provided, branding wins and a dev warning is emitted.
 * printSize is additive — it layers print-media classes alongside size.
 */

export interface Props {
  variant?: "primary" | "white" | "navy" | "black";
  size?: "compact" | "navbar" | "header" | "footer" | "login" | "login-lg";
  printSize?: "compact" | "navbar" | "header";
  branding?: "sm" | "md" | "lg" | "xl";
  alt?: string;
  class?: string;
}

const {
  variant = "primary",
  size,
  printSize,
  branding,
  alt = "USRad",
  class: className,
} = Astro.props;

// ── §3 Variant → file mapping ───────────────────────────────────────
const variantMap: Record<string, string> = {
  primary: "/images/logo/brand/usrad-logo.svg",
  white:   "/images/logo/brand/usrad-logo-white.svg",
  navy:    "/images/logo/brand/usrad-logo-navy.svg",
  black:   "/images/logo/brand/usrad-logo-black.svg",
};

const src = variantMap[variant] ?? variantMap.primary;

// ── §3 Size tokens (height-driven, responsive) ─────────────────────
const sizeMap: Record<string, string> = {
  compact:    "h-7 sm:h-9",
  navbar:     "h-8 sm:h-10",
  header:     "h-10 sm:h-12",
  footer:     "h-8 sm:h-10",
  login:      "h-16",
  "login-lg": "h-20",
};

// ── §3 Print-size tokens (print media) ──────────────────────────────
const printSizeMap: Record<string, string> = {
  compact: "print:h-9",
  navbar:  "print:h-10",
  header:  "print:h-12",
};

// ── §4 Branding tokens (width-driven) ───────────────────────────────
const brandingMap: Record<string, string> = {
  sm: "max-w-[120px] h-auto w-full",  // 120px
  md: "max-w-[160px] h-auto w-full",  // 160px
  lg: "max-w-[200px] h-auto w-full",  // 200px
  xl: "max-w-[280px] h-auto w-full",  // 280px
};

// ── Mutual exclusivity: size vs branding ────────────────────────────
if (size && branding && import.meta.env.DEV) {
  console.warn(
    `[BrandLogo] Both "size" and "branding" were provided. "branding" takes precedence. Remove "size" to silence this warning.`
  );
}

let tokenClasses: string;
if (branding) {
  tokenClasses = brandingMap[branding] ?? brandingMap.md;
} else if (size) {
  tokenClasses = sizeMap[size] ?? sizeMap.navbar;
} else {
  tokenClasses = sizeMap.navbar; // default: 40px
}

// ── Print-size (additive, not mutually exclusive) ───────────────────
const printClasses = printSize ? (printSizeMap[printSize] ?? "") : "";

// ── Assemble classes ────────────────────────────────────────────────
const classes = [
  "select-none",
  "object-contain",
  tokenClasses,
  printClasses,
  className,
].filter(Boolean).join(" ");
---

<img src={src} alt={alt} class={classes} />
