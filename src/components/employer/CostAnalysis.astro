---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- The Real Cost Section - Mobile Optimized -->
<section
  id="cost-analysis"
  class={`py-16 sm:py-24 px-4 sm:px-6 bg-white ${className}`}
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12 sm:mb-16">
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 sm:mb-6"
        data-aos="fade-up"
      >
        The True Cost of Delayed Imaging
      </h2>
      <p
        class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        It's not just the scan price. It's the cascade of costs that follow.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 sm:gap-12 items-center">
      <!-- Cost Breakdown -->
      <div data-aos="fade-right">
        <div class="space-y-4 sm:space-y-6">
          <div
            class="bg-gradient-to-r from-red-50 to-white rounded-xl p-4 sm:p-6 border-l-4 border-red-500"
          >
            <h3 class="font-semibold text-base sm:text-lg text-gray-900 mb-2">
              When Employees Delay Due to Cost
            </h3>
            <ul class="space-y-2 text-sm sm:text-base text-gray-700">
              <li class="flex items-start gap-2">
                <span class="text-red-500 flex-shrink-0">→</span>
                <span>Conditions worsen, requiring more complex treatment</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500 flex-shrink-0">→</span>
                <span>Disability claims extend by 18+ days average</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500 flex-shrink-0">→</span>
                <span>Productivity losses compound weekly</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500 flex-shrink-0">→</span>
                <span>Injuries worsen and claims escalate</span>
              </li>
            </ul>
          </div>

          <div
            class="bg-gradient-to-r from-orange-50 to-white rounded-xl p-4 sm:p-6 border-l-4 border-orange-500"
          >
            <h3 class="font-semibold text-base sm:text-lg text-gray-900 mb-2">
              The Hospital Markup Reality
            </h3>
            <div class="space-y-3 text-sm sm:text-base">
              <div class="flex justify-between items-center">
                <span class="text-gray-700">Imaging Center Rate</span>
                <span class="font-semibold">$600</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-700">Hospital Outpatient</span>
                <span class="font-semibold text-red-600">$3,200</span>
              </div>
              <div class="pt-3 border-t">
                <div class="flex justify-between items-center">
                  <span class="font-semibold text-gray-900"
                    >Hospital markup vs. imaging center</span
                  >
                  <span class="font-bold text-red-600">5.3×</span>
                </div>
              </div>
            </div>
          </div>

          <p class="text-xs text-gray-500 max-w-xl">
            Hospital and imaging center rates shown are representative cash-pay
            prices for a plain MRI without a negotiated contract. Actual prices
            vary by market and facility. USRad network pricing reflects
            contracted rates that vary by market.
          </p>
        </div>
      </div>

      <!-- Visual Impact -->
      <div data-aos="fade-left">
        <div
          class="bg-gradient-to-br from-gray-50 to-white rounded-2xl shadow-xl p-4 sm:p-8"
        >
          <h3
            class="text-xl sm:text-2xl font-bold text-gray-900 mb-4 sm:mb-6 text-center"
          >
            Illustrative Example: Lower Back Pain
          </h3>

          <!-- Timeline Comparison -->
          <div class="space-y-6 sm:space-y-8">
            <div>
              <h4 class="font-semibold text-red-600 mb-3 text-sm sm:text-base">
                Without Affordable Access
              </h4>
              <div class="relative">
                <div
                  class="absolute left-0 top-0 bottom-0 w-1 bg-red-200 rounded"
                >
                </div>
                <div class="space-y-3 sm:space-y-4 pl-4 sm:pl-6">
                  <div class="relative">
                    <div
                      class="absolute -left-6 sm:-left-8 w-3 sm:w-4 h-3 sm:h-4 bg-red-500 rounded-full"
                    >
                    </div>
                    <p class="text-xs sm:text-sm">
                      <span class="font-semibold">Day 1:</span> Pain starts, employee
                      continues working
                    </p>
                  </div>
                  <div class="relative">
                    <div
                      class="absolute -left-6 sm:-left-8 w-3 sm:w-4 h-3 sm:h-4 bg-red-500 rounded-full"
                    >
                    </div>
                    <p class="text-xs sm:text-sm">
                      <span class="font-semibold">Week 2:</span> Can't afford $3,200
                      MRI, tries PT
                    </p>
                  </div>
                  <div class="relative">
                    <div
                      class="absolute -left-6 sm:-left-8 w-3 sm:w-4 h-3 sm:h-4 bg-red-500 rounded-full"
                    >
                    </div>
                    <p class="text-xs sm:text-sm">
                      <span class="font-semibold">Week 4:</span> Injury worsens,
                      costs escalate
                    </p>
                  </div>
                  <div class="relative">
                    <div
                      class="absolute -left-6 sm:-left-8 w-3 sm:w-4 h-3 sm:h-4 bg-red-500 rounded-full"
                    >
                    </div>
                    <p class="text-xs sm:text-sm">
                      <span class="font-semibold">Week 8:</span> Surgery required,
                      6-month disability
                    </p>
                  </div>
                </div>
              </div>
              <p
                class="text-red-600 font-semibold mt-3 sm:mt-4 text-sm sm:text-base"
              >
                Total Cost: $45,000+
              </p>
            </div>

            <div>
              <h4
                class="font-semibold text-green-600 mb-3 text-sm sm:text-base"
              >
                With USRad Access
              </h4>
              <div class="relative">
                <div
                  class="absolute left-0 top-0 bottom-0 w-1 bg-green-200 rounded"
                >
                </div>
                <div class="space-y-3 sm:space-y-4 pl-4 sm:pl-6">
                  <div class="relative">
                    <div
                      class="absolute -left-6 sm:-left-8 w-3 sm:w-4 h-3 sm:h-4 bg-green-500 rounded-full"
                    >
                    </div>
                    <p class="text-xs sm:text-sm">
                      <span class="font-semibold">Day 1:</span> Pain starts, books
                      $260 MRI
                    </p>
                  </div>
                  <div class="relative">
                    <div
                      class="absolute -left-6 sm:-left-8 w-3 sm:w-4 h-3 sm:h-4 bg-green-500 rounded-full"
                    >
                    </div>
                    <p class="text-xs sm:text-sm">
                      <span class="font-semibold">Day 3:</span> MRI reveals minor
                      disc issue
                    </p>
                  </div>
                  <div class="relative">
                    <div
                      class="absolute -left-6 sm:-left-8 w-3 sm:w-4 h-3 sm:h-4 bg-green-500 rounded-full"
                    >
                    </div>
                    <p class="text-xs sm:text-sm">
                      <span class="font-semibold">Week 2:</span> Targeted treatment,
                      continues working
                    </p>
                  </div>
                  <div class="relative">
                    <div
                      class="absolute -left-6 sm:-left-8 w-3 sm:w-4 h-3 sm:h-4 bg-green-500 rounded-full"
                    >
                    </div>
                    <p class="text-xs sm:text-sm">
                      <span class="font-semibold">Week 4:</span> Full recovery, no
                      lost time
                    </p>
                  </div>
                </div>
              </div>
              <p
                class="text-green-600 font-semibold mt-3 sm:mt-4 text-sm sm:text-base"
              >
                Total Cost: $1,200
              </p>
            </div>
          </div>

          <div
            class="mt-6 sm:mt-8 p-3 sm:p-4 bg-blue-50 rounded-lg border border-blue-200 text-center"
          >
            <p class="text-xl sm:text-2xl font-bold text-blue-900">
              97% Cost Reduction
            </p>
            <p class="text-xs sm:text-sm text-blue-700">
              Plus retained productivity and employee satisfaction
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
