---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- Quick Credibility Bar - Mobile Optimized -->
<section
  class={`py-6 sm:py-8 px-4 sm:px-6 bg-gray-900 border-t border-gray-800 ${className}`}
>
  <div class="max-w-7xl mx-auto">
    <div
      class="flex flex-col sm:flex-row flex-wrap justify-center items-center gap-6 sm:gap-8 text-center"
    >
      <div class="text-white">
        <span class="text-xs sm:text-sm opacity-80">From the founders of</span>
        <span class="block text-base sm:text-lg font-semibold"
          >AnciCare (1994)</span
        >
      </div>
      <div class="hidden sm:block w-px h-8 bg-gray-700"></div>
      <div class="text-white">
        <span class="text-xs sm:text-sm opacity-80">AnciCare</span>
        <span class="block text-base sm:text-lg font-semibold"
          >168,000+ imaging cases</span
        >
      </div>
      <div class="hidden sm:block w-px h-8 bg-gray-700"></div>
      <div class="text-white">
        <span class="text-xs sm:text-sm opacity-80">Model operating</span>
        <span class="block text-base sm:text-lg font-semibold"
          >20+ Years Post-Exit</span
        >
      </div>
    </div>
  </div>
</section>
