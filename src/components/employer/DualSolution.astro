---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- The USRad Solution - Mobile Optimized -->
<section
  id="dual-solution"
  class={`py-16 sm:py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-50 to-white ${className}`}
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12 sm:mb-16">
      <div
        class="inline-flex items-center gap-2 bg-green-100 text-green-800 rounded-full px-3 sm:px-4 py-1.5 sm:py-2 mb-4 sm:mb-6"
        data-aos="fade-down"
      >
        <span class="text-xs sm:text-sm font-medium">The USRad Solution</span>
      </div>

      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 sm:mb-6"
        data-aos="fade-up"
      >
        One Partner. Two Populations. Total Control.
      </h2>

      <p
        class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        The model our founders built for workers' compensation, applied to
        employee health benefits.
      </p>
    </div>

    <!-- Two Solutions Side by Side -->
    <div class="grid lg:grid-cols-2 gap-8 sm:gap-10 mb-12 sm:mb-16">
      <!-- Where the Model Was Built (AnciCare history) -->
      <div
        class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 border-t-4 border-blue-600"
        data-aos="zoom-in"
      >
        <div class="flex items-center gap-3 mb-4 sm:mb-6">
          <div
            class="w-10 sm:w-12 h-10 sm:h-12 bg-blue-100 rounded-xl flex items-center justify-center"
          >
            <span class="text-xl sm:text-2xl">🏗️</span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-gray-900">
            Where the Model Was Built
          </h3>
        </div>

        <p class="text-sm sm:text-base text-gray-700 mb-4 sm:mb-6">
          Our founders built AnciCare, a managed-care imaging carve-out for
          workers' compensation, from 1994 to 2002. By April 2002 it had
          contracted 1,228 imaging facilities across 43 states.
        </p>

        <ul class="space-y-3 text-sm sm:text-base">
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700">
              AnciCare contracted flat rates in place of variable billing
            </span>
          </li>

          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700">
              Faster imaging shortened time to treatment and return to work
            </span>
          </li>
        </ul>

        <div class="mt-4 sm:mt-6 p-3 sm:p-4 bg-blue-50 rounded-lg">
          <p class="text-xs sm:text-sm text-blue-800">
            AnciCare delivered imaging at 50% or more below the Florida
            workers' compensation fee schedule, 1994–2002.
          </p>
        </div>
      </div>
      <!-- CLOSE Where the Model Was Built Card -->

      <!-- Employee Health Solution -->
      <div
        class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 border-t-4 border-green-600"
        data-aos="zoom-in"
        data-aos-delay="100"
      >
        <div class="flex items-center gap-3 mb-4 sm:mb-6">
          <div
            class="w-10 sm:w-12 h-10 sm:h-12 bg-green-100 rounded-xl flex items-center justify-center"
          >
            <span class="text-xl sm:text-2xl">👥</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900">
            For Health Plan Members
          </h3>
        </div>

        <p class="text-sm sm:text-base text-gray-700 mb-4 sm:mb-6">
          Imaging employees can price before they book.
        </p>

        <p class="text-sm sm:text-base text-gray-700 mb-3 sm:mb-4">
          The program is designed so that:
        </p>

        <ul class="space-y-3 text-sm sm:text-base">
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700"
              >One all-inclusive price, known before booking</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700"
              >No prior auth or referral requirements</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700">Booking by phone or web</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
