---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- The Proven Solution - Mobile Optimized -->
<section
  id="proven-solution"
  class={`py-16 sm:py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-50 to-white ${className}`}
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12 sm:mb-16">
      <div
        class="inline-flex items-center gap-2 bg-green-100 text-green-800 rounded-full px-3 sm:px-4 py-1.5 sm:py-2 mb-4 sm:mb-6"
        data-aos="fade-down"
      >
        <span class="text-xs sm:text-sm font-medium">The USRad Solution</span>
      </div>

      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 sm:mb-6"
        data-aos="fade-up"
      >
        One Partner. Two Populations. Total Control.
      </h2>

      <p
        class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        The same proven model that transformed workers' comp imaging now
        available for your employee health benefits
      </p>
    </div>

    <!-- Two Solutions Side by Side -->
    <div class="grid lg:grid-cols-2 gap-8 sm:gap-10 mb-12 sm:mb-16">
      <!-- Workers' Comp Solution -->
      <div
        class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 border-t-4 border-blue-600"
        data-aos="zoom-in"
      >
        <div class="flex items-center gap-3 mb-4 sm:mb-6">
          <div
            class="w-10 sm:w-12 h-10 sm:h-12 bg-blue-100 rounded-xl flex items-center justify-center"
          >
            <span class="text-xl sm:text-2xl">🏗️</span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-gray-900">
            For Workers' Compensation Programs
          </h3>
        </div>

        <p class="text-sm sm:text-base text-gray-700 mb-4 sm:mb-6">
          The managed imaging model we created and scaled across
          <span class="font-semibold">168,000+ diagnostic imaging cases</span>
        </p>

        <ul class="space-y-3 text-sm sm:text-base">
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700">
              48-hour imaging appointments accelerate diagnosis and treatment
              decisions
            </span>
          </li>

          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700">
              Transparent flat rates eliminate cost escalation
            </span>
          </li>

          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700">
              Faster imaging leads to earlier treatment and improved
              return-to-work outcomes
            </span>
          </li>
        </ul>

        <div class="mt-4 sm:mt-6 p-3 sm:p-4 bg-blue-50 rounded-lg">
          <p class="text-xs sm:text-sm text-blue-800">
            <span class="font-semibold">Proven Impact:</span>
            50–70% imaging cost reduction · 18+ days faster return-to-work
          </p>
        </div>
      </div>
      <!-- CLOSE Workers Comp Card -->

      <!-- Employee Health Solution -->
      <div
        class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 border-t-4 border-green-600"
        data-aos="zoom-in"
        data-aos-delay="100"
      >
        <div class="flex items-center gap-3 mb-4 sm:mb-6">
          <div
            class="w-10 sm:w-12 h-10 sm:h-12 bg-green-100 rounded-xl flex items-center justify-center"
          >
            <span class="text-xl sm:text-2xl">👥</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-gray-900">
            For Health Plan Members
          </h3>
        </div>

        <p class="text-sm sm:text-base text-gray-700 mb-4 sm:mb-6">
          Breaking down the high-deductible barrier to necessary care
        </p>

        <ul class="space-y-3 text-sm sm:text-base">
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700"
              >$260 MRIs employees can actually afford</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700"
              >No prior auth or referral requirements</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700"
              >Evening/weekend hours for convenience</span
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-gray-700"
              >Mobile booking increases utilization</span
            >
          </li>
        </ul>

        <div class="mt-4 sm:mt-6 p-3 sm:p-4 bg-green-50 rounded-lg">
          <p class="text-xs sm:text-sm text-green-800">
            <span class="font-semibold">Member Impact:</span> 73% increase in necessary
            imaging, 92% satisfaction score
          </p>
        </div>
      </div>
    </div>

    <!-- Integration Benefits -->
    <div
      class="bg-gradient-to-r from-gray-900 to-gray-800 text-white rounded-2xl p-6 sm:p-8 md:p-12"
      data-aos="fade-up"
    >
      <div class="text-center mb-6 sm:mb-8">
        <h3 class="text-xl sm:text-2xl font-bold mb-3 sm:mb-4">
          The Power of One Integrated Solution
        </h3>
        <p class="text-sm sm:text-base text-gray-300 max-w-3xl mx-auto">
          Why managing both populations through USRad multiplies your benefits
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 sm:gap-8">
        <div class="text-center">
          <div
            class="w-14 sm:w-16 h-14 sm:h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-3 sm:mb-4"
          >
            <span class="text-2xl sm:text-3xl">📊</span>
          </div>
          <h4 class="font-semibold text-base sm:text-lg mb-2">
            Unified Analytics
          </h4>
          <p class="text-xs sm:text-sm text-gray-300">
            Single dashboard for all imaging spend across both populations
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-14 sm:w-16 h-14 sm:h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-3 sm:mb-4"
          >
            <span class="text-2xl sm:text-3xl">🔄</span>
          </div>
          <h4 class="font-semibold text-base sm:text-lg mb-2">
            Seamless Transitions
          </h4>
          <p class="text-xs sm:text-sm text-gray-300">
            When injuries become WC claims, continuity of care is maintained
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-14 sm:w-16 h-14 sm:h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-3 sm:mb-4"
          >
            <span class="text-2xl sm:text-3xl">💰</span>
          </div>
          <h4 class="font-semibold text-base sm:text-lg mb-2">
            Volume Advantages
          </h4>
          <p class="text-xs sm:text-sm text-gray-300">
            Combined volume drives even better pricing and priority access
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
