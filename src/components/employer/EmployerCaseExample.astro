---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- Employer Case Example - Composite Scenario -->
<section
  class={`py-16 sm:py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-white ${className}`}
>
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-12 sm:mb-16">
      <div
        class="inline-flex items-center gap-2 bg-[#cc9933]/20 text-[#cc9933] rounded-full px-4 py-2 mb-4 sm:mb-6"
        data-aos="fade-down"
      >
        <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest"
          >Composite Case Study</span
        >
      </div>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 sm:mb-6"
        data-aos="fade-up"
      >
        What This Looks Like in Practice
      </h2>
      <p
        class="text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Based on outcomes from comparable self-insured employers in logistics
        and distribution
      </p>
    </div>

    <!-- Case Card -->
    <div
      class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-3xl overflow-hidden"
      data-aos="fade-up"
      data-aos-delay="150"
    >
      <!-- Company Header Bar -->
      <div
        class="bg-[#cc9933]/15 border-b border-white/10 px-6 sm:px-10 py-5 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8"
      >
        <div class="flex items-center gap-4">
          <div
            class="w-12 h-12 bg-[#cc9933]/20 rounded-xl flex items-center justify-center flex-shrink-0"
          >
            <span class="text-2xl">🚚</span>
          </div>
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-widest text-[#cc9933] mb-0.5"
            >
              Composite Employer Profile
            </p>
            <p class="text-lg font-bold text-white">
              Regional Logistics & Distribution Company
            </p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3 sm:ml-auto">
          <span
            class="bg-white/10 text-gray-200 text-xs font-medium px-3 py-1.5 rounded-full"
            >4,800 Employees</span
          >
          <span
            class="bg-white/10 text-gray-200 text-xs font-medium px-3 py-1.5 rounded-full"
            >Self-Insured</span
          >
          <span
            class="bg-white/10 text-gray-200 text-xs font-medium px-3 py-1.5 rounded-full"
            >Multi-State Operations</span
          >
          <span
            class="bg-white/10 text-gray-200 text-xs font-medium px-3 py-1.5 rounded-full"
            >High WC Volume</span
          >
        </div>
      </div>

      <div class="p-6 sm:p-10">
        <div class="grid lg:grid-cols-3 gap-8 sm:gap-10">
          <!-- Before Column -->
          <div>
            <div class="flex items-center gap-2 mb-6">
              <div
                class="w-7 h-7 bg-red-500/20 rounded-full flex items-center justify-center flex-shrink-0"
              >
                <span class="text-red-400 text-sm font-bold">✕</span>
              </div>
              <h3
                class="text-base font-bold text-red-400 uppercase tracking-wide"
              >
                Before USRad
              </h3>
            </div>
            <div class="space-y-4">
              <div
                class="bg-red-500/10 border border-red-500/20 rounded-xl p-4"
              >
                <p class="text-xs text-gray-400 mb-1">Average MRI cost</p>
                <p class="text-2xl font-bold text-red-400">$3,400</p>
                <p class="text-xs text-gray-500 mt-1">
                  Hospital outpatient billing
                </p>
              </div>
              <div
                class="bg-red-500/10 border border-red-500/20 rounded-xl p-4"
              >
                <p class="text-xs text-gray-400 mb-1">Annual imaging spend</p>
                <p class="text-2xl font-bold text-red-400">$5.1M</p>
                <p class="text-xs text-gray-500 mt-1">
                  Group health + workers' comp
                </p>
              </div>
              <div
                class="bg-red-500/10 border border-red-500/20 rounded-xl p-4"
              >
                <p class="text-xs text-gray-400 mb-1">
                  Avg. disability duration
                </p>
                <p class="text-2xl font-bold text-red-400">47 days</p>
                <p class="text-xs text-gray-500 mt-1">
                  Delayed imaging = delayed RTW
                </p>
              </div>
              <div
                class="bg-red-500/10 border border-red-500/20 rounded-xl p-4"
              >
                <p class="text-xs text-gray-400 mb-1">
                  Employees skipping imaging
                </p>
                <p class="text-2xl font-bold text-red-400">67%</p>
                <p class="text-xs text-gray-500 mt-1">
                  Due to $6,500 avg. deductible
                </p>
              </div>
            </div>
          </div>

          <!-- Arrow / Divider -->
          <div
            class="hidden lg:flex flex-col items-center justify-center gap-6"
          >
            <div
              class="w-px flex-1 bg-gradient-to-b from-transparent via-white/20 to-transparent"
            >
            </div>
            <div
              class="w-14 h-14 bg-[#cc9933]/20 border border-[#cc9933]/30 rounded-full flex items-center justify-center flex-shrink-0"
            >
              <svg
                class="w-6 h-6 text-[#cc9933]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </div>
            <div class="text-center">
              <p
                class="text-xs text-[#cc9933] font-semibold uppercase tracking-widest"
              >
                USRad
              </p>
              <p class="text-xs text-gray-400">30-day</p>
              <p class="text-xs text-gray-400">implementation</p>
            </div>
            <div
              class="w-px flex-1 bg-gradient-to-b from-transparent via-white/20 to-transparent"
            >
            </div>
          </div>

          <!-- After Column -->
          <div>
            <div class="flex items-center gap-2 mb-6">
              <div
                class="w-7 h-7 bg-green-500/20 rounded-full flex items-center justify-center flex-shrink-0"
              >
                <span class="text-green-400 text-sm font-bold">✓</span>
              </div>
              <h3
                class="text-base font-bold text-green-400 uppercase tracking-wide"
              >
                After USRad
              </h3>
            </div>
            <div class="space-y-4">
              <div
                class="bg-green-500/10 border border-green-500/20 rounded-xl p-4"
              >
                <p class="text-xs text-gray-400 mb-1">Average MRI cost</p>
                <p class="text-2xl font-bold text-green-400">$420</p>
                <p class="text-xs text-gray-500 mt-1">
                  Independent accredited centers
                </p>
              </div>
              <div
                class="bg-green-500/10 border border-green-500/20 rounded-xl p-4"
              >
                <p class="text-xs text-gray-400 mb-1">Annual imaging spend</p>
                <p class="text-2xl font-bold text-green-400">$1.8M</p>
                <p class="text-xs text-gray-500 mt-1">63% reduction year one</p>
              </div>
              <div
                class="bg-green-500/10 border border-green-500/20 rounded-xl p-4"
              >
                <p class="text-xs text-gray-400 mb-1">
                  Avg. disability duration
                </p>
                <p class="text-2xl font-bold text-green-400">29 days</p>
                <p class="text-xs text-gray-500 mt-1">
                  48-hr appointments accelerate RTW
                </p>
              </div>
              <div
                class="bg-green-500/10 border border-green-500/20 rounded-xl p-4"
              >
                <p class="text-xs text-gray-400 mb-1">Imaging utilization</p>
                <p class="text-2xl font-bold text-green-400">+73%</p>
                <p class="text-xs text-gray-500 mt-1">
                  Affordable access drives compliance
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Summary Bar -->
        <div class="mt-10 pt-8 border-t border-white/10">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
            <div>
              <p class="text-4xl sm:text-5xl font-bold text-[#cc9933] mb-1">
                $3.3M
              </p>
              <p class="text-sm text-gray-300">Annual savings — year one</p>
            </div>
            <div>
              <p class="text-4xl sm:text-5xl font-bold text-[#cc9933] mb-1">
                18 days
              </p>
              <p class="text-sm text-gray-300">Faster return-to-work average</p>
            </div>
            <div>
              <p class="text-4xl sm:text-5xl font-bold text-[#cc9933] mb-1">
                30 days
              </p>
              <p class="text-sm text-gray-300">From contract to fully live</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Disclaimer + CTA -->
    <div
      class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-between gap-6"
    >
      <p class="text-xs text-gray-500 max-w-xl">
        * Composite profile based on outcomes from comparable self-insured
        employers. Individual results vary based on workforce size, utilization
        patterns, and existing plan structure.
      </p>
      <a
        href="/employer/schedule"
        class="flex-shrink-0 bg-[#cc9933] hover:bg-[#b8861f] text-white px-6 sm:px-8 py-3 sm:py-4 rounded-xl font-semibold text-sm sm:text-base transition-all inline-flex items-center gap-2"
        data-aos="fade-left"
      >
        See Your Numbers
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
