---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- Hero Section - Mobile Optimized -->
<section
  class={`relative pt-24 sm:pt-32 pb-16 sm:pb-20 px-4 sm:px-6 overflow-hidden bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 ${className}`}
>
  <!-- Subtle pattern background -->
  <div class="absolute inset-0 opacity-10">
    <div
      class="absolute inset-0"
      style="background-image: url('data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23FFFFFF' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"
    >
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <div class="max-w-5xl">
      <!-- Category Label -->
      <div
        class="inline-flex items-center bg-white/10 text-gray-200 backdrop-blur-sm ring-1 ring-white/15 rounded-full px-3 sm:px-4 py-1.5 sm:py-2 mb-4 sm:mb-6"
        data-aos="fade-down"
      >
        <span class="text-xs sm:text-sm font-medium tracking-widest"
          >FOR SELF-FUNDED EMPLOYERS</span
        >
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 sm:mb-6 leading-tight"
        data-aos="fade-up"
      >
        Your plan pays for imaging.
        <span class="text-red-400 block">
          Your employees decide whether to get it.
        </span>
      </h1>

      <p
        class="text-lg sm:text-xl md:text-2xl text-gray-200 mb-6 sm:mb-8 leading-relaxed max-w-3xl"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        When a scan feels unaffordable, it gets postponed. The condition
        doesn't.
      </p>

      <!-- Value Props - Stacked -->
      <div
        class="flex flex-col gap-3 sm:gap-4 text-base sm:text-lg mb-8 sm:mb-10 max-w-3xl"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div class="flex items-start gap-2">
          <svg
            class="w-5 h-5 text-green-400 flex-shrink-0 mt-1"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-gray-200">Independent imaging centers</span>
        </div>
        <div class="flex items-start gap-2">
          <svg
            class="w-5 h-5 text-green-400 flex-shrink-0 mt-1"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-gray-200"
            >One all-inclusive price, known before booking</span
          >
        </div>
        <div class="flex items-start gap-2">
          <svg
            class="w-5 h-5 text-green-400 flex-shrink-0 mt-1"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-gray-200"
            >USRad pays the center directly. Your employee never negotiates a
            rate.</span
          >
        </div>
      </div>

      <!-- CTAs - Full width on mobile, inline on desktop -->
      <div
        class="flex flex-col sm:flex-row gap-3 sm:gap-4"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <a
          href="#roi-calculator"
          class="bg-white hover:bg-gray-100 text-gray-900 px-6 sm:px-8 py-3 sm:py-4 rounded-xl font-semibold text-base sm:text-lg transition-all inline-flex items-center justify-center gap-2 w-full sm:w-auto"
        >
          Calculate Your Imaging Spend
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a
          href="/employer/schedule"
          class="bg-transparent hover:bg-white/10 text-white border-2 border-white px-6 sm:px-8 py-3 sm:py-4 rounded-xl font-semibold text-base sm:text-lg transition-all w-full sm:w-auto text-center inline-flex items-center justify-center"
        >
          Schedule Executive Briefing
        </a>
      </div>
    </div>
  </div>
</section>
