---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- Industry Data Section - Mobile Optimized -->
<section class={`py-16 sm:py-24 px-4 sm:px-6 bg-white ${className}`}>
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12 sm:mb-16">
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 sm:mb-6"
        data-aos="fade-up"
      >
        The Data Self-Insured Executives Need to See
      </h2>
      <p
        class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Third-party research validates what we've known for 30 years
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mb-8 sm:mb-12">
      <div
        class="bg-white rounded-xl shadow-lg p-4 sm:p-6 text-center border-t-4 border-red-500"
        data-aos="zoom-in"
      >
        <div class="text-3xl sm:text-4xl font-bold text-red-600 mb-1 sm:mb-2">
          67%
        </div>
        <p class="text-xs sm:text-sm text-gray-700 mb-1 sm:mb-2">
          of employees skip needed imaging due to cost
        </p>
        <p class="text-xs text-gray-500">EBRI 2023</p>
      </div>

      <div
        class="bg-white rounded-xl shadow-lg p-4 sm:p-6 text-center border-t-4 border-orange-500"
        data-aos="zoom-in"
        data-aos-delay="100"
      >
        <div
          class="text-3xl sm:text-4xl font-bold text-orange-600 mb-1 sm:mb-2"
        >
          $6,500
        </div>
        <p class="text-xs sm:text-sm text-gray-700 mb-1 sm:mb-2">
          average family deductible
        </p>
        <p class="text-xs text-gray-500">KFF 2023</p>
      </div>

      <div
        class="bg-white rounded-xl shadow-lg p-4 sm:p-6 text-center border-t-4 border-purple-500"
        data-aos="zoom-in"
        data-aos-delay="200"
      >
        <div
          class="text-3xl sm:text-4xl font-bold text-purple-600 mb-1 sm:mb-2"
        >
          12x
        </div>
        <p class="text-xs sm:text-sm text-gray-700 mb-1 sm:mb-2">
          price variation for same MRI
        </p>
        <p class="text-xs text-gray-500">RAND 2023</p>
      </div>

      <div
        class="bg-white rounded-xl shadow-lg p-4 sm:p-6 text-center border-t-4 border-blue-500"
        data-aos="zoom-in"
        data-aos-delay="300"
      >
        <div class="text-3xl sm:text-4xl font-bold text-blue-600 mb-1 sm:mb-2">
          31%
        </div>
        <p class="text-xs sm:text-sm text-gray-700 mb-1 sm:mb-2">
          longer disability when imaging delayed
        </p>
        <p class="text-xs text-gray-500">IBI 2023</p>
      </div>
    </div>

    <!-- Bottom Line Impact -->
    <div
      class="bg-gradient-to-r from-gray-900 to-gray-800 text-white rounded-2xl p-6 sm:p-8 md:p-12"
      data-aos="fade-up"
    >
      <h3 class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6 text-center">
        What This Means for Your Bottom Line
      </h3>
      <div class="grid md:grid-cols-3 gap-6 sm:gap-8 text-center">
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-red-400 mb-1 sm:mb-2">
            +$847
          </div>
          <p class="text-xs sm:text-sm">
            Additional cost per delayed diagnosis (average)
          </p>
        </div>
        <div>
          <div
            class="text-2xl sm:text-3xl font-bold text-orange-400 mb-1 sm:mb-2"
          >
            +18 days
          </div>
          <p class="text-xs sm:text-sm">Extended disability duration</p>
        </div>
        <div>
          <div
            class="text-2xl sm:text-3xl font-bold text-yellow-400 mb-1 sm:mb-2"
          >
            -12 NPS
          </div>
          <p class="text-xs sm:text-sm">Employee satisfaction impact</p>
        </div>
      </div>

      <div class="mt-6 sm:mt-8 text-center">
        <p class="text-base sm:text-lg mb-3 sm:mb-4">
          Every imaging delay cascades into higher costs across your entire
          benefits spend
        </p>
        <a
          href="/employer/cost-analysis"
          class="inline-flex items-center gap-2 text-yellow-400 hover:text-yellow-300 font-semibold text-sm sm:text-base"
        >
          See Full Cost Analysis
          <svg
            class="w-4 sm:w-5 h-4 sm:h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
