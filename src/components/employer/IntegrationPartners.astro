---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- Integration Partners - Mobile Optimized -->
<section class={`py-16 sm:py-24 px-4 sm:px-6 bg-white ${className}`}>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12 sm:mb-16">
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 sm:mb-6"
        data-aos="fade-up"
      >
        Seamless Integration with Your Ecosystem
      </h2>
      <p
        class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        We've already integrated with the platforms you use
      </p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 md:gap-8">
      <div
        class="bg-gray-50 rounded-xl p-4 sm:p-6 text-center hover:shadow-lg transition-all hover:-translate-y-1"
        data-aos="zoom-in"
      >
        <div
          class="w-12 sm:w-16 h-12 sm:h-16 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-3 sm:mb-4"
        >
          <span class="text-xl sm:text-2xl">🔗</span>
        </div>
        <h3
          class="font-semibold text-gray-900 mb-1 sm:mb-2 text-sm sm:text-base"
        >
          Major TPAs
        </h3>
        <p class="text-xs sm:text-sm text-gray-600">
          Sedgwick, Gallagher Bassett, ESIS, Broadspire, and more
        </p>
      </div>

      <div
        class="bg-gray-50 rounded-xl p-4 sm:p-6 text-center hover:shadow-lg transition-all hover:-translate-y-1"
        data-aos="zoom-in"
        data-aos-delay="100"
      >
        <div
          class="w-12 sm:w-16 h-12 sm:h-16 bg-green-100 rounded-xl flex items-center justify-center mx-auto mb-3 sm:mb-4"
        >
          <span class="text-xl sm:text-2xl">📱</span>
        </div>
        <h3
          class="font-semibold text-gray-900 mb-1 sm:mb-2 text-sm sm:text-base"
        >
          Benefits Platforms
        </h3>
        <p class="text-xs sm:text-sm text-gray-600">
          Single sign-on, embedded booking
        </p>
      </div>

      <div
        class="bg-gray-50 rounded-xl p-4 sm:p-6 text-center hover:shadow-lg transition-all hover:-translate-y-1"
        data-aos="zoom-in"
        data-aos-delay="200"
      >
        <div
          class="w-12 sm:w-16 h-12 sm:h-16 bg-purple-100 rounded-xl flex items-center justify-center mx-auto mb-3 sm:mb-4"
        >
          <span class="text-xl sm:text-2xl">🏥</span>
        </div>
        <h3
          class="font-semibold text-gray-900 mb-1 sm:mb-2 text-sm sm:text-base"
        >
          Care Navigation
        </h3>
        <p class="text-xs sm:text-sm text-gray-600">
          API-first architecture for seamless member experience
        </p>
      </div>

      <div
        class="bg-gray-50 rounded-xl p-4 sm:p-6 text-center hover:shadow-lg transition-all hover:-translate-y-1"
        data-aos="zoom-in"
        data-aos-delay="300"
      >
        <div
          class="w-12 sm:w-16 h-12 sm:h-16 bg-orange-100 rounded-xl flex items-center justify-center mx-auto mb-3 sm:mb-4"
        >
          <span class="text-xl sm:text-2xl">📊</span>
        </div>
        <h3
          class="font-semibold text-gray-900 mb-1 sm:mb-2 text-sm sm:text-base"
        >
          Analytics Tools
        </h3>
        <p class="text-xs sm:text-sm text-gray-600">
          Real-time data feeds to your BI platforms
        </p>
      </div>
    </div>

    <div class="text-center mt-8 sm:mt-12">
      <p class="text-sm sm:text-base text-gray-600">
        Don't see your platform? We integrate with any system via API.
      </p>
    </div>
  </div>
</section>
