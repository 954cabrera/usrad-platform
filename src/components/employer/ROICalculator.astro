---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- ROI Calculator - Upgraded Phase 1 -->
<section
  id="roi-calculator"
  class={`py-16 sm:py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-900 to-gray-800 text-white ${className}`}
>
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12 sm:mb-16">
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 sm:mb-6"
        data-aos="fade-up"
      >
        Calculate Your Total Imaging Savings
      </h2>
      <p
        class="text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        See the combined impact across workers' comp and employee health
        benefits
      </p>
    </div>

    <div
      class="bg-white/10 backdrop-blur-sm rounded-2xl sm:rounded-3xl p-6 sm:p-8 md:p-12"
      data-aos="zoom-in"
    >
      <div class="grid md:grid-cols-2 gap-8 sm:gap-12">
        <!-- Input Side -->
        <div>
          <h3 class="text-xl sm:text-2xl font-bold mb-6">
            Your Current Numbers
          </h3>
          <div class="space-y-5 sm:space-y-6">
            <div>
              <label class="block text-sm font-medium mb-2"
                >Total Employees</label
              >
              <input
                type="text"
                inputmode="numeric"
                id="total-employees"
                value="5,000"
                class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-green-400 text-base"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2"
                >Annual WC Imaging Scans</label
              >
              <input
                type="text"
                inputmode="numeric"
                id="wc-scans"
                value="120"
                class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-green-400 text-base"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2"
                >Annual Employee Health Scans</label
              >
              <input
                type="text"
                inputmode="numeric"
                id="health-scans"
                value="380"
                class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-green-400 text-base"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2"
                >Average Cost per Scan Today</label
              >
              <div class="relative">
                <span
                  class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 text-gray-300 font-medium pointer-events-none"
                  >$</span
                >
                <input
                  type="text"
                  inputmode="numeric"
                  id="avg-cost"
                  value="2,400"
                  class="w-full pl-7 sm:pl-8 pr-3 sm:pr-4 py-2.5 sm:py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-green-400 text-base"
                />
              </div>
            </div>
          </div>

          <!-- Cost Comparison Bars -->
          <div class="mt-8">
            <p class="text-sm text-gray-300 mb-4 font-medium">
              Average Cost Per Scan
            </p>
            <div class="space-y-3">
              <div>
                <div class="flex justify-between text-xs text-gray-300 mb-1">
                  <span>Your Current Cost</span>
                  <span id="bar-current-cost" class="font-semibold text-red-400"
                    >$2,400</span
                  >
                </div>
                <div class="w-full bg-gray-700 rounded-full h-3">
                  <div
                    id="current-bar"
                    class="bg-red-500 h-3 rounded-full transition-all duration-500"
                    style="width:100%"
                  >
                  </div>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-xs text-gray-300 mb-1">
                  <span>USRad Network</span>
                  <span class="font-semibold text-green-400">$350</span>
                </div>
                <div class="w-full bg-gray-700 rounded-full h-3">
                  <div
                    id="usrad-bar"
                    class="bg-green-500 h-3 rounded-full transition-all duration-500"
                    style="width:15%"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Results Side -->
        <div>
          <!-- Personalized context header -->
          <p id="roi-context" class="text-sm text-gray-400 mb-2 h-5"></p>
          <h3 class="text-xl sm:text-2xl font-bold mb-6">
            Your Savings Potential
          </h3>

          <div class="space-y-4">
            <div class="grid grid-cols-2 gap-3 sm:gap-4">
              <div class="bg-white/10 rounded-xl p-4 sm:p-5">
                <p class="text-xs text-gray-300 mb-1">Current Annual Spend</p>
                <p
                  class="text-xl sm:text-2xl font-bold text-red-400 break-words"
                  id="current-spend"
                >
                  $1,200,000
                </p>
              </div>
              <div class="bg-white/10 rounded-xl p-4 sm:p-5">
                <p class="text-xs text-gray-300 mb-1">USRad Annual Cost</p>
                <p
                  class="text-xl sm:text-2xl font-bold text-green-400 break-words"
                  id="usrad-cost"
                >
                  $175,000
                </p>
              </div>
            </div>

            <!-- Hero savings card — visually dominant -->
            <div
              class="bg-gradient-to-r from-green-600 to-emerald-600 rounded-2xl p-6 sm:p-8 shadow-xl border border-green-400/20 text-center"
            >
              <p class="text-xs sm:text-sm text-white/80 mb-1">
                Projected Year-One Savings
              </p>
              <p
                class="text-4xl sm:text-5xl font-bold text-white tracking-tight break-words"
                id="annual-savings"
              >
                $850,000
              </p>
              <p
                class="text-base sm:text-lg text-white/80 mt-2"
                id="savings-percent"
              >
                71% cost reduction
              </p>
            </div>

            <!-- WC / Health split -->
            <div class="grid grid-cols-2 gap-3 sm:gap-4">
              <div class="bg-white/10 rounded-lg p-3 sm:p-4 text-center">
                <p
                  class="text-xl sm:text-2xl font-bold text-blue-400 break-words"
                  id="wc-savings"
                >
                  $204,000
                </p>
                <p class="text-xs text-gray-400">WC Savings</p>
              </div>
              <div class="bg-white/10 rounded-lg p-3 sm:p-4 text-center">
                <p
                  class="text-xl sm:text-2xl font-bold text-green-400 break-words"
                  id="health-savings"
                >
                  $646,000
                </p>
                <p class="text-xs text-gray-400">Health Plan Savings</p>
              </div>
            </div>

            <!-- Savings Waterfall Breakdown -->
            <div
              class="bg-white/5 rounded-xl p-4 sm:p-5 border border-white/10"
            >
              <p
                class="text-xs text-gray-400 uppercase tracking-wider mb-3 font-semibold"
              >
                What Drives These Savings
              </p>
              <div class="space-y-2.5 text-sm">
                <div class="flex justify-between items-center">
                  <span class="text-gray-300"
                    >Direct Imaging Price Reduction</span
                  >
                  <span class="font-semibold text-white" id="price-savings"
                    >$637,500</span
                  >
                </div>
                <div class="w-full bg-gray-700 rounded-full h-1.5">
                  <div
                    class="bg-green-400 h-1.5 rounded-full"
                    style="width:75%"
                  >
                  </div>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-300">Faster Return-to-Work (WC)</span>
                  <span class="font-semibold text-white" id="rtw-savings"
                    >$136,000</span
                  >
                </div>
                <div class="w-full bg-gray-700 rounded-full h-1.5">
                  <div class="bg-blue-400 h-1.5 rounded-full" style="width:16%">
                  </div>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-300">Improved Imaging Utilization</span
                  >
                  <span
                    class="font-semibold text-white"
                    id="utilization-savings">$76,500</span
                  >
                </div>
                <div class="w-full bg-gray-700 rounded-full h-1.5">
                  <div
                    class="bg-yellow-400 h-1.5 rounded-full"
                    style="width:9%"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- CTA Button -->
          <button
            id="roi-report-btn"
            onclick="openROIModal()"
            class="w-full mt-6 bg-white text-gray-900 px-4 sm:px-6 py-3 sm:py-4 rounded-xl font-bold hover:bg-gray-100 transition-all duration-200 text-base flex items-center justify-center gap-2 hover:scale-[1.01] hover:shadow-lg"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v3.586l-1.293-1.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V8z"
                clip-rule="evenodd"></path>
            </svg>
            Download Your Custom ROI Report
          </button>
        </div>
      </div>

      <div
        class="mt-6 sm:mt-8 p-4 sm:p-6 bg-yellow-500/20 rounded-xl border border-yellow-500/40"
      >
        <p class="text-xs sm:text-sm text-yellow-200">
          <span class="font-semibold">💡 Not included in calculation:</span> Reduced
          disability duration, lower indemnity costs, improved productivity, and
          increased employee satisfaction. Actual savings typically 20–40% higher.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ROI Report Modal -->
<div
  id="roi-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden"
  aria-modal="true"
  role="dialog"
>
  <!-- Backdrop -->
  <div
    id="roi-modal-backdrop"
    class="absolute inset-0 bg-black/70 backdrop-blur-sm"
    onclick="closeROIModal()"
  >
  </div>

  <!-- Modal Card -->
  <div
    class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 sm:p-8 z-10"
  >
    <!-- Close button -->
    <button
      onclick="closeROIModal()"
      class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors"
      aria-label="Close"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Success state (hidden by default) -->
    <div id="roi-modal-success" class="hidden text-center py-4">
      <div
        class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
      >
        <svg
          class="w-8 h-8 text-green-600"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-gray-900 mb-2">
        Your report downloaded!
      </h3>
      <p class="text-gray-600 text-sm mb-6">
        Check your downloads for your custom ROI analysis. We've also emailed
        you the Employer Implementation Guide.
      </p>
      <a
        href="/employer/schedule"
        class="inline-flex items-center gap-2 bg-[#003087] hover:bg-[#002070] text-white px-6 py-3 rounded-xl font-semibold text-sm transition-all"
      >
        Schedule a 30-Minute Briefing with Michael
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>

    <!-- Form state -->
    <div id="roi-modal-form">
      <!-- Savings summary inside modal -->
      <div
        class="bg-gradient-to-r from-green-600 to-emerald-600 rounded-xl p-4 mb-6 text-white text-center"
      >
        <p class="text-xs text-white/80 mb-0.5">
          Your Projected Year-One Savings
        </p>
        <p class="text-3xl font-bold tracking-tight" id="modal-savings-display">
          $850,000
        </p>
        <p class="text-sm text-white/80" id="modal-context-display">
          for a 5,000-employee workforce
        </p>
      </div>

      <h2 class="text-xl font-bold text-gray-900 mb-1">
        Download Your Custom ROI Report
      </h2>
      <p class="text-sm text-gray-500 mb-5">
        Your custom ROI report will download instantly. We'll also email you the
        Employer Implementation Guide.
      </p>

      <form id="roi-form" class="space-y-4" novalidate>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">
            Full Name <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="roi-name"
            required
            placeholder="Sarah Johnson"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#003087]/30 focus:border-[#003087] text-gray-900 text-base transition-all"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">
            Work Email <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="roi-email"
            required
            placeholder="sarah@company.com"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#003087]/30 focus:border-[#003087] text-gray-900 text-base transition-all"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">
            Company <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="roi-company"
            required
            placeholder="Acme Corp"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#003087]/30 focus:border-[#003087] text-gray-900 text-base transition-all"
          />
        </div>

        <div
          id="roi-form-error"
          class="hidden bg-red-50 border border-red-200 rounded-lg px-4 py-3 text-sm text-red-700"
        >
        </div>

        <button
          type="submit"
          id="roi-submit-btn"
          class="w-full bg-[#003087] hover:bg-[#002070] text-white px-6 py-4 rounded-xl font-bold text-base transition-all flex items-center justify-center gap-2"
        >
          <span id="roi-btn-text">Send Me the Report</span>
          <svg
            id="roi-btn-arrow"
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
          <svg
            id="roi-btn-spinner"
            class="hidden w-5 h-5 animate-spin"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
        </button>

        <p class="text-xs text-gray-400 text-center">
          No spam. No sales calls unless you ask.
        </p>
      </form>
    </div>
  </div>
</div>

<script>
  // ─── State ───────────────────────────────────────────────────────────────
  let currentSavings = 850000;
  let currentEmployees = 5000;
  let animationFrames: Record<string, number> = {};

  // ─── Comma formatting helpers ─────────────────────────────────────────────
  function parseInput(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement;
    if (!el) return 0;
    return parseInt(el.value.replace(/,/g, ""), 10) || 0;
  }

  function attachCommaFormatter(id: string) {
    const el = document.getElementById(id) as HTMLInputElement;
    if (!el) return;
    el.addEventListener("input", () => {
      const cursorPos = el.selectionStart ?? 0;
      const oldCommasBefore = (el.value.slice(0, cursorPos).match(/,/g) || [])
        .length;
      const raw = el.value.replace(/[^0-9]/g, "");
      if (raw === "") {
        el.value = "";
        updateCalculator();
        return;
      }
      const formatted = parseInt(raw, 10).toLocaleString();
      el.value = formatted;
      const newCommasBefore = (formatted.slice(0, cursorPos).match(/,/g) || [])
        .length;
      const newPos = Math.min(
        cursorPos + (newCommasBefore - oldCommasBefore),
        formatted.length,
      );
      el.setSelectionRange(newPos, newPos);
      updateCalculator();
    });
  }

  // ─── Animated number counter ─────────────────────────────────────────────
  function animateValue(
    elementId: string,
    start: number,
    end: number,
    prefix = "$",
    suffix = "",
    duration = 700,
  ) {
    // Cancel any running animation on this element
    if (animationFrames[elementId]) {
      cancelAnimationFrame(animationFrames[elementId]);
    }
    const el = document.getElementById(elementId);
    if (!el) return;
    const range = end - start;
    const startTime = performance.now();

    function update(currentTime: number) {
      const progress = Math.min((currentTime - startTime) / duration, 1);
      // Ease out cubic
      const eased = 1 - Math.pow(1 - progress, 3);
      const value = Math.round(start + range * eased);
      el.textContent = `${prefix}${value.toLocaleString()}${suffix}`;
      if (progress < 1) {
        animationFrames[elementId] = requestAnimationFrame(update);
      }
    }
    animationFrames[elementId] = requestAnimationFrame(update);
  }

  // ─── Main calculator ──────────────────────────────────────────────────────
  function updateCalculator() {
    const totalEmployees = parseInput("total-employees");
    const wcScans = parseInput("wc-scans");
    const healthScans = parseInput("health-scans");
    const avgCost = parseInput("avg-cost");

    const totalScans = wcScans + healthScans;
    const currentSpend = totalScans * avgCost;
    const usradCost = totalScans * 350;
    const savings = Math.max(0, currentSpend - usradCost);
    const savingsPercent =
      currentSpend > 0 ? Math.round((savings / currentSpend) * 100) : 0;

    // Waterfall breakdown
    const priceSavings = Math.round(savings * 0.75);
    const rtwSavings = Math.round(savings * 0.16);
    const utilizationSavings = savings - priceSavings - rtwSavings;

    // WC / health split
    const wcSavings = Math.max(0, wcScans * avgCost - wcScans * 350);
    const healthSavings = Math.max(
      0,
      healthScans * avgCost - healthScans * 350,
    );

    // ── Animate numbers ──
    animateValue("current-spend", 0, currentSpend, "$", "", 600);
    animateValue("usrad-cost", 0, usradCost, "$", "", 600);
    animateValue("annual-savings", 0, savings, "$", "", 900);
    animateValue("wc-savings", 0, wcSavings, "$", "", 600);
    animateValue("health-savings", 0, healthSavings, "$", "", 600);
    animateValue("price-savings", 0, priceSavings, "$", "", 700);
    animateValue("rtw-savings", 0, rtwSavings, "$", "", 700);
    animateValue("utilization-savings", 0, utilizationSavings, "$", "", 700);

    // ── Savings percent (no animation, text) ──
    const pctEl = document.getElementById("savings-percent");
    if (pctEl) pctEl.textContent = `${savingsPercent}% cost reduction`;

    // ── Personalized context ──
    const ctxEl = document.getElementById("roi-context");
    if (ctxEl && totalEmployees > 0) {
      ctxEl.textContent = `Estimated savings for a ${totalEmployees.toLocaleString()}-employee workforce`;
    }

    // ── Cost comparison bars ──
    const barCurrentCost = document.getElementById("bar-current-cost");
    if (barCurrentCost)
      barCurrentCost.textContent = `$${avgCost.toLocaleString()}`;

    const currentBar = document.getElementById("current-bar") as HTMLElement;
    const usradBarEl = document.getElementById("usrad-bar") as HTMLElement;
    if (currentBar && usradBarEl && avgCost > 0) {
      const usradPct = Math.max(4, Math.round((350 / avgCost) * 100));
      currentBar.style.width = "100%";
      usradBarEl.style.width = `${usradPct}%`;
    }

    // ── Store state for modal ──
    currentSavings = savings;
    currentEmployees = totalEmployees;

    // ── Update modal display if open ──
    const modalSavings = document.getElementById("modal-savings-display");
    const modalCtx = document.getElementById("modal-context-display");
    if (modalSavings) modalSavings.textContent = `$${savings.toLocaleString()}`;
    if (modalCtx && totalEmployees > 0) {
      modalCtx.textContent = `for a ${totalEmployees.toLocaleString()}-employee workforce`;
    }
  }

  // ─── Modal open/close ─────────────────────────────────────────────────────
  function openROIModal() {
    const modal = document.getElementById("roi-modal");
    if (!modal) return;

    // Sync modal savings display
    const modalSavings = document.getElementById("modal-savings-display");
    const modalCtx = document.getElementById("modal-context-display");
    if (modalSavings)
      modalSavings.textContent = `$${currentSavings.toLocaleString()}`;
    if (modalCtx && currentEmployees > 0) {
      modalCtx.textContent = `for a ${currentEmployees.toLocaleString()}-employee workforce`;
    }

    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeROIModal() {
    const modal = document.getElementById("roi-modal");
    if (!modal) return;
    modal.classList.add("hidden");
    document.body.style.overflow = "";
  }

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeROIModal();
  });

  // ─── Modal form submission ────────────────────────────────────────────────
  document.getElementById("roi-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const name = (
      document.getElementById("roi-name") as HTMLInputElement
    ).value.trim();
    const email = (
      document.getElementById("roi-email") as HTMLInputElement
    ).value.trim();
    const company = (
      document.getElementById("roi-company") as HTMLInputElement
    ).value.trim();
    const errorEl = document.getElementById("roi-form-error") as HTMLDivElement;
    const submitBtn = document.getElementById(
      "roi-submit-btn",
    ) as HTMLButtonElement;
    const btnText = document.getElementById("roi-btn-text") as HTMLSpanElement;
    const btnArrow = document.getElementById("roi-btn-arrow") as HTMLElement;
    const btnSpinner = document.getElementById(
      "roi-btn-spinner",
    ) as HTMLElement;

    errorEl.classList.add("hidden");

    if (!name || !email || !company) {
      errorEl.textContent = "Please fill in all fields.";
      errorEl.classList.remove("hidden");
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errorEl.textContent = "Please enter a valid work email address.";
      errorEl.classList.remove("hidden");
      return;
    }

    // Loading state
    submitBtn.disabled = true;
    btnText.textContent = "Sending…";
    btnArrow.classList.add("hidden");
    btnSpinner.classList.remove("hidden");

    try {
      // Fire guide download in background — PDF is the primary deliverable
      // and must not be blocked by guide download success/failure
      fetch("/api/employer-guide-download", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name,
          email,
          company,
          source: "roi-calculator",
          roiData: {
            employees: currentEmployees.toLocaleString(),
            projectedSavings: `$${currentSavings.toLocaleString()}`,
          },
        }),
      }).catch(() => {}); // non-blocking — failure is silent

      // Generate and download custom ROI PDF report
      const totalEmployees = parseInput("total-employees");
      const wcScans = parseInput("wc-scans");
      const healthScans = parseInput("health-scans");
      const avgCost = parseInput("avg-cost");

      const pdfRes = await fetch("/api/employer-roi-report", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          companyName: company,
          contactName: name,
          contactEmail: email,
          totalEmployees,
          wcScans,
          healthScans,
          avgCost,
        }),
      });

      if (pdfRes.ok) {
        const blob = await pdfRes.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `USRad-ROI-Report-${company.replace(/\s+/g, "-")}.pdf`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      // Show success
      document.getElementById("roi-modal-form")?.classList.add("hidden");
      document.getElementById("roi-modal-success")?.classList.remove("hidden");
    } catch (err: any) {
      errorEl.textContent =
        err.message || "Something went wrong. Please try again.";
      errorEl.classList.remove("hidden");
      submitBtn.disabled = false;
      btnText.textContent = "Send Me the Report";
      btnArrow.classList.remove("hidden");
      btnSpinner.classList.add("hidden");
    }
  });

  // ─── Event listeners (comma formatting handles input + calls updateCalculator) ──
  attachCommaFormatter("total-employees");
  attachCommaFormatter("wc-scans");
  attachCommaFormatter("health-scans");
  attachCommaFormatter("avg-cost");

  // Initial render
  updateCalculator();

  // Expose modal function globally for onclick attributes
  (window as any).openROIModal = openROIModal;
  (window as any).closeROIModal = closeROIModal;
</script>
