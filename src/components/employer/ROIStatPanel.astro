---
export interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<!-- Pre-Calculator Stat Panel -->
<section
  class={`bg-white py-12 sm:py-16 px-4 sm:px-6 border-t border-b border-gray-200 ${className}`}
>
  <div class="max-w-5xl mx-auto">
    <p
      class="text-center text-xs sm:text-sm font-semibold uppercase tracking-widest text-gray-400 mb-8"
      data-aos="fade-up"
    >
      Current Market Reality
    </p>
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-12 text-center"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      <div class="flex flex-col">
        <p
          class="text-xs sm:text-sm text-gray-500 uppercase tracking-wide mb-2"
        >
          Hospital outpatient MRI
        </p>
        <p class="flex-1 text-4xl sm:text-5xl font-bold text-gray-900">$1,800–$3,200</p>
        <p class="text-xs text-gray-400 mt-2">Hospital outpatient billing</p>
      </div>

      <div class="relative flex flex-col">
        <!-- Dividers on desktop -->
        <div
          class="hidden md:block absolute left-0 top-1/2 -translate-y-1/2 w-px h-12 bg-gray-200"
        >
        </div>
        <div
          class="hidden md:block absolute right-0 top-1/2 -translate-y-1/2 w-px h-12 bg-gray-200"
        >
        </div>
        <p
          class="text-xs sm:text-sm text-gray-500 uppercase tracking-wide mb-2"
        >
          USRad Network MRI
        </p>
        <p class="flex-1 text-4xl sm:text-5xl font-bold text-[#003087]">$260–$475</p>
        <p class="text-xs text-gray-400 mt-2">Independent accredited centers</p>
      </div>

      <div class="flex flex-col">
        <p
          class="text-xs sm:text-sm text-gray-500 uppercase tracking-wide mb-2"
        >
          Typical Employer Savings
        </p>
        <p class="flex-1 text-4xl sm:text-5xl font-bold text-[#cc9933]">75–90%</p>
        <p class="text-xs text-gray-400 mt-2">For a plain MRI</p>
      </div>
    </div>

    <p
      class="text-center text-xs text-gray-400 mt-8"
      data-aos="fade-up"
      data-aos-delay="200"
    >
      Now calculate your organization's specific savings below
      <svg
        class="inline w-4 h-4 ml-1 text-gray-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"></path>
      </svg>
    </p>
  </div>
</section>
