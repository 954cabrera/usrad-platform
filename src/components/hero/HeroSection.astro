---
/**
 * HeroSection.astro - Main search interface
 *
 * DEPENDENCIES:
 * - procedure-data.js (creates window.ProcedureLibrary)
 * - search-manager.ts (bundled by Astro, creates window.searchManager)
 */

import HeroBackground from "./HeroBackground.astro";
import HeroHeadline from "./HeroHeadline.astro";
import SearchStep1 from "./SearchStep1.astro";
import SearchStep2 from "./SearchStep2.astro";
import SearchDropdown from "./search/SearchDropdown.astro";
import MobileSearchModal from "./MobileSearchModal.astro";

interface Props {
  remixUrl: string;
}

const { remixUrl } = Astro.props;
---

<!-- ======================================================
  PROCEDURE DATA LOADER
  ====================================================== --><!-- Load procedure-data.js from /public (plain ES module) -->
<script type="module">
  await import("/js/procedure-data.js");
  // Procedure data loaded silently - creates window.ProcedureLibrary
</script>

<!-- ======================================================
  HERO SECTION MARKUP
  ====================================================== -->
<section
  id="hero-section"
  class="relative pt-40 pb-24 px-4 sm:px-6 bg-[#003087] text-white overflow-visible"
  style="margin-top: -32px;"
  data-aos="fade-up"
>
  <HeroBackground />

  <div class="max-w-7xl mx-auto relative z-20">
    <div class="max-w-5xl mx-auto text-center">
      <HeroHeadline />

      <div id="hero-search-container" class="relative">
        <SearchStep1 />
        <SearchStep2 remixUrl={remixUrl} />
      </div>
    </div>
  </div>
</section>

<!-- Mobile Search Modal - Moved outside section for proper z-index stacking -->
<MobileSearchModal />
<!-- ✅ OUTSIDE section -->

<!-- DROPDOWN PORTAL - Positioned outside hero section for proper z-index stacking -->
<!-- This prevents the SocialProofBar from covering the dropdown -->
<SearchDropdown />

<div
  id="search-backdrop"
  class="hidden fixed inset-0 pointer-events-none"
  style="z-index: 99999998;"
  aria-hidden="true"
>
</div>

<script>
  // Import and initialize search manager
  import { searchManager } from "../../lib/search-manager";
  import type { SearchManager } from "../../lib/search-manager";

  // Expose to window
  window.searchManager = searchManager;
  window.isMobileViewport = () => window.innerWidth < 768;

  /**
   * ════════════════════════════════════════════════════════════════
   *   CRITICAL FIX: Proper procedure data flattening
   * ════════════════════════════════════════════════════════════════
   *
   * The procedure-data.js structure is:
   *
   * MRI_PROCEDURES = {
   *   brain: {
   *     category: "Brain",
   *     procedures: [{ cpt: "70551", label: "...", ... }]
   *   },
   *   knee: {
   *     category: "Knee",
   *     procedures: [{ cpt: "73721", label: "...", ... }]
   *   }
   * }
   *
   * We need to extract ALL procedures arrays and flatten them.
   */

  function flattenProcedureData(modalityData: Record<string, any>): any[] {
    if (!modalityData || typeof modalityData !== "object") {
      return [];
    }

    const procedures: any[] = [];

    // Iterate through each region/body part
    for (const key in modalityData) {
      const entry = modalityData[key];

      // Check if this entry has a procedures array
      if (entry && Array.isArray(entry.procedures)) {
        // Add all procedures from this region
        procedures.push(...entry.procedures);
      }
    }

    return procedures;
  }

  // Wait for ProcedureLibrary and initialize
  function initSearchEngine() {
    if (typeof window.ProcedureLibrary === "undefined") {
      setTimeout(initSearchEngine, 70);
      return;
    }

    const lib = window.ProcedureLibrary;
    if (!lib) {
      console.error("❌ ProcedureLibrary missing");
      return;
    }

    try {
      // Flatten each modality's procedures
      const mriProcs = flattenProcedureData(lib.MRI);
      const ctProcs = flattenProcedureData(lib.CT);
      const xrayProcs = flattenProcedureData(lib["X-Ray"]);
      const usProcs = flattenProcedureData(lib.Ultrasound);

      // Normalize popular procedures
      let popularProcs = Array.isArray(lib.Popular) ? lib.Popular : [];

      // Initialize SearchManager with flattened data
      searchManager.initialize(
        mriProcs,
        ctProcs,
        xrayProcs,
        usProcs,
        popularProcs
      );

      console.log("✅ [HeroSection] SearchManager initialized successfully");
    } catch (err) {
      console.error("❌ [HeroSection] Initialization error:", err);
    }
  }

  // Start initialization
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSearchEngine);
  } else {
    initSearchEngine();
  }
</script>

<style>
  #hero-section {
    position: relative;
  }

  #hero-search-container {
    position: relative;
    z-index: 999999;
  }

  #search-backdrop {
    background: rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(2px);
    transition: opacity 0.3s ease;
  }

  #search-backdrop.hidden {
    opacity: 0;
    pointer-events: none;
  }

  #search-backdrop:not(.hidden) {
    opacity: 1;
    pointer-events: auto;
  }
</style>
