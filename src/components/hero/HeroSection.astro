---
import {
  USE_NEW_PROCEDURE_ENGINE,
  ENABLE_DEBUG_NEW_ENGINE,
} from "../../lib/feature-flags";
import HeroBackground from "./HeroBackground.astro";
import HeroHeadline from "./HeroHeadline.astro";
import SearchStep1 from "./SearchStep1.astro";
import SearchStep2 from "./SearchStep2.astro";
import SearchDropdown from "./search/SearchDropdown.astro";
import MobileSearchModal from "./MobileSearchModal.astro";

interface Props {
  remixUrl: string;
}

const { remixUrl } = Astro.props;
---

<script type="module">
  await import("/js/procedure-data.js");
  // Procedure data loaded - always silent in production
</script>

<section
  id="hero-section"
  class="relative pt-40 pb-24 px-4 sm:px-6 bg-[#003087] text-white overflow-visible"
  style="margin-top: -32px;"
  data-aos="fade-up"
>
  <HeroBackground />

  <div class="max-w-7xl mx-auto relative z-20">
    <div class="max-w-5xl mx-auto text-center">
      <HeroHeadline />

      <div id="hero-search-container" class="relative">
        <SearchStep1 />
        <SearchStep2 remixUrl={remixUrl} />
      </div>
    </div>
  </div>
</section>

<!-- Mobile Search Modal - Moved outside section for proper z-index stacking -->
<MobileSearchModal />
<!-- ✅ OUTSIDE section -->

<!-- DROPDOWN PORTAL - Positioned outside hero section for proper z-index stacking -->
<!-- This prevents the SocialProofBar from covering the dropdown -->
<SearchDropdown />

<div
  id="search-backdrop"
  class="hidden fixed inset-0 pointer-events-none"
  style="z-index: 99999998;"
  aria-hidden="true"
>
</div>

<script>
  // Debug flag - set to false for production
  const DEBUG = false; // Legacy debug flag

  import {
    USE_NEW_PROCEDURE_ENGINE,
    ENABLE_DEBUG_NEW_ENGINE,
  } from "../../lib/feature-flags";

  import { searchManager } from "../../lib/search-manager";
  import {
    loadCanonicalIndex,
    getIndexStats,
  } from "../../lib/procedure-resolver";

  // ✅ CRITICAL: Expose searchManager to window for other components
  window.searchManager = searchManager;
  window.isMobileViewport = () => window.innerWidth < 768;

  function initializeSearchManager() {
    if (typeof (window as any).ProcedureLibrary === "undefined") {
      setTimeout(initializeSearchManager, 100);
      return;
    }

    const lib = (window as any).ProcedureLibrary;

    if (!lib) {
      console.error("❌ ProcedureLibrary not found!");
      return;
    }

    try {
      let popularProcs = lib.Popular || [];

      if (!Array.isArray(popularProcs)) {
        const allProcs: any[] = [];
        for (const region in popularProcs) {
          if (popularProcs[region]?.procedures) {
            allProcs.push(...popularProcs[region].procedures);
          }
        }
        popularProcs = allProcs;
      }

      // ✅ CRITICAL: Pass raw nested objects, NOT flattened arrays
      // SearchManager.flattenProcedures() expects this structure:
      // { brain: { procedures: [...] }, knee: { procedures: [...] } }
      searchManager.initialize(
        lib.MRI || {},
        lib.CT || {},
        lib["X-Ray"] || {},
        lib.Ultrasound || {},
        popularProcs
      );

      // Phase 1: Initialize new engine if enabled
      if (USE_NEW_PROCEDURE_ENGINE) {
        initializeNewEngine();
      }

      if (DEBUG) console.log("[HeroSection] SearchManager initialized");
    } catch (error) {
      console.error("❌ Error initializing SearchManager:", error);
    }
  }

  function initHeroSection() {
    if (DEBUG) console.log("[HeroSection] Initializing...");
    initializeSearchManager();

    document.addEventListener("mobile-procedure-selected", (e: any) => {
      if (DEBUG)
        console.log("[HeroSection] Mobile modal: Procedure selected", e.detail);
    });

    if (DEBUG) console.log("[HeroSection] Initialization complete");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroSection);
  } else {
    initHeroSection();
  }

  document.addEventListener("astro:page-load", initHeroSection);

  /**
   * Phase 1: New Engine Initialization
   * Loads the canonical index and verifies readiness
   */
  function initializeNewEngine() {
    const lib = (window as any).ProcedureLibrary;

    if (!lib) {
      console.warn("⚠️ New Engine enabled but ProcedureLibrary not available");
      return;
    }

    // Load canonical index
    const loaded = loadCanonicalIndex();

    if (!loaded) {
      console.error("❌ Failed to load canonical index");
      return;
    }

    if (ENABLE_DEBUG_NEW_ENGINE) {
      const stats = getIndexStats();
      console.log("✅ Phase 1: New Engine Active", {
        isLoaded: stats.isLoaded,
        totalProcedures: stats.totalProcedures,
        modalities: stats.modalities,
        cptCount: stats.cptCount,
      });
    }
  }
</script>

<style>
  #hero-section {
    position: relative;
  }

  #hero-search-container {
    position: relative;
    z-index: 999999;
  }

  #search-backdrop {
    background: rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(2px);
    transition: opacity 0.3s ease;
  }

  #search-backdrop.hidden {
    opacity: 0;
    pointer-events: none;
  }

  #search-backdrop:not(.hidden) {
    opacity: 1;
    pointer-events: auto;
  }
</style>
