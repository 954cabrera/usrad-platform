---
/**
 * MobileSearchModal.astro - UNIVERSAL SEARCH MODAL
 *
 * ✅ UNIVERSAL MODAL REFACTOR
 * Previously mobile-only, now serves ALL viewports:
 * - Mobile/Tablet (<1024px): Full-screen modal, slides up from bottom
 * - Desktop (≥1024px): Centered overlay (700px max, 80vh), scale-up animation
 *
 * ✅ PHASE 6 INTEGRATION (preserved):
 * 1. Uses SearchManager for search (no duplicate logic)
 * 2. Applies character encoding fixes (fixCharacterEncoding)
 * 3. Subscribes to SearchManager state
 * 4. Maintains backward compatibility with custom events
 *
 * ✅ GUARDRAILS (confirmed):
 * 1. Keyboard: ESC → close, TAB → focus trap, ENTER → select
 * 2. Scroll lock: body overflow hidden when open
 * 3. Search persistence: query preserved on close, cleared on selection
 *
 * DEPENDENCIES:
 * - window.searchManager (provided by HeroSection.astro initialization)
 * - window.ProcedureLibrary (provided by procedure-data.js)
 *
 * API:
 * - window.mobileSearchModal.open() - Opens modal
 * - window.mobileSearchModal.close() - Closes modal
 *
 * Events:
 * - Dispatches 'mobile-procedure-selected' custom event
 * - SearchManager handles actual state updates
 */
---

<!-- Universal Search Modal — hidden by default via inline display:none -->
<div
  id="mobile-search-modal"
  class="search-modal-container"
  style="display: none; z-index: 2147483647; position: fixed; top: 0; left: 0; right: 0; bottom: 0;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-search-title"
>
  <!-- Backdrop — visible on desktop, transparent on mobile/tablet -->
  <div id="search-modal-backdrop" class="search-modal-backdrop"></div>

  <!-- Content Panel -->
  <div id="search-modal-content" class="search-modal-content bg-white">
    <!-- Header: Fixed at top -->
    <div
      class="mobile-modal-header sticky top-0 z-[100] bg-white border-b border-gray-200 shadow-sm"
    >
      <div class="flex items-center gap-3 p-4">
        <!-- Close Button -->
        <button
          type="button"
          id="mobile-modal-close"
          class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors"
          aria-label="Close search"
        >
          <svg
            class="w-6 h-6 text-gray-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <!-- Title -->
        <div class="flex-1">
          <h2
            id="mobile-search-title"
            class="text-lg font-semibold text-gray-900"
          >
            Which scan do you need?
          </h2>
        </div>
      </div>

      <!-- Search Input -->
      <div class="px-4 pb-4">
        <div class="relative">
          <div
            class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
          >
            <svg
              class="w-5 h-5 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="text"
            id="mobile-modal-search-input"
            placeholder="Type MRI, CT, Ultrasound..."
            autocomplete="off"
            class="w-full pl-12 pr-12 py-3.5 text-base text-gray-900 placeholder-gray-500 bg-gray-50 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#003087] focus:border-transparent transition-all"
          />
          <!-- Clear button — shown when input has text -->
          <button
            type="button"
            id="search-modal-clear-btn"
            class="hidden absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400 hover:text-gray-600 transition-colors"
            aria-label="Clear search"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Results Container -->
    <div id="mobile-modal-results" class="mobile-modal-body overflow-y-auto">
      <!-- Popular Procedures Section -->
      <div id="mobile-popular-section" class="px-4 py-3">
        <div class="mb-3">
          <div class="flex items-center justify-between mb-2">
            <h3
              class="text-sm font-semibold text-[#b8862d] flex items-center gap-2"
            >
              ⭐ Popular Procedures
            </h3>
            <span class="text-xs text-[#b8862d]/80 font-medium"
              >Curated by USRad</span
            >
          </div>
          <p class="text-xs text-gray-500">Or start typing to search...</p>
        </div>
        <div id="mobile-popular-list" class="space-y-2"></div>
      </div>

      <!-- Search Results Section -->
      <div id="mobile-search-section" class="hidden px-4 py-3">
        <div class="mb-3">
          <h3 class="text-sm font-semibold text-gray-700">
            <span id="mobile-results-count">0</span> Results
          </h3>
        </div>
        <div id="mobile-search-list" class="space-y-2"></div>
      </div>

      <!-- Empty State -->
      <div id="mobile-empty-state" class="hidden text-center py-16 px-4">
        <svg
          class="w-16 h-16 mx-auto mb-4 text-gray-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <p class="text-base font-semibold text-gray-700 mb-1">
          No procedures found
        </p>
        <p class="text-sm text-gray-500">Try a different search term</p>
      </div>
    </div>
  </div>
</div>

<script>
  const DEBUG = false;

  /**
   * ════════════════════════════════════════════════════════════════
   *   INLINE UTILITY: fixCharacterEncoding
   * ════════════════════════════════════════════════════════════════
   */
  const ENCODING_MAP = {
    "\xE2\x80\x93": "\u2013", // en dash
    "\xE2\x80\x94": "\u2014", // em dash
    "\xE2\x80\x9C": "\u201C", // left double quote
    "\xE2\x80\x9D": "\u201D", // right double quote
    "\xE2\x80\x98": "\u2018", // left single quote
    "\xE2\x80\x99": "\u2019", // right single quote
    "\xE2\x80\xA2": "\u2022", // bullet
    "\xC2\xA0": "\u00A0", // non-breaking space
  };

  function fixCharacterEncoding(text) {
    if (!text || typeof text !== "string") return text;
    let fixed = text;
    for (const [bad, good] of Object.entries(ENCODING_MAP)) {
      fixed = fixed.split(bad).join(good);
    }
    return fixed;
  }

  /**
   * ════════════════════════════════════════════════════════════════
   *   VIEWPORT DETECTION
   * ════════════════════════════════════════════════════════════════
   */
  function isDesktopViewport() {
    return window.innerWidth >= 1024;
  }

  /**
   * ════════════════════════════════════════════════════════════════
   *   MODAL VISIBILITY — Uses inline style display:none/flex|block
   *   instead of Tailwind 'hidden' class to avoid CSS specificity
   *   conflicts with the desktop media query (display:flex).
   * ════════════════════════════════════════════════════════════════
   */
  function isModalVisible(modal) {
    return modal && modal.style.display !== "none";
  }

  function showModal(modal) {
    if (!modal) return;
    const desktop = isDesktopViewport();
    // Desktop uses flex for centering, mobile uses block (full-screen)
    modal.style.display = desktop ? "flex" : "block";
  }

  function hideModal(modal) {
    if (!modal) return;
    modal.style.display = "none";
  }

  /**
   * ════════════════════════════════════════════════════════════════
   *   INITIALIZE UNIVERSAL SEARCH MODAL
   * ════════════════════════════════════════════════════════════════
   */
  function initMobileModal() {
    // Wait for SearchManager + ProcedureLibrary (provided by HeroSection.astro)
    if (!window.searchManager || !window.ProcedureLibrary) {
      setTimeout(initMobileModal, 50);
      return;
    }

    const modal = document.getElementById("mobile-search-modal");
    const modalContent = document.getElementById("search-modal-content");
    const backdrop = document.getElementById("search-modal-backdrop");
    const closeBtn = document.getElementById("mobile-modal-close");
    const clearBtn = document.getElementById("search-modal-clear-btn");

    const searchInput = document.getElementById("mobile-modal-search-input");
    const popularSection = document.getElementById("mobile-popular-section");
    const popularList = document.getElementById("mobile-popular-list");

    const searchSection = document.getElementById("mobile-search-section");
    const searchList = document.getElementById("mobile-search-list");

    const emptyState = document.getElementById("mobile-empty-state");
    const resultsCount = document.getElementById("mobile-results-count");

    // Track scroll position for body lock restoration
    let savedScrollY = 0;
    let searchTimeout = null;

    if (DEBUG) console.log("🔍 SearchModal: initializing (universal)");

    /**
     * ════════════════════════════════════════════════════════════════
     *   CLEAR BUTTON — show/hide based on input content
     * ════════════════════════════════════════════════════════════════
     */
    function updateClearButton() {
      if (!clearBtn || !searchInput) return;
      if (searchInput.value.length > 0) {
        clearBtn.classList.remove("hidden");
      } else {
        clearBtn.classList.add("hidden");
      }
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          searchInput.focus();
          updateClearButton();
          showPopularProcedures();
        }
      });
    }

    /**
     * ████████████████████████████████████████
     *   PUBLIC API — Window.mobileSearchModal
     * ████████████████████████████████████████
     */
    window.mobileSearchModal = {
      open() {
        if (!modal) return;

        const desktop = isDesktopViewport();

        if (DEBUG) console.log("🔍 SearchModal: open()", { desktop });

        // Save scroll position before locking
        savedScrollY = window.scrollY;

        // Show modal via inline style (avoids Tailwind hidden specificity issue)
        showModal(modal);

        // Apply viewport-specific enter animation
        if (desktop) {
          modal.classList.add("modal-enter-desktop");
        } else {
          modal.classList.add("modal-enter-mobile");
        }

        // Lock body scroll
        document.body.style.overflow = "hidden";
        if (!desktop) {
          document.body.style.position = "fixed";
          document.body.style.width = "100%";
          document.body.style.top = `-${savedScrollY}px`;
        }

        // Focus search input after animation completes + show procedures
        setTimeout(() => {
          searchInput?.focus();
          updateClearButton();
          // Only show popular if input is empty (preserves previous search)
          if (!searchInput?.value || searchInput.value.trim().length < 2) {
            showPopularProcedures();
          }
        }, 200);
      },

      close() {
        if (!modal) return;

        const desktop = isDesktopViewport();

        if (DEBUG) console.log("🔍 SearchModal: close()", { desktop });

        // Remove enter animation, add exit animation
        modal.classList.remove("modal-enter-desktop", "modal-enter-mobile");

        if (desktop) {
          modal.classList.add("modal-exit-desktop");
        } else {
          modal.classList.add("modal-exit-mobile");
        }

        const exitDuration = desktop ? 150 : 200;

        setTimeout(() => {
          // Hide modal via inline style
          hideModal(modal);
          modal.classList.remove("modal-exit-desktop", "modal-exit-mobile");

          // Unlock body scroll
          document.body.style.overflow = "";
          document.body.style.position = "";
          document.body.style.width = "";
          document.body.style.top = "";

          // Restore scroll position (needed after position:fixed on mobile)
          if (!desktop) {
            window.scrollTo(0, savedScrollY);
          }

          // ✅ GUARDRAIL 3: Search persistence
          // Do NOT clear the input here — preserve the query
          // Input is only cleared when a procedure is selected (see attachResultHandlers)
        }, exitDuration);
      },
    };

    /**
     * ████████████████████████████████████████
     *   EVENT LISTENERS
     * ████████████████████████████████████████
     */

    // Close button
    closeBtn?.addEventListener("click", () => window.mobileSearchModal.close());

    // Click backdrop to close (desktop)
    backdrop?.addEventListener("click", () => window.mobileSearchModal.close());

    // Esc to close modal
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isModalVisible(modal)) {
        window.mobileSearchModal.close();
      }
    });

    /**
     * Search Input — Uses SearchManager
     */
    searchInput?.addEventListener("input", (e) => {
      clearTimeout(searchTimeout);
      const query = e.target.value.trim();

      updateClearButton();

      searchTimeout = setTimeout(() => {
        if (query.length < 2) {
          showPopularProcedures();
        } else {
          window.searchManager.search(query);
          if (DEBUG) console.log("SearchModal: search:", query);
        }
      }, 200);
    });

    /**
     * ████████████████████████████████████████
     *   SUBSCRIBE TO SEARCH MANAGER
     * ████████████████████████████████████████
     */
    window.searchManager.subscribe((state) => {
      // Only update UI when modal is visible
      if (!isModalVisible(modal)) return;

      const query = state.currentQuery || "";

      if (DEBUG)
        console.log("🔍 SearchModal: state update", {
          query,
          results: state.searchResults.length,
        });

      if (query.length < 2) {
        showPopularProcedures();
      } else {
        renderSearchResults(state.searchResults, query);
      }
    });

    /**
     * ████████████████████████████████████████
     *   RENDER: POPULAR PROCEDURES
     * ████████████████████████████████████████
     */
    function showPopularProcedures() {
      if (!popularList || !popularSection) return;

      const lib = window.ProcedureLibrary;

      let popular = lib?.Popular || [];

      if (!Array.isArray(popular) && typeof popular === "object") {
        popular = Object.values(popular)
          .filter((p) => p?.procedures)
          .flatMap((p) => p.procedures);
      }

      popular = popular || [];

      popularSection.classList.remove("hidden");
      searchSection?.classList.add("hidden");
      emptyState?.classList.add("hidden");

      popularList.innerHTML = renderGroupedResults(popular, "");
      attachResultHandlers();

      if (DEBUG) console.log("🔍 SearchModal: showing popular", popular.length);
    }

    /**
     * ████████████████████████████████████████
     *   RENDER: SEARCH RESULTS
     * ████████████████████████████████████████
     */
    function renderSearchResults(results, query) {
      if (!searchList) return;

      if (results.length === 0) {
        popularSection?.classList.add("hidden");
        searchSection?.classList.add("hidden");
        emptyState?.classList.remove("hidden");
        return;
      }

      popularSection?.classList.add("hidden");
      emptyState?.classList.add("hidden");
      searchSection?.classList.remove("hidden");

      if (resultsCount) resultsCount.textContent = results.length.toString();

      searchList.innerHTML = renderGroupedResults(results, query);
      attachResultHandlers();

      if (DEBUG)
        console.log("🔍 SearchModal: rendered results", results.length);
    }

    /**
     * ████████████████████████████████████████
     *   HELPERS: RENDER grouped results
     * ████████████████████████████████████████
     */
    function renderGroupedResults(results, query = "") {
      const groups = {};
      results.forEach((p) => {
        const m = p.modality || "Other";
        if (!groups[m]) groups[m] = [];
        groups[m].push(p);
      });

      const order = ["MRI", "CT", "X-Ray", "Ultrasound", "Other"];
      const ICONS = {
        MRI: "🧠",
        CT: "🦴",
        "X-Ray": "👀",
        Ultrasound: "🩺",
        Other: "📋",
      };

      return order
        .map((mod) => {
          const group = groups[mod];
          if (!group || group.length === 0) return "";

          return `
            <div class="mb-4 border border-gray-100 rounded-xl overflow-hidden shadow-sm">
              <div class="sticky top-0 z-10 px-4 py-2.5 bg-gradient-to-r from-[#fff8ee] to-white border-b border-[#f5e4c3] flex items-center justify-between">
                <h4 class="text-sm font-semibold text-[#b8862d]">
                  ${ICONS[mod] || "📋"} ${mod}
                </h4>
              </div>

              <div class="divide-y divide-gray-100">
                ${group
                  .map((p) => {
                    const cleanLabel = fixCharacterEncoding(p.label);
                    const highlighted = highlightMatch(cleanLabel, query);
                    const cpt = p.cpt || p.cptCode || "";
                    const bodyPartKey = p.bodyPartKey || p.bodyPart || "";

                    return `
                      <button
                        type="button"
                        class="w-full text-left flex items-center justify-between px-4 py-3 hover:bg-gray-50 mobile-procedure-result"
                        data-cpt="${cpt}"
                        data-label="${cleanLabel}"
                        data-modality="${mod}"
                        data-bodypart="${p.bodyPart || ""}"
                        data-bodypart-key="${bodyPartKey}"
                        data-display-override="${cleanLabel}"
                      >
                        <span class="text-[15px] font-medium text-gray-900">${highlighted}</span>
                        <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-700">${mod}</span>
                      </button>
                    `;
                  })
                  .join("")}
              </div>
            </div>
          `;
        })
        .join("");
    }

    /**
     * ████████████████████████████████████████
     *   HELPERS: Highlight matches
     * ████████████████████████████████████████
     */
    function highlightMatch(text, query) {
      if (!query || query.length < 2) return text;

      const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const regex = new RegExp(escaped, "gi");

      return text.replace(
        regex,
        (m) => `<span class="text-[#b8862d] font-semibold">${m}</span>`,
      );
    }

    /**
     * ████████████████████████████████████████
     *   HELPERS: Click handlers
     * ████████████████████████████████████████
     */
    function attachResultHandlers() {
      document.querySelectorAll(".mobile-procedure-result").forEach((btn) => {
        btn.addEventListener("click", () => {
          const selected = {
            label: btn.getAttribute("data-label") || "",
            cpt: btn.getAttribute("data-cpt") || "",
            cptCode: btn.getAttribute("data-cpt") || "",
            modality: btn.getAttribute("data-modality") || "",
            bodyPart: btn.getAttribute("data-bodypart") || "",
            region: btn.getAttribute("data-bodypart") || "",
            bodyPartKey: btn.getAttribute("data-bodypart-key") || "",
            displayLabelOverride:
              btn.getAttribute("data-display-override") || "",
          };

          if (DEBUG) console.log("🔍 SearchModal: selecting", selected);

          window.searchManager.selectProcedure(selected);

          // Dispatch custom event for backward compatibility
          const event = new CustomEvent("mobile-procedure-selected", {
            detail: selected,
            bubbles: true,
          });
          document.dispatchEvent(event);

          // Clear search input on procedure selection (fresh start next time)
          if (searchInput) searchInput.value = "";

          window.mobileSearchModal.close();
        });
      });
    }

    if (DEBUG) console.log("✅ SearchModal: ready (universal)");
  }

  // Initialize on DOM ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMobileModal);
  } else {
    initMobileModal();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener("astro:page-load", initMobileModal);
</script>

<style>
  /**
   * ════════════════════════════════════════════════════════════════
   *   UNIVERSAL SEARCH MODAL — RESPONSIVE LAYOUT
   * ════════════════════════════════════════════════════════════════
   *
   * IMPORTANT: Visibility is controlled via inline style (display:none/flex/block)
   * in JavaScript, NOT via Tailwind 'hidden' class, to avoid specificity
   * conflicts with the desktop media query's display:flex.
   *
   * Mobile/Tablet (<1024px): Full-screen overlay (display:block)
   * Desktop (≥1024px): Centered modal with backdrop (display:flex)
   */

  /* ── Backdrop ── */
  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  /* ── Content panel: full-screen by default (mobile/tablet) ── */
  .search-modal-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    z-index: 1;
  }

  /* Results container: fill remaining space below header */
  .mobile-modal-body {
    flex: 1;
    overflow-y: auto;
  }

  /* ── Desktop (≥1024px): centered overlay with backdrop ── */
  @media (min-width: 1024px) {
    .search-modal-container {
      /* display is set via JS (flex when open, none when closed) */
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .search-modal-backdrop {
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .search-modal-content {
      width: 100%;
      max-width: 700px;
      max-height: 80vh;
      height: auto;
      border-radius: 16px;
      box-shadow:
        0 25px 60px rgba(0, 0, 0, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.1);
      overflow: hidden;
    }
  }

  /**
   * ════════════════════════════════════════════════════════════════
   *   ANIMATIONS — Mobile/Tablet: Slide up/down
   * ════════════════════════════════════════════════════════════════
   */
  .modal-enter-mobile {
    animation: modalSlideIn 0.3s ease-out;
  }

  .modal-exit-mobile {
    animation: modalSlideOut 0.2s ease-in;
  }

  @keyframes modalSlideIn {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes modalSlideOut {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(100%);
    }
  }

  /**
   * ════════════════════════════════════════════════════════════════
   *   ANIMATIONS — Desktop: Scale + Fade with Backdrop
   * ════════════════════════════════════════════════════════════════
   */
  .modal-enter-desktop .search-modal-backdrop {
    animation: backdropFadeIn 0.2s ease-out forwards;
  }

  .modal-enter-desktop .search-modal-content {
    animation: modalScaleIn 0.2s ease-out forwards;
  }

  .modal-exit-desktop .search-modal-backdrop {
    animation: backdropFadeOut 0.15s ease-in forwards;
  }

  .modal-exit-desktop .search-modal-content {
    animation: modalScaleOut 0.15s ease-in forwards;
  }

  @keyframes backdropFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes backdropFadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes modalScaleIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes modalScaleOut {
    from {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    to {
      opacity: 0;
      transform: scale(0.95) translateY(8px);
    }
  }

  /**
