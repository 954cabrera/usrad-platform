---
/**
 * MobileSearchModal.astro - UPDATED WITH SEARCHMANAGER INTEGRATION
 *
 * ✅ PHASE 6 INTEGRATION CHANGES:
 * 1. Uses SearchManager for search (no duplicate logic)
 * 2. Applies character encoding fixes (fixCharacterEncoding)
 * 3. Subscribes to SearchManager state
 * 4. Maintains backward compatibility with custom events
 *
 * API:
 * - window.mobileSearchModal.open() - Opens modal
 * - window.mobileSearchModal.close() - Closes modal
 *
 * Events:
 * - Dispatches 'mobile-procedure-selected' custom event
 * - SearchManager handles actual state updates
 */
---

<!-- Mobile Search Modal - Full Screen Overlay -->
<div
  id="mobile-search-modal"
  class="mobile-search-modal hidden fixed inset-0 bg-white"
  style="z-index: 2147483647 !important; position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; background-color: white !important; width: 100vw !important; height: 100vh !important;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-search-title"
>
  <!-- Header: Fixed at top -->
  <div
    class="mobile-modal-header sticky top-0 z-[100] bg-white border-b border-gray-200 shadow-sm"
  >
    <div class="flex items-center gap-3 p-4">
      <!-- Close Button -->
      <button
        type="button"
        id="mobile-modal-close"
        class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors"
        aria-label="Close search"
      >
        <svg
          class="w-6 h-6 text-gray-600"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Title -->
      <div class="flex-1">
        <h2
          id="mobile-search-title"
          class="text-lg font-semibold text-gray-900"
        >
          Which scan do you need?
        </h2>
      </div>
    </div>

    <!-- Search Input -->
    <div class="px-4 pb-4">
      <div class="relative">
        <div
          class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
        >
          <svg
            class="w-5 h-5 text-gray-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          type="text"
          id="mobile-modal-search-input"
          placeholder="Type MRI, CT, Ultrasound..."
          autocomplete="off"
          class="w-full pl-12 pr-4 py-3.5 text-base text-gray-900 placeholder-gray-500 bg-gray-50 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#003087] focus:border-transparent transition-all"
        />
      </div>
    </div>
  </div>

  <!-- Results Container -->
  <div
    id="mobile-modal-results"
    class="mobile-modal-body overflow-y-auto"
    style="height: calc(100vh - 160px);"
  >
    <!-- Popular Procedures Section -->
    <div id="mobile-popular-section" class="px-4 py-3">
      <div class="mb-3">
        <div class="flex items-center justify-between mb-2">
          <h3
            class="text-sm font-semibold text-[#b8862d] flex items-center gap-2"
          >
            ⭐ Popular Procedures
          </h3>
          <span class="text-xs text-[#b8862d]/80 font-medium"
            >Curated by USRad</span
          >
        </div>
        <p class="text-xs text-gray-500">Or start typing to search...</p>
      </div>
      <div id="mobile-popular-list" class="space-y-2"></div>
    </div>

    <!-- Search Results Section -->
    <div id="mobile-search-section" class="hidden px-4 py-3">
      <div class="mb-3">
        <h3 class="text-sm font-semibold text-gray-700">
          <span id="mobile-results-count">0</span> Results
        </h3>
      </div>
      <div id="mobile-search-list" class="space-y-2"></div>
    </div>

    <!-- Empty State -->
    <div id="mobile-empty-state" class="hidden text-center py-16 px-4">
      <svg
        class="w-16 h-16 mx-auto mb-4 text-gray-300"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <p class="text-base font-semibold text-gray-700 mb-1">
        No procedures found
      </p>
      <p class="text-sm text-gray-500">Try a different search term</p>
    </div>
  </div>
</div>

<script>
  /**
   * ✅ PHASE 6: Mobile Modal with SearchManager Integration
   */
  import { searchManager } from "../../lib/search-manager";
  import { fixCharacterEncoding } from "../../lib/search-utils";

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMobileModal);
  } else {
    initMobileModal();
  }

  function initMobileModal() {
    const modal = document.getElementById("mobile-search-modal");
    const closeBtn = document.getElementById("mobile-modal-close");
    const searchInput = document.getElementById(
      "mobile-modal-search-input"
    ) as HTMLInputElement;
    const popularSection = document.getElementById("mobile-popular-section");
    const popularList = document.getElementById("mobile-popular-list");
    const searchSection = document.getElementById("mobile-search-section");
    const searchList = document.getElementById("mobile-search-list");
    const emptyState = document.getElementById("mobile-empty-state");
    const resultsCount = document.getElementById("mobile-results-count");

    let searchTimeout: number;

    console.log(
      "✅ MobileSearchModal: Initializing with SearchManager integration"
    );

    /**
     * Modal API - Exposed globally
     */
    (window as any).mobileSearchModal = {
      open: function () {
        if (!modal) return;

        console.log("✅ MobileSearchModal: Opening");

        modal.classList.remove("hidden");
        modal.classList.add("modal-enter");
        document.body.style.overflow = "hidden";
        document.body.style.position = "fixed";
        document.body.style.width = "100%";

        setTimeout(() => {
          searchInput?.focus();
          showPopularProcedures();
        }, 300);
      },

      close: function () {
        if (!modal) return;

        console.log("✅ MobileSearchModal: Closing");

        modal.classList.remove("modal-enter");
        modal.classList.add("modal-exit");

        setTimeout(() => {
          modal.classList.add("hidden");
          modal.classList.remove("modal-exit");
          document.body.style.overflow = "";
          document.body.style.position = "";
          document.body.style.width = "";

          if (searchInput) searchInput.value = "";
          showPopularProcedures();
        }, 250);
      },
    };

    /**
     * Event Listeners
     */
    closeBtn?.addEventListener("click", () => {
      (window as any).mobileSearchModal.close();
    });

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        (window as any).mobileSearchModal.close();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
        (window as any).mobileSearchModal.close();
      }
    });

    /**
     * ✅ PHASE 6: Search input uses SearchManager
     */
    searchInput?.addEventListener("input", (e) => {
      clearTimeout(searchTimeout);
      const query = (e.target as HTMLInputElement).value.trim();

      searchTimeout = window.setTimeout(() => {
        if (query.length < 2) {
          showPopularProcedures();
        } else {
          // ✅ Use SearchManager for search
          searchManager.search(query);
          console.log("MobileSearchModal: Search via SearchManager", { query });
        }
      }, 200);
    });

    /**
     * ✅ PHASE 6: Subscribe to SearchManager state
     */
    searchManager.subscribe((state) => {
      console.log("MobileSearchModal: State update", {
        query: state.currentQuery,
        results: state.searchResults.length,
      });

      // Only update if modal is open
      if (modal?.classList.contains("hidden")) return;

      // Show search results
      if (state.currentQuery && state.currentQuery.length >= 2) {
        renderSearchResults(state.searchResults);
      }
    });

    /**
     * Show popular procedures
     */
    function showPopularProcedures() {
      if (!popularSection || !popularList) return;

      popularSection.classList.remove("hidden");
      searchSection?.classList.add("hidden");
      emptyState?.classList.add("hidden");

      // Get popular procedures from ProcedureLibrary
      const lib = (window as any).ProcedureLibrary;
      if (!lib || !lib.Popular) {
        console.warn("ProcedureLibrary.Popular not found");
        return;
      }

      popularList.innerHTML = renderGroupedResults(lib.Popular, "");
      attachResultHandlers();

      console.log("MobileSearchModal: Popular procedures shown");
    }

    /**
     * Render search results
     */
    function renderSearchResults(results: any[]) {
      if (results.length === 0) {
        popularSection?.classList.add("hidden");
        searchSection?.classList.add("hidden");
        emptyState?.classList.remove("hidden");
        return;
      }

      popularSection?.classList.add("hidden");
      searchSection?.classList.remove("hidden");
      emptyState?.classList.add("hidden");

      if (resultsCount) resultsCount.textContent = results.length.toString();
      if (searchList) {
        const currentQuery = searchInput?.value || "";
        searchList.innerHTML = renderGroupedResults(results, currentQuery);
        attachResultHandlers();
      }

      console.log("MobileSearchModal: Results rendered", {
        count: results.length,
      });
    }

    /**
     * Highlight matching characters in gold (USRad signature color)
     * while preserving original text and preventing regex issues.
     */
    function highlightMatch(text: string, query: string): string {
      if (!query || query.trim().length < 2) return text;
      const cleanText = text ?? "";
      const cleanQuery = query.trim();
      // Escape regex metacharacters in the search query
      const escaped = cleanQuery.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      // Case-insensitive, global match
      const regex = new RegExp(escaped, "gi");
      return cleanText.replace(regex, (match) => {
        return `<span class="text-[#b8862d] font-semibold">${match}</span>`;
      });
    }

    /**
     * Return consistent color-coded badge classes for modalities.
     * Automatically normalizes variations in naming and capitalization.
     */
    function getBadgeClass(modality: string): string {
      if (!modality) return "bg-gray-100 text-gray-600";

      // Normalize modality for reliable matching
      const key = modality.trim().toLowerCase();

      const badgeColors: Record<string, string> = {
        mri: "bg-blue-100 text-blue-600",
        ct: "bg-[#fff8ee] text-[#b8862d]", // USRad Gold
        "x-ray": "bg-gray-100 text-gray-600",
        xray: "bg-gray-100 text-gray-600", // alias for safety
        ultrasound: "bg-green-100 text-green-600",
        other: "bg-gray-100 text-gray-600",
      };

      return badgeColors[key] || badgeColors["other"];
    }

    /**
     * Render grouped results with character encoding fixes
     */
    function renderGroupedResults(procedures: any[], query: string = "") {
      const groups: Record<string, any[]> = {};

      procedures.forEach((proc) => {
        const modality = proc.modality || "Other";
        if (!groups[modality]) groups[modality] = [];
        groups[modality].push(proc);
      });

      const modalityOrder = ["MRI", "CT", "X-Ray", "Ultrasound", "Other"];
      const ICONS: Record<string, string> = {
        MRI: "🧠",
        CT: "🦴",
        "X-Ray": "👀",
        Ultrasound: "🩺",
        Other: "📋",
      };

      return modalityOrder
        .map((modality) => {
          const group = groups[modality];
          if (!group || group.length === 0) return "";

          const icon = ICONS[modality] || "📋";

          return `
            <div class="mb-4 border border-gray-100 rounded-xl overflow-hidden shadow-sm">
              <div class="sticky top-0 z-10 px-4 py-2.5 bg-gradient-to-r from-[#fff8ee] to-white border-b border-[#f5e4c3]">
                <h4 class="text-sm font-semibold text-[#b8862d]">${icon} ${modality}</h4>
              </div>
              <div class="divide-y divide-gray-100">
                ${group
                  .map((proc) => {
                    // ✅ PHASE 6: Apply character encoding fix
                    const cleanLabel = fixCharacterEncoding(proc.label);
                    const cpt = proc.cpt || proc.cptCode || "";
                    const bodyPart = proc.bodyPart || "";

                    return `
                      <button type="button" 
                        class="w-full text-left flex items-center justify-between px-4 py-3 hover:bg-gray-50 mobile-procedure-result"
                        data-cpt="${cpt}" 
                        data-label="${cleanLabel}" 
                        data-modality="${modality}" 
                        data-bodypart="${bodyPart}">
                        <span class="text-[15px] font-medium text-gray-900">${highlightMatch(cleanLabel, query)}</span>
                        <span class="text-xs px-2 py-1 rounded ${getBadgeClass(modality)}">${modality}</span>
                      </button>
                    `;
                  })
                  .join("")}
              </div>
            </div>
          `;
        })
        .join("");
    }

    /**
     * Attach click handlers to procedure buttons
     */
    function attachResultHandlers() {
      document.querySelectorAll(".mobile-procedure-result").forEach((btn) => {
        btn.addEventListener("click", () => {
          const procedure = {
            cptCode: btn.getAttribute("data-cpt") || "",
            label: btn.getAttribute("data-label") || "",
            modality: btn.getAttribute("data-modality") || "",
            bodyPart: btn.getAttribute("data-bodypart") || "",
          };

          console.log("MobileSearchModal: Procedure selected", procedure);

          // ✅ PHASE 6: Use SearchManager to select procedure
          searchManager.selectProcedure(procedure);

          // Dispatch custom event for backward compatibility
          document.dispatchEvent(
            new CustomEvent("mobile-procedure-selected", {
              detail: procedure,
              bubbles: true,
            })
          );

          // Close modal
          (window as any).mobileSearchModal.close();
        });
      });
    }

    console.log("✅ MobileSearchModal: Initialization complete");
  }
</script>

<style>
  @keyframes slideUp {
    from {
      transform: translateY(100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes slideDown {
    from {
      transform: translateY(0);
      opacity: 1;
    }
    to {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  .modal-enter {
    animation: slideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .modal-exit {
    animation: slideDown 0.25s cubic-bezier(0.4, 0, 0.6, 1) forwards;
  }

  .mobile-modal-body {
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  .mobile-search-modal {
    /* Maximum z-index and positioning */
    z-index: 2147483647 !important;
    position: fixed !important;
    /* ... all positioning props ... */

    /* Solid background - no transparency */
    background-color: white !important;

    /* Create new stacking context at root level */
    transform: translateZ(0);
    will-change: transform;
    isolation: isolate;

    /* Ensure it's on its own layer */
    contain: layout style paint;
  }

  .mobile-procedure-result:active {
    transform: scale(0.98);
    transition: transform 0.1s ease;
  }

  @media (min-width: 768px) {
    .mobile-search-modal {
      display: none !important;
    }
  }
</style>
