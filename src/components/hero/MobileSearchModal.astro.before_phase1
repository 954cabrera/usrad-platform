---
/**
 * MobileSearchModal.astro - UPDATED WITH SEARCHMANAGER INTEGRATION
 *
 * ✅ PHASE 6 INTEGRATION CHANGES:
 * 1. Uses SearchManager for search (no duplicate logic)
 * 2. Applies character encoding fixes (fixCharacterEncoding)
 * 3. Subscribes to SearchManager state
 * 4. Maintains backward compatibility with custom events
 *
 * DEPENDENCIES:
 * - window.searchManager (provided by HeroSection.astro initialization)
 * - window.ProcedureLibrary (provided by procedure-data.js)
 *
 * API:
 * - window.mobileSearchModal.open() - Opens modal
 * - window.mobileSearchModal.close() - Closes modal
 *
 * Events:
 * - Dispatches 'mobile-procedure-selected' custom event
 * - SearchManager handles actual state updates
 */
---

<!-- Mobile Search Modal - Full Screen Overlay -->
<div
  id="mobile-search-modal"
  class="mobile-search-modal hidden fixed inset-0 bg-white"
  style="z-index: 2147483647 !important; position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; background-color: white !important; width: 100vw !important; height: 100vh !important;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-search-title"
>
  <!-- Header: Fixed at top -->
  <div
    class="mobile-modal-header sticky top-0 z-[100] bg-white border-b border-gray-200 shadow-sm"
  >
    <div class="flex items-center gap-3 p-4">
      <!-- Close Button -->
      <button
        type="button"
        id="mobile-modal-close"
        class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-100 transition-colors"
        aria-label="Close search"
      >
        <svg
          class="w-6 h-6 text-gray-600"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Title -->
      <div class="flex-1">
        <h2
          id="mobile-search-title"
          class="text-lg font-semibold text-gray-900"
        >
          Which scan do you need?
        </h2>
      </div>
    </div>

    <!-- Search Input -->
    <div class="px-4 pb-4">
      <div class="relative">
        <div
          class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
        >
          <svg
            class="w-5 h-5 text-gray-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          type="text"
          id="mobile-modal-search-input"
          placeholder="Type MRI, CT, Ultrasound..."
          autocomplete="off"
          class="w-full pl-12 pr-4 py-3.5 text-base text-gray-900 placeholder-gray-500 bg-gray-50 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#003087] focus:border-transparent transition-all"
        />
      </div>
    </div>
  </div>

  <!-- Results Container -->
  <div
    id="mobile-modal-results"
    class="mobile-modal-body overflow-y-auto"
    style="height: calc(100vh - 160px);"
  >
    <!-- Popular Procedures Section -->
    <div id="mobile-popular-section" class="px-4 py-3">
      <div class="mb-3">
        <div class="flex items-center justify-between mb-2">
          <h3
            class="text-sm font-semibold text-[#b8862d] flex items-center gap-2"
          >
            ⭐ Popular Procedures
          </h3>
          <span class="text-xs text-[#b8862d]/80 font-medium"
            >Curated by USRad</span
          >
        </div>
        <p class="text-xs text-gray-500">Or start typing to search...</p>
      </div>
      <div id="mobile-popular-list" class="space-y-2"></div>
    </div>

    <!-- Search Results Section -->
    <div id="mobile-search-section" class="hidden px-4 py-3">
      <div class="mb-3">
        <h3 class="text-sm font-semibold text-gray-700">
          <span id="mobile-results-count">0</span> Results
        </h3>
      </div>
      <div id="mobile-search-list" class="space-y-2"></div>
    </div>

    <!-- Empty State -->
    <div id="mobile-empty-state" class="hidden text-center py-16 px-4">
      <svg
        class="w-16 h-16 mx-auto mb-4 text-gray-300"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <p class="text-base font-semibold text-gray-700 mb-1">
        No procedures found
      </p>
      <p class="text-sm text-gray-500">Try a different search term</p>
    </div>
  </div>
</div>

<script>
  const DEBUG = false;

  /**
   * ════════════════════════════════════════════════════════════════
   *   INLINE UTILITY: fixCharacterEncoding
   * ════════════════════════════════════════════════════════════════
   */
  const ENCODING_MAP = {
    "\xE2\x80\x93": "\u2013", // en dash
    "\xE2\x80\x94": "\u2014", // em dash
    "\xE2\x80\x9C": "\u201C", // left double quote
    "\xE2\x80\x9D": "\u201D", // right double quote
    "\xE2\x80\x98": "\u2018", // left single quote
    "\xE2\x80\x99": "\u2019", // right single quote
    "\xE2\x80\xA2": "\u2022", // bullet
    "\xC2\xA0": "\u00A0", // non-breaking space
  };

  function fixCharacterEncoding(text) {
    if (!text || typeof text !== "string") return text;
    let fixed = text;
    for (const [bad, good] of Object.entries(ENCODING_MAP)) {
      fixed = fixed.split(bad).join(good);
    }
    return fixed;
  }

  /**
   * ════════════════════════════════════════════════════════════════
   *   INITIALIZE MOBILE SEARCH MODAL
   * ════════════════════════════════════════════════════════════════
   */
  function initMobileModal() {
    // Wait for SearchManager + ProcedureLibrary (provided by HeroSection.astro)
    if (!window.searchManager || !window.ProcedureLibrary) {
      setTimeout(initMobileModal, 50);
      return;
    }

    const modal = document.getElementById("mobile-search-modal");
    const closeBtn = document.getElementById("mobile-modal-close");

    const searchInput = document.getElementById("mobile-modal-search-input");
    const popularSection = document.getElementById("mobile-popular-section");
    const popularList = document.getElementById("mobile-popular-list");

    const searchSection = document.getElementById("mobile-search-section");
    const searchList = document.getElementById("mobile-search-list");

    const emptyState = document.getElementById("mobile-empty-state");
    const resultsCount = document.getElementById("mobile-results-count");

    let searchTimeout = null;

    if (DEBUG) console.log("📱 MobileSearchModal: initializing");

    /**
     * ████████████████████████████████████████
     *   PUBLIC API — Window.mobileSearchModal
     * ████████████████████████████████████████
     */
    window.mobileSearchModal = {
      open() {
        if (!modal) return;

        if (DEBUG) console.log("📱 MobileSearchModal: open()");

        modal.classList.remove("hidden");
        modal.classList.add("modal-enter");
        document.body.style.overflow = "hidden";
        document.body.style.position = "fixed";
        document.body.style.width = "100%";

        setTimeout(() => {
          searchInput?.focus();
          showPopularProcedures();
        }, 200);
      },

      close() {
        if (!modal) return;

        if (DEBUG) console.log("📱 MobileSearchModal: close()");

        modal.classList.remove("modal-enter");
        modal.classList.add("modal-exit");

        setTimeout(() => {
          modal.classList.add("hidden");
          modal.classList.remove("modal-exit");
          document.body.style.overflow = "";
          document.body.style.position = "";
          document.body.style.width = "";

          if (searchInput) searchInput.value = "";
          showPopularProcedures();
        }, 200);
      },
    };

    /**
     * ████████████████████████████████████████
     *   EVENT LISTENERS
     * ████████████████████████████████████████
     */

    // Close button
    closeBtn?.addEventListener("click", () => window.mobileSearchModal.close());

    // Click backdrop to close
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) window.mobileSearchModal.close();
    });

    // Esc to close modal
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        window.mobileSearchModal.close();
      }
    });

    /**
     * Search Input — Uses SearchManager
     */
    searchInput?.addEventListener("input", (e) => {
      clearTimeout(searchTimeout);
      const query = e.target.value.trim();

      searchTimeout = setTimeout(() => {
        if (query.length < 2) {
          showPopularProcedures();
        } else {
          window.searchManager.search(query);
          if (DEBUG) console.log("MobileSearchModal: search:", query);
        }
      }, 200);
    });

    /**
     * ████████████████████████████████████████
     *   SUBSCRIBE TO SEARCH MANAGER
     * ████████████████████████████████████████
     */
    window.searchManager.subscribe((state) => {
      if (modal.classList.contains("hidden")) return;

      const query = state.currentQuery || "";

      if (DEBUG)
        console.log("📱 MobileSearchModal: state update", {
          query,
          results: state.searchResults.length,
        });

      if (query.length < 2) {
        showPopularProcedures();
      } else {
        renderSearchResults(state.searchResults, query);
      }
    });

    /**
     * ████████████████████████████████████████
     *   RENDER: POPULAR PROCEDURES
     * ████████████████████████████████████████
     */
    function showPopularProcedures() {
      if (!popularList || !popularSection) return;

      const lib = window.ProcedureLibrary;

      let popular = lib?.Popular || [];

      if (!Array.isArray(popular) && typeof popular === "object") {
        popular = Object.values(popular)
          .filter((p) => p?.procedures)
          .flatMap((p) => p.procedures);
      }

      popular = popular || [];

      popularSection.classList.remove("hidden");
      searchSection?.classList.add("hidden");
      emptyState?.classList.add("hidden");

      popularList.innerHTML = renderGroupedResults(popular, "");
      attachResultHandlers();

      if (DEBUG)
        console.log("📱 MobileSearchModal: showing popular", popular.length);
    }

    /**
     * ████████████████████████████████████████
     *   RENDER: SEARCH RESULTS
     * ████████████████████████████████████████
     */
    function renderSearchResults(results, query) {
      if (!searchList) return;

      if (results.length === 0) {
        popularSection?.classList.add("hidden");
        searchSection?.classList.add("hidden");
        emptyState?.classList.remove("hidden");
        return;
      }

      popularSection?.classList.add("hidden");
      emptyState?.classList.add("hidden");
      searchSection?.classList.remove("hidden");

      if (resultsCount) resultsCount.textContent = results.length.toString();

      searchList.innerHTML = renderGroupedResults(results, query);
      attachResultHandlers();

      if (DEBUG)
        console.log("📱 MobileSearchModal: rendered results", results.length);
    }

    /**
     * ████████████████████████████████████████
     *   HELPERS: RENDER grouped results
     * ████████████████████████████████████████
     */
    function renderGroupedResults(results, query = "") {
      const groups = {};
      results.forEach((p) => {
        const m = p.modality || "Other";
        if (!groups[m]) groups[m] = [];
        groups[m].push(p);
      });

      const order = ["MRI", "CT", "X-Ray", "Ultrasound", "Other"];
      const ICONS = {
        MRI: "🧠",
        CT: "🦴",
        "X-Ray": "👀",
        Ultrasound: "🩺",
        Other: "📋",
      };

      return order
        .map((mod) => {
          const group = groups[mod];
          if (!group || group.length === 0) return "";

          return `
            <div class="mb-4 border border-gray-100 rounded-xl overflow-hidden shadow-sm">
              <div class="sticky top-0 z-10 px-4 py-2.5 bg-gradient-to-r from-[#fff8ee] to-white border-b border-[#f5e4c3] flex items-center justify-between">
                <h4 class="text-sm font-semibold text-[#b8862d]">
                  ${ICONS[mod] || "📋"} ${mod}
                </h4>
              </div>

              <div class="divide-y divide-gray-100">
                ${group
                  .map((p) => {
                    const cleanLabel = fixCharacterEncoding(p.label);
                    const highlighted = highlightMatch(cleanLabel, query);
                    const cpt = p.cpt || p.cptCode || "";

                    return `
                      <button
                        type="button"
                        class="w-full text-left flex items-center justify-between px-4 py-3 hover:bg-gray-50 mobile-procedure-result"
                        data-cpt="${cpt}"
                        data-label="${cleanLabel}"
                        data-modality="${mod}"
                        data-bodypart="${p.bodyPart || ""}"
                      >
                        <span class="text-[15px] font-medium text-gray-900">${highlighted}</span>
                        <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-700">${mod}</span>
                      </button>
                    `;
                  })
                  .join("")}
              </div>
            </div>
          `;
        })
        .join("");
    }

    /**
     * ████████████████████████████████████████
     *   HELPERS: Highlight matches
     * ████████████████████████████████████████
     */
    function highlightMatch(text, query) {
      if (!query || query.length < 2) return text;

      const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const regex = new RegExp(escaped, "gi");

      return text.replace(
        regex,
        (m) => `<span class="text-[#b8862d] font-semibold">${m}</span>`
      );
    }

    /**
     * ████████████████████████████████████████
     *   HELPERS: Click handlers
     * ████████████████████████████████████████
     */
    function attachResultHandlers() {
      document.querySelectorAll(".mobile-procedure-result").forEach((btn) => {
        btn.addEventListener("click", () => {
          const selected = {
            cptCode: btn.getAttribute("data-cpt") || "",
            label: btn.getAttribute("data-label") || "",
            modality: btn.getAttribute("data-modality") || "",
            bodyPart: btn.getAttribute("data-bodypart") || "",
          };

          if (DEBUG) console.log("📱 MobileSearchModal: selecting", selected);

          window.searchManager.selectProcedure(selected);

          // Dispatch custom event for backward compatibility
          const event = new CustomEvent("mobile-procedure-selected", {
            detail: selected,
            bubbles: true,
          });
          document.dispatchEvent(event);

          window.mobileSearchModal.close();
        });
      });
    }

    if (DEBUG) console.log("✅ MobileSearchModal: ready");
  }

  // Initialize on DOM ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMobileModal);
  } else {
    initMobileModal();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener("astro:page-load", initMobileModal);
</script>

<style>
  /* Modal animations */
  .modal-enter {
    animation: modalSlideIn 0.3s ease-out;
  }

  .modal-exit {
    animation: modalSlideOut 0.25s ease-in;
  }

  @keyframes modalSlideIn {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes modalSlideOut {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(100%);
    }
  }

  /* Scrollbar styling */
  .mobile-modal-body {
    scrollbar-width: thin;
    scrollbar-color: #b8862d #f3f4f6;
  }

  .mobile-modal-body::-webkit-scrollbar {
    width: 6px;
  }

  .mobile-modal-body::-webkit-scrollbar-track {
    background: #f3f4f6;
  }

  .mobile-modal-body::-webkit-scrollbar-thumb {
    background-color: #b8862d;
    border-radius: 3px;
  }
</style>
