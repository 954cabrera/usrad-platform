---
// SearchLoadingOverlay.astro
// Enterprise-grade loading overlay that appears INSTANTLY when user clicks "Find Centers"
// This prevents the "frozen page" feeling during cross-origin navigation
import BrandLogo from "../brand/BrandLogo.astro";
---

<!-- Full-screen loading overlay - hidden by default -->
<div
  id="search-loading-overlay"
  class="fixed inset-0 z-[999999] hidden"
  aria-hidden="true"
  role="status"
  aria-live="polite"
>
  <!-- Backdrop with blur -->
  <div class="absolute inset-0 bg-white/95 backdrop-blur-sm"></div>

  <!-- Loading content -->
  <div
    class="relative z-10 flex flex-col items-center justify-center min-h-screen px-4"
  >
    <!-- USRad Logo -->
    <div class="mb-8 animate-pulse">
      <BrandLogo size="header" />
    </div>

    <!-- Animated progress indicator -->
    <div class="w-full max-w-md mb-8">
      <!-- Progress bar container -->
      <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
        <div
          id="search-progress-bar"
          class="h-full bg-gradient-to-r from-[#003087] to-[#00CED1] rounded-full transition-all duration-500 ease-out"
          style="width: 0%"
        >
        </div>
      </div>

      <!-- Progress steps -->
      <div class="flex justify-between mt-3 text-xs text-gray-500">
        <span id="step-1" class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-[#003087]"></span>
          Analyzing your options
        </span>
        <span id="step-2" class="flex items-center gap-1 opacity-50">
          <span class="w-2 h-2 rounded-full bg-gray-300"></span>
          Evaluating providers
        </span>
        <span id="step-3" class="flex items-center gap-1 opacity-50">
          <span class="w-2 h-2 rounded-full bg-gray-300"></span>
          Selecting best match
        </span>
      </div>
    </div>

    <!-- Dynamic status message -->
    <div class="text-center mb-8">
      <h2 id="loading-title" class="text-2xl font-bold text-gray-900 mb-2">
        Identifying your best option...
      </h2>
      <p id="loading-subtitle" class="text-gray-600">
        Evaluating <span
          id="loading-procedure"
          class="font-medium text-[#003087]">MRI</span
        >
        providers within <span id="loading-radius" class="font-medium"
          >25 miles</span
        >
      </p>
    </div>

    <!-- Skeleton preview — hierarchy-aware, mirrors actual results layout -->
    <div class="w-full max-w-2xl space-y-3">
      <!-- PRIMARY CARD SKELETON — dominant, navy border, top-ranked structure -->
      <div
        class="skeleton-primary-card bg-white rounded-xl border-2 border-[#003087] shadow-lg overflow-hidden"
      >
        <div class="skeleton-bar h-1 w-full"></div>
        <div class="p-5">
          <!-- Top-ranked label skeleton -->
          <div class="mb-3">
            <div
              class="h-3 rounded-full w-44 skeleton-shimmer"
              style="background-color: rgba(0,48,135,0.1)"
            >
            </div>
          </div>
          <!-- Provider row -->
          <div class="flex items-start justify-between gap-4 mb-3">
            <div class="flex items-center gap-3 flex-1">
              <div
                class="w-10 h-10 rounded-lg flex-shrink-0 skeleton-shimmer"
                style="background-color: rgba(0,48,135,0.08)"
              >
              </div>
              <div class="flex-1 space-y-2">
                <div class="h-4 bg-gray-200 rounded w-3/4 skeleton-shimmer">
                </div>
                <div class="h-3 bg-gray-100 rounded w-1/2 skeleton-shimmer">
                </div>
              </div>
            </div>
            <!-- Price -->
            <div class="text-right space-y-1.5 flex-shrink-0">
              <div
                class="h-7 bg-gray-200 rounded w-20 ml-auto skeleton-shimmer"
              >
              </div>
              <div
                class="h-3 bg-gray-100 rounded w-14 ml-auto skeleton-shimmer"
              >
              </div>
            </div>
          </div>
          <!-- SmartMatch confidence line skeleton -->
          <div
            class="h-3 rounded w-5/6 mb-3 skeleton-shimmer"
            style="background-color: rgba(0,48,135,0.07)"
          >
          </div>
          <!-- Signal pills -->
          <div class="flex gap-2 mb-4">
            <div class="h-6 bg-gray-100 rounded-md w-28 skeleton-shimmer"></div>
            <div class="h-6 bg-gray-100 rounded-md w-36 skeleton-shimmer"></div>
            <div class="h-6 bg-gray-100 rounded-md w-24 skeleton-shimmer"></div>
          </div>
          <!-- CTA button -->
          <div
            class="h-11 rounded-lg w-full skeleton-shimmer"
            style="background-color: rgba(0,48,135,0.12)"
          >
          </div>
        </div>
      </div>

      <!-- Section label skeleton -->
      <div class="px-1 pt-1">
        <div class="h-3 bg-gray-200 rounded w-40 skeleton-shimmer"></div>
      </div>

      <!-- CONTENDER CARD 1 SKELETON -->
      <div
        class="skeleton-contender bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden"
        style="animation-delay: 0.15s"
      >
        <div class="p-4">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3 flex-1">
              <div
                class="w-9 h-9 bg-gray-100 rounded-lg flex-shrink-0 skeleton-shimmer"
              >
              </div>
              <div class="flex-1 space-y-2">
                <div class="h-3.5 bg-gray-200 rounded w-2/3 skeleton-shimmer">
                </div>
                <div class="h-3 bg-gray-100 rounded w-1/3 skeleton-shimmer">
                </div>
              </div>
            </div>
            <div class="text-right space-y-1.5 flex-shrink-0">
              <div
                class="h-6 bg-gray-200 rounded w-16 ml-auto skeleton-shimmer"
              >
              </div>
              <div
                class="h-3 bg-gray-100 rounded w-12 ml-auto skeleton-shimmer"
              >
              </div>
            </div>
          </div>
          <div class="mt-3 flex gap-2">
            <div class="h-5 bg-gray-100 rounded-md w-24 skeleton-shimmer"></div>
            <div class="h-5 bg-gray-100 rounded-md w-28 skeleton-shimmer"></div>
          </div>
        </div>
      </div>

      <!-- CONTENDER CARD 2 SKELETON — further reduced weight -->
      <div
        class="skeleton-contender bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden opacity-60"
        style="animation-delay: 0.3s"
      >
        <div class="p-4">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3 flex-1">
              <div
                class="w-9 h-9 bg-gray-100 rounded-lg flex-shrink-0 skeleton-shimmer"
              >
              </div>
              <div class="flex-1 space-y-2">
                <div class="h-3.5 bg-gray-200 rounded w-1/2 skeleton-shimmer">
                </div>
                <div class="h-3 bg-gray-100 rounded w-1/4 skeleton-shimmer">
                </div>
              </div>
            </div>
            <div class="text-right space-y-1.5 flex-shrink-0">
              <div
                class="h-6 bg-gray-200 rounded w-16 ml-auto skeleton-shimmer"
              >
              </div>
              <div
                class="h-3 bg-gray-100 rounded w-12 ml-auto skeleton-shimmer"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust signals -->
    <div class="mt-8 flex flex-wrap justify-center gap-6 text-sm text-gray-500">
      <div class="flex items-center gap-2">
        <svg
          class="w-5 h-5 text-green-500"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        <span>Save up to 70%</span>
      </div>
      <div class="flex items-center gap-2">
        <svg
          class="w-5 h-5 text-green-500"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        <span>1,500+ centers</span>
      </div>
      <div class="flex items-center gap-2">
        <svg
          class="w-5 h-5 text-green-500"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        <span>No insurance needed</span>
      </div>
    </div>
  </div>
</div>

<script>
  // SearchLoadingOverlay Controller
  window.SearchLoadingOverlay = {
    overlay: null,
    progressBar: null,
    progressInterval: null,
    currentProgress: 0,

    init() {
      this.overlay = document.getElementById("search-loading-overlay");
      this.progressBar = document.getElementById("search-progress-bar");
    },

    show(procedureName = "MRI", radius = "25") {
      if (!this.overlay) this.init();

      // Update dynamic content
      const procEl = document.getElementById("loading-procedure");
      const radiusEl = document.getElementById("loading-radius");
      if (procEl) procEl.textContent = procedureName;
      if (radiusEl) radiusEl.textContent = radius + " miles";

      // Show overlay
      this.overlay.classList.remove("hidden");
      this.overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";

      // Start progress animation
      this.startProgress();
    },

    hide() {
      if (!this.overlay) return;

      this.overlay.classList.add("hidden");
      this.overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";

      this.stopProgress();
    },

    startProgress() {
      this.currentProgress = 0;

      // Simulate realistic loading progress
      const stages = [
        {
          target: 25,
          duration: 800,
          step: 1,
          title: "Evaluating providers in your area...",
          subtitle: "Scanning nearby facilities",
        },
        {
          target: 50,
          duration: 1500,
          step: 2,
          title: "Ranking by price, proximity, and quality...",
          subtitle: "Identifying your top-ranked option",
        },
        {
          target: 75,
          duration: 2000,
          step: 3,
          title: "Your best match is ready...",
          subtitle: "Preparing your recommendation",
        },
        {
          target: 90,
          duration: 3000,
          step: 3,
          title: "Almost there...",
          subtitle: "Just a moment more",
        },
      ];

      let stageIndex = 0;

      const updateProgress = () => {
        if (stageIndex >= stages.length) return;

        const stage = stages[stageIndex];

        // Update step indicators
        this.updateSteps(stage.step);

        // Update titles
        const titleEl = document.getElementById("loading-title");
        const subtitleEl = document.getElementById("loading-subtitle");
        if (titleEl) titleEl.textContent = stage.title;

        // Animate progress bar
        const increment =
          (stage.target - this.currentProgress) / (stage.duration / 50);

        this.progressInterval = setInterval(() => {
          this.currentProgress += increment;

          if (this.currentProgress >= stage.target) {
            this.currentProgress = stage.target;
            clearInterval(this.progressInterval);
            stageIndex++;

            // Move to next stage after a brief pause
            setTimeout(updateProgress, 200);
          }

          if (this.progressBar) {
            this.progressBar.style.width = this.currentProgress + "%";
          }
        }, 50);
      };

      updateProgress();
    },

    updateSteps(activeStep) {
      for (let i = 1; i <= 3; i++) {
        const stepEl = document.getElementById(`step-${i}`);
        if (!stepEl) continue;

        const dot = stepEl.querySelector("span");

        if (i < activeStep) {
          // Completed
          stepEl.classList.remove("opacity-50");
          if (dot) dot.classList.replace("bg-gray-300", "bg-green-500");
        } else if (i === activeStep) {
          // Active
          stepEl.classList.remove("opacity-50");
          if (dot) dot.classList.replace("bg-gray-300", "bg-[#003087]");
        } else {
          // Pending
          stepEl.classList.add("opacity-50");
        }
      }
    },

    stopProgress() {
      if (this.progressInterval) {
        clearInterval(this.progressInterval);
        this.progressInterval = null;
      }
      this.currentProgress = 0;
      if (this.progressBar) {
        this.progressBar.style.width = "0%";
      }
    },
  };

  // Auto-init on page load
  document.addEventListener("DOMContentLoaded", () => {
    window.SearchLoadingOverlay.init();
  });

  // Also init on Astro page transitions
  document.addEventListener("astro:page-load", () => {
    window.SearchLoadingOverlay.init();
  });
</script>

<style>
  @keyframes shimmer {
    0% {
      background-position: -400% 0;
    }
    100% {
      background-position: 400% 0;
    }
  }

  @keyframes skeletonFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes primaryPulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(0, 48, 135, 0);
    }
    50% {
      box-shadow: 0 0 0 4px rgba(0, 48, 135, 0.07);
    }
  }

  @keyframes barFlow {
    0% {
      background-position: -200% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  .skeleton-shimmer {
    background: linear-gradient(90deg, #efefef 25%, #f8f8f8 50%, #efefef 75%);
    background-size: 400% 100%;
    animation: shimmer 1.8s ease-in-out infinite;
  }

  .skeleton-primary-card {
    animation:
      skeletonFadeIn 0.35s ease-out both,
      primaryPulse 2.5s ease-in-out 0.35s infinite;
  }

  .skeleton-bar {
    background: linear-gradient(
      90deg,
      #003087 0%,
      #0047c0 35%,
      #cc9933 55%,
      #003087 100%
    );
    background-size: 200% 100%;
    animation: barFlow 2s linear infinite;
  }

  .skeleton-contender {
    animation: skeletonFadeIn 0.35s ease-out both;
  }
</style>
