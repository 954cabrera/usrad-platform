---
/**
 * SearchResults.astro
 * ===================
 * Displays search results when user types 2+ characters.
 *
 * ⚠️ CRITICAL: CHARACTER ENCODING FIXES APPLIED ⚠️
 * This component applies fixCharacterEncoding() to ALL procedure labels
 * to prevent corrupted UTF-8 characters (â€", â€œ, etc.) from displaying.
 *
 * PURPOSE:
 * - Shows search results grouped by modality
 * - Displays result count
 * - Handles empty state (no results found)
 * - Subscribes to SearchManager for reactive updates
 *
 * DEPENDENCIES:
 * - window.searchManager (global instance from HeroSection)
 *
 * BEHAVIOR:
 * - Visible when query.length >= 2 AND results exist
 * - Hidden when query is empty
 * - Shows empty state when query >= 2 but no results
 * - Maximum 10 results displayed
 * - Handles procedure selection via SearchManager
 *
 * STRUCTURE:
 * - Header with result count
 * - Scrollable list with groups by modality
 * - Each procedure clickable with hover effects
 * - Empty state with icon and message
 * - Gentle fade at bottom for scroll indication
 */
---

<!-- Search Results Container -->
<div id="search-results-section" class="hidden relative">
  <!-- 
    Header Section with Result Count
    =================================
    - Blue gradient background to distinguish from popular
    - Dynamic result count updated by JavaScript
  -->
  <div
    class="px-4 py-3 bg-gradient-to-r from-blue-50 to-white border-b border-gray-200"
  >
    <h3 class="text-sm font-semibold text-gray-700">
      <span id="results-count">0</span> Results
    </h3>
  </div>

  <!-- 
    Scrollable Results Container
    ============================
    - max-h-[420px]: Maximum height before scrolling
    - Custom scrollbar styling applied via CSS
    - overflow-y-auto: Scrolls when content exceeds height
  -->
  <div
    id="search-results-list"
    class="overflow-y-auto max-h-[420px] px-3 py-2.5"
  >
    <!-- Search results will be rendered here by JavaScript -->
  </div>

  <!-- 
    Fade Indicator
    ==============
    Gentle gradient at bottom to indicate more content below
  -->
  <div
    class="pointer-events-none absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-white to-transparent rounded-b-xl"
  >
  </div>
</div>

<!-- 
  Empty State
  ===========
  Shown when search query is >= 2 chars but no results found
-->
<div id="empty-state" class="hidden text-center py-12 px-4">
  <!-- Search icon -->
  <svg
    class="w-16 h-16 mx-auto mb-4 text-gray-300"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
  </svg>

  <!-- Empty state message -->
  <p class="text-base font-semibold text-gray-700 mb-1">No procedures found</p>
  <p class="text-sm text-gray-500">Try a different search term</p>
</div>

<script>
  const DEBUG = false;

  /**
   * Helper: Fix character encoding issues
   * (Inline version - no import needed)
   */
  function fixCharacterEncoding(text: string): string {
    if (!text || typeof text !== "string") return text;

    const ENCODING_MAP: Record<string, string> = {
      "\xE2\x80\x93": "\u2013",
      "\xE2\x80\x94": "\u2014",
      "\xE2\x80\x9C": "\u201C",
      "\xE2\x80\x9D": "\u201D",
      "\xE2\x80\x98": "\u2018",
      "\xE2\x80\x99": "\u2019",
      "\xE2\x80\xA2": "\u2022",
      "\xC2\xA0": "\u00A0",
    };

    let fixed = text;
    for (const [bad, good] of Object.entries(ENCODING_MAP)) {
      fixed = fixed.split(bad).join(good);
    }
    return fixed;
  }

  // State elements
  const resultsContainer = document.getElementById("search-results-section");
  const resultsListContainer = document.getElementById("search-results-list");
  const resultsCountElement = document.getElementById("results-count");
  const emptyStateContainer = document.getElementById("empty-state");

  /**
   * Highlight parts of text that match the query
   */
  function highlightMatch(text, query) {
    if (!query || query.length < 2) return text;

    const normalizedQuery = query
      .toLowerCase()
      .replace(/[^\w\s]/g, " ")
      .replace(/\s+/g, " ")
      .trim();

    const words = normalizedQuery.split(" ").filter((w) => w.length >= 2);
    let result = text;

    words.forEach((word) => {
      const escaped = word.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const regex = new RegExp(`(${escaped})`, "gi");
      result = result.replace(
        regex,
        `<span class="font-semibold text-[#cc9933]">$1</span>`
      );
    });

    return result;
  }

  /**
   * Group results by modality
   */
  function groupByModality(procedures) {
    const groups = {};

    procedures.forEach((p) => {
      const key = p.modality || "Other";
      if (!groups[key]) groups[key] = [];
      groups[key].push(p);
    });

    return groups;
  }

  // Modalities and badges
  const MODALITY_ICONS = {
    MRI: "🧠",
    CT: "🦴",
    "X-Ray": "👀",
    Ultrasound: "🩺",
    Other: "📋",
  };

  /**
   * Render a single result button
   */
  function renderProcedureButton(proc, query) {
    const cleanLabel = fixCharacterEncoding(proc.label);
    const cleanBodyPart = fixCharacterEncoding(proc.bodyPart || "");

    const highlightedLabel = highlightMatch(cleanLabel, query);

    return `
      <button
        type="button"
        class="w-full text-left flex items-center justify-between px-4 py-2.5 hover:bg-gray-50 cursor-pointer transition procedure-result"
        data-cpt="${proc.cpt || ""}"
        data-label="${cleanLabel.replace(/"/g, "&quot;")}"
        data-modality="${proc.modality || ""}"
        data-bodypart="${cleanBodyPart.replace(/"/g, "&quot;")}"
        aria-label="Select ${cleanLabel}"
      >
        <div class="flex flex-col flex-1 min-w-0">
          <span class="text-[15px] font-medium text-gray-900 leading-tight">
            ${highlightedLabel}
          </span>

          ${
            cleanBodyPart
              ? `<span class="text-xs text-gray-500 mt-0.5">${cleanBodyPart}</span>`
              : ""
          }
        </div>

        <span
          class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-md text-[11px] font-semibold uppercase tracking-wide ${
            proc.modality === "MRI"
              ? "bg-[#e7f0ff] text-[#003087]"
              : proc.modality === "CT"
                ? "bg-[#fff8ee] text-[#b8862d]"
                : proc.modality === "X-Ray"
                  ? "bg-gray-100 text-gray-700"
                  : "bg-[#eefaf1] text-[#006d3b]"
          }"
        >
          ${proc.modality || "Scan"}
        </span>
      </button>
    `;
  }

  /**
   * Render grouped results with sticky modality headers
   */
  function renderGroupedResults(results, query) {
    const groups = groupByModality(results);
    const order = ["MRI", "CT", "X-Ray", "Ultrasound", "Other"];

    return order
      .map((mod) => {
        const group = groups[mod];
        if (!group || group.length === 0) return "";

        const icon = MODALITY_ICONS[mod] || "📋";

        return `
          <div class="mb-4 border border-gray-100 rounded-lg overflow-hidden shadow-sm">
            <div class="sticky top-0 z-10 px-4 py-2 bg-gradient-to-r from-blue-50 to-white border-b border-blue-100 flex items-center justify-between backdrop-blur-sm">
              <h4 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                <span>${icon}</span>${mod}
              </h4>
              <span class="text-xs text-gray-500">${group.length} results</span>
            </div>

            <div class="divide-y divide-gray-100 max-h-[220px] overflow-y-auto">
              ${group.map((proc) => renderProcedureButton(proc, query)).join("")}
            </div>
          </div>
        `;
      })
      .join("");
  }

  /**
   * Attach click handlers for selecting a procedure
   */
  function attachHandlers() {
    const buttons = resultsListContainer?.querySelectorAll(".procedure-result");
    if (!buttons) return;

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selected = {
          cpt: btn.getAttribute("data-cpt") || "",
          label: btn.getAttribute("data-label") || "",
          modality: btn.getAttribute("data-modality") || "",
          bodyPart: btn.getAttribute("data-bodypart") || "",
        };

        if (DEBUG) console.log("SearchResults: selecting", selected);
        window.searchManager.selectProcedure(selected);
      });
    });
  }

  /**
   * Main rendering logic
   */
  function render(state) {
    if (!resultsContainer) return;

    const query = state.currentQuery || "";
    const results = state.searchResults || [];
    const hasQuery = query.length >= 2;
    const hasResults = results.length > 0;

    // Reset UI
    resultsContainer.classList.add("hidden");
    emptyStateContainer?.classList.add("hidden");

    // If query is too short, show nothing (popular list shows instead)
    if (!hasQuery) return;

    // Update result count
    if (resultsCountElement) {
      resultsCountElement.textContent = results.length.toString();
    }

    if (!hasResults) {
      emptyStateContainer?.classList.remove("hidden");
      return;
    }

    // Show container and render results
    resultsContainer.classList.remove("hidden");

    resultsListContainer.innerHTML = renderGroupedResults(results, query);

    // Attach click handlers after render
    attachHandlers();
  }

  /**
   * INIT — Subscribe to SearchManager
   */
  function init() {
    if (!window.searchManager) {
      if (DEBUG) console.log("SearchResults: waiting for searchManager...");
      setTimeout(init, 50);
      return;
    }

    const unsubscribe = window.searchManager.subscribe(render);

    document.addEventListener("astro:before-swap", unsubscribe);
    window.addEventListener("beforeunload", unsubscribe);

    if (DEBUG) console.log("SearchResults: ready");
  }

  // DOM Ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

  // Astro navigation reload
  document.addEventListener("astro:page-load", init);
</script>

<style>
  /**
   * Custom Scrollbar Styling
   * ========================
   * Gold/bronze theme matching brand colors
   */

  /* WebKit browsers (Chrome, Safari, Edge) */
  #search-results-list::-webkit-scrollbar {
    width: 12px;
  }

  #search-results-list::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
  }

  #search-results-list::-webkit-scrollbar-thumb {
    background: #b8862d; /* Brand gold */
    border-radius: 10px;
    border: 2px solid #ffffff;
  }

  #search-results-list::-webkit-scrollbar-thumb:hover {
    background: #996d24; /* Darker gold on hover */
  }

  /* Firefox */
  #search-results-list {
    scrollbar-width: auto;
    scrollbar-color: #b8862d #f1f1f1;
  }

  /* Nested scrollbars (for group lists) */
  #search-results-list .overflow-y-auto::-webkit-scrollbar {
    width: 8px;
  }

  #search-results-list .overflow-y-auto::-webkit-scrollbar-track {
    background: #f9f9f9;
    border-radius: 8px;
  }

  #search-results-list .overflow-y-auto::-webkit-scrollbar-thumb {
    background: #d4a855;
    border-radius: 8px;
    border: 1px solid #ffffff;
  }
</style>
