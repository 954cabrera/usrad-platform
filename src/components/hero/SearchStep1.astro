---
/**
 * SearchStep1.astro
 *
 * Search input component (Step 1 of the hero search flow)
 *
 * ✅ UNIVERSAL MODAL REFACTOR
 * All viewports now open the search modal on focus.
 * The inline dropdown is no longer the default for desktop.
 * The search bar in the hero acts as a visual entry point only.
 *
 * FEATURES:
 * 1. Search input as visual entry point
 * 2. Focus handler opens universal search modal on ALL viewports
 * 3. Integration with SearchManager
 * 4. Smooth transitions when switching steps
 *
 * BEHAVIOR (ALL VIEWPORTS):
 * - Focus → blur input immediately → open search modal
 * - Find button → open search modal
 * - Modal handles all search interaction
 *
 * DEPENDENCIES:
 * - window.searchManager (provided by HeroSection.astro initialization)
 * - window.mobileSearchModal (provided by MobileSearchModal.astro)
 */
---

<!-- STEP 1: Search Input with Find Button -->
<div
  id="search-step-1"
  class="relative z-[9999] max-w-3xl mx-auto mb-16 sm:mb-24 transition-all duration-500"
  data-aos="fade-up"
  data-aos-delay="300"
>
  <!-- Microcopy — speed signal above search bar -->
  <p class="text-white/80 text-sm sm:text-base mb-2 tracking-wide">
    Tell us what you need — SmartMatch™ will identify your best option
    instantly.
  </p>
  <p class="text-white/60 text-xs sm:text-sm mb-4">
    No searching. No guesswork.
  </p>

  <!-- Search Input Container -->
  <div
    class="relative rounded-2xl shadow-2xl ring-1 ring-white/20 p-1 bg-white/10 backdrop-blur-sm"
  >
    <div
      class="bg-white border border-gray-100 rounded-xl flex flex-col sm:flex-row items-stretch overflow-hidden"
    >
      <!-- Search Input with magnifying glass icon -->
      <div class="relative flex-1">
        <div
          class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none"
        >
          <svg
            class="w-5 h-5 text-gray-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            >
            </path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
            >
            </path>
          </svg>
        </div>
        <input
          type="text"
          id="hero-search-input"
          placeholder="Tell us your scan (MRI, CT, X-ray, etc.)"
          autocomplete="off"
          class="w-full pl-14 pr-6 py-4 sm:py-5 text-base sm:text-lg text-gray-900 placeholder-gray-400 bg-transparent focus:outline-none transition-all"
          aria-label="Search for medical procedures"
          aria-autocomplete="list"
          aria-controls="mobile-search-modal"
          aria-expanded="false"
        />
      </div>

      <!-- Search Button -->
      <button
        type="button"
        id="hero-find-button"
        class="bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-8 py-4 sm:py-5 font-bold text-base sm:text-lg transition-all duration-300 hover:brightness-110"
      >
        <span class="flex items-center justify-center gap-2">
          Get Your Recommendation
          <svg
            class="w-5 h-5 opacity-75"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </span>
      </button>
    </div>
  </div>
</div>

<style>
  /* Fade animations for step transitions */
  .fade-in-step {
    animation: fadeInStep 0.25s ease-out;
  }

  .fade-out-step {
    animation: fadeOutStep 0.25s ease-out;
  }

  @keyframes fadeInStep {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeOutStep {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-10px);
    }
  }
</style>

<script>
  const DEBUG = false;

  let isSubscribed = false;

  function initializeSearchStep1() {
    const searchInput = document.getElementById("hero-search-input");
    const findButton = document.getElementById("hero-find-button");

    if (!searchInput) {
      console.error("SearchStep1: search input missing");
      return;
    }

    // Wait for searchManager (provided by HeroSection.astro)
    if (!window.searchManager) {
      if (DEBUG) console.log("SearchStep1: waiting for searchManager...");
      setTimeout(initializeSearchStep1, 75);
      return;
    }

    if (DEBUG) console.log("SearchStep1: initializing");

    /**
     * Focus handler — UNIVERSAL: always opens modal on all viewports
     */
    searchInput.addEventListener("focus", () => {
      const currentState = window.searchManager.getState();

      if (DEBUG)
        console.log("[SearchStep1] focus:", {
          step: currentState.currentStep,
        });

      // Only open on Step 1
      if (currentState.currentStep !== 1) return;

      // Universal modal — all viewports
      if (window.mobileSearchModal) {
        searchInput.blur(); // prevent keyboard on mobile, remove focus on desktop
        window.mobileSearchModal.open();
      }
    });

    /**
     * Find button — opens modal on all viewports
     */
    if (findButton) {
      findButton.addEventListener("click", () => {
        const currentState = window.searchManager.getState();
        if (currentState.currentStep !== 1) return;

        if (window.mobileSearchModal) {
          window.mobileSearchModal.open();
        }
      });
    }

    /**
     * Subscribe to state updates
     */
    if (!isSubscribed) {
      let previousStep = 1;

      window.searchManager.subscribe((state) => {
        if (DEBUG)
          console.log("[SearchStep1] state:", {
            step: state.currentStep,
            selected: state.selectedProcedure?.label,
          });

        // Update input when a procedure is chosen
        if (state.selectedProcedure && state.currentStep === 2) {
          searchInput.value = state.selectedProcedure.label;
        }

        // Clear input only when going from step2 → step1
        if (state.currentStep === 1 && previousStep === 2) {
          searchInput.value = "";
        }

        // Update aria
        searchInput.setAttribute(
          "aria-expanded",
          state.isDropdownOpen ? "true" : "false",
        );

        // Toggle step visibility
        const step1Container = document.getElementById("search-step-1");
        if (step1Container) {
          if (state.currentStep === 1) {
            step1Container.classList.remove("hidden");
          } else {
            step1Container.classList.add("hidden");
          }
        }

        previousStep = state.currentStep;
      });

      isSubscribed = true;
      if (DEBUG) console.log("[SearchStep1] subscribed");
    }

    if (DEBUG) console.log("[SearchStep1] ready");
  }

  // DOM ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSearchStep1);
  } else {
    initializeSearchStep1();
  }

  // Astro page transitions
  document.addEventListener("astro:page-load", initializeSearchStep1);
</script>
