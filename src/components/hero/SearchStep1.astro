---
/**
 * SearchStep1.astro
 *
 * Search input component (Step 1 of the hero search flow)
 *
 * FEATURES:
 * 1. Search input with real-time search
 * 2. Focus handler that opens dropdown (desktop) or modal (mobile)
 * 3. Mobile detection (< 768px)
 * 4. Integration with SearchManager
 * 5. Smooth transitions when switching steps
 *
 * MOBILE BEHAVIOR:
 * - Focus → blur input immediately → open modal
 * - Prevents keyboard from showing
 *
 * DESKTOP BEHAVIOR:
 * - Focus → open dropdown
 * - Input → search with 200ms debounce
 * - Escape → close dropdown
 * - Click outside → close dropdown
 *
 * DEPENDENCIES:
 * - window.searchManager (provided by HeroSection.astro initialization)
 * - window.mobileSearchModal (provided by MobileSearchModal.astro)
 */
---

<!-- STEP 1: Search Input with Find Button -->
<div
  id="search-step-1"
  class="relative z-[9999] max-w-3xl mx-auto mb-16 sm:mb-24 transition-all duration-500"
  data-aos="fade-up"
  data-aos-delay="300"
>
  <!-- Search Input Container -->
  <div class="relative">
    <div
      class="bg-white/90 backdrop-blur-md border-2 border-white/60 shadow-lg rounded-xl flex flex-col sm:flex-row items-stretch overflow-hidden"
    >
      <!-- Search Input -->
      <input
        type="text"
        id="hero-search-input"
        placeholder="Type MRI, CT, Ultrasound..."
        autocomplete="off"
        class="flex-1 px-6 py-4 sm:py-5 text-base sm:text-lg text-gray-900 placeholder-gray-500 bg-transparent focus:outline-none focus:ring-2 focus:ring-[#003087]/20 transition-all"
        aria-label="Search for medical procedures"
        aria-autocomplete="list"
        aria-controls="search-dropdown"
        aria-expanded="false"
      />

      <!-- Find Button -->
      <button
        type="button"
        id="hero-find-button"
        class="bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-8 py-4 sm:py-5 font-bold text-base sm:text-lg transition-all duration-300 hover:brightness-110"
      >
        <span class="flex items-center justify-center gap-2">
          Find
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </span>
      </button>
    </div>
  </div>
</div>

<style>
  /* Fade animations for step transitions */
  .fade-in-step {
    animation: fadeInStep 0.25s ease-out;
  }

  .fade-out-step {
    animation: fadeOutStep 0.25s ease-out;
  }

  @keyframes fadeInStep {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeOutStep {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-10px);
    }
  }
</style>

<script>
  const DEBUG = false;

  let searchTimeout = null;
  let isSubscribed = false;

  function initializeSearchStep1() {
    const searchInput = document.getElementById("hero-search-input");
    const findButton = document.getElementById("hero-find-button");

    if (!searchInput) {
      console.error("SearchStep1: search input missing");
      return;
    }

    // Wait for searchManager (provided by HeroSection.astro)
    if (!window.searchManager) {
      if (DEBUG) console.log("SearchStep1: waiting for searchManager...");
      setTimeout(initializeSearchStep1, 75);
      return;
    }

    if (DEBUG) console.log("SearchStep1: initializing");

    /**
     * Focus handler — opens dropdown or mobile modal
     */
    searchInput.addEventListener("focus", () => {
      const isMobile = window.innerWidth < 768;
      const currentState = window.searchManager.getState();

      if (DEBUG)
        console.log("[SearchStep1] focus:", {
          step: currentState.currentStep,
          isMobile,
        });

      // Only open on Step 1
      if (currentState.currentStep !== 1) return;

      if (isMobile && window.mobileSearchModal) {
        searchInput.blur(); // prevent keyboard
        window.mobileSearchModal.open();
      } else {
        window.searchManager.openDropdown();
      }
    });

    searchInput.addEventListener("input", (e) => {
      const isMobile = window.innerWidth < 768;
      if (isMobile) return;

      const query = e.target.value.trim();

      clearTimeout(searchTimeout);
      window.searchManager.openDropdown();

      searchTimeout = setTimeout(() => {
        window.searchManager.search(query);

        // ✅ NUCLEAR: Directly update SearchResults DOM
        setTimeout(() => {
          const state = window.searchManager.getState();
          console.log(
            "[SearchStep1] Forcing DOM update:",
            state.currentQuery,
            state.searchResults.length
          );

          // Find the results list element
          const resultsList = document.getElementById("search-results-list");
          if (
            resultsList &&
            state.searchResults &&
            state.searchResults.length > 0
          ) {
            // Clear and rebuild HTML
            resultsList.innerHTML = buildResultsHTML(
              state.searchResults,
              query
            );

            // Attach click handlers
            document.querySelectorAll(".procedure-result").forEach((btn) => {
              btn.addEventListener("click", () => {
                const selected = {
                  label: btn.getAttribute("data-label") || "",
                  cpt: btn.getAttribute("data-cpt") || "",
                  cptCode: btn.getAttribute("data-cpt") || "",
                  modality: btn.getAttribute("data-modality") || "",
                  bodyPart: btn.getAttribute("data-bodypart") || "",
                  region: btn.getAttribute("data-bodypart") || "",
                  bodyPartKey: btn.getAttribute("data-bodypart-key") || "",
                  displayLabelOverride:
                    btn.getAttribute("data-display-override") || "",
                };
                window.searchManager.selectProcedure(selected);
              });
            });

            // Show container
            const resultsSection = document.getElementById(
              "search-results-section"
            );
            if (resultsSection) resultsSection.classList.remove("hidden");

            console.log(
              "[SearchStep1] DOM updated with",
              state.searchResults.length,
              "results"
            );
          }
        }, 100);

        if (DEBUG) console.log("[SearchStep1] search:", query);
      }, 200);
    });

    // Helper function to build HTML
    function buildResultsHTML(results, query) {
      const groups = {};
      results.forEach((p) => {
        const m = p.modality || "Other";
        if (!groups[m]) groups[m] = [];
        groups[m].push(p);
      });

      const order = ["MRI", "CT", "X-Ray", "Ultrasound", "Other"];

      return order
        .map((mod) => {
          const group = groups[mod];
          if (!group || !group.length) return "";

          return `
      <div class="mb-4 border border-gray-100 rounded-lg overflow-hidden shadow-sm">
        <div class="sticky top-0 z-10 px-4 py-2 bg-gradient-to-r from-blue-50 to-white border-b border-blue-100">
          <h4 class="text-sm font-semibold text-gray-700">${mod}</h4>
        </div>
        <div class="divide-y divide-gray-100">
          ${group
            .map(
              (p) => `
            <button type="button" class="w-full text-left px-4 py-2.5 hover:bg-gray-50 procedure-result"
              data-cpt="${p.cpt || p.cptCode || ""}"
              data-label="${p.label}"
              data-modality="${p.modality || ""}"
              data-bodypart="${p.bodyPart || ""}"
              data-bodypart-key="${p.bodyPartKey || p.bodyPart || ""}"
              data-display-override="${p.label}">
              <span class="text-sm font-medium">${p.label}</span>
            </button>
          `
            )
            .join("")}
        </div>
      </div>
    `;
        })
        .join("");
    }

    /**
     * Find button (desktop)
     */
    if (findButton) {
      findButton.addEventListener("click", () => {
        const query = searchInput.value.trim();
        if (query.length >= 2) {
          window.searchManager.search(query);
        } else {
          window.searchManager.openDropdown();
        }
      });
    }

    /**
     * Subscribe to state updates
     */
    if (!isSubscribed) {
      let previousStep = 1;

      window.searchManager.subscribe((state) => {
        if (DEBUG)
          console.log("[SearchStep1] state:", {
            step: state.currentStep,
            selected: state.selectedProcedure?.label,
          });

        // Update input when a procedure is chosen
        if (state.selectedProcedure && state.currentStep === 2) {
          searchInput.value = state.selectedProcedure.label;
        }

        // Clear input only when going from step2 → step1
        if (state.currentStep === 1 && previousStep === 2) {
          searchInput.value = "";
        }

        // Update aria
        searchInput.setAttribute(
          "aria-expanded",
          state.isDropdownOpen ? "true" : "false"
        );

        // Toggle step visibility
        const step1Container = document.getElementById("search-step-1");
        if (step1Container) {
          if (state.currentStep === 1) {
            step1Container.classList.remove("hidden");
          } else {
            step1Container.classList.add("hidden");
          }
        }

        previousStep = state.currentStep;
      });

      isSubscribed = true;
      if (DEBUG) console.log("[SearchStep1] subscribed");
    }

    if (DEBUG) console.log("[SearchStep1] ready");
  }

  // DOM ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSearchStep1);
  } else {
    initializeSearchStep1();
  }

  // Astro page transitions
  document.addEventListener("astro:page-load", initializeSearchStep1);
</script>
