---
/**
 * SearchStep2.astro
 *
 * ZIP code input component (Step 2 of the hero search flow)
 */

interface Props {
  remixUrl: string;
}

// Use environment variable for cross-app routing (local + production)
const remixUrl = import.meta.env.PUBLIC_REMIX_URL;
---

<!-- STEP 2: ZIP Code Input (Hidden Initially) -->
<div
  id="search-step-2"
  class="hidden relative z-50 max-w-4xl mx-auto mb-16 sm:mb-24 transition-all duration-500"
  data-aos="fade-up"
  data-aos-delay="300"
>
  <form action={`${remixUrl}/pbs/search`} method="GET">
    <!-- Compact Horizontal Row -->
    <div
      class="bg-white/90 backdrop-blur-md border-2 border-white/60 shadow-lg rounded-xl overflow-hidden"
    >
      <!-- Mobile: Stack Vertically -->
      <div class="flex flex-col sm:hidden">
        <!-- Selected Procedure Pill - Mobile -->
        <div class="p-4 border-b border-gray-200">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 flex-1 min-w-0">
              <div
                id="checkmark-mobile"
                class="flex-shrink-0 w-8 h-8 checkmark-gradient rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-5 h-5 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-medium text-gray-500 mb-0.5">Selected</p>
                <p
                  id="selected-procedure-display-mobile"
                  class="text-sm font-semibold text-gray-900 truncate"
                >
                </p>
              </div>
            </div>
            <button
              type="button"
              id="change-procedure-button-mobile"
              class="flex-shrink-0 flex items-center gap-1 text-xs font-medium text-[#003087] hover:text-[#cc9933] transition-colors px-3 py-1.5 rounded-lg hover:bg-gray-100"
            >
              <svg
                id="change-arrow-mobile"
                class="w-3 h-3"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                ></path>
              </svg>
              Change
            </button>
          </div>
        </div>

        <!-- ZIP Input - Mobile -->
        <div class="relative p-3 border-b border-gray-200">
          <label
            for="hero-zip-input-mobile"
            class="block text-xs font-medium text-gray-500 mb-2"
          >
            ZIP Code
          </label>
          <div class="relative">
            <input
              type="text"
              id="hero-zip-input-mobile"
              name="zip"
              placeholder="Enter ZIP code"
              inputmode="numeric"
              pattern="[0-9]{5}"
              maxlength="5"
              class="w-full px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 border border-gray-300 rounded-lg focus:outline-none focus:border-[#003087] focus:ring-2 focus:ring-[#003087]/20 transition-all pr-10"
            />
            <button
              type="button"
              id="hero-detect-location-mobile"
              class="absolute inset-y-0 right-0 pr-3 flex items-center text-[#003087] hover:text-[#cc9933] transition-all"
              title="Detect location"
            >
              <svg
                id="location-icon-mobile"
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                ></path>
              </svg>
              <svg
                id="location-loading-mobile"
                class="w-5 h-5 animate-spin hidden"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                ></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Submit Button - Mobile -->
        <div class="p-3 relative">
          <button
            type="submit"
            id="hero-search-button-mobile"
            class="w-full bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-5 py-3 rounded-lg font-bold text-sm transition-all duration-300 hover:brightness-110 hover:shadow-lg hover:from-[#d7a53f] hover:to-[#b98c2f] disabled:opacity-50 disabled:cursor-not-allowed"
            disabled
          >
            <span class="flex items-center justify-center gap-2 relative z-10">
              <span id="button-text-mobile">Find Centers</span>
              <svg
                class="w-5 h-5 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </span>
          </button>
        </div>
      </div>

      <!-- Desktop: Horizontal Layout -->
      <div
        class="hidden sm:flex items-stretch bg-white/90 backdrop-blur-md rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.04)] border border-gray-200 overflow-hidden w-full max-w-4xl mx-auto"
      >
        <!-- Selected Procedure -->
        <div
          class="flex flex-col justify-center flex-1 px-6 py-3 border-r border-gray-200"
        >
          <div class="flex items-center gap-3">
            <div
              id="checkmark-desktop"
              class="flex-shrink-0 w-10 h-10 checkmark-gradient rounded-full flex items-center justify-center shadow-sm"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="3"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>

            <div class="flex-1 min-w-0">
              <p class="text-xs font-medium text-gray-500 mb-0.5">
                Selected Procedure
              </p>
              <p
                id="selected-procedure-display"
                class="text-base font-semibold text-gray-900 truncate"
              >
              </p>
              <p class="text-xs text-gray-500 mt-1 leading-snug">
                You'll compare prices and book instantly — no payment until
                appointment is confirmed.
              </p>
            </div>

            <button
              type="button"
              id="change-procedure-button"
              class="flex-shrink-0 flex items-center gap-1.5 text-[#003087] hover:text-[#cc9933] font-medium text-sm transition-all px-3 py-1.5 rounded-lg hover:bg-gray-100"
            >
              <svg
                id="change-arrow-desktop"
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                ></path>
              </svg>
              Change
            </button>
          </div>
        </div>

        <!-- ZIP Input -->
        <div
          class="flex flex-col justify-center px-6 py-3 border-r border-gray-200 min-w-[180px]"
        >
          <label
            for="hero-zip-input"
            class="block text-xs font-medium text-gray-500 mb-1"
          >
            ZIP Code
          </label>
          <div class="relative">
            <input
              type="text"
              id="hero-zip-input"
              name="zip"
              placeholder="12345"
              inputmode="numeric"
              pattern="[0-9]{5}"
              maxlength="5"
              class="w-full px-3 py-2 text-center text-lg font-semibold text-gray-900 placeholder-gray-400 border border-gray-300 rounded-lg focus:outline-none focus:border-[#003087] focus:ring-2 focus:ring-[#003087]/20 transition-all"
            />
            <button
              type="button"
              id="hero-detect-location"
              class="absolute right-2 top-1/2 -translate-y-1/2 text-[#003087] hover:text-[#cc9933] transition-transform hover:scale-110"
              title="Detect location"
            >
              <svg
                id="location-icon"
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                ></path>
              </svg>
              <svg
                id="location-loading"
                class="w-5 h-5 animate-spin hidden"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                ></path>
              </svg>
            </button>
          </div>
          <p id="zip-hint" class="text-gray-500 text-xs mt-1">
            Enter ZIP to continue
          </p>
        </div>

        <!-- Find Centers Button -->
        <div class="flex items-center justify-center p-3.5">
          <button
            type="submit"
            id="hero-search-button"
            class="relative h-full bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-6 py-3.5 font-bold text-lg transition-all duration-300 hover:brightness-110 hover:shadow-lg hover:from-[#d7a53f] hover:to-[#b98c2f] disabled:opacity-50 disabled:cursor-not-allowed overflow-hidden group rounded-lg"
            disabled
          >
            <span class="flex items-center justify-center gap-2 relative z-10">
              <span id="button-text">Find Centers</span>
              <svg
                class="w-5 h-5 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </span>
          </button>
        </div>
      </div>

      <!-- Hidden Form Fields -->
      <input type="hidden" id="cpt-code-hidden" name="cpt" value="" />
      <input
        type="hidden"
        id="procedure-name-hidden"
        name="procedureSearch"
        value=""
      />
    </div>
  </form>
</div>

<style>
  .fade-in-step {
    animation: fadeInStep 0.25s ease-out;
  }

  .fade-out-step {
    animation: fadeOutStep 0.25s ease-out;
  }

  @keyframes fadeInStep {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeOutStep {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  /* ✨ NEW: Checkmark pulse animation */
  @keyframes checkmarkPulse {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    50% {
      transform: scale(1.1);
      box-shadow: 0 0 0 8px rgba(34, 197, 94, 0.3);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 16px rgba(34, 197, 94, 0);
    }
  }

  .checkmark-pulse {
    animation: checkmarkPulse 0.6s ease-out forwards;
    background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%) !important;
  }

  /* ✨ NEW: Label fade-in animation */
  @keyframes labelFadeIn {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .label-fade-in {
    animation: labelFadeIn 0.4s ease-out;
  }

  /* ✨ NEW: Gradient background for checkmark */
  .checkmark-gradient {
    background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  }

  /* ✨ NEW: 180° rotate animation for change button arrow */
  @keyframes rotateArrow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(180deg);
    }
  }

  .rotate-arrow {
    animation: rotateArrow 0.4s ease-in-out;
  }

  /* ✨ Progressive button states */
  @keyframes readyPulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(204, 153, 51, 0.4);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(204, 153, 51, 0);
    }
  }

  /* Button ready state - when ZIP is valid */
  #hero-search-button-mobile.button-ready {
    animation: readyPulse 2s infinite;
    box-shadow: 0 4px 12px rgba(204, 153, 51, 0.3);
  }

  /* Typing state - gentle pulse on border */
  #hero-zip-input-mobile.zip-typing {
    border-color: #cc9933;
    box-shadow: 0 0 0 3px rgba(204, 153, 51, 0.1);
    transition: all 0.3s ease;
  }

  /* Valid ZIP - green border */
  #hero-zip-input-mobile.zip-valid {
    border-color: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
  }

  /* ✨ Pin bounce animation */
  @keyframes pinBounce {
    0%,
    100% {
      transform: translateY(0);
    }
    25% {
      transform: translateY(-6px);
    }
    50% {
      transform: translateY(0);
    }
    75% {
      transform: translateY(-3px);
    }
  }

  .pin-bouncing {
    animation: pinBounce 0.6s ease-in-out;
  }
</style>

<script>
  // Debug flag - set to false for production
  const DEBUG = false;

  // TEMP VALIDATION — confirm Remix URL wiring
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("hero-search-form");
    if (form) {
      console.log("🔗 PUBLIC_REMIX_URL:", import.meta.env.PUBLIC_REMIX_URL);
      console.log("🔗 Form action:", form.action);
    }
  });

  let isSubscribed = false;

  /**
   * Wait until window.searchManager is ready
   */
  function waitForSearchManager(callback) {
    if (
      window.searchManager &&
      typeof window.searchManager.subscribe === "function"
    ) {
      callback(window.searchManager);
      return;
    }

    if (DEBUG) {
      console.log("[SearchStep2] Waiting for searchManager...");
    }

    setTimeout(() => waitForSearchManager(callback), 50);
  }

  /**
   * Main initializer for Step 2
   */
  function initializeSearchStep2() {
    waitForSearchManager((searchManager) => {
      const step1 = document.getElementById("search-step-1");
      const step2 = document.getElementById("search-step-2");

      const changeBtn = document.getElementById("change-procedure-button");
      const changeBtnMobile = document.getElementById(
        "change-procedure-button-mobile"
      );

      const zipInput = document.getElementById("hero-zip-input");
      const zipInputMobile = document.getElementById("hero-zip-input-mobile");

      const detectBtn = document.getElementById("hero-detect-location");
      const detectBtnMobile = document.getElementById(
        "hero-detect-location-mobile"
      );

      const locationIcon = document.getElementById("location-icon");
      const locationIconMobile = document.getElementById(
        "location-icon-mobile"
      );
      const locationLoading = document.getElementById("location-loading");
      const locationLoadingMobile = document.getElementById(
        "location-loading-mobile"
      );

      const submitBtn = document.getElementById("hero-search-button");
      const submitBtnMobile = document.getElementById(
        "hero-search-button-mobile"
      );

      const procedureDisplay = document.getElementById(
        "selected-procedure-display"
      );
      const procedureDisplayMobile = document.getElementById(
        "selected-procedure-display-mobile"
      );

      const cptHidden = document.getElementById("cpt-code-hidden");
      const procedureHidden = document.getElementById("procedure-name-hidden");

      const zipHint = document.getElementById("zip-hint");

      if (DEBUG) console.log("✅ SearchStep2: Initializing...");

      /**
       * Helper: check if form is ready to submit
       */
      function checkFormReady() {
        const hasCpt =
          cptHidden && cptHidden.value && cptHidden.value.length > 0;

        const zipValue =
          (zipInput && zipInput.value) ||
          (zipInputMobile && zipInputMobile.value) ||
          "";
        const hasZip = zipValue.length === 5 && /^\d{5}$/.test(zipValue);
        const isReady = hasCpt && hasZip;

        if (submitBtn) submitBtn.disabled = !isReady;
        if (submitBtnMobile) submitBtnMobile.disabled = !isReady;

        if (zipHint) {
          if (hasZip) {
            zipHint.textContent = "Ready to search!";
            zipHint.classList.add("text-green-600");
            zipHint.classList.remove("text-gray-500");
          } else {
            zipHint.textContent = "Enter ZIP to continue";
            zipHint.classList.add("text-gray-500");
            zipHint.classList.remove("text-green-600");
          }
        }
      }

      /**
       * Transition back to Step 1 (Change procedure)
       */
      function transitionToStep1() {
        if (!step1 || !step2) return;

        if (DEBUG) console.log("SearchStep2: Transitioning to Step 1");

        step2.classList.add("fade-out-step");

        setTimeout(() => {
          step2.classList.add("hidden");
          step2.classList.remove("fade-out-step");

          step1.classList.remove("hidden");
          step1.classList.add("fade-in-step");

          // Set state to Step 1 BEFORE focusing to avoid race conditions
          searchManager.setState({ currentStep: 1 });

          const searchInput = document.getElementById("hero-search-input");

          // Focus the input (this will trigger modal or dropdown based on screen size)
          if (searchInput) {
            searchInput.focus();
          }

          const isMobile = window.innerWidth < 768;
          if (!isMobile) {
            searchManager.openDropdown();
            if (DEBUG) {
              console.log(
                "[SearchStep2] Transitioned to Step 1 with dropdown open (desktop)"
              );
            }
          } else {
            if (DEBUG) {
              console.log(
                "[SearchStep2] Transitioned to Step 1, modal will open via focus (mobile)"
              );
            }
          }
        }, 250);
      }

      /**
       * Change procedure button (desktop)
       */
      if (changeBtn) {
        changeBtn.addEventListener("click", () => {
          const arrow = document.getElementById("change-arrow-desktop");
          if (arrow) {
            arrow.classList.remove("rotate-arrow");
            void arrow.offsetWidth;
            arrow.classList.add("rotate-arrow");
            setTimeout(() => {
              arrow.classList.remove("rotate-arrow");
            }, 400);
          }

          transitionToStep1();
        });
      }

      /**
       * Change procedure button (mobile)
       */
      if (changeBtnMobile) {
        changeBtnMobile.addEventListener("click", () => {
          const arrow = document.getElementById("change-arrow-mobile");
          if (arrow) {
            arrow.classList.remove("rotate-arrow");
            void arrow.offsetWidth;
            arrow.classList.add("rotate-arrow");
            setTimeout(() => {
              arrow.classList.remove("rotate-arrow");
            }, 400);
          }

          transitionToStep1();
        });
      }

      /**
       * ZIP input handling (desktop + mobile)
       */
      [zipInput, zipInputMobile].filter(Boolean).forEach((inputEl) => {
        inputEl.addEventListener("input", function (e) {
          const target = e.target;
          const value = target.value || "";
          const cleaned = value.replace(/\D/g, "");
          target.value = cleaned;

          if (zipInput && zipInput !== target) zipInput.value = cleaned;
          if (zipInputMobile && zipInputMobile !== target)
            zipInputMobile.value = cleaned;

          const length = cleaned.length;

          if (zipInputMobile) {
            zipInputMobile.classList.remove("zip-typing", "zip-valid");
          }
          if (submitBtnMobile) {
            submitBtnMobile.classList.remove("button-ready");
          }

          if (length > 0 && length < 5) {
            if (zipInputMobile) zipInputMobile.classList.add("zip-typing");
          } else if (length === 5) {
            if (zipInputMobile) zipInputMobile.classList.add("zip-valid");
            if (submitBtnMobile) submitBtnMobile.classList.add("button-ready");
          }

          searchManager.setZipCode(cleaned);
          checkFormReady();
        });
      });

      /**
       * Detect location → fetch ZIP
       */
      async function detectLocation() {
        if (DEBUG) console.log("SearchStep2: Detecting location...");

        if (locationIcon) locationIcon.classList.add("hidden");
        if (locationIconMobile) locationIconMobile.classList.add("hidden");
        if (locationLoading) locationLoading.classList.remove("hidden");
        if (locationLoadingMobile)
          locationLoadingMobile.classList.remove("hidden");

        try {
          const position = await new Promise((resolve, reject) => {
            if (!navigator.geolocation) {
              reject(new Error("Geolocation not supported"));
              return;
            }

            navigator.geolocation.getCurrentPosition(resolve, reject, {
              timeout: 5000,
              maximumAge: 300000,
            });
          });

          const lat = position.coords.latitude;
          const lng = position.coords.longitude;

          if (DEBUG) console.log("SearchStep2: Got coordinates", { lat, lng });

          const response = await fetch(`/api/geocode?lat=${lat}&lng=${lng}`);
          const data = await response.json();

          if (data.postalCode) {
            if (zipInput) zipInput.value = data.postalCode;
            if (zipInputMobile) zipInputMobile.value = data.postalCode;

            searchManager.setZipCode(data.postalCode);

            if (zipHint) {
              zipHint.textContent = `Detected your location${
                data.city ? ` in ${data.city}` : ""
              }`;
              zipHint.classList.add("text-green-600");
              zipHint.classList.remove("text-gray-500");
            }

            checkFormReady();

            if (DEBUG)
              console.log("✅ Location detected", {
                zip: data.postalCode,
                city: data.city,
              });
          } else {
            throw new Error("No postal code found");
          }
        } catch (error) {
          console.error("❌ Location detection error:", error);

          let errorMessage = "Could not detect location • Enter ZIP manually";

          if (error && typeof error === "object" && "code" in error) {
            if (error.code === error.PERMISSION_DENIED) {
              errorMessage = "Location permission denied • Enter ZIP manually";
            } else if (error.code === error.TIMEOUT) {
              errorMessage = "Location timeout • Enter ZIP manually";
            }
          }

          if (zipHint) {
            zipHint.textContent = errorMessage;
            zipHint.classList.add("text-red-600");
            zipHint.classList.remove("text-gray-500", "text-green-600");
          }

          if (zipInput) zipInput.focus();
        } finally {
          if (locationIcon) locationIcon.classList.remove("hidden");
          if (locationIconMobile) locationIconMobile.classList.remove("hidden");
          if (locationLoading) locationLoading.classList.add("hidden");
          if (locationLoadingMobile)
            locationLoadingMobile.classList.add("hidden");
        }
      }

      if (detectBtn) {
        detectBtn.addEventListener("click", detectLocation);
      }

      if (detectBtnMobile) {
        detectBtnMobile.addEventListener("click", detectLocation);
      }

      const form = document.getElementById("hero-search-form");
      if (form) {
        form.addEventListener("submit", (e) => {
          if (DEBUG)
            console.log("SearchStep2: Form submitting", {
              cpt: cptHidden && cptHidden.value,
              procedure: procedureHidden && procedureHidden.value,
              zip:
                (zipInput && zipInput.value) ||
                (zipInputMobile && zipInputMobile.value),
              action: form.action,
            });
        });
      }

      /**
       * Subscribe to SearchManager state
       */
      if (!isSubscribed) {
        searchManager.subscribe((state) => {
          if (DEBUG)
            console.log("SearchStep2: State update", {
              currentStep: state.currentStep,
              selectedProcedure: state.selectedProcedure
                ? state.selectedProcedure.label
                : null,
              zipCode: state.zipCode,
            });

          if (state.selectedProcedure) {
            const label = state.selectedProcedure.label;
            const cptCode =
              state.selectedProcedure.cptCode ||
              state.selectedProcedure.cpt ||
              "";

            if (procedureDisplay && procedureDisplay.textContent !== label) {
              procedureDisplay.textContent = label;
              procedureDisplay.classList.add("label-fade-in");
              setTimeout(() => {
                procedureDisplay.classList.remove("label-fade-in");
              }, 400);
            }

            if (
              procedureDisplayMobile &&
              procedureDisplayMobile.textContent !== label
            ) {
              procedureDisplayMobile.textContent = label;
              procedureDisplayMobile.classList.add("label-fade-in");
              setTimeout(() => {
                procedureDisplayMobile.classList.remove("label-fade-in");
              }, 400);
            }

            const checkmarkDesktop =
              document.getElementById("checkmark-desktop");
            const checkmarkMobile = document.getElementById("checkmark-mobile");

            const lastProcedure =
              (checkmarkDesktop &&
                checkmarkDesktop.getAttribute("data-last-procedure")) ||
              "";
            const currentProcedure = label || "";

            if (currentProcedure !== lastProcedure) {
              if (checkmarkDesktop) {
                checkmarkDesktop.setAttribute(
                  "data-last-procedure",
                  currentProcedure
                );
                checkmarkDesktop.classList.remove("checkmark-pulse");
                void checkmarkDesktop.offsetWidth;
                checkmarkDesktop.classList.add("checkmark-pulse");
                setTimeout(() => {
                  checkmarkDesktop.classList.remove("checkmark-pulse");
                }, 600);
              }

              if (checkmarkMobile) {
                checkmarkMobile.setAttribute(
                  "data-last-procedure",
                  currentProcedure
                );
                checkmarkMobile.classList.remove("checkmark-pulse");
                void checkmarkMobile.offsetWidth;
                checkmarkMobile.classList.add("checkmark-pulse");
                setTimeout(() => {
                  checkmarkMobile.classList.remove("checkmark-pulse");
                }, 600);
              }
            }

            if (cptHidden) {
              cptHidden.value = cptCode;
              if (DEBUG)
                console.log("🔍 CPT code set:", {
                  cptCode,
                  cptHiddenValue: cptHidden.value,
                  hasValue: cptHidden.value.length > 0,
                });
            }
            if (procedureHidden) procedureHidden.value = label;

            if (DEBUG)
              console.log("✅ Procedure display updated", { label, cptCode });
          }

          if (state.zipCode) {
            if (zipInput) zipInput.value = state.zipCode;
            if (zipInputMobile) zipInputMobile.value = state.zipCode;
          }

          const step2Container = document.getElementById("search-step-2");
          if (step2Container) {
            if (state.currentStep === 2) {
              step2Container.classList.remove("hidden");

              const isMobile = window.innerWidth < 768;
              if (isMobile && zipInputMobile) {
                setTimeout(() => {
                  zipInputMobile.focus();
                }, 300);
              } else if (!isMobile && zipInput) {
                setTimeout(() => {
                  zipInput.focus();
                }, 300);
              }
            } else {
              step2Container.classList.add("hidden");
            }
          }

          checkFormReady();
        });

        isSubscribed = true;
        if (DEBUG) console.log("✅ SearchStep2: Subscribed to SearchManager");
      }

      if (DEBUG) console.log("✅ SearchStep2: Initialization complete");
    });
  }

  // Initialize on DOM ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSearchStep2);
  } else {
    initializeSearchStep2();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener("astro:page-load", initializeSearchStep2);
</script>
