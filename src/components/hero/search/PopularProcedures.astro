---
/**
 * PopularProcedures.astro
 * ========================
 * Displays curated list of popular procedures when search query is empty.
 *
 * PURPOSE:
 * - Shows 22 popular procedures by default
 * - Groups procedures by modality (MRI, CT, X-Ray, Ultrasound)
 * - Provides quick access to common procedures
 * - Subscribes to SearchManager for reactive updates
 *
 * DEPENDENCIES:
 * - window.searchManager (global instance from HeroSection)
 * - window.ProcedureLibrary (loaded from /js/procedure-data.js)
 *
 * BEHAVIOR:
 * - Visible when query === '' (empty search)
 * - Hidden when query.length >= 2 (search active)
 * - Handles procedure selection via SearchManager
 * - Unsubscribes on component cleanup
 *
 * STRUCTURE:
 * - Header with title and "Curated by USRad" badge
 * - Scrollable list with groups by modality
 * - Each procedure clickable with hover effects
 * - Gentle fade at bottom for scroll indication
 */
---

<!-- Popular Procedures Container -->
<div id="popular-procedures-section" class="hidden relative">
  <!-- 
    Header Section
    ==============
    - Gold gradient background for premium feel
    - Star emoji for visual interest
    - "Curated by USRad" badge for trust
  -->
  <div
    class="px-4 py-3 bg-gradient-to-r from-[#fff5e3] via-[#fffaf5] to-white border-b border-[#f5e4c3] flex items-center justify-between"
  >
    <div>
      <h3 class="text-sm font-semibold text-[#b8862d] flex items-center gap-2">
        ⭐ Popular Procedures
      </h3>
      <p class="text-xs text-gray-500 mt-0.5">Or start typing to search...</p>
    </div>
    <span class="text-xs text-[#b8862d]/80 font-medium">Curated by USRad</span>
  </div>

  <!-- 
    Scrollable List Container
    =========================
    - max-h-[420px]: Maximum height before scrolling
    - Custom scrollbar styling applied via CSS
    - overflow-y-auto: Scrolls when content exceeds height
  -->
  <div
    id="popular-procedures-list"
    class="overflow-y-auto max-h-[420px] px-3 py-2.5"
  >
    <!-- Procedures will be rendered here by JavaScript -->
  </div>

  <!-- 
    Fade Indicator
    ==============
    Gentle gradient at bottom to indicate more content below
    - pointer-events-none: Doesn't interfere with clicking
    - Fades from white to transparent
  -->
  <div
    class="pointer-events-none absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-white to-transparent rounded-b-xl"
  >
  </div>
</div>

<script>
  const DEBUG = false;

  /**
   * Helper: Fix character encoding issues
   * (Inline version - no import needed)
   */
  function fixCharacterEncoding(text: string): string {
    if (!text || typeof text !== "string") return text;

    const ENCODING_MAP: Record<string, string> = {
      "\xE2\x80\x93": "\u2013",
      "\xE2\x80\x94": "\u2014",
      "\xE2\x80\x9C": "\u201C",
      "\xE2\x80\x9D": "\u201D",
      "\xE2\x80\x98": "\u2018",
      "\xE2\x80\x99": "\u2019",
      "\xE2\x80\xA2": "\u2022",
      "\xC2\xA0": "\u00A0",
    };

    let fixed = text;
    for (const [bad, good] of Object.entries(ENCODING_MAP)) {
      fixed = fixed.split(bad).join(good);
    }
    return fixed;
  }

  /**
   * Initialize PopularProcedures
   */
  function initPopularProcedures() {
    // Wait for window.searchManager and window.ProcedureLibrary
    if (!window.searchManager || !window.ProcedureLibrary) {
      setTimeout(initPopularProcedures, 50);
      return;
    }

    const container = document.getElementById("popular-procedures-section");
    const listContainer = document.getElementById("popular-procedures-list");

    if (!container || !listContainer) {
      console.warn("PopularProcedures: missing container elements");
      return;
    }

    if (DEBUG) console.log("⭐ PopularProcedures: initializing…");

    /**
     * ████████████████████████████████████████
     *   SUBSCRIBE TO SEARCH MANAGER
     * ████████████████████████████████████████
     */
    window.searchManager.subscribe((state) => {
      const query = state.currentQuery || "";

      if (DEBUG)
        console.log("⭐ PopularProcedures: state", {
          query,
          shouldShow: query.length < 2,
        });

      // Show only when no active query
      if (!query || query.length < 2) {
        container.classList.remove("hidden");
        renderPopular();
      } else {
        container.classList.add("hidden");
      }
    });

    /**
     * ████████████████████████████████████████
     *   RENDER POPULAR PROCEDURES
     * ████████████████████████████████████████
     */
    function renderPopular() {
      const lib = window.ProcedureLibrary;

      let popular = lib?.Popular || [];

      // Allow both array and {region: {procedures: []}} objects
      if (!Array.isArray(popular) && typeof popular === "object") {
        popular = Object.values(popular)
          .filter((x) => x?.procedures)
          .flatMap((x) => x.procedures);
      }

      popular = popular || [];

      if (DEBUG)
        console.log(`⭐ PopularProcedures: rendering ${popular.length} items`);

      if (popular.length === 0) {
        listContainer.innerHTML = `
          <div class="text-center py-8 text-gray-500 text-sm">
            Loading popular procedures…
          </div>
        `;
        return;
      }

      listContainer.innerHTML = renderGroupedProcedures(popular);
      attachClickHandlers();
    }

    /**
     * ████████████████████████████████████████
     *   GROUP + RENDER
     * ████████████████████████████████████████
     */
    function renderGroupedProcedures(procedures) {
      const groups = {};

      procedures.forEach((p) => {
        const m = p.modality || "Other";
        if (!groups[m]) groups[m] = [];
        groups[m].push(p);
      });

      const order = ["MRI", "CT", "X-Ray", "Ultrasound", "Other"];
      const ICONS = {
        MRI: "🧠",
        CT: "🦴",
        "X-Ray": "👀",
        Ultrasound: "🩺",
        Other: "📋",
      };

      return order
        .map((mod) => {
          const group = groups[mod];
          if (!group || group.length === 0) return "";

          return `
          <div class="mb-4 border border-gray-100 rounded-lg overflow-hidden shadow-sm">
            <div class="sticky top-0 z-10 px-4 py-2 bg-gradient-to-r from-[#fff8ee] to-white border-b border-[#f5e4c3] flex items-center justify-between backdrop-blur-sm">
              <h4 class="text-sm font-semibold text-[#b8862d]">
                ${ICONS[mod] || "📋"} ${mod}
              </h4>
              <span class="text-xs text-gray-500">${group.length} procedures</span>
            </div>

            <div class="divide-y divide-gray-100 max-h-[220px] overflow-y-auto">
              ${group.map(renderButton).join("")}
            </div>
          </div>
        `;
        })
        .join("");
    }

    /**
     * ████████████████████████████████████████
     *   RENDER SINGLE PROCEDURE BUTTON
     * ████████████████████████████████████████
     */
    function renderButton(proc) {
      const cleanLabel = fixCharacterEncoding(proc.label);
      const cpt = proc.cpt || proc.cptCode || "";

      return `
        <button
          type="button"
          class="w-full text-left flex items-center justify-between px-4 py-2.5 hover:bg-gray-50 cursor-pointer transition procedure-result"
          data-cpt="${cpt}"
          data-label="${cleanLabel}"
          data-modality="${proc.modality || ""}"
          data-bodypart="${proc.bodyPart || ""}"
        >
          <span class="text-[15px] font-medium text-gray-900">${cleanLabel}</span>
          <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-700">
            ${proc.modality || "Scan"}
          </span>
        </button>
      `;
    }

    /**
     * ████████████████████████████████████████
     *   CLICK HANDLERS — SELECT PROCEDURE
     * ████████████████████████████████████████
     */
    function attachClickHandlers() {
      listContainer.querySelectorAll(".procedure-result").forEach((btn) => {
        btn.addEventListener("click", () => {
          const selected = {
            cptCode: btn.getAttribute("data-cpt") || "",
            label: btn.getAttribute("data-label") || "",
            modality: btn.getAttribute("data-modality") || "",
            bodyPart: btn.getAttribute("data-bodypart") || "",
          };

          if (DEBUG) console.log("⭐ PopularProcedures: selecting", selected);

          window.searchManager.selectProcedure(selected);
        });
      });
    }

    if (DEBUG) console.log("⭐ PopularProcedures: ready");
  }

  // DOM Ready & Astro navigation support
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPopularProcedures);
  } else {
    initPopularProcedures();
  }

  document.addEventListener("astro:page-load", initPopularProcedures);
</script>

<style>
  /**
   * Custom Scrollbar Styling
   * ========================
   * Gold/bronze theme matching brand colors
   */

  /* WebKit browsers (Chrome, Safari, Edge) */
  #popular-procedures-list::-webkit-scrollbar {
    width: 12px;
  }

  #popular-procedures-list::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
  }

  #popular-procedures-list::-webkit-scrollbar-thumb {
    background: #b8862d; /* Brand gold */
    border-radius: 10px;
    border: 2px solid #ffffff;
  }

  #popular-procedures-list::-webkit-scrollbar-thumb:hover {
    background: #996d24; /* Darker gold on hover */
  }

  /* Firefox */
  #popular-procedures-list {
    scrollbar-width: auto;
    scrollbar-color: #b8862d #f1f1f1;
  }

  /* Nested scrollbars (for group lists) */
  #popular-procedures-list .overflow-y-auto::-webkit-scrollbar {
    width: 8px;
  }

  #popular-procedures-list .overflow-y-auto::-webkit-scrollbar-track {
    background: #f9f9f9;
    border-radius: 8px;
  }

  #popular-procedures-list .overflow-y-auto::-webkit-scrollbar-thumb {
    background: #d4a855;
    border-radius: 8px;
    border: 1px solid #ffffff;
  }
</style>
