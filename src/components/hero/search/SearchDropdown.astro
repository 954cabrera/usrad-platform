---
/**
 * SearchDropdown.astro
 *
 * Desktop search dropdown container that orchestrates:
 * - PopularProcedures (when query is empty)
 * - SearchResults (when query has 2+ chars)
 * - Empty state (when query has 2+ chars but no results)
 *
 * CRITICAL FEATURES:
 * 1. Blur ONLY sections BELOW hero (not hero itself)
 * 2. Scroll lock with padding compensation
 * 3. Backdrop element for click-outside handling
 * 4. Fixed positioning relative to search input
 * 5. Event handlers (click outside, Escape, resize)
 *
 * DEPENDENCIES:
 * - window.searchManager (provided by HeroSection.astro initialization)
 * - PopularProcedures.astro and SearchResults.astro (both also use window.searchManager)
 */

// Import search subcomponents
import PopularProcedures from "./PopularProcedures.astro";
import SearchResults from "../SearchResults.astro";
---

<!-- Backdrop element (click-outside detection ONLY - no visual effect) -->
<div
  id="search-backdrop"
  class="hidden fixed inset-0 pointer-events-auto transition-opacity duration-300"
  style="z-index: 9999998;"
  aria-hidden="true"
>
</div>

<!-- Search dropdown container (fixed positioning) -->
<div
  id="search-dropdown"
  class="hidden fixed bg-white shadow-2xl rounded-lg overflow-hidden border border-gray-200"
  style="z-index: 9999999; max-height: 600px;"
>
  <!-- Content container with custom scrollbar -->
  <div class="overflow-y-auto h-full search-dropdown-scroll">
    <!-- Popular Procedures (shown when query is empty) -->
    <div id="popular-procedures-container">
      <PopularProcedures />
    </div>

    <!-- Search Results (shown when query >= 2 chars AND results exist) -->
    <div id="search-results-container" class="hidden">
      <SearchResults />
    </div>

    <!-- Empty State (shown when query >= 2 chars AND no results) -->
    <div id="empty-state-container" class="hidden">
      <div class="p-8 text-center">
        <svg
          class="mx-auto h-12 w-12 text-gray-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          ></path>
        </svg>
        <h3 class="mt-4 text-lg font-medium text-gray-900">
          No procedures found
        </h3>
        <p class="mt-2 text-sm text-gray-500">
          Try searching for a different procedure or body part.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  /* Custom scrollbar styling */
  .search-dropdown-scroll {
    scrollbar-width: thin;
    scrollbar-color: #b8862d #f3f4f6;
  }

  .search-dropdown-scroll::-webkit-scrollbar {
    width: 8px;
  }

  .search-dropdown-scroll::-webkit-scrollbar-track {
    background: #f3f4f6;
  }

  .search-dropdown-scroll::-webkit-scrollbar-thumb {
    background-color: #b8862d;
    border-radius: 4px;
  }

  .search-dropdown-scroll::-webkit-scrollbar-thumb:hover {
    background-color: #cc9933;
  }
</style>

<script>
  const DEBUG = false;

  let scrollLockPadding = 0;

  function initSearchDropdown() {
    const dropdown = document.getElementById("search-dropdown");
    const backdrop = document.getElementById("search-backdrop");
    const searchInput = document.getElementById("hero-search-input");

    const popularContainer = document.getElementById(
      "popular-procedures-container"
    );
    const resultsContainer = document.getElementById(
      "search-results-container"
    );
    const emptyContainer = document.getElementById("empty-state-container");

    if (!dropdown || !backdrop || !searchInput) {
      console.warn("SearchDropdown: Missing elements");
      return;
    }

    // Wait for searchManager (provided by HeroSection.astro)
    if (!window.searchManager) {
      if (DEBUG) console.log("SearchDropdown: waiting for searchManager...");
      setTimeout(initSearchDropdown, 75);
      return;
    }

    if (DEBUG) console.log("[SearchDropdown] initializing");

    /**
     * Position dropdown relative to input
     */
    function positionDropdown() {
      const rect = searchInput.getBoundingClientRect();
      const scrollOffset =
        document.body.style.position === "fixed"
          ? Math.abs(parseInt(document.body.style.top || "0"))
          : 0;

      dropdown.style.width = `${rect.width}px`;
      dropdown.style.top = `${rect.bottom + scrollOffset + 8}px`;
      dropdown.style.left = `${rect.left}px`;
    }

    /**
     * OPEN dropdown (desktop only)
     */
    function openDropdown() {
      if (!dropdown.classList.contains("hidden")) return;

      // Scroll lock
      scrollLockPadding =
        window.innerWidth - document.documentElement.clientWidth;

      document.body.style.overflow = "hidden";
      document.body.style.position = "fixed";
      document.body.style.top = `-${window.scrollY}px`;
      document.body.style.width = "100%";

      if (scrollLockPadding > 0) {
        document.body.style.paddingRight = `${scrollLockPadding}px`;
      }

      backdrop.classList.remove("hidden");
      dropdown.classList.remove("hidden");

      positionDropdown();
      blurSectionsBelow();

      if (DEBUG) console.log("SearchDropdown: opened");
    }

    /**
     * CLOSE dropdown
     */
    function closeDropdown() {
      if (dropdown.classList.contains("hidden")) return;

      const scrollY = document.body.style.top;

      document.body.style.overflow = "";
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.width = "";
      document.body.style.paddingRight = "";

      window.scrollTo(0, parseInt(scrollY || "0") * -1);

      backdrop.classList.add("hidden");
      dropdown.classList.add("hidden");

      unblurSectionsBelow();

      if (DEBUG) console.log("SearchDropdown: closed");
    }

    /**
     * Blur everything below hero section
     */
    function blurSectionsBelow() {
      const hero = document.getElementById("hero-section");
      if (!hero) return;

      let section = hero.nextElementSibling;
      while (section) {
        if (
          section.id === "search-dropdown" ||
          section.id === "search-backdrop" ||
          section.id === "mobile-search-modal"
        ) {
          section = section.nextElementSibling;
          continue;
        }

        section.style.filter = "blur(3px)";
        section.style.transition = "filter 0.25s ease";

        section = section.nextElementSibling;
      }
    }

    /**
     * Remove blurring
     */
    function unblurSectionsBelow() {
      const hero = document.getElementById("hero-section");
      if (!hero) return;

      let section = hero.nextElementSibling;
      while (section) {
        if (
          section.id === "search-dropdown" ||
          section.id === "search-backdrop"
        ) {
          section = section.nextElementSibling;
          continue;
        }

        section.style.filter = "";

        section = section.nextElementSibling;
      }
    }

    /**
     * Update what's visible inside the dropdown
     */
    function updateVisibility(state) {
      const hasQuery = state.currentQuery && state.currentQuery.length >= 2;
      const hasResults = state.searchResults?.length > 0;

      if (!hasQuery) {
        popularContainer?.classList.remove("hidden");
        resultsContainer?.classList.add("hidden");
        emptyContainer?.classList.add("hidden");
      } else if (hasResults) {
        popularContainer?.classList.add("hidden");
        resultsContainer?.classList.remove("hidden");
        emptyContainer?.classList.add("hidden");

        // ✅ CRITICAL: Force SearchResults to re-render with new data
        // This bypasses the broken subscription mechanism
        const event = new CustomEvent("force-search-results-render", {
          detail: state,
        });
        document.dispatchEvent(event);
        console.log(
          "[SearchDropdown] Dispatched force-render event:",
          state.currentQuery,
          "results:",
          state.searchResults.length
        );
      } else {
        popularContainer?.classList.add("hidden");
        resultsContainer?.classList.add("hidden");
        emptyContainer?.classList.remove("hidden");
      }
    }

    /**
     * Subscribe to searchManager events
     */
    window.searchManager.subscribe((state) => {
      if (state.isDropdownOpen) openDropdown();
      else closeDropdown();

      updateVisibility(state);
    });

    /**
     * Click outside closes dropdown
     */
    backdrop.addEventListener("click", () => {
      window.searchManager.closeDropdown();
    });

    /**
     * ESC closes dropdown
     */
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") window.searchManager.closeDropdown();
    });

    /**
     * Reposition on resize
     */
    window.addEventListener("resize", () => {
      if (!dropdown.classList.contains("hidden")) {
        positionDropdown();
      }
    });

    if (DEBUG) console.log("[SearchDropdown] ready");
  }

  // Force re-initialization on every possible event
  function forceReinit() {
    console.log("[SearchDropdown] Force re-initializing...");
    // Small delay to ensure DOM is ready
    setTimeout(initSearchDropdown, 100);
  }

  // DOM ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", forceReinit);
  } else {
    forceReinit();
  }

  // Astro navigation
  document.addEventListener("astro:page-load", forceReinit);
  document.addEventListener("astro:after-swap", forceReinit);

  // Browser navigation (back/forward)
  window.addEventListener("pageshow", forceReinit);
  window.addEventListener("popstate", forceReinit);

  // Visibility change (tab switching)
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) {
      console.log(
        "[SearchDropdown] Tab became visible, checking subscription..."
      );
      forceReinit();
    }
  });
</script>
