---
export interface ProviderMarkerProps {
  provider: {
    id: string;
    facility_name: string;
    address: string;
    phone?: string;
    coordinates: { lat: number; lng: number };
    pricing: {
      patient_price: number;
      patient_savings: number;
      savings_percentage: number;
    };
    distance_miles?: number;
    availability: {
      available_slots: number;
    };
  };
  index: number;
  markerStyle?: "price" | "savings" | "simple";
  onClick?: string;
}

const {
  provider,
  index,
  markerStyle = "price",
  onClick = "selectProvider",
} = Astro.props;

const { pricing } = provider;
---

<!-- ===========================================
     src/components/map/ProviderMarker.astro
     Map marker logic and info windows
     =========================================== --><!-- This component provides the marker creation logic -->
<script define:vars={{ provider, index, markerStyle, onClick }}>
  // Marker creation function
  window.createProviderMarker = function (
    mapInstance,
    provider,
    index,
    options = {}
  ) {
    const { pricing, coordinates, facility_name } = provider;
    const position = {
      lat: parseFloat(coordinates.lat),
      lng: parseFloat(coordinates.lng),
    };

    // Validate coordinates
    if (isNaN(position.lat) || isNaN(position.lng)) {
      console.warn("Invalid coordinates for provider:", facility_name);
      return null;
    }

    // Create marker icon based on style
    const markerIcon = createMarkerIcon(provider, index, markerStyle);

    // Create marker
    const marker = new google.maps.Marker({
      position: position,
      map: mapInstance,
      title: facility_name,
      icon: markerIcon,
      animation: google.maps.Animation.DROP,
      providerId: provider.id,
      providerIndex: index,
      zIndex: 100 + index,
    });

    // Create info window
    const infoWindow = new google.maps.InfoWindow({
      content: createInfoWindowContent(provider),
      maxWidth: 320,
    });

    // Add click listener
    marker.addListener("click", () => {
      // Close any open info windows
      if (window.currentInfoWindow) {
        window.currentInfoWindow.close();
      }

      // Open this info window
      infoWindow.open(mapInstance, marker);
      window.currentInfoWindow = infoWindow;

      // Highlight corresponding provider card
      highlightProviderCard(index);

      // Call external callback
      if (window[onClick]) {
        window[onClick](provider.id, index);
      }

      // Analytics tracking
      if (window.gtag) {
        window.gtag("event", "map_marker_click", {
          provider_id: provider.id,
          provider_name: facility_name,
          price: pricing.patient_price,
        });
      }
    });

    return { marker, infoWindow };
  };

  // Create custom marker icon
  function createMarkerIcon(provider, index, style) {
    const { pricing } = provider;
    let displayText = "";
    let backgroundColor = "#2563eb";

    switch (style) {
      case "price":
        displayText = `$${Math.round(pricing.patient_price)}`;
        backgroundColor = "#059669"; // Green for price
        break;
      case "savings":
        displayText = `${Math.round(pricing.savings_percentage)}%`;
        backgroundColor = "#dc2626"; // Red for savings
        break;
      case "simple":
        displayText = (index + 1).toString();
        backgroundColor = "#2563eb"; // Blue for simple
        break;
    }

    return {
      url:
        "data:image/svg+xml;charset=UTF-8," +
        encodeURIComponent(`
             <svg width="80" height="50" xmlns="http://www.w3.org/2000/svg">
               <!-- Marker background -->
               <rect x="3" y="3" width="74" height="44" rx="22" ry="22" 
                     fill="white" stroke="${backgroundColor}" stroke-width="3"/>
               
               <!-- Price/savings text -->
               <text x="40" y="28" text-anchor="middle" 
                     font-family="Arial, sans-serif" font-size="12" font-weight="bold" 
                     fill="${backgroundColor}">
                 ${displayText}
               </text>
               
               <!-- Pointer -->
               <polygon points="40,47 35,37 45,37" fill="${backgroundColor}"/>
             </svg>
           `),
      scaledSize: new google.maps.Size(80, 50),
      anchor: new google.maps.Point(40, 50),
      labelOrigin: new google.maps.Point(40, 25),
    };
  }

  // Create info window content
  function createInfoWindowContent(provider) {
    const {
      pricing,
      facility_name,
      address,
      phone,
      distance_miles,
      availability,
    } = provider;
    const savings = Math.round(pricing.patient_savings);
    const savingsPercent = Math.round(pricing.savings_percentage);

    return `
           <div class="info-window-content" style="max-width: 300px; font-family: system-ui, -apple-system, sans-serif;">
             <!-- Header -->
             <div style="border-bottom: 2px solid #e5e7eb; padding-bottom: 12px; margin-bottom: 12px;">
               <h3 style="margin: 0; font-size: 16px; font-weight: 600; color: #111827;">
                 ${facility_name}
               </h3>
               <p style="margin: 4px 0 0 0; font-size: 14px; color: #6b7280;">
                 📍 ${address}
               </p>
               ${phone ? `<p style="margin: 4px 0 0 0; font-size: 14px; color: #6b7280;">📞 ${phone}</p>` : ""}
               ${
                 distance_miles
                   ? `
                 <p style="margin: 4px 0 0 0; font-size: 14px; color: #6b7280;">
                   🚗 ${distance_miles.toFixed(1)} miles away
                 </p>
               `
                   : ""
               }
             </div>
             
             <!-- Pricing -->
             <div style="margin-bottom: 12px;">
               <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                 <span style="font-size: 20px; font-weight: 700; color: #059669;">
                   $${Math.round(pricing.patient_price)}
                 </span>
                 <span style="background: #dcfce7; color: #166534; padding: 3px 8px; border-radius: 12px; font-size: 12px; font-weight: 600;">
                   Save $${savings}
                 </span>
               </div>
               <div style="font-size: 12px; color: #6b7280;">
                 ${savingsPercent}% savings vs typical hospital pricing
               </div>
             </div>
             
             <!-- Availability -->
             ${
               availability.available_slots > 0
                 ? `
               <div style="display: flex; align-items: center; margin-bottom: 12px; padding: 8px; background: #f0fdf4; border-radius: 6px;">
                 <span style="margin-right: 8px;">📅</span>
                 <span style="font-size: 14px; color: #059669; font-weight: 500;">
                   ${availability.available_slots} appointment slots available
                 </span>
               </div>
             `
                 : ""
             }
             
             <!-- Action Button -->
             <button 
               onclick="selectProvider('${provider.id}', ${index})"
               style="width: 100%; background: #2563eb; color: white; border: none; padding: 10px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 14px;"
               onmouseover="this.style.background='#1d4ed8'"
               onmouseout="this.style.background='#2563eb'"
             >
               Book Now & Save $${savings}
             </button>
             
             <!-- Trust Indicators -->
             <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #e5e7eb; font-size: 11px; color: #6b7280; text-align: center;">
               ✓ Medicare-based pricing ✓ Board-certified radiologists ✓ 24-48hr results
             </div>
           </div>
         `;
  }

  // Highlight corresponding provider card
  function highlightProviderCard(index) {
    // Remove existing highlights
    document.querySelectorAll(".provider-card").forEach((card) => {
      card.classList.remove("ring-2", "ring-blue-500", "shadow-lg");
    });

    // Highlight the selected card
    const targetCard = document.querySelector(
      `[data-provider-index="${index}"]`
    );
    if (targetCard) {
      targetCard.classList.add("ring-2", "ring-blue-500", "shadow-lg");
      targetCard.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }
</script>
