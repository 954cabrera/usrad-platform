---
export interface SearchMapProps {
  containerId?: string;
  height?: string;
  initialCenter?: { lat: number; lng: number };
  initialZoom?: number;
  onMapReady?: string;
}

const {
  containerId = "searchMap",
  height = "400px",
  initialCenter = { lat: 26.1224, lng: -80.1373 },
  initialZoom = 10,
  onMapReady = "onMapReady",
} = Astro.props;
---

<!-- ===========================================
     src/components/map/SearchMap.astro
     Map container component
     =========================================== -->
<div class="bg-white rounded-lg shadow-lg overflow-hidden">
  <div class="p-4 border-b border-gray-200">
    <h3 class="text-lg font-semibold text-gray-900">Provider Locations</h3>
    <p class="text-sm text-gray-600">Click markers for details and pricing</p>
  </div>

  <div
    id={containerId}
    class="w-full bg-gray-100 relative"
    style={`height: ${height}`}
  >
    <!-- Map Loading State -->
    <div
      id="mapLoading"
      class="absolute inset-0 flex items-center justify-center bg-gray-100"
    >
      <div class="text-center">
        <div
          class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto mb-2"
        >
        </div>
        <p class="text-sm text-gray-600">Loading map...</p>
      </div>
    </div>

    <!-- Map Error State -->
    <div
      id="mapError"
      class="absolute inset-0 flex items-center justify-center bg-gray-100 hidden"
    >
      <div class="text-center">
        <div class="text-4xl mb-2">🗺️</div>
        <p class="text-sm text-gray-600">Map unavailable</p>
        <button
          id="retryMap"
          class="mt-2 text-blue-600 hover:text-blue-800 text-sm"
        >
          Retry
        </button>
      </div>
    </div>
  </div>

  <!-- Map Controls -->
  <div class="p-4 border-t border-gray-200 bg-gray-50">
    <div class="flex justify-between items-center text-sm">
      <div class="flex items-center space-x-4">
        <button id="fitBounds" class="text-blue-600 hover:text-blue-800">
          Fit All Providers
        </button>
        <button id="toggleSatellite" class="text-blue-600 hover:text-blue-800">
          Satellite View
        </button>
      </div>

      <div class="flex items-center space-x-2">
        <span class="text-gray-600">Providers:</span>
        <span id="markerCount" class="font-medium text-gray-900">0</span>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ containerId, initialCenter, initialZoom, onMapReady }}>
  // Initialize map when DOM is ready
  document.addEventListener("DOMContentLoaded", async () => {
    try {
      // Wait for MapManager to be available
      if (!window.MapManager) {
        console.error("MapManager not loaded");
        showMapError();
        return;
      }

      // Get Google Maps API key
      const apiKey =
        window.GOOGLE_MAPS_API_KEY ||
        import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;

      if (!apiKey) {
        console.error("Google Maps API key not found");
        showMapError();
        return;
      }

      // Initialize map manager
      const mapManager = new window.MapManager(apiKey);

      // Set up map options
      const mapOptions = {
        center: initialCenter,
        zoom: initialZoom,
      };

      // Initialize the map
      await mapManager.initialize(containerId, mapOptions);

      // Store map manager globally
      window.mapManager = mapManager;

      // Hide loading state
      document.getElementById("mapLoading")?.classList.add("hidden");

      // Setup map control handlers
      setupMapControls(mapManager);

      // Call ready callback
      if (window[onMapReady]) {
        window[onMapReady](mapManager);
      }
    } catch (error) {
      console.error("Map initialization failed:", error);
      showMapError();
    }
  });

  function showMapError() {
    document.getElementById("mapLoading")?.classList.add("hidden");
    document.getElementById("mapError")?.classList.remove("hidden");
  }

  function setupMapControls(mapManager) {
    // Fit bounds button
    document.getElementById("fitBounds")?.addEventListener("click", () => {
      mapManager.fitBoundsToMarkers();
    });

    // Satellite toggle
    let isSatellite = false;
    document
      .getElementById("toggleSatellite")
      ?.addEventListener("click", (e) => {
        isSatellite = !isSatellite;
        const map = mapManager.getMap();

        if (map) {
          map.setMapTypeId(isSatellite ? "satellite" : "roadmap");
          e.target.textContent = isSatellite ? "Road View" : "Satellite View";
        }
      });

    // Retry button
    document.getElementById("retryMap")?.addEventListener("click", () => {
      location.reload();
    });

    // Update marker count when markers change
    const updateMarkerCount = () => {
      const count = mapManager.getMarkers().length;
      const countElement = document.getElementById("markerCount");
      if (countElement) {
        countElement.textContent = count.toString();
      }
    };

    // Set up marker count updates
    mapManager.onMarkersChanged = updateMarkerCount;
  }
</script>
