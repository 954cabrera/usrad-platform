---
const REMIX_URL = import.meta.env.PUBLIC_REMIX_URL || 'https://usrad-portal.vercel.app';
// AnciCareStory.astro - The Evolution: AnciCare to USRad section
---

<!-- Enhanced AnciCare Success Story -->
<section
  class="py-24 px-4 sm:px-6 bg-gradient-to-br from-[#003087] via-[#0052cc] to-[#003087] text-white relative overflow-hidden"
>
  <!-- Animated background elements -->
  <div class="absolute inset-0 opacity-10">
    <div
      class="absolute top-20 left-20 w-96 h-96 bg-[#cc9933] rounded-full blur-3xl animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-20 right-20 w-96 h-96 bg-[#FFA500] rounded-full blur-3xl animate-pulse animation-delay-2000"
    >
    </div>
  </div>

  <div class="max-w-5xl mx-auto relative z-10">
    <div class="text-center mb-12" data-aos="fade-up">
      <div
        class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-6 py-3 mb-6"
      >
        <svg
          class="w-5 h-5 text-[#cc9933]"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
          ></path>
        </svg>
        <span class="text-[#cc9933] font-bold"
          >The Evolution: AnciCare to USRad</span
        >
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-4">
        From Revolutionary to Evolutionary
      </h2>
      <p class="text-xl text-blue-100 max-w-3xl mx-auto">
        We didn't just build a successful company—we created the blueprint for
        affordable healthcare. Now we're taking it to the next level.
      </p>
    </div>

    <div
      class="bg-white/10 backdrop-blur-md rounded-3xl p-8 md:p-12 border border-white/20"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      <!-- The Evolution Timeline -->
      <div class="grid md:grid-cols-2 gap-12 mb-12">
        <!-- AnciCare Era (1994-2002) -->
        <div class="space-y-6">
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-16 h-16 bg-[#cc9933]/20 rounded-full flex items-center justify-center"
            >
              <span class="text-2xl font-bold text-[#cc9933]">1.0</span>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-[#cc9933]">AnciCare Era</h3>
              <p class="text-sm text-blue-200">1994-2002: The Foundation</p>
            </div>
          </div>

          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold">Manual Network Building</p>
                <p class="text-sm text-blue-200">
                  Phone calls, faxes, in-person recruitment
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold">Paper-Based Systems</p>
                <p class="text-sm text-blue-200">
                  10 day scheduling, 90-day payments
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold">B2B Focus</p>
                <p class="text-sm text-blue-200">
                  Served employers & workers' comp
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold">Regional Scale</p>
                <p class="text-sm text-blue-200">
                  Select markets, gradual expansion
                </p>
              </div>
            </div>
          </div>

          <div class="bg-[#cc9933]/10 rounded-xl p-4 mt-6">
            <p class="text-sm font-semibold text-[#cc9933]">The Result:</p>
            <p class="text-3xl font-bold text-white mt-1">$180M+ Volume Delivered</p>
            <p class="text-sm text-blue-200">
              1,200+ centers • 168,000+ patients
            </p>
          </div>
        </div>

        <!-- USRad Era (2024+) -->
        <div class="space-y-6">
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-16 h-16 bg-[#003087]/30 rounded-full flex items-center justify-center animate-pulse"
            >
              <span class="text-2xl font-bold text-white">2.0</span>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white">USRad Era</h3>
              <p class="text-sm text-blue-200">2024+: The Revolution</p>
            </div>
          </div>

          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-[#00ff88] flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold">AI-Powered Network</p>
                <p class="text-sm text-blue-200">
                  Real-time matching in 47 seconds
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-[#00ff88] flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold">Digital-First Platform</p>
                <p class="text-sm text-blue-200">
                  60-second booking, 10-day payments
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-[#00ff88] flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold">Direct-to-Consumer</p>
                <p class="text-sm text-blue-200">
                  No gatekeepers, no insurance required
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-[#00ff88] flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <div>
                <p class="font-semibold">Nationwide Scale</p>
                <p class="text-sm text-blue-200">
                  10 priority markets, instant deployment
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white/10 rounded-xl p-4 mt-6">
            <p class="text-sm font-semibold text-white">The Mission:</p>
            <p class="text-3xl font-bold text-[#00ff88] mt-1">90M Americans</p>
            <p class="text-sm text-blue-200">Uninsured & underinsured served</p>
          </div>
        </div>
      </div>

      <!-- The Technology Evolution -->
      <div
        class="bg-gradient-to-r from-[#cc9933]/20 to-[#FFA500]/20 rounded-2xl p-6 mb-8 border border-[#cc9933]/30"
      >
        <h4 class="text-xl font-bold text-[#cc9933] mb-4 text-center">
          What 30 Years of Innovation Looks Like
        </h4>
        <div class="grid md:grid-cols-3 gap-6 text-center">
          <div>
            <div class="text-3xl font-bold text-white mb-1">
              10 days → 60 sec
            </div>
            <p class="text-sm text-blue-200">Booking time</p>
          </div>
          <div>
            <div class="text-3xl font-bold text-white mb-1">Fax → AI</div>
            <p class="text-sm text-blue-200">Technology leap</p>
          </div>
          <div>
            <div class="text-3xl font-bold text-white mb-1">168K+ → 90M</div>
            <p class="text-sm text-blue-200">People served</p>
          </div>
        </div>
      </div>

      <!-- The Bottom Line -->
      <div
        class="text-center bg-gradient-to-r from-[#003087]/20 to-[#002266]/20 rounded-2xl p-8 border border-white/20"
      >
        <svg
          class="w-12 h-12 text-[#cc9933] mx-auto mb-4"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
            clip-rule="evenodd"></path>
        </svg>
        <p class="text-xl font-semibold mb-2">The Bottom Line</p>
        <p class="text-lg italic mb-4 leading-relaxed">
          "We're not just recreating AnciCare—we're revolutionizing it.
          AI-driven patient matching, blockchain-secured transactions, real-time
          network optimization, and a direct-to-consumer model that eliminates
          every barrier between patients and care. The future of healthcare,
          built on 30 years of proven success."
        </p>
        <p class="text-sm text-[#cc9933]">— Michael Cabrera, Founder & CEO</p>
      </div>

      <!-- Call to Action -->
      <div class="text-center mt-8">
        <p class="text-lg mb-6">
          Join the network that's already proven it can change an industry.
        </p>
        <a
          href={`${REMIX_URL}/signup`}
          class="inline-flex items-center gap-2 bg-gradient-to-r from-[#cc9933] to-[#FFA500] text-[#003087] px-8 py-4 rounded-xl font-bold hover:shadow-2xl transition-all transform hover:scale-105"
        >
          <span>Apply Now - Limited Slots Available</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>

  <style>
    @keyframes pulse {
      0%,
      100% {
        opacity: 0.1;
      }
      50% {
        opacity: 0.2;
      }
    }
    .animation-delay-2000 {
      animation-delay: 2s;
    }
  </style>
</section>
