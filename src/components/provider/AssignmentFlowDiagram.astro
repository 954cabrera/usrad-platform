---
// src/components/provider/AssignmentFlowDiagram.astro
// Phase 2 — Assignment Flow Diagram
// Placement: after ScannerUtilization, before HowItWorks
// Communicates USRad as routing infrastructure, not a booking marketplace.
// Seven nodes: Physician Order → USRad Network → Assignment Routed →
//   Scanner Utilization → Radiologist Interpretation → Report Delivery →
//   10-Day Payment Issued
---

<section
  id="assignment-flow"
  class="py-20 sm:py-28 px-4 sm:px-6 bg-gradient-to-b from-gray-50 to-white"
>
  <div class="max-w-4xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-14 sm:mb-20" data-aos="fade-up">
      <div
        class="inline-flex items-center gap-2 bg-[#003087]/8 rounded-full px-4 sm:px-6 py-2 sm:py-3 mb-6"
      >
        <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
        <span
          class="text-[#003087] text-xs sm:text-sm font-semibold tracking-wide uppercase"
        >
          Network Infrastructure
        </span>
      </div>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-5 leading-tight"
      >
        How Imaging Assignments
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-[#003087] to-[#cc9933]"
        >
          Flow Through the Network
        </span>
      </h2>
      <p
        class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed"
      >
        USRad is not a booking marketplace. It is a routing and fulfillment
        layer that connects physician demand with available scanner capacity.
      </p>
    </div>

    <!-- Flow Diagram -->
    <div class="relative" data-aos="fade-up" data-aos-delay="100">
      <!-- Vertical connector line (desktop) -->
      <div
        class="hidden sm:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-[#003087]/20 via-[#cc9933]/30 to-[#22c55e]/40 -translate-x-1/2 pointer-events-none"
      >
      </div>

      <div class="space-y-4 sm:space-y-0">
        <!-- NODE 1 — Physician Order -->
        <div class="flow-node-wrapper" data-aos="fade-up" data-aos-delay="100">
          <div
            class="flow-node border-[#003087]/20 bg-white hover:border-[#003087]/50"
          >
            <div class="node-icon-wrap bg-[#003087]/8">
              <!-- Clipboard icon -->
              <svg
                class="w-5 h-5 text-[#003087]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                ></path>
              </svg>
            </div>
            <div class="node-content">
              <div class="node-step text-[#003087]">Step 1</div>
              <div class="node-title text-gray-900">Physician Order</div>
              <div class="node-desc">
                A physician issues an imaging order. The request enters the
                USRad network for verification.
              </div>
            </div>
            <div class="node-badge bg-[#003087]/8 text-[#003087]">
              Demand Origin
            </div>
          </div>
        </div>

        <!-- Arrow -->
        <div class="flow-arrow" aria-hidden="true">
          <svg
            class="w-5 h-5 text-[#003087]/40"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>

        <!-- NODE 2 — USRad Network Layer -->
        <div class="flow-node-wrapper" data-aos="fade-up" data-aos-delay="150">
          <div
            class="flow-node border-[#cc9933]/30 bg-gradient-to-br from-white to-[#cc9933]/5 hover:border-[#cc9933]/60"
          >
            <div class="node-icon-wrap bg-[#cc9933]/10">
              <!-- Network nodes icon -->
              <svg
                class="w-5 h-5 text-[#cc9933]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6a2 2 0 100-4 2 2 0 000 4zm16 0a2 2 0 100-4 2 2 0 000 4zm-8 6a2 2 0 100-4 2 2 0 000 4zM4 20a2 2 0 100-4 2 2 0 000 4zm16 0a2 2 0 100-4 2 2 0 000 4M6 6l3.5 4M14.5 10L18 6M8 18l3.5-4M12.5 14L16 18"
                ></path>
              </svg>
            </div>
            <div class="node-content">
              <div class="node-step text-[#cc9933]">Step 2</div>
              <div class="node-title text-gray-900">USRad Network Layer</div>
              <div class="node-desc">
                Order verified. Pricing established. USRad's matching is
                designed to route the assignment to a participating center on
                location, modality and contracted price.
              </div>
            </div>
            <div class="node-badge bg-[#cc9933]/10 text-[#cc9933]">
              Verification · Pricing · Routing
            </div>
          </div>
        </div>

        <!-- Arrow -->
        <div class="flow-arrow" aria-hidden="true">
          <svg
            class="w-5 h-5 text-[#cc9933]/50"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>

        <!-- NODE 3 — Assignment Routed -->
        <div class="flow-node-wrapper" data-aos="fade-up" data-aos-delay="200">
          <div
            class="flow-node border-[#003087]/20 bg-white hover:border-[#003087]/50"
          >
            <div class="node-icon-wrap bg-[#003087]/8">
              <!-- Bell / notification icon -->
              <svg
                class="w-5 h-5 text-[#003087]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
                ></path>
              </svg>
            </div>
            <div class="node-content">
              <div class="node-step text-[#003087]">Step 3</div>
              <div class="node-title text-gray-900">
                Assignment Appears in Your Portal
              </div>
              <div class="node-desc">
                The assignment appears instantly in your provider dashboard —
                procedure type, patient window, and assignment ID already
                attached. No price negotiation. No insurance verification.
              </div>
            </div>
            <div class="node-badge bg-[#003087]/8 text-[#003087]">
              Pending Activation
            </div>
          </div>
        </div>

        <!-- Arrow -->
        <div class="flow-arrow" aria-hidden="true">
          <svg
            class="w-5 h-5 text-[#003087]/40"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>

        <!-- NODE 4 — Scanner Utilization (Economic anchor) -->
        <div class="flow-node-wrapper" data-aos="fade-up" data-aos-delay="250">
          <div
            class="flow-node border-[#cc9933]/40 bg-gradient-to-br from-white to-[#cc9933]/5 hover:border-[#cc9933]/70 ring-1 ring-[#cc9933]/10"
          >
            <!-- Highlighted node — economic anchor -->
            <div class="node-icon-wrap bg-[#cc9933]/15">
              <!-- MRI / scanner icon -->
              <svg
                class="w-5 h-5 text-[#cc9933]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"
                ></path>
              </svg>
            </div>
            <div class="node-content">
              <div class="node-step text-[#cc9933]">Step 4</div>
              <div class="node-title text-gray-900">Scanner Utilization</div>
              <div class="node-desc">
                Your team schedules the patient exactly like any other referral.
                Your scanner performs the study — MRI, CT, X-ray, or ultrasound.
                This is the revenue event.
              </div>
            </div>
            <div class="node-badge bg-[#cc9933]/15 text-[#cc9933] font-bold">
              MRI · CT · X-ray · Ultrasound
            </div>
          </div>
        </div>

        <!-- Arrow -->
        <div class="flow-arrow" aria-hidden="true">
          <svg
            class="w-5 h-5 text-[#cc9933]/50"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>

        <!-- NODE 5 — Radiologist Interpretation -->
        <div class="flow-node-wrapper" data-aos="fade-up" data-aos-delay="300">
          <div
            class="flow-node border-[#003087]/20 bg-white hover:border-[#003087]/50"
          >
            <div class="node-icon-wrap bg-[#003087]/8">
              <!-- Monitor icon -->
              <svg
                class="w-5 h-5 text-[#003087]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <div class="node-content">
              <div class="node-step text-[#003087]">Step 5</div>
              <div class="node-title text-gray-900">
                Radiologist Interpretation
              </div>
              <div class="node-desc">
                A board-certified radiologist reads the study. Final images and
                interpretation are finalized. The assignment is marked complete
                in your portal.
              </div>
            </div>
            <div class="node-badge bg-[#003087]/8 text-[#003087]">
              Board Certified
            </div>
          </div>
        </div>

        <!-- Arrow -->
        <div class="flow-arrow" aria-hidden="true">
          <svg
            class="w-5 h-5 text-[#003087]/40"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>

        <!-- NODE 6 — Report Delivery -->
        <div class="flow-node-wrapper" data-aos="fade-up" data-aos-delay="350">
          <div
            class="flow-node border-[#003087]/20 bg-white hover:border-[#003087]/50"
          >
            <div class="node-icon-wrap bg-[#003087]/8">
              <!-- Document check icon -->
              <svg
                class="w-5 h-5 text-[#003087]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
            </div>
            <div class="node-content">
              <div class="node-step text-[#003087]">Step 6</div>
              <div class="node-title text-gray-900">Report Delivered</div>
              <div class="node-desc">
                Diagnostic results are returned to the ordering physician. USRad
                coordinates the delivery. Your team's job is complete.
              </div>
            </div>
            <div class="node-badge bg-[#003087]/8 text-[#003087]">
              Fulfillment Complete
            </div>
          </div>
        </div>

        <!-- Arrow -->
        <div class="flow-arrow" aria-hidden="true">
          <svg
            class="w-5 h-5 text-[#22c55e]/60"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>

        <!-- NODE 7 — Payment Issued (Financial anchor) -->
        <div class="flow-node-wrapper" data-aos="fade-up" data-aos-delay="400">
          <div
            class="flow-node border-[#22c55e]/40 bg-gradient-to-br from-white to-[#22c55e]/5 hover:border-[#22c55e]/70 ring-1 ring-[#22c55e]/10"
          >
            <div class="node-icon-wrap bg-[#22c55e]/15">
              <!-- Shield check icon -->
              <svg
                class="w-5 h-5 text-[#22c55e]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <div class="node-content">
              <div class="node-step text-[#22c55e]">Step 7</div>
              <div class="node-title text-gray-900">
                Payment Issued in 10 Business Days
              </div>
              <div class="node-desc">
                Payment is processed and disbursed directly to your center
                within 10 business days of fulfillment. No claim filing. No
                collections. No surprises.
              </div>
            </div>
            <div class="node-badge bg-[#22c55e]/15 text-[#22c55e] font-bold">
              Guaranteed Disbursement
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Conversion callout -->
    <div
      class="mt-14 sm:mt-20 bg-gradient-to-r from-[#003087] to-[#004299] rounded-2xl p-8 sm:p-10 text-center shadow-xl"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      <p
        class="text-white/60 text-xs font-semibold uppercase tracking-widest mb-3"
      >
        The Most Important Thing to Understand
      </p>
      <p
        class="text-white text-xl sm:text-2xl font-bold max-w-2xl mx-auto leading-snug mb-6"
      >
        Every assignment is funded before it reaches your center.
      </p>
      <p class="text-white/70 text-base max-w-xl mx-auto leading-relaxed">
        Your front desk schedules the patient. Your team performs the study.
        USRad handles verification, pricing, coordination, and payment.
      </p>
      <a
        href="/provider/portal-tour"
        class="inline-flex items-center gap-2 mt-8
      text-[#cc9933] hover:text-[#e8b84b] text-sm font-semibold
      transition-colors duration-200 group"
      >
        See the portal in action
        <span
          class="group-hover:translate-x-1 transition-transform duration-200"
          >→</span
        >
      </a>
    </div>
  </div>

  <style>
    .flow-node-wrapper {
      position: relative;
      display: flex;
      justify-content: center;
    }

    .flow-node {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      width: 100%;
      max-width: 640px;
      padding: 20px 24px;
      border-radius: 16px;
      border-width: 2px;
      border-style: solid;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
      transition: all 0.3s ease;
      position: relative;
      z-index: 1;
    }

    .flow-node:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.1);
    }

    .node-icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .node-content {
      flex: 1;
      min-width: 0;
    }

    .node-step {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 4px;
    }

    .node-title {
      font-size: 17px;
      font-weight: 700;
      margin-bottom: 6px;
      line-height: 1.3;
    }

    .node-desc {
      font-size: 14px;
      color: #6b7280;
      line-height: 1.6;
    }

    .node-badge {
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 999px;
      white-space: nowrap;
      align-self: flex-start;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .flow-arrow {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 6px 0;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 640px) {
      .flow-node {
        flex-wrap: nowrap;
        gap: 12px;
        padding: 14px 16px;
        align-items: center;
      }

      .node-icon-wrap {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        flex-shrink: 0;
      }

      .node-content {
        flex: 1;
        min-width: 0;
      }

      .node-step {
        display: inline;
        margin-right: 6px;
      }

      .node-badge {
        display: inline;
        font-size: 10px;
        padding: 2px 8px;
        margin-left: 4px;
        vertical-align: middle;
      }

      /* Badge moved inline — hide the standalone badge on mobile */
      .flow-node .node-badge {
        display: none;
      }

      /* Instead, show step + badge inline inside node-content via a wrapper */
      .node-title {
        font-size: 15px;
        margin-bottom: 3px;
      }

      .node-desc {
        font-size: 13px;
        line-height: 1.5;
      }
    }
  </style>
</section>
