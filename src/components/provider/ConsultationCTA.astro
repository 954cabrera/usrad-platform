---
// src/components/provider/ConsultationCTA.astro
// Questions section with consultation option
---

<section class="consultation-cta-section" data-aos="fade-up">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
    <div class="cta-container">
      <!-- Left side - Content -->
      <div class="cta-content">
        <div class="badge">
          <span class="badge-dot"></span>
          <span class="badge-text">Questions? We're Here to Help</span>
        </div>

        <h2 class="cta-title">
          Not Ready to Join Yet?
          <span class="title-highlight">Let's Talk First</span>
        </h2>

        <p class="cta-description">
          Whether you have questions about pricing, integration, or want to
          understand how USRad fits into your existing operations, we're here to
          help. Schedule a quick call or jump right in.
        </p>

        <!-- Benefits list -->
        <ul class="benefits-list">
          <li class="benefit-item">
            <svg class="benefit-icon" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Understand our pricing and terms</span>
          </li>
          <li class="benefit-item">
            <svg class="benefit-icon" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Learn about the integration process</span>
          </li>
          <li class="benefit-item">
            <svg class="benefit-icon" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Discuss multi-center opportunities</span>
          </li>
        </ul>

        <!-- CTA Buttons -->
        <div class="cta-buttons">
          <a
            href="https://cal.com/usrad/15min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-consultation"
          >
            <svg
              class="btn-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              ></path>
            </svg>
            Book a Call Now
          </a>

          <span class="divider">or</span>

          <a href="/provider#hero" class="btn-join">
            Join the Network
            <svg
              class="btn-arrow"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>

        <!-- Alternative: Form Option -->
        <p class="form-alternative">
          Prefer to share details first?
          <a href="/provider/consultation" class="form-link"
            >Tell us about your centers →</a
          >
        </p>
      </div>

      <!-- Right side - Visual/Stats Card -->
      <div class="cta-visual">
        <div class="stats-card">
          <div class="stats-header">
            <div class="stats-icon">📞</div>
            <h3 class="stats-title">Quick Response</h3>
          </div>

          <div class="stats-grid">
            <div class="stat">
              <div class="stat-value">&lt; 24h</div>
              <div class="stat-label">Response Time</div>
            </div>
            <div class="stat">
              <div class="stat-value">15 min</div>
              <div class="stat-label">Typical Call Length</div>
            </div>
          </div>

          <div class="contact-info">
            <p class="contact-title">Prefer to call directly?</p>
            <a href="tel:1-800-877-2324" class="contact-phone">
              1-800-USRAD-24
            </a>
            <p class="contact-hours">Mon-Fri, 8am-8pm EST</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .consultation-cta-section {
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    position: relative;
    overflow: hidden;
  }

  /* Subtle background pattern */
  .consultation-cta-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0.03;
    background-image: url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23003087" fill-opacity="1"%3E%3Cpath d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');
  }

  .cta-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .cta-content {
    max-width: 560px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #e0f2fe 0%, #dbeafe 100%);
    color: #0369a1;
    padding: 8px 16px;
    border-radius: 24px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 24px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: #0ea5e9;
    border-radius: 50%;
    animation: pulse 2s ease infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  .cta-title {
    font-size: 42px;
    font-weight: 800;
    color: #1a1a1a;
    line-height: 1.2;
    margin: 0 0 16px 0;
  }

  .title-highlight {
    display: block;
    background: linear-gradient(135deg, #003087 0%, #0066cc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cta-description {
    font-size: 18px;
    color: #666;
    line-height: 1.7;
    margin: 0 0 32px 0;
  }

  .benefits-list {
    list-style: none;
    padding: 0;
    margin: 0 0 36px 0;
  }

  .benefit-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    color: #333;
    font-size: 16px;
  }

  .benefit-icon {
    width: 24px;
    height: 24px;
    color: #22c55e;
    flex-shrink: 0;
  }

  .cta-buttons {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-consultation {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #003087 0%, #004299 100%);
    color: white;
    padding: 16px 28px;
    border-radius: 12px;
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 48, 135, 0.3);
    border: 2px solid transparent;
  }

  .btn-consultation:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 48, 135, 0.4);
  }

  .btn-icon {
    width: 20px;
    height: 20px;
  }

  .divider {
    color: #999;
    font-size: 15px;
    font-weight: 500;
    padding: 0 8px;
  }

  .btn-join {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: #003087;
    padding: 16px 28px;
    border-radius: 12px;
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 2px solid #003087;
  }

  .btn-join:hover {
    background: #003087;
    color: white;
  }

  .btn-join:hover .btn-arrow {
    transform: translateX(4px);
  }

  .btn-arrow {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .form-alternative {
    margin-top: 20px;
    text-align: center;
    font-size: 14px;
    color: #666;
  }

  .form-link {
    color: #003087;
    text-decoration: none;
    font-weight: 600;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }

  .form-link:hover {
    border-bottom-color: #003087;
  }

  /* Visual/Stats Card */
  .cta-visual {
    display: flex;
    justify-content: center;
  }

  .stats-card {
    background: white;
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    border: 2px solid #f0f0f0;
    width: 100%;
    max-width: 400px;
  }

  .stats-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 2px solid #f0f0f0;
  }

  .stats-icon {
    font-size: 40px;
  }

  .stats-title {
    font-size: 24px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 28px;
  }

  .stat {
    text-align: center;
    padding: 20px;
    background: linear-gradient(135deg, #f8f9fa 0%, #e8e8e8 100%);
    border-radius: 12px;
  }

  .stat-value {
    font-size: 32px;
    font-weight: 800;
    color: #cc9933;
    margin-bottom: 8px;
  }

  .stat-label {
    font-size: 13px;
    color: #666;
    line-height: 1.3;
  }

  .contact-info {
    background: linear-gradient(135deg, #dbeafe 0%, #e0f2fe 100%);
    padding: 24px;
    border-radius: 12px;
    text-align: center;
  }

  .contact-title {
    margin: 0 0 12px 0;
    font-size: 14px;
    color: #666;
    font-weight: 500;
  }

  .contact-phone {
    display: block;
    font-size: 28px;
    font-weight: 800;
    color: #003087;
    text-decoration: none;
    margin-bottom: 8px;
    transition: color 0.2s ease;
  }

  .contact-phone:hover {
    color: #0066cc;
  }

  .contact-hours {
    margin: 0;
    font-size: 13px;
    color: #666;
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .cta-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .cta-content {
      max-width: 100%;
    }

    .cta-title {
      font-size: 36px;
    }
  }

  @media (max-width: 640px) {
    .cta-title {
      font-size: 32px;
    }

    .cta-description {
      font-size: 16px;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    .btn-consultation,
    .btn-join {
      width: 100%;
      justify-content: center;
    }

    .divider {
      text-align: center;
    }

    .stats-card {
      padding: 30px 20px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .contact-phone {
      font-size: 24px;
    }
  }
</style>
