---
// src/components/provider/ExitModal.astro
// Enhanced exit intent modal with 3 lead capture options
---

<div id="exitModal" class="exit-modal" style="display: none;">
  <div class="modal-overlay"></div>
  <div class="modal-content">
    <button class="modal-close" aria-label="Close modal">×</button>

    <!-- Main View -->
    <div class="modal-body" id="mainView">
      <!-- Icon -->
      <div class="modal-icon">
        <svg
          width="64"
          height="64"
          viewBox="0 0 64 64"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            x="10"
            y="6"
            width="36"
            height="46"
            rx="4"
            fill="#E8EDF5"
            stroke="#003087"
            stroke-width="2"></rect>
          <rect
            x="16"
            y="6"
            width="36"
            height="46"
            rx="4"
            fill="#EEF2FA"
            stroke="#003087"
            stroke-width="2"></rect>
          <path
            d="M24 20h16M24 28h16M24 36h10"
            stroke="#003087"
            stroke-width="2.5"
            stroke-linecap="round"></path>
          <circle cx="46" cy="46" r="10" fill="#cc9933"></circle>
          <path
            d="M46 41v5.5l3 3"
            stroke="white"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>

      <!-- Heading -->
      <h2 class="modal-title">Before You Go</h2>
      <p class="modal-subtitle">Get the complete decision framework — free</p>

      <!-- Content -->
      <p class="modal-description">
        <em>The Cash-Pay Imaging Decision</em> — written by USRad founder Michael
        Cabrera — walks through the real economics of building a cash-pay program
        independently versus joining an established network.
      </p>

      <!-- Stats from the ebook -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-value">$0</div>
          <div class="stat-label">Network path upfront cost</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">60–90</div>
          <div class="stat-label">Days to first revenue</div>
        </div>
      </div>

      <!-- What's inside -->
      <div class="proven-box">
        <div class="proven-icon">📖</div>
        <div class="proven-text">
          Covers the <strong>$2–4B cash-pay market opportunity</strong>, the
          two-path decision framework, and why 65–75% of independent programs
          struggle in year one.
        </div>
      </div>

      <!-- Choose Your Next Step -->
      <div class="options-heading">
        <h3>Choose Your Next Step:</h3>
      </div>

      <!-- CTA Options -->
      <div class="cta-options">
        <!-- Option 1: Download Ebook (PRIMARY) -->
        <button class="option-card option-card-primary" data-option="guide">
          <div class="option-icon">📥</div>
          <div class="option-content">
            <div class="option-title">Get the Free Ebook</div>
            <div class="option-description">
              The Cash-Pay Imaging Decision — by Michael Cabrera
            </div>
          </div>
          <div class="option-arrow">→</div>
        </button>

        <!-- Option 2: Schedule Call -->
        <button class="option-card" data-option="schedule">
          <div class="option-icon">📞</div>
          <div class="option-content">
            <div class="option-title">Schedule a Quick Call</div>
            <div class="option-description">
              15-min conversation with our team
            </div>
          </div>
          <div class="option-arrow">→</div>
        </button>
      </div>

      <button class="btn-secondary" id="riskWaitingBtn">
        No thanks, continue browsing
      </button>

      <!-- Fine print -->
      <p class="modal-footer">
        🔒 No spam · 📄 Instant email delivery · ❌ Unsubscribe anytime
      </p>
    </div>

    <!-- Market Analysis Form View -->
    <div class="modal-body" id="analysisView" style="display: none;">
      <button class="back-button" id="backFromAnalysis">← Back</button>

      <div class="modal-icon">
        <svg
          width="64"
          height="64"
          viewBox="0 0 64 64"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            x="8"
            y="8"
            width="48"
            height="48"
            rx="8"
            fill="#FEF3C7"
            stroke="#F59E0B"
            stroke-width="2"></rect>
          <path
            d="M16 28h32M24 36h24M20 20h28"
            stroke="#F59E0B"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>
      </div>

      <h2 class="modal-title">Get Your Market Analysis</h2>
      <p class="modal-description">
        See exactly who you're competing against and discover untapped
        opportunities in your market.
      </p>

      <form id="analysisForm" class="lead-form">
        <div class="form-group">
          <label for="analysisName">Full Name *</label>
          <input
            type="text"
            id="analysisName"
            name="name"
            required
            placeholder="Dr. Sarah Johnson"
          />
        </div>

        <div class="form-group">
          <label for="analysisEmail">Email Address *</label>
          <input
            type="email"
            id="analysisEmail"
            name="email"
            required
            placeholder="sarah@imagingcenter.com"
          />
        </div>

        <div class="form-group">
          <label for="analysisPhone">Phone Number</label>
          <input
            type="tel"
            id="analysisPhone"
            name="phone"
            placeholder="(555) 123-4567"
          />
        </div>

        <div class="form-group">
          <label for="analysisZip">Facility ZIP Code *</label>
          <input
            type="text"
            id="analysisZip"
            name="zipCode"
            required
            placeholder="33024"
            pattern="[0-9]{5}"
            maxlength="5"
          />
        </div>

        <div class="form-group">
          <label for="analysisFacilityName">Facility Name</label>
          <input
            type="text"
            id="analysisFacilityName"
            name="facilityName"
            placeholder="Miami Advanced Imaging"
          />
        </div>

        <button type="submit" class="btn-primary">
          Generate My Analysis
          <svg
            class="btn-icon"
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </form>

      <p class="form-note">
        🔒 Your information is secure. We'll email your personalized analysis
        within 24 hours.
      </p>
    </div>

    <!-- PDF Guide Form View -->
    <div class="modal-body" id="guideView" style="display: none;">
      <button class="back-button" id="backFromGuide">← Back</button>

      <div class="modal-icon">
        <svg
          width="64"
          height="64"
          viewBox="0 0 64 64"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            x="12"
            y="8"
            width="40"
            height="48"
            rx="4"
            fill="#FEF3C7"
            stroke="#F59E0B"
            stroke-width="2"></rect>
          <path
            d="M20 20h24M20 28h24M20 36h16"
            stroke="#F59E0B"
            stroke-width="2"></path>
        </svg>
      </div>

      <h2 class="modal-title">Download Your Free Ebook</h2>
      <p class="modal-description">
        <em>The Cash-Pay Imaging Decision</em> by Michael Cabrera. The complete framework
        for evaluating whether to build independently or join an established network
        — with real economics, not estimates.
      </p>

      <div class="guide-features">
        <div class="feature-item">✓ The $2–4B cash-pay market opportunity</div>
        <div class="feature-item">
          ✓ Independent vs. network path comparison
        </div>
        <div class="feature-item">
          ✓ Why 65–75% of independent programs struggle
        </div>
        <div class="feature-item">✓ Decision framework with your numbers</div>
      </div>

      <form id="guideForm" class="lead-form">
        <div class="form-group">
          <label for="guideName">Full Name *</label>
          <input
            type="text"
            id="guideName"
            name="name"
            required
            placeholder="Dr. Sarah Johnson"
          />
        </div>

        <div class="form-group">
          <label for="guideEmail">Email Address *</label>
          <input
            type="email"
            id="guideEmail"
            name="email"
            required
            placeholder="sarah@imagingcenter.com"
          />
        </div>

        <div class="form-group">
          <label for="guidePhone">Phone Number (Optional)</label>
          <input
            type="tel"
            id="guidePhone"
            name="phone"
            placeholder="(555) 123-4567"
          />
        </div>

        <div class="form-group">
          <label for="guideFacilityType">Facility Type *</label>
          <select id="guideFacilityType" name="facilityType" required>
            <option value="">Select your facility type...</option>
            <option value="hospital">Hospital/Health System</option>
            <option value="independent">Independent Imaging Center</option>
            <option value="mobile">Mobile Imaging</option>
            <option value="urgent-care">Urgent Care</option>
            <option value="other">Other</option>
          </select>
        </div>

        <button type="submit" class="btn-primary">
          Download Guide
          <svg
            class="btn-icon"
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              d="M10 3a1 1 0 011 1v9.586l2.293-2.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 13.586V4a1 1 0 011-1z"
            ></path>
            <path d="M4 16a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1z"></path>
          </svg>
        </button>
      </form>

      <p class="form-note">
        🔒 Your information is secure. Instant download link sent to your email.
      </p>
    </div>

    <!-- Success View -->
    <div class="modal-body" id="successView" style="display: none;">
      <div class="modal-icon">
        <svg
          width="64"
          height="64"
          viewBox="0 0 64 64"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="32"
            cy="32"
            r="30"
            fill="#D1FAE5"
            stroke="#10B981"
            stroke-width="2"></circle>
          <path
            d="M20 32l8 8 16-16"
            stroke="#10B981"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>

      <h2 class="modal-title">Success! Check Your Email</h2>
      <p class="modal-description" id="successMessage">
        We've sent your personalized market analysis to your email. You should
        receive it within 24 hours.
      </p>

      <button class="btn-primary" onclick="window.location.reload()">
        Continue Exploring
      </button>

      <p class="form-note">
        Want to talk now? <a
          href="https://cal.com/usrad/15min"
          target="_blank"
          rel="noopener noreferrer"
          style="color: #cc9933; text-decoration: underline;"
          >Schedule a quick call</a
        >
      </p>
    </div>
  </div>
</div>

<style>
  .exit-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fadeIn 0.3s ease;
  }

  .modal-content {
    position: relative;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 24px;
    max-width: 600px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    animation: slideUp 0.4s ease;
  }

  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.9);
    transition: all 0.2s ease;
    z-index: 10;
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: scale(1.1);
  }

  .modal-body {
    padding: 40px 30px;
    text-align: center;
  }

  .back-button {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.9);
    transition: all 0.2s ease;
    min-width: 90px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .back-button:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateX(-2px);
  }

  .modal-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
    animation: bounce 1s ease infinite;
  }

  .modal-title {
    font-size: 28px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 8px 0;
    line-height: 1.2;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .modal-subtitle {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 20px 0;
    font-style: italic;
  }

  .modal-description {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.6;
    margin: 0 0 24px 0;
  }

  .highlight {
    color: #cc9933;
    font-weight: 700;
  }

  .highlight-gold {
    color: #b8861f;
    font-weight: 700;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 20px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .stat-value {
    font-size: 32px;
    font-weight: 700;
    color: #cc9933;
    margin-bottom: 8px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .stat-label {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.3;
  }

  .proven-box {
    background: rgba(254, 243, 199, 0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 20px;
    border-radius: 12px;
    border: 2px solid rgba(245, 158, 11, 0.5);
    margin-bottom: 28px;
    display: flex;
    gap: 12px;
    text-align: left;
    align-items: flex-start;
  }

  .proven-icon {
    font-size: 28px;
    flex-shrink: 0;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }

  .proven-text {
    font-size: 15px;
    color: #fef3c7;
    line-height: 1.5;
  }

  .options-heading {
    margin-bottom: 16px;
  }

  .options-heading h3 {
    font-size: 18px;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
  }

  .cta-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }

  .option-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: left;
    width: 100%;
  }

  .option-card-primary {
    border-color: rgba(204, 153, 51, 0.5);
    background: rgba(204, 153, 51, 0.08);
  }

  .option-card-primary:hover {
    border-color: rgba(204, 153, 51, 0.9);
    background: rgba(204, 153, 51, 0.15);
  }

  .option-card:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(204, 153, 51, 0.8);
    transform: translateX(6px);
    box-shadow: 0 4px 12px rgba(204, 153, 51, 0.2);
  }

  .option-icon {
    font-size: 36px;
    flex-shrink: 0;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.4));
    transition: transform 0.3s ease;
  }

  .option-card:hover .option-icon {
    transform: scale(1.1);
  }

  .option-content {
    flex: 1;
  }

  .option-title {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 4px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .option-description {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.3;
  }

  .option-arrow {
    font-size: 28px;
    color: #cc9933;
    transition: transform 0.3s ease;
  }

  .option-card:hover .option-arrow {
    transform: translateX(4px);
  }

  /* Subtle pulse on highest-intent option */
  .option-card[data-option="schedule"] {
    animation: pulse-gold 3s ease-in-out infinite;
  }

  .option-card[data-option="schedule"]:hover {
    animation: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #cc9933 0%, #b8861f 100%);
    color: white;
    padding: 16px 24px;
    border-radius: 12px;
    font-size: 18px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(204, 153, 51, 0.3);
    width: 100%;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(204, 153, 51, 0.4);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .btn-icon {
    transition: transform 0.3s ease;
  }

  .btn-primary:hover .btn-icon {
    transform: translateX(4px);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.75);
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.9);
  }

  .modal-footer {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.65);
    margin: 16px 0 0 0;
  }

  /* Form Styles */
  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 24px;
  }

  .form-group {
    text-align: left;
  }

  .form-group label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .form-group input,
  .form-group select {
    width: 100%;
    padding: 12px 16px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #ffffff;
    font-size: 15px;
    transition: all 0.2s ease;
  }

  .form-group input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: rgba(204, 153, 51, 0.5);
    background: rgba(255, 255, 255, 0.15);
  }

  .form-group select {
    cursor: pointer;
  }

  .form-group select option {
    background: #1a1a1a;
    color: #ffffff;
  }

  .form-note {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 16px;
    line-height: 1.4;
  }

  .guide-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 24px 0;
  }

  .feature-item {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  /* Animations */
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      transform: translateY(50px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes pulse-gold {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(204, 153, 51, 0.4);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(204, 153, 51, 0);
    }
  }

  /* Mobile responsive */
  @media (max-width: 640px) {
    .modal-body {
      padding: 30px 20px;
    }

    .modal-title {
      font-size: 24px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stat-value {
      font-size: 28px;
    }

    .proven-box {
      flex-direction: column;
      text-align: center;
    }

    .guide-features {
      grid-template-columns: 1fr;
    }

    .option-card {
      padding: 12px;
    }

    .option-icon {
      font-size: 28px;
    }

    .option-title {
      font-size: 15px;
    }

    .option-description {
      font-size: 12px;
    }

    .btn-primary {
      font-size: 16px;
      padding: 14px 20px;
    }
  }

  /* Coming Soon Badge */
  .coming-soon-badge {
    display: inline-block;
    background: #f59e0b;
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  /* Disabled state for option card */
  .option-card:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
  }

  .option-card:disabled:hover {
    transform: none;
    box-shadow: none;
    background: inherit;
  }
</style>

<script>
  // Exit intent detection with cookie persistence
  let modalShown = false;
  const currentPath = window.location.pathname;

  function hasSeenModal() {
    const hasDismissed = document.cookie.includes(
      `exitModalDismissed_${currentPath}=true`,
    );
    const hasConverted = document.cookie.includes("exitModalConverted=true");
    return hasDismissed || hasConverted;
  }

  function showExitModal() {
    if (modalShown || hasSeenModal()) return;

    const modal = document.getElementById("exitModal");
    if (modal) {
      modal.style.display = "flex";
      modalShown = true;
      console.log("🚪 Exit modal shown - exit intent detected");

      if (typeof window.gtag !== "undefined") {
        window.gtag("event", "exit_modal_shown", {
          event_category: "Provider",
          event_label: "Exit Intent",
        });
      }
    }
  }

  function closeModal(isConversion = false) {
    const modal = document.getElementById("exitModal");
    if (modal) {
      modal.style.display = "none";
      console.log("🚪 Exit modal closed");

      if (isConversion) {
        document.cookie = `exitModalConverted=true; max-age=${90 * 24 * 60 * 60}; path=/`;
        console.log("✅ Conversion cookie set - modal suppressed for 90 days");
      } else {
        document.cookie = `exitModalDismissed_${currentPath}=true; max-age=${7 * 24 * 60 * 60}; path=/`;
        console.log(
          "⏸️ Dismissal cookie set - modal suppressed for 7 days on this page",
        );
      }
    }
  }

  function showView(viewId: string) {
    ["mainView", "analysisView", "guideView", "successView"].forEach((id) => {
      const view = document.getElementById(id);
      if (view) view.style.display = "none";
    });

    const view = document.getElementById(viewId);
    if (view) view.style.display = "block";
  }

  // ✅ ADD THIS ENTIRE FUNCTION
  function formatPhoneNumber(input: HTMLInputElement) {
    // Get only numbers from input
    let phoneNumber = input.value.replace(/\D/g, "");

    // Limit to 10 digits
    phoneNumber = phoneNumber.substring(0, 10);

    // Format based on length
    let formatted = "";

    if (phoneNumber.length === 0) {
      formatted = "";
    } else if (phoneNumber.length <= 3) {
      formatted = `(${phoneNumber}`;
    } else if (phoneNumber.length <= 6) {
      formatted = `(${phoneNumber.slice(0, 3)}) ${phoneNumber.slice(3)}`;
    } else {
      formatted = `(${phoneNumber.slice(0, 3)}) ${phoneNumber.slice(3, 6)}-${phoneNumber.slice(6)}`;
    }

    input.value = formatted;
  }

  // Desktop exit intent
  document.addEventListener("mouseleave", (e) => {
    const scrollPercent =
      (window.scrollY /
        (document.documentElement.scrollHeight - window.innerHeight)) *
      100;

    if (
      e.clientY <= 0 &&
      scrollPercent > 25 &&
      !modalShown &&
      !hasSeenModal()
    ) {
      console.log("🎯 Exit intent detected - showing modal");
      setTimeout(() => {
        showExitModal();
      }, 100);
    }
  });

  // Mobile exit intent
  let pageLoadTime = Date.now();
  let lastScrollY = 0;
  let rapidScrollToTopCount = 0;

  if (window.innerWidth <= 768) {
    window.addEventListener("scroll", () => {
      const currentScrollY = window.scrollY;
      const timeOnPage = (Date.now() - pageLoadTime) / 1000;

      if (currentScrollY < 10 && lastScrollY > 100 && timeOnPage > 10) {
        rapidScrollToTopCount++;

        if (rapidScrollToTopCount >= 2 && !modalShown && !hasSeenModal()) {
          console.log("🎯 Mobile exit intent detected - showing modal");
          showExitModal();
        }

        setTimeout(() => {
          rapidScrollToTopCount = 0;
        }, 3000);
      }

      lastScrollY = currentScrollY;
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    // Close button
    const closeBtn = document.querySelector(".modal-close");
    if (closeBtn) {
      closeBtn.addEventListener("click", () => closeModal(false));
    }

    // Risk waiting button
    const riskBtn = document.getElementById("riskWaitingBtn");
    if (riskBtn) {
      riskBtn.addEventListener("click", () => closeModal(false));
    }

    // Overlay click
    const overlay = document.querySelector(".modal-overlay");
    if (overlay) {
      overlay.addEventListener("click", () => closeModal(false));
    }

    // Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeModal(false);
      }
    });

    // Option card handlers
    const optionCards = document.querySelectorAll(".option-card");
    optionCards.forEach((card) => {
      card.addEventListener("click", () => {
        const option = card.getAttribute("data-option");

        if (option === "schedule") {
          if (typeof window.gtag !== "undefined") {
            window.gtag("event", "schedule_call_clicked", {
              event_category: "Provider",
              event_label: "Exit Modal",
            });
          }
          window.open("https://cal.com/usrad/15min", "_blank");
          closeModal(true);
        } else if (option === "analysis") {
          showView("analysisView");
          if (typeof window.gtag !== "undefined") {
            window.gtag("event", "market_analysis_view", {
              event_category: "Provider",
              event_label: "Exit Modal",
            });
          }
        } else if (option === "guide") {
          showView("guideView");
          if (typeof window.gtag !== "undefined") {
            window.gtag("event", "guide_download_view", {
              event_category: "Provider",
              event_label: "Exit Modal",
            });
          }
        }
      });
    });

    // Back buttons
    const backFromAnalysis = document.getElementById("backFromAnalysis");
    if (backFromAnalysis) {
      backFromAnalysis.addEventListener("click", () => showView("mainView"));
    }

    const backFromGuide = document.getElementById("backFromGuide");
    if (backFromGuide) {
      backFromGuide.addEventListener("click", () => showView("mainView"));
    }

    // Analysis form submission
    const analysisForm = document.getElementById("analysisForm");
    if (analysisForm) {
      analysisForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const submitBtn = analysisForm.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Generating...";
        }

        const formData = new FormData(analysisForm);
        const data = Object.fromEntries(formData.entries());

        try {
          const response = await fetch("/api/market-analysis", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              ...data,
              source: "exit_modal",
              timestamp: new Date().toISOString(),
            }),
          });

          if (response.ok) {
            if (typeof window.gtag !== "undefined") {
              window.gtag("event", "market_analysis_requested", {
                event_category: "Provider",
                event_label: "Exit Modal",
                value: 1,
              });
            }

            const successMsg = document.getElementById("successMessage");
            if (successMsg) {
              successMsg.textContent =
                "We've sent your personalized market analysis to your email. You should receive it within 24 hours.";
            }
            showView("successView");

            // ✅ Show success for 3 seconds, then close with conversion cookie
            setTimeout(() => {
              closeModal(true);
            }, 3000);
          } else {
            alert(
              "Something went wrong. Please try again or contact us directly.",
            );
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML =
                'Generate My Analysis <svg class="btn-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>';
            }
          }
        } catch (error) {
          console.error("Error:", error);
          alert(
            "Something went wrong. Please try again or contact us directly.",
          );
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML =
              'Generate My Analysis <svg class="btn-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>';
          }
        }
      });
    }

    // Guide form submission
    const guideForm = document.getElementById("guideForm");
    if (guideForm) {
      guideForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const submitBtn = guideForm.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Sending...";
        }

        const formData = new FormData(guideForm);
        const data = Object.fromEntries(formData.entries());

        try {
          const response = await fetch("/api/guide-download", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              ...data,
              source: "exit_modal",
              timestamp: new Date().toISOString(),
            }),
          });

          if (response.ok) {
            if (typeof window.gtag !== "undefined") {
              window.gtag("event", "guide_download_requested", {
                event_category: "Provider",
                event_label: "Exit Modal",
                value: 1,
              });
            }

            const successMsg = document.getElementById("successMessage");
            if (successMsg) {
              successMsg.textContent =
                "Success! Check your email for the download link to your Cash-Pay Imaging Guide. It should arrive within a few minutes.";
            }
            showView("successView");

            // ✅ Show success for 3 seconds, then close with conversion cookie
            setTimeout(() => {
              closeModal(true);
            }, 3000);
          } else {
            alert(
              "Something went wrong. Please try again or contact us directly.",
            );
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML =
                'Download Guide <svg class="btn-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M10 3a1 1 0 011 1v9.586l2.293-2.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 13.586V4a1 1 0 011-1z"></path><path d="M4 16a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1z"></path></svg>';
            }
          }
        } catch (error) {
          console.error("Error:", error);
          alert(
            "Something went wrong. Please try again or contact us directly.",
          );
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML =
              'Download Guide <svg class="btn-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M10 3a1 1 0 011 1v9.586l2.293-2.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 13.586V4a1 1 0 011-1z"></path><path d="M4 16a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1z"></path></svg>';
          }
        }
      });
    }

    // ✅ NEW: Phone number formatting
    const phoneInputs = document.querySelectorAll('input[type="tel"]');
    phoneInputs.forEach((input) => {
      input.addEventListener("input", (e) => {
        formatPhoneNumber(e.target as HTMLInputElement);
      });

      // Also format on paste
      input.addEventListener("paste", (e) => {
        setTimeout(() => {
          formatPhoneNumber(e.target as HTMLInputElement);
        }, 10);
      });
    });
    // ✅ END NEW BLOCK
  }); // ← Closes DOMContentLoaded
</script>
