---
const REMIX_URL =
  import.meta.env.PUBLIC_REMIX_URL || "https://usrad-portal.vercel.app";
// FoundingPartners.astro
// Placeholder component — holds the testimonial position in the provider page
// journey until founding partners are onboarded and can speak on record.
//
// TO REPLACE WITH REAL TESTIMONIALS:
// 1. Remove the three placeholder benefit cards
// 2. Replace with attributed provider quote cards (name, title, center, quote)
// 3. Keep the section header, statement strip, and CTA block unchanged
---

<!-- Founding Partners / Testimonial Placeholder -->
<section id="founding-partners" class="py-24 px-4 sm:px-6 bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16" data-aos="fade-up">
      <div
        class="inline-flex items-center gap-2 bg-[#cc9933]/10 px-5 py-2.5 rounded-full mb-6"
      >
        <span class="w-2 h-2 bg-[#cc9933] rounded-full animate-pulse"></span>
        <span
          class="text-[#cc9933] font-semibold text-sm tracking-wide uppercase"
          >Market Formation Phase</span
        >
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-[#003087] mb-4">
        Early Market Position Determines Long-Term Visibility
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        Each market is established with a limited number of initial providers.
        Centers that join early capture preferred placement and volume priority
        — before performance baselines are set across the network.
      </p>
    </div>

    <!-- Three standard benefit cards -->
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <!-- Card 1 — Early Volume Allocation -->
      <div
        class="bg-white rounded-2xl shadow-md border border-gray-100 hover:border-[#cc9933] hover:shadow-xl transition-all duration-300 p-8"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div
          class="w-12 h-12 bg-[#E8EDF5] rounded-xl flex items-center justify-center mb-5"
        >
          <svg
            class="w-6 h-6 text-[#003087]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[#003087] mb-2">
          Early Volume Allocation
        </h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Early partners receive initial patient flow, building the performance
          history that supports stronger recommendation placement as the network
          grows.
        </p>
      </div>

      <!-- Card 2 — Market Position Visibility -->
      <div
        class="bg-white rounded-2xl shadow-md border border-gray-100 hover:border-[#cc9933] hover:shadow-xl transition-all duration-300 p-8"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div
          class="w-12 h-12 bg-[#E8EDF5] rounded-xl flex items-center justify-center mb-5"
        >
          <svg
            class="w-6 h-6 text-[#003087]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
            ></path>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[#003087] mb-2">
          Market Position Visibility
        </h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Early providers gain visibility into how performance translates into
          ranking within their specific market environment.
        </p>
      </div>

      <!-- Card 3 — Network Formation Access -->
      <div
        class="bg-white rounded-2xl shadow-md border border-gray-100 hover:border-[#cc9933] hover:shadow-xl transition-all duration-300 p-8"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div
          class="w-12 h-12 bg-[#E8EDF5] rounded-xl flex items-center justify-center mb-5"
        >
          <svg
            class="w-6 h-6 text-[#003087]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
            ></path>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[#003087] mb-2">
          Network Formation Access
        </h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Early providers participate in the operational shaping of the network,
          influencing service expectations and baseline standards.
        </p>
      </div>
    </div>

    <!-- Transition line -->
    <div class="text-center mb-8" data-aos="fade-up">
      <p class="text-[#003087] font-semibold text-lg">
        The mechanism that defines long-term market position:
      </p>
    </div>

    <!-- Featured Card — Priority Recommendation Placement -->
    <div
      class="relative bg-gradient-to-r from-[#003087] to-[#002266] rounded-2xl p-8 md:p-10 mb-16 overflow-hidden"
      data-aos="fade-up"
      data-aos-delay="200"
    >
      <!-- Background texture -->
      <div class="absolute inset-0 opacity-5">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern
              id="grid"
              width="32"
              height="32"
              patternUnits="userSpaceOnUse"
            >
              <path
                d="M 32 0 L 0 0 0 32"
                fill="none"
                stroke="white"
                stroke-width="1"></path>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid)"></rect>
        </svg>
      </div>

      <div
        class="relative z-10 flex flex-col md:flex-row md:items-center gap-8"
      >
        <!-- Icon + label -->
        <div class="flex-shrink-0">
          <div
            class="w-16 h-16 bg-[#cc9933] rounded-2xl flex items-center justify-center shadow-lg"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
              ></path>
            </svg>
          </div>
        </div>

        <!-- Content -->
        <div class="flex-1">
          <div
            class="inline-flex items-center gap-2 bg-[#cc9933]/20 border border-[#cc9933]/30 rounded-full px-4 py-1 mb-3"
          >
            <span class="w-1.5 h-1.5 bg-[#cc9933] rounded-full"></span>
            <span
              class="text-[#cc9933] text-xs font-semibold uppercase tracking-wider"
              >Pre-Benchmark Phase</span
            >
          </div>
          <h3
            class="text-2xl md:text-3xl font-bold text-white mb-3 leading-tight"
          >
            Priority Recommendation Placement
          </h3>
          <p class="text-blue-100 leading-relaxed max-w-2xl">
            Centers that price competitively earn preferred placement in patient
            recommendations — positioning that becomes increasingly difficult to
            achieve once market benchmarks are established.
          </p>
          <p class="text-blue-300 text-sm mt-3">
            This is how patient volume is distributed across the network.
          </p>
          <a
            href="/provider/smartmatch"
            class="inline-flex items-center gap-1.5 text-[#cc9933] text-sm font-semibold mt-4 hover:text-white transition-colors duration-200"
          >
            See how recommendations work
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>

        <!-- Right stat -->
        <div class="flex-shrink-0 text-center md:text-right">
          <div class="text-4xl font-bold text-[#cc9933] leading-none mb-2">
            Day 1
          </div>
          <div class="text-blue-200 text-sm leading-snug">
            Position established<br />before competitors enter
          </div>
        </div>
      </div>
    </div>

    <!-- Statement strip -->
    <div
      class="bg-gradient-to-r from-[#003087] to-[#0052cc] rounded-2xl p-8 md:p-10 text-white text-center mb-12"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      <div
        class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-5 py-2 mb-6"
      >
        <span class="relative flex h-2.5 w-2.5">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#cc9933] opacity-75"
          ></span>
          <span
            class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#cc9933]"
          ></span>
        </span>
        <span class="text-sm font-medium text-white"
          >Now enrolling in priority markets</span
        >
      </div>
      <p
        class="text-2xl md:text-3xl font-bold mb-4 max-w-3xl mx-auto leading-snug"
      >
        Market capacity is intentionally limited during formation.
      </p>
      <p class="text-lg text-blue-100 max-w-2xl mx-auto">
        Centers that join early establish the strongest market position —
        capturing volume priority and preferred placement before benchmarks are
        set. Early partners shape the network. Late entrants adapt to it.
      </p>
    </div>

    <!-- Scarcity validation callout — routes to network map before applying -->
    <div
      class="max-w-2xl mx-auto mb-10 bg-white border border-gray-200 rounded-xl p-6"
      data-aos="fade-up"
    >
      <p class="text-gray-700 text-sm leading-relaxed mb-3">
        Markets are forming quickly. Some are already active — others are still
        unclaimed. Before you apply, take a moment to see what your market
        actually looks like.
      </p>
      <a
        href="/provider/network-map"
        class="inline-flex items-center gap-1.5
      text-[#003087] font-semibold text-sm hover:text-[#002266]
      transition-colors duration-200 border-b border-[#003087]/25
      hover:border-[#003087]/55 pb-px"
      >
        Check Market Availability →
      </a>
    </div>

    <!-- CTA -->
    <div class="text-center" data-aos="fade-up">
      <a
        href={`${REMIX_URL}/signup?source=provider`}
        class="inline-flex items-center gap-3 bg-[#cc9933] text-[#003087] px-12 py-5
    rounded-xl font-bold text-lg hover:shadow-2xl transition-all shadow-lg"
      >
        <span>Establish Your Position</span>
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
      <p class="text-gray-500 mt-4 text-sm">
        $0 to join · No volume commitments · accredited centers
      </p>
    </div>
  </div>
</section>
