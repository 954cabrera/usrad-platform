---
// src/components/provider/MarketOpportunityTeaser.astro
// ─────────────────────────────────────────────────────
// Provider Network Map — Decision Teaser Section
// Positioned after HowItWorks / PriorityMarketsMap replacement
// Routes providers to /provider/network-map before applying
//
// Design contract:
//   §7.3  No gradients on content surfaces
//   §8.1  Gold: CTA only (B2B recruitment context)
//   §2.5  No blue-*, indigo-*, slate-* tokens
//   §15.3 No animations
// ─────────────────────────────────────────────────────
---

<section
  id="market-map-teaser"
  class="bg-gray-50 border-t border-gray-200 py-20 px-4 sm:px-6"
  data-aos="fade-up"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- ── LEFT: Copy ─────────────────────────────── -->
      <div>
        <!-- Eyebrow badge -->
        <div
          class="inline-flex items-center gap-2 bg-[#E8EDF5] border border-[#003087]/15 rounded-full px-4 py-1.5 mb-6"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#003087]"></span>
          <span
            class="text-xs font-semibold text-[#003087] tracking-widest uppercase"
          >
            Network Intelligence
          </span>
        </div>

        <h2
          class="text-4xl sm:text-5xl font-bold text-gray-900 leading-[1.08] tracking-tight mb-5"
        >
          See Your Market<br />
          <span class="text-[#003087]">Before You Join.</span>
        </h2>

        <p class="text-lg text-gray-600 leading-relaxed mb-8 max-w-md">
          Every cluster represents ACR-accredited imaging centers already
          operating in your area. Some markets are forming. Others are still
          unclaimed. Before you decide, see where USRad is building — and where
          your position is still open.
        </p>

        <!-- Three-step explanation -->
        <div class="space-y-3 mb-10">
          {
            [
              {
                n: "1",
                label: "Select your state",
                sub: "Florida is live. More activating soon.",
              },
              {
                n: "2",
                label: "Choose your modality",
                sub: "MRI, CT, Ultrasound, and more.",
              },
              {
                n: "3",
                label: "Click a cluster to inspect",
                sub: "See exactly how many centers — and whether your market is unclaimed.",
              },
            ].map((step) => (
              <div class="flex items-start gap-4">
                <div class="w-7 h-7 rounded-full bg-[#003087] text-white text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">
                  {step.n}
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900">
                    {step.label}
                  </p>
                  <p class="text-sm text-gray-500">{step.sub}</p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- CTAs -->
        <div class="flex items-center gap-4 flex-wrap">
          <!--
            Gold CTA — §8.1 B2B recruitment context
            Max 2 gold per viewport — this is the only one in this section
          -->
          <a
            href="/provider/network-map"
            class="inline-flex items-center gap-2 bg-[#C9A24D] hover:bg-[#b8901f] text-white font-semibold px-7 py-3.5 rounded-lg transition-colors duration-200"
          >
            Explore Your Market
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>

          <a
            href="/provider/smartmatch"
            class="text-[#003087] hover:text-[#002266] font-medium text-sm border-b border-[#003087]/25 hover:border-[#003087]/55 pb-px transition-colors duration-200"
          >
            See how ranking works →
          </a>
        </div>
      </div>

      <!-- ── RIGHT: Map preview card ────────────────── -->
      <div class="relative">
        <!-- Outer card — canonical §5.1 pattern -->
        <div
          class="bg-white rounded-2xl border border-gray-200 shadow-lg overflow-hidden"
        >
          <!-- Card header — navy bar -->
          <div class="bg-[#003087] px-5 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#C9A24D]"></span>
              <span
                class="text-xs font-semibold text-white/80 tracking-widest uppercase"
              >
                USRad Network Map
              </span>
            </div>
            <span class="text-xs text-white/40">Florida · MRI</span>
          </div>

          <!-- Map preview — static visual representation -->
          <div
            class="relative bg-[#E8EFF8] overflow-hidden"
            style="height: 280px;"
          >
            <!-- Simulated map background grid -->
            <div
              class="absolute inset-0 opacity-[0.08]"
              style="background-image: linear-gradient(#003087 1px, transparent 1px), linear-gradient(90deg, #003087 1px, transparent 1px); background-size: 40px 40px;"
            >
            </div>

            <!-- Florida silhouette hint — abstract shape -->
            <div
              class="absolute opacity-20"
              style="
                top: 15%;
                left: 30%;
                width: 38%;
                height: 65%;
                background: #94A3B8;
                border-radius: 4px 4px 30% 8%;
                transform: rotate(-2deg);
              "
            >
            </div>

            <!-- Simulated navy clusters — representative positions -->
            {
              [
                { top: "18%", left: "52%", count: "16", size: "large" },
                { top: "28%", left: "44%", count: "7", size: "medium" },
                { top: "38%", left: "56%", count: "11", size: "large" },
                { top: "42%", left: "38%", count: "26", size: "xlarge" },
                { top: "52%", left: "48%", count: "10", size: "medium" },
                { top: "60%", left: "60%", count: "5", size: "small" },
                { top: "68%", left: "52%", count: "24", size: "large" },
                { top: "72%", left: "64%", count: "38", size: "xlarge" },
                { top: "30%", left: "62%", count: "3", size: "small" },
                { top: "55%", left: "34%", count: "13", size: "medium" },
              ].map((c) => {
                const sz =
                  c.size === "xlarge"
                    ? "48px"
                    : c.size === "large"
                      ? "42px"
                      : c.size === "medium"
                        ? "36px"
                        : "30px";
                const fs =
                  c.size === "xlarge"
                    ? "13px"
                    : c.size === "large"
                      ? "12px"
                      : "11px";
                return (
                  <div
                    style={`
                    position: absolute;
                    top: ${c.top};
                    left: ${c.left};
                    width: ${sz};
                    height: ${sz};
                    border-radius: 50%;
                    background: #1E3A5F;
                    opacity: 0.88;
                    border: 1.5px solid #2D5A8E;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
                    transform: translate(-50%, -50%);
                  `}
                  >
                    <span
                      style={`color: white; font-size: ${fs}; font-weight: 700; font-family: Arial, sans-serif;`}
                    >
                      {c.count}
                    </span>
                  </div>
                );
              })
            }

            <!-- Simulated gold contracted pin — Orlando area -->
            <div
              style="
                position: absolute;
                top: 38%;
                left: 56%;
                transform: translate(-50%, -100%);
                filter: drop-shadow(0 3px 6px rgba(0,0,0,0.25));
              "
            >
              <svg
                width="20"
                height="26"
                viewBox="0 0 12 15"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M 6 14.5 C 6 14.5 1 10 1 6 A 5 5 0 1 1 11 6 C 11 10 6 14.5 6 14.5 Z"
                  fill="#CC9933"
                  stroke="white"
                  stroke-width="1"></path>
                <circle cx="6" cy="6" r="3.2" fill="white" opacity="0.95"
                ></circle>
              </svg>
            </div>

            <!-- "Live" badge overlay -->
            <div
              class="absolute top-3 left-3 bg-white/90 rounded-full px-2.5 py-1 flex items-center gap-1.5 shadow-sm"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
              <span class="text-xs font-semibold text-gray-700"
                >Florida Active</span
              >
            </div>

            <!-- CTA overlay hint -->
            <div
              class="absolute bottom-3 right-3 bg-white/90 rounded-lg px-3 py-1.5 shadow-sm"
            >
              <span class="text-xs font-medium text-[#003087]"
                >Click cluster → See market signal</span
              >
            </div>
          </div>

          <!-- Card footer — stat strip -->
          <div
            class="px-5 py-3 bg-gray-50 border-t border-gray-100 flex items-center justify-between"
          >
            <div class="flex items-center gap-3 text-xs text-gray-500">
              <span class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-[#CC9933] inline-block"
                ></span>
                5 USRad partners
              </span>
              <span class="text-gray-300">·</span>
              <span class="flex items-center gap-1.5">
                <span
                  class="w-2.5 h-2.5 rounded-full bg-[#1E3A5F] opacity-80 inline-block"
                ></span>
                520 MRI centers mapped
              </span>
            </div>
            <a
              href="/provider/network-map"
              class="text-xs font-semibold text-[#003087] hover:text-[#002266] transition-colors duration-200"
            >
              Open full map →
            </a>
          </div>
        </div>

        <!-- Floating label — positioned bottom-left of card -->
        <div
          class="absolute -bottom-4 -left-4 bg-white border border-gray-200 rounded-lg shadow-md px-4 py-2.5 hidden lg:block"
        >
          <p class="text-xs font-semibold text-gray-900">Market Intelligence</p>
          <p class="text-xs text-gray-500">Live · Updated daily</p>
        </div>
      </div>
    </div>
  </div>
</section>
