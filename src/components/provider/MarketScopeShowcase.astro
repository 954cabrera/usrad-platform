          name: "MRI Lumbar",
          medicare: "$183",
          vol: "$220",
          bal: "$275",
          prem: "$329",
        },
        {
          code: "73721",
          name: "MRI Knee w/o",
          medicare: "$163",
          vol: "$196",
          bal: "$245",
          prem: "$293",
        },
      ],
    },
  };

  function updateMarketDisplay(marketKey) {
    const data = marketData[marketKey];
    if (!data) return;

    // Update header
    document.getElementById("market-title").textContent = data.facilityName;
    document.getElementById("market-address").textContent = data.address;

    // Update Market Reality panel
    document.getElementById("market-area-name").textContent =
      `${data.city}, ${data.state}`;
    document.getElementById("total-competitors").textContent =
      data.totalCompetitors;
    document.getElementById("mri-competitors").textContent =
      data.mriCompetitors;
    document.getElementById("market-density").textContent = data.density;

    // Update modality bars
    const maxModality = Math.max(
      data.modalities.mri,
      data.modalities.ct,
      data.modalities.us,
      data.modalities.xray,
    );
    document.getElementById("bar-mri").style.width =
      `${(data.modalities.mri / maxModality) * 100}%`;
    document.getElementById("bar-ct").style.width =
      `${(data.modalities.ct / maxModality) * 100}%`;
    document.getElementById("bar-us").style.width =
      `${(data.modalities.us / maxModality) * 100}%`;
    document.getElementById("bar-xray").style.width =
      `${(data.modalities.xray / maxModality) * 100}%`;

    document.getElementById("count-mri").textContent = data.modalities.mri;
    document.getElementById("count-ct").textContent = data.modalities.ct;
    document.getElementById("count-us").textContent = data.modalities.us;
    document.getElementById("count-xray").textContent = data.modalities.xray;

    // Update competitors list
    const competitorList = document.getElementById("competitor-list");
    competitorList.innerHTML = data.competitors
      .map(
        (comp, i) => `
      <div class="competitor-item">
        <span class="rank">${i + 1}</span>
        <div class="competitor-info">
          <span class="name">${comp.name}</span>
          <span class="services">${comp.services}</span>
        </div>
        <span class="distance">${comp.distance}</span>
      </div>
    `,
      )
      .join("");

    // Update Economics panel
    document.getElementById("medicare-baseline").textContent = data.medicare;
    document.getElementById("workers-comp").textContent = data.workersComp;
    document.getElementById("workers-comp-pct").textContent =
      data.workersCompPct;
    document.getElementById("market-opportunity").textContent = data.marketOpp;

    // Update pricing table
    const pricingBody = document.getElementById("pricing-table-body");
    const highlightCol =
      data.recommendedStrategy === "premium" ? "prem" : "vol";
    pricingBody.innerHTML = data.pricing
      .map(
        (proc) => `
      <tr>
        <td>${proc.code} - ${proc.name}</td>
        <td>${proc.medicare}</td>
        <td class="${highlightCol === "vol" ? "highlight-cell" : ""}">${proc.vol}</td>
        <td class="${data.recommendedStrategy === "balanced" ? "highlight-cell" : ""}">${proc.bal}</td>
        <td class="${highlightCol === "prem" ? "highlight-cell" : ""}">${proc.prem}</td>
      </tr>
    `,
      )
      .join("");

    // Update Strategy panel
    const volumeCard = document.getElementById("volume-strategy-card");
    const premiumCard = document.getElementById("premium-strategy-card");
    const volumeBadge = document.getElementById("volume-badge");
    const premiumBadge = document.getElementById("premium-badge");

    volumeCard.classList.remove("recommended");
    premiumCard.classList.remove("recommended");
    volumeBadge.style.display = "none";
    premiumBadge.style.display = "none";

    if (
      data.recommendedStrategy === "volume" ||
      data.recommendedStrategy === "balanced"
    ) {
      volumeCard.classList.add("recommended");
      volumeBadge.style.display = "block";
    }
    if (data.recommendedStrategy === "premium") {
      premiumCard.classList.add("recommended");
      premiumBadge.style.display = "block";
    }

    // Update recommendation
    document.getElementById("rec-market-name").textContent = data.city;
    document.getElementById("rec-competitors").textContent =
      data.totalCompetitors;
    document.getElementById("rec-density").textContent = data.density;
    document.getElementById("rec-strategy").textContent = data.strategyRange;
  }

  document.addEventListener("DOMContentLoaded", () => {
    // Initialize with Miami
    updateMarketDisplay("miami");

    // Market selector change handler
    const marketSelect = document.getElementById("market-select");
    marketSelect.addEventListener("change", (e) => {
      updateMarketDisplay(e.target.value);
    });

    // Tab switching functionality
    const tabs = document.querySelectorAll(".tab");
    const panels = document.querySelectorAll(".tab-panel");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const targetTab = tab.getAttribute("data-tab");
        tabs.forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        panels.forEach((panel) => {
          panel.classList.remove("active");
          if (panel.id === `panel-${targetTab}`) {
            panel.classList.add("active");
          }
        });
      });
    });

    // Listen for market selection from the Priority Markets Map
    window.addEventListener("usrad:selectMarket", (e) => {
      const marketKey = e.detail?.market?.toLowerCase();
      if (marketKey && marketData[marketKey]) {
        marketSelect.value = marketKey;
        updateMarketDisplay(marketKey);
        document.getElementById("market-analysis").scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }
    });

    // Expose global function for direct calls from map or other components
    window.USRadMarketScope = {
      selectMarket: (marketKey) => {
        const key = marketKey.toLowerCase();
        if (marketData[key]) {
          marketSelect.value = key;
          updateMarketDisplay(key);
          document.getElementById("market-analysis").scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }
      },
      // Get available markets
      getMarkets: () => Object.keys(marketData),
      // Check if a market exists
      hasMarket: (key) => !!marketData[key?.toLowerCase()],
    };
  });
</script>
