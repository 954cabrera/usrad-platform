---
// MarketScopeShowcase.astro
// Showcases USRad MarketScope™ intelligence features for prospective providers
---

<section id="market-analysis" class="marketscope-section">
  <!-- Decorative background elements -->
  <div class="bg-pattern"></div>
  <div class="gradient-orb gradient-orb-1"></div>
  <div class="gradient-orb gradient-orb-2"></div>

  <div class="container">
    <!-- Section Header -->
    <div class="section-header" data-aos="fade-up">
      <span class="badge">Intelligence Platform</span>
      <h2>USRad MarketScope<sup>™</sup></h2>
      <p class="subtitle">
        Data-driven insights to maximize your imaging center's revenue
        potential. Know your market before you set your prices.
      </p>
    </div>

    <!-- Main Feature Showcase -->
    <div class="showcase-grid">
      <!-- Left Column: Interactive Preview -->
      <div class="preview-column" data-aos="fade-right" data-aos-delay="100">
        <div class="preview-window">
          <div class="window-header">
            <div class="window-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="window-title">MarketScope™ Analysis</span>
          </div>

          <div class="window-content">
            <!-- Tab Navigation -->
            <div class="preview-tabs">
              <button class="tab active" data-tab="market">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="10" r="3"></circle>
                  <path
                    d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 7 8 11.7z"
                  ></path>
                </svg>
                Market Reality
              </button>
              <button class="tab" data-tab="economics">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                  ></path>
                </svg>
                Economics
              </button>
              <button class="tab" data-tab="strategy">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                </svg>
                Strategy
              </button>
            </div>

            <!-- Market Reality Panel -->
            <div class="tab-panel active" id="panel-market">
              <div class="panel-header">
                <h4>Market Reality - Sample Area</h4>
                <span class="powered-by">Powered by USRad MarketScope™</span>
              </div>

              <div class="metrics-row">
                <div class="metric-card highlight-blue">
                  <span class="metric-value">165</span>
                  <span class="metric-label">Total Competitors</span>
                  <span class="metric-sublabel">10 mile radius</span>
                </div>
                <div class="metric-card highlight-purple">
                  <span class="metric-value">27</span>
                  <span class="metric-label">MRI Competitors</span>
                  <span class="metric-sublabel">10 mile radius</span>
                </div>
                <div class="metric-card highlight-amber">
                  <span class="metric-value-text">Very High</span>
                  <span class="metric-label">Market Density</span>
                  <span class="metric-sublabel">Competitive positioning</span>
                </div>
              </div>

              <div class="modality-breakdown">
                <h5>Modality Breakdown</h5>
                <div class="modality-bars">
                  <div class="modality-item">
                    <span class="modality-name">MRI</span>
                    <div class="bar-container">
                      <div class="bar" style="width: 24%"></div>
                    </div>
                    <span class="modality-count">27</span>
                  </div>
                  <div class="modality-item">
                    <span class="modality-name">CT</span>
                    <div class="bar-container">
                      <div class="bar bar-ct" style="width: 22%"></div>
                    </div>
                    <span class="modality-count">25</span>
                  </div>
                  <div class="modality-item">
                    <span class="modality-name">Ultrasound</span>
                    <div class="bar-container">
                      <div class="bar bar-us" style="width: 8%"></div>
                    </div>
                    <span class="modality-count">9</span>
                  </div>
                  <div class="modality-item">
                    <span class="modality-name">X-Ray</span>
                    <div class="bar-container">
                      <div class="bar bar-xray" style="width: 100%"></div>
                    </div>
                    <span class="modality-count">113</span>
                  </div>
                </div>
              </div>

              <div class="competitor-preview">
                <h5>Top Nearby Competitors</h5>
                <div class="competitor-list">
                  <div class="competitor-item">
                    <span class="rank">1</span>
                    <div class="competitor-info">
                      <span class="name">Regional Medical Imaging</span>
                      <span class="services">MRI, CT Scan</span>
                    </div>
                    <span class="distance">2.4 mi</span>
                  </div>
                  <div class="competitor-item">
                    <span class="rank">2</span>
                    <div class="competitor-info">
                      <span class="name">Advanced Diagnostic Center</span>
                      <span class="services">MRI, CT, Ultrasound</span>
                    </div>
                    <span class="distance">2.6 mi</span>
                  </div>
                  <div class="competitor-item">
                    <span class="rank">3</span>
                    <div class="competitor-info">
                      <span class="name">Metro Imaging Associates</span>
                      <span class="services">MRI, Ultrasound</span>
                    </div>
                    <span class="distance">2.7 mi</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Economics Panel -->
            <div class="tab-panel" id="panel-economics">
              <div class="panel-header">
                <h4>Economic Analysis</h4>
                <span class="powered-by">Medicare + Market Pricing</span>
              </div>

              <div class="pricing-cards">
                <div class="pricing-card">
                  <span class="pricing-label">Medicare Baseline</span>
                  <span class="pricing-value">$201.65</span>
                  <span class="pricing-detail">100% Medicare Rate</span>
                  <span class="pricing-code"
                    >MRI Brain w/o Contrast (70551)</span
                  >
                </div>
                <div class="pricing-card">
                  <span class="pricing-label">Workers' Comp</span>
                  <span class="pricing-value">$371</span>
                  <span class="pricing-detail">184% of Medicare</span>
                  <span class="pricing-code">Regional standard rate</span>
                </div>
                <div class="pricing-card highlight">
                  <span class="pricing-label">Market Opportunity</span>
                  <span class="pricing-value">$277-$429</span>
                  <span class="pricing-detail">Cash Market Range</span>
                  <span class="pricing-code">Competitive positioning</span>
                </div>
              </div>

              <div class="pricing-table-preview">
                <h5>Strategic Pricing by Procedure</h5>
                <table>
                  <thead>
                    <tr>
                      <th>Procedure</th>
                      <th>Medicare</th>
                      <th>Volume 120%</th>
                      <th>Balanced 150%</th>
                      <th>Premium 180%</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>70551 - MRI Brain w/o</td>
                      <td>$201.65</td>
                      <td class="highlight-cell">$242</td>
                      <td>$302</td>
                      <td>$363</td>
                    </tr>
                    <tr>
                      <td>72148 - MRI Lumbar</td>
                      <td>$192</td>
                      <td class="highlight-cell">$230</td>
                      <td>$288</td>
                      <td>$346</td>
                    </tr>
                    <tr>
                      <td>73721 - MRI Knee w/o</td>
                      <td>$171</td>
                      <td class="highlight-cell">$205</td>
                      <td>$257</td>
                      <td>$308</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Strategy Panel -->
            <div class="tab-panel" id="panel-strategy">
              <div class="panel-header">
                <h4>Pricing Strategy Recommendations</h4>
                <span class="powered-by">AI-Powered Analysis</span>
              </div>

              <div class="strategy-cards">
                <div class="strategy-card recommended">
                  <div class="strategy-badge">
                    Recommended for High Competition
                  </div>
                  <h5>Volume Strategy</h5>
                  <span class="strategy-range">120-130% Medicare</span>
                  <p>
                    Best for markets with 20+ competitors. Drives volume through
                    competitive pricing while maintaining reasonable margins.
                  </p>
                  <div class="expected-volume">
                    <span class="volume-label">Expected Volume</span>
                    <span class="volume-value">80-120 scans/month</span>
                  </div>
                </div>
                <div class="strategy-card">
                  <h5>Premium Strategy</h5>
                  <span class="strategy-range">180-200% Medicare</span>
                  <p>
                    Suitable for markets with low competition (under 10
                    competitors). Positions facility as premium service
                    provider.
                  </p>
                  <div class="expected-volume">
                    <span class="volume-label">Expected Volume</span>
                    <span class="volume-value">40-60 scans/month</span>
                  </div>
                </div>
              </div>

              <div class="market-recommendation">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"
                  ></path>
                  <path d="M12 16v-4M12 8h.01"></path>
                </svg>
                <div class="recommendation-content">
                  <strong>For this market:</strong> With 165 competitors and Very
                  High market density, consider a <span class="highlight"
                    >120-150% Medicare</span
                  > pricing strategy.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Features List -->
      <div class="features-column" data-aos="fade-left" data-aos-delay="200">
        <div class="feature-block">
          <div class="feature-icon">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="10" r="3"></circle>
              <path
                d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 7 8 11.7z"
              ></path>
            </svg>
          </div>
          <div class="feature-content">
            <h3>Competitor Intelligence</h3>
            <p>
              See every imaging center within your market radius. Know exactly
              who you're competing against, what modalities they offer, and how
              far they are from your location.
            </p>
            <ul class="feature-list">
              <li>PostGIS-powered 10-mile radius analysis</li>
              <li>Modality-specific competitor counts</li>
              <li>Market density classification</li>
            </ul>
          </div>
        </div>

        <div class="feature-block">
          <div class="feature-icon icon-green">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
              ></path>
            </svg>
          </div>
          <div class="feature-content">
            <h3>Medicare Pricing Database</h3>
            <p>
              Access 43,600+ Medicare pricing records across 113 localities. See
              exactly what Medicare pays for every CPT code in your specific
              geographic area.
            </p>
            <ul class="feature-list">
              <li>Real Medicare reimbursement rates</li>
              <li>Workers' compensation benchmarks</li>
              <li>Cash market opportunity analysis</li>
            </ul>
          </div>
        </div>

        <div class="feature-block">
          <div class="feature-icon icon-purple">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
          </div>
          <div class="feature-content">
            <h3>Strategic Pricing Engine</h3>
            <p>
              Get AI-powered recommendations based on your specific market
              conditions. Volume vs. premium strategies with projected scan
              volumes.
            </p>
            <ul class="feature-list">
              <li>Volume, balanced & premium tiers</li>
              <li>Competition-based recommendations</li>
              <li>Revenue projection modeling</li>
            </ul>
          </div>
        </div>

        <div class="cta-block">
          <p class="cta-text">
            <strong>Free with network membership.</strong> Get complete market intelligence
            for your facility during onboarding.
          </p>
          <a href="#priority-markets" class="cta-button">
            Apply for Priority Markets
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Stats Bar -->
    <div class="stats-bar" data-aos="fade-up" data-aos-delay="300">
      <div class="stat-item">
        <span class="stat-number">43,600+</span>
        <span class="stat-label">Medicare Pricing Records</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number">113</span>
        <span class="stat-label">Geographic Localities</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number">15,000+</span>
        <span class="stat-label">Facilities Analyzed</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number">Real-time</span>
        <span class="stat-label">Market Updates</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marketscope-section {
    position: relative;
    padding: 6rem 0;
    background: linear-gradient(180deg, #0a0f1a 0%, #111827 50%, #0a0f1a 100%);
    overflow: hidden;
  }

  .bg-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle at 1px 1px,
      rgba(99, 102, 241, 0.15) 1px,
      transparent 0
    );
    background-size: 40px 40px;
    opacity: 0.5;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.3;
  }

  .gradient-orb-1 {
    width: 600px;
    height: 600px;
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
    top: -200px;
    left: -200px;
  }

  .gradient-orb-2 {
    width: 500px;
    height: 500px;
    background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
    bottom: -150px;
    right: -150px;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(99, 102, 241, 0.2);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 100px;
    color: #a5b4fc;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .section-header h2 {
    font-family: "Inter", system-ui, sans-serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .section-header h2 sup {
    font-size: 0.5em;
    color: #f59e0b;
  }

  .subtitle {
    font-size: 1.25rem;
    color: #9ca3af;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Preview Window Styles */
  .preview-window {
    background: #1f2937;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 25px 50px -12px rgba(0, 0, 0, 0.5),
      0 0 100px rgba(99, 102, 241, 0.1);
  }

  .window-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: #111827;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .window-dots {
    display: flex;
    gap: 0.5rem;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot.red {
    background: #ef4444;
  }
  .dot.yellow {
    background: #f59e0b;
  }
  .dot.green {
    background: #22c55e;
  }

  .window-title {
    color: #9ca3af;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .window-content {
    padding: 0;
  }

  .preview-tabs {
    display: flex;
    gap: 0;
    background: #111827;
    padding: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: transparent;
    border: none;
    color: #6b7280;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.2s;
  }

  .tab:hover {
    color: #d1d5db;
    background: rgba(255, 255, 255, 0.05);
  }

  .tab.active {
    color: #ffffff;
    background: rgba(99, 102, 241, 0.2);
  }

  .tab svg {
    opacity: 0.7;
  }

  .tab.active svg {
    opacity: 1;
    stroke: #a5b4fc;
  }

  .tab-panel {
    display: none;
    padding: 1.5rem;
  }

  .tab-panel.active {
    display: block;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .panel-header h4 {
    color: #ffffff;
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }

  .powered-by {
    font-size: 0.75rem;
    color: #6b7280;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
  }

  /* Metrics Row */
  .metrics-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .metric-card {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1rem;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .metric-value {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .metric-value-text {
    display: block;
    font-size: 1.125rem;
    font-weight: 700;
    color: #f59e0b;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .metric-label {
    display: block;
    font-size: 0.75rem;
    color: #9ca3af;
    margin-bottom: 0.25rem;
  }

  .metric-sublabel {
    display: block;
    font-size: 0.625rem;
    color: #6b7280;
  }

  .highlight-blue .metric-value {
    color: #60a5fa;
  }
  .highlight-purple .metric-value {
    color: #a78bfa;
  }
  .highlight-amber .metric-value-text {
    color: #fbbf24;
  }

  /* Modality Breakdown */
  .modality-breakdown {
    margin-bottom: 1.5rem;
  }

  .modality-breakdown h5 {
    color: #9ca3af;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 1rem;
  }

  .modality-bars {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .modality-item {
    display: grid;
    grid-template-columns: 80px 1fr 40px;
    align-items: center;
    gap: 1rem;
  }

  .modality-name {
    color: #d1d5db;
    font-size: 0.875rem;
  }

  .bar-container {
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
  }

  .bar {
    height: 100%;
    background: linear-gradient(90deg, #3b82f6 0%, #60a5fa 100%);
    border-radius: 4px;
    transition: width 1s ease-out;
  }

  .bar-ct {
    background: linear-gradient(90deg, #8b5cf6 0%, #a78bfa 100%);
  }
  .bar-us {
    background: linear-gradient(90deg, #22c55e 0%, #4ade80 100%);
  }
  .bar-xray {
    background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 100%);
  }

  .modality-count {
    color: #9ca3af;
    font-size: 0.875rem;
    text-align: right;
    font-weight: 600;
  }

  /* Competitor Preview */
  .competitor-preview h5 {
    color: #9ca3af;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 1rem;
  }

  .competitor-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .competitor-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .rank {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(99, 102, 241, 0.2);
    color: #a5b4fc;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 50%;
  }

  .competitor-info {
    flex: 1;
    min-width: 0;
  }

  .competitor-info .name {
    display: block;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .competitor-info .services {
    display: block;
    color: #6b7280;
    font-size: 0.75rem;
  }

  .distance {
    color: #60a5fa;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Economics Panel */
  .pricing-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
