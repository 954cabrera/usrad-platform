---
const REMIX_URL =
  import.meta.env.PUBLIC_REMIX_URL || "https://usrad-portal.vercel.app";
// NetworkBuilding.astro - Be Part of Something Bigger section
---

<!-- Network Building -->
<section
  class="py-24 px-4 sm:px-6 bg-gradient-to-br from-slate-900 via-[#003087] to-black text-white"
>
  <div class="max-w-5xl mx-auto text-center">
    <div
      class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-6 py-3 mb-8"
      data-aos="fade-down"
    >
      <span class="relative flex h-3 w-3">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#cc9933] opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-[#cc9933]"
        ></span>
      </span>
      <span class="text-sm font-medium">Building our nationwide network</span>
    </div>

    <h2 class="text-4xl md:text-5xl font-bold mb-8" data-aos="fade-up">
      Be Part of Something Bigger
    </h2>

    <p
      class="text-xl text-gray-300 mb-12 max-w-3xl mx-auto"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      USRad is building the infrastructure layer that connects unused imaging
      capacity with patients who need access to care. Providers contribute
      capacity. Members receive guided access. USRad coordinates fulfillment.
    </p>

    <div
      class="max-w-3xl mx-auto mb-12 bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-8"
      data-aos="fade-up"
      data-aos-delay="150"
    >
      <p class="text-2xl md:text-3xl font-bold text-white leading-snug">
        USRad does not participate in the diagnostic imaging system.
      </p>
      <p class="text-2xl md:text-3xl font-bold text-[#cc9933] mt-2">
        USRad is the system.
      </p>
    </div>

    <!-- Simple network visualization -->
    <div
      class="relative max-w-4xl mx-auto mb-12"
      data-aos="zoom-in"
      data-aos-delay="200"
    >
      <div
        class="bg-white/10 backdrop-blur-sm rounded-2xl p-12 border border-[#cc9933]/30"
      >
        <div class="text-center">
          <p class="text-4xl md:text-6xl font-bold text-[#cc9933] mb-2">Market by Market</p>
          <p class="text-xl text-gray-400">Shaped by local conditions and demand</p>
        </div>
      </div>
    </div>

    <!-- Final CTA -->
    <div class="space-y-6" data-aos="fade-up" data-aos-delay="300">
      <a
        href={`${REMIX_URL}/signup?source=provider`}
        class="inline-flex items-center gap-3 bg-gradient-to-r from-[#cc9933] to-[#FFA500] text-[#003087] px-12 py-5 rounded-xl font-bold text-lg hover:shadow-2xl transition-all transform hover:scale-105 shadow-lg"
      >
        <span>Join the Network</span>
        <span>→</span>
      </a>

      <p class="text-gray-400">No obligations. No setup costs.</p>

      <div class="pt-6 border-t border-gray-700 mt-8">
        <p class="text-sm text-gray-500">
          Questions? Call
          <a
            href="tel:1-866-877-2324"
            class="text-[#cc9933] hover:text-[#FFA500] font-semibold transition-colors"
            >(866) USRad-24</a
          >
          or
          <a
            href="mailto:providers@usrad.com"
            class="text-[#cc9933] hover:text-[#FFA500] font-semibold transition-colors"
            >email our team</a
          >
        </p>
      </div>
    </div>
  </div>
</section>
