<!-- ===========================================
     src/components/provider/PricingBreakdown.astro
     Detailed pricing component for providers
     =========================================== -->

     ---
     export interface PricingBreakdownProps {
       pricing: {
         medicare_rate: number;
         patient_price: number;
         hospital_estimate: number;
         patient_savings: number;
         savings_percentage: number;
         usrad_fee?: number;
       };
       procedure?: string;
       size?: 'sm' | 'md' | 'lg';
       showComparison?: boolean;
       highlightSavings?: boolean;
     }
     
     const {
       pricing,
       procedure = 'Medical Imaging',
       size = 'md',
       showComparison = true,
       highlightSavings = true
     } = Astro.props;
     
     const usradFee = pricing.usrad_fee || (pricing.patient_price - pricing.medicare_rate);
     const savings = Math.round(pricing.patient_savings);
     const savingsPercent = Math.round(pricing.savings_percentage);
     
     const sizeClasses = {
       sm: 'text-sm',
       md: 'text-base',
       lg: 'text-lg'
     };
     ---
     
     <div class={`pricing-breakdown ${sizeClasses[size]}`}>
       {highlightSavings && (
         <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
           <div class="flex justify-between items-center mb-3">
             <span class="text-lg font-bold text-green-600">
               Your Price: ${Math.round(pricing.patient_price)}
             </span>
             <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-semibold">
               Save ${savings} ({savingsPercent}%)
             </span>
           </div>
           
           <!-- Detailed Breakdown -->
           <div class="space-y-2 text-sm">
             <div class="flex justify-between items-center">
               <span class="text-gray-600">Medicare Allowable Rate:</span>
               <span class="font-medium text-gray-900">${Math.round(pricing.medicare_rate)}</span>
             </div>
             
             <div class="flex justify-between items-center">
               <span class="text-gray-600">USRad Service Fee:</span>
               <span class="font-medium text-gray-900">$${Math.round(usradFee)}</span>
             </div>
             
             <div class="border-t pt-2 flex justify-between items-center font-semibold">
               <span class="text-gray-900">Total You Pay:</span>
               <span class="text-green-600 text-lg">${Math.round(pricing.patient_price)}</span>
             </div>
             
             {showComparison && (
               <div class="border-t pt-2 flex justify-between items-center text-red-600">
                 <span>Hospital Estimate:</span>
                 <span class="line-through">${Math.round(pricing.hospital_estimate)}</span>
               </div>
             )}
           </div>
         </div>
       )}
     
       <!-- What's Included -->
       <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
         <h4 class="font-semibold text-blue-900 mb-3">What's Included in Your ${Math.round(pricing.patient_price)} Payment:</h4>
         
         <ul class="space-y-2 text-sm text-blue-800">
           <li class="flex items-center">
             <span class="text-green-500 mr-2">✓</span>
             Complete {procedure} scan
           </li>
           <li class="flex items-center">
             <span class="text-green-500 mr-2">✓</span>
             Board-certified radiologist review
           </li>
           <li class="flex items-center">
             <span class="text-green-500 mr-2">✓</span>
             Professional interpretation report
           </li>
           <li class="flex items-center">
             <span class="text-green-500 mr-2">✓</span>
             Digital images and report delivery
           </li>
           <li class="flex items-center">
             <span class="text-green-500 mr-2">✓</span>
             Results within 24-48 hours
           </li>
           <li class="flex items-center">
             <span class="text-green-500 mr-2">✓</span>
             Secure patient portal access
           </li>
           <li class="flex items-center">
             <span class="text-green-500 mr-2">✓</span>
             Direct physician sharing if needed
           </li>
         </ul>
       </div>
     
       <!-- Medicare Transparency -->
       <div class="mt-3 p-3 bg-gray-50 rounded-lg">
         <h5 class="text-xs font-semibold text-gray-700 mb-1">💡 Pricing Transparency</h5>
         <p class="text-xs text-gray-600">
           This pricing is based on actual Medicare allowable rates plus our transparent $75 service fee. 
           We handle all billing, so you pay nothing additional.
         </p>
       </div>
     
       {showComparison && (
         <div class="mt-3 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
           <h5 class="text-xs font-semibold text-yellow-800 mb-1">🏥 vs Hospital Pricing</h5>
           <p class="text-xs text-yellow-700">
             Hospitals typically charge ${Math.round(pricing.hospital_estimate)} for the same procedure. 
             You save ${savings} (${savingsPercent}%) with our transparent Medicare-based pricing.
           </p>
         </div>
       )}
     </div>