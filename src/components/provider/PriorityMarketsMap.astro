---
// src/components/provider/PriorityMarketsMap.astro
import ParticleCanvas from "./priority-markets/ParticleCanvas.astro";
import MarketHeader from "./priority-markets/MarketHeader.astro";
import NetworkMap from "./priority-markets/NetworkMap.astro";
import MarketStats from "./priority-markets/MarketStats.astro";
import MarketsList from "./priority-markets/MarketsList.astro";
import NetworkSyncSteps from "./priority-markets/NetworkSyncSteps.astro";
import SimpleLinks from "./priority-markets/SimpleLinks.astro";

export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<section
  id="priority-markets"
  class={`relative py-32 overflow-hidden bg-gradient-to-br from-[#0a0e27] via-[#0f1629] to-[#003087] ${className}`}
>
  <ParticleCanvas opacity={40} particleCount={50} />

  <div class="relative z-10">
    <div class="px-4 sm:px-6 max-w-7xl mx-auto">
      <MarketHeader showScarcity={true} />
    </div>

    <div class="w-full px-4 sm:px-6 2xl:px-0 max-w-[1400px] mx-auto mb-20">
      <NetworkMap showLegend={true} />
    </div>

    <div class="px-4 sm:px-6 max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-start mb-16">
        <MarketStats />
        <MarketsList />
      </div>

      <NetworkSyncSteps />
      <!-- Bottom CTA Section -->
      <div class="text-center mt-16 pt-12 border-t border-gray-800">
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center items-center"
        >
          <SimpleLinks />
        </div>
      </div>
    </div>
  </div>
</section>
