---
// src/components/provider/PriorityMarketsMap.astro
export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<!-- National Scale Section - Fort Lauderdale Hub -->
<section
  class="relative py-32 overflow-hidden bg-gradient-to-br from-[#0a0e27] via-[#0f1629] to-[#003087]"
>
  <!-- Particle System Background -->
  <canvas id="particle-network" class="absolute inset-0 opacity-40"></canvas>

  <div class="relative z-10">
    <!-- Section Header with padding -->
    <div class="px-4 sm:px-6 max-w-7xl mx-auto">
      <!-- Header and Title -->
      <div class="text-center mb-12">
        <div
          class="inline-flex items-center gap-3 backdrop-blur-sm bg-white/5 rounded-full px-4 py-2 mb-8 border border-white/10"
          data-aos="fade-up"
        >
          <div class="relative">
            <span
              class="absolute inline-flex h-3 w-3 rounded-full bg-[#cc9933] opacity-75 animate-ping"
            ></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-[#cc9933]"
            ></span>
          </div>
          <span
            class="text-[#cc9933] text-sm font-medium uppercase tracking-wider"
            >Priority Markets Active Recruitment</span
          >
        </div>

        <!-- Scarcity Message -->
        <div
          class="bg-[#cc9933]/10 backdrop-blur-sm border border-[#cc9933]/30 rounded-2xl p-6 mb-12 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="250"
        >
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
              <div
                class="w-12 h-12 bg-[#cc9933]/20 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-[#cc9933]"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
            </div>
            <div>
              <p class="text-[#cc9933] font-bold mb-1">
                Limited Network Slots Available
              </p>
              <p class="text-sm text-gray-300 leading-relaxed">
                Just as we carefully selected centers for AnciCare to ensure
                quality and maintain volume commitments, we're accepting only <strong
                  class="text-[#cc9933]">3-5 centers per market</strong
                > for USRad. Early partners will capture the most market share.
              </p>
            </div>
          </div>
        </div>

        <h2
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-8 leading-tight"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          High-volume<br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] via-[#FFA500] to-[#cc9933] animate-gradient"
          >
            opportunity markets
          </span>
        </h2>

        <p
          class="text-lg md:text-xl text-gray-300 mb-12 leading-relaxed max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          From our Fort Lauderdale headquarters, we're actively recruiting
          imaging centers in 10 high-demand markets where our patient
          acquisition programs show the strongest results.
        </p>
      </div>
    </div>

    <!-- Full Width Map Visualization -->
    <div class="w-full px-4 sm:px-6 2xl:px-0 max-w-[1400px] mx-auto">
      <div
        class="relative w-full h-[500px] md:h-[600px] lg:h-[700px] xl:h-[800px] bg-black/20 rounded-2xl overflow-hidden mb-20"
        data-aos="fade-up"
      >
        <!-- Legend - Centered at top -->
        <div
          class="absolute top-4 left-1/2 transform -translate-x-1/2 z-20 bg-black/60 backdrop-blur-sm rounded-lg px-6 py-3 border border-white/10"
        >
          <h4 class="text-sm font-bold text-white mb-2 text-center">
            Network Sync Activity
          </h4>
          <div class="flex gap-6">
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 bg-[#00ff88] rounded-sm"></div>
              <span class="text-xs text-gray-300">Patient Referrals →</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 bg-[#4A90E2] rounded-sm"></div>
              <span class="text-xs text-gray-300">Reimbursements →</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 bg-[#FFA500] rounded-sm"></div>
              <span class="text-xs text-gray-300">← Medical Reports</span>
            </div>
          </div>
        </div>

        <svg
          class="absolute inset-0 w-full h-full"
          viewBox="0 0 1200 600"
          preserveAspectRatio="xMidYMid meet"
        >
          <!-- Definitions -->
          <defs>
            <!-- Grid Pattern -->
            <pattern
              id="grid"
              x="0"
              y="0"
              width="40"
              height="40"
              patternUnits="userSpaceOnUse"
            >
              <line
                x1="0"
                y1="0"
                x2="0"
                y2="40"
                stroke="#1a2744"
                stroke-width="0.5"
                opacity="0.3"></line>
              <line
                x1="0"
                y1="0"
                x2="40"
                y2="0"
                stroke="#1a2744"
                stroke-width="0.5"
                opacity="0.3"></line>
            </pattern>

            <!-- Hub Gradient -->
            <radialGradient id="hub-gradient" cx="50%" cy="50%" r="50%">
              <stop offset="0%" style="stop-color:#cc9933;stop-opacity:1">
                <animate
                  attributeName="stop-opacity"
                  values="1;0.4;1"
                  dur="2s"
                  repeatCount="indefinite"></animate>
              </stop>
              <stop offset="50%" style="stop-color:#FFA500;stop-opacity:0.5"
              ></stop>
              <stop offset="100%" style="stop-color:#cc9933;stop-opacity:0"
              ></stop>
            </radialGradient>

            <!-- State Gradient -->
            <radialGradient id="state-gradient" cx="50%" cy="50%" r="50%">
              <stop offset="0%" style="stop-color:#cc9933;stop-opacity:0.8"
              ></stop>
              <stop offset="100%" style="stop-color:#cc9933;stop-opacity:0"
              ></stop>
            </radialGradient>

            <!-- Glow Filter -->
            <filter id="glow">
              <feGaussianBlur stdDeviation="3" result="coloredBlur"
              ></feGaussianBlur>
              <feMerge>
                <feMergeNode in="coloredBlur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>

            <!-- Patient Referral Packet (Green - From Hub) -->
            <g id="referral-packet">
              <rect
                x="-3"
                y="-1.5"
                width="6"
                height="3"
                fill="#00ff88"
                opacity="0.8"></rect>
              <circle cx="0" cy="0" r="4" fill="#00ff88" opacity="0.3"></circle>
            </g>

            <!-- Reimbursement Packet (Blue - From Hub) -->
            <g id="reimbursement-packet">
              <rect
                x="-3"
                y="-1.5"
                width="6"
                height="3"
                fill="#4A90E2"
                opacity="0.8"></rect>
              <circle cx="0" cy="0" r="4" fill="#4A90E2" opacity="0.3"></circle>
            </g>

            <!-- Medical Report Packet (Orange - From Centers) -->
            <g id="report-packet">
              <rect
                x="-3"
                y="-1.5"
                width="6"
                height="3"
                fill="#FFA500"
                opacity="0.8"></rect>
              <circle cx="0" cy="0" r="4" fill="#FFA500" opacity="0.3"></circle>
            </g>
          </defs>

          <!-- Background -->
          <rect width="100%" height="100%" fill="url(#grid)"></rect>

          <!-- Connection Lines -->
          <g
            id="connections"
            stroke="#cc9933"
            stroke-width="1.5"
            fill="none"
            opacity="0.3"
          >
            <!-- Outbound paths (Hub to States) -->
            <path id="path-tx-out" d="M 900 450 Q 650 400 400 350"></path>
            <path id="path-ca-out" d="M 900 450 Q 550 350 150 280"></path>
            <path id="path-ny-out" d="M 900 450 Q 950 300 1000 150"></path>
            <path id="path-pa-out" d="M 900 450 Q 920 330 950 200"></path>
            <path id="path-il-out" d="M 900 450 Q 750 350 600 250"></path>
            <path id="path-oh-out" d="M 900 450 Q 800 350 700 250"></path>
            <path id="path-ga-out" d="M 900 450 Q 850 400 800 350"></path>
            <path id="path-nc-out" d="M 900 450 Q 920 370 950 300"></path>
            <path id="path-nj-out" d="M 900 450 Q 950 330 1000 200"></path>

            <!-- Return paths (States to Hub) -->
            <path id="path-tx-return" d="M 400 350 Q 650 400 900 450"></path>
            <path id="path-ca-return" d="M 150 280 Q 550 350 900 450"></path>
            <path id="path-ny-return" d="M 1000 150 Q 950 300 900 450"></path>
            <path id="path-pa-return" d="M 950 200 Q 920 330 900 450"></path>
            <path id="path-il-return" d="M 600 250 Q 750 350 900 450"></path>
            <path id="path-oh-return" d="M 700 250 Q 800 350 900 450"></path>
            <path id="path-ga-return" d="M 800 350 Q 850 400 900 450"></path>
            <path id="path-nc-return" d="M 950 300 Q 920 370 900 450"></path>
            <path id="path-nj-return" d="M 1000 200 Q 950 330 900 450"></path>
          </g>

          <!-- State Nodes -->
          <g id="states">
            <!-- California -->
            <g transform="translate(150, 280)">
              <circle r="25" fill="url(#state-gradient)" opacity="0.8"></circle>
              <circle r="12" fill="#cc9933" filter="url(#glow)"></circle>
              <text
                y="-35"
                text-anchor="middle"
                fill="white"
                font-size="14"
                font-weight="bold">California</text
              >
              <text
                y="35"
                text-anchor="middle"
                fill="#cc9933"
                font-size="10"
                opacity="0.7">Los Angeles • San Diego</text
              >
            </g>

            <!-- Texas -->
            <g transform="translate(400, 350)">
              <circle r="25" fill="url(#state-gradient)" opacity="0.8"></circle>
              <circle r="12" fill="#cc9933" filter="url(#glow)"></circle>
              <text
                y="-35"
                text-anchor="middle"
                fill="white"
                font-size="14"
                font-weight="bold">Texas</text
              >
              <text
                y="35"
                text-anchor="middle"
                fill="#cc9933"
                font-size="10"
                opacity="0.7">Houston • Dallas</text
              >
            </g>

            <!-- Illinois -->
            <g transform="translate(600, 250)">
              <circle r="22" fill="url(#state-gradient)" opacity="0.8"></circle>
              <circle r="10" fill="#cc9933" filter="url(#glow)"></circle>
              <text
                y="-32"
                text-anchor="middle"
                fill="white"
                font-size="13"
                font-weight="bold">Illinois</text
              >
              <text
                y="32"
                text-anchor="middle"
                fill="#cc9933"
                font-size="9"
                opacity="0.7">Chicago Metro</text
              >
            </g>

            <!-- Ohio -->
            <g transform="translate(700, 250)">
              <circle r="20" fill="url(#state-gradient)" opacity="0.8"></circle>
              <circle r="9" fill="#cc9933" filter="url(#glow)"></circle>
              <text
                y="-30"
                text-anchor="middle"
                fill="white"
                font-size="12"
                font-weight="bold">Ohio</text
              >
              <text
                y="30"
                text-anchor="middle"
                fill="#cc9933"
                font-size="9"
                opacity="0.7">Cleveland • Columbus</text
              >
            </g>

            <!-- Georgia -->
            <g transform="translate(800, 350)">
              <circle r="20" fill="url(#state-gradient)" opacity="0.8"></circle>
              <circle r="9" fill="#cc9933" filter="url(#glow)"></circle>
              <text
                y="-30"
                text-anchor="middle"
                fill="white"
                font-size="12"
                font-weight="bold">Georgia</text
              >
              <text
                y="30"
                text-anchor="middle"
                fill="#cc9933"
                font-size="9"
                opacity="0.7">Atlanta Metro</text
              >
            </g>

            <!-- North Carolina -->
            <g transform="translate(950, 300)">
              <circle r="20" fill="url(#state-gradient)" opacity="0.8"></circle>
              <circle r="9" fill="#cc9933" filter="url(#glow)"></circle>
              <text
                y="-30"
                text-anchor="middle"
                fill="white"
                font-size="12"
                font-weight="bold">N. Carolina</text
              >
              <text
                y="30"
                text-anchor="middle"
                fill="#cc9933"
                font-size="9"
                opacity="0.7">Charlotte • Raleigh</text
              >
            </g>

            <!-- Pennsylvania -->
            <g transform="translate(950, 200)">
              <circle r="22" fill="url(#state-gradient)" opacity="0.8"></circle>
              <circle r="10" fill="#cc9933" filter="url(#glow)"></circle>
              <text
                y="-32"
                text-anchor="middle"
                fill="white"
                font-size="13"
                font-weight="bold">Pennsylvania</text
              >
              <text
                y="32"
                text-anchor="middle"
                fill="#cc9933"
                font-size="9"
                opacity="0.7">Philadelphia • Pittsburgh</text
              >
            </g>

            <!-- New Jersey -->
            <g transform="translate(1000, 200)">
              <circle r="18" fill="url(#state-gradient)" opacity="0.8"></circle>
              <circle r="8" fill="#cc9933" filter="url(#glow)"></circle>
              <text
                y="-28"
                text-anchor="middle"
                fill="white"
                font-size="11"
                font-weight="bold">New Jersey</text
              >
              <text
                y="28"
                text-anchor="middle"
                fill="#cc9933"
                font-size="9"
                opacity="0.7">Newark</text
              >
            </g>

            <!-- New York -->
            <g transform="translate(1000, 150)">
              <circle r="25" fill="url(#state-gradient)" opacity="0.8"></circle>
              <circle r="12" fill="#cc9933" filter="url(#glow)"></circle>
              <text
                y="-35"
                text-anchor="middle"
                fill="white"
                font-size="14"
                font-weight="bold">New York</text
              >
              <text
                y="35"
                text-anchor="middle"
                fill="#cc9933"
                font-size="10"
                opacity="0.7">NYC Metro</text
              >
            </g>

            <!-- Fort Lauderdale Hub - Last so it's on top -->
            <g transform="translate(900, 450)">
              <!-- Outer pulse rings -->
              <circle r="60" fill="url(#hub-gradient)"></circle>
              <circle
                r="45"
                fill="none"
                stroke="#cc9933"
                stroke-width="2"
                opacity="0.5"
              >
                <animate
                  attributeName="r"
                  values="45;70;45"
                  dur="3s"
                  repeatCount="indefinite"></animate>
                <animate
                  attributeName="opacity"
                  values="0.5;0;0.5"
                  dur="3s"
                  repeatCount="indefinite"></animate>
              </circle>
              <circle
                r="30"
                fill="none"
                stroke="#FFA500"
                stroke-width="1.5"
                opacity="0.4"
              >
                <animate
                  attributeName="r"
                  values="30;50;30"
                  dur="2.5s"
                  repeatCount="indefinite"></animate>
                <animate
                  attributeName="opacity"
                  values="0.4;0;0.4"
                  dur="2.5s"
                  repeatCount="indefinite"></animate>
              </circle>

              <!-- Hub center -->
              <circle r="15" fill="#cc9933" filter="url(#glow)"></circle>
              <circle r="10" fill="#FFA500"></circle>

              <!-- Hub label -->
              <text
                y="-70"
                text-anchor="middle"
                fill="white"
                font-size="16"
                font-weight="bold">FORT LAUDERDALE</text
              >
              <text y="-50" text-anchor="middle" fill="#cc9933" font-size="12"
                >USRad Command Center</text
              >
              <text
                y="60"
                text-anchor="middle"
                fill="#FFA500"
                font-size="11"
                opacity="0.8">Processing Hub</text
              >
            </g>
          </g>

          <!-- Animated Data Packets -->
          <g id="animations">
            <!-- Patient Referrals (Green - Outbound from Hub) -->
            <use href="#referral-packet" filter="url(#glow)">
              <animateMotion dur="3s" repeatCount="indefinite">
                <mpath href="#path-tx-out"></mpath>
              </animateMotion>
            </use>
            <use href="#referral-packet" filter="url(#glow)">
              <animateMotion dur="4s" repeatCount="indefinite" begin="0.5s">
                <mpath href="#path-ca-out"></mpath>
              </animateMotion>
            </use>
            <use href="#referral-packet" filter="url(#glow)">
              <animateMotion dur="3.5s" repeatCount="indefinite" begin="1s">
                <mpath href="#path-ny-out"></mpath>
              </animateMotion>
            </use>

            <!-- Reimbursements (Blue - Outbound from Hub) -->
            <use href="#reimbursement-packet" filter="url(#glow)">
              <animateMotion dur="3.2s" repeatCount="indefinite" begin="1.5s">
                <mpath href="#path-il-out"></mpath>
              </animateMotion>
            </use>
            <use href="#reimbursement-packet" filter="url(#glow)">
              <animateMotion dur="3.3s" repeatCount="indefinite" begin="2s">
                <mpath href="#path-ga-out"></mpath>
              </animateMotion>
            </use>
            <use href="#reimbursement-packet" filter="url(#glow)">
              <animateMotion dur="3.4s" repeatCount="indefinite" begin="2.5s">
                <mpath href="#path-oh-out"></mpath>
              </animateMotion>
            </use>

            <!-- Medical Reports (Orange - Returning to Hub) -->
            <use href="#report-packet" filter="url(#glow)">
              <animateMotion dur="3.1s" repeatCount="indefinite" begin="0.8s">
                <mpath href="#path-nc-return"></mpath>
              </animateMotion>
            </use>
            <use href="#report-packet" filter="url(#glow)">
              <animateMotion dur="3.5s" repeatCount="indefinite" begin="1.3s">
                <mpath href="#path-pa-return"></mpath>
              </animateMotion>
            </use>
            <use href="#report-packet" filter="url(#glow)">
              <animateMotion dur="3s" repeatCount="indefinite" begin="1.8s">
                <mpath href="#path-nj-return"></mpath>
              </animateMotion>
            </use>
            <use href="#report-packet" filter="url(#glow)">
              <animateMotion dur="3.2s" repeatCount="indefinite" begin="2.3s">
                <mpath href="#path-tx-return"></mpath>
              </animateMotion>
            </use>
            <use href="#report-packet" filter="url(#glow)">
              <animateMotion dur="3.4s" repeatCount="indefinite" begin="2.8s">
                <mpath href="#path-ca-return"></mpath>
              </animateMotion>
            </use>
          </g>
        </svg>
      </div>
    </div>

    <!-- Stats and Markets Grid - Now Below Map -->
    <div class="px-4 sm:px-6 max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-start mb-16">
        <!-- Left Column - Stats and Market Opportunity -->
        <div>
          <!-- Key Market Stats -->
          <div
            class="grid grid-cols-3 gap-4 mb-8"
            data-aos="fade-up"
            data-aos-delay="300"
          >
            <div
              class="bg-white/5 backdrop-blur-md rounded-lg p-4 border border-white/10"
            >
              <div class="text-2xl font-bold text-[#cc9933] mb-1">90M+</div>
              <div class="text-xs text-gray-400">Underinsured Americans</div>
            </div>
            <div
              class="bg-white/5 backdrop-blur-md rounded-lg p-4 border border-white/10"
            >
              <div class="text-2xl font-bold text-white mb-1">35%</div>
              <div class="text-xs text-gray-400">Typical Slot Utilization</div>
            </div>
            <div
              class="bg-white/5 backdrop-blur-md rounded-lg p-4 border border-white/10"
            >
              <div class="text-2xl font-bold text-[#FFA500] mb-1">$2.8B</div>
              <div class="text-xs text-gray-400">Addressable Market</div>
            </div>
          </div>

          <!-- Market Opportunity -->
          <div
            class="bg-gradient-to-r from-[#003087] to-[#0052cc] rounded-xl p-6"
            data-aos="fade-up"
            data-aos-delay="400"
          >
            <h3 class="text-white font-bold text-lg mb-4">
              Market Opportunity
            </h3>
            <div class="grid grid-cols-3 gap-4 text-center">
              <div>
                <div class="text-3xl font-bold text-[#cc9933]">65%</div>
                <div class="text-sm text-gray-300">
                  Average Unfilled Appointment Slots
                </div>
              </div>
              <div>
                <div class="text-3xl font-bold text-white">100%</div>
                <div class="text-sm text-gray-300">Payment Collection Rate</div>
              </div>
              <div>
                <div class="text-3xl font-bold text-[#FFA500]">10 Days</div>
                <div class="text-sm text-gray-300">
                  Guaranteed Payment Timeline
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column - Priority Markets List -->
        <div
          class="bg-white/5 backdrop-blur-md rounded-2xl p-8 border border-white/10"
          data-aos="fade-up"
          data-aos-delay="500"
        >
          <h3 class="text-2xl font-bold text-white mb-6">
            10 Priority Markets
          </h3>

          <div class="grid grid-cols-2 gap-4">
            <!-- Top Tier Markets -->
            <div class="space-y-3">
              <h4 class="text-sm text-[#cc9933] uppercase tracking-wider">
                Tier 1 Markets
              </h4>
              <div
                class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30"
              >
                <div class="font-medium text-white">Florida</div>
                <div class="text-xs text-[#cc9933]">
                  HQ • Miami-Ft. Lauderdale
                </div>
              </div>
              <div
                class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30"
              >
                <div class="font-medium text-white">Texas</div>
                <div class="text-xs text-gray-400">
                  Houston • Dallas • Austin
                </div>
              </div>
              <div
                class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30"
              >
                <div class="font-medium text-white">California</div>
                <div class="text-xs text-gray-400">
                  LA • San Diego • Bay Area
                </div>
              </div>
              <div
                class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30"
              >
                <div class="font-medium text-white">New York</div>
                <div class="text-xs text-gray-400">NYC Metro • Long Island</div>
              </div>
            </div>

            <!-- Secondary Markets -->
            <div class="space-y-3">
              <h4 class="text-sm text-[#4A90E2] uppercase tracking-wider">
                Expansion Markets
              </h4>
              <div class="bg-white/5 rounded-lg p-3 border border-gray-700">
                <div class="font-medium text-white">Pennsylvania</div>
                <div class="text-xs text-gray-400">
                  Philadelphia • Pittsburgh
                </div>
              </div>
              <div class="bg-white/5 rounded-lg p-3 border border-gray-700">
                <div class="font-medium text-white">Illinois</div>
                <div class="text-xs text-gray-400">Chicago Metro</div>
              </div>
              <div class="bg-white/5 rounded-lg p-3 border border-gray-700">
                <div class="font-medium text-white">Ohio</div>
                <div class="text-xs text-gray-400">Cleveland • Columbus</div>
              </div>
              <div class="bg-white/5 rounded-lg p-3 border border-gray-700">
