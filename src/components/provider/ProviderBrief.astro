---
// src/components/provider/ProviderBrief.astro
// Phase 3 — Provider Opportunity Brief download section
// Surfaces the PDF with preview, key contents summary, and download CTA.
// Positioned after ConsultationCTA, before FAQSection.

const REMIX_URL = import.meta.env.PUBLIC_REMIX_URL || 'https://app.usrad.com';
---

<section id="provider-brief" class="py-20 sm:py-24 px-4 sm:px-6 bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <!-- Section label -->
    <div class="flex items-center gap-3 mb-4" data-aos="fade-up">
      <div class="w-1 h-5 bg-[#cc9933] rounded-full"></div>
      <span class="text-xs font-bold tracking-widest text-[#003087] uppercase">
        Provider Resource
      </span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- LEFT — PDF preview card -->
      <div data-aos="fade-right" data-aos-delay="100">
        <div class="relative group">
          <!-- Drop shadow layer -->
          <div
            class="absolute inset-0 translate-x-3 translate-y-3 bg-[#003087]/15 rounded-2xl"
          >
          </div>

          <!-- PDF preview card -->
          <div
            class="relative bg-white rounded-2xl border-2 border-[#003087]/10 overflow-hidden shadow-xl group-hover:border-[#cc9933]/40 transition-all duration-300"
          >
            <!-- Navy header strip mimicking PDF header -->
            <div
              class="bg-gradient-to-r from-[#003087] to-[#002266] px-6 py-4 flex items-center justify-between"
            >
              <div class="flex items-center gap-3">
                <img
                  src="/images/logo/brand/logo_gold_white_transparent.png"
                  alt="USRad"
                  class="h-7 w-auto"
                />
              </div>
              <div class="text-right">
                <div class="text-white text-xs font-bold tracking-wider">
                  PROVIDER OPPORTUNITY BRIEF
                </div>
                <div class="text-blue-300 text-xs mt-0.5">
                  Founding Center Program
                </div>
              </div>
            </div>

            <!-- Preview content area -->
            <div class="px-6 py-5 space-y-4">
              <!-- Headline preview -->
              <div>
                <div class="text-[#003087] font-bold text-base leading-snug">
                  Turn Empty Scanner Slots Into<br />
                  <span class="text-[#cc9933]">Guaranteed Monthly Revenue.</span
                  >
                </div>
              </div>

              <!-- Stat strip -->
              <div class="grid grid-cols-3 gap-2">
                <div class="bg-[#003087] rounded-lg px-2 py-2.5 text-center">
                  <div class="text-[#cc9933] font-bold text-sm">$375</div>
                  <div class="text-white text-[9px] leading-tight mt-0.5">
                    net margin<br />per scan
                  </div>
                </div>
                <div class="bg-[#003087] rounded-lg px-2 py-2.5 text-center">
                  <div class="text-[#cc9933] font-bold text-sm">+15–25</div>
                  <div class="text-white text-[9px] leading-tight mt-0.5">
                    scans<br />per month
                  </div>
                </div>
                <div class="bg-[#003087] rounded-lg px-2 py-2.5 text-center">
                  <div class="text-[#cc9933] font-bold text-sm">$5K–$10K</div>
                  <div class="text-white text-[9px] leading-tight mt-0.5">
                    monthly<br />revenue add
                  </div>
                </div>
              </div>

              <!-- Contents list -->
              <div class="space-y-1.5 pt-1">
                {
                  [
                    "10-day payment guarantee details",
                    "Assignment lifecycle — all 7 steps",
                    "Founding Center Program terms",
                    "Platform credibility & track record",
                  ].map((item) => (
                    <div class="flex items-center gap-2 text-xs text-gray-600">
                      <div class="w-1 h-1 rounded-full bg-[#cc9933] flex-shrink-0" />
                      <span>{item}</span>
                    </div>
                  ))
                }
              </div>

              <!-- Page count badge -->
              <div class="flex items-center gap-2 pt-1">
                <div
                  class="flex items-center gap-1.5 bg-gray-100 rounded-full px-3 py-1"
                >
                  <svg
                    class="w-3 h-3 text-gray-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    ></path>
                  </svg>
                  <span class="text-xs text-gray-500 font-medium"
                    >2-page PDF · Print ready</span
                  >
                </div>
              </div>
            </div>

            <!-- Gold bottom accent -->
            <div class="h-1 bg-gradient-to-r from-[#cc9933] to-[#e8b84b]"></div>
          </div>
        </div>
      </div>

      <!-- RIGHT — Copy + CTAs -->
      <div data-aos="fade-left" data-aos-delay="150" class="space-y-6">
        <div>
          <h2
            class="text-3xl sm:text-4xl font-bold text-[#003087] leading-tight mb-3"
          >
            Take the Revenue Case<br />
            <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-[#003087] to-[#cc9933]"
            >
              With You.
            </span>
          </h2>
          <p class="text-gray-600 text-base leading-relaxed">
            The USRad Provider Opportunity Brief is a two-page summary of
            everything your leadership team needs to evaluate joining the
            network — revenue projections, assignment workflow, payment terms,
            and founding center program details.
          </p>
        </div>

        <!-- Share nudge -->
        <div
          class="flex items-start gap-3 bg-[#003087]/5 rounded-xl px-4 py-3 border border-[#003087]/10"
        >
          <svg
            class="w-4 h-4 text-[#cc9933] mt-0.5 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
            ></path>
          </svg>
          <p class="text-xs text-gray-600 leading-relaxed">
            <span class="font-semibold text-[#003087]"
              >Share with your administrator.</span
            >{" "}
            Many imaging center managers forward this brief internally before scheduling
            an onboarding call.
          </p>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="/downloads/USRad_Provider_Opportunity_Brief.pdf"
            download="USRad_Provider_Opportunity_Brief.pdf"
            class="group inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-[#cc9933] to-[#e8b84b] text-[#003087] px-6 py-3.5 rounded-xl font-bold text-sm hover:shadow-xl transition-all duration-200 hover:scale-105"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
              ></path>
            </svg>
            Download the Brief
          </a>

          <a
            href={`${REMIX_URL}/signup?source=provider`}
            class="group inline-flex items-center justify-center gap-2 border-2 border-[#003087] text-[#003087] px-6 py-3.5 rounded-xl font-bold text-sm hover:bg-[#003087] hover:text-white transition-all duration-200"
          >
            Begin Provider Onboarding
            <span class="group-hover:translate-x-1 transition-transform">→</span
            >
          </a>
        </div>

        <!-- Fine print -->
        <p class="text-xs text-gray-400">
          Free to download · No form required · usrad.com/provider
        </p>
      </div>
    </div>
  </div>
</section>
