---
export interface ProviderCardProps {
  provider: {
    id: string;
    facility_name: string;
    address: string;
    city: string;
    state: string;
    phone?: string;
    distance_miles?: number;
    pricing: {
      patient_price: number;
      medicare_rate: number;
      hospital_estimate: number;
      patient_savings: number;
      savings_percentage: number;
    };
    availability: {
      available_slots: number;
      modality?: string;
    };
    features?: string[];
    rating?: number;
  };
  index: number;
  onSelect?: string;
}

const { provider, index, onSelect = "selectProvider" } = Astro.props;
const { pricing, availability } = provider;
const savings = Math.round(pricing.patient_savings);
const savingsPercent = Math.round(pricing.savings_percentage);
---

<!-- ===========================================
     src/components/provider/ProviderCard.astro
     Individual provider display card
     =========================================== -->
<div
  class="provider-card bg-white rounded-lg shadow-md hover:shadow-lg transition-all duration-200 p-6 border border-gray-200 cursor-pointer"
  data-provider-id={provider.id}
  data-provider-index={index}
  data-provider-data={JSON.stringify(provider)}
>
  <!-- Provider Header -->
  <div class="flex justify-between items-start mb-4">
    <div class="flex-1">
      <h3 class="text-lg font-semibold text-gray-900 mb-1">
        {provider.facility_name}
      </h3>
      <p class="text-sm text-gray-600 flex items-center">
        <span class="mr-1">📍</span>
        {provider.address}
      </p>
      {
        provider.phone && (
          <p class="text-sm text-gray-600 flex items-center mt-1">
            <span class="mr-1">📞</span>
            {provider.phone}
          </p>
        )
      }
    </div>

    {
      provider.distance_miles && (
        <div class="text-right">
          <span class="text-sm text-gray-500">
            {provider.distance_miles.toFixed(1)} miles
          </span>
        </div>
      )
    }
  </div>

  <!-- Pricing Section -->
  <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
    <div class="flex justify-between items-center mb-2">
      <span class="text-lg font-bold text-green-600">
        ${Math.round(pricing.patient_price)}
      </span>
      <span
        class="bg-green-100 text-green-800 px-2 py-1 rounded-full text-xs font-semibold"
      >
        Save ${savings} ({savingsPercent}%)
      </span>
    </div>

    <div class="space-y-1 text-xs text-gray-600">
      <div class="flex justify-between">
        <span>Medicare Rate:</span>
        <span>${Math.round(pricing.medicare_rate)}</span>
      </div>
      <div class="flex justify-between">
        <span>USRad Fee:</span>
        <span>${Math.round(pricing.patient_price - pricing.medicare_rate)}</span
        >
      </div>
      <div class="flex justify-between text-gray-400">
        <span>vs Hospital:</span>
        <span class="line-through"
          >${Math.round(pricing.hospital_estimate)}</span
        >
      </div>
    </div>
  </div>

  <!-- Availability and Features -->
  <div class="space-y-3 mb-4">
    {
      availability.available_slots > 0 && (
        <div class="flex items-center text-sm text-green-600">
          <span class="mr-2">📅</span>
          <span class="font-medium">
            {availability.available_slots} slots available
          </span>
        </div>
      )
    }

    {
      provider.features && provider.features.length > 0 && (
        <div class="flex flex-wrap gap-1">
          {provider.features.map((feature) => (
            <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">
              {feature}
            </span>
          ))}
        </div>
      )
    }

    {
      provider.rating && (
        <div class="flex items-center text-sm text-gray-600">
          <span class="mr-1">⭐</span>
          <span>{provider.rating.toFixed(1)} rating</span>
        </div>
      )
    }
  </div>

  <!-- Action Button -->
  <button
    class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition-colors font-medium"
    onclick={`${onSelect}('${provider.id}', ${index})`}
  >
    Book Now & Save ${savings}
  </button>
</div>

<script define:vars={{ provider, index }}>
  // Add hover effects for map integration
  document.addEventListener("DOMContentLoaded", () => {
    const card = document.querySelector(`[data-provider-index="${index}"]`);

    if (card) {
      card.addEventListener("mouseenter", () => {
        if (window.mapManager && window.mapManager.highlightMarkerByIndex) {
          window.mapManager.highlightMarkerByIndex(index);
        }
      });

      card.addEventListener("mouseleave", () => {
        // Remove highlights when mouse leaves
        if (window.mapManager && window.mapManager.clearHighlights) {
          window.mapManager.clearHighlights();
        }
      });
    }
  });
</script>
