<!-- ===========================================
     src/components/provider/ProviderList.astro
     Provider grid/list container with REAL provider cards
     =========================================== -->

     ---
     export interface ProviderListProps {
       providers?: any[];
       currentPage?: number;
       totalPages?: number;
       totalResults?: number;
       onPageChange?: string;
       loading?: boolean;
     }
     
     const {
       providers = [],
       currentPage = 1,
       totalPages = 1,
       totalResults = 0,
       onPageChange = 'handlePageChange',
       loading = false
     } = Astro.props;
     
     // Create simple pagination array
     const createPaginationPages = (current, total) => {
       const pages = [];
       
       if (total <= 7) {
         for (let i = 1; i <= total; i++) {
           pages.push(i);
         }
       } else if (current <= 4) {
         for (let i = 1; i <= 7; i++) {
           pages.push(i);
         }
       } else if (current > total - 4) {
         for (let i = total - 6; i <= total; i++) {
           pages.push(i);
         }
       } else {
         for (let i = current - 3; i <= current + 3; i++) {
           pages.push(i);
         }
       }
       
       return pages;
     };
     
     const paginationPages = createPaginationPages(currentPage, totalPages);
     ---
     
     <div id="providerList" class="space-y-4">
       <!-- Results Header -->
       <div class="flex justify-between items-center mb-6">
         <div>
           <h2 class="text-xl font-semibold text-gray-900">
             Available Providers
           </h2>
           <p class="text-sm text-gray-600">
             Showing {providers.length} of {totalResults} providers
           </p>
         </div>
         
         <!-- View Toggle -->
         <div class="flex items-center space-x-2">
           <button id="gridView" class="p-2 text-gray-600 hover:text-blue-600 transition-colors" title="Grid view">
             <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
               <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
             </svg>
           </button>
           <button id="listView" class="p-2 text-blue-600 hover:text-blue-800 transition-colors" title="List view">
             <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
               <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
             </svg>
           </button>
         </div>
       </div>
     
       <!-- Provider Cards Container -->
       <div id="providerCards" class={`grid gap-4 ${loading ? 'opacity-50' : ''}`}>
         {providers.map((provider, index) => {
           // Calculate pricing values
           const pricing = provider.pricing || {};
           const savings = Math.round(pricing.patient_savings || 0);
           const savingsPercent = Math.round(pricing.savings_percentage || 0);
           const patientPrice = Math.round(pricing.patient_price || 0);
           const medicareRate = Math.round(pricing.medicare_rate || 0);
           const hospitalEstimate = Math.round(pricing.hospital_estimate || 0);
           const usradFee = patientPrice - medicareRate;
           
           return (
             <div 
               key={provider.id || index}
               class="provider-card bg-white rounded-lg shadow-md hover:shadow-lg transition-all duration-200 p-6 border border-gray-200 cursor-pointer"
               data-provider-id={provider.id}
               data-provider-index={index}
               data-provider-data={JSON.stringify(provider)}
             >
               <!-- Provider Header -->
               <div class="flex justify-between items-start mb-4">
                 <div class="flex-1">
                   <h3 class="text-lg font-semibold text-gray-900 mb-1">
                     {provider.facility_name || provider.name || 'Medical Center'}
                   </h3>
                   <p class="text-sm text-gray-600 flex items-center">
                     <span class="mr-1">📍</span>
                     {provider.address || `${provider.city || ''}, ${provider.state || ''}`}
                   </p>
                   {provider.phone && (
                     <p class="text-sm text-gray-600 flex items-center mt-1">
                       <span class="mr-1">📞</span>
                       {provider.phone}
                     </p>
                   )}
                 </div>
                 
                 {provider.distance_miles && (
                   <div class="text-right">
                     <span class="text-sm text-gray-500">
                       {provider.distance_miles.toFixed(1)} miles
                     </span>
                   </div>
                 )}
               </div>
     
               <!-- Pricing Section -->
               <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
                 <div class="flex justify-between items-center mb-2">
                   <span class="text-lg font-bold text-green-600">
                     ${patientPrice}
                   </span>
                   <span class="bg-green-100 text-green-800 px-2 py-1 rounded-full text-xs font-semibold">
                     Save ${savings} ({savingsPercent}%)
                   </span>
                 </div>
                 
                 <div class="space-y-1 text-xs text-gray-600">
                   <div class="flex justify-between">
                     <span>Medicare Rate:</span>
                     <span>${medicareRate}</span>
                   </div>
                   <div class="flex justify-between">
                     <span>USRad Fee:</span>
                     <span>${usradFee}</span>
                   </div>
                   <div class="flex justify-between text-gray-400">
                     <span>vs Hospital:</span>
                     <span class="line-through">${hospitalEstimate}</span>
                   </div>
                 </div>
               </div>
     
               <!-- Availability -->
               {provider.availability?.available_slots > 0 && (
                 <div class="flex items-center text-sm text-green-600 mb-4">
                   <span class="mr-2">📅</span>
                   <span class="font-medium">
                     {provider.availability.available_slots} slots available
                   </span>
                 </div>
               )}
     
               <!-- Features/Badges -->
               {provider.features && provider.features.length > 0 && (
                 <div class="flex flex-wrap gap-1 mb-4">
                   {provider.features.map((feature, i) => (
                     <span key={i} class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">
                       {feature}
                     </span>
                   ))}
                 </div>
               )}
     
               <!-- Action Button -->
               <button 
                 class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition-colors font-medium"
                 onclick={`selectProvider('${provider.id}', ${index})`}
               >
                 Book Now & Save ${savings}
               </button>
             </div>
           );
         })}
       </div>
     
       <!-- No Results State -->
       {providers.length === 0 && !loading && (
         <div class="text-center py-12">
           <div class="text-6xl mb-4">🔍</div>
           <h3 class="text-lg font-semibold text-gray-900 mb-2">
             No providers found
           </h3>
           <p class="text-gray-600 mb-4">
             Try adjusting your search criteria or expanding your search area.
           </p>
           <button 
             class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors"
             onclick="expandSearchArea()"
           >
             Expand Search Area
           </button>
         </div>
       )}
     
       <!-- Simple Pagination -->
       {totalPages > 1 && (
         <div class="flex justify-center items-center space-x-2 mt-8">
           <!-- Previous Button -->
           <button 
             class={`px-3 py-2 text-sm rounded-md transition-colors ${
               currentPage === 1 
                 ? 'text-gray-400 cursor-not-allowed' 
                 : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
             }`}
             disabled={currentPage === 1}
             onclick={currentPage > 1 ? `${onPageChange}(${currentPage - 1})` : ''}
           >
             Previous
           </button>
           
           <!-- Page Numbers -->
           {paginationPages.map((page) => (
             <button 
               key={page}
               class={`px-3 py-2 text-sm rounded-md transition-colors ${
                 page === currentPage 
                   ? 'bg-blue-600 text-white' 
                   : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
               }`}
               onclick={`${onPageChange}(${page})`}
             >
               {page}
             </button>
           ))}
           
           <!-- Next Button -->
           <button 
             class={`px-3 py-2 text-sm rounded-md transition-colors ${
               currentPage === totalPages 
                 ? 'text-gray-400 cursor-not-allowed' 
                 : 'text-gray-600 hover:text-blue-600 hover:bg-blue-50'
             }`}
             disabled={currentPage === totalPages}
             onclick={currentPage < totalPages ? `${onPageChange}(${currentPage + 1})` : ''}
           >
             Next
           </button>
         </div>
       )}
     </div>
     
     <script define:vars={{ onPageChange }}>
       document.addEventListener('DOMContentLoaded', () => {
         // Setup view toggle functionality
         const gridView = document.getElementById('gridView');
         const listView = document.getElementById('listView');
         const providerCards = document.getElementById('providerCards');
         
         if (gridView && listView && providerCards) {
           gridView.addEventListener('click', () => {
             providerCards.className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4';
             gridView.classList.add('text-blue-600');
             gridView.classList.remove('text-gray-600');
             listView.classList.add('text-gray-600');
             listView.classList.remove('text-blue-600');
           });
           
           listView.addEventListener('click', () => {
             providerCards.className = 'grid grid-cols-1 gap-4';
             listView.classList.add('text-blue-600');
             listView.classList.remove('text-gray-600');
             gridView.classList.add('text-gray-600');
             gridView.classList.remove('text-blue-600');
           });
         }
     
         // Add hover effects for map integration
         const providerCardElements = document.querySelectorAll('.provider-card');
         providerCardElements.forEach((card, index) => {
           card.addEventListener('mouseenter', () => {
             if (window.mapManager && window.mapManager.highlightMarkerByIndex) {
               window.mapManager.highlightMarkerByIndex(index);
             }
           });
           
           card.addEventListener('mouseleave', () => {
             // Optional: Clear map highlights when mouse leaves
           });
         });
       });
     
       // Global function for expanding search area
       window.expandSearchArea = function() {
         if (window.searchPageController) {
           window.searchPageController.expandSearch();
         }
       };
     </script>