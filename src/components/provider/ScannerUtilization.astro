---
// src/components/provider/ScannerUtilization.astro
// Priority 3 — Scanner Utilization Visual + Payment Timeline
// Placement: after ReferralWorkflow, before PriorityMarketsMap
// Makes revenue opportunity viscerally concrete for administrators
---

<section id="scanner-utilization" class="py-20 sm:py-28 px-4 sm:px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-14 sm:mb-20" data-aos="fade-up">
      <div
        class="inline-flex items-center gap-2 bg-[#003087]/8 rounded-full px-4 sm:px-6 py-2 sm:py-3 mb-6"
      >
        <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
        <span
          class="text-[#003087] text-xs sm:text-sm font-semibold tracking-wide uppercase"
        >
          The Revenue Opportunity
        </span>
      </div>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-5 leading-tight"
      >
        Most Imaging Centers Have
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-[#003087] to-[#cc9933]"
        >
          Untapped Capacity
        </span>
      </h2>
      <p
        class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed"
      >
        Every empty scanner slot is revenue that doesn't require a single
        additional staff member, piece of equipment, or overhead dollar.
      </p>
    </div>

    <!-- Two column layout: Scanner Visual + Payment Timeline -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12">
      <!-- LEFT: Scanner Utilization Visual -->
      <div
        class="bg-gradient-to-br from-white to-gray-50 rounded-2xl shadow-lg border-2 border-transparent hover:border-[#cc9933] transition-all duration-300 p-6 sm:p-8"
        data-aos="fade-right"
      >
        <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2">
          Your Scanner's Hidden Capacity
        </h3>
        <p class="text-sm text-gray-500 mb-8">
          Industry estimate averages — independent imaging centers
        </p>

        <!-- Bar Chart -->
        <div class="space-y-5">
          <!-- Full capacity bar -->
          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-sm font-semibold text-gray-700"
                >Full capacity</span
              >
              <span class="text-sm font-bold text-gray-900">15 scans/day</span>
            </div>
            <div class="h-10 bg-gray-100 rounded-lg overflow-hidden">
              <div
                class="h-full bg-gradient-to-r from-[#003087] to-[#004299] rounded-lg flex items-center justify-end pr-3 transition-all duration-1000"
                style="width: 100%;"
                data-width="100"
              >
                <span class="text-white text-xs font-bold">100%</span>
              </div>
            </div>
          </div>

          <!-- Typical utilization bar -->
          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-sm font-semibold text-gray-700"
                >Typical utilization</span
              >
              <span class="text-sm font-bold text-gray-900">8 scans/day</span>
            </div>
            <div class="h-10 bg-gray-100 rounded-lg overflow-hidden">
              <div
                class="h-full bg-gradient-to-r from-[#cc9933] to-[#b8861f] rounded-lg flex items-center justify-end pr-3 transition-all duration-1000"
                style="width: 53%;"
                data-width="53"
              >
                <span class="text-white text-xs font-bold">53%</span>
              </div>
            </div>
          </div>

          <!-- Unused capacity bar -->
          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-sm font-semibold text-[#22c55e]"
                >Unused capacity</span
              >
              <span class="text-sm font-bold text-[#22c55e]">7 scans/day</span>
            </div>
            <div class="h-10 bg-gray-100 rounded-lg overflow-hidden">
              <div
                class="h-full bg-gradient-to-r from-[#22c55e] to-[#16a34a] rounded-lg flex items-center justify-end pr-3 transition-all duration-1000"
                style="width: 47%;"
                data-width="47"
              >
                <span class="text-white text-xs font-bold">47%</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Revenue opportunity callout -->
        <div
          class="mt-8 bg-gradient-to-br from-[#22c55e]/8 to-[#22c55e]/5 rounded-xl border border-[#22c55e]/20 p-5"
        >
          <p
            class="text-xs font-semibold text-[#22c55e] uppercase tracking-wide mb-3"
          >
            Revenue Opportunity
          </p>
          <div class="grid grid-cols-3 gap-3 text-center mb-3">
            <div>
              <div class="text-lg sm:text-xl font-bold text-gray-900">5</div>
              <div class="text-xs text-gray-500">additional<br />scans/day</div>
            </div>
            <div
              class="flex items-center justify-center text-gray-400 text-xl font-light"
            >
              ×
            </div>
            <div>
              <div class="text-lg sm:text-xl font-bold text-gray-900">$375</div>
              <div class="text-xs text-gray-500">avg margin<br />per scan</div>
            </div>
          </div>
          <div class="border-t border-[#22c55e]/20 pt-3 text-center">
            <div class="text-2xl sm:text-3xl font-bold text-[#22c55e]">
              $37,500/month
            </div>
            <div class="text-xs text-gray-500 mt-1">
              in additional revenue from existing capacity
            </div>
          </div>
        </div>

        <p class="text-xs text-gray-400 mt-4 text-center">
          * Based on average cash-pay MRI reimbursement across modality mix and
          U.S. markets. Individual results vary by market and modality.
        </p>
      </div>

      <!-- RIGHT: Payment Timeline Comparison -->
      <div
        class="bg-gradient-to-br from-white to-gray-50 rounded-2xl shadow-lg border-2 border-transparent hover:border-[#cc9933] transition-all duration-300 p-6 sm:p-8"
        data-aos="fade-left"
      >
        <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2">
          When You Actually Get Paid
        </h3>
        <p class="text-sm text-gray-500 mb-8">
          The difference between waiting and knowing
        </p>

        <!-- Traditional Insurance Path -->
        <div class="mb-6">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-3 h-3 rounded-full bg-gray-400"></div>
            <span
              class="text-sm font-bold text-gray-600 uppercase tracking-wide"
              >Traditional Insurance</span
            >
          </div>

          <!-- Timeline steps -->
          <div class="relative">
            <div class="absolute left-3 top-4 bottom-4 w-px bg-gray-200"></div>
            <div class="space-y-4">
              <div class="flex items-start gap-4 pl-8 relative">
                <div
                  class="absolute left-0 w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    class="w-3.5 h-3.5 text-gray-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                    ></path>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-700">
                    Scan performed
                  </div>
                  <div class="text-xs text-gray-400">Day 0</div>
                </div>
              </div>
              <div class="flex items-start gap-4 pl-8 relative">
                <div
                  class="absolute left-0 w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    class="w-3.5 h-3.5 text-gray-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-700">
                    Claim submitted
                  </div>
                  <div class="text-xs text-gray-400">Days 1–7</div>
                </div>
              </div>
              <div class="flex items-start gap-4 pl-8 relative">
                <div
                  class="absolute left-0 w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    class="w-3.5 h-3.5 text-gray-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-700">
                    Payer processing
                  </div>
                  <div class="text-xs text-gray-400">Days 14–45</div>
                </div>
              </div>
              <div class="flex items-start gap-4 pl-8 relative">
                <div
                  class="absolute left-0 w-7 h-7 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    class="w-3.5 h-3.5 text-red-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-red-600">
                    Payment (maybe)
                  </div>
                  <div class="text-xs text-red-400 font-medium">
                    Days 45–90 · collections risk
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="border-t border-gray-200 my-6"></div>

        <!-- USRad Path -->
        <div>
          <div class="flex items-center gap-2 mb-4">
            <div class="w-3 h-3 rounded-full bg-[#22c55e]"></div>
            <span
              class="text-sm font-bold text-[#003087] uppercase tracking-wide"
              >USRad</span
            >
          </div>

          <div class="relative">
            <div class="absolute left-3 top-4 bottom-4 w-px bg-[#22c55e]/30">
            </div>
            <div class="space-y-4">
              <div class="flex items-start gap-4 pl-8 relative">
                <div
                  class="absolute left-0 w-7 h-7 rounded-full bg-[#003087]/10 flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    class="w-3.5 h-3.5 text-[#003087]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                    ></path>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-gray-700">
                    Scan performed
                  </div>
                  <div class="text-xs text-gray-400">Day 0</div>
                </div>
              </div>
              <div class="flex items-start gap-4 pl-8 relative">
                <div
                  class="absolute left-0 w-7 h-7 rounded-full bg-[#22c55e]/20 flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    class="w-3.5 h-3.5 text-[#22c55e]"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-[#22c55e]">
                    Disbursement — guaranteed
                  </div>
                  <div class="text-xs text-[#22c55e] font-bold">
                    Day 10 · zero collections risk
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Guarantee callout -->
          <div
            class="mt-6 bg-gradient-to-br from-[#003087]/8 to-[#003087]/5 rounded-xl border border-[#003087]/20 p-5"
          >
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 bg-[#003087] rounded-xl flex items-center justify-center flex-shrink-0"
              >
                <svg
                  class="w-5 h-5 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  ></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-bold text-[#003087]">
                  10 business days from fulfillment
                </div>
                <div class="text-xs text-gray-600 mt-0.5">
                  Direct deposit. No claim filing. No collections. No surprises.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- How assignments reach the center -->
    <p
      class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed mt-12 sm:mt-16"
      data-aos="fade-up"
    >
      Every assignment is a Fully Funded Assignment — a defined term in our
      Provider Service Agreement. Funding is secured before the assignment
      reaches your center, and USRad pays you directly within 10 business days
      of fulfillment.
    </p>

    <!-- Bottom stat row -->
    <div
      class="mt-10 sm:mt-14 grid grid-cols-1 sm:grid-cols-2 gap-6"
      data-aos="fade-up"
      data-aos-delay="200"
    >
      <div
        class="text-center bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 p-6 shadow-sm"
      >
        <div class="text-3xl sm:text-4xl font-bold text-[#003087] mb-2">$0</div>
        <div class="text-sm font-semibold text-gray-700">Setup cost</div>
        <div class="text-xs text-gray-500 mt-1">No equipment. No overhead.</div>
      </div>
      <div
        class="text-center bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 p-6 shadow-sm"
      >
        <div class="text-3xl sm:text-4xl font-bold text-[#cc9933] mb-2">10</div>
        <div class="text-sm font-semibold text-gray-700">
          Days to disbursement
        </div>
        <div class="text-xs text-gray-500 mt-1">Guaranteed. Every scan.</div>
      </div>
    </div>
  </div>
</section>
