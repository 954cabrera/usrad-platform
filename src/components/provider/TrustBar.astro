---
// TrustBar.astro - Credibility indicators bar
---

<!-- Trust Bar -->
<section
  class="py-6 sm:py-3 bg-gradient-to-r from-gray-50 to-white border-y border-gray-200 relative overflow-hidden"
>
  <!-- Subtle background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div
      class="absolute inset-0"
      style="background-image: url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 viewBox=%220 0 60 60%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cg fill=%22none%22 fill-rule=%22evenodd%22%3E%3Cg fill=%22%23003087%22 fill-opacity=%220.1%22%3E%3Cpath d=%22M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <div
      class="flex flex-col sm:flex-row sm:flex-wrap justify-center items-center gap-6 sm:gap-8 md:gap-12"
    >
      <!-- First item - AnciCare Founders -->
      <div
        class="flex items-center gap-3 group w-full sm:w-auto justify-center sm:justify-start"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="relative flex-shrink-0">
          <div
            class="absolute inset-0 bg-green-500 rounded-full blur-md opacity-30 group-hover:opacity-50 transition-opacity"
          >
          </div>
          <svg
            class="w-6 h-6 text-green-600 relative z-10"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
        <div class="text-center sm:text-left">
          <span class="text-gray-800 font-bold text-sm block"
            >From the AnciCare Founders</span
          >
          <div class="text-xs text-gray-500">Proven Industry Leaders</div>
        </div>
      </div>

      <!-- Divider - hidden on mobile -->
      <div class="hidden sm:hidden md:block w-px h-8 bg-gray-300"></div>

      <!-- Second item - 1,200+ Centers -->
      <div
        class="flex items-center gap-3 group w-full sm:w-auto justify-center sm:justify-start"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div class="relative flex-shrink-0">
          <div
            class="absolute inset-0 bg-blue-500 rounded-full blur-md opacity-30 group-hover:opacity-50 transition-opacity"
          >
          </div>
          <svg
            class="w-6 h-6 text-blue-600 relative z-10"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"
            ></path>
          </svg>
        </div>
        <div class="text-center sm:text-left">
          <span class="text-gray-800 font-bold text-sm block"
            >1,200+ Centers Successfully Recruited</span
          >
          <div class="text-xs text-gray-500">Delivered over $150 million in Volume</div>
        </div>
      </div>

      <!-- Divider - hidden on mobile and small tablets -->
      <div class="hidden sm:hidden md:block w-px h-8 bg-gray-300"></div>

      <!-- Third item - NASDAQ-Listed -->
      <div
        class="flex items-center gap-3 group w-full sm:w-auto justify-center sm:justify-start"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div class="relative flex-shrink-0">
          <div
            class="absolute inset-0 bg-[#cc9933] rounded-full blur-md opacity-30 group-hover:opacity-50 transition-opacity"
          >
          </div>
          <svg
            class="w-6 h-6 text-[#cc9933] relative z-10"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
            ></path>
          </svg>
        </div>
        <div class="text-center sm:text-left">
          <span class="text-gray-800 font-bold text-sm block"
            >NASDAQ-Listed Acquisition</span
          >
          <div class="text-xs text-gray-500">
            CorVel Corporation (NASDAQ: CRVL)
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
