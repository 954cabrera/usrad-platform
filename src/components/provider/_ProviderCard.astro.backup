---
// ===========================================
// src/components/provider/ProviderCard.astro
// Individual provider display card - EXACT match to search-test.astro styling
// ===========================================

export interface ProviderCardProps {
  provider: {
    id: string;
    name?: string;
    facility_name?: string;
    address?: string;
    city: string;
    state: string;
    phone?: string;
    distance_miles?: number;
    coordinates?: {
      lat: number;
      lng: number;
    };
    pricing: {
      patient_price: number;
      medicare_rate: number;
      hospital_estimate: number;
      patient_savings: number;
      savings_percentage: number;
    };
    availability?: {
      available_slots: number;
      modality?: string;
      next_available?: string;
    };
    features?: string[];
    medicare_locality?: string;
    rating?: number;
  };
  index: number;
  onSelect?: string;
}

const { provider, index, onSelect = "selectProvider" } = Astro.props;
const { pricing, availability = { available_slots: 0 } } = provider;

// Calculate display values
const savings = Math.round(pricing.patient_savings || 0);
const savingsPercent = Math.round(pricing.savings_percentage || 0);
const displayName =
  provider.name || provider.facility_name || "Unknown Provider";

// Get border class based on index (matching search-test.astro pattern)
const getBorderClass = (idx: number): string => {
  const colors = [
    "border-blue-500",
    "border-green-500",
    "border-purple-500",
    "border-orange-500",
    "border-red-500",
    "border-indigo-500",
    "border-pink-500",
    "border-yellow-500",
  ];
  return colors[idx % colors.length];
};

// Get badge based on index (matching search-test.astro pattern)
const getBadge = (idx: number): string => {
  const badges = [
    '<span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-xs font-semibold">Best Value</span>',
    '<span class="bg-green-100 text-green-800 px-2 py-1 rounded-full text-xs font-semibold">Fastest</span>',
    '<span class="bg-purple-100 text-purple-800 px-2 py-1 rounded-full text-xs font-semibold">Premium</span>',
    '<span class="bg-orange-100 text-orange-800 px-2 py-1 rounded-full text-xs font-semibold">Popular</span>',
    '<span class="bg-red-100 text-red-800 px-2 py-1 rounded-full text-xs font-semibold">New</span>',
    '<span class="bg-indigo-100 text-indigo-800 px-2 py-1 rounded-full text-xs font-semibold">Trusted</span>',
    '<span class="bg-pink-100 text-pink-800 px-2 py-1 rounded-full text-xs font-semibold">Featured</span>',
    '<span class="bg-yellow-100 text-yellow-800 px-2 py-1 rounded-full text-xs font-semibold">Certified</span>',
  ];
  return badges[idx % badges.length];
};

// Generate random distance (matching search-test.astro behavior)
const getRandomDistance = (): string => {
  if (provider.distance_miles) {
    return provider.distance_miles.toFixed(1);
  }
  return (Math.random() * 25 + 1).toFixed(1);
};

const borderClass = getBorderClass(index);
const badgeHtml = getBadge(index);
const distance = getRandomDistance();
---

<!-- Provider Card with EXACT styling from search-test.astro -->
<div
  class={`provider-card bg-white rounded-xl shadow-md p-6 mb-6 hover:shadow-xl transition-all duration-300 border-l-4 ${borderClass}`}
  data-provider-index={index}
  data-provider-id={provider.id}
  data-provider-data={JSON.stringify(provider)}
  onmouseenter={`highlightMarker(${index})`}
  onmouseleave={`unhighlightMarker(${index})`}
>
  <!-- Provider Header with Enhanced Badge -->
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1">
      <div class="flex items-center mb-2">
        <h3 class="text-xl font-bold text-gray-900 mr-3">{displayName}</h3>
        <span set:html={badgeHtml} />
      </div>

      <div class="flex items-center text-gray-600 mb-2">
        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
            clip-rule="evenodd"></path>
        </svg>
        <span class="text-sm">{provider.city}, {provider.state}</span>
        {
          provider.medicare_locality && (
            <span class="ml-2 text-xs text-gray-500">
              • Medicare Locality: {provider.medicare_locality}
            </span>
          )
        }
      </div>

      <div class="flex items-center text-green-600 text-sm font-medium mb-2">
        <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        ✅ Available for booking
      </div>

      <!-- Distance Badge -->
      <div
        class="inline-flex items-center bg-blue-50 text-blue-700 px-3 py-1 rounded-full text-sm font-medium mb-3"
      >
        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
            clip-rule="evenodd"></path>
        </svg>
        {distance} miles away
      </div>
    </div>

    <div class="text-right">
      <div class="text-3xl font-bold text-green-600 mb-1">
        ${pricing.patient_price.toFixed(2)}
      </div>
      <div class="text-sm text-gray-500 line-through">
        vs ${pricing.hospital_estimate.toFixed(2)}
      </div>
      <div class="text-lg font-bold savings-highlight">
        {savingsPercent}% savings
      </div>
    </div>
  </div>

  <!-- Enhanced Pricing Section -->
  <div
    class="pricing-section bg-gradient-to-br from-gray-50 to-gray-100 rounded-lg p-4 mb-4 border-l-4 border-green-500"
  >
    <h4 class="text-sm font-semibold text-gray-700 mb-3 flex items-center">
      <svg
        class="w-4 h-4 mr-1 text-green-600"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"
        ></path>
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z"
          clip-rule="evenodd"></path>
      </svg>
      Medicare-Based Transparent Pricing
    </h4>

    <div class="grid grid-cols-2 gap-4 text-sm">
      <div class="usrad-price">
        <div class="flex justify-between items-center">
          <span class="price-label">Medicare Rate:</span>
          <span class="font-semibold text-gray-700"
            >${pricing.medicare_rate.toFixed(2)}</span
          >
        </div>
      </div>

      <div class="usrad-price">
        <div class="flex justify-between items-center">
          <span class="price-label">USRad Fee:</span>
          <span class="font-semibold text-gray-700"
            >${(pricing.patient_price - pricing.medicare_rate).toFixed(2)}</span
          >
        </div>
      </div>

      <div class="usrad-price">
        <div class="flex justify-between items-center">
          <span class="price-label">Your Total:</span>
          <span class="font-bold text-green-600 text-lg"
            >${pricing.patient_price.toFixed(2)}</span
          >
        </div>
      </div>

      <div class="usrad-price">
        <div class="flex justify-between items-center">
          <span class="price-label">You Save:</span>
          <span class="font-bold text-green-600 text-lg">${savings}</span>
        </div>
      </div>
    </div>

    <div class="mt-3 pt-3 border-t border-gray-200">
      <div class="flex justify-between items-center text-xs text-gray-500">
        <span>Hospital Estimate:</span>
        <span class="line-through">${pricing.hospital_estimate.toFixed(2)}</span
        >
      </div>
    </div>
  </div>

  <!-- Availability Section -->
  {
    availability.available_slots > 0 && (
      <div class="bg-green-50 border border-green-200 rounded-lg p-3 mb-4">
        <div class="flex items-center text-green-700">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="font-medium text-sm">
            {availability.available_slots} appointment slots available
          </span>
        </div>
      </div>
    )
  }

  <!-- Features Section -->
  {
    provider.features && provider.features.length > 0 && (
      <div class="mb-4">
        <div class="flex flex-wrap gap-2">
          {provider.features.map((feature) => (
            <span class="bg-blue-50 text-blue-700 px-2 py-1 rounded text-xs font-medium">
              {feature}
            </span>
          ))}
        </div>
      </div>
    )
  }

  <!-- Trust Indicators -->
  <div class="bg-gray-50 rounded-lg p-3 mb-4">
    <div class="flex items-center justify-between text-xs text-gray-600">
      <span class="flex items-center">
        <svg
          class="w-3 h-3 mr-1 text-green-500"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        Medicare-based pricing
      </span>
      <span class="flex items-center">
        <svg
          class="w-3 h-3 mr-1 text-green-500"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        Board-certified radiologists
      </span>
      <span class="flex items-center">
        <svg
          class="w-3 h-3 mr-1 text-green-500"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        24-48hr results
      </span>
    </div>
  </div>

  <!-- Enhanced Book Now Button -->
  <button
    class="book-btn w-full bg-gradient-to-r from-blue-600 to-blue-700 text-white px-6 py-3 rounded-lg font-semibold text-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
    onclick={`${onSelect}('${provider.id}', ${index})`}
  >
    <div class="flex items-center justify-center">
      <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
          clip-rule="evenodd"></path>
      </svg>
      Book Now & Save ${savings}
    </div>
  </button>

  <!-- Additional Info Tooltip -->
  <div class="mt-2 text-center">
    <span class="text-xs text-gray-500">
      📋 Reports delivered electronically • 🔒 HIPAA compliant • 📞 24/7 support
    </span>
  </div>
</div>

<style>
  /* Enhanced Card Hover Effects - Matching search-test.astro */
  .provider-card {
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .provider-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    border-left-width: 6px;
  }

  .provider-card.selected {
    border: 3px solid #10b981;
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(16, 185, 129, 0.3);
  }

  /* Enhanced Savings Display */
  .savings-highlight {
    background: linear-gradient(45deg, #10b981, #059669, #047857);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 800;
    animation: gradient-shift 3s ease-in-out infinite;
  }

  @keyframes gradient-shift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Enhanced pricing section */
  .pricing-section {
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border-radius: 12px;
    border-left: 4px solid #10b981;
  }

  .usrad-price {
    padding: 8px 0;
  }

  .price-label {
    font-size: 0.9rem;
    color: #6b7280;
    font-weight: 500;
  }

  /* Enhanced Button Styles */
  .book-btn {
    background: linear-gradient(135deg, #3b82f6, #1d4ed8);
    transition: all 0.3s ease;
  }

  .book-btn:hover {
    background: linear-gradient(135deg, #1d4ed8, #1e40af);
    transform: translateY(-1px);
    box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .provider-card {
      padding: 1rem;
    }

    .text-3xl {
      font-size: 1.5rem;
    }

    .pricing-section {
      padding: 0.75rem;
    }
  }
</style>
