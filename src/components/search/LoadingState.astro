---
export interface LoadingStateProps {
  message?: string;
  subMessage?: string;
  type?: "search" | "booking" | "payment" | "general";
}

const {
  message = "Loading...",
  subMessage = "",
  type = "general",
} = Astro.props;

const loadingMessages = {
  search: "🔍 Searching providers",
  booking: "📅 Processing your booking",
  payment: "💳 Securing your payment",
  general: "⏳ Loading",
};

const loadingSubMessages = {
  search: "Analyzing Medicare rates across our network of 1,500+ centers",
  booking: "Confirming availability and generating your appointment",
  payment: "Encrypting payment data and processing transaction",
  general: "Please wait while we load your information",
};

const displayMessage = message || loadingMessages[type];
const displaySubMessage = subMessage || loadingSubMessages[type];
---

<!-- ===========================================
     src/components/search/LoadingState.astro
     Loading animations and states
     =========================================== -->
<div id="loadingState" class="hidden">
  <div class="bg-white rounded-lg shadow-lg p-8 mb-8 text-center">
    <div class="inline-flex items-center">
      <div
        class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mr-3"
      >
      </div>
      <span class="text-lg text-gray-700 font-medium">
        {displayMessage}<span class="loading-dots"></span>
      </span>
    </div>
    {
      displaySubMessage && (
        <p class="text-sm text-gray-500 mt-2">{displaySubMessage}</p>
      )
    }
  </div>
</div>

<style>
  .loading-dots::after {
    content: "";
    animation: dots 2s infinite;
  }

  @keyframes dots {
    0% {
      content: "";
    }
    25% {
      content: ".";
    }
    50% {
      content: "..";
    }
    75% {
      content: "...";
    }
    100% {
      content: "";
    }
  }
</style>
