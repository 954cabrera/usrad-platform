---
// ProcedureSearchModal.astro - Reusable search modal
// Pure JavaScript implementation for compatibility
---

<div
  id="modal-search-overlay"
  class="fixed inset-0 hidden"
  style="z-index: 9999999;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <!-- Backdrop -->
  <div
    id="modal-backdrop"
    class="absolute inset-0 bg-black/80 backdrop-blur-sm"
    style="opacity: 0; transition: opacity 300ms;"
    aria-hidden="true"
  >
  </div>

  <!-- Modal Container -->
  <div
    class="absolute inset-0 flex items-start justify-center pt-16 sm:pt-24 pb-8 px-4 overflow-y-auto"
  >
    <!-- Modal Content -->
    <div
      id="modal-content"
      class="relative w-full max-w-3xl bg-white rounded-2xl shadow-2xl transition-all"
      style="opacity: 0; transform: scale(0.95); transition: all 300ms;"
    >
      <!-- Header -->
      <div
        class="sticky top-0 z-10 bg-white border-b border-gray-200 rounded-t-2xl px-6 py-5"
      >
        <div class="flex items-center justify-between">
          <h2 id="modal-title" class="text-2xl font-bold text-gray-900">
            Select your procedure
          </h2>
          <button
            type="button"
            id="modal-close-button"
            class="flex-shrink-0 p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-all"
            aria-label="Close search modal"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Search Input -->
        <div class="mt-4 relative">
          <div
            class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
          >
            <svg
              class="w-5 h-5 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="text"
            id="modal-search-input"
            placeholder="Search MRI, CT, Ultrasound..."
            class="w-full pl-12 pr-4 py-3 text-base text-gray-900 placeholder-gray-400 bg-gray-50 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#003087] focus:border-transparent transition-all"
            autocomplete="off"
          />
        </div>
      </div>

      <!-- Results Container -->
      <div
        id="modal-results"
        class="px-6 py-6 max-h-[60vh] overflow-y-auto"
        style="scrollbar-width: thin; scrollbar-color: #003087 #f1f5f9;"
      >
        <div class="text-center py-12 text-gray-500">
          <svg
            class="w-16 h-16 mx-auto mb-4 text-gray-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <p class="text-lg font-medium">Start typing to search procedures</p>
          <p class="text-sm mt-1">Try "MRI", "CT Scan", or "Ultrasound"</p>
        </div>
      </div>

      <!-- Footer -->
      <div
        class="sticky bottom-0 bg-gray-50 border-t border-gray-200 rounded-b-2xl px-6 py-4"
      >
        <div class="text-center">
          <p class="text-sm text-gray-700 font-medium mb-3">
            Can't find your procedure? Try searching by:
          </p>
          <div class="flex flex-wrap justify-center gap-2 text-xs">
            <span
              class="px-3 py-1.5 bg-white border border-gray-200 rounded-full text-gray-600"
            >
              Body part (e.g., "knee", "shoulder")
            </span>
            <span
              class="px-3 py-1.5 bg-white border border-gray-200 rounded-full text-gray-600"
            >
              CPT code (e.g., "70553")
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Self-contained - inline event system
  const SearchEvents = {
    OPEN_MODAL: "usrad:openSearchModal",
    PROCEDURE_SELECTED: "usrad:procedureSelected",
    MODAL_CLOSED: "usrad:modalClosed",
  };

  function dispatchProcedureSelected(procedure) {
    window.dispatchEvent(
      new CustomEvent(SearchEvents.PROCEDURE_SELECTED, {
        detail: { procedure },
      })
    );
  }

  // Import search function
  import { searchUniversalProcedures } from "../../lib/procedures/utils/universal-search-engine.ts";

  // Get DOM elements
  const overlay = document.getElementById("modal-search-overlay");
  const backdrop = document.getElementById("modal-backdrop");
  const content = document.getElementById("modal-content");
  const input = document.getElementById("modal-search-input");
  const results = document.getElementById("modal-results");
  const closeBtn = document.getElementById("modal-close-button");

  // State
  let lastFocusedElement = null;
  let searchTimeout = null;

  console.log("✅ Modal initialized", {
    overlay: overlay !== null,
    input: input !== null,
  });

  // Open modal function - NUCLEAR VERSION
  // Open modal function - NUCLEAR VERSION
  function openModal(initialQuery) {
    if (!overlay || !backdrop || !content || !input) {
      console.error("❌ Modal elements not found");
      return;
    }

    console.log("📖 Opening modal - NUCLEAR approach");
    initialQuery = initialQuery || "";
    lastFocusedElement = document.activeElement;

    // Force overlay to be full screen
    overlay.style.display = "block";
    overlay.style.position = "fixed";
    overlay.style.top = "0";
    overlay.style.left = "0";
    overlay.style.right = "0";
    overlay.style.bottom = "0";
    overlay.style.width = "100vw";
    overlay.style.height = "100vh";
    overlay.style.zIndex = "9999999";

    // Force BOTH parent and grandparent
    const parent = content.parentElement;
    const grandparent = parent?.parentElement;

    if (parent) {
      parent.style.minHeight = "100vh";
      parent.style.height = "100vh";
      parent.style.width = "100%";
      parent.style.display = "flex";
      parent.style.alignItems = "center";
      parent.style.justifyContent = "center";
    }

    if (grandparent) {
      grandparent.style.height = "100vh";
      grandparent.style.width = "100%";
    }

    // Remove ALL classes from content
    content.className =
      "relative w-full max-w-3xl bg-white rounded-2xl shadow-2xl";

    // Force reflow
    overlay.offsetHeight;

    // Apply NUCLEAR styles
    setTimeout(() => {
      backdrop.setAttribute(
        "style",
        "opacity: 1 !important; transition: opacity 300ms !important; position: fixed !important; inset: 0 !important; background: rgba(0, 0, 0, 0.8) !important; backdrop-filter: blur(4px) !important;"
      );

      content.setAttribute(
        "style",
        `
      opacity: 1 !important;
      transform: scale(1) !important;
      transition: all 300ms !important;
      display: block !important;
      visibility: visible !important;
      pointer-events: auto !important;
      position: relative !important;
      width: 768px !important;
      min-height: 400px !important;
      background: white !important;
      border-radius: 1rem !important;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25) !important;
      z-index: 10 !important;
      padding: 2rem !important;
      margin: 2rem auto !important;
    `
      );

      console.log("📖 NUCLEAR styles applied");
      console.log("  Overlay dimensions:", overlay.getBoundingClientRect());
      console.log("  Content dimensions:", content.getBoundingClientRect());
      console.log(
        "  Content computed opacity:",
        window.getComputedStyle(content).opacity
      );
    }, 10);

    // Focus input
    setTimeout(() => {
      input.value = initialQuery;
      input.focus();
      trapFocus(content);
      console.log("📖 Focused input - CHECK IF MODAL IS VISIBLE NOW");
    }, 50);
  }

  // Close modal function
  function closeModal() {
    if (!overlay || !backdrop || !content) return;

    console.log("📕 Closing modal");

    // Animate out
    backdrop.style.opacity = "0";
    content.style.opacity = "0";
    content.style.transform = "scale(0.95)";

    setTimeout(() => {
      overlay.style.display = "none";
      if (lastFocusedElement && lastFocusedElement.focus) {
        lastFocusedElement.focus();
      }
    }, 300);

    window.dispatchEvent(new CustomEvent(SearchEvents.MODAL_CLOSED));
  }

  // Focus trap for accessibility
  function trapFocus(container) {
    if (!container) return;

    const focusableElements = container.querySelectorAll(
      'button, input, [tabindex]:not([tabindex="-1"])'
    );

    if (focusableElements.length === 0) return;

    const firstElement = focusableElements[0];
    const lastElement = focusableElements[focusableElements.length - 1];

    container.addEventListener("keydown", (e) => {
      if (e.key !== "Tab") return;

      if (e.shiftKey) {
        if (document.activeElement === firstElement) {
          e.preventDefault();
          lastElement.focus();
        }
      } else {
        if (document.activeElement === lastElement) {
          e.preventDefault();
          firstElement.focus();
        }
      }
    });
  }

  // Perform search
  function performSearch(value) {
    if (!results) return;

    if (value.length < 2) {
      results.innerHTML = `
        <div class="text-center py-12 text-gray-500">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <p class="text-lg font-medium">Start typing to search procedures</p>
          <p class="text-sm mt-1">Try "MRI", "CT Scan", or "Ultrasound"</p>
        </div>
      `;
      return;
    }

    console.log("🔍 Searching for:", value);
    const matches = searchUniversalProcedures(value, 8);
    console.log("📋 Found results:", matches.length);

    if (!matches || matches.length === 0) {
      results.innerHTML = `
        <div class="text-center py-12 text-gray-500">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <p class="text-lg font-medium">No results found for "${value}"</p>
          <p class="text-sm mt-1">Try a different search term</p>
        </div>
      `;
      return;
    }

    // Render results
    results.innerHTML = matches
      .map(
        (r) => `
      <button 
        class="w-full text-left border-b border-gray-200 px-4 py-3 hover:bg-blue-50 transition-all focus:outline-none focus:ring-2 focus:ring-[#003087] focus:bg-blue-50"
        data-cpt="${r.cpt || ""}" 
        data-label="${(r.label || "").replace(/"/g, "&quot;")}" 
        data-modality="${r.modality || ""}"
        data-bodypart="${r.bodyPart || ""}"
      >
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 w-10 h-10 bg-[#003087] text-white rounded-lg flex items-center justify-center text-sm font-bold">
            ${(r.modality || "").substring(0, 2).toUpperCase()}
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-semibold text-gray-900">${r.label || ""}</div>
            <div class="text-sm text-gray-500 mt-0.5">${r.modality || ""} • ${r.bodyPart || ""} • CPT ${r.cpt || ""}</div>
          </div>
        </div>
      </button>
    `
      )
      .join("");

    // Attach click handlers
    const buttons = results.querySelectorAll("button");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const procedure = {
          cpt_code: btn.getAttribute("data-cpt") || "",
          label: btn.getAttribute("data-label") || "",
          modality: btn.getAttribute("data-modality") || "",
          bodyPart: btn.getAttribute("data-bodypart") || "",
        };
        console.log("✅ Procedure selected from modal:", procedure);
        dispatchProcedureSelected(procedure);
        closeModal();
      });
    });
  }

  // Event listeners
  if (closeBtn) {
    closeBtn.addEventListener("click", closeModal);
  }

  if (backdrop) {
    backdrop.addEventListener("click", closeModal);
  }

  // Listen for open modal event
  window.addEventListener(SearchEvents.OPEN_MODAL, (e) => {
    console.log("📨 Received open modal event");
    const detail = e.detail || {};
    openModal(detail.initialQuery);
  });

  // Debounced search on input
  if (input) {
    input.addEventListener("input", (e) => {
      if (searchTimeout) {
        clearTimeout(searchTimeout);
      }
      searchTimeout = setTimeout(() => {
        const value = e.target.value.trim();
        performSearch(value);
      }, 200);
    });
  }

  // ESC key to close
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay && overlay.style.display !== "none") {
      closeModal();
    }
  });
</script>

<style>
  /* Custom scrollbar */
  #modal-results::-webkit-scrollbar {
    width: 8px;
  }

  #modal-results::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 4px;
  }

  #modal-results::-webkit-scrollbar-thumb {
    background: #003087;
    border-radius: 4px;
  }

  #modal-results::-webkit-scrollbar-thumb:hover {
    background: #002060;
  }
</style>
