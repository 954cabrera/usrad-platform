---
// Clean, minimal modal that WORKS
---

<!-- Modal Overlay -->
<div
  id="modal-search-overlay"
  style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999999;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <!-- Backdrop -->
  <div
    id="modal-backdrop"
    style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(4px); opacity: 0; transition: opacity 300ms;"
    aria-hidden="true"
  >
  </div>

  <!-- Modal Container - SIMPLE STRUCTURE -->
  <div
    style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; overflow-y: auto; padding: 4rem 1rem;"
  >
    <!-- Modal Content -->
    <div
      id="modal-content"
      style="
        max-width: 800px;
        margin: 0 auto;
        background: white;
        border-radius: 1rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        opacity: 0;
        transform: scale(0.95);
        transition: all 300ms ease-out;
      "
    >
      <!-- Header -->
      <div
        style="background: linear-gradient(to right, #003087, #0040a0); padding: 1.5rem; border-radius: 1rem 1rem 0 0; display: flex; align-items: center; justify-content: space-between;"
      >
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <svg
            style="width: 1.5rem; height: 1.5rem; color: white;"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <h2
            id="modal-title"
            style="font-size: 1.5rem; font-weight: 700; color: white; margin: 0;"
          >
            Search Procedures
          </h2>
        </div>
        <button
          type="button"
          id="modal-close-button"
          style="padding: 0.5rem; color: white; opacity: 0.8; background: transparent; border: none; cursor: pointer; border-radius: 0.5rem; transition: all 200ms;"
          aria-label="Close modal"
          onmouseover="this.style.opacity='1'; this.style.background='rgba(255,255,255,0.1)'"
          onmouseout="this.style.opacity='0.8'; this.style.background='transparent'"
        >
          <svg
            style="width: 1.5rem; height: 1.5rem;"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Search Input -->
      <div style="padding: 1.5rem; border-bottom: 1px solid #e5e7eb;">
        <div style="position: relative;">
          <div
            style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); pointer-events: none;"
          >
            <svg
              style="width: 1.25rem; height: 1.25rem; color: #9ca3af;"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="text"
            id="modal-search-input"
            placeholder="Type: MRI, CT, Ultrasound, X-Ray..."
            style="
              width: 100%;
              padding: 0.75rem 1rem 0.75rem 3rem;
              font-size: 1rem;
              border: 2px solid #e5e7eb;
              border-radius: 0.5rem;
              outline: none;
              transition: border-color 200ms;
            "
            onfocus="this.style.borderColor='#003087'"
            onblur="this.style.borderColor='#e5e7eb'"
            autocomplete="off"
          />
        </div>
      </div>

      <!-- Results Container -->
      <div
        id="modal-results"
        style="max-height: 500px; overflow-y: auto; padding: 1rem;"
      >
        <!-- Default empty state -->
        <div style="text-align: center; padding: 3rem 1rem; color: #6b7280;">
          <svg
            style="width: 4rem; height: 4rem; margin: 0 auto 1rem; color: #d1d5db;"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <p
            style="font-size: 1.125rem; font-weight: 600; margin: 0 0 0.5rem 0;"
          >
            Start typing to search
          </p>
          <p style="font-size: 0.875rem; margin: 0;">
            Try "MRI", "CT Scan", or "Ultrasound"
          </p>
        </div>
      </div>

      <!-- Footer -->
      <div
        style="background: #f9fafb; border-top: 1px solid #e5e7eb; padding: 1rem 1.5rem; border-radius: 0 0 1rem 1rem;"
      >
        <p
          style="text-align: center; font-size: 0.875rem; font-weight: 600; color: #374151; margin: 0 0 0.75rem 0;"
        >
          Can't find your procedure? Try searching by:
        </p>
        <div
          style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem;"
        >
          <span
            style="padding: 0.375rem 0.75rem; background: white; border: 1px solid #d1d5db; border-radius: 9999px; font-size: 0.75rem; color: #4b5563;"
          >
            Body part (e.g., "knee", "shoulder")
          </span>
          <span
            style="padding: 0.375rem 0.75rem; background: white; border: 1px solid #d1d5db; border-radius: 9999px; font-size: 0.75rem; color: #4b5563;"
          >
            CPT code (e.g., "70553")
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Event system
  const SearchEvents = {
    OPEN_MODAL: "usrad:openSearchModal",
    PROCEDURE_SELECTED: "usrad:procedureSelected",
    MODAL_CLOSED: "usrad:modalClosed",
  };

  function dispatchProcedureSelected(procedure) {
    window.dispatchEvent(
      new CustomEvent(SearchEvents.PROCEDURE_SELECTED, {
        detail: { procedure },
      })
    );
  }

  // Import search
  import { searchUniversalProcedures } from "../../lib/procedures/utils/universal-search-engine.ts";

  // Get elements
  const overlay = document.getElementById("modal-search-overlay");
  const backdrop = document.getElementById("modal-backdrop");
  const content = document.getElementById("modal-content");
  const input = document.getElementById("modal-search-input");
  const results = document.getElementById("modal-results");
  const closeBtn = document.getElementById("modal-close-button");

  let lastFocusedElement = null;
  let searchTimeout = null;

  console.log("✅ Modal V2 initialized");

  // SIMPLE open modal
  function openModal(initialQuery = "") {
    if (!overlay || !backdrop || !content || !input) {
      console.error("❌ Modal elements missing");
      return;
    }

    console.log("📖 Opening modal V2");
    lastFocusedElement = document.activeElement;

    // Show overlay
    overlay.style.display = "block";

    // Animate in
    requestAnimationFrame(() => {
      backdrop.style.opacity = "1";
      content.style.opacity = "1";
      content.style.transform = "scale(1)";
    });

    // Focus input
    setTimeout(() => {
      input.value = initialQuery;
      input.focus();
    }, 100);

    console.log("✅ Modal opened - should be visible!");
  }

  // Close modal
  function closeModal() {
    if (!overlay || !backdrop || !content) return;

    console.log("📕 Closing modal");

    backdrop.style.opacity = "0";
    content.style.opacity = "0";
    content.style.transform = "scale(0.95)";

    setTimeout(() => {
      overlay.style.display = "none";
      if (lastFocusedElement?.focus) {
        lastFocusedElement.focus();
      }
    }, 300);

    window.dispatchEvent(new CustomEvent(SearchEvents.MODAL_CLOSED));
  }

  // Search function
  function performSearch(value) {
    if (!results) return;

    if (value.length < 2) {
      results.innerHTML = `
        <div style="text-align: center; padding: 3rem 1rem; color: #6b7280;">
          <svg style="width: 4rem; height: 4rem; margin: 0 auto 1rem; color: #d1d5db;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <p style="font-size: 1.125rem; font-weight: 600; margin: 0 0 0.5rem 0;">Start typing to search</p>
          <p style="font-size: 0.875rem; margin: 0;">Try "MRI", "CT Scan", or "Ultrasound"</p>
        </div>
      `;
      return;
    }

    console.log("🔍 Searching:", value);
    const matches = searchUniversalProcedures(value, 8);
    console.log("📋 Results:", matches.length);

    if (!matches?.length) {
      results.innerHTML = `
        <div style="text-align: center; padding: 3rem 1rem; color: #6b7280;">
          <svg style="width: 4rem; height: 4rem; margin: 0 auto 1rem; color: #d1d5db;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <p style="font-size: 1.125rem; font-weight: 600; margin: 0 0 0.5rem 0;">No results for "${value}"</p>
          <p style="font-size: 0.875rem; margin: 0;">Try a different search term</p>
        </div>
      `;
      return;
    }

    // Render results
    results.innerHTML = matches
      .map(
        (r) => `
      <button 
        class="result-item"
        data-cpt="${r.cpt || ""}" 
        data-label="${(r.label || "").replace(/"/g, "&quot;")}" 
        data-modality="${r.modality || ""}"
        data-bodypart="${r.bodyPart || ""}"
        style="
          width: 100%;
          text-align: left;
          border: none;
          border-bottom: 1px solid #e5e7eb;
          padding: 1rem;
          background: white;
          cursor: pointer;
          transition: background 200ms;
        "
        onmouseover="this.style.background='#eff6ff'"
        onmouseout="this.style.background='white'"
      >
        <div style="display: flex; align-items: start; gap: 0.75rem;">
          <div style="flex-shrink: 0; width: 2.5rem; height: 2.5rem; background: #003087; color: white; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">
            ${(r.modality || "").substring(0, 2).toUpperCase()}
          </div>
          <div style="flex: 1; min-width: 0;">
            <div style="font-weight: 600; color: #111827; margin-bottom: 0.25rem;">${r.label || ""}</div>
            <div style="font-size: 0.875rem; color: #6b7280;">${r.modality || ""} • ${r.bodyPart || ""} • CPT ${r.cpt || ""}</div>
          </div>
        </div>
      </button>
    `
      )
      .join("");

    // Add click handlers
    results.querySelectorAll(".result-item").forEach((btn) => {
      btn.addEventListener("click", () => {
        const procedure = {
          cpt_code: btn.getAttribute("data-cpt"),
          label: btn.getAttribute("data-label"),
          modality: btn.getAttribute("data-modality"),
          bodyPart: btn.getAttribute("data-bodypart"),
        };
        console.log("✅ Selected:", procedure);
        dispatchProcedureSelected(procedure);
        closeModal();
      });
    });
  }

  // Event listeners
  if (closeBtn) closeBtn.addEventListener("click", closeModal);
  if (backdrop) backdrop.addEventListener("click", closeModal);

  window.addEventListener(SearchEvents.OPEN_MODAL, (e) => {
    console.log("📨 Open event received");
    openModal(e.detail?.initialQuery || "");
  });

  if (input) {
    input.addEventListener("input", (e) => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(
        () => performSearch(e.target.value.trim()),
        200
      );
    });
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay?.style.display === "block") {
      closeModal();
    }
  });
</script>

<style>
  #modal-results::-webkit-scrollbar {
    width: 8px;
  }
  #modal-results::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 4px;
  }
  #modal-results::-webkit-scrollbar-thumb {
    background: #003087;
    border-radius: 4px;
  }
</style>
