---
export interface SearchFormProps {
  initialZipCode?: string;
  initialState?: string;
  initialProcedure?: string;
  onSearch?: string; // Function name to call on search
}

const {
  initialZipCode = "",
  initialState = "FL",
  initialProcedure = "70551",
  onSearch = "handleSearch",
} = Astro.props;
---

<!-- ===========================================
     src/components/search/SearchForm.astro
     Modular search form component
     =========================================== -->
<div class="bg-white rounded-lg shadow-lg p-6 mb-8">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div>
      <label for="zipCode" class="block text-sm font-medium text-gray-700 mb-2">
        ZIP Code
      </label>
      <input
        type="text"
        id="zipCode"
        value={initialZipCode}
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        placeholder="Enter ZIP code"
        maxlength="10"
      />
      <p class="text-xs text-gray-500 mt-1">
        Try: 33012 (Miami), 33330 (Fort Lauderdale)
      </p>
    </div>

    <div>
      <label
        for="procedure"
        class="block text-sm font-medium text-gray-700 mb-2"
      >
        Procedure
      </label>
      <select
        id="procedure"
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <option value="70551" selected={initialProcedure === "70551"}>
          MRI Brain without contrast
        </option>
        <option value="70552" selected={initialProcedure === "70552"}>
          MRI Brain with contrast
        </option>
        <option value="72148" selected={initialProcedure === "72148"}>
          MRI Lumbar Spine without contrast
        </option>
        <option value="72149" selected={initialProcedure === "72149"}>
          MRI Lumbar Spine with contrast
        </option>
        <option value="74177" selected={initialProcedure === "74177"}>
          CT Abdomen and Pelvis with contrast
        </option>
      </select>
    </div>

    <div>
      <label for="state" class="block text-sm font-medium text-gray-700 mb-2">
        State
      </label>
      <select
        id="state"
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <option value="FL" selected={initialState === "FL"}>Florida</option>
        <option value="GA" selected={initialState === "GA"}>Georgia</option>
        <option value="TX" selected={initialState === "TX"}>Texas</option>
        <option value="CA" selected={initialState === "CA"}>California</option>
      </select>
    </div>

    <div class="flex items-end">
      <button
        id="searchBtn"
        class="w-full bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-200 font-medium"
      >
        Search Providers
      </button>
    </div>
  </div>
</div>

<script define:vars={{ onSearch }}>
  // Setup search form functionality
  document.addEventListener("DOMContentLoaded", () => {
    const searchBtn = document.getElementById("searchBtn");
    const zipInput = document.getElementById("zipCode");
    const procedureSelect = document.getElementById("procedure");
    const stateSelect = document.getElementById("state");

    // Search button click handler
    searchBtn?.addEventListener("click", () => {
      const searchParams = {
        zipCode: zipInput?.value || "",
        procedure: procedureSelect?.value || "70551",
        state: stateSelect?.value || "FL",
      };

      // Call the specified search function
      if (window[onSearch]) {
        window[onSearch](searchParams);
      } else {
        console.warn(`Search function '${onSearch}' not found`);
      }
    });

    // Enter key handler for ZIP code input
    zipInput?.addEventListener("keypress", (e) => {
      if (e.key === "Enter") {
        searchBtn?.click();
      }
    });

    // Input validation for ZIP code
    zipInput?.addEventListener("input", (e) => {
      const value = e.target.value;
      const isValid = /^\d{0,5}$/.test(value);

      if (!isValid) {
        e.target.value = value.slice(0, -1);
      }

      // Update button state
      const hasValue = value.length >= 5;
      searchBtn.disabled = !hasValue;
      searchBtn.classList.toggle("opacity-50", !hasValue);
    });
  });
</script>
