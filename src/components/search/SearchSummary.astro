---
export interface SearchSummaryProps {
  totalResults?: number;
  searchCriteria?: {
    zipCode?: string;
    state?: string;
    procedure?: string;
    city?: string;
  };
  averageSavings?: number;
  averagePrice?: number;
  searchTime?: number;
  networkSize?: number;
}

const {
  totalResults = 0,
  searchCriteria = {},
  averageSavings = 0,
  averagePrice = 0,
  searchTime = 0,
  networkSize = 1500,
} = Astro.props;

const procedureNames = {
  "70551": "MRI Brain without contrast",
  "70552": "MRI Brain with contrast",
  "72148": "MRI Lumbar Spine without contrast",
  "72149": "MRI Lumbar Spine with contrast",
  "74177": "CT Abdomen and Pelvis with contrast",
  "76700": "Ultrasound Abdomen",
  "71046": "Chest X-Ray",
};

const procedureName =
  procedureNames[searchCriteria.procedure] || "Medical Imaging";
---

<!-- ===========================================
     src/components/search/SearchSummary.astro
     Search metrics and summary display
     =========================================== -->
<div
  id="searchSummary"
  class="bg-gradient-to-r from-green-50 to-blue-50 rounded-lg p-6 mb-6 border border-green-200"
>
  <!-- Header Section -->
  <div class="flex items-center justify-between flex-wrap mb-4">
    <div>
      <h3 class="text-lg font-semibold text-gray-900 mb-1">Search Results</h3>
      <p id="summaryText" class="text-sm text-gray-600">
        {
          totalResults > 0
            ? `Found ${totalResults} providers for ${procedureName} • Average savings: ${averageSavings}% vs hospitals`
            : "Enter your ZIP code to find providers with transparent Medicare pricing"
        }
      </p>
    </div>

    <div
      id="networkBadge"
      class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium"
    >
      Part of {networkSize.toLocaleString()}+ center network
    </div>
  </div>

  <!-- Search Criteria Display -->
  {
    searchCriteria.zipCode && (
      <div class="bg-white/50 rounded-lg p-3 mb-4">
        <div class="flex flex-wrap items-center gap-4 text-sm">
          <div class="flex items-center">
            <span class="text-gray-600 mr-2">📍 Location:</span>
            <span class="font-medium">{searchCriteria.zipCode}</span>
            {searchCriteria.city && (
              <span class="text-gray-500 ml-1">
                ({searchCriteria.city}, {searchCriteria.state})
              </span>
            )}
          </div>

          <div class="flex items-center">
            <span class="text-gray-600 mr-2">🔬 Procedure:</span>
            <span class="font-medium">{procedureName}</span>
          </div>

          {searchTime > 0 && (
            <div class="flex items-center">
              <span class="text-gray-600 mr-2">⚡ Search time:</span>
              <span class="font-medium">{searchTime.toFixed(2)}s</span>
            </div>
          )}
        </div>
      </div>
    )
  }

  <!-- Enhanced Metrics -->
  {
    totalResults > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="text-center bg-white/50 rounded-lg p-4">
          <div class="text-2xl font-bold text-green-600" id="avgSavings">
            {averageSavings}%
          </div>
          <div class="text-sm text-gray-600">Average Savings</div>
          <div class="text-xs text-gray-500 mt-1">vs hospital pricing</div>
        </div>

        <div class="text-center bg-white/50 rounded-lg p-4">
          <div class="text-2xl font-bold text-blue-600" id="totalProviders">
            {totalResults}
          </div>
          <div class="text-sm text-gray-600">Providers Found</div>
          <div class="text-xs text-gray-500 mt-1">in your area</div>
        </div>

        <div class="text-center bg-white/50 rounded-lg p-4">
          <div class="text-2xl font-bold text-purple-600" id="avgPrice">
            ${Math.round(averagePrice)}
          </div>
          <div class="text-sm text-gray-600">Average Price</div>
          <div class="text-xs text-gray-500 mt-1">with USRad savings</div>
        </div>
      </div>
    )
  }

  <!-- Call to Action for Empty Results -->
  {
    totalResults === 0 && searchCriteria.zipCode && (
      <div class="text-center py-4">
        <div class="text-4xl mb-2">🔍</div>
        <p class="text-gray-600 mb-3">No providers found in this area yet.</p>
        <div class="space-x-3">
          <button
            id="expandSearchRadius"
            class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors text-sm"
          >
            Expand Search Area
          </button>
          <button
            id="notifyWhenAvailable"
            class="border border-blue-600 text-blue-600 px-4 py-2 rounded-md hover:bg-blue-50 transition-colors text-sm"
          >
            Notify When Available
          </button>
        </div>
      </div>
    )
  }
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Expand search radius handler
    document
      .getElementById("expandSearchRadius")
      ?.addEventListener("click", () => {
        if (window.searchPageController) {
          window.searchPageController.expandSearch();
        }
      });

    // Notify when available handler
    document
      .getElementById("notifyWhenAvailable")
      ?.addEventListener("click", () => {
        if (window.uiManager) {
          window.uiManager.showModal("notifyModal");
        }
      });

    // Update metrics with animation when data changes
    window.addEventListener("searchResultsUpdated", (event) => {
      const { results, averageSavings, averagePrice } = event.detail;

      if (window.uiManager) {
        window.uiManager.animateCounter("avgSavings", averageSavings, {
          suffix: "%",
        });
        window.uiManager.animateCounter("totalProviders", results.length);
        window.uiManager.animateCounter("avgPrice", averagePrice, {
          prefix: "$",
        });
      }
    });
  });
</script>
