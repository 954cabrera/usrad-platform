---
/**
 * MemberRightsSummary.astro
 *
 * Reusable trust section introducing the USRad Member Bill of Rights.
 * Designed for use on the How It Works page and Booking page.
 *
 * Trigger button opens a self-contained Astro-native modal.
 * No React. No imports. No client islands.
 */

const rights = [
  {
    number: 1,
    title: "Transparent Pricing",
    description:
      "View clear, upfront pricing before booking. The price displayed prior to payment represents the full cost of the imaging service, with no hidden fees or surprise charges.",
  },
  {
    number: 2,
    title: "Informed Scheduling",
    description:
      "Review your appointment details — including facility location, date, time, and any preparation requirements — before confirming your imaging appointment.",
  },
  {
    number: 3,
    title: "Timely Communication",
    description:
      "Receive prompt updates regarding your booking status, appointment confirmations, and any changes to your scheduled service.",
  },
  {
    number: 4,
    title: "Access to Records",
    description:
      "Obtain documentation related to your booking, authorization code, and payment receipts through your Member Portal.",
  },
  {
    number: 5,
    title: "Quality Imaging",
    description:
      "Receive imaging services at accredited facilities staffed by licensed technologists and interpreted by board-certified radiologists.",
  },
  {
    number: 6,
    title: "Privacy and Security",
    description:
      "Have your personal and medical information protected in accordance with applicable privacy standards and handled with appropriate safeguards.",
  },
  {
    number: 7,
    title: "Secure Payment Processing",
    description:
      "Have payment handled through industry-standard secure systems. USRad does not store your card details.",
  },
  {
    number: 8,
    title: "Respectful Service",
    description:
      "Be treated with professionalism and dignity at every point of contact — from booking through imaging and follow-up.",
  },
  {
    number: 9,
    title: "Right to Raise Concerns",
    description:
      "If you believe your rights under this document have not been upheld, you may contact USRad Support to request a review of your experience. Our team will investigate concerns related to scheduling, billing, or service coordination and work toward a prompt resolution.",
  },
];
---

<!-- ============================================================
  MEMBER RIGHTS SUMMARY SECTION
============================================================ -->
<section class="bg-white border-t border-gray-100">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <h2 class="text-2xl font-semibold text-gray-900">
      Your Rights as a USRad Member
    </h2>
    <p class="text-gray-500 text-sm font-medium mt-1">
      Protected by the USRad Member Bill of Rights
    </p>
    <p class="text-gray-600 mt-3">
      When you use the USRad network, you are protected by our Member Bill of
      Rights, ensuring transparency, security, and respectful care coordination.
    </p>

    <ul class="mt-6 space-y-2">
      <li class="flex items-start gap-3 text-gray-700">
        <svg
          class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        Transparent pricing before booking
      </li>
      <li class="flex items-start gap-3 text-gray-700">
        <svg
          class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        Secure payment processing
      </li>
      <li class="flex items-start gap-3 text-gray-700">
        <svg
          class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        Access to imaging records
      </li>
      <li class="flex items-start gap-3 text-gray-700">
        <svg
          class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"></path>
        </svg>
        Respectful and professional service
      </li>
    </ul>

    <button
      id="mbor-trigger"
      type="button"
      class="inline-block mt-6 text-[#003087] font-medium hover:underline cursor-pointer bg-transparent border-none p-0"
    >
      View the full Member Bill of Rights →
    </button>
  </div>
</section>

<!-- ============================================================
  MEMBER BILL OF RIGHTS MODAL
============================================================ -->
<div
  id="mbor-modal"
  class="fixed inset-0 z-50 overflow-y-auto hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mbor-title"
>
  <!-- Backdrop -->
  <div id="mbor-backdrop" class="fixed inset-0 bg-black/50 transition-opacity">
  </div>

  <!-- Modal panel -->
  <div class="flex min-h-full items-center justify-center p-4">
    <div
      class="relative bg-white rounded-2xl shadow-xl max-w-lg w-full max-h-[90vh] overflow-y-auto"
    >
      <!-- Navy accent line -->
      <div class="h-[3px] bg-[#003087] rounded-t-2xl"></div>

      <!-- Header -->
      <div class="px-6 pt-5 pb-4 border-b border-slate-200">
        <div class="flex items-start justify-between">
          <div>
            <h2 id="mbor-title" class="text-lg font-semibold text-slate-900">
              Member Bill of Rights
            </h2>
            <p class="text-sm text-slate-500 mt-1">
              USRad Network — Member Protections
            </p>
          </div>
          <button
            id="mbor-close"
            type="button"
            class="p-2 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-100 transition-colors"
            aria-label="Close"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Body -->
      <div class="px-6 py-5">
        <p class="text-sm text-slate-600 leading-relaxed mb-6">
          As a USRad member, you are entitled to the following protections
          throughout your imaging experience.
        </p>

        <div class="space-y-5">
          {
            rights.map((right) => (
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-7 h-7 rounded-full bg-[#003087]/10 flex items-center justify-center">
                  <span class="text-xs font-semibold text-[#003087]">
                    {right.number}
                  </span>
                </div>
                <div class="min-w-0">
                  <h3 class="text-sm font-semibold text-slate-900">
                    {right.title}
                  </h3>
                  <p class="text-sm text-slate-600 leading-relaxed mt-1">
                    {right.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Institutional footer -->
        <div class="mt-6 pt-5 border-t border-slate-200">
          <p class="text-xs text-slate-400 leading-relaxed">
            This document reflects USRad's commitment to member care and service
            standards. For questions or concerns, contact us at{" "}
            <span class="text-[#003087]">1-866-USRad-24</span> or{" "}
            <span class="text-[#003087]">support@usrad.com</span>.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("mbor-modal");
  const trigger = document.getElementById("mbor-trigger");
  const close = document.getElementById("mbor-close");
  const backdrop = document.getElementById("mbor-backdrop");

  function openModal() {
    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal.classList.add("hidden");
    document.body.style.overflow = "";
  }

  trigger.addEventListener("click", openModal);
  close.addEventListener("click", closeModal);
  backdrop.addEventListener("click", closeModal);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });
</script>
