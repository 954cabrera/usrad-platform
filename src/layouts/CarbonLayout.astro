---
// CarbonLayout.astro
import "../styles/global-carbon.css";
import UtilityBar from "../components/UtilityBar.astro";
import CarbonFooter from "../components/CarbonFooter.astro";
import CarbonHeader from "../components/CarbonHeader.jsx";
import ProcedureSearchModal from "@/components/search/ProcedureSearchModal.astro";

export interface Props {
  title?: string;
  description?: string;
  isHeroPage?: boolean;
  hideNewsletter?: boolean;
}

const {
  title = "USRad - MRI Scans in 48 Hours, 70% Less",
  description = "Get same-day MRI appointments at 70% less than hospital prices. Board-certified radiologists, 1,500+ locations nationwide.",
  isHeroPage = false,
  hideNewsletter = false,
} = Astro.props;

const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || "G-60JBC6WVCW";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!--
      Viewport: prevents pinch-zoom on mobile to keep search and form
      interactions stable. Note: this is a known WCAG 2.1 §1.4.4 concern;
      a future accessibility pass should evaluate removing user-scalable=no
      and verifying no layout regressions across marketing pages.
    -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />

    <!-- Theme -->
    <meta name="color-scheme" content="light only" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <!-- Prevent browser bfcache from restoring stale search state -->
    <script is:inline>
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) {
          console.log("⚠️ Page restored from bfcache - forcing reload");
          window.location.reload();
        }
      });
    </script>

    <!-- Fonts - Inter for that clean Carbon Health look -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- AOS Animation Library -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

    <!-- Open Graph defaults -->
    <meta
      property="og:title"
      content="USRad — National Diagnostic Imaging Access Infrastructure"
    />
    <meta
      property="og:description"
      content="Access high-quality medical imaging nationwide with transparent pricing and infrastructure-grade reliability."
    />
    <meta property="og:image" content="https://usrad.com/og-default.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://usrad.com/og-default.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <!-- Google Analytics 4 -->
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}
      is:inline></script>
    <script define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag("js", new Date());
      window.gtag("config", ga4Id, {
        anonymize_ip: true,
        linker: {
          domains: ["usrad.com", "app.usrad.com"],
        },
      });
    </script>

    <!--
      Per-page <head> injection slot.
 
      Use from any page that consumes CarbonLayout to inject page-specific
      meta tags (noindex, canonical, page-specific OG, JSON-LD, etc.):
 
        <CarbonLayout title="..." description="...">
          <Fragment slot="head">
            <meta name="robots" content="noindex, nofollow" />
            <link rel="canonical" href="https://usrad.com/..." />
          </Fragment>
          ...page content...
        </CarbonLayout>
 
      Positioned at end of <head> so per-page tags come AFTER layout defaults,
      letting pages override og:title etc. when needed.
    -->
    <slot name="head" />
  </head>

  <body class="font-inter text-gray-900 bg-white antialiased">
    <!-- Enhanced Carbon Header Component with Hero Page Prop -->
    <CarbonHeader client:load isHeroPage={isHeroPage} />

    <!-- Main Content -->
    <main class={isHeroPage ? "" : "pt-16"}>
      <slot />
    </main>

    <!-- Carbon Style Footer - Using Astro Component -->
    <CarbonFooter hideNewsletter={hideNewsletter} />
  </body>
</html>

<!-- AOS Animation Script -->
<script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

<!-- 
  REFACTOR NOTE: Procedure data now loaded as ES6 module above
  Legacy global script removed during refactor on November 12, 2025
  The module automatically sets window.ProcedureLibrary for backward compatibility
-->

<!-- Initialize AOS Animations -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    if (typeof AOS !== "undefined") {
      AOS.init({
        duration: 800,
        once: true,
        easing: "ease-out",
        offset: 100,
      });
      console.log("✅ AOS initialized successfully");
    } else {
      console.error("❌ AOS library not loaded");
    }
  });
</script>

<style is:global>
  body {
    font-family:
      "Inter",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }

  ::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 5px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #555;
  }
</style>

<script
  src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"
></script>
