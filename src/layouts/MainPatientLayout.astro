---
// layouts/MainPatientLayout.astro - Fixed Header Height
import "../styles/global.css";
import AOSInit from "../components/AOSInit.astro";
import PatientHeader from "../components/PatientHeader.jsx";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><slot name="title" /></title>
    <meta name="color-scheme" content="light only" />
    <meta name="theme-color" content="#fcf9f0" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="msapplication-TileColor" content="#fcf9f0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <AOSInit />
  </head>

  <body class="font-manrope text-[#003087] bg-[#fcf9f0] min-h-screen">
    <!-- Utility Header with Fixed Height -->
    <header
      class="w-full bg-[#fcf9f0] border-b border-gray-200 relative z-50"
      style="min-height: 56px !important; height: 56px !important;"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" style="height: 100%;">
        <div
          class="flex justify-between items-center"
          style="height: 100%; min-height: 56px; padding: 8px 0;"
        >
          <!-- Left side -->
          <div class="flex items-center">
            <span class="text-sm text-gray-600 font-medium">
              Revolutionizing Medical Imaging Access
            </span>
          </div>

          <!-- Right side - Fixed Position Button -->
          <div
            class="flex items-center"
            style="position: relative; z-index: 100;"
          >
            <a
              href="/partners/managed-care"
              style="
                background-color: #e67e22 !important;
                color: white !important;
                text-decoration: none !important;
                display: inline-block !important;
                font-weight: 600 !important;
                padding: 10px 20px !important;
                border-radius: 8px !important;
                font-size: 14px !important;
                box-shadow: 0 3px 6px rgba(0,0,0,0.2) !important;
                border: 2px solid #d35400 !important;
                position: relative !important;
                z-index: 1000 !important;
                min-width: 160px !important;
                text-align: center !important;
                white-space: nowrap !important;
                line-height: 1.2 !important;
              "
              class="imaging-centers-btn-final"
            >
              For Imaging Centers
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Patient Header -->
    <PatientHeader client:load showStickyBar={true} />

    <!-- Main Content -->
    <main class="main-content relative z-10">
      <slot />
    </main>

    <Footer />

    <!-- Logout Success Toast -->
    <div id="logout-toast" class="hidden fixed top-6 right-6 z-[9999]">
      <div
        class="bg-white border border-green-200 rounded-2xl p-5 shadow-2xl max-w-sm transform transition-all duration-300 ease-out"
      >
        <div class="flex items-start">
          <!-- Success Icon with Animation -->
          <div class="flex-shrink-0 mr-4">
            <div
              class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-600 rounded-full flex items-center justify-center shadow-lg"
            >
              <svg
                class="w-6 h-6 text-white animate-pulse"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="3"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
          </div>

          <!-- Content -->
          <div class="flex-1 min-w-0">
            <p class="text-base font-semibold text-gray-900 mb-1">
              Successfully signed out
            </p>
            <p class="text-sm text-gray-600 leading-relaxed">
              Thanks for using USRad! Your session has ended securely.
            </p>
          </div>

          <!-- Close Button -->
          <button
            onclick="window.closeToast()"
            class="flex-shrink-0 ml-4 text-gray-400 hover:text-gray-600 transition-colors duration-200 p-1 rounded-lg hover:bg-gray-100"
            aria-label="Close notification"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Progress Bar -->
        <div class="mt-4 bg-gray-100 rounded-full h-1 overflow-hidden">
          <div
            class="bg-gradient-to-r from-green-500 to-green-600 h-full rounded-full animate-shrink-width"
          >
          </div>
        </div>
      </div>
    </div>

    <style>
      /* Force proper header height and visibility */
      header {
        position: relative !important;
        z-index: 50 !important;
        min-height: 56px !important;
        height: 56px !important;
        background-color: #fcf9f0 !important;
        border-bottom: 1px solid #e5e7eb !important;
        width: 100% !important;
        overflow: visible !important;
      }

      /* Force button visibility */
      .imaging-centers-btn-final {
        background-color: #e67e22 !important;
        color: white !important;
        text-decoration: none !important;
        display: inline-block !important;
        font-weight: 600 !important;
        padding: 10px 20px !important;
        border-radius: 8px !important;
        font-size: 14px !important;
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.2) !important;
        border: 2px solid #d35400 !important;
        position: relative !important;
        z-index: 1000 !important;
        min-width: 160px !important;
        text-align: center !important;
        white-space: nowrap !important;
        line-height: 1.2 !important;
        visibility: visible !important;
        opacity: 1 !important;
        overflow: visible !important;
      }

      .imaging-centers-btn-final:hover {
        background-color: #d35400 !important;
        color: white !important;
        transform: translateY(-1px) !important;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25) !important;
      }

      /* Ensure no parent containers are clipping */
      header * {
        overflow: visible !important;
      }

      /* Toast animations */
      @keyframes shrink-width {
        from {
          width: 100%;
        }
        to {
          width: 0%;
        }
      }

      .animate-shrink-width {
        animation: shrink-width 5s linear forwards;
      }

      #logout-toast.show {
        animation: slideInRight 0.5s ease-out forwards;
      }

      @keyframes slideInRight {
        from {
          transform: translateX(100%) scale(0.95);
          opacity: 0;
        }
        to {
          transform: translateX(0) scale(1);
          opacity: 1;
        }
      }

      /* Simple main content spacing */
      .main-content {
        margin-top: 0;
        padding-top: 0;
      }

      /* Ensure body has no conflicts */
      body {
        padding-top: 0;
        margin-top: 0;
        overflow-x: hidden;
      }

      /* Prevent any global styles from interfering */
      * {
        box-sizing: border-box;
      }

      /* Mobile responsiveness */
      @media (max-width: 768px) {
        header {
          min-height: 52px !important;
          height: 52px !important;
        }

        .imaging-centers-btn-final {
          font-size: 13px !important;
          padding: 8px 16px !important;
          min-width: 140px !important;
        }

        header .text-sm {
          font-size: 12px !important;
        }
      }

      @media (max-width: 640px) {
        /* Hide tagline on mobile */
        header .flex.items-center:first-child {
          display: none !important;
        }

        /* Center button on mobile */
        header .flex.justify-between {
          justify-content: center !important;
        }
      }
    </style>

    <script>
      console.log("🔍 Final version - checking button visibility...");

      // Make functions global to avoid conflicts
      window.closeToast = function () {
        window.hideToast();
      };

      window.hideToast = function () {
        const toast = document.getElementById("logout-toast");
        if (toast) {
          toast.style.opacity = "0";
          toast.style.transform = "translateX(100%)";
          toast.style.transition = "all 0.3s ease";
          setTimeout(() => {
            toast.classList.add("hidden");
            toast.style.opacity = "";
            toast.style.transform = "";
            toast.style.transition = "";
          }, 300);
        }
      };

      // Use setTimeout to delay execution and avoid conflicts
      setTimeout(function () {
        console.log("Checking for logout success...");

        if (sessionStorage.getItem("logout_success") === "true") {
          console.log("Found logout success, showing toast");
          sessionStorage.removeItem("logout_success");

          const toast = document.getElementById("logout-toast");
          if (toast) {
            console.log("Showing toast element");
            toast.classList.remove("hidden");
            setTimeout(() => {
              console.log("Auto-hiding toast");
              window.hideToast();
            }, 5000);
          }
        }

        // Final debug check
        const button = document.querySelector(".imaging-centers-btn-final");
        const header = document.querySelector("header");

        console.log("🔍 FINAL CHECK:");
        console.log("🔍 Header found:", !!header);
        console.log("🔍 Button found:", !!button);

        if (header) {
          const headerRect = header.getBoundingClientRect();
          console.log("🔍 Header position:", {
            top: headerRect.top,
            left: headerRect.left,
            width: headerRect.width,
            height: headerRect.height,
            bottom: headerRect.bottom,
          });
        }

        if (button) {
          const buttonRect = button.getBoundingClientRect();
          console.log("🔍 Button position:", {
            top: buttonRect.top,
            left: buttonRect.left,
            width: buttonRect.width,
            height: buttonRect.height,
            bottom: buttonRect.bottom,
            right: buttonRect.right,
          });
          console.log(
            "🔍 Button is visible in viewport:",
            buttonRect.top >= 0 &&
              buttonRect.left >= 0 &&
              buttonRect.bottom <= window.innerHeight &&
              buttonRect.right <= window.innerWidth
          );
        }
      }, 1000);
    </script>
  </body>
</html>
