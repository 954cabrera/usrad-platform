---
// Modular, premium blog post layout for USRad
import CarbonLayout from "../layouts/CarbonLayout.astro";
import CTASection from "../components/blog/CTASection.astro";
import CalloutBox from "../../components/blog/CalloutBox.astro";
import CompareTable from "../../components/blog/CompareTable.astro";
import FAQAccordion from "../../components/blog/FAQAccordion.astro";

export interface Props {
  title: string;
  description: string;
  heroImage?: string;
  tagline?: string;
  readTime?: string;
  author?: string;
}

const {
  title,
  description,
  heroImage,
  tagline,
  readTime = "5 min read",
  author = "USRad Editorial Team",
} = Astro.props;
---

<CarbonLayout title={title} description={description} isHeroPage={false}>
  <section class="bg-white py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 leading-tight">
        {title}
      </h1>
      {tagline && <p class="mt-4 text-lg text-gray-600">{tagline}</p>}
      <div class="mt-4 text-sm text-gray-400">
        <span>{author}</span> &middot; <span>{readTime}</span>
      </div>
    </div>

    {
      heroImage && (
        <div class="max-w-5xl mx-auto mt-12">
          <img
            src={heroImage}
            alt={title}
            class="rounded-xl shadow-lg w-full"
            loading="lazy"
          />
        </div>
      )
    }
  </section>

  <article
    class="prose prose-lg prose-blue max-w-3xl mx-auto px-4 sm:px-6 lg:px-0 pb-24 prose-headings:text-gray-900 prose-a:text-[#003087] prose-li:marker:text-[#003087]"
  >
    <slot />
  </article>

  <CTASection />
</CarbonLayout>
