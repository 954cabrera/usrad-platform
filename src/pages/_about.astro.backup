---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import Footer from "../components/Footer.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import FadeIn from "../components/FadeIn.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
const showPatientHeader = true;
---

<MainPatientLayout>
  <AOSInit />

  <!-- HERO SECTION - CREDIBILITY FIRST -->
  <section
    class="bg-gradient-to-br from-[#f8f2e1] to-[#fcf9f0] text-[#003087] py-16 md:py-24 lg:py-32 px-4 md:px-6"
  >
    <div class="max-w-6xl mx-auto">
      <!-- CREDIBILITY BANNER -->
      <div class="text-center mb-8" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 bg-[#cc9933] text-white px-6 py-3 rounded-full text-sm font-bold mb-6"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          PROVEN HEALTHCARE INNOVATORS
        </div>
      </div>

      <div class="text-center mb-16">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-semibold leading-tight mb-6 md:mb-8 text-[#003087] font-manrope"
          data-aos="fade-up"
          data-aos-duration="800"
        >
          $400M+ in Proven Savings
        </h1>
        <p
          class="text-base sm:text-lg md:text-xl text-[#003087] max-w-4xl mx-auto leading-relaxed font-manrope"
          data-aos="fade-up"
          data-aos-duration="800"
          data-aos-delay="100"
        >
          The team behind USRad didn't just theorize about healthcare
          improvement—we built AnciCare into America's largest imaging network,
          serving <strong>400,000+ patients</strong> and delivering
          <strong>$400M+ in total savings</strong> before successfully exiting to
          a public company.
        </p>
      </div>

      <!-- PROOF METRICS - ENHANCED -->
      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 mb-16"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <div
          class="bg-white p-6 rounded-xl shadow-lg text-center transform hover:scale-105 transition-transform duration-300 border-t-4 border-[#cc9933]"
        >
          <div
            class="text-[#cc9933] text-4xl md:text-5xl font-bold mb-2 font-manrope"
          >
            $400M+
          </div>
          <p class="text-sm md:text-base font-manrope font-medium">
            Total Savings Delivered
          </p>
          <p class="text-xs text-[#003087]/60 mt-1">Medical + Indemnity</p>
        </div>
        <div
          class="bg-white p-6 rounded-xl shadow-lg text-center transform hover:scale-105 transition-transform duration-300 border-t-4 border-[#cc9933]"
        >
          <div
            class="text-[#cc9933] text-4xl md:text-5xl font-bold mb-2 font-manrope"
          >
            400K+
          </div>
          <p class="text-sm md:text-base font-manrope font-medium">
            Patients Served
          </p>
          <p class="text-xs text-[#003087]/60 mt-1">AnciCare Legacy</p>
        </div>
        <div
          class="bg-white p-6 rounded-xl shadow-lg text-center transform hover:scale-105 transition-transform duration-300 border-t-4 border-[#cc9933]"
        >
          <div
            class="text-[#cc9933] text-4xl md:text-5xl font-bold mb-2 font-manrope"
          >
            30
          </div>
          <p class="text-sm md:text-base font-manrope font-medium">
            Years Experience
          </p>
          <p class="text-xs text-[#003087]/60 mt-1">Industry Pioneers</p>
        </div>
        <div
          class="bg-white p-6 rounded-xl shadow-lg text-center transform hover:scale-105 transition-transform duration-300 border-t-4 border-[#cc9933]"
        >
          <div
            class="text-[#cc9933] text-4xl md:text-5xl font-bold mb-2 font-manrope"
          >
            ✓
          </div>
          <p class="text-sm md:text-base font-manrope font-medium">
            Public Company
          </p>
          <p class="text-xs text-[#003087]/60 mt-1">Successful Exit</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ANCICARE SUCCESS STORY - DETAILED -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          The AnciCare Innovation Story
        </h2>
        <p
          class="text-lg text-[#003087]/80 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          How we revolutionized medical imaging and created a proven model
          that's now expanding access to 90 million Americans
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
        <!-- LEFT: Success Timeline -->
        <div data-aos="fade-right">
          <div class="space-y-8">
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-12 h-12 flex items-center justify-center font-bold text-xl mr-6 flex-shrink-0"
              >
                1
              </div>
              <div>
                <h3 class="text-xl font-bold text-[#003087] mb-2">
                  Pioneered New Model (1994)
                </h3>
                <p class="text-[#003087]/80">
                  Created the first-ever managed care imaging carve-out when no
                  one else was offering comprehensive imaging networks.
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-12 h-12 flex items-center justify-center font-bold text-xl mr-6 flex-shrink-0"
              >
                2
              </div>
              <div>
                <h3 class="text-xl font-bold text-[#003087] mb-2">
                  Revolutionary Results
                </h3>
                <p class="text-[#003087]/80">
                  Achieved 50%+ cost savings while reducing wait times from
                  10-14 days to 2-3 days—often with next-day appointments.
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-12 h-12 flex items-center justify-center font-bold text-xl mr-6 flex-shrink-0"
              >
                3
              </div>
              <div>
                <h3 class="text-xl font-bold text-[#003087] mb-2">
                  Massive Scale Impact
                </h3>
                <p class="text-[#003087]/80">
                  Delivered $200M+ in direct medical savings and $200M+ in
                  indemnity cost savings through faster return-to-work.
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-12 h-12 flex items-center justify-center font-bold text-xl mr-6 flex-shrink-0"
              >
                4
              </div>
              <div>
                <h3 class="text-xl font-bold text-[#003087] mb-2">
                  Validated Success
                </h3>
                <p class="text-[#003087]/80">
                  Successfully acquired by public company, proving the model
                  works at scale with Fortune 500 companies.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Impact Visualization -->
        <div data-aos="fade-left">
          <div
            class="bg-gradient-to-br from-[#f8f2e1] to-[#fcf9f0] rounded-3xl p-8 shadow-xl"
          >
            <h3 class="text-2xl font-bold text-[#003087] mb-6 text-center">
              Total Impact Delivered
            </h3>

            <!-- Savings Breakdown -->
            <div class="space-y-6">
              <div class="bg-white rounded-xl p-6 shadow-md">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-[#003087] font-medium"
                    >Medical Imaging Savings</span
                  >
                  <span class="text-2xl font-bold text-[#cc9933]">$200M+</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-3">
                  <div class="bg-[#cc9933] h-3 rounded-full" style="width: 50%">
                  </div>
                </div>
              </div>

              <div class="bg-white rounded-xl p-6 shadow-md">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-[#003087] font-medium"
                    >Indemnity Cost Savings</span
                  >
                  <span class="text-2xl font-bold text-[#cc9933]">$200M+</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-3">
                  <div class="bg-[#cc9933] h-3 rounded-full" style="width: 50%">
                  </div>
                </div>
              </div>

              <div
                class="bg-white rounded-xl p-6 shadow-md border-2 border-[#cc9933]"
              >
                <div class="flex justify-between items-center mb-2">
                  <span class="text-[#003087] font-bold"
                    >Total Savings Delivered</span
                  >
                  <span class="text-3xl font-bold text-[#cc9933]">$400M+</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-4">
                  <div
                    class="bg-gradient-to-r from-[#cc9933] to-[#e6c378] h-4 rounded-full"
                    style="width: 100%"
                  >
                  </div>
                </div>
              </div>
            </div>

            <!-- Key Benefits -->
            <div class="mt-8 grid grid-cols-2 gap-4">
              <div class="text-center">
                <div class="text-2xl font-bold text-[#003087]">2-3 Days</div>
                <div class="text-sm text-[#003087]/70">Avg. Wait Time</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-[#003087]">50%+</div>
                <div class="text-sm text-[#003087]/70">Cost Savings</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-[#003087]">100%</div>
                <div class="text-sm text-[#003087]/70">Quality Guarantee</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-[#003087]">1,200+</div>
                <div class="text-sm text-[#003087]/70">Network Centers</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- BUSINESS TRANSFORMATION STORY -->
      <div
        class="bg-[#f0f4f9] rounded-3xl p-8 md:p-12 shadow-xl"
        data-aos="fade-up"
      >
        <h3
          class="text-2xl md:text-3xl font-bold text-[#003087] mb-6 text-center"
        >
          How We Transformed Healthcare Efficiency
        </h3>
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h4 class="text-xl font-bold text-[#003087] mb-4">
              The Problem We Solved
            </h4>
            <div class="space-y-3 text-[#003087]/90">
              <p>
                • <strong>10-14 day wait times</strong> for MRI appointments
              </p>
              <p>
                • <strong>$1,000+ fees</strong> for basic MRIs under workers' comp
              </p>
              <p>
                • <strong>Complex referral processes</strong> creating delays
              </p>
              <p>• <strong>Inconsistent quality</strong> across providers</p>
              <p>• <strong>Hidden costs</strong> and surprise billing</p>
            </div>
          </div>
          <div>
            <h4 class="text-xl font-bold text-[#003087] mb-4">
              Our Proven Solution
            </h4>
            <div class="space-y-3 text-[#003087]/90">
              <p>• <strong>2-3 day appointments</strong> (often next-day)</p>
              <p>
                • <strong>50%+ cost reductions</strong> with transparent pricing
              </p>
              <p>
                • <strong>Complete case management</strong> and coordination
              </p>
              <p>• <strong>Quality guarantee</strong> at top-tier facilities</p>
              <p>• <strong>All-inclusive pricing</strong> with no surprises</p>
            </div>
          </div>
        </div>

        <div class="mt-8 text-center">
          <div
            class="inline-flex items-center gap-2 bg-[#cc9933] text-white px-6 py-3 rounded-full text-sm font-bold"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            RESULT: $400M+ in proven savings across 400,000+ patients
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOUNDERS SECTION - ENHANCED WITH CREDIBILITY -->
  <section class="py-20 px-6 bg-gradient-to-br from-[#f8f2e1] to-[#fcf9f0]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          Meet the Proven Healthcare Innovators
        </h2>
        <p
          class="text-lg text-[#003087]/80 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          The visionary team that built America's first managed care imaging
          network and delivered $400M+ in savings
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-16">
        <!-- Michael's Enhanced Profile -->
        <div
          class="bg-white rounded-3xl p-8 shadow-xl"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div class="text-center mb-6">
            <img
              src="/images/michael.jpg"
              alt="Michael Cabrera, Co-Founder & CEO"
              class="w-48 h-48 object-cover rounded-full mx-auto shadow-xl mb-6"
            />
            <h3 class="text-2xl md:text-3xl font-bold text-[#003087] mb-2">
              Michael Cabrera
            </h3>
            <p class="text-lg text-[#cc9933] font-bold mb-4">
              Co-Founder & CEO
            </p>

            <!-- Credibility Highlights -->
            <div class="grid grid-cols-2 gap-4 mb-6">
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <div class="text-2xl font-bold text-[#cc9933]">1,236%</div>
                <div class="text-sm text-[#003087]">Growth Rate</div>
              </div>
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <div class="text-2xl font-bold text-[#cc9933]">$400M+</div>
                <div class="text-sm text-[#003087]">Savings Led</div>
              </div>
            </div>
          </div>

          <div class="space-y-4 text-[#003087]/90">
            <p>
              <strong>Healthcare Transformation Leader:</strong> Michael didn't just
              build a successful business—he revolutionized an entire industry. Under
              his leadership, AnciCare achieved 1,236% growth, serving 400,000+ patients
              and delivering $400M+ in total savings.
            </p>
            <p>
              <strong>Proven Track Record:</strong> Successfully scaled from startup
              to public company acquisition, proving the managed care imaging model
              works at massive scale with Fortune 500 companies.
            </p>
            <p>
              <strong>Elite Recognition:</strong> Graduate of the prestigious "Birthing
              of Giants" program, co-created by MIT, Inc. Magazine, and Entrepreneurs'
              Organization.
            </p>
          </div>

          <div class="mt-8 text-center">
            <a
              href="/founder"
              class="inline-block px-8 py-4 bg-[#003087] text-white rounded-full font-bold hover:bg-[#002266] transition-colors border-l-4 border-[#cc9933]"
            >
              Read Michael's Full Story →
            </a>
          </div>
        </div>

        <!-- Donna's Enhanced Profile -->
        <div
          class="bg-white rounded-3xl p-8 shadow-xl"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div class="text-center mb-6">
            <img
              src="/images/donna.webp"
              alt="Donna Cabrera, Co-Founder & Patient Advocacy Advisor"
              class="w-48 h-48 object-cover rounded-full mx-auto shadow-xl mb-6"
            />
            <h3 class="text-2xl md:text-3xl font-bold text-[#003087] mb-2">
              Donna Cabrera
            </h3>
            <p class="text-lg text-[#cc9933] font-bold mb-4">
              Co-Founder & Patient Advocacy Advisor
            </p>

            <!-- Credibility Highlights -->
            <div class="grid grid-cols-2 gap-4 mb-6">
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <div class="text-2xl font-bold text-[#cc9933]">400K+</div>
                <div class="text-sm text-[#003087]">Patients Served</div>
              </div>
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <div class="text-2xl font-bold text-[#cc9933]">30+</div>
                <div class="text-sm text-[#003087]">Years Experience</div>
              </div>
            </div>
          </div>

          <div class="space-y-4 text-[#003087]/90">
            <p>
              <strong>Patient Care Pioneer:</strong> Donna was instrumental in creating
              the gold standard for patient care that made AnciCare's success possible.
              Her focus on dignity and care quality became the foundation of our
              service model.
            </p>
            <p>
              <strong>Operations Excellence:</strong> Led compliance and service
              delivery operations that ensured 400,000+ patients received consistent,
              high-quality care across 1,200+ imaging centers.
            </p>
            <p>
              <strong>Patient-First Philosophy:</strong> Developed the patient advocacy
              framework that reduced anxiety, improved outcomes, and created the
              trust that drove our client retention and growth.
            </p>
          </div>

          <div class="mt-8 text-center">
            <a
              href="/co-founder"
              class="inline-block px-8 py-4 bg-[#003087] text-white rounded-full font-bold hover:bg-[#002266] transition-colors border-l-4 border-[#cc9933]"
            >
              Learn About Donna's Role →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VISION & VALUES - ENHANCED WITH CREDIBILITY -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          Our Vision & Values
          <span class="text-lg font-normal text-[#003087]/70 block mt-2">
            Proven by 30 years of healthcare innovation
          </span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-16">
        <!-- Vision Column -->
        <div class="space-y-8" data-aos="fade-right">
          <h3 class="text-2xl md:text-3xl font-bold text-[#003087] mb-6">
            Our Vision Forward
          </h3>

          <div class="bg-[#f0f4f9] rounded-2xl p-6">
            <p class="text-lg leading-relaxed text-[#003087]">
              We're not building a new model—we're <strong
                >expanding a proven one</strong
              >. After successfully demonstrating that managed care imaging
              works at scale, we're now applying the same innovation to serve
              the 90 million uninsured and underinsured Americans who deserve
              access to affordable, high-quality imaging.
            </p>
          </div>

          <div class="space-y-6">
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0 mt-1"
              >
                ✓
              </div>
              <div>
                <h4 class="font-bold text-[#003087] mb-1">Proven Innovation</h4>
                <p class="text-[#003087]/80">
                  We've already revolutionized imaging once—now we're doing it
                  again
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0 mt-1"
              >
                ✓
              </div>
              <div>
                <h4 class="font-bold text-[#003087] mb-1">Massive Scale</h4>
                <p class="text-[#003087]/80">
                  From 400K+ patients to 90M+ Americans who need access
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0 mt-1"
              >
                ✓
              </div>
              <div>
                <h4 class="font-bold text-[#003087] mb-1">Validated Success</h4>
                <p class="text-[#003087]/80">
                  Public company acquisition proves our model works
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Values Column -->
        <div class="space-y-8" data-aos="fade-left">
          <h3 class="text-2xl md:text-3xl font-bold text-[#003087] mb-6">
            Our Proven Values
          </h3>

          <div class="space-y-6">
            <div
              class="bg-white border-2 border-[#e6c378] rounded-xl p-6 hover:shadow-lg transition-shadow"
            >
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center text-white text-xl font-bold mr-4"
                >
                  T
                </div>
                <div>
                  <h4 class="text-xl font-bold text-[#003087]">Transparency</h4>
                  <p class="text-sm text-[#cc9933] font-medium">
                    Proven through 400K+ patient interactions
                  </p>
                </div>
              </div>
              <p class="text-[#003087]/90">
                We pioneered transparent pricing in medical imaging. Our
                all-inclusive model eliminated surprise billing for 400,000+
                patients.
              </p>
            </div>

            <div
              class="bg-white border-2 border-[#e6c378] rounded-xl p-6 hover:shadow-lg transition-shadow"
            >
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center text-white text-xl font-bold mr-4"
                >
                  A
                </div>
                <div>
                  <h4 class="text-xl font-bold text-[#003087]">
                    Accessibility
                  </h4>
                  <p class="text-sm text-[#cc9933] font-medium">
                    Delivered $400M+ in savings
                  </p>
                </div>
              </div>
              <p class="text-[#003087]/90">
                We proved that premium imaging can be affordable. Our managed
                care model delivered 50%+ cost savings while maintaining the
                highest quality standards.
              </p>
            </div>

            <div
              class="bg-white border-2 border-[#e6c378] rounded-xl p-6 hover:shadow-lg transition-shadow"
            >
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center text-white text-xl font-bold mr-4"
                >
                  Q
                </div>
                <div>
                  <h4 class="text-xl font-bold text-[#003087]">Quality</h4>
                  <p class="text-sm text-[#cc9933] font-medium">
                    100% quality guarantee delivered
                  </p>
                </div>
              </div>
              <p class="text-[#003087]/90">
                We were the first to offer a quality guarantee in medical
                imaging. Our network of 1,200+ centers maintained consistent
                excellence that earned Fortune 500 trust.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Vision Quote - Enhanced -->
      <div class="mt-16 text-center" data-aos="fade-up">
        <div
