---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import FadeIn from "../components/FadeIn.astro";
import AOSInit from "../components/AOSInit.astro";
import ProviderSearchSection from "../components/ProviderSearchSection.jsx";
import TrustBadgesBar from "../components/TrustBadgesBar.astro";

const pageTitle =
  "Proven Savings: $400M+ Delivered - Medical Imaging 30-70% Below Hospital Rates | USRad";
const pageDescription =
  "The same pricing model that delivered $400M+ in savings to 400,000+ patients. Get high-quality MRI, CT, and ultrasound scans at transparent prices 30-70% below hospital rates.";
const canonicalURL = Astro.site
  ? new URL("/pricing", Astro.site).toString()
  : "/pricing";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: "USRad",
  description: pageDescription,
  url:
    typeof canonicalURL === "string" ? canonicalURL : canonicalURL.toString(),
  logo: "/images/usrad-logo.png",
  priceRange: "$85-$325",
  medicalSpecialty: "Diagnostic Radiology",
};
---

<MainPatientLayout
  showPatientHeader={true}
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  structuredData={structuredData}
>
  <AOSInit />

  <!-- CREDIBILITY BANNER - ENHANCED -->
  <section
    class="bg-gradient-to-r from-[#003087] to-blue-700 text-white py-4 px-6"
  >
    <div class="max-w-7xl mx-auto">
      <div
        class="flex flex-col md:flex-row items-center justify-center gap-4 text-center md:text-left"
      >
        <div class="flex items-center gap-2">
          <svg
            class="w-5 h-5 text-[#cc9933]"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="font-bold">PROVEN SAVINGS MODEL:</span>
        </div>
        <span class="text-sm font-medium">
          $400M+ delivered to 400,000+ patients • Same proven pricing system as
          AnciCare
        </span>
      </div>
    </div>
  </section>

  <!-- HERO SECTION - CREDIBILITY FIRST -->
  <FadeIn effect="fade" delay={0}>
    <section
      class="relative bg-gradient-to-br from-[#fefbf5] to-[#f8f5e8] py-24 px-6"
    >
      <div class="max-w-7xl mx-auto">
        <!-- Credibility Header -->
        <div class="text-center mb-12" data-aos="fade-up">
          <div
            class="inline-flex items-center gap-2 bg-[#cc9933] text-white px-6 py-3 rounded-full text-sm font-bold mb-6"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            PROVEN PRICING MODEL • ACQUIRED BY CORVEL (NYSE: CVL)
          </div>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6 text-[#003087]"
          >
            $400M+ in Proven Savings
            <span class="text-[#cc9933] block mt-2"
              >Now Available to Everyone</span
            >
          </h1>

          <p
            class="text-lg sm:text-xl text-[#003087]/80 max-w-4xl mx-auto leading-relaxed mb-8"
          >
            This isn't experimental pricing—it's the same <strong
              >proven model</strong
            > that delivered
            <strong class="text-[#cc9933]">$400M+ in total savings</strong> to 400,000+
            patients through our AnciCare network (1994-2002). So successful that
            <strong class="text-[#cc9933]"
              >CorVel Corporation (NYSE: CVL) acquired us</strong
            > and continues operating our model 20+ years later. Now we're expanding
            access to the 90 million Americans who need affordable, high-quality
            imaging.
          </p>
        </div>

        <!-- Success Metrics Grid -->
        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 mb-16"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div
            class="bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 border-[#cc9933] hover:shadow-xl transition-shadow"
          >
            <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
              $400M+
            </div>
            <div class="text-sm md:text-base text-[#003087] font-medium">
              Total Proven Savings
            </div>
            <div class="text-xs text-[#003087]/60 mt-1">
              Medical + Indemnity
            </div>
          </div>
          <div
            class="bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 border-[#cc9933] hover:shadow-xl transition-shadow"
          >
            <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
              400K+
            </div>
            <div class="text-sm md:text-base text-[#003087] font-medium">
              Patients Successfully Served
            </div>
            <div class="text-xs text-[#003087]/60 mt-1">AnciCare Legacy</div>
          </div>
          <div
            class="bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 border-[#cc9933] hover:shadow-xl transition-shadow"
          >
            <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
              50%+
            </div>
            <div class="text-sm md:text-base text-[#003087] font-medium">
              Average Cost Reduction
            </div>
            <div class="text-xs text-[#003087]/60 mt-1">
              Proven Track Record
            </div>
          </div>
          <div
            class="bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 border-[#cc9933] hover:shadow-xl transition-shadow"
          >
            <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
              8
            </div>
            <div class="text-sm md:text-base text-[#003087] font-medium">
              Years Building AnciCare
            </div>
            <div class="text-xs text-[#003087]/60 mt-1">
              1994-2002 Innovation
            </div>
          </div>
        </div>

        <!-- Hero Grid -->
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Text Content -->
          <div data-aos="fade-right">
            <h2 class="text-3xl md:text-4xl font-bold text-[#003087] mb-6">
              The Same Proven Model,
              <span class="text-[#cc9933]">Expanded Access</span>
            </h2>
            <p class="text-lg text-[#003087]/80 mb-8">
              We didn't just create transparent pricing overnight. This model is
              the result of 8 years building the AnciCare managed care imaging
              approach (1994-2002)—<strong
                >so successful that CorVel Corporation (NYSE: CVL) acquired us</strong
              > and continues operating our model 20+ years later. <strong
                >That's the ultimate validation.</strong
              >
            </p>

            <!-- Key Benefits -->
            <div class="space-y-4 mb-8">
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 bg-[#cc9933] rounded-full flex items-center justify-center"
                >
                  <svg
                    class="w-4 h-4 text-white"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
                <span class="text-[#003087] font-medium"
                  >100% transparent pricing - no hidden fees, ever</span
                >
              </div>
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 bg-[#cc9933] rounded-full flex items-center justify-center"
                >
                  <svg
                    class="w-4 h-4 text-white"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
                <span class="text-[#003087] font-medium"
                  >Same quality as hospitals, 30-70% less cost</span
                >
              </div>
              <div class="flex items-center gap-3">
                <div
                  class="w-8 h-8 bg-[#cc9933] rounded-full flex items-center justify-center"
                >
                  <svg
                    class="w-4 h-4 text-white"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
                <span class="text-[#003087] font-medium"
                  >Validated by CorVel (NYSE: CVL) acquisition</span
                >
              </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href="#pricing-calculator"
                class="group bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-bold px-8 py-4 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center justify-center gap-2"
              >
                See Proven Savings
                <svg
                  class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </a>
              <a
                href="/about"
                class="group border-2 border-[#cc9933] text-[#003087] font-semibold px-8 py-4 rounded-xl hover:bg-[#cc9933]/10 transition-all duration-300 inline-flex items-center justify-center gap-2"
              >
                Our Proven Track Record
              </a>
            </div>
          </div>

          <!-- Visual Content -->
          <div data-aos="fade-left">
            <div
              class="bg-white rounded-3xl p-8 shadow-xl border border-[#e6c378]/30"
            >
              <h3 class="text-2xl font-bold text-[#003087] mb-6 text-center">
                AnciCare → USRad Evolution
              </h3>

              <!-- Timeline -->
              <div class="space-y-6">
                <div class="flex items-center">
                  <div
                    class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center text-white font-bold mr-4"
                  >
                    1
                  </div>
                  <div>
                    <div class="font-bold text-[#003087]">
                      Pioneered Model (1994-2002)
                    </div>
                    <div class="text-sm text-[#003087]/70">
                      Built first managed care imaging network
                    </div>
                  </div>
                </div>
                <div class="flex items-center">
                  <div
                    class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center text-white font-bold mr-4"
                  >
                    2
                  </div>
                  <div>
                    <div class="font-bold text-[#003087]">Proven Results</div>
                    <div class="text-sm text-[#003087]/70">
                      $400M+ savings, 400K+ patients served
                    </div>
                  </div>
                </div>
                <div class="flex items-center">
                  <div
                    class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center text-white font-bold mr-4"
                  >
                    3
                  </div>
                  <div>
                    <div class="font-bold text-[#003087]">
                      CorVel Acquisition (2002)
                    </div>
                    <div class="text-sm text-[#003087]/70">
                      Acquired by NYSE-listed corporation
                    </div>
                  </div>
                </div>
                <div class="flex items-center">
                  <div
                    class="w-12 h-12 bg-gradient-to-r from-[#cc9933] to-yellow-400 rounded-full flex items-center justify-center text-white font-bold mr-4"
                  >
                    4
                  </div>
                  <div>
                    <div class="font-bold text-[#003087]">
                      Continued Success
                    </div>
                    <div class="text-sm text-[#003087]/70">
                      CorVel still operates our model today
                    </div>
                  </div>
                </div>
                <div class="flex items-center">
                  <div
                    class="w-12 h-12 bg-gradient-to-r from-[#cc9933] to-yellow-400 rounded-full flex items-center justify-center text-white font-bold mr-4"
                  >
                    5
                  </div>
                  <div>
                    <div class="font-bold text-[#003087]">
                      USRad Launch (2025)
                    </div>
                    <div class="text-sm text-[#003087]/70">
                      Same proven model, expanded access
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </FadeIn>

  <!-- PRICING COMPARISON - ENHANCED WITH CREDIBILITY -->
  <section id="pricing-calculator" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-4xl md:text-5xl font-bold text-[#003087] mb-6">
          Proven Savings, Guaranteed Results
        </h2>
        <p class="text-xl text-[#003087]/80 max-w-3xl mx-auto mb-4">
          The same transparent pricing that delivered $400M+ in savings and
          earned CorVel Corporation (NYSE: CVL) acquisition
        </p>
        <div
          class="inline-flex items-center gap-2 bg-[#f0f4f9] rounded-full px-6 py-2"
        >
          <svg
            class="w-4 h-4 text-[#cc9933]"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-sm font-medium text-[#003087]"
            >Model acquired by NYSE-listed CorVel, still operating 20+ years
            later</span
          >
        </div>
      </div>

      <!-- Enhanced Pricing Cards -->
      <div class="grid lg:grid-cols-3 gap-8 mb-16">
        <!-- MRI Card -->
        <div
          class="group bg-white rounded-3xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 border-2 border-transparent hover:border-[#cc9933]/30 hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <!-- Credibility Badge -->
          <div
            class="bg-[#cc9933]/10 text-[#cc9933] px-3 py-1 rounded-full text-xs font-bold mb-4 inline-block"
          >
            ✓ PROVEN BY 400K+ PATIENTS
          </div>

          <div class="text-center mb-8">
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#003087] to-[#1a4fa0] rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M9 12a1 1 0 01-.117-1.993L9 10h2a3 3 0 10-3-3 1 1 0 012 0A1 1 0 1112 7a1 1 0 11-1 1H9a1 1 0 010 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-2">MRI Scan</h3>
            <p class="text-gray-600">Brain, Spine, Joints & More</p>
          </div>

          <div class="text-center mb-8">
            <div class="text-red-500 line-through text-xl mb-2 opacity-75">
              Hospital: $1,200-$8,000
            </div>
            <div class="text-5xl font-black text-[#003087] mb-3">
              $260<span class="text-2xl">-</span>$325
            </div>
            <div
              class="inline-flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-4 py-2 rounded-full text-sm font-bold animate-pulse"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z"
                  clip-rule="evenodd"></path>
              </svg>
              Save up to 96%
            </div>
          </div>

          <!-- Enhanced Benefits -->
          <div class="space-y-4 mb-8">
            <div class="bg-[#f0f4f9] rounded-xl p-4">
              <h4 class="font-bold text-[#003087] mb-2">
                Proven Quality Guarantee:
              </h4>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <svg
                    class="w-4 h-4 text-green-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span>Same equipment as hospitals</span>
                </li>
                <li class="flex items-center gap-2">
                  <svg
                    class="w-4 h-4 text-green-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span>Board-certified radiologists</span>
                </li>
                <li class="flex items-center gap-2">
                  <svg
                    class="w-4 h-4 text-green-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span>Results in 24-48 hours</span>
                </li>
                <li class="flex items-center gap-2">
                  <svg
                    class="w-4 h-4 text-green-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span>30+ years proven experience</span>
                </li>
              </ul>
            </div>
          </div>

          <a
            href="/search-test?type=mri"
            class="w-full bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-bold py-4 px-6 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            Find MRI Centers
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>

        <!-- CT Card -->
        <div
          class="group bg-white rounded-3xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 border-2 border-transparent hover:border-[#cc9933]/30 hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <!-- Credibility Badge -->
          <div
            class="bg-[#cc9933]/10 text-[#cc9933] px-3 py-1 rounded-full text-xs font-bold mb-4 inline-block"
          >
            ✓ PROVEN BY 400K+ PATIENTS
          </div>

          <div class="text-center mb-8">
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#003087] to-[#1a4fa0] rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M4 3a2 2 0 100 4h12a2 2 0 100-4H4zM4 9a2 2 0 100 4h12a2 2 0 100-4H4zM4 15a2 2 0 100 4h12a2 2 0 100-4H4z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-2">CT Scan</h3>
            <p class="text-gray-600">Chest, Abdomen, Head</p>
          </div>

          <div class="text-center mb-8">
            <div class="text-red-500 line-through text-xl mb-2 opacity-75">
              Hospital: $800-$4,000
            </div>
            <div class="text-5xl font-black text-[#003087] mb-3">
              $150<span class="text-2xl">-</span>$225
            </div>
            <div
              class="inline-flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-4 py-2 rounded-full text-sm font-bold animate-pulse"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z"
                  clip-rule="evenodd"></path>
              </svg>
              Save up to 94%
            </div>
          </div>

          <!-- Enhanced Benefits -->
          <div class="space-y-4 mb-8">
            <div class="bg-[#f0f4f9] rounded-xl p-4">
              <h4 class="font-bold text-[#003087] mb-2">
                Proven Quality Guarantee:
              </h4>
              <ul class="space-y-2 text-sm">
                <li class="flex items-center gap-2">
                  <svg
                    class="w-4 h-4 text-green-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span>Latest CT technology</span>
                </li>
                <li class="flex items-center gap-2">
                  <svg
                    class="w-4 h-4 text-green-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
