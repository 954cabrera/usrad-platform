  <style>
    /* Story Arc Indicator Styles */
    .story-arc {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 6px 16px;
      background: rgba(204, 153, 51, 0.1);
      border-radius: 20px;
      font-size: 13px;
      font-weight: 500;
      color: #cc9933;
      margin-bottom: 16px;
    }

    .story-arc svg {
      width: 16px;
      height: 16px;
    }

    /* USRad era story arc */
    .story-arc.usrad-era {
      background: rgba(0, 48, 135, 0.1);
      color: #003087;
    }

    /* Timeline Container */
    .timeline-wrapper {
      position: relative;
      padding: 0 20px;
    }

    /* Vertical Timeline Line */
    .timeline-line {
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 3px;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        #e5e5e5 10%,
        #e5e5e5 90%,
        transparent 100%
      );
      transform: translateX(-50%);
      z-index: 1;
    }

    /* Animated Progress Line */
    .timeline-progress {
      position: absolute;
      left: 50%;
      top: 0;
      width: 3px;
      background: linear-gradient(
        180deg,
        #cc9933 0%,
        #cc9933 40%,
        #003087 60%,
        #003087 100%
      );
      transform: translateX(-50%);
      height: 0%;
      z-index: 2;
      transition: height 2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Timeline Nodes */
    .timeline-node {
      position: relative;
      margin: 80px 0;
      display: flex;
      align-items: center;
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.6s ease-out;
    }

    .timeline-node.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Alternating Layout */
    .timeline-node:nth-child(even) {
      flex-direction: row-reverse;
    }

    .timeline-node:nth-child(odd) .timeline-content {
      margin-right: 60px;
      text-align: right;
    }

    .timeline-node:nth-child(even) .timeline-content {
      margin-left: 60px;
      text-align: left;
    }

    /* Timeline Dots */
    .timeline-dot {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 24px;
      height: 24px;
      background: white;
      border: 4px solid #e5e5e5;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      z-index: 3;
      transition: all 0.3s ease;
    }

    .timeline-node.visible .timeline-dot {
      border-color: #cc9933;
    }

    .timeline-node.usrad-era.visible .timeline-dot {
      border-color: #003087;
      width: 28px;
      height: 28px;
    }

    /* Pulse Effect for Current Node */
    .timeline-dot.pulse::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 2px solid #003087;
      transform: translate(-50%, -50%);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
      }
      100% {
        transform: translate(-50%, -50%) scale(2);
        opacity: 0;
      }
    }

    /* Content Styling */
    .timeline-content {
      flex: 1;
      padding: 30px;
      background: #f8f9fa;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      position: relative;
      transition: all 0.3s ease;
    }

    .timeline-node:nth-child(odd) .timeline-content {
      background: linear-gradient(135deg, #fefbf5 0%, #fff 100%);
    }

    .timeline-node.usrad-era .timeline-content {
      background: linear-gradient(135deg, #f0f4f8 0%, #fff 100%);
      border: 2px solid #e1e8f0;
    }

    .timeline-content:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }

    /* Year Badge */
    .timeline-year {
      display: inline-block;
      padding: 6px 16px;
      background: #cc9933;
      color: white;
      border-radius: 20px;
      font-weight: 600;
      font-size: 14px;
      margin-bottom: 12px;
    }

    .timeline-node.usrad-era .timeline-year {
      background: #003087;
    }

    /* Content Typography */
    .timeline-title {
      font-size: 28px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 12px;
    }

    .timeline-description {
      font-size: 18px;
      color: #666;
      line-height: 1.6;
    }

    /* Impact Numbers */
    .timeline-impact {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    .impact-number {
      font-size: 36px;
      font-weight: 800;
      color: #cc9933;
      display: block;
    }

    .timeline-node.usrad-era .impact-number {
      color: #003087;
    }

    /* Mobile Responsive */
    @media (max-width: 768px) {
      .timeline-line,
      .timeline-progress {
        left: 30px;
      }

      .timeline-node {
        flex-direction: column !important;
        margin: 60px 0;
      }

      .timeline-node:nth-child(odd) .timeline-content,
      .timeline-node:nth-child(even) .timeline-content {
        margin: 0 0 0 60px;
        text-align: left;
      }

      .timeline-dot {
        left: 30px;
      }
    }

    /* Floating Year Indicator */
    .floating-year {
      position: fixed;
      right: 40px;
      top: 50%;
      transform: translateY(-50%);
      padding: 12px 24px;
      background: rgba(0, 48, 135, 0.9);
      color: white;
      border-radius: 30px;
      font-weight: 600;
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 100;
    }

    .floating-year.visible {
      opacity: 1;
    }

    /* Section Transition Marker */
    .era-transition {
      position: relative;
      text-align: center;
      margin: 100px 0;
      opacity: 0;
      transform: scale(0.9);
      transition: all 0.6s ease;
    }

    .era-transition.visible {
      opacity: 1;
      transform: scale(1);
    }

    .era-line {
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        #ccc 50%,
        transparent 100%
      );
      margin: 40px 0;
    }

    .era-badge {
      display: inline-block;
      padding: 12px 32px;
      background: white;
      border: 2px solid #003087;
      border-radius: 30px;
      font-weight: 600;
      color: #003087;
      font-size: 18px;
    }
  </style>

  <!-- Timeline JavaScript -->
  <script>
    // Timeline Animation Script
    document.addEventListener("DOMContentLoaded", function () {
      const timelineProgress = document.getElementById("timelineProgress");
      const floatingYear = document.getElementById("floatingYear");
      const timelineNodes = document.querySelectorAll(".timeline-node");
      const eraTransition = document.querySelector(".era-transition");

      // Calculate timeline progress based on scroll
      function updateTimeline() {
        const windowHeight = window.innerHeight;
        const scrolled = window.scrollY;

        // Update progress line
        const timelineSection = document.querySelector(".timeline-wrapper");
        if (timelineSection) {
          const sectionTop = timelineSection.offsetTop;
          const sectionHeight = timelineSection.offsetHeight;
          const sectionScrolled = scrolled - sectionTop + windowHeight * 0.5;
          const progress = Math.min(
            Math.max((sectionScrolled / sectionHeight) * 100, 0),
            100
          );

          timelineProgress.style.height = progress + "%";
        }

        // Animate nodes as they come into view
        timelineNodes.forEach((node, index) => {
          const rect = node.getBoundingClientRect();
          if (rect.top < windowHeight * 0.75) {
            setTimeout(() => {
              node.classList.add("visible");
            }, index * 100);

            // Update floating year
            if (
              rect.top < windowHeight * 0.5 &&
              rect.bottom > windowHeight * 0.5
            ) {
              floatingYear.textContent = node.dataset.year;
              floatingYear.classList.add("visible");
            }
          }
        });

        // Show era transition
        if (eraTransition) {
          const transitionRect = eraTransition.getBoundingClientRect();
          if (transitionRect.top < windowHeight * 0.75) {
            eraTransition.classList.add("visible");
          }
        }
      }

      // Throttle scroll events
      let ticking = false;
      function requestTick() {
        if (!ticking) {
          window.requestAnimationFrame(updateTimeline);
          ticking = true;
          setTimeout(() => {
            ticking = false;
          }, 100);
        }
      }

      window.addEventListener("scroll", requestTick);
      updateTimeline(); // Initial call
    });
  </script>
