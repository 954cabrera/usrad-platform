---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout title="About USRad - The Full Story">
  <AOSInit />

  <!-- Hero Section with Background Image -->
  <section
    class="relative pt-32 pb-20 px-4 sm:px-6 min-h-[600px] flex items-center"
  >
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/about-hero-f.webp"
        alt="Worker with family"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-black/40">
      </div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="max-w-5xl">
        <h1
          class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold mb-8 text-white leading-tight"
          data-aos="fade-up"
        >
          The Full Story Behind<br />
          <span class="text-[#cc9933]">The Revolution</span>
        </h1>
        <p
          class="text-xl md:text-2xl text-gray-100 leading-relaxed"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          How a Workers' Compensation crisis in 1994 led to a healthcare model
          that saved $585 million and is now evolving to serve 90 million
          Americans.
        </p>
      </div>
    </div>
  </section>

  <!-- The Origin Story -->
  <section class="py-20 px-4 sm:px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2
        class="text-4xl md:text-5xl font-bold text-gray-900 mb-12 text-center"
        data-aos="fade-up"
      >
        How We Made Medical Imaging Affordable and Accessible
      </h2>

      <div
        class="space-y-8 text-xl text-gray-600 leading-relaxed"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <p>
          In 1994, managing Workers' Compensation claims revealed an
          opportunity: While injured workers waited 14 days for imaging, quality
          outpatient centers had immediate availability.
        </p>

        <p>
          <span class="font-semibold text-gray-900">The breakthrough?</span> Workers'
          Comp laws allowed employers and insurers to direct care.
        </p>

        <p>
          We built AnciCare—America's first imaging network that guaranteed
          volume to providers in exchange for dramatic cost reductions. Centers
          lowered prices beyond the $1,000 fee schedule. Employers saved
          millions. Workers got immediate care.
        </p>

        <div
          class="bg-[#fefbf5] rounded-2xl p-8 my-12 border-l-4 border-[#cc9933]"
        >
          <p class="text-2xl font-semibold text-gray-900 mb-2">The Result:</p>
          <p class="text-xl text-gray-700">
            50%+ savings. Next-day imaging. Everyone wins.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ANIMATED TIMELINE SECTION -->
  <section class="py-20 bg-gradient-to-b from-white to-gray-50 overflow-hidden">
    <div class="max-w-6xl mx-auto timeline-wrapper relative px-4 sm:px-6">
      <!-- Timeline Header -->
      <div class="text-center mb-20" data-aos="fade-up">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          Our Journey Through Time
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          From a simple discovery to a healthcare revolution, follow our path to
          transforming medical imaging in America.
        </p>
      </div>

      <!-- Background Timeline Line -->
      <div class="timeline-line"></div>
      <!-- Animated Progress Line -->
      <div class="timeline-progress" id="timelineProgress"></div>

      <!-- Floating Year Indicator -->
      <div class="floating-year" id="floatingYear">1994</div>

      <!-- 1994: The Discovery -->
      <div class="timeline-node" data-year="1993">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <span class="timeline-year">1993</span>
          <h3 class="timeline-title">The Discovery</h3>
          <p class="timeline-description">
            Managing Workers' Comp claims revealed the opportunity: 14-day waits
            while quality centers sat empty.
          </p>
          <div class="timeline-impact">
            <span class="impact-number">14 days</span>
            <span class="text-sm text-gray-600">Average wait time</span>
          </div>
        </div>
      </div>

      <!-- 1996: AnciCare Launch -->
      <div class="timeline-node" data-year="1994">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <span class="timeline-year">1994</span>
          <h3 class="timeline-title">AnciCare Launches</h3>
          <p class="timeline-description">
            America's first imaging network goes live. Direct contracts with
            providers, guaranteed volume for lower prices.
          </p>
          <div class="timeline-impact">
            <span class="impact-number">50%+</span>
            <span class="text-sm text-gray-600"
              >Savings below fee schedules</span
            >
          </div>
        </div>
      </div>

      <!-- 1999: Rapid Growth -->
      <div class="timeline-node" data-year="1999">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <span class="timeline-year">1999</span>
          <h3 class="timeline-title">Explosive Growth</h3>
          <p class="timeline-description">
            Network expands nationwide. Major employers adopt the model. Lives
            change daily.
          </p>
          <div class="timeline-impact">
            <span class="impact-number">400,000</span>
            <span class="text-sm text-gray-600">Workers served</span>
          </div>
        </div>
      </div>

      <!-- 2002: The Exit -->
      <div class="timeline-node" data-year="2002">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <span class="timeline-year">2002</span>
          <h3 class="timeline-title">Mission Accomplished?</h3>
          <p class="timeline-description">
            AnciCare sold. $585 million saved. We thought we were done.
          </p>
          <div class="timeline-impact">
            <span class="impact-number">$585M</span>
            <span class="text-sm text-gray-600">Total employer savings</span>
          </div>
        </div>
      </div>

      <!-- Era Transition -->
      <div class="era-transition">
        <div class="era-line"></div>
        <span class="era-badge">But healthcare got worse, not better...</span>
        <div class="era-line"></div>
      </div>

      <!-- 2024: The Return -->
      <div class="timeline-node usrad-era" data-year="2024">
        <div class="timeline-dot pulse"></div>
        <div class="timeline-content">
          <span class="timeline-year">2024</span>
          <h3 class="timeline-title">USRad is Born</h3>
          <p class="timeline-description">
            MRIs from $260. Less than your deductible. No insurance needed. The same
            quality imaging, 85% less cost.
          </p>
          <div class="timeline-impact">
            <span class="impact-number">90M</span>
            <span class="text-sm text-gray-600">Americans to serve</span>
          </div>
        </div>
      </div>

      <!-- 2025: USRad Revolution -->
      <div class="timeline-node usrad-era" data-year="2025">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <span class="timeline-year">2025</span>
          <h3 class="timeline-title">The Revolution Begins</h3>
          <p class="timeline-description">
            Same proven model. Modern technology. Transparent pricing. Book in
            60 seconds.
          </p>
          <div class="timeline-impact">
            <span class="impact-number">One Goal</span>
            <span class="text-sm text-gray-600">Affordable access</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NEW PREMIUM SAVINGS SECTION -->
  <section
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-white to-gray-50 overflow-hidden"
  >
    <div class="max-w-6xl mx-auto">
      <!-- Premium Header -->
      <div class="text-center mb-20" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 px-4 py-2 rounded-full text-sm font-medium mb-6"
        >
          <span class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></span>
          Our Proven Track Record
        </div>
        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 text-gray-900 leading-tight"
        >
          How We Saved<br />
          <span
            class="text-6xl md:text-7xl lg:text-8xl bg-gradient-to-r from-[#FFD700] via-[#FFA500] to-[#FF8C00] bg-clip-text text-transparent"
            >$585 Million</span
          >
        </h1>
        <p
          class="text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto leading-relaxed"
        >
          20 years ago, we revolutionized healthcare for 400,000 American
          workers. Here's exactly how we did it.
        </p>
      </div>

      <!-- Photo Grid Introduction -->
      <div class="grid md:grid-cols-3 gap-8 mb-24">
        <div
          class="relative rounded-2xl overflow-hidden shadow-2xl group"
          data-aos="fade-up"
        >
          <img
            src="/images/website/about_worker.webp"
            alt="Construction worker"
            class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
          >
            <div class="text-white">
              <h3 class="text-2xl font-bold mb-2">The Workers</h3>
              <p class="text-sm opacity-90">
                400,000 injured Americans waiting for care
              </p>
            </div>
          </div>
        </div>

        <div
          class="relative rounded-2xl overflow-hidden shadow-2xl group"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <img
            src="/images/website/about_solution.webp"
            alt="MRI machine"
            class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
          >
            <div class="text-white">
              <h3 class="text-2xl font-bold mb-2">The Solution</h3>
              <p class="text-sm opacity-90">
                Direct access to quality imaging centers
              </p>
            </div>
          </div>
        </div>

        <div
          class="relative rounded-2xl overflow-hidden shadow-2xl group"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <img
            src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=800&q=90"
            alt="Happy professional"
            class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
          >
            <div class="text-white">
              <h3 class="text-2xl font-bold mb-2">The Impact</h3>
              <p class="text-sm opacity-90">Lives changed, families saved</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Timeline with Photos -->
      <div class="space-y-32">
        <!-- The Problem -->
        <div class="grid md:grid-cols-2 gap-12 items-center" data-aos="fade-up">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl">
            <img
              src="/images/website/about_waiting.webp"
              alt="Modern MRI facility"
              class="w-full h-96 object-cover"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
            >
            </div>
          </div>
          <div>
            <div
              class="inline-block bg-red-100 text-red-700 px-4 py-2 rounded-full text-sm font-medium mb-4"
            >
              The Old Way
            </div>
            <h2 class="text-4xl font-bold text-gray-900 mb-6">
              14 Days of Waiting
            </h2>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <span class="text-2xl">😰</span>
                </div>
                <div>
                  <p class="font-semibold text-lg text-gray-900">
                    Pain without answers
                  </p>
                  <p class="text-gray-600">
                    Workers suffered while insurance processed paperwork
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <span class="text-2xl">💸</span>
                </div>
                <div>
                  <p class="font-semibold text-lg text-gray-900">
                    $3,000 for a plain MRI
                  </p>
                  <p class="text-gray-600">
                    Hospital monopolies drove prices sky-high
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Our Solution -->
        <div class="grid md:grid-cols-2 gap-12 items-center" data-aos="fade-up">
          <div class="order-2 md:order-1">
            <div
              class="inline-block bg-green-100 text-green-700 px-4 py-2 rounded-full text-sm font-medium mb-4"
            >
              Our Revolution
            </div>
            <h2 class="text-4xl font-bold text-gray-900 mb-6">
              2 Days to Answers
            </h2>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <span class="text-2xl">⚡</span>
                </div>
                <div>
                  <p class="font-semibold text-lg text-gray-900">
                    Same-week imaging
                  </p>
                  <p class="text-gray-600">
                    Direct contracts cut through red tape
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <span class="text-2xl">✨</span>
                </div>
                <div>
                  <p class="font-semibold text-lg text-gray-900">
                    $475 transparent pricing
                  </p>
                  <p class="text-gray-600">No surprises, no hidden fees</p>
                </div>
              </div>
            </div>
          </div>
          <div
            class="order-1 md:order-2 relative rounded-3xl overflow-hidden shadow-2xl"
          >
            <img
              src="/images/website/imaging-center-hero-fallback.webp"
              alt="Modern MRI facility"
              class="w-full h-96 object-cover"
            />
          </div>
        </div>

        <!-- The Impact -->
        <div class="relative">
          <div
            class="relative rounded-3xl overflow-hidden shadow-2xl mb-12"
            data-aos="fade-up"
          >
            <img
              src="https://images.unsplash.com/photo-1609220136736-443140cffec6?w=1600&q=90"
              alt="Happy family"
              class="w-full h-96 object-cover"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex items-end"
            >
              <div class="p-12 text-white">
                <h2 class="text-5xl font-bold mb-4">
                  400,000 Faster Recoveries
                </h2>
                <p class="text-2xl opacity-90">
                  $585 Million in healthcare costs eliminated
                </p>
              </div>
            </div>
          </div>

          <!-- Impact Stats -->
          <div class="grid md:grid-cols-3 gap-8">
            <div
              class="bg-white rounded-2xl p-8 shadow-lg text-center hover:-translate-y-2 transition-transform"
              data-aos="zoom-in"
            >
              <div
                class="w-20 h-20 mx-auto mb-4 bg-blue-100 rounded-2xl flex items-center justify-center p-3"
              >
                <img
                  src="/images/icons/savings.png"
                  alt="Medical savings"
                  class="w-full h-full object-contain"
                />
              </div>
              <div class="text-4xl font-bold text-blue-600 mb-2">$226M</div>
              <p class="text-gray-600">Medical savings</p>
              <p class="text-sm text-gray-500 mt-2">52% cost reduction</p>
            </div>

            <div
              class="bg-white rounded-2xl p-8 shadow-lg text-center hover:-translate-y-2 transition-transform"
              data-aos="zoom-in"
              data-aos-delay="200"
            >
              <div
                class="w-20 h-20 mx-auto mb-4 bg-orange-100 rounded-2xl flex items-center justify-center p-3"
              >
                <img
                  src="/images/icons/productivity.png"
                  alt="Productivity saved"
                  class="w-full h-full object-contain"
                />
              </div>
              <div class="text-4xl font-bold text-orange-600 mb-2">$359M</div>
              <p class="text-gray-600">Productivity saved</p>
              <p class="text-sm text-gray-500 mt-2">3.2M work days</p>
            </div>

            <div
              class="bg-white rounded-2xl p-8 shadow-lg text-center hover:-translate-y-2 transition-transform"
              data-aos="zoom-in"
              data-aos-delay="400"
            >
              <div
                class="w-20 h-20 mx-auto mb-4 bg-green-100 rounded-2xl flex items-center justify-center p-3"
              >
                <img
                  src="/images/icons/save-the-world.png"
                  alt="Total impact"
                  class="w-full h-full object-contain"
                />
              </div>
              <div class="text-4xl font-bold text-green-600 mb-2">$585M</div>
              <p class="text-gray-600">Total impact</p>
              <p class="text-sm text-gray-500 mt-2">Employer savings</p>
            </div>
          </div>

          <!-- Emotional Close of Savings Section -->
          <div
            class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#003087] to-[#002266] p-12 md:p-16 text-white text-center mt-20"
            data-aos="fade-up"
          >
            <div class="relative z-10">
              <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
                Behind Every Dollar Was a Life Changed
              </h2>
              <div class="max-w-3xl mx-auto space-y-4 text-lg md:text-xl mb-8">
                <p class="opacity-90">400,000 families who kept their homes</p>
                <p class="opacity-90">
                  3.2 million days parents didn't miss with their kids
                </p>
                <p class="opacity-90">
                  Countless lives that didn't spiral into medical debt
                </p>
              </div>
              <div class="pt-8 border-t border-white/20">
                <p class="text-2xl md:text-3xl font-semibold">
                  We did it once. But we weren't done.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- OPTION 4: The Mission Statement (My Favorite) -->
      <div class="relative overflow-hidden">
        <div class="max-w-4xl mx-auto py-20 px-6">
          <div class="text-center mb-12">
            <div class="story-arc usrad-era inline-flex mb-8">
              <span>A New Chapter Begins</span>
            </div>
            <h2 class="text-5xl font-bold text-gray-900 mb-6">
              This Time, It's Different
            </h2>
          </div>

          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-[#cc9933] bg-opacity-20 rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <span class="text-xl font-bold text-[#cc9933]">1</span>
                </div>
                <div>
                  <h4 class="font-semibold text-lg text-gray-900">
                    We're Not Starting from Scratch
                  </h4>
                  <p class="text-gray-600">
                    20 years of proven success. Every mistake already made and
                    learned from.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-[#003087] bg-opacity-20 rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <span class="text-xl font-bold text-[#003087]">2</span>
                </div>
                <div>
                  <h4 class="font-semibold text-lg text-gray-900">
                    We're Not Serving Employers
                  </h4>
                  <p class="text-gray-600">
                    Direct to consumer. Your health, your choice, your savings.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-green-600 bg-opacity-20 rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <span class="text-xl font-bold text-green-600">3</span>
                </div>
                <div>
                  <h4 class="font-semibold text-lg text-gray-900">
                    We're Not Asking Permission
                  </h4>
                  <p class="text-gray-600">
                    No insurance approvals. No networks. No gatekeepers.
                  </p>
                </div>
              </div>
            </div>

            <div
              class="bg-gradient-to-br from-[#003087] to-[#002266] rounded-3xl p-8 text-white"
            >
              <h3 class="text-2xl font-bold mb-4">My Promise to You</h3>
              <p class="text-lg opacity-90 leading-relaxed">
                "We built AnciCare to save employers money. We built USRad to
                save lives. Same proven model, bigger mission, personal
                commitment."
              </p>
              <div class="mt-6">
                <img
                  src="/images/signature.png"
                  alt="Michael Cabrera"
                  class="h-16 opacity-80"
                />
                <p class="text-sm opacity-70 mt-2">
                  Michael Cabrera, Founder & CEO
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- EMOTIONAL FOUNDERS SECTION -->
      <section
        class="py-20 px-4 sm:px-6 bg-gradient-to-br from-[#fefbf5] to-white"
      >
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16" data-aos="fade-up">
            <h2 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6">
              The Hearts Behind the Mission
            </h2>
            <p class="text-xl md:text-2xl text-gray-600 max-w-4xl mx-auto">
              Two people who couldn't watch healthcare fail any longer. Who came
              back to finish what they started.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
            <!-- Michael -->
            <div
              class="bg-white rounded-3xl shadow-xl overflow-hidden transform hover:scale-[1.02] transition-all"
              data-aos="fade-right"
            >
              <div class="p-8 md:p-10">
                <div
                  class="w-48 h-48 mx-auto mb-6 rounded-full overflow-hidden shadow-lg"
                >
                  <img
                    src="/images/michael.jpg"
                    alt="Michael Cabrera"
                    class="w-full h-full object-cover"
                  />
                </div>

                <h3 class="text-3xl font-bold text-gray-900 text-center mb-2">
                  Michael Cabrera
                </h3>
                <p class="text-[#cc9933] font-semibold text-center mb-6">
                  Co-Founder & CEO
                </p>

                <div class="grid grid-cols-2 gap-4 mb-6">
                  <div class="text-center p-4 bg-gray-50 rounded-xl">
                    <div class="text-3xl font-bold text-[#003087]">1,236%</div>
                    <div class="text-sm text-gray-600">Growth Achieved</div>
                  </div>
                  <div class="text-center p-4 bg-gray-50 rounded-xl">
                    <div class="text-3xl font-bold text-[#cc9933]">$585M+</div>
                    <div class="text-sm text-gray-600">Value Created</div>
                  </div>
                </div>

                <p class="text-gray-600 text-center mb-8 italic">
                  "Every delayed scan is someone's parent, child, or friend. We
                  can't let that continue."
                </p>

                <a
                  href="/michael-story"
