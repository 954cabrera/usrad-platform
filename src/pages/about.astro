---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout title="About USRad - The Full Story" isHeroPage={false}>
  <AOSInit />

  <!-- Hero Section with Background Image -->
  <section
    class="relative pt-32 pb-20 px-4 sm:px-6 min-h-[600px] flex items-center"
  >
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/about-hero-f.webp"
        alt="Worker with family"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-black/40">
      </div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="max-w-5xl">
        <h1 class="mb-8" data-aos="fade-up">
          <span
            class="block text-2xl sm:text-3xl font-medium text-white/80 tracking-wide mb-3"
          >
            The Story Behind
          </span>
          <span
            class="block text-7xl sm:text-8xl md:text-9xl font-bold text-[#B08A4A] leading-none tracking-tight"
          >
            USRad
          </span>
        </h1>
        <p
          class="text-xl md:text-2xl text-gray-100 leading-relaxed max-w-2xl mb-4"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          One price for the study, with the radiologist&rsquo;s interpretation
          included.
        </p>
        <p
          class="text-base md:text-lg text-[#B08A4A] font-medium tracking-wide max-w-2xl"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          We&rsquo;re building the category of Accessible Imaging.
        </p>
      </div>
    </div>
  </section>

  <!-- Founders Documentary Hero -->
  <section
    id="founders-photo"
    class="py-16 px-4 sm:px-6 bg-white border-b border-gray-100"
  >
    <div class="max-w-6xl mx-auto">
      <!-- Documentary Label -->
      <div class="mb-10" data-aos="fade-up">
        <p
          class="text-xs font-semibold uppercase tracking-[0.2em] text-[#B08A4A]"
        >
          1994 &mdash; The Founding Moment
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-0 items-stretch min-h-[580px]">
        <!-- Left: Founders Photo -->
        <div class="relative flex flex-col" data-aos="fade-right">
          <figure class="flex-1 flex flex-col">
            <div class="flex-1 overflow-hidden rounded-md shadow-md">
              <img
                src="/images/founders_restored.webp"
                alt="Michael and Donna Cabrera inside a diagnostic imaging center, mid-1990s"
                class="w-full h-full object-cover object-[center_15%]"
                loading="eager"
                width="1000"
                height="1300"
              />
            </div>
            <figcaption class="mt-4 pl-1">
              <div class="flex items-start gap-3">
                <div class="w-px h-10 bg-[#cc9933] flex-shrink-0 mt-1"></div>
                <div>
                  <p class="text-sm font-semibold text-gray-900 tracking-wide">
                    Michael &amp; Donna Cabrera
                  </p>
                  <p
                    class="text-xs text-gray-400 mt-0.5 tracking-wider uppercase"
                  >
                    Diagnostic imaging center &mdash; mid-1990s
                  </p>
                </div>
              </div>
            </figcaption>
          </figure>
        </div>

        <!-- Right: Headline + Narrative -->
        <div
          class="flex flex-col justify-center md:pl-16 pt-10 md:pt-0"
          data-aos="fade-left"
          data-aos-delay="150"
        >
          <p
            class="text-xs font-semibold uppercase tracking-widest text-[#cc9933] mb-5"
          >
            The Origin
          </p>

          <h2
            class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-6"
          >
            Where It All<br />
            <span class="text-[#003087]">Started.</span>
          </h2>

          <div class="space-y-5 text-lg text-gray-600 leading-relaxed">
            <p>
              In the early 1990s, imaging centers had open capacity and injured
              workers couldn&rsquo;t reach it. Authorization ran through
              carriers by fax and phone. Most facilities wouldn&rsquo;t schedule
              until someone approved. Nobody in the chain was accountable for
              how long it took.
            </p>
            <p>
              Florida workers&rsquo; compensation law let employers direct care.
              So in 1994, Michael and Donna Cabrera founded Managed Care
              Networks, Inc., operating as AnciCare PPO &mdash; a specialty
              preferred provider organization delivering medical imaging through
              a contracted network of independent diagnostic facilities. Volume
              commitments to imaging centers in exchange for rates below the fee
              schedule, and one party accountable for scheduling.
            </p>
            <p>
              AnciCare sold to insurers, third-party administrators and
              self-insured employers. The business was focused on workers&rsquo;
              compensation, while also accepting referrals from auto liability
              and group health.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Origin Story -->
  <section class="py-20 px-4 sm:px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <!-- Left Column: Narrative -->
        <div data-aos="fade-up">
          <!-- Chapter label -->
          <p
            class="text-xs font-semibold uppercase tracking-[0.2em] text-[#B08A4A] mb-4"
          >
            The Breakthrough
          </p>
          <!-- Bridge sentence -->
          <p class="text-lg text-gray-400 italic mb-3">
            The idea was simple. But the impact was enormous.
          </p>
          <h2
            class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 text-left"
          >
            How We Made Medical Imaging Affordable and Accessible
          </h2>

          <div
            class="h-px w-24 bg-gradient-to-r from-[#cc9933] to-transparent mb-8"
          >
          </div>

          <div class="space-y-6 text-lg text-gray-600 leading-relaxed">
            <p>
              The system wasn't broken because care was unavailable. It was
              broken because access was.
            </p>

            <p>
              In 1994, imaging centers had capacity. Injured workers had 14-day
              waits. Workers' Comp law allowed employers to direct care — so we
              built AnciCare to connect the two. Volume guarantees in exchange
              for prices below the fee schedule.
            </p>

            <p>
              What we built then was the first version of what we now call
              <span class="font-semibold text-[#003087]"
                >Accessible Imaging</span
              >
              &mdash; infrastructure that makes diagnostic care reachable for the
              people the existing system fails to serve.
            </p>

            <p class="text-sm">
              <a
                href="/blog/the-scan-that-never-happens"
                class="inline-flex items-center gap-1 text-[#003087] hover:text-[#002266] font-medium border-b border-[#003087]/30 hover:border-[#003087] transition-colors"
              >
                Read the essay
                <span aria-hidden="true">&rarr;</span>
              </a>
            </p>

            <p>
              <span class="font-semibold text-gray-900">The result:</span> 150,000+
              patients served across a national network. A proven playbook.
            </p>
          </div>

          <div
            class="bg-[#fefbf5] rounded-2xl p-6 mt-8 border-l-4 border-[#cc9933]"
          >
            <p class="text-lg font-semibold text-gray-900 mb-1">The Result:</p>
            <p class="text-gray-700">
              50%+ savings. Next-day imaging. Everyone wins.
            </p>
          </div>
        </div>

        <!-- Right Column: Credibility Panel -->
        <div
          class="bg-gray-50 rounded-xl p-8 shadow-sm border border-gray-100 md:mt-16"
          data-aos="fade-up"
          data-aos-delay="150"
        >
          <p
            class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2"
          >
            The AnciCare Record
          </p>
          <p class="text-sm text-gray-400 mb-8">
            Four dimensions of a model that worked.
          </p>
          <div class="space-y-10">
            <div>
              <p class="text-4xl font-bold text-gray-900">30+</p>
              <p class="text-sm text-gray-400 mt-1">Years in the field</p>
            </div>
            <div>
              <p class="text-4xl font-bold text-gray-900">1,200+</p>
              <p class="text-sm text-gray-400 mt-1">
                Facilities in the network
              </p>
            </div>
            <div>
              <p class="text-4xl font-bold text-[#003087]">$246M</p>
              <p class="text-sm text-gray-400 mt-1">Documented savings</p>
            </div>
            <div>
              <p class="text-4xl font-bold text-[#003087]">150,000+</p>
              <p class="text-sm text-gray-400 mt-1">People reached</p>
            </div>
          </div>
          <div class="mt-10 pt-6 border-t border-gray-200">
            <p class="text-xs text-gray-400 leading-relaxed">
              Created by the founder of AnciCare, one of the first nationwide
              diagnostic imaging networks.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- REVOLUTIONARY TIMELINE SECTION -->
  <section
    id="timeline"
    class="relative py-32 bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900 overflow-hidden"
  >
    <!-- Animated Background -->
    <div class="absolute inset-0">
      <div
        class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="
        60"
        height="60"
        viewBox="0 0 60 60"
        xmlns="http://www.w3.org/2000/svg"
        %3E%3Cg
        fill="none"
        fill-rule="evenodd"
        %3E%3Cg
        fill="%239C92AC"
        fill-opacity="0.03"
        %3E%3Cpath
        d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"
        %3E%3C
        g%3E%3C
        g%3E%3C
        svg%3E')]
        opacity-20"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6">
      <!-- Section Header -->
      <div class="text-center mb-20" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-sm px-6 py-3 rounded-full mb-8"
        >
          <div class="w-2 h-2 bg-[#cc9933] rounded-full animate-pulse"></div>
          <span
            class="text-white/80 text-sm font-medium tracking-wider uppercase"
            >The Journey</span
          >
          <div class="w-2 h-2 bg-[#003087] rounded-full animate-pulse"></div>
        </div>
        <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6">
          30 Years. Two Companies.<br />
          <span
            class="bg-gradient-to-r from-[#cc9933] to-[#003087] bg-clip-text text-transparent"
            >One Mission.</span
          >
        </h2>
        <p class="text-lg text-white/50 max-w-xl mx-auto mt-4">
          How the model evolved — milestone by milestone, into a system that
          works at scale.
        </p>
      </div>

      <!-- The Timeline -->
      <div class="relative">
        <!-- Center Path — glowing gold gradient -->
        <div
          class="absolute left-1/2 top-0 bottom-0 w-0.5 transform -translate-x-1/2"
          style="background: linear-gradient(to bottom, transparent, rgba(176,138,74,0.6) 20%, rgba(176,138,74,0.3) 70%, transparent);"
        >
        </div>

        <!-- 1993: The Discovery — ACT 1 ANCHOR -->
        <div class="relative flex items-center mb-32" data-aos="fade-right">
          <div class="w-full md:w-1/2 text-right pr-8 md:pr-16">
            <div class="inline-block">
              <span
                class="text-[#cc9933] text-8xl md:text-9xl font-bold opacity-60"
                >1993</span
              >
              <h3 class="text-3xl font-bold text-white mt-4 mb-3">
                The Discovery
              </h3>
              <p class="text-gray-300 text-lg max-w-md ml-auto">
                14-day waits. Empty imaging centers. A broken system begging for
                disruption.
              </p>
              <div
                class="mt-6 inline-flex items-center gap-4 bg-[#cc9933]/20 px-6 py-3 rounded-full"
              >
                <span class="text-4xl font-bold text-[#cc9933]">14</span>
                <span class="text-white/80">days average wait</span>
              </div>
            </div>
          </div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-24 h-24 bg-gray-900 rounded-full border-4 border-[#cc9933] flex items-center justify-center group hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/images/icons/magnifying-glass.svg"
                alt="Discovery"
                class="w-12 h-12 filter-gold group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          </div>
          <div class="hidden md:block w-1/2"></div>
        </div>

        <!-- 1994: AnciCare Launch — ACT 1 ANCHOR -->
        <div class="relative flex items-center mb-32" data-aos="fade-left">
          <div class="hidden md:block w-1/2"></div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-24 h-24 bg-gray-900 rounded-full border-4 border-[#cc9933] flex items-center justify-center group hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/images/icons/social.svg"
                alt="Network Launch"
                class="w-12 h-12 filter-gold group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          </div>
          <div class="w-full md:w-1/2 pl-8 md:pl-16">
            <span
              class="text-[#cc9933] text-8xl md:text-9xl font-bold opacity-60"
              >1994</span
            >
            <h3 class="text-3xl font-bold text-white mt-4 mb-3">
              AnciCare Launches
            </h3>
            <p class="text-gray-300 text-lg max-w-md">
              America's first imaging network. Direct contracts. Volume
              guarantees. Prices plummet.
            </p>
            <div
              class="mt-6 inline-flex items-center gap-4 bg-[#cc9933]/20 px-6 py-3 rounded-full"
            >
              <span class="text-4xl font-bold text-[#cc9933]">50%</span>
              <span class="text-white/80">cost reduction</span>
            </div>
          </div>
        </div>

        <!-- 1999: Scale — supporting year, visually subdued -->
        <div class="relative flex items-center mb-24" data-aos="fade-right">
          <div class="w-full md:w-1/2 text-right pr-8 md:pr-16">
            <div class="inline-block opacity-70">
              <span class="text-[#cc9933]/40 text-5xl md:text-6xl font-bold"
                >1999</span
              >
              <h3 class="text-2xl font-semibold text-white/80 mt-3 mb-2">
                Explosive Growth
              </h3>
              <p class="text-gray-400 text-base max-w-md ml-auto">
                National expansion. Major employers on board, including many
                Fortune 500 companies. The model works at scale.
              </p>
              <div
                class="mt-4 inline-flex items-center gap-3 bg-[#cc9933]/10 px-4 py-2 rounded-full"
              >
                <span class="text-2xl font-bold text-[#cc9933]/70"
                  >150,000+</span
                >
                <span class="text-white/60 text-sm">workers served</span>
              </div>
            </div>
          </div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-24 h-24 bg-gray-900 rounded-full border-4 border-[#cc9933] flex items-center justify-center group hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/images/icons/increase.svg"
                alt="Explosive Growth"
                class="w-12 h-12 filter-gold group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          </div>
          <div class="hidden md:block w-1/2"></div>
        </div>

        <!-- 2002: The Exit — supporting year, visually subdued -->
        <div class="relative flex items-center mb-24" data-aos="fade-left">
          <div class="hidden md:block w-1/2"></div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-16 h-16 bg-gray-900 rounded-full border-2 border-[#cc9933]/40 flex items-center justify-center group hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/images/icons/hand-shake.svg"
                alt="Mission Accomplished"
                class="w-8 h-8 filter-gold opacity-60 group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          </div>
          <div class="w-full md:w-1/2 pl-8 md:pl-16 opacity-70">
            <span class="text-[#cc9933]/40 text-5xl md:text-6xl font-bold"
              >2002</span
            >
            <h3 class="text-2xl font-semibold text-white/80 mt-3 mb-2">
              Mission Accomplished?
            </h3>
            <p class="text-gray-400 text-base max-w-md">
              AnciCare sold. A model proven at national scale. Time to
              celebrate... or so we thought.
            </p>
          </div>
        </div>

        <!-- The Transition -->
        <div class="relative my-40" data-aos="zoom-in">
          <div
            class="absolute left-1/2 top-1/2 transform -translate-x-1/2 -translate-y-1/2"
          >
            <div
              class="w-32 h-32 rounded-full bg-gradient-to-r from-[#cc9933] to-[#003087] opacity-20 animate-pulse"
            >
            </div>
          </div>
          <div class="text-center relative z-10">
            <div
              class="inline-block bg-gray-800 border border-white/20 rounded-full px-8 py-4"
            >
              <p class="text-2xl font-bold text-white">
                Healthcare costs exploded.
              </p>
              <p class="text-xl text-gray-400">
                Millions of Americans left without options.
              </p>
            </div>
          </div>
        </div>

        <!-- 2025: USRad Born — ACT 3 ANCHOR, dramatic reveal -->
        <div
          class="relative flex items-center mb-32 mt-32"
          data-aos="fade-right"
        >
          <div class="w-full md:w-1/2 text-right pr-8 md:pr-16">
            <div class="inline-block">
              <span class="text-white text-8xl md:text-9xl font-bold opacity-80"
                >2025</span
              >
              <h3 class="text-3xl font-bold text-white mt-4 mb-3">
                USRad is Born
              </h3>
              <p class="text-gray-300 text-lg max-w-md ml-auto">
                30 years of network-building. Now direct to patients. No
                insurance required.
              </p>
              <div
                class="mt-6 inline-flex items-center gap-4 bg-[#003087]/20 px-6 py-3 rounded-full"
              >
                <span class="text-4xl font-bold text-white/60">$260</span>
                <span class="text-white/80">MRI starting price</span>
              </div>
            </div>
          </div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-24 h-24 bg-gray-900 rounded-full border-4 border-[#003087] flex items-center justify-center animate-pulse overflow-hidden p-4 hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/images/logo/brand/usrad-pin.svg"
                alt="USRad Logo"
                class="w-full h-full object-contain"
              />
            </div>
          </div>
          <div class="hidden md:block w-1/2"></div>
        </div>

        <!-- 2026: Built for Members — final node, full brightness -->
        <div class="relative flex items-center" data-aos="fade-left">
          <div class="hidden md:block w-1/2"></div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-24 h-24 bg-gray-900 rounded-full border-4 border-[#003087] flex items-center justify-center group hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/images/icons/flag.svg"
                alt="Built for Members"
                class="w-12 h-12 filter-gold group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          </div>
          <div class="w-full md:w-1/2 pl-8 md:pl-16">
            <span class="text-white text-7xl md:text-8xl font-bold opacity-100"
              >2026</span
            >
            <h3 class="text-3xl font-bold text-white mt-4 mb-3">
              Built for Members
            </h3>
            <p class="text-gray-300 text-lg max-w-md">
              Nationwide launch. 60-second booking. Transparent pricing.
              Healthcare reimagined.
            </p>
            <p class="text-gray-400 text-base max-w-md mt-3">
              Free USRad membership gives every American access to
              pre-negotiated imaging prices — no insurance required.
            </p>
            <div
              class="mt-6 inline-flex items-center gap-4 bg-[#003087]/20 px-6 py-3 rounded-full"
            >
              <span class="text-4xl font-bold text-white">90 Million</span>
              <span class="text-white/80">Americans to serve</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom CTA -->
      <div class="text-center mt-32" data-aos="fade-up">
        <p class="text-2xl text-gray-400 mb-8">
          From saving companies millions to saving lives.
        </p>
        <div class="inline-flex items-center gap-8">
          <div class="text-center">
            <p class="text-5xl font-bold text-[#cc9933]">Then</p>
            <p class="text-gray-400">For Employers</p>
          </div>
          <div class="text-4xl text-white/20">→</div>
          <div class="text-center">
            <p class="text-5xl font-bold text-white/70">Now</p>
            <p class="text-gray-400">For Everyone</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Add smooth scroll behavior */
    @media (prefers-reduced-motion: no-preference) {
      .timeline-node {
        transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      }
    }

    /* Enhanced hover effects for timeline nodes */
    .group:hover {
      box-shadow: 0 0 30px rgba(204, 153, 51, 0.3);
    }

    /* USRad era nodes */
    .border-[#003087].group:hover {
      box-shadow: 0 0 30px rgba(0, 48, 135, 0.3);
    }

    /* CSS filter for gold color #cc9933 */
    .filter-gold {
      filter: brightness(0) saturate(100%) invert(79%) sepia(50%)
        saturate(1500%) hue-rotate(359deg) brightness(1.1) contrast(0.9);
    }

    /* CSS filter for white color */
    .filter-white {
      filter: brightness(0) invert(1);
    }

    /* Mobile adjustments */
    @media (max-width: 768px) {
      /* Stack timeline rows vertically */
      .relative.flex.items-center {
        flex-direction: column !important;
        align-items: flex-start !important;
      }

      /* Pull icon out of absolute positioning on mobile so it flows in the column */
      .relative.flex.items-center > .absolute.left-1\/2 {
        position: relative !important;
        left: auto !important;
        transform: none !important;
        margin-bottom: 1rem;
        order: -1; /* Icon always appears first */
      }

      /* Content blocks take full width */
      .relative.flex.items-center > div[class*="w-full"] {
        width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
      }

      .text-right {
        text-align: left !important;
      }

      .ml-auto {
        margin-left: 0 !important;
      }

      .pr-8,
      .pl-8 {
        padding: 0 !important;
      }

      /* Center line: shift to left edge on mobile for cleaner look */
      #timeline .absolute.left-1\/2.top-0.bottom-0 {
        left: 2rem !important;
        transform: none !important;
      }
    }
  </style>

