---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import ProofMetricsSection from "../components/ProofMetricsSection.astro";
import InnovationTimeline from "../components/InnovationTimeline.astro";
import ImpactBarGraph from "../components/ImpactBarGraph.astro";
import SideBySideBullets from "../components/SideBySideBullets.astro";
import FoundersSection from "../components/FoundersSection.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
const showPatientHeader = true;
---

<MainPatientLayout>
  <AOSInit />

  <!-- HERO SECTION - EVOLUTION STORY -->
  <section
    class="bg-gradient-to-br from-[#f8f2e1] to-[#fcf9f0] text-[#003087] py-16 md:py-24 lg:py-32 px-4 md:px-6"
  >
    <div class="max-w-6xl mx-auto">
      <!-- EVOLUTION BANNER -->
      <div class="text-center mb-8" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 bg-[#cc9933] text-white px-6 py-3 rounded-full text-sm font-bold mb-6"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          PROVEN FOUNDATION → MODERN EVOLUTION → EXPANDED MISSION
        </div>
      </div>

      <div class="text-center mb-16">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-semibold leading-tight mb-6 md:mb-8 text-[#003087] font-manrope"
          data-aos="fade-up"
          data-aos-duration="800"
        >
          From Pioneer to Evolution
          <span class="text-2xl block mt-2 text-[#cc9933]"
            >$400 Million Saved → 90 Million to Serve</span
          >
        </h1>
        <p
          class="text-base sm:text-lg md:text-xl text-[#003087] max-w-4xl mx-auto leading-relaxed font-manrope"
          data-aos="fade-up"
          data-aos-duration="800"
          data-aos-delay="100"
        >
          The proven team behind USRad previously built AnciCare (1994-2002),
          America's first managed care imaging network. We served <strong
            >400,000+ patients</strong
          >, delivered
          <strong>$400 Million+ in total savings</strong>, and achieved a
          <strong class="text-[#cc9933]"
            >successful exit with EY financial review and Greenberg Traurig
            representation</strong
          >. Now we're evolving that proven model for the digital age.
        </p>
      </div>

      <!-- ENHANCED PROOF METRICS -->
      <ProofMetricsSection
        metrics={[
          {
            value: "$400M+",
            label: "Total Savings Delivered",
            caption: "Verified through exit",
          },
          {
            value: "400,000+",
            label: "Patients Served",
            caption: "Proven Track Record",
          },
          {
            value: "Big Four",
            label: "Financial Review",
            caption: "EY validation",
          },
          {
            value: "20+",
            label: "Years Operating",
            caption: "Model still successful",
          },
        ]}
      />
    </div>
  </section>

  <!-- THE COMPLETE EVOLUTION STORY -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          The Evolution Journey: Foundation → Evolution → Mission
        </h2>
        <p
          class="text-lg text-[#003087]/80 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          How we built healthcare innovation, achieved institutional validation,
          and are now expanding our proven model to serve millions
        </p>
      </div>

      <!-- Chapter 1: Foundation -->
      <div class="mb-20">
        <div class="text-center mb-12" data-aos="fade-up">
          <div
            class="inline-flex items-center gap-3 bg-[#f0f4f9] rounded-full px-6 py-3"
          >
            <span class="text-5xl">🏛️</span>
            <h3 class="text-2xl font-bold text-[#003087]">
              Chapter 1: The Foundation (1994-2002)
            </h3>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- LEFT: Foundation Timeline -->
          <div data-aos="fade-right">
            <InnovationTimeline
              steps={[
                {
                  number: "1",
                  title: "Pioneered the Model (1994)",
                  description:
                    "Created America's first managed care imaging network when healthcare needed innovation most.",
                },
                {
                  number: "2",
                  title: "Revolutionary Results",
                  description:
                    "Achieved 50%+ cost savings while reducing wait times from 10-14 days to 2-3 days.",
                },
                {
                  number: "3",
                  title: "Institutional Excellence",
                  description:
                    "Built with financial discipline that attracted EY financial review and Greenberg Traurig legal counsel.",
                },
                {
                  number: "4",
                  title: "Successful Exit (2002)",
                  description:
                    "CorVel Corporation (NYSE: CVL) acquired AnciCare, validating our model at enterprise scale.",
                },
              ]}
            />
          </div>

          <!-- RIGHT: Impact Visualization -->
          <div data-aos="fade-left">
            <ImpactBarGraph
              title="Foundation Era Impact"
              metrics={[
                {
                  label: "Medical Imaging Savings",
                  value: "$200 Million+",
                  percent: 50,
                },
                {
                  label: "Productivity Savings",
                  value: "$200 Million+",
                  percent: 50,
                },
                {
                  label: "Total Value Created",
                  value: "$400 Million+",
                  percent: 100,
                  highlight: true,
                },
              ]}
            />
          </div>
        </div>
      </div>

      <!-- PROFESSIONAL VALIDATION SECTION -->
      <div
        class="bg-gradient-to-br from-[#003087]/5 to-[#cc9933]/5 rounded-3xl p-8 md:p-12 shadow-xl mb-20"
        data-aos="fade-up"
      >
        <h3
          class="text-2xl md:text-3xl font-bold text-[#003087] mb-8 text-center"
        >
          Validated by the Best in Business
        </h3>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white rounded-2xl p-8">
            <div class="mb-6">
              <h4 class="text-xl font-bold text-[#003087] mb-2">
                Big Four Financial Excellence
              </h4>
              <p class="text-sm text-[#cc9933] font-semibold">
                Ernst & Young (EY)
              </p>
            </div>
            <p class="text-[#003087]/80 mb-4">
              Our acquisition process included comprehensive financial review by
              EY, one of the world's Big Four accounting firms. This level of
              institutional scrutiny is rare in healthcare and validates our
              business fundamentals.
            </p>
            <div class="bg-[#f0f4f9] rounded-lg p-4">
              <p class="text-sm text-[#003087]">
                <strong>What This Means:</strong> Our financial model, operational
                metrics, and business practices met the rigorous standards required
                for a successful enterprise acquisition.
              </p>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-8">
            <div class="mb-6">
              <h4 class="text-xl font-bold text-[#003087] mb-2">
                First-Tier Legal Excellence
              </h4>
              <p class="text-sm text-[#cc9933] font-semibold">
                Greenberg Traurig LLP
              </p>
            </div>
            <p class="text-[#003087]/80 mb-4">
              Greenberg Traurig didn't just guide our exit—they were our trusted
              legal counsel for several years, helping us navigate the complex
              healthcare marketplace. Their healthcare division's deep expertise
              ensured not only a successful exit but also sustainable growth
              throughout our journey.
            </p>
            <div class="bg-[#f0f4f9] rounded-lg p-4">
              <p class="text-sm text-[#003087]">
                <strong>The Validation:</strong> When a premier law firm partners
                with you for years and successfully guides your exit, it demonstrates
                long-term institutional confidence in your model's viability and
                compliance.
              </p>
            </div>
          </div>
        </div>

        <div class="text-center mt-8">
          <p class="text-lg font-bold text-[#003087]">
            "We're the only imaging company with this level of professional
            validation."
          </p>
          <p class="text-sm text-[#003087]/70 mt-2">
            Our model continues operating successfully 20+ years
            post-acquisition
          </p>
        </div>
      </div>

      <!-- Chapter 2: Evolution -->
      <div class="mb-20">
        <div class="text-center mb-12" data-aos="fade-up">
          <div
            class="inline-flex items-center gap-3 bg-gradient-to-r from-[#f0f4f9] to-[#fefbf5] rounded-full px-6 py-3"
          >
            <span class="text-5xl">⚡</span>
            <h3 class="text-2xl font-bold text-[#003087]">
              Chapter 2: The Evolution (2025)
            </h3>
          </div>
        </div>

        <div
          class="bg-white rounded-3xl p-8 md:p-12 shadow-lg"
          data-aos="fade-up"
        >
          <p class="text-lg text-[#003087] mb-8 text-center">
            We're not just replicating what worked—we're enhancing it with
            modern capabilities that allow us to serve at unprecedented scale.
          </p>

          <div class="grid md:grid-cols-3 gap-8 mb-8">
            <div class="text-center">
              <div class="text-4xl font-bold text-[#cc9933] mb-2">225x</div>
              <div class="text-lg font-semibold text-[#003087] mb-2">
                Market Expansion
              </div>
              <p class="text-sm text-[#003087]/70">400K → 90M Americans</p>
            </div>
            <div class="text-center">
              <div class="text-4xl font-bold text-[#cc9933] mb-2">1000x</div>
              <div class="text-lg font-semibold text-[#003087] mb-2">
                Booking Speed
              </div>
              <p class="text-sm text-[#003087]/70">Hours → Seconds</p>
            </div>
            <div class="text-center">
              <div class="text-4xl font-bold text-[#cc9933] mb-2">24/7</div>
              <div class="text-lg font-semibold text-[#003087] mb-2">
                Accessibility
              </div>
              <p class="text-sm text-[#003087]/70">Always available</p>
            </div>
          </div>

          <div class="bg-[#f0f4f9] rounded-2xl p-6">
            <h4 class="font-bold text-[#003087] mb-4 text-center">
              Same DNA + Modern Capabilities = Exponential Impact
            </h4>
            <!-- Better aligned version -->
            <div class="grid md:grid-cols-2 gap-8 mt-8">
              <div class="bg-[#f0f4f9] rounded-xl p-6">
                <h5 class="font-semibold text-[#003087] mb-3 text-center">
                  Foundation Elements
                </h5>
                <ul class="text-sm text-[#003087]/80 space-y-2">
                  <li class="flex items-start">
                    <span class="text-[#003087] mr-2">✓</span>
                    <span>Managed care expertise</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-[#003087] mr-2">✓</span>
                    <span>Quality guarantees</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-[#003087] mr-2">✓</span>
                    <span>Transparent pricing</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-[#003087] mr-2">✓</span>
                    <span>Patient-first approach</span>
                  </li>
                </ul>
              </div>

              <div class="bg-[#fefbf5] rounded-xl p-6">
                <h5 class="font-semibold text-[#cc9933] mb-3 text-center">
                  Evolution Enhancements
                </h5>
                <ul class="text-sm text-[#003087]/80 space-y-2">
                  <li class="flex items-start">
                    <span class="text-[#cc9933] mr-2">⚡</span>
                    <span>Digital-first platform</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-[#cc9933] mr-2">⚡</span>
                    <span>Real-time booking</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-[#cc9933] mr-2">⚡</span>
                    <span>Nationwide scale</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-[#cc9933] mr-2">⚡</span>
                    <span>24/7 accessibility</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Chapter 3: Mission -->
      <div>
        <div class="text-center mb-12" data-aos="fade-up">
          <div
            class="inline-flex items-center gap-3 bg-gradient-to-r from-[#cc9933]/10 to-[#cc9933]/5 rounded-full px-6 py-3"
          >
            <span class="text-5xl">🚀</span>
            <h3 class="text-2xl font-bold text-[#003087]">
              Chapter 3: The Mission (Now)
            </h3>
          </div>
        </div>

        <div
          class="bg-gradient-to-br from-[#003087] to-[#002266] rounded-3xl p-8 md:p-12 text-white"
          data-aos="fade-up"
        >
          <h4 class="text-2xl font-bold mb-6 text-center">
            Serving the 90 Million Americans Who Need Us Most
          </h4>
          <p class="text-lg mb-8 text-center opacity-90">
            Our proven model is now focused on the uninsured and
            underinsured—those who need quality, affordable imaging but have
            been locked out of the system.
          </p>

          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-white/10 rounded-xl p-6 text-center">
              <div class="text-3xl mb-3">🎯</div>
              <h5 class="font-bold mb-2">Clear Mission</h5>
              <p class="text-sm opacity-90">
                Bring proven excellence to those who need it most
              </p>
            </div>
            <div class="bg-white/10 rounded-xl p-6 text-center">
              <div class="text-3xl mb-3">💰</div>
              <h5 class="font-bold mb-2">Transparent Pricing</h5>
              <p class="text-sm opacity-90">
                No insurance games, no surprise bills
              </p>
            </div>
            <div class="bg-white/10 rounded-xl p-6 text-center">
              <div class="text-3xl mb-3">🏆</div>
              <h5 class="font-bold mb-2">Proven Quality</h5>
              <p class="text-sm opacity-90">
                Same standards that earned our exit
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BUSINESS TRANSFORMATION STORY -->
  <section class="bg-[#f0f4f9] py-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div
        class="bg-white rounded-3xl p-8 md:p-12 shadow-xl"
        data-aos="fade-up"
      >
        <!-- Banner at the top -->
        <div class="text-center mb-10">
          <div
            class="inline-flex items-center gap-2 bg-[#cc9933] text-white px-6 py-3 rounded-full text-sm font-bold"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            PROVEN FOUNDATION + MODERN EVOLUTION = EXPANDED IMPACT
          </div>
        </div>

        <h3
          class="text-2xl md:text-3xl font-bold text-[#003087] mb-12 text-center"
        >
          How We Transformed Healthcare: Then and Now
        </h3>

        <!-- Two Column Grid with Better Visual Balance -->
        <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
          <!-- Left Column - Problems Solved -->
          <div
            class="bg-gradient-to-br from-[#f8f5e8] to-[#fefbf5] rounded-2xl p-8"
          >
            <div class="flex items-center mb-6">
              <div
                class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center mr-4"
              >
                <span class="text-2xl text-white">🏛️</span>
              </div>
              <h4 class="text-xl font-bold text-[#003087]">
                Problems We Solved<br /><span
                  class="text-sm font-normal text-[#003087]/70"
                  >(1994-2002)</span>
              </h4>
            </div>

            <div class="space-y-4">
              <div class="flex items-start">
                <span class="text-[#cc9933] mr-3 mt-1">•</span>
                <p class="text-[#003087]">
                  <span class="font-semibold">10-14 day wait times</span> → 2-3 days
                </p>
              </div>
              <div class="flex items-start">
                <span class="text-[#cc9933] mr-3 mt-1">•</span>
                <p class="text-[#003087]">
                  <span class="font-semibold">$1,000+ imaging costs</span> → 50%+
                  savings
                </p>
              </div>
              <div class="flex items-start">
                <span class="text-[#cc9933] mr-3 mt-1">•</span>
                <p class="text-[#003087]">
                  <span class="font-semibold">Complex referrals</span> → Direct access
                </p>
              </div>
              <div class="flex items-start">
                <span class="text-[#cc9933] mr-3 mt-1">•</span>
                <p class="text-[#003087]">
                  <span class="font-semibold">Quality uncertainty</span> → Guaranteed
                  standards
                </p>
              </div>
              <div class="flex items-start">
                <span class="text-[#cc9933] mr-3 mt-1">•</span>
                <p class="text-[#003087]">
                  <span class="font-semibold">Hidden costs</span> → Transparent pricing
                </p>
              </div>
            </div>
          </div>

          <!-- Right Column - Evolution -->
          <div
            class="bg-gradient-to-br from-[#e8ecf4] to-[#f0f4f9] rounded-2xl p-8"
          >
            <div class="flex items-center mb-6">
              <div
                class="w-12 h-12 bg-[#cc9933] rounded-xl flex items-center justify-center mr-4"
              >
                <span class="text-2xl text-white">⚡</span>
              </div>
              <h4 class="text-xl font-bold text-[#003087]">
                Evolution for Today<br /><span
                  class="text-sm font-normal text-[#003087]/70">(2025)</span>
              </h4>
            </div>

            <div class="space-y-4">
              <div class="flex items-start">
                <span class="text-[#cc9933] mr-3 mt-1">•</span>
                <p class="text-[#003087]">
                  <span class="font-semibold">Phone booking</span> → 60-second digital
                </p>
              </div>
              <div class="flex items-start">
                <span class="text-[#cc9933] mr-3 mt-1">•</span>
                <p class="text-[#003087]">
                  <span class="font-semibold">Business hours</span> → 24/7 access
                </p>
              </div>
              <div class="flex items-start">
                <span class="text-[#cc9933] mr-3 mt-1">•</span>
                <p class="text-[#003087]">
                  <span class="font-semibold">Regional</span> → Nationwide coverage
                </p>
              </div>
              <div class="flex items-start">
                <span class="text-[#cc9933] mr-3 mt-1">•</span>
                <p class="text-[#003087]">
                  <span class="font-semibold">Thousands served</span> → Millions
                  ready
                </p>
              </div>
              <div class="flex items-start">
                <span class="text-[#cc9933] mr-3 mt-1">•</span>
                <p class="text-[#003087]">
                  <span class="font-semibold">Same proven model</span> → Digitally
                  enhanced
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Summary Statement -->
        <div class="mt-10 text-center">
          <p class="text-lg text-[#003087]/80 max-w-3xl mx-auto">
            The same innovative approach that revolutionized imaging access 20
            years ago, now enhanced with digital capabilities to serve
            exponentially more Americans.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOUNDERS SECTION - Keep existing but enhanced intro -->
  <FoundersSection />

  <!-- VISION & VALUES - EVOLUTION FOCUSED -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          Our Vision & Values
          <span class="text-lg font-normal text-[#003087]/70 block mt-2">
            Same values, evolved delivery, expanded mission
          </span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-16">
        <!-- Vision Column -->
        <div class="space-y-8" data-aos="fade-right">
          <h3 class="text-2xl md:text-3xl font-bold text-[#003087] mb-6">
            From Proven Success to Scaled Impact
          </h3>

          <div class="bg-[#f0f4f9] rounded-2xl p-6">
            <p class="text-lg leading-relaxed text-[#003087]">
              We're not experimenting—we're <strong
                >evolving proven success</strong
              >. After building AnciCare into a model so effective that it
              achieved Big Four validation and continues operating 20+ years
              later, we're now bringing the same innovation to serve the 90
              million Americans who deserve affordable, quality healthcare.
            </p>
          </div>

          <div class="space-y-6">
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0 mt-1"
              >
                ✓
              </div>
              <div>
                <h4 class="font-bold text-[#003087] mb-1">
                  Validated Excellence
                </h4>
                <p class="text-[#003087]/80">
                  EY financial review and successful exit prove our model
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0 mt-1"
              >
                ⚡
              </div>
              <div>
                <h4 class="font-bold text-[#003087] mb-1">Digital Evolution</h4>
                <p class="text-[#003087]/80">
                  Same proven approach, enhanced with modern technology
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0 mt-1"
              >
                🚀
              </div>
              <div>
                <h4 class="font-bold text-[#003087] mb-1">Expanded Mission</h4>
                <p class="text-[#003087]/80">
                  From 400,000 to 90 million Americans who need access
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Values Column - Enhanced with Evolution -->
        <div class="space-y-8" data-aos="fade-left">
          <h3 class="text-2xl md:text-3xl font-bold text-[#003087] mb-6">
            Values That Evolve With Purpose
          </h3>

          <div class="space-y-6">
            <div
              class="bg-white border-2 border-[#e6c378] rounded-xl p-6 hover:shadow-lg transition-shadow"
            >
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center text-white text-xl font-bold mr-4"
                >
                  T
                </div>
                <div>
                  <h4 class="text-xl font-bold text-[#003087]">Transparency</h4>
                  <p class="text-sm text-[#cc9933] font-medium">
                    Pioneered then, perfected now
                  </p>
                </div>
              </div>
              <p class="text-[#003087]/90">
                We pioneered transparent pricing with AnciCare. Now enhanced
                with real-time digital visibility, our pricing model remains the
