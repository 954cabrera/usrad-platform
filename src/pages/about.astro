---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import InnovationTimeline from "../components/InnovationTimeline.astro";
import ImpactBarGraph from "../components/ImpactBarGraph.astro";
import FoundersSection from "../components/FoundersSection.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
const showPatientHeader = true;
---

<MainPatientLayout>
  <AOSInit />

  <!-- HERO SECTION - STREAMLINED -->
  <section
    class="bg-gradient-to-br from-[#f8f2e1] to-[#fcf9f0] text-[#003087] py-16 md:py-24 lg:py-32 px-4 md:px-6"
  >
    <div class="max-w-6xl mx-auto">
      <!-- EVOLUTION BANNER -->
      <div class="text-center mb-8" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 bg-[#cc9933] text-white px-6 py-3 rounded-full text-sm font-bold mb-6"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          PROVEN FOUNDATION → MODERN EVOLUTION → EXPANDED MISSION
        </div>
      </div>

      <div class="text-center mb-16">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-semibold leading-tight mb-6 md:mb-8 text-[#003087] font-manrope"
          data-aos="fade-up"
          data-aos-duration="800"
        >
          From Pioneer to Evolution
          <span class="text-2xl block mt-2 text-[#cc9933]"
            >$400 Million Saved → 90 Million to Serve</span
          >
        </h1>
        <p
          class="text-base sm:text-lg md:text-xl text-[#003087] max-w-3xl mx-auto leading-relaxed font-manrope"
          data-aos="fade-up"
          data-aos-duration="800"
          data-aos-delay="100"
        >
          We built AnciCare (1994-2002), America's first managed care imaging
          network.
          <strong>400,000+ patients served. $400M+ saved.</strong>
          Now we're evolving that proven model for the digital age.
        </p>
      </div>

      <!-- NEW VISUAL COMPARISON SECTION -->
      <div
        class="relative bg-white rounded-3xl shadow-2xl overflow-hidden"
        data-aos="fade-up"
      >
        <!-- Split background -->
        <div class="absolute inset-0 flex">
          <div class="w-1/2 bg-gradient-to-br from-gray-50 to-gray-100"></div>
          <div class="w-1/2 bg-gradient-to-br from-[#fefbf5] to-[#fff8e8]">
          </div>
        </div>

        <!-- Center divider with arrow -->
        <div
          class="absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-[#cc9933] to-transparent"
        >
        </div>
        <div
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20"
        >
          <div class="bg-white rounded-full p-4 shadow-xl">
            <svg
              class="w-8 h-8 text-[#cc9933] animate-pulse"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
              ></path>
            </svg>
          </div>
        </div>

        <!-- Content -->
        <div class="relative grid md:grid-cols-2 gap-8 p-8 md:p-12">
          <!-- Foundation Side -->
          <div class="text-center space-y-6">
            <div>
              <h3
                class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2"
              >
                Foundation
              </h3>
              <p class="text-xl font-bold text-[#003087]">What We Built</p>
            </div>

            <div class="space-y-4">
              <div class="transform hover:scale-105 transition-transform">
                <div class="text-2xl font-bold text-gray-600">
                  Regional Network
                </div>
              </div>

              <div class="transform hover:scale-105 transition-transform">
                <div class="text-2xl font-bold text-gray-600">Days to Book</div>
              </div>

              <div class="transform hover:scale-105 transition-transform">
                <div class="text-2xl font-bold text-gray-600">
                  Limited Hours
                </div>
              </div>

              <div class="transform hover:scale-105 transition-transform">
                <div class="text-2xl font-bold text-gray-600">400K Served</div>
              </div>
            </div>
          </div>

          <!-- Evolution Side -->
          <div class="text-center space-y-6">
            <div>
              <h3
                class="text-sm font-bold text-[#cc9933] uppercase tracking-wider mb-2"
              >
                Evolution
              </h3>
              <p class="text-xl font-bold text-[#003087]">
                What We're Building
              </p>
            </div>

            <div class="space-y-4">
              <div
                class="transform hover:scale-110 transition-all hover:text-[#cc9933]"
              >
                <div class="text-2xl font-bold text-[#003087]">
                  Nationwide Network
                </div>
              </div>

              <div
                class="transform hover:scale-110 transition-all hover:text-[#cc9933]"
              >
                <div class="text-2xl font-bold text-[#003087]">
                  Book in Seconds
                </div>
              </div>

              <div
                class="transform hover:scale-110 transition-all hover:text-[#cc9933]"
              >
                <div class="text-2xl font-bold text-[#003087]">
                  24/7 Availability
                </div>
              </div>

              <div
                class="transform hover:scale-110 transition-all hover:text-[#cc9933]"
              >
                <div
                  class="text-3xl font-bold bg-gradient-to-r from-[#cc9933] to-yellow-400 bg-clip-text text-transparent"
                >
                  90 Million Ready
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom accent -->
        <div
          class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-gray-300 via-[#cc9933] to-yellow-400"
        >
        </div>
      </div>
    </div>
  </section>

  <!-- STREAMLINED JOURNEY SECTION -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          The Innovation Story: From AnciCare to USRad
        </h2>
        <p
          class="text-lg text-[#003087]/80 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          How we built a revolutionary healthcare company and are now expanding
          that proven model to serve 90 million Americans
        </p>
      </div>

      <!-- Combined Timeline & Impact Visual -->
      <div class="grid lg:grid-cols-3 gap-8 mb-16">
        <!-- Left: Timeline Steps -->
        <div class="lg:col-span-2 space-y-6" data-aos="fade-right">
          <!-- Step 1 -->
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0">
              <div
                class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center text-white font-bold text-lg"
              >
                1
              </div>
            </div>
            <div class="flex-grow">
              <h3 class="text-xl font-bold text-[#003087] mb-2">
                Created AnciCare (1994)
              </h3>
              <p class="text-[#003087]/80">
                Founded America's first comprehensive managed care imaging
                network when traditional healthcare couldn't solve the cost and
                access crisis.
              </p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0">
              <div
                class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center text-white font-bold text-lg"
              >
                2
              </div>
            </div>
            <div class="flex-grow">
              <h3 class="text-xl font-bold text-[#003087] mb-2">
                Revolutionary Results
              </h3>
              <p class="text-[#003087]/80">
                Achieved 50%+ cost savings while reducing wait times from 10-14
                days to 2-3 days—transforming the patient experience.
              </p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0">
              <div
                class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center text-white font-bold text-lg"
              >
                3
              </div>
            </div>
            <div class="flex-grow">
              <h3 class="text-xl font-bold text-[#003087] mb-2">
                Massive Scale Impact
              </h3>
              <p class="text-[#003087]/80">
                Delivered $200M+ in direct medical savings and $200M+ in
                productivity savings through faster return-to-work.
              </p>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0">
              <div
                class="w-12 h-12 bg-[#003087] rounded-full flex items-center justify-center text-white font-bold text-lg"
              >
                4
              </div>
            </div>
            <div class="flex-grow">
              <h3 class="text-xl font-bold text-[#003087] mb-2">
                CorVel Acquisition (2002)
              </h3>
              <p class="text-[#003087]/80">
                CorVel Corporation (NYSE: CVL) acquired AnciCare, validating our
                model at enterprise scale. They continue operating it
                successfully 20+ years later.
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Impact Metrics -->
        <div
          class="bg-gradient-to-br from-[#fefbf5] to-[#f8f5e8] rounded-2xl p-6 h-fit"
          data-aos="fade-left"
        >
          <h3 class="text-xl font-bold text-[#003087] mb-6 text-center">
            Total Impact Delivered
          </h3>

          <!-- Savings Bars -->
          <div class="space-y-4 mb-6">
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="text-[#003087]">Medical Imaging Savings</span>
                <span class="text-[#cc9933] font-bold">$200M+</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-3">
                <div
                  class="bg-gradient-to-r from-[#cc9933] to-yellow-400 h-3 rounded-full"
                  style="width: 50%"
                >
                </div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-sm mb-1">
                <span class="text-[#003087]">Productivity Savings</span>
                <span class="text-[#cc9933] font-bold">$200M+</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-3">
                <div
                  class="bg-gradient-to-r from-[#cc9933] to-yellow-400 h-3 rounded-full"
                  style="width: 50%"
                >
                </div>
              </div>
            </div>
          </div>

          <!-- Total Value -->
          <div
            class="bg-white rounded-xl p-4 text-center border-2 border-[#cc9933]"
          >
            <p class="text-sm text-[#003087] mb-1">Total Value Created</p>
            <p class="text-3xl font-bold text-[#cc9933]">$400 Million+</p>
          </div>

          <!-- Key Metrics Grid -->
          <div class="grid grid-cols-2 gap-4 mt-6">
            <div class="text-center">
              <p class="text-2xl font-bold text-[#003087]">2-3 Days</p>
              <p class="text-xs text-[#003087]/70">Avg. Wait Time</p>
            </div>
            <div class="text-center">
              <p class="text-2xl font-bold text-[#003087]">50%+</p>
              <p class="text-xs text-[#003087]/70">Cost Savings</p>
            </div>
            <div class="text-center">
              <p class="text-2xl font-bold text-[#003087]">100%</p>
              <p class="text-xs text-[#003087]/70">Quality Guarantee</p>
            </div>
            <div class="text-center">
              <p class="text-2xl font-bold text-[#003087]">1,200+</p>
              <p class="text-xs text-[#003087]/70">Network Centers</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Evolution to Today -->
      <div
        class="bg-gradient-to-r from-[#003087] to-[#002266] rounded-2xl p-8 text-white text-center"
        data-aos="fade-up"
      >
        <h3 class="text-2xl font-bold mb-4">Now: The Digital Evolution</h3>
        <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
          <div>
            <div class="text-4xl mb-2">⚡</div>
            <h4 class="font-bold mb-1">2025 Launch</h4>
            <p class="text-sm opacity-90">
              Same proven model, digitally enhanced
            </p>
          </div>
          <div>
            <div class="text-4xl mb-2">🌐</div>
            <h4 class="font-bold mb-1">Nationwide Scale</h4>
            <p class="text-sm opacity-90">1,500+ centers competing for you</p>
          </div>
          <div>
            <div class="text-4xl mb-2">🚀</div>
            <h4 class="font-bold mb-1">90M Americans</h4>
            <p class="text-sm opacity-90">Ready to serve the underserved</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOUNDERS SECTION - Keep as is -->
  <FoundersSection />

  <!-- STREAMLINED VALUES -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          Our Vision & Values
        </h2>
        <p
          class="text-lg text-[#003087]/70"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          From proven foundation to digital revolution—making quality imaging
          affordable for everyone
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <!-- Left: Vision -->
        <div data-aos="fade-right">
          <h3 class="text-2xl font-bold text-[#003087] mb-6">
            Expanding Proven Innovation
          </h3>

          <p class="text-lg text-[#003087]/80 mb-8">
            We're not experimenting—we're <strong class="text-[#003087]"
              >expanding proven success</strong
            >. After building AnciCare into a model so effective it was acquired
            by a NYSE-listed company and continues operating successfully today,
            we're now bringing the same innovation to serve 90 million Americans
            who deserve affordable, quality healthcare.
          </p>

          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div
                class="w-10 h-10 bg-[#cc9933] rounded-full flex items-center justify-center flex-shrink-0"
              >
                <svg
                  class="w-5 h-5 text-white"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-[#003087]">Validated Model</h4>
                <p class="text-sm text-[#003087]/70">
                  Successful acquisition proved the model works
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-10 h-10 bg-[#cc9933] rounded-full flex items-center justify-center flex-shrink-0"
              >
                <svg
                  class="w-5 h-5 text-white"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-[#003087]">Massive Impact</h4>
                <p class="text-sm text-[#003087]/70">
                  From hundreds of thousands to 90 million Americans
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-10 h-10 bg-[#cc9933] rounded-full flex items-center justify-center flex-shrink-0"
              >
                <svg
                  class="w-5 h-5 text-white"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-[#003087]">Proven Results</h4>
                <p class="text-sm text-[#003087]/70">
                  $400M+ in delivered savings proves our approach
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Values -->
        <div class="space-y-6" data-aos="fade-left">
          <h3 class="text-2xl font-bold text-[#003087]">
            Values That Deliver Results
          </h3>

          <!-- Transparency -->
          <div
            class="bg-gradient-to-br from-[#fefbf5] to-white rounded-2xl p-6 border border-[#e6c378]/20 hover:shadow-lg transition-shadow"
          >
            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center text-white text-xl font-bold flex-shrink-0"
              >
                T
              </div>
              <div class="flex-grow">
                <h4 class="text-xl font-bold text-[#003087] mb-1">
                  Transparency
                </h4>
                <p class="text-sm text-[#cc9933] font-medium mb-3">
                  Proven through 400,000+ interactions
                </p>
                <p class="text-sm text-[#003087]/80">
                  We pioneered transparent pricing in medical imaging. Our
                  all-inclusive model eliminated surprise billing and became the
                  industry standard—and now our nationwide network brings you
                  real-time competitive pricing from 1,500+ centers, ensuring
                  you always get the best value.
                </p>
              </div>
            </div>
          </div>

          <!-- Accessibility -->
          <div
            class="bg-gradient-to-br from-[#f0f4f9] to-white rounded-2xl p-6 border border-[#003087]/10 hover:shadow-lg transition-shadow"
          >
            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center text-white text-xl font-bold flex-shrink-0"
              >
                A
              </div>
              <div class="flex-grow">
                <h4 class="text-xl font-bold text-[#003087] mb-1">
                  Accessibility
                </h4>
                <p class="text-sm text-[#cc9933] font-medium mb-3">
                  $400 Million+ in savings delivered
                </p>
                <p class="text-sm text-[#003087]/80">
                  We proved that premium imaging can be affordable. Our managed
                  care model delivered 50%+ savings while maintaining the
                  highest quality standards—a formula still in use today.
                </p>
              </div>
            </div>
          </div>

          <!-- Quality -->
          <div
            class="bg-gradient-to-br from-[#fefbf5] to-white rounded-2xl p-6 border border-[#e6c378]/20 hover:shadow-lg transition-shadow"
          >
            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center text-white text-xl font-bold flex-shrink-0"
              >
                Q
              </div>
              <div class="flex-grow">
                <h4 class="text-xl font-bold text-[#003087] mb-1">Quality</h4>
                <p class="text-sm text-[#cc9933] font-medium mb-3">
                  100% quality guarantee
                </p>
                <p class="text-sm text-[#003087]/80">
                  We were first to offer a quality guarantee in medical imaging.
                  Our network maintained consistent excellence that earned
                  Fortune 500 trust and set the industry standard—and now we
                  extend that same guarantee to you.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SIMPLIFIED CTA -->
  <section
    class="py-20 px-6 bg-gradient-to-br from-[#003087] to-[#002266] text-white relative overflow-hidden"
  >
    <!-- Background Elements -->
    <div class="absolute inset-0">
      <!-- Subtle grid pattern -->
      <div
        class="absolute inset-0 opacity-5"
        style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 1px);
        background-size: 40px 40px;"
      >
      </div>
      <!-- Glow effects -->
      <div
        class="absolute top-20 left-20 w-96 h-96 bg-[#cc9933] rounded-full filter blur-3xl opacity-10"
      >
      </div>
      <div
        class="absolute bottom-20 right-20 w-96 h-96 bg-white rounded-full filter blur-3xl opacity-5"
      >
      </div>
    </div>

    <div class="max-w-5xl mx-auto text-center relative z-10">
      <!-- Impact Numbers Animation -->
      <div
        class="grid grid-cols-3 gap-8 max-w-3xl mx-auto mb-10"
        data-aos="fade-down"
      >
        <div class="text-center">
          <div class="text-4xl md:text-5xl font-bold text-[#cc9933] mb-2">
            $400M+
          </div>
          <div class="text-sm opacity-80">Saved for Patients</div>
        </div>
        <div class="text-center">
          <div class="text-4xl md:text-5xl font-bold text-white mb-2">
            1,500+
          </div>
          <div class="text-sm opacity-80">Centers Competing</div>
        </div>
        <div class="text-center">
          <div class="text-4xl md:text-5xl font-bold text-[#cc9933] mb-2">
            24/7
          </div>
          <div class="text-sm opacity-80">Instant Access</div>
        </div>
      </div>

      <!-- Main Message -->
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 whitespace-nowrap"
        data-aos="fade-up"
      >
        The Future of <span
          class="bg-gradient-to-r from-[#cc9933] to-yellow-400 bg-clip-text text-transparent"
          >Affordable</span
        > Medical Imaging is Here
      </h2>

      <!-- Transformation Visual -->
      <div
        class="flex items-center justify-center gap-4 mb-8"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="flex items-center gap-2">
          <span class="text-lg opacity-70">Traditional Healthcare</span>
          <div
            class="w-12 h-12 bg-gray-600/30 rounded-lg flex items-center justify-center"
          >
            <svg
              class="w-6 h-6 text-gray-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
        </div>

        <svg
          class="w-8 h-8 text-[#cc9933] animate-pulse"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="3"
