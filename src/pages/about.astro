---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout title="About USRad - The Full Story" isHeroPage={false}>
  <AOSInit />

  <!-- Hero Section with Background Image -->
  <section
    class="relative pt-32 pb-20 px-4 sm:px-6 min-h-[600px] flex items-center"
  >
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/about-hero-f.webp"
        alt="Worker with family"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-black/40">
      </div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="max-w-5xl">
        <h1
          class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold mb-8 text-white leading-tight"
          data-aos="fade-up"
        >
          The Full Story Behind<br />
          <span class="text-[#cc9933]">The Revolution</span>
        </h1>
        <p
          class="text-xl md:text-2xl text-gray-100 leading-relaxed"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          How a Workers' Compensation crisis in 1994 led to a healthcare model
          that saved $246 million and is now evolving to serve 90 million
          Americans.
        </p>
      </div>
    </div>
  </section>

  <!-- The Origin Story -->
  <section class="py-20 px-4 sm:px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2
        class="text-4xl md:text-5xl font-bold text-gray-900 mb-12 text-center"
        data-aos="fade-up"
      >
        How We Made Medical Imaging Affordable and Accessible
      </h2>

      <div
        class="space-y-8 text-xl text-gray-600 leading-relaxed"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <p>
          In 1994, managing Workers' Compensation claims revealed an
          opportunity: While injured workers waited 14 days for imaging, quality
          outpatient centers had immediate availability.
        </p>

        <p>
          <span class="font-semibold text-gray-900">The breakthrough?</span> Workers'
          Comp laws allowed employers and insurers to direct care.
        </p>

        <p>
          We built AnciCare—America's first imaging network that guaranteed
          volume to providers in exchange for dramatic cost reductions. Centers
          lowered prices beyond the $1,000 fee schedule. Employers saved
          millions. Workers got immediate care.
        </p>

        <div
          class="bg-[#fefbf5] rounded-2xl p-8 my-12 border-l-4 border-[#cc9933]"
        >
          <p class="text-2xl font-semibold text-gray-900 mb-2">The Result:</p>
          <p class="text-xl text-gray-700">
            50%+ savings. Next-day imaging. Everyone wins.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- REVOLUTIONARY TIMELINE SECTION -->
  <section
    class="relative py-32 bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900 overflow-hidden"
  >
    <!-- Animated Background -->
    <div class="absolute inset-0">
      <div
        class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="
        60"
        height="60"
        viewBox="0 0 60 60"
        xmlns="http://www.w3.org/2000/svg"
        %3E%3Cg
        fill="none"
        fill-rule="evenodd"
        %3E%3Cg
        fill="%239C92AC"
        fill-opacity="0.03"
        %3E%3Cpath
        d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"
        %3E%3C
        g%3E%3C
        g%3E%3C
        svg%3E')]
        opacity-20"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6">
      <!-- Section Header -->
      <div class="text-center mb-20" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-sm px-6 py-3 rounded-full mb-8"
        >
          <div class="w-2 h-2 bg-[#cc9933] rounded-full animate-pulse"></div>
          <span
            class="text-white/80 text-sm font-medium tracking-wider uppercase"
            >The Journey</span
          >
          <div class="w-2 h-2 bg-[#003087] rounded-full animate-pulse"></div>
        </div>
        <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6">
          30 Years. Two Companies.<br />
          <span
            class="bg-gradient-to-r from-[#cc9933] to-[#003087] bg-clip-text text-transparent"
            >One Mission.</span
          >
        </h2>
      </div>

      <!-- The Timeline -->
      <div class="relative">
        <!-- Center Path -->
        <div
          class="absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-white/20 to-transparent transform -translate-x-1/2"
        >
        </div>

        <!-- 1993: The Discovery -->
        <div class="relative flex items-center mb-32" data-aos="fade-right">
          <div class="w-full md:w-1/2 text-right pr-8 md:pr-16">
            <div class="inline-block">
              <span
                class="text-[#cc9933] text-7xl md:text-8xl font-bold opacity-20"
                >1993</span
              >
              <h3 class="text-3xl font-bold text-white mt-4 mb-3">
                The Discovery
              </h3>
              <p class="text-gray-300 text-lg max-w-md ml-auto">
                14-day waits. Empty imaging centers. A broken system begging for
                disruption.
              </p>
              <div
                class="mt-6 inline-flex items-center gap-4 bg-[#cc9933]/20 px-6 py-3 rounded-full"
              >
                <span class="text-4xl font-bold text-[#cc9933]">14</span>
                <span class="text-white/80">days average wait</span>
              </div>
            </div>
          </div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-24 h-24 bg-gray-900 rounded-full border-4 border-[#cc9933] flex items-center justify-center group hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/images/icons/magnifying-glass.svg"
                alt="Discovery"
                class="w-12 h-12 filter-gold group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          </div>
          <div class="hidden md:block w-1/2"></div>
        </div>

        <!-- 1994: AnciCare Launch -->
        <div class="relative flex items-center mb-32" data-aos="fade-left">
          <div class="hidden md:block w-1/2"></div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-24 h-24 bg-gray-900 rounded-full border-4 border-[#cc9933] flex items-center justify-center group hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/images/icons/social.svg"
                alt="Network Launch"
                class="w-12 h-12 filter-gold group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          </div>
          <div class="w-full md:w-1/2 pl-8 md:pl-16">
            <span
              class="text-[#cc9933] text-7xl md:text-8xl font-bold opacity-20"
              >1994</span
            >
            <h3 class="text-3xl font-bold text-white mt-4 mb-3">
              AnciCare Launches
            </h3>
            <p class="text-gray-300 text-lg max-w-md">
              America's first imaging network. Direct contracts. Volume
              guarantees. Prices plummet.
            </p>
            <div
              class="mt-6 inline-flex items-center gap-4 bg-[#cc9933]/20 px-6 py-3 rounded-full"
            >
              <span class="text-4xl font-bold text-[#cc9933]">50%</span>
              <span class="text-white/80">cost reduction</span>
            </div>
          </div>
        </div>

        <!-- 1999: Scale -->
        <div class="relative flex items-center mb-32" data-aos="fade-right">
          <div class="w-full md:w-1/2 text-right pr-8 md:pr-16">
            <div class="inline-block">
              <span
                class="text-[#cc9933] text-7xl md:text-8xl font-bold opacity-20"
                >1999</span
              >
              <h3 class="text-3xl font-bold text-white mt-4 mb-3">
                Explosive Growth
              </h3>
              <p class="text-gray-300 text-lg max-w-md ml-auto">
                National expansion. Major employers on board. The model works at
                scale.
              </p>
              <div
                class="mt-6 inline-flex items-center gap-4 bg-[#cc9933]/20 px-6 py-3 rounded-full"
              >
                <span class="text-4xl font-bold text-[#cc9933]">168K</span>
                <span class="text-white/80">workers served</span>
              </div>
            </div>
          </div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-24 h-24 bg-gray-900 rounded-full border-4 border-[#cc9933] flex items-center justify-center group hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/images/icons/increase.svg"
                alt="Explosive Growth"
                class="w-12 h-12 filter-gold group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          </div>
          <div class="hidden md:block w-1/2"></div>
        </div>

        <!-- 2002: The Exit -->
        <div class="relative flex items-center mb-32" data-aos="fade-left">
          <div class="hidden md:block w-1/2"></div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-24 h-24 bg-gray-900 rounded-full border-4 border-[#cc9933] flex items-center justify-center group hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/images/icons/hand-shake.svg"
                alt="Mission Accomplished"
                class="w-12 h-12 filter-gold group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          </div>
          <div class="w-full md:w-1/2 pl-8 md:pl-16">
            <span
              class="text-[#cc9933] text-7xl md:text-8xl font-bold opacity-20"
              >2002</span
            >
            <h3 class="text-3xl font-bold text-white mt-4 mb-3">
              Mission Accomplished?
            </h3>
            <p class="text-gray-300 text-lg max-w-md">
              AnciCare sold. $246 million saved. Time to celebrate... or so we
              thought.
            </p>
            <div
              class="mt-6 inline-flex items-center gap-4 bg-[#cc9933]/20 px-6 py-3 rounded-full"
            >
              <span class="text-4xl font-bold text-[#cc9933]">$246M</span>
              <span class="text-white/80">total saved</span>
            </div>
          </div>
        </div>

        <!-- The Transition -->
        <div class="relative my-40" data-aos="zoom-in">
          <div
            class="absolute left-1/2 top-1/2 transform -translate-x-1/2 -translate-y-1/2"
          >
            <div
              class="w-32 h-32 rounded-full bg-gradient-to-r from-[#cc9933] to-[#003087] opacity-20 animate-pulse"
            >
            </div>
          </div>
          <div class="text-center relative z-10">
            <div
              class="inline-block bg-gray-800 border border-white/20 rounded-full px-8 py-4"
            >
              <p class="text-2xl font-bold text-white">
                Healthcare costs exploded.
              </p>
              <p class="text-xl text-gray-400">
                90 million Americans priced out.
              </p>
            </div>
          </div>
        </div>

        <!-- 2024: USRad Born -->
        <div class="relative flex items-center mb-32" data-aos="fade-right">
          <div class="w-full md:w-1/2 text-right pr-8 md:pr-16">
            <div class="inline-block">
              <span class="text-white/20 text-7xl md:text-8xl font-bold"
                >2024</span
              >
              <h3 class="text-3xl font-bold text-white mt-4 mb-3">
                USRad is Born
              </h3>
              <p class="text-gray-300 text-lg max-w-md ml-auto">
                Same expertise. New mission. Direct to consumer. No insurance
                required.
              </p>
              <div
                class="mt-6 inline-flex items-center gap-4 bg-[#003087]/20 px-6 py-3 rounded-full"
              >
                <span class="text-4xl font-bold text-white/30">$260</span>
                <span class="text-white/80">MRI starting price</span>
              </div>
            </div>
          </div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-24 h-24 bg-gray-900 rounded-full border-4 border-[#003087] flex items-center justify-center animate-pulse overflow-hidden p-4 hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/logo/Florida.png"
                alt="USRad Logo"
                class="w-full h-full object-contain"
              />
            </div>
          </div>
          <div class="hidden md:block w-1/2"></div>
        </div>

        <!-- 2025: The Revolution -->
        <div class="relative flex items-center" data-aos="fade-left">
          <div class="hidden md:block w-1/2"></div>
          <div class="absolute left-1/2 transform -translate-x-1/2 z-10">
            <div
              class="w-24 h-24 bg-gray-900 rounded-full border-4 border-[#003087] flex items-center justify-center group hover:bg-gray-800 transition-all duration-300"
            >
              <img
                src="/images/icons/flag.svg"
                alt="Revolution Begins"
                class="w-12 h-12 filter-gold group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          </div>
          <div class="w-full md:w-1/2 pl-8 md:pl-16">
            <span class="text-white/20 text-7xl md:text-8xl font-bold"
              >2025</span
            >
            <h3 class="text-3xl font-bold text-white mt-4 mb-3">
              The Revolution Begins
            </h3>
            <p class="text-gray-300 text-lg max-w-md">
              Nationwide launch. 60-second booking. Transparent pricing.
              Healthcare reimagined.
            </p>
            <div
              class="mt-6 inline-flex items-center gap-4 bg-[#003087]/20 px-6 py-3 rounded-full"
            >
              <span class="text-4xl font-bold text-white/30">90 Million</span>
              <span class="text-white/80">Americans to serve</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom CTA -->
      <div class="text-center mt-32" data-aos="fade-up">
        <p class="text-2xl text-gray-400 mb-8">
          From saving companies millions to saving lives.
        </p>
        <div class="inline-flex items-center gap-8">
          <div class="text-center">
            <p class="text-5xl font-bold text-[#cc9933]">Then</p>
            <p class="text-gray-400">For Employers</p>
          </div>
          <div class="text-4xl text-white/20">→</div>
          <div class="text-center">
            <p class="text-5xl font-bold text-white/70">Now</p>
            <p class="text-gray-400">For Everyone</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Add smooth scroll behavior */
    @media (prefers-reduced-motion: no-preference) {
      .timeline-node {
        transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      }
    }

    /* Enhanced hover effects for timeline nodes */
    .group:hover {
      box-shadow: 0 0 30px rgba(204, 153, 51, 0.3);
    }

    /* USRad era nodes */
    .border-[#003087].group:hover {
      box-shadow: 0 0 30px rgba(0, 48, 135, 0.3);
    }

    /* CSS filter for gold color #cc9933 */
    .filter-gold {
      filter: brightness(0) saturate(100%) invert(79%) sepia(50%)
        saturate(1500%) hue-rotate(359deg) brightness(1.1) contrast(0.9);
    }

    /* CSS filter for white color */
    .filter-white {
      filter: brightness(0) invert(1);
    }

    /* Mobile adjustments */
    @media (max-width: 768px) {
      .relative.flex.items-center {
        flex-direction: column !important;
      }

      .text-right {
        text-align: left !important;
      }

      .ml-auto {
        margin-left: 0 !important;
      }

      .pr-8,
      .pl-8 {
        padding: 0 !important;
      }
    }
  </style>

  <!-- NEW PREMIUM SAVINGS SECTION -->
  <section
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-white to-gray-50 overflow-hidden"
  >
    <div class="max-w-6xl mx-auto">
      <!-- Premium Header -->
      <div class="text-center mb-20" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 px-4 py-2 rounded-full text-sm font-medium mb-6"
        >
          <span class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></span>
          Our Proven Track Record
        </div>
        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 text-gray-900 leading-tight"
        >
          How We Saved<br />
          <span
            class="text-6xl md:text-7xl lg:text-8xl bg-gradient-to-r from-[#FFD700] via-[#FFA500] to-[#FF8C00] bg-clip-text text-transparent"
            >$246 Million</span
          >
        </h1>
        <p
          class="text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto leading-relaxed"
        >
          20 years ago, we revolutionized healthcare for 168,244 American
          workers. Here's exactly how we did it.
        </p>
      </div>

      <!-- Photo Grid Introduction -->
      <div class="grid md:grid-cols-3 gap-8 mb-24">
        <div
          class="relative rounded-2xl overflow-hidden shadow-2xl group"
          data-aos="fade-up"
        >
          <img
            src="/images/website/about_worker.webp"
            alt="Construction worker"
            class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
          >
            <div class="text-white">
              <h3 class="text-2xl font-bold mb-2">The Workers</h3>
              <p class="text-sm opacity-90">
                168,224 injured Americans waiting for care
              </p>
            </div>
          </div>
        </div>

        <div
          class="relative rounded-2xl overflow-hidden shadow-2xl group"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <img
            src="/images/website/about_solution.webp"
            alt="MRI machine"
            class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
          >
            <div class="text-white">
              <h3 class="text-2xl font-bold mb-2">The Solution</h3>
              <p class="text-sm opacity-90">
                Direct access to quality imaging centers
              </p>
            </div>
          </div>
        </div>

        <div
          class="relative rounded-2xl overflow-hidden shadow-2xl group"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <img
            src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=800&q=90"
            alt="Happy professional"
            class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
          >
            <div class="text-white">
              <h3 class="text-2xl font-bold mb-2">The Impact</h3>
              <p class="text-sm opacity-90">Lives changed, families saved</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Timeline with Photos -->
      <div class="space-y-32">
        <!-- The Problem -->
        <div class="grid md:grid-cols-2 gap-12 items-center" data-aos="fade-up">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl">
            <img
              src="/images/website/about_waiting.webp"
              alt="Worker in pain waiting for care"
              class="w-full h-96 object-cover"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
            >
            </div>
          </div>
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span
                class="inline-block bg-red-100 text-red-800 text-sm font-semibold px-3 py-1 rounded-full tracking-wide shadow-sm"
                >Pre-AnciCare</span
              >
              <div
                class="inline-block bg-red-100 text-red-700 px-4 py-2 rounded-full text-sm font-medium"
              >
                The Old Way
              </div>
            </div>

            <h2 class="text-4xl font-bold text-gray-900 mb-6">
              14 Days of Waiting
            </h2>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <img
                    src="/images/icons/wait.svg"
                    alt="Long wait times"
                    class="w-8 h-8"
                  />
                </div>
                <div>
                  <p class="font-semibold text-lg text-gray-900">
                    Pain without answers
                  </p>
                  <p class="text-gray-600">
                    Workers suffered while insurance processed paperwork
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <img
                    src="/images/icons/medicalbill.svg"
                    alt="Expensive medical bills"
                    class="w-8 h-8"
                  />
                </div>
                <div>
                  <p class="font-semibold text-lg text-gray-900">
                    $3,200 for a plain MRI
                  </p>
                  <p class="text-gray-600">
                    Forcing people to delay or skip care entirely
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Our Solution -->
        <div class="grid md:grid-cols-2 gap-12 items-center" data-aos="fade-up">
          <div class="order-2 md:order-1">
            <div class="flex items-center gap-2 mb-2">
              <span
                class="inline-block bg-green-100 text-green-800 text-sm font-semibold px-3 py-1 rounded-full tracking-wide shadow-sm"
                >Our Revolution</span
              >
              <span
                class="inline-block bg-[#fefbf5] text-[#cc9933] border border-[#cc9933] text-sm font-semibold px-3 py-1 rounded-full tracking-wide shadow-sm"
                >AnciCare</span
              >
            </div>

            <h2 class="text-4xl font-bold text-gray-900 mb-6">
              2 Days to Answers
            </h2>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <img
                    src="/images/icons/cellcalendar.svg"
                    alt="Quick scheduling"
                    class="w-8 h-8"
                  />
                </div>
                <div>
                  <p class="font-semibold text-lg text-gray-900">
                    Same-week imaging
                  </p>
                  <p class="text-gray-600">
                    Direct contracts cut through red tape
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <img
                    src="/images/icons/protection.svg"
                    alt="Transparent pricing"
