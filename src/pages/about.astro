<script>
  // ✅ Analytics — trust_content_view
  // Fires when patient scrolls into view of key trust sections on About page
  // Uses IntersectionObserver — fires once per section per page load
  // See /docs/analytics/analytics-event-contract.md

  const trustSections = [
    { id: "founders-photo", section: "founder_photo" },
    { id: "timeline", section: "timeline" },
  ];

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const match = trustSections.find((s) => s.id === entry.target.id);
          if (match) {
            try {
              const g = (window as any).gtag;
              if (typeof g === "function") {
                g("event", "trust_content_view", {
                  app_surface: "marketing",
                  section: match.section,
                });
              }
            } catch (_) {
              // Never block UX
            }
            observer.unobserve(entry.target); // Fire once per section
          }
        }
      });
    },
    { threshold: 0.4 },
  );

  document.addEventListener("DOMContentLoaded", () => {
    trustSections.forEach(({ id }) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  });
</script>
