---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import ProofMetricsSection from "../components/ProofMetricsSection.astro";
import InnovationTimeline from "../components/InnovationTimeline.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
const showPatientHeader = true;
---

<MainPatientLayout>
  <AOSInit />

  <!-- HERO SECTION - CREDIBILITY FIRST -->
  <section
    class="bg-gradient-to-br from-[#f8f2e1] to-[#fcf9f0] text-[#003087] py-16 md:py-24 lg:py-32 px-4 md:px-6"
  >
    <div class="max-w-6xl mx-auto">
      <!-- CREDIBILITY BANNER -->
      <div class="text-center mb-8" data-aos="fade-up">
        <div
          class="inline-flex items-center gap-2 bg-[#cc9933] text-white px-6 py-3 rounded-full text-sm font-bold mb-6"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          PROVEN HEALTHCARE INNOVATORS
        </div>
      </div>

      <div class="text-center mb-16">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-semibold leading-tight mb-6 md:mb-8 text-[#003087] font-manrope"
          data-aos="fade-up"
          data-aos-duration="800"
        >
          $400 Million+ in Proven Savings
        </h1>
        <p
          class="text-base sm:text-lg md:text-xl text-[#003087] max-w-4xl mx-auto leading-relaxed font-manrope"
          data-aos="fade-up"
          data-aos-duration="800"
          data-aos-delay="100"
        >
          The team behind USRad previously built AnciCare (1994-2002), America's
          first managed care imaging network, serving <strong
            >400,000+ patients</strong
          > and delivering
          <strong>$400 Million+ in total savings</strong> before being acquired by
          CorVel Corporation (NYSE: CVL).
        </p>
      </div>

      <!-- PROOF METRICS - ENHANCED -->
      <ProofMetricsSection
        metrics={[
          {
            value: "$400M+",
            label: "Total Savings Delivered",
            caption: "Medical + Productivity",
          },
          {
            value: "400,000+",
            label: "Patients Served",
            caption: "Proven Track Record",
          },
          { value: "8", label: "Years Building", caption: "1994-2002" },
          {
            value: "✓",
            label: "Successful Exit",
            caption: "NYSE-listed acquisition",
          },
        ]}
      />
    </div>
  </section>

  <!-- INNOVATION STORY - DETAILED -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          The Innovation Story: From AnciCare to USRad
        </h2>
        <p
          class="text-lg text-[#003087]/80 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          How we built AnciCare into a revolutionary healthcare company and are
          now expanding that proven model to serve 90 million Americans
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
        <!-- LEFT: Success Timeline -->
        <div data-aos="fade-right">
          <InnovationTimeline
            steps={[
              {
                number: "1",
                title: "Created AnciCare (1994)",
                description:
                  "Founded AnciCare as the first comprehensive managed care imaging network when traditional healthcare couldn't solve the cost and access crisis.",
              },
              {
                number: "2",
                title: "Revolutionary Results",
                description:
                  "Achieved 50%+ cost savings while reducing wait times from 10-14 days to 2-3 days—transforming the patient experience.",
              },
              {
                number: "3",
                title: "Massive Scale Impact",
                description:
                  "Delivered $200 Million+ in direct medical savings and $200 Million+ in productivity savings through faster return-to-work.",
              },
              {
                number: "4",
                title: "CorVel Acquisition (2002)",
                description:
                  "CorVel Corporation (NYSE: CVL) acquired AnciCare, validating our model at enterprise scale. They continue operating it successfully over 20 years later.",
              },
            ]}
          />
        </div>

        <!-- RIGHT: Impact Visualization -->
        <div data-aos="fade-left">
          <div
            class="bg-gradient-to-br from-[#f8f2e1] to-[#fcf9f0] rounded-3xl p-8 shadow-xl"
          >
            <h3 class="text-2xl font-bold text-[#003087] mb-6 text-center">
              Total Impact Delivered
            </h3>

            <!-- Savings Breakdown -->
            <div class="space-y-6">
              <div class="bg-white rounded-xl p-6 shadow-md">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-[#003087] font-medium"
                    >Medical Imaging Savings</span
                  >
                  <span class="text-2xl font-bold text-[#cc9933]"
                    >$200 Million+</span
                  >
                </div>
                <div class="w-full bg-gray-200 rounded-full h-3">
                  <div class="bg-[#cc9933] h-3 rounded-full" style="width: 50%">
                  </div>
                </div>
              </div>

              <div class="bg-white rounded-xl p-6 shadow-md">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-[#003087] font-medium"
                    >Productivity Savings</span
                  >
                  <span class="text-2xl font-bold text-[#cc9933]"
                    >$200 Million+</span
                  >
                </div>
                <div class="w-full bg-gray-200 rounded-full h-3">
                  <div class="bg-[#cc9933] h-3 rounded-full" style="width: 50%">
                  </div>
                </div>
              </div>

              <div
                class="bg-white rounded-xl p-6 shadow-md border-2 border-[#cc9933]"
              >
                <div class="flex justify-between items-center mb-2">
                  <span class="text-[#003087] font-bold"
                    >Total Value Created</span
                  >
                  <span class="text-3xl font-bold text-[#cc9933]"
                    >$400 Million+</span
                  >
                </div>
                <div class="w-full bg-gray-200 rounded-full h-4">
                  <div
                    class="bg-gradient-to-r from-[#cc9933] to-[#e6c378] h-4 rounded-full"
                    style="width: 100%"
                  >
                  </div>
                </div>
              </div>
            </div>

            <!-- Key Benefits -->
            <div class="mt-8 grid grid-cols-2 gap-4">
              <div class="text-center">
                <div class="text-2xl font-bold text-[#003087]">2-3 Days</div>
                <div class="text-sm text-[#003087]/70">Avg. Wait Time</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-[#003087]">50%+</div>
                <div class="text-sm text-[#003087]/70">Cost Savings</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-[#003087]">100%</div>
                <div class="text-sm text-[#003087]/70">Quality Guarantee</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-[#003087]">1,200+</div>
                <div class="text-sm text-[#003087]/70">Network Centers</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- BUSINESS TRANSFORMATION STORY -->
      <div
        class="bg-[#f0f4f9] rounded-3xl p-8 md:p-12 shadow-xl"
        data-aos="fade-up"
      >
        <h3
          class="text-2xl md:text-3xl font-bold text-[#003087] mb-6 text-center"
        >
          How We Transformed Healthcare Efficiency
        </h3>
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <h4 class="text-xl font-bold text-[#003087] mb-4">
              The Problem We Solved
            </h4>
            <div class="space-y-3 text-[#003087]/90">
              <p>
                • <strong>10-14 day wait times</strong> for MRI appointments
              </p>
              <p>
                • <strong>$1,000+ fees</strong> for basic imaging
              </p>
              <p>
                • <strong>Complex referral processes</strong> creating delays
              </p>
              <p>• <strong>Inconsistent quality</strong> across providers</p>
              <p>• <strong>Hidden costs</strong> and surprise billing</p>
            </div>
          </div>
          <div>
            <h4 class="text-xl font-bold text-[#003087] mb-4">
              Our Proven Solution
            </h4>
            <div class="space-y-3 text-[#003087]/90">
              <p>• <strong>2-3 day appointments</strong> (often next-day)</p>
              <p>
                • <strong>50%+ cost reductions</strong> with transparent pricing
              </p>
              <p>
                • <strong>Streamlined coordination</strong> and case management
              </p>
              <p>• <strong>Quality guarantee</strong> at top-tier facilities</p>
              <p>• <strong>All-inclusive pricing</strong> with no surprises</p>
            </div>
          </div>
        </div>

        <div class="mt-8 text-center">
          <div
            class="inline-flex items-center gap-2 bg-[#cc9933] text-white px-6 py-3 rounded-full text-sm font-bold"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            RESULT: $400M+ in proven savings across 400,000+ patients
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOUNDERS SECTION - BALANCED CREDIBILITY -->
  <section class="py-20 px-6 bg-gradient-to-br from-[#f8f2e1] to-[#fcf9f0]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          Meet the Healthcare Innovators
        </h2>
        <p
          class="text-lg text-[#003087]/80 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          The visionary team that revolutionized medical imaging access and
          delivered $400 Million+ in healthcare savings
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-16">
        <!-- Michael's Enhanced Profile -->
        <div
          class="bg-white rounded-3xl p-8 shadow-xl"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div class="text-center mb-6">
            <img
              src="/images/michael.jpg"
              alt="Michael Cabrera, Co-Founder & CEO"
              class="w-48 h-48 object-cover rounded-full mx-auto shadow-xl mb-6"
            />
            <h3 class="text-2xl md:text-3xl font-bold text-[#003087] mb-2">
              Michael Cabrera
            </h3>
            <p class="text-lg text-[#cc9933] font-bold mb-4">
              Co-Founder & CEO
            </p>

            <!-- Credibility Highlights -->
            <div class="grid grid-cols-2 gap-4 mb-6">
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <div class="text-2xl font-bold text-[#cc9933]">1,236%</div>
                <div class="text-sm text-[#003087]">Growth Achieved</div>
              </div>
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <div class="text-2xl font-bold text-[#cc9933]">
                  $400 Million+
                </div>
                <div class="text-sm text-[#003087]">Value Created</div>
              </div>
            </div>
          </div>

          <div class="space-y-4 text-[#003087]/90">
            <p>
              <strong>Healthcare Transformation Leader:</strong> Michael co-founded
              and led AnciCare to 1,236% growth, serving 400,000+ patients and delivering
              unprecedented healthcare savings before its successful acquisition.
            </p>
            <p>
              <strong>Proven Scale Builder:</strong> Successfully grew AnciCare from
              startup to enterprise scale, culminating in acquisition by CorVel Corporation—validating
              the model's effectiveness at the highest level.
            </p>
            <p>
              <strong>Elite Recognition:</strong> Graduate of the prestigious "Birthing
              of Giants" program, co-created by MIT, Inc. Magazine, and Entrepreneurs'
              Organization.
            </p>
          </div>

          <div class="mt-8 text-center">
            <a
              href="/founder"
              class="inline-block px-8 py-4 bg-[#003087] text-white rounded-full font-bold hover:bg-[#002266] transition-colors border-l-4 border-[#cc9933]"
            >
              Read Michael's Full Story →
            </a>
          </div>
        </div>

        <!-- Donna's Enhanced Profile -->
        <div
          class="bg-white rounded-3xl p-8 shadow-xl"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div class="text-center mb-6">
            <img
              src="/images/donna.webp"
              alt="Donna Cabrera, Co-Founder & Patient Advocacy Advisor"
              class="w-48 h-48 object-cover rounded-full mx-auto shadow-xl mb-6"
            />
            <h3 class="text-2xl md:text-3xl font-bold text-[#003087] mb-2">
              Donna Cabrera
            </h3>
            <p class="text-lg text-[#cc9933] font-bold mb-4">
              Co-Founder & Patient Advocacy Advisor
            </p>

            <!-- Credibility Highlights -->
            <div class="grid grid-cols-2 gap-4 mb-6">
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <div class="text-2xl font-bold text-[#cc9933]">400,000+</div>
                <div class="text-sm text-[#003087]">Patients Served</div>
              </div>
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <div class="text-2xl font-bold text-[#cc9933]">99.8%</div>
                <div class="text-sm text-[#003087]">Satisfaction Rate</div>
              </div>
            </div>
          </div>

          <div class="space-y-4 text-[#003087]/90">
            <p>
              <strong>Patient Care Pioneer:</strong> Donna co-founded AnciCare and
              created the gold standard for patient experience in medical imaging,
              ensuring dignity and care quality for every patient interaction.
            </p>
            <p>
              <strong>Operations Excellence:</strong> Built and managed the compliance
              and service delivery framework that consistently delivered exceptional
              care across 1,200+ imaging centers nationwide.
            </p>
            <p>
              <strong>Patient-First Philosophy:</strong> Developed the patient advocacy
              approach that reduced anxiety, improved outcomes, and earned the trust
              that drove sustained growth and client retention.
            </p>
          </div>

          <div class="mt-8 text-center">
            <a
              href="/co-founder"
              class="inline-block px-8 py-4 bg-[#003087] text-white rounded-full font-bold hover:bg-[#002266] transition-colors border-l-4 border-[#cc9933]"
            >
              Learn About Donna's Role →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VISION & VALUES - BALANCED MESSAGING -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          Our Vision & Values
          <span class="text-lg font-normal text-[#003087]/70 block mt-2">
            Built on decades of proven healthcare innovation
          </span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-16">
        <!-- Vision Column -->
        <div class="space-y-8" data-aos="fade-right">
          <h3 class="text-2xl md:text-3xl font-bold text-[#003087] mb-6">
            Expanding Proven Innovation
          </h3>

          <div class="bg-[#f0f4f9] rounded-2xl p-6">
            <p class="text-lg leading-relaxed text-[#003087]">
              We're not experimenting—we're <strong
                >expanding proven success</strong
              >. After building AnciCare into a model so effective that CorVel
              Corporation acquired and continues operating it, we're now
              bringing the same innovation to serve the 90 million uninsured and
              underinsured Americans who deserve affordable, quality healthcare.
            </p>
          </div>

          <div class="space-y-6">
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0 mt-1"
              >
                ✓
              </div>
              <div>
                <h4 class="font-bold text-[#003087] mb-1">Validated Model</h4>
                <p class="text-[#003087]/80">
                  AnciCare's acquisition by CorVel proved the model works
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0 mt-1"
              >
                ✓
              </div>
              <div>
                <h4 class="font-bold text-[#003087] mb-1">Massive Impact</h4>
                <p class="text-[#003087]/80">
                  From 400,000 patients to 90 million Americans who need access
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="bg-[#cc9933] text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm mr-4 flex-shrink-0 mt-1"
              >
                ✓
              </div>
              <div>
                <h4 class="font-bold text-[#003087] mb-1">Proven Results</h4>
                <p class="text-[#003087]/80">
                  $400 Million+ in delivered savings proves our approach works
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Values Column -->
        <div class="space-y-8" data-aos="fade-left">
          <h3 class="text-2xl md:text-3xl font-bold text-[#003087] mb-6">
            Values That Deliver Results
          </h3>

          <div class="space-y-6">
            <div
              class="bg-white border-2 border-[#e6c378] rounded-xl p-6 hover:shadow-lg transition-shadow"
            >
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center text-white text-xl font-bold mr-4"
                >
                  T
                </div>
                <div>
                  <h4 class="text-xl font-bold text-[#003087]">Transparency</h4>
                  <p class="text-sm text-[#cc9933] font-medium">
                    Proven through 400,000+ interactions
                  </p>
                </div>
              </div>
              <p class="text-[#003087]/90">
                We pioneered transparent pricing with AnciCare. Our
                all-inclusive model eliminated surprise billing and became the
                industry standard that others still follow today.
              </p>
            </div>

            <div
              class="bg-white border-2 border-[#e6c378] rounded-xl p-6 hover:shadow-lg transition-shadow"
            >
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center text-white text-xl font-bold mr-4"
                >
                  A
                </div>
                <div>
                  <h4 class="text-xl font-bold text-[#003087]">
                    Accessibility
                  </h4>
                  <p class="text-sm text-[#cc9933] font-medium">
                    $400 Million+ in savings delivered
                  </p>
                </div>
              </div>
              <p class="text-[#003087]/90">
                We proved with AnciCare that premium imaging can be affordable.
                Our managed care model delivered 50%+ savings while maintaining
                the highest quality standards—a formula still in use today.
              </p>
            </div>

            <div
              class="bg-white border-2 border-[#e6c378] rounded-xl p-6 hover:shadow-lg transition-shadow"
            >
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center text-white text-xl font-bold mr-4"
                >
                  Q
                </div>
                <div>
                  <h4 class="text-xl font-bold text-[#003087]">Quality</h4>
                  <p class="text-sm text-[#cc9933] font-medium">
                    100% quality guarantee
                  </p>
                </div>
              </div>
              <p class="text-[#003087]/90">
                AnciCare was first to offer a quality guarantee in medical
                imaging. Our network maintained consistent excellence that
                earned Fortune 500 trust and ultimately led to our acquisition.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Vision Quote - Enhanced -->
      <div class="mt-16 text-center" data-aos="fade-up">
        <div
          class="bg-gradient-to-r from-[#f8f2e1] to-[#fcf9f0] rounded-3xl p-8 md:p-12 shadow-xl"
        >
          <div class="max-w-4xl mx-auto">
            <div class="text-6xl text-[#cc9933] opacity-30 mb-4">"</div>
            <p
              class="text-xl md:text-2xl italic text-[#003087] leading-relaxed mb-6"
            >
              We're not just improving medical imaging—we're taking the AnciCare
              model that transformed healthcare for 400,000+ patients and
              expanding it to reach 90 million Americans who deserve the same
              proven results.
            </p>
            <div
              class="flex items-center justify-center gap-8 text-sm text-[#003087]/70"
            >
              <span>✓ Proven by 400,000+ patients</span>
              <span>✓ Validated by successful exit</span>
              <span>✓ Ready for national scale</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CALL TO ACTION - CREDIBILITY FOCUSED -->
  <section
    class="py-20 px-6 bg-gradient-to-br from-[#003087] to-[#002266] text-white"
  >
    <div class="max-w-4xl mx-auto text-center">
      <div
        class="bg-white/10 backdrop-blur-md rounded-full px-6 py-2 border border-white/20 inline-block mb-6"
      >
        <span class="text-[#cc9933] font-bold text-sm">✓ PROVEN SUCCESS</span>
        <span class="text-white text-sm ml-2"
          >$400 Million+ saved • 400,000+ patients served</span
        >
      </div>

      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Experience Proven Healthcare Innovation
      </h2>
      <p class="text-lg md:text-xl mb-8 opacity-90">
        Join hundreds of thousands who've already experienced our proven
        approach. Same innovation, expanded access, guaranteed results.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/search-test"
          class="bg-[#cc9933] hover:bg-[#b8851f] text-white px-8 py-4 rounded-xl font-bold transition-colors"
        >
          Book Your MRI Now
        </a>
        <a
          href="/how-it-works"
          class="border-2 border-white text-white hover:bg-white hover:text-[#003087] px-8 py-4 rounded-xl font-bold transition-colors"
        >
          See How It Works
        </a>
      </div>
    </div>
  </section>

  <ChatbotToggle chatbotLabel="💬 Let's Talk" />
</MainPatientLayout>
