---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout title="Accessibility Statement - USRad" isHeroPage={false}>
  <AOSInit />

  <!-- Clean Hero Section -->
  <section
    class="relative bg-gradient-to-b from-blue-50 to-white py-24 overflow-hidden"
  >
    <!-- Geometric circles pattern -->
    <div class="absolute inset-0 overflow-hidden">
      <div
        class="absolute -top-40 -right-40 w-80 h-80 rounded-full bg-blue-100 opacity-20"
      >
      </div>
      <div
        class="absolute -bottom-40 -left-40 w-80 h-80 rounded-full bg-blue-100 opacity-20"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-blue-50 opacity-30"
      >
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl" data-aos="fade-up">
        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 mb-6"
        >
          Accessibility Statement
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 mb-8">
          USRad is committed to ensuring digital accessibility for everyone,
          including people with disabilities.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Last Updated -->
      <div class="text-center mb-16" data-aos="fade-up">
        <p class="text-gray-600">Effective Date</p>
        <p class="text-2xl font-bold text-gray-900">October 1, 2025</p>
        <p class="text-sm text-gray-500 mt-1">Last Updated: April 11, 2026</p>
      </div>

      <!-- Our Commitment -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Our Commitment</h2>
        <div class="prose prose-lg max-w-none text-gray-700">
          <p class="text-xl leading-relaxed mb-6">
            USRad is committed to ensuring our website and services are
            accessible to all users, including people with disabilities. We
            believe everyone deserves equal access to affordable medical imaging
            services.
          </p>
          <p class="leading-relaxed">
            We view accessibility not just as a legal requirement, but as a
            fundamental aspect of providing quality healthcare services to our
            community.
          </p>
        </div>
      </div>

      <!-- Accessibility Standards -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">
          Standards We Follow
        </h2>
        <p class="text-gray-700 mb-8">
          We strive to meet Web Content Accessibility Guidelines (WCAG) 2.1
          Level AA standards. This helps make our content accessible to people
          with:
        </p>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-gray-50 rounded-xl p-8">
            <h3 class="font-semibold text-gray-900 mb-4">
              Sensory Disabilities
            </h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start gap-3">
                <div
                  class="w-1 h-6 bg-[#003087] rounded-full flex-shrink-0 mt-0.5"
                >
                </div>
                <span
                  >Visual impairments (blindness, low vision, color blindness)</span
                >
              </li>
              <li class="flex items-start gap-3">
                <div
                  class="w-1 h-6 bg-[#003087] rounded-full flex-shrink-0 mt-0.5"
                >
                </div>
                <span>Hearing impairments (deafness, hearing loss)</span>
              </li>
            </ul>
          </div>

          <div class="bg-gray-50 rounded-xl p-8">
            <h3 class="font-semibold text-gray-900 mb-4">
              Physical & Cognitive
            </h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start gap-3">
                <div
                  class="w-1 h-6 bg-[#003087] rounded-full flex-shrink-0 mt-0.5"
                >
                </div>
                <span>Motor impairments (limited fine motor control)</span>
              </li>
              <li class="flex items-start gap-3">
                <div
                  class="w-1 h-6 bg-[#003087] rounded-full flex-shrink-0 mt-0.5"
                >
                </div>
                <span
                  >Cognitive disabilities (learning disabilities, attention
                  deficits)</span
                >
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Key Features -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">
          Accessibility Features
        </h2>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Navigation -->
          <div>
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              Navigation & Structure
            </h3>
            <ul class="space-y-4 text-gray-700">
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Clear, consistent navigation throughout the site</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Descriptive page titles and headings</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Skip-to-content links for keyboard users</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Logical content structure and reading order</span>
              </li>
            </ul>
          </div>

          <!-- Visual Design -->
          <div>
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              Visual Design
            </h3>
            <ul class="space-y-4 text-gray-700">
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>High contrast color combinations</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Text resizable up to 200% without breaking</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>No flashing or distracting animations</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Color not sole indicator of information</span>
              </li>
            </ul>
          </div>

          <!-- Interactive Elements -->
          <div>
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              Forms & Interaction
            </h3>
            <ul class="space-y-4 text-gray-700">
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Clear labels for all form fields</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Helpful error messages with solutions</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Full keyboard navigation support</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Focus indicators for all interactive elements</span>
              </li>
            </ul>
          </div>

          <!-- Media -->
          <div>
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              Images & Media
            </h3>
            <ul class="space-y-4 text-gray-700">
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Alternative text for all images</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Captions for video content</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Descriptive text for complex graphics</span>
              </li>
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-[#003087] flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Transcripts for audio content</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Need Help Section -->
      <div class="mb-20" data-aos="fade-up">
        <div class="bg-[#003087] text-white rounded-xl p-8">
          <h2 class="text-3xl font-bold mb-6">Need Accessibility Help?</h2>
          <p class="text-white/90 mb-8">
            We welcome your feedback. If you encounter any barriers or have
            suggestions for improvement, please let us know.
          </p>

          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h3 class="text-xl font-semibold mb-4">Contact Us</h3>
              <div class="space-y-3">
                <a
                  href="mailto:support@usrad.com"
                  class="flex items-center gap-3 text-[#cc9933] hover:text-[#e6b347] transition"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    ></path>
                  </svg>
                  support@usrad.com
                </a>
                <a
                  href="tel:1-866-877-2324"
                  class="flex items-center gap-3 text-[#cc9933] hover:text-[#e6b347] transition"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    ></path>
                  </svg>
                  1-866-USRad-24
                </a>
              </div>
            </div>

            <div>
              <h3 class="text-xl font-semibold mb-4">When Contacting Us</h3>
              <p class="text-white/80 text-sm">Please include:</p>
              <ul class="space-y-2 text-white/80 text-sm mt-3">
                <li>• The page or feature you had trouble with</li>
                <li>• Any assistive technology you were using</li>
                <li>• A description of the issue</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Alternative Access -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">
          Alternative Access
        </h2>
        <p class="text-gray-700 text-lg">
          If you can't access any content or feature due to a disability, we'll
          provide the information in an alternative format. Contact us using the
          information above, and we'll work with you to find a solution.
        </p>
      </div>

      <!-- Legal Compliance -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Legal Compliance</h2>
        <p class="text-gray-700 mb-6">
          This statement applies to usrad.com and reflects our commitment to:
        </p>

        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <div class="w-1 h-6 bg-[#003087] rounded-full flex-shrink-0 mt-0.5">
            </div>
            <span class="text-gray-700"
              >Americans with Disabilities Act (ADA)</span
            >
          </div>
          <div class="flex items-start gap-3">
            <div class="w-1 h-6 bg-[#003087] rounded-full flex-shrink-0 mt-0.5">
            </div>
            <span class="text-gray-700"
              >Section 508 of the Rehabilitation Act</span
            >
          </div>
          <div class="flex items-start gap-3">
            <div class="w-1 h-6 bg-[#003087] rounded-full flex-shrink-0 mt-0.5">
            </div>
            <span class="text-gray-700"
              >Web Content Accessibility Guidelines (WCAG) 2.1 Level AA</span
            >
          </div>
        </div>
      </div>

      <!-- Review Schedule -->
      <div class="text-center p-8 bg-gray-50 rounded-xl" data-aos="fade-up">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Regular Reviews</h2>
        <p class="text-gray-600">
          We review this statement annually and whenever we make significant
          changes to our website. Our commitment to accessibility is ongoing.
        </p>
      </div>
    </div>
  </section>

  <!-- Simple CTA -->
  <section class="py-16 px-4 sm:px-6 bg-gradient-to-br from-gray-50 to-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        Everyone Deserves Access to Affordable Imaging
      </h2>
      <p class="text-xl text-gray-600 mb-8">
        Let us help you find the care you need.
      </p>
      <a
        href="/search-results"
        class="bg-[#003087] hover:bg-[#002266] text-white px-8 py-3 rounded-lg font-medium transition inline-block"
      >
        Find Imaging Centers
      </a>
    </div>
  </section>

  <style>
    /* Clean, minimal styles */
    ul {
      list-style: none;
      padding: 0;
    }
  </style>
</CarbonLayout>
