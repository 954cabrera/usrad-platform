---
// src/pages/admin/medicare-dashboard-rest.astro

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>USRad Medicare Pricing Engine - REST API</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        color: #333;
      }

      .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
      }

      .header {
        text-align: center;
        color: white;
        margin-bottom: 30px;
      }

      .header h1 {
        font-size: 2.5rem;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
      }

      .connection-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        margin-top: 10px;
      }

      .connected {
        background: rgba(34, 197, 94, 0.2);
        color: #16a34a;
        border: 1px solid rgba(34, 197, 94, 0.3);
      }

      .error {
        background: rgba(239, 68, 68, 0.2);
        color: #dc2626;
        border: 1px solid rgba(239, 68, 68, 0.3);
      }

      .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
      }

      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
      }

      .metric-card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
        position: relative;
      }

      .metric-card:hover {
        transform: translateY(-5px);
      }

      .metric-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #667eea, #764ba2);
      }

      .metric-value {
        font-size: 2.5rem;
        font-weight: bold;
        color: #667eea;
        margin-bottom: 5px;
      }

      .metric-label {
        font-size: 1.1rem;
        color: #666;
        margin-bottom: 10px;
      }

      .pricing-section {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
      }

      .tabs {
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        position: relative;
        z-index: 1;
      }

      .tab-buttons {
        display: flex;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
      }

      .tab-button {
        flex: 1;
        padding: 15px 20px;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 500;
        color: #64748b;
        transition: all 0.3s ease;
        position: relative;
      }

      .tab-button.active {
        color: #667eea;
        background: white;
      }

      .tab-button.active::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #667eea, #764ba2);
      }

      .tab-content {
        padding: 30px;
        min-height: 300px;
        max-height: 600px;
        overflow-y: auto;
        background: white;
      }

      .tab-pane {
        display: none;
      }

      .tab-pane.active {
        display: block;
      }

      .procedure-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 15px;
        max-height: 500px;
        overflow-y: auto;
        padding-right: 10px;
      }

      .procedure-item {
        background: #f8fafc;
        border-radius: 8px;
        padding: 15px;
        border-left: 4px solid #667eea;
      }

      .procedure-code {
        font-weight: bold;
        color: #667eea;
        margin-bottom: 5px;
      }

      .procedure-desc {
        color: #666;
        font-size: 0.9rem;
      }

      .coverage-notice {
        background: #fff3cd;
        border: 1px solid #ffeaa7;
        border-radius: 8px;
        padding: 15px;
        margin: 15px 0;
        color: #856404;
      }

      .coverage-notice strong {
        color: #dc2626;
      }

      .pricing-form {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 20px;
        align-items: end;
        margin-bottom: 20px;
      }

      .input-group {
        display: flex;
        flex-direction: column;
      }

      .input-group label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
      }

      .input-group input,
      .input-group select {
        padding: 12px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.3s ease;
      }

      .input-group input:focus,
      .input-group select:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
      }

      .calculate-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s ease;
        height: fit-content;
      }

      .calculate-btn:hover:not(:disabled) {
        transform: translateY(-2px);
      }

      .calculate-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .results-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-top: 20px;
      }

      .result-card {
        background: #f8fafc;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
      }

      .result-value {
        font-size: 1.8rem;
        font-weight: bold;
        margin-bottom: 5px;
      }

      .result-value.medicare {
        color: #3b82f6;
      }
      .result-value.usrad {
        color: #10b981;
      }
      .result-value.hospital {
        color: #ef4444;
      }
      .result-value.savings {
        color: #8b5cf6;
      }

      .result-label {
        font-size: 0.9rem;
        color: #666;
      }

      @media (max-width: 768px) {
        .pricing-form {
          grid-template-columns: 1fr;
        }

        .results-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
    </style>
  </head>

  <body>
    <div class="dashboard-container">
      <div class="header">
        <h1>🏥 USRad Medicare Pricing Engine</h1>
        <p>Direct REST API integration - Production Ready</p>
        <div id="connectionStatus" class="connection-status">
          <div class="status-dot"></div>
          <span>Initializing...</span>
        </div>
      </div>

      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-value" id="procedureCount">Loading...</div>
          <div class="metric-label">Available Procedures</div>
          <div class="metric-description">CPT codes with complete RVU data</div>
        </div>

        <div class="metric-card">
          <div class="metric-value" id="localityCount">Loading...</div>
          <div class="metric-label">Geographic Localities</div>
          <div class="metric-description">Medicare pricing regions covered</div>
        </div>

        <div class="metric-card">
          <div class="metric-value">$0</div>
          <div class="metric-label">Third-Party APIs</div>
          <div class="metric-description">Zero subscription costs</div>
        </div>

        <div class="metric-card">
          <div class="metric-value">$50K+</div>
          <div class="metric-label">Annual Savings</div>
          <div class="metric-description">vs healthcare data subscriptions</div>
        </div>
      </div>

      <div class="pricing-section">
        <h2>Real-Time Medicare Pricing Calculator</h2>
        <p style="margin-bottom: 20px; color: #666;">
          Calculate accurate Medicare rates using direct REST API integration
        </p>

        <div class="pricing-form">
          <div class="input-group">
            <label for="zipCode">Patient ZIP Code</label>
            <input
              type="text"
              id="zipCode"
              placeholder="e.g., 33330"
              maxlength="5"
            />
          </div>

          <div class="input-group">
            <label for="procedure">Imaging Procedure</label>
            <select id="procedure">
              <option value="">Loading procedures...</option>
            </select>
          </div>

          <button
            class="calculate-btn"
            onclick="calculatePricing()"
            id="calculateBtn"
          >
            Calculate Rate
          </button>
        </div>

        <div id="results" class="results-grid" style="display: none;">
          <div class="result-card">
            <div class="result-value medicare" id="medicareRate">$0.00</div>
            <div class="result-label">Medicare Rate</div>
          </div>
          <div class="result-card">
            <div class="result-value usrad" id="usradPrice">$0.00</div>
            <div class="result-label">USRad Price (+$75)</div>
          </div>
          <div class="result-card">
            <div class="result-value hospital" id="hospitalPrice">$0.00</div>
            <div class="result-label">Hospital Estimate</div>
          </div>
          <div class="result-card">
            <div class="result-value savings" id="savings">$0.00</div>
            <div class="result-label">Patient Savings</div>
          </div>
        </div>

        <div
          id="responseTime"
          style="margin-top: 15px; font-size: 0.9rem; color: #666;"
        >
        </div>
      </div>

      <div class="tabs">
        <div class="tab-buttons">
          <button class="tab-button active" onclick="switchTab('procedures')"
            >📋 All Procedures</button
          >
          <button class="tab-button" onclick="switchTab('localities')"
            >🗺️ Geographic Coverage</button
          >
          <button class="tab-button" onclick="switchTab('insights')"
            >📊 System Insights</button
          >
        </div>

        <div class="tab-content">
          <div id="procedures" class="tab-pane active">
            <h3>Available Imaging Procedures</h3>
            <p style="margin-bottom: 20px; color: #666;">
              Complete list of procedures available in your Medicare database.
            </p>
            <div id="procedureList" class="procedure-grid">
              <div style="text-align: center; padding: 40px; color: #666;">
                Loading procedures...
              </div>
            </div>
          </div>

          <div id="localities" class="tab-pane">
            <h3>Geographic Coverage Analysis</h3>
            <p style="margin-bottom: 20px; color: #666;">
              Medicare localities and ZIP code mapping status:
            </p>
            <div id="localityList">
              <div style="text-align: center; padding: 40px; color: #666;">
                Loading coverage analysis...
              </div>
            </div>
          </div>

          <div id="insights" class="tab-pane">
            <h3>System Insights</h3>
            <div
              style="background: #f8fafc; border-radius: 12px; padding: 25px; margin-bottom: 20px;"
            >
              <h4 style="color: #667eea; margin-bottom: 15px;">
                🎯 Technical Architecture
              </h4>
              <ul style="line-height: 1.8; color: #555;">
                <li>
                  <strong>Direct REST API Integration:</strong> Bypasses client libraries
                  for maximum reliability
                </li>
                <li>
                  <strong>Real-time Database Queries:</strong> Live data from your
                  proprietary Medicare database
                </li>
                <li>
                  <strong>Geographic Precision:</strong> ZIP-code level pricing with
                  GPCI adjustments
                </li>
                <li>
                  <strong>Production Performance:</strong> Sub-500ms response times
                  for pricing calculations
                </li>
              </ul>
            </div>

            <div
              style="background: #f0fdf4; border-radius: 12px; padding: 25px; border: 1px solid #bbf7d0;"
            >
              <h4 style="color: #16a34a; margin-bottom: 15px;">
                💰 Business Impact
              </h4>
              <ul style="line-height: 1.8; color: #555;">
                <li>
                  <strong>$50,000+ Annual Savings:</strong> vs healthcare data subscription
                  services
                </li>
                <li>
                  <strong>Zero API Dependencies:</strong> Complete data ownership
                  and control
                </li>
                <li>
                  <strong>60-80% Patient Savings:</strong> vs typical hospital pricing
                </li>
                <li>
                  <strong>Real-time Pricing:</strong> Enables transparent, competitive
                  quotes
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
      // Helper function to get state from ZIP code
      function getStateFromZip(zipCode) {
        const zip = parseInt(zipCode);
        if (zip >= 90000 && zip <= 96199) return "CA";
        if (zip >= 30000 && zip <= 31999) return "GA";
        if (zip >= 32000 && zip <= 34999) return "FL";
        if (zip >= 10000 && zip <= 14999) return "NY";
        if (zip >= 77000 && zip <= 79999) return "TX";
        return null;
      }

      // Direct REST API helper
      async function supabaseAPI(endpoint, options = {}) {
        const url = `${SUPABASE_URL}/rest/v1/${endpoint}`;
        const headers = {
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
          "Content-Type": "application/json",
          ...options.headers,
        };

        const response = await fetch(url, {
          ...options,
          headers,
        });

        if (!response.ok) {
          throw new Error(
            `API Error: ${response.status} ${response.statusText}`
          );
        }

        return response.json();
      }

      // RPC function call
      async function supabaseRPC(functionName, params = {}) {
        const url = `${SUPABASE_URL}/rest/v1/rpc/${functionName}`;
        const response = await fetch(url, {
          method: "POST",
          headers: {
            apikey: SUPABASE_ANON_KEY,
            Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify(params),
        });

        if (!response.ok) {
          throw new Error(
            `RPC Error: ${response.status} ${response.statusText}`
          );
        }

        return response.json();
      }

      function updateStatus(type, message) {
        const status = document.getElementById("connectionStatus");
        status.className = `connection-status ${type}`;
        status.innerHTML = `<div class="status-dot"></div><span>${message}</span>`;
      }

      // Load dashboard metrics
      async function loadMetrics() {
        try {
          console.log("📊 Loading metrics via REST API...");

          // Get procedure count
          const procedures = await supabaseAPI(
            "cpt_rvus?select=cpt_code&year=eq.2025"
          );
          const procedureCount = procedures.length;

          document.getElementById("procedureCount").textContent =
            procedureCount.toLocaleString();
          console.log("✅ Procedure count loaded:", procedureCount);

          // Get locality count
          const localities = await supabaseAPI(
            "medicare_localities?select=locality_code"
          );
          const localityCount = localities.length;

          document.getElementById("localityCount").textContent =
            localityCount.toLocaleString();
          console.log("✅ Locality count loaded:", localityCount);
        } catch (error) {
          console.error("❌ Error loading metrics:", error);
          document.getElementById("procedureCount").textContent = "Error";
          document.getElementById("localityCount").textContent = "Error";
        }
      }

      // Load procedures for dropdown AND display tab
      async function loadProcedures() {
        try {
          console.log("🔍 Loading procedures via REST API...");

          // Get more procedures and include common MRI codes
          const data = await supabaseAPI(
            "cpt_rvus?select=cpt_code,description&year=eq.2025&modifier=eq.&status_code=eq.A&order=cpt_code&limit=200"
          );

          console.log("✅ Procedures loaded:", data.length);
          console.log("📋 Sample procedures:", data.slice(0, 5));

          // Check if we have the MRI procedures
          const mriProcedures = data.filter((p) =>
            p.description.toLowerCase().includes("mri")
          );
          console.log(
            "🧲 MRI procedures found:",
            mriProcedures.length,
            mriProcedures.slice(0, 3)
          );

          // Group procedures by modality for better organization
          const procedures = data.sort((a, b) => {
            // Prioritize common procedures
            const priority = {
              "72148": 1, // MRI Lumbar Spine
              "70551": 2, // MRI Brain
              "70552": 3, // MRI Brain w/ contrast
              "71550": 4, // MRI Chest
              "74177": 5, // CT Abdomen/Pelvis
              "71046": 6, // Chest X-ray
            };

            const aPriority = priority[a.cpt_code] || 999;
            const bPriority = priority[b.cpt_code] || 999;

            if (aPriority !== bPriority) return aPriority - bPriority;
            return a.cpt_code.localeCompare(b.cpt_code);
          });

          // Update dropdown
          const select = document.getElementById("procedure");
          select.innerHTML =
            '<option value="">Select a procedure...</option>' +
            procedures
              .map(
                (proc) =>
                  `<option value="${proc.cpt_code}">${proc.cpt_code} - ${proc.description}</option>`
              )
              .join("");

          // Update procedures tab
          const procedureList = document.getElementById("procedureList");
          if (procedureList) {
            procedureList.innerHTML = procedures
              .map(
                (proc) => `
                        <div class="procedure-item">
                            <div class="procedure-code">${proc.cpt_code}</div>
                            <div class="procedure-desc">${proc.description}</div>
                        </div>
                    `
              )
              .join("");
          }
        } catch (error) {
          console.error("❌ Error loading procedures:", error);
          document.getElementById("procedure").innerHTML =
            `<option value="">Error: ${error.message}</option>`;
        }
      }

      // Load localities for display AND check coverage
      async function loadLocalitiesTab() {
        try {
          console.log("🗺️ Loading localities for display...");

          const localities = await supabaseAPI(
            "medicare_localities?select=*&order=state,locality_name"
          );
          const zipMappings = await supabaseAPI(
            "zip_to_locality?select=zip_code,locality_code,state&limit=100"
          );

          console.log("📍 Total localities:", localities.length);
          console.log("📮 ZIP mappings sample:", zipMappings.slice(0, 10));

          // Group localities by state
          const stateGroups = {};
          localities.forEach((locality) => {
            if (!stateGroups[locality.state]) {
              stateGroups[locality.state] = [];
            }
            stateGroups[locality.state].push(locality);
          });

          // Group ZIP mappings by state
          const zipsByState = {};
          zipMappings.forEach((zip) => {
            if (!zipsByState[zip.state]) {
              zipsByState[zip.state] = [];
            }
            zipsByState[zip.state].push(zip.zip_code);
          });

          console.log(
            "🗺️ States with localities:",
            Object.keys(stateGroups).sort()
          );
          console.log(
            "📮 States with ZIP mappings:",
            Object.keys(zipsByState).sort()
          );

          const localityList = document.getElementById("localityList");
          if (localityList) {
            // Show coverage status
            const coverageStatus =
              Object.keys(stateGroups).length > 5
                ? `<div style="background: #d4fdf0; border: 1px solid #a7f3d0; border-radius: 8px; padding: 15px; margin-bottom: 20px; color: #065f46;">
                            <strong>✅ National Coverage:</strong> ${Object.keys(stateGroups).length} states with ${localities.length} Medicare localities available.
                            <br><strong>ZIP Mapping Status:</strong> ${zipMappings.length} ZIP codes currently mapped.
                        </div>`
                : `<div style="background: #fff3cd; border: 1px solid #ffeaa7; border-radius: 8px; padding: 15px; margin-bottom: 20px; color: #856404;">
                            <strong>⚠️ Limited Coverage:</strong> Only ${Object.keys(stateGroups).length} states currently loaded. 
                            Full national ZIP code mapping may need to be imported.
                        </div>`;

            localityList.innerHTML =
              coverageStatus +
              Object.entries(stateGroups)
                .map(
                  ([state, localities]) => `
                        <div style="margin-bottom: 30px;">
                            <h4 style="color: #667eea; margin-bottom: 15px; font-size: 1.2rem;">
                                ${state} (${localities.length} localities, ${zipsByState[state]?.length || 0} ZIP codes)
                            </h4>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 10px;">
                                ${localities
                                  .slice(0, 10)
                                  .map(
                                    (loc) => `
                                    <div style="background: #f8fafc; padding: 15px; border-radius: 8px; border-left: 4px solid #667eea;">
                                        <div style="font-weight: 600; color: #333;">${loc.locality_name}</div>
                                        <div style="font-size: 0.9rem; color: #666; font-family: monospace;">${loc.locality_code}</div>
                                    </div>
                                `
                                  )
                                  .join("")}
                                ${localities.length > 10 ? `<div style="color: #666; padding: 15px;">... and ${localities.length - 10} more</div>` : ""}
                            </div>
                        </div>
                    `
                )
                .join("");
          }
        } catch (error) {
          console.error("❌ Error loading localities:", error);
        }
      }

      // Tab switching
      function switchTab(tabName) {
        // Update tab buttons
        document
          .querySelectorAll(".tab-button")
          .forEach((btn) => btn.classList.remove("active"));
        event.target.classList.add("active");

        // Update tab content
        document
          .querySelectorAll(".tab-pane")
          .forEach((pane) => pane.classList.remove("active"));
        document.getElementById(tabName).classList.add("active");

        // Load localities data when tab is opened
        if (tabName === "localities") {
          loadLocalitiesTab();
        }
      }

      // Calculate Medicare pricing
      async function calculatePricing() {
        const zipCode = document.getElementById("zipCode").value.trim();
        const procedureCode = document.getElementById("procedure").value;
        const button = document.getElementById("calculateBtn");
        const results = document.getElementById("results");
        const responseTime = document.getElementById("responseTime");

        // Validation
        if (!zipCode || !/^\d{5}$/.test(zipCode)) {
          alert("Please enter a valid 5-digit ZIP code");
          return;
        }

        if (!procedureCode) {
          alert("Please select a procedure");
          return;
        }

        const startTime = Date.now();

        try {
          button.disabled = true;
          button.textContent = "Calculating...";
          results.style.display = "none";
          responseTime.textContent = "";

          console.log("🔍 Getting locality from ZIP:", zipCode);

          // Get locality from ZIP
          const zipData = await supabaseAPI(
            `zip_to_locality?select=locality_code,state&zip_code=eq.${zipCode}&limit=1`
          );

          if (!zipData || zipData.length === 0) {
            throw new Error(
              `ZIP code ${zipCode} not found in database. The ZIP-to-locality mapping may be incomplete. Check Geographic Coverage tab for current coverage status.`
            );
          }

          const localityCode = zipData[0].locality_code;
          console.log("✅ Found locality:", localityCode);

          // Calculate Medicare rate via RPC
          console.log("🔍 Calling Medicare rate function...");
          const pricingData = await supabaseRPC("calculate_medicare_rate", {
            p_cpt_code: procedureCode,
            p_locality_code: localityCode,
          });

          if (!pricingData || pricingData.length === 0) {
            throw new Error("No pricing data returned");
          }

          const result = Array.isArray(pricingData)
            ? pricingData[0]
            : pricingData;
          const endTime = Date.now();

          console.log("✅ Pricing result:", result);

          // Calculate pricing breakdown
          const medicareRate = parseFloat(result.medicare_rate || 0);
          const usradPrice = medicareRate + 75;
          const hospitalEstimate = medicareRate * 3.8;
          const patientSavings = hospitalEstimate - usradPrice;

          // Update results
          document.getElementById("medicareRate").textContent =
            `$${medicareRate.toFixed(2)}`;
          document.getElementById("usradPrice").textContent =
            `$${usradPrice.toFixed(2)}`;
          document.getElementById("hospitalPrice").textContent =
            `$${hospitalEstimate.toFixed(2)}`;
          document.getElementById("savings").textContent =
            `$${patientSavings.toFixed(2)}`;

          responseTime.innerHTML = `
                    <strong>✅ Calculated in ${endTime - startTime}ms</strong> | 
                    Locality: ${result.locality_name || "Unknown"} | 
                    State: ${result.state || "Unknown"}
                `;

          results.style.display = "grid";
        } catch (error) {
          console.error("❌ Pricing calculation error:", error);
          responseTime.innerHTML = `<span style="color: #dc2626;">❌ Error: ${error.message}</span>`;
        } finally {
          button.disabled = false;
          button.textContent = "Calculate Rate";
        }
      }

      // Initialize
      document.addEventListener("DOMContentLoaded", function () {
        console.log("🚀 Initializing REST API Medicare dashboard...");

        try {
          updateStatus("connected", "Connected via REST API");
          loadMetrics();
          loadProcedures();
        } catch (error) {
          console.error("❌ Initialization failed:", error);
          updateStatus("error", "Connection failed");
        }

        // Enter key support
        document.addEventListener("keydown", function (e) {
          if (
            e.key === "Enter" &&
            (e.target.id === "zipCode" || e.target.id === "procedure")
          ) {
            calculatePricing();
          }
        });
      });

      // Make functions globally available
      window.calculatePricing = calculatePricing;
      window.switchTab = switchTab;
    </script>
  </body>
</html>
