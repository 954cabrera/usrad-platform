---
// src/pages/admin/medicare-dashboard.astro

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>USRad Medicare Pricing Engine - Live Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        color: #333;
      }

      .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
      }

      .header {
        text-align: center;
        color: white;
        margin-bottom: 30px;
      }

      .header h1 {
        font-size: 2.5rem;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
      }

      .connection-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        margin-top: 10px;
        transition: all 0.3s ease;
      }

      .connection-status.connected {
        background: rgba(34, 197, 94, 0.2);
        color: #16a34a;
        border: 1px solid rgba(34, 197, 94, 0.3);
      }

      .connection-status.error {
        background: rgba(239, 68, 68, 0.2);
        color: #dc2626;
        border: 1px solid rgba(239, 68, 68, 0.3);
      }

      .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        animation: pulse 2s infinite;
      }

      .connected .status-dot {
        background: #16a34a;
      }

      .error .status-dot {
        background: #dc2626;
      }

      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
      }

      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
      }

      .metric-card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        transition:
          transform 0.3s ease,
          box-shadow 0.3s ease;
        position: relative;
        overflow: hidden;
      }

      .metric-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
      }

      .metric-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #667eea, #764ba2);
      }

      .metric-value {
        font-size: 2.5rem;
        font-weight: bold;
        color: #667eea;
        margin-bottom: 5px;
      }

      .metric-label {
        font-size: 1.1rem;
        color: #666;
        margin-bottom: 10px;
      }

      .metric-description {
        font-size: 0.9rem;
        color: #888;
        line-height: 1.4;
      }

      .pricing-section {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
      }

      .calculator-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
      }

      .input-group {
        display: flex;
        flex-direction: column;
      }

      .input-group label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 5px;
      }

      .input-group input,
      .input-group select {
        padding: 12px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.3s ease;
      }

      .input-group input:focus,
      .input-group select:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
      }

      .calculate-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 15px;
      }

      .calculate-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
      }

      .calculate-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
      }

      .pricing-results {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-top: 20px;
      }

      .result-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
      }

      .result-value {
        font-size: 1.8rem;
        font-weight: bold;
        margin-bottom: 5px;
      }

      .result-value.medicare {
        color: #3b82f6;
      }
      .result-value.usrad {
        color: #10b981;
      }
      .result-value.hospital {
        color: #ef4444;
      }
      .result-value.savings {
        color: #8b5cf6;
      }

      .result-label {
        font-size: 0.9rem;
        color: #666;
      }

      .loading-spinner {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 2px solid #f3f3f3;
        border-top: 2px solid #667eea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }

      .tabs {
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        margin-bottom: 20px;
      }

      .tab-buttons {
        display: flex;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
      }

      .tab-button {
        flex: 1;
        padding: 15px 20px;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 500;
        color: #64748b;
        transition: all 0.3s ease;
        position: relative;
      }

      .tab-button.active {
        color: #667eea;
        background: white;
      }

      .tab-button.active::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #667eea, #764ba2);
      }

      .tab-content {
        padding: 30px;
        min-height: 400px;
      }

      .tab-pane {
        display: none;
      }

      .tab-pane.active {
        display: block;
      }

      .procedure-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 15px;
        max-height: 500px;
        overflow-y: auto;
      }

      .procedure-item {
        background: #f8fafc;
        border-radius: 8px;
        padding: 15px;
        border: 1px solid #e2e8f0;
      }

      .procedure-code {
        font-weight: bold;
        color: #667eea;
        font-family: monospace;
      }

      .procedure-description {
        color: #555;
        font-size: 0.9rem;
        margin-top: 5px;
      }

      .locality-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
      }

      .state-section {
        background: #f8fafc;
        border-radius: 10px;
        padding: 20px;
      }

      .state-section h3 {
        color: #667eea;
        margin-bottom: 15px;
        font-size: 1.2rem;
      }

      .locality-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        background: white;
        border-radius: 6px;
        margin-bottom: 8px;
        font-size: 0.9rem;
      }

      .locality-name {
        font-weight: 500;
      }

      .locality-code {
        color: #666;
        font-family: monospace;
      }

      .error-message {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        padding: 15px;
        border-radius: 8px;
        margin: 20px 0;
      }

      .success-message {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #16a34a;
        padding: 15px;
        border-radius: 8px;
        margin: 20px 0;
      }

      .response-time {
        font-size: 0.8rem;
        color: #888;
        margin-top: 10px;
      }

      @media (max-width: 768px) {
        .dashboard-container {
          padding: 10px;
        }

        .header h1 {
          font-size: 2rem;
        }

        .metrics-grid {
          grid-template-columns: 1fr;
        }

        .tab-buttons {
          flex-direction: column;
        }

        .calculator-grid {
          grid-template-columns: 1fr;
        }

        .pricing-results {
          grid-template-columns: repeat(2, 1fr);
        }
      }
    </style>
  </head>

  <body>
    <div class="dashboard-container">
      <div class="header">
        <h1>🏥 USRad Medicare Pricing Engine</h1>
        <p>Real-time Medicare rate calculations with live API integration</p>
        <div id="connectionStatus" class="connection-status connecting">
          <div class="status-dot"></div>
          <span>Connecting to API...</span>
        </div>
      </div>

      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-value" id="procedureCount">Loading...</div>
          <div class="metric-label">Available Procedures</div>
          <div class="metric-description">CPT codes with complete RVU data</div>
        </div>

        <div class="metric-card">
          <div class="metric-value" id="localityCount">Loading...</div>
          <div class="metric-label">Geographic Localities</div>
          <div class="metric-description">Medicare pricing regions covered</div>
        </div>

        <div class="metric-card">
          <div class="metric-value">$0</div>
          <div class="metric-label">Third-Party APIs</div>
          <div class="metric-description">
            Zero subscription costs - proprietary data
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-value">$50K+</div>
          <div class="metric-label">Annual Savings</div>
          <div class="metric-description">vs healthcare data subscriptions</div>
        </div>
      </div>

      <div class="pricing-section">
        <h2>Real-Time Medicare Pricing Calculator</h2>
        <p style="margin-bottom: 20px; color: #666;">
          Calculate accurate Medicare rates using your live API with geographic
          adjustments.
        </p>

        <div class="calculator-grid">
          <div class="input-group">
            <label for="zipCodeInput">Patient ZIP Code</label>
            <input
              type="text"
              id="zipCodeInput"
              placeholder="e.g., 33330"
              maxlength="5"
              value="33330"
            />
          </div>

          <div class="input-group">
            <label for="procedureSelect">Imaging Procedure</label>
            <select id="procedureSelect">
              <option value="">Loading procedures...</option>
            </select>
          </div>
        </div>

        <button
          class="calculate-btn"
          onclick="calculatePricing()"
          id="calculateButton"
        >
          Calculate Medicare Rate
        </button>

        <div id="pricingResults" class="pricing-results" style="display: none;">
          <div class="result-card">
            <div class="result-value medicare" id="medicareRate">$0.00</div>
            <div class="result-label">Medicare Rate</div>
          </div>
          <div class="result-card">
            <div class="result-value usrad" id="usradPrice">$0.00</div>
            <div class="result-label">USRad Price (+$75)</div>
          </div>
          <div class="result-card">
            <div class="result-value hospital" id="hospitalPrice">$0.00</div>
            <div class="result-label">Hospital Est.</div>
          </div>
          <div class="result-card">
            <div class="result-value savings" id="savingsAmount">$0.00</div>
            <div class="result-label">Patient Savings</div>
          </div>
        </div>

        <div id="responseTime" class="response-time"></div>
      </div>

      <div class="tabs">
        <div class="tab-buttons">
          <button class="tab-button active" onclick="switchTab('procedures')"
            >📋 All Procedures</button
          >
          <button class="tab-button" onclick="switchTab('geography')"
            >🗺️ Geographic Coverage</button
          >
          <button class="tab-button" onclick="switchTab('insights')"
            >📊 System Insights</button
          >
        </div>

        <div class="tab-content">
          <div id="procedures" class="tab-pane active">
            <h2>Available Imaging Procedures</h2>
            <p style="margin-bottom: 20px; color: #666;">
              Complete list of CPT codes available in your Medicare database.
            </p>
            <div id="procedures-content">
              <div style="text-align: center; padding: 40px;">
                <div class="loading-spinner"></div>
                <p style="margin-top: 15px; color: #666;">
                  Loading procedures from API...
                </p>
              </div>
            </div>
          </div>

          <div id="geography" class="tab-pane">
            <h2>Geographic Coverage</h2>
            <p style="margin-bottom: 20px; color: #666;">
              Medicare localities and pricing regions across the United States.
            </p>
            <div id="geography-content">
              <div style="text-align: center; padding: 40px;">
                <div class="loading-spinner"></div>
                <p style="margin-top: 15px; color: #666;">
                  Loading geographic data from API...
                </p>
              </div>
            </div>
          </div>

          <div id="insights" class="tab-pane">
            <h2>Strategic System Insights</h2>

            <div
              style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; margin-bottom: 30px;"
            >
              <div
                style="text-align: center; padding: 20px; background: #f8fafc; border-radius: 10px;"
              >
                <div
                  style="font-size: 2rem; font-weight: bold; color: #667eea; margin-bottom: 5px;"
                >
                  100%
                </div>
                <div style="font-size: 0.9rem; color: #666;">
                  Data Ownership
                </div>
              </div>
              <div
                style="text-align: center; padding: 20px; background: #f8fafc; border-radius: 10px;"
              >
                <div
                  style="font-size: 2rem; font-weight: bold; color: #667eea; margin-bottom: 5px;"
                >
                  &lt;100ms
                </div>
                <div style="font-size: 0.9rem; color: #666;">API Response</div>
              </div>
              <div
                style="text-align: center; padding: 20px; background: #f8fafc; border-radius: 10px;"
              >
                <div
                  style="font-size: 2rem; font-weight: bold; color: #667eea; margin-bottom: 5px;"
                >
                  Live
                </div>
                <div style="font-size: 0.9rem; color: #666;">
                  Real-time Data
                </div>
              </div>
              <div
                style="text-align: center; padding: 20px; background: #f8fafc; border-radius: 10px;"
              >
                <div
                  style="font-size: 2rem; font-weight: bold; color: #667eea; margin-bottom: 5px;"
                >
                  $0
                </div>
                <div style="font-size: 0.9rem; color: #666;">
                  API Dependencies
                </div>
              </div>
            </div>

            <div
              style="background: #f8fafc; border-radius: 12px; padding: 25px; margin-bottom: 20px;"
            >
              <h3 style="color: #667eea; margin-bottom: 15px;">
                🎯 Live API Performance
              </h3>
              <ul style="line-height: 1.8; color: #555;">
                <li>
                  <strong>Real-time Calculations:</strong> Medicare rates calculated
                  instantly from your database
                </li>
                <li>
                  <strong>Geographic Precision:</strong> ZIP-code level pricing with
                  GPCI adjustments
                </li>
                <li>
                  <strong>API-First Architecture:</strong> Scalable endpoints ready
                  for production
                </li>
                <li>
                  <strong>No Demo Mode:</strong> Everything runs on live data from
                  your Medicare database
                </li>
                <li>
                  <strong>Complete Coverage:</strong> 308 procedures across 97 Medicare
                  localities
                </li>
              </ul>
            </div>

            <div
              style="background: #f0fdf4; border-radius: 12px; padding: 25px; border: 1px solid #bbf7d0;"
            >
              <h3 style="color: #16a34a; margin-bottom: 15px;">
                💰 Business Impact
              </h3>
              <ul style="line-height: 1.8; color: #555;">
                <li>
                  <strong>$50,000+ Annual Savings:</strong> vs healthcare data subscription
                  services
                </li>
                <li>
                  <strong>Provider Value:</strong> Revenue optimization tools drive
                  25% increase in bookings
                </li>
                <li>
                  <strong>Patient Savings:</strong> 60-80% cost reduction vs typical
                  hospital pricing
                </li>
                <li>
                  <strong>Market Positioning:</strong> Transparent pricing creates
                  competitive differentiation
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
      // ============================================
      // API-FIRST MEDICARE DASHBOARD
      // ============================================

      let connectionStatus = "connecting";

      function updateConnectionStatus(status, message) {
        const statusElement = document.getElementById("connectionStatus");
        if (statusElement) {
          statusElement.className = `connection-status ${status}`;
          statusElement.innerHTML = `
          <div class="status-dot"></div>
          <span>${message}</span>
        `;
        }
      }

      // ============================================
      // API FUNCTIONS - NO SUPABASE CLIENT NEEDED
      // ============================================

      async function apiRequest(endpoint) {
        try {
          const response = await fetch(endpoint);
          if (!response.ok) {
            throw new Error(`API Error: ${response.status}`);
          }
          return await response.json();
        } catch (error) {
          console.error(`API request failed for ${endpoint}:`, error);
          throw error;
        }
      }

      // Load metrics from health endpoint
      async function loadMetrics() {
        try {
          console.log("📊 Loading metrics from API...");
          const health = await apiRequest("/api/medicare/health");

          console.log("✅ Health check successful:", health);
          updateConnectionStatus("connected", "Connected to Live API");

          document.getElementById("procedureCount").textContent =
            health.metrics.procedures || "0";
          document.getElementById("localityCount").textContent =
            health.metrics.localities || "0";
        } catch (error) {
          console.error("❌ Health check failed:", error);
          updateConnectionStatus("error", "API Connection Failed");

          document.getElementById("procedureCount").textContent = "Error";
          document.getElementById("localityCount").textContent = "Error";
        }
      }

      // Load procedures from API
      async function loadProcedures() {
        try {
          console.log("🔍 Loading procedures from API...");
          // Load more procedures for the dropdown, prioritizing common imaging procedures
          const data = await apiRequest(
            "/api/medicare/procedures?limit=200&prioritize=imaging"
          );

          console.log(
            "✅ Procedures loaded for dropdown:",
            data.procedures.length
          );

          const select = document.getElementById("procedureSelect");

          // Group procedures by modality for better organization
          const groupedProcedures = {};
          data.procedures.forEach((proc) => {
            // Determine modality based on CPT code ranges
            let modality = "Other";
            const code = parseInt(proc.cpt_code);

            if (code >= 70010 && code <= 70559) modality = "CT Head/Neck";
            else if (code >= 70540 && code <= 70559) modality = "MRI Head/Neck";
            else if (code >= 71010 && code <= 71555) modality = "Chest Imaging";
            else if (code >= 72010 && code <= 72295) modality = "Spine Imaging";
            else if (code >= 73000 && code <= 73725)
              modality = "Extremity Imaging";
            else if (code >= 74000 && code <= 74190) modality = "CT Body";
            else if (code >= 74400 && code <= 74485)
              modality = "Abdomen/Pelvis";
            else if (code >= 76000 && code <= 76999) modality = "Ultrasound";
            else if (code >= 77000 && code <= 77099)
              modality = "Mammography/Breast";
            else if (code >= 78000 && code <= 78999)
              modality = "Nuclear Medicine";

            if (!groupedProcedures[modality]) groupedProcedures[modality] = [];
            groupedProcedures[modality].push(proc);
          });

          // Build organized dropdown with optgroups
          let optionsHtml = '<option value="">Select a procedure...</option>';

          // Sort modalities with most common first
          const modalityOrder = [
            "MRI Head/Neck",
            "CT Head/Neck",
            "Chest Imaging",
            "Spine Imaging",
            "CT Body",
            "Abdomen/Pelvis",
            "Extremity Imaging",
            "Ultrasound",
            "Mammography/Breast",
            "Nuclear Medicine",
            "Other",
          ];

          modalityOrder.forEach((modality) => {
            if (
              groupedProcedures[modality] &&
              groupedProcedures[modality].length > 0
            ) {
              optionsHtml += `<optgroup label="${modality}">`;
              groupedProcedures[modality]
                .sort((a, b) => a.cpt_code.localeCompare(b.cpt_code))
                .forEach((proc) => {
                  optionsHtml += `<option value="${proc.cpt_code}">${proc.cpt_code} - ${proc.description}</option>`;
                });
              optionsHtml += "</optgroup>";
            }
          });

          select.innerHTML = optionsHtml;

          // Load all procedures for the tab
          loadAllProcedures();
        } catch (error) {
          console.error("❌ Failed to load procedures:", error);
          const select = document.getElementById("procedureSelect");
          select.innerHTML =
            '<option value="">Error loading procedures</option>';
        }
      }

      // Load all procedures for the procedures tab
      async function loadAllProcedures() {
        try {
          const data = await apiRequest("/api/medicare/procedures?limit=308"); // Get all procedures

          const content = document.getElementById("procedures-content");
          if (data.procedures && data.procedures.length > 0) {
            // Group procedures by modality for better display
            const groupedProcedures = {};
            data.procedures.forEach((proc) => {
              let modality = "Other";
              const code = parseInt(proc.cpt_code);

              if (code >= 70010 && code <= 70559)
                modality = "Head/Neck CT & MRI";
              else if (code >= 71010 && code <= 71555)
                modality = "Chest Imaging";
              else if (code >= 72010 && code <= 72295)
                modality = "Spine Imaging";
              else if (code >= 73000 && code <= 73725)
                modality = "Extremity Imaging";
              else if (code >= 74000 && code <= 74485)
                modality = "Abdomen/Pelvis CT";
              else if (code >= 76000 && code <= 76999) modality = "Ultrasound";
              else if (code >= 77000 && code <= 77099)
                modality = "Mammography/Breast";
              else if (code >= 78000 && code <= 78999)
                modality = "Nuclear Medicine";

              if (!groupedProcedures[modality])
                groupedProcedures[modality] = [];
              groupedProcedures[modality].push(proc);
            });

            // Create summary stats
            const modalityCounts = Object.entries(groupedProcedures)
              .map(([modality, procedures]) => ({
                modality,
                count: procedures.length,
              }))
              .sort((a, b) => b.count - a.count);

            content.innerHTML = `
            <div style="margin-bottom: 30px;">
              <h3>Procedure Coverage Summary</h3>
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin: 20px 0;">
                ${modalityCounts
                  .map(
                    (item) => `
                  <div style="background: #f8fafc; padding: 15px; border-radius: 8px; text-align: center;">
                    <div style="font-size: 1.5rem; font-weight: bold; color: #667eea;">${item.count}</div>
                    <div style="font-size: 0.9rem; color: #666;">${item.modality}</div>
                  </div>
                `
                  )
                  .join("")}
              </div>
            </div>
            
            ${Object.entries(groupedProcedures)
              .sort(([, a], [, b]) => b.length - a.length)
              .map(
                ([modality, procedures]) => `
                <div style="margin-bottom: 30px;">
                  <h3 style="color: #667eea; margin-bottom: 15px;">${modality} (${procedures.length} procedures)</h3>
                  <div class="procedure-grid">
                    ${procedures
                      .sort((a, b) => a.cpt_code.localeCompare(b.cpt_code))
                      .map(
                        (proc) => `
                        <div class="procedure-item">
                          <div class="procedure-code">${proc.cpt_code}</div>
                          <div class="procedure-description">${proc.description}</div>
                        </div>
                      `
                      )
                      .join("")}
                  </div>
                </div>
              `
              )
              .join("")}
          `;
          } else {
            content.innerHTML = "<p>No procedures found.</p>";
          }
        } catch (error) {
          console.error("❌ Failed to load all procedures:", error);
          document.getElementById("procedures-content").innerHTML =
            '<div class="error-message">Failed to load procedures from API</div>';
        }
      }

      // Load localities for geography tab
      async function loadLocalities() {
        try {
          console.log("🗺️ Loading localities from API...");
          const data = await apiRequest("/api/medicare/localities");

          console.log("✅ Localities loaded:", data.localities.length);

          // Group by state
          const stateGroups = {};
          data.localities.forEach((locality) => {
            const state = locality.state || "Unknown";
            if (!stateGroups[state]) {
              stateGroups[state] = [];
            }
            stateGroups[state].push(locality);
          });

          const content = document.getElementById("geography-content");
          content.innerHTML = `
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; margin-bottom: 30px;">
            <div style="text-align: center; padding: 20px; background: #f8fafc; border-radius: 10px;">
              <div style="font-size: 2rem; font-weight: bold; color: #667eea; margin-bottom: 5px;">${data.localities.length}</div>
              <div style="font-size: 0.9rem; color: #666;">Total Localities</div>
            </div>
            <div style="text-align: center; padding: 20px; background: #f8fafc; border-radius: 10px;">
              <div style="font-size: 2rem; font-weight: bold; color: #667eea; margin-bottom: 5px;">${Object.keys(stateGroups).length}</div>
              <div style="font-size: 0.9rem; color: #666;">States Covered</div>
            </div>
          </div>
          
          <div class="locality-grid">
            ${Object.entries(stateGroups)
              .sort(([a], [b]) => a.localeCompare(b))
              .map(
                ([state, localities]) => `
                <div class="state-section">
                  <h3>${state}</h3>
                  <div class="locality-list">
                    ${localities
                      .map(
                        (loc) => `
                      <div class="locality-item">
                        <span class="locality-name">${loc.locality_name}</span>
                        <span class="locality-code">${loc.locality_code}</span>
                      </div>
                    `
                      )
                      .join("")}
                  </div>
                </div>
              `
              )
              .join("")}
          </div>
        `;
        } catch (error) {
          console.error("❌ Failed to load localities:", error);
          document.getElementById("geography-content").innerHTML =
            '<div class="error-message">Failed to load geographic data from API</div>';
        }
      }

      // Calculate pricing using API
      async function calculatePricing() {
        const zipCode = document.getElementById("zipCodeInput").value.trim();
        const procedureCode = document.getElementById("procedureSelect").value;
        const button = document.getElementById("calculateButton");
        const resultsDiv = document.getElementById("pricingResults");
        const responseTimeDiv = document.getElementById("responseTime");

        // Validation
        if (!zipCode || !/^\d{5}$/.test(zipCode)) {
          alert("Please enter a valid 5-digit ZIP code");
          return;
        }

        if (!procedureCode) {
          alert("Please select a procedure");
          return;
        }

        const startTime = Date.now();

        try {
          // Update UI
          button.disabled = true;
          button.innerHTML =
            '<div class="loading-spinner"></div> Calculating...';
          resultsDiv.style.display = "none";

          console.log("🔍 Calculating price via API...");

          // Call the pricing API
          const pricing = await apiRequest(
            `/api/medicare/price?zip=${zipCode}&cpt=${procedureCode}`
          );

          const responseTime = Date.now() - startTime;
          console.log("✅ Price calculation successful:", pricing);

          if (pricing.medicare_rate === null) {
            throw new Error(
              "Unable to calculate Medicare rate for this ZIP code and procedure"
            );
          }

          // Update results
          document.getElementById("medicareRate").textContent =
            `$${pricing.medicare_rate?.toFixed(2) || "0.00"}`;
          document.getElementById("usradPrice").textContent =
            `$${pricing.usrad_price?.toFixed(2) || "0.00"}`;
          document.getElementById("hospitalPrice").textContent =
            `$${pricing.hospital_estimate?.toFixed(2) || "0.00"}`;
          document.getElementById("savingsAmount").textContent =
            `$${pricing.savings?.toFixed(2) || "0.00"}`;

          responseTimeDiv.innerHTML = `
          <strong>Calculation completed in ${responseTime}ms</strong><br>
          ZIP: ${zipCode} | CPT: ${procedureCode} | Source: Live API
        `;

          resultsDiv.style.display = "grid";
        } catch (error) {
          console.error("❌ Price calculation failed:", error);
          alert(`Error calculating pricing: ${error.message}`);
          responseTimeDiv.innerHTML = `<span style="color: #dc2626;">Error: ${error.message}</span>`;
        } finally {
          button.disabled = false;
          button.textContent = "Calculate Medicare Rate";
        }
      }

      // Tab switching
      function switchTab(tabName) {
        // Update tab buttons
        document
          .querySelectorAll(".tab-button")
          .forEach((btn) => btn.classList.remove("active"));
        event.target.classList.add("active");

        // Update tab content
        document
          .querySelectorAll(".tab-pane")
          .forEach((pane) => pane.classList.remove("active"));
        document.getElementById(tabName).classList.add("active");

        // Load tab content if needed
        if (
          tabName === "geography" &&
          document
            .getElementById("geography-content")
            .innerHTML.includes("Loading")
        ) {
          loadLocalities();
        }
      }

      // ============================================
      // INITIALIZATION
      // ============================================

      document.addEventListener("DOMContentLoaded", function () {
        console.log("🚀 Initializing API-first Medicare dashboard...");

        // Load initial data
        loadMetrics();
        loadProcedures();

        // Set up Enter key support
        document.addEventListener("keydown", function (e) {
          if (
            e.key === "Enter" &&
            (document.activeElement ===
              document.getElementById("zipCodeInput") ||
              document.activeElement ===
                document.getElementById("procedureSelect"))
          ) {
            calculatePricing();
          }
        });
      });

      // Make functions globally available
      window.calculatePricing = calculatePricing;
      window.switchTab = switchTab;
    </script>
  </body>
</html>
