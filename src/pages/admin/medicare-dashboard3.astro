          geoContent.innerHTML = `
                <div class="geographic-stats">
                    <div class="stat-item">
                        <div class="stat-value">5</div>
                        <div class="stat-label">Total Localities</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">2</div>
                        <div class="stat-label">States Covered</div>
                    </div>
                </div>
                
                <div class="locality-grid">
                    <div class="state-section">
                        <h3>FL</h3>
                        <div class="locality-list">
                            <div class="locality-item">
                                <span class="locality-name">FORT LAUDERDALE</span>
                                <span class="locality-code">09102_03</span>
                            </div>
                            <div class="locality-item">
                                <span class="locality-name">MIAMI</span>
                                <span class="locality-code">09102_04</span>
                            </div>
                            <div class="locality-item">
                                <span class="locality-name">REST OF FLORIDA</span>
                                <span class="locality-code">09102_99</span>
                            </div>
                        </div>
                    </div>
                    <div class="state-section">
                        <h3>GA</h3>
                        <div class="locality-list">
                            <div class="locality-item">
                                <span class="locality-name">ATLANTA</span>
                                <span class="locality-code">10212_01</span>
                            </div>
                            <div class="locality-item">
                                <span class="locality-name">REST OF GEORGIA</span>
                                <span class="locality-code">10212_99</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        console.log("✅ Manual demo mode ready!");
      }

      // Initialize when DOM is loaded
      document.addEventListener("DOMContentLoaded", function () {
        // Wait for DOM and Supabase library to load
        setTimeout(() => {
          const supabaseInitialized = initializeSupabase();

          if (supabaseInitialized) {
            console.log("🚀 Initializing dashboard with Supabase...");

            // Try Supabase for 3 seconds, then fall back to manual mode
            const supabaseTimeout = setTimeout(() => {
              console.log(
                "⚠️ Supabase queries taking too long, switching to demo mode..."
              );
              setupManualMode();
            }, 3000);

            // Try to run diagnostic test
            runDiagnosticTest()
              .then(() => {
                clearTimeout(supabaseTimeout);
              })
              .catch(() => {
                clearTimeout(supabaseTimeout);
                setupManualMode();
              });

            // Also try the original functions (but don't wait for them)
            loadDashboardMetrics();
            loadProcedures();
            loadLocalities();
          } else {
            console.error("❌ Supabase initialization failed");
            setupManualMode(); // Use manual mode as fallback
          }
        }, 100); // Small delay to ensure Supabase library is loaded

        // Enter key support
        document.addEventListener("keydown", function (e) {
          if (
            e.key === "Enter" &&
            (document.activeElement ===
              document.getElementById("zipCodeInput") ||
              document.activeElement ===
                document.getElementById("procedureSelect"))
          ) {
            calculatePricing();
          }
        });
      });

      // Global function for calculate button
      window.calculatePricing = calculatePricing;
      window.switchTab = switchTab;
    </script>
  </body>
