      async function performEnhancedBulkValidation(
        state,
        modality,
        sampleSize
      ) {
        // Get random sample from database
        let query = supabase
          .from("medicare_pricing")
          .select(
            "cpt_code, county, state, medicare_rate, usrad_price, description, modality"
          );

        if (state) {
          query = query.eq("state", state);
        }

        if (modality) {
          query = query.eq("modality", modality);
        }

        const { data: sampleData, error } = await query.limit(sampleSize);

        if (error) {
          throw new Error(`Database sampling failed: ${error.message}`);
        }

        if (!sampleData || sampleData.length === 0) {
          throw new Error("No sample data found");
        }

        let passed = 0;
        let failed = 0;
        let results = [];
        let totalResponseTime = 0;

        // Test each sample against API
        for (const sample of sampleData) {
          try {
            const startTime = performance.now();
            const apiData = await getAPIData(
              sample.cpt_code,
              sample.county,
              sample.state
            );
            const endTime = performance.now();
            const responseTime = endTime - startTime;
            totalResponseTime += responseTime;

            const dbRate = parseFloat(sample.medicare_rate);
            const apiRate = parseFloat(apiData.pricing.medicare_rate);
            const difference = Math.abs(dbRate - apiRate);
            const isMatch = difference < 0.01;

            if (isMatch) {
              passed++;
              results.push({
                status: "pass",
                sample: sample,
                message: `✅ ${sample.cpt_code} in ${sample.county}: Perfect match ($${dbRate})`,
                responseTime: responseTime,
              });
            } else {
              failed++;
              results.push({
                status: "fail",
                sample: sample,
                message: `❌ ${sample.cpt_code} in ${sample.county}: DB $${dbRate} ≠ API $${apiRate} (diff: $${difference.toFixed(2)})`,
                responseTime: responseTime,
              });
            }
          } catch (error) {
            failed++;
            results.push({
              status: "fail",
              sample: sample,
              message: `❌ ${sample.cpt_code} in ${sample.county}: API error - ${error.message}`,
              responseTime: null,
            });
          }

          // Small delay to avoid overwhelming the API
          await new Promise((resolve) => setTimeout(resolve, 50));
        }

        const avgResponseTime = totalResponseTime / sampleData.length;

        return {
          passed,
          failed,
          results,
          total: sampleData.length,
          avgResponseTime: Math.round(avgResponseTime),
        };
      }

      function displayEnhancedBulkResults(testResults) {
        const { passed, failed, results, total, avgResponseTime } = testResults;
        const accuracy = total > 0 ? Math.round((passed / total) * 100) : 0;

        // Update stats
        document.getElementById("total-tested").textContent = total;
        document.getElementById("passed-tests").textContent = passed;
        document.getElementById("failed-tests").textContent = failed;
        document.getElementById("accuracy-rate").textContent = accuracy + "%";
        document.getElementById("bulk-stats").style.display = "grid";

        // Display results
        const resultsDiv = document.getElementById("bulk-validation-results");
        let resultsHTML = `
                <div class="test-result ${accuracy >= 99 ? "pass" : accuracy >= 95 ? "warning" : "fail"}">
                    <h3>Enhanced Bulk Validation Summary</h3>
                    <p><strong>Database-API Consistency:</strong> ${accuracy}% (${passed}/${total} matched)</p>
                    <p><strong>Average Response Time:</strong> ${avgResponseTime}ms</p>
                    <p><strong>Sample Coverage:</strong> ${total} procedures tested</p>
                </div>
            `;

        // Show failed tests first
        const failedResults = results.filter((r) => r.status === "fail");
        const passedResults = results.filter((r) => r.status === "pass");

        if (failedResults.length > 0) {
          resultsHTML += "<h4>Failed Tests (Require Investigation)</h4>";
          failedResults.slice(0, 10).forEach((result) => {
            resultsHTML += `<div class="test-result ${result.status}">${result.message}</div>`;
          });

          if (failedResults.length > 10) {
            resultsHTML += `<div class="test-result warning">... and ${failedResults.length - 10} more failed tests</div>`;
          }
        }

        if (passedResults.length > 0) {
          resultsHTML += "<h4>Sample Passed Tests</h4>";
          passedResults.slice(0, 5).forEach((result) => {
            resultsHTML += `<div class="test-result ${result.status}">${result.message}</div>`;
          });
        }

        resultsDiv.innerHTML = resultsHTML;
      }

