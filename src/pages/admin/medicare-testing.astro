      async function performSystemHealthCheck() {
        const results = [];

        // Test database connectivity
        try {
          const { data, error } = await supabase
            .from("medicare_pricing")
            .select("count(*)")
            .limit(1);

          if (error) {
            results.push({
              test: "Database Connectivity",
              status: "fail",
              message: `❌ Database connection failed: ${error.message}`,
            });
          } else {
            results.push({
              test: "Database Connectivity",
              status: "pass",
              message: "✅ Database connection successful",
            });
          }
        } catch (error) {
          results.push({
            test: "Database Connectivity",
            status: "fail",
            message: `❌ Database error: ${error.message}`,
          });
        }

        // Test API endpoints
        const testCases = [
          { state: "FL", county: "Miami-Dade", cpt: "72148" },
          { state: "GA", county: "Fulton", cpt: "72148" },
        ];

        let totalResponseTime = 0;
        let successfulTests = 0;

        for (const testCase of testCases) {
          try {
            const startTime = performance.now();
            const response = await fetch(
              `/api/pricing/calculate-db?cpt=${testCase.cpt}&county=${encodeURIComponent(testCase.county)}&state=${testCase.state}`
            );
            const endTime = performance.now();
            const responseTime = Math.round(endTime - startTime);

            if (response.ok) {
              const data = await response.json();
              if (!data.error) {
                successfulTests++;
                totalResponseTime += responseTime;
                results.push({
                  test: `API Test: ${testCase.state} - ${testCase.county}`,
                  status: "pass",
                  message: `✅ API responsive (${responseTime}ms)`,
                  responseTime: responseTime,
                });
              } else {
                results.push({
                  test: `API Test: ${testCase.state} - ${testCase.county}`,
                  status: "fail",
                  message: `❌ API error: ${data.error}`,
                });
              }
            } else {
              results.push({
                test: `API Test: ${testCase.state} - ${testCase.county}`,
                status: "fail",
                message: `❌ HTTP ${response.status}`,
              });
            }
          } catch (error) {
            results.push({
              test: `API Test: ${testCase.state} - ${testCase.county}`,
              status: "fail",
              message: `❌ Connection failed: ${error.message}`,
            });
          }
        }

        // Update average response time
        if (successfulTests > 0) {
          const avgResponseTime = Math.round(
            totalResponseTime / successfulTests
          );
          document.getElementById("avg-response-time").textContent =
            avgResponseTime + "ms";
        }

        return results;
      }

      function displaySystemHealth(results) {
        const resultsDiv = document.getElementById("system-monitor-results");

        const passed = results.filter((r) => r.status === "pass").length;
        const failed = results.filter((r) => r.status === "fail").length;
