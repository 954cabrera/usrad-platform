          results.length > 0 ? Math.round((passed / results.length) * 100) : 0;

        let resultsHTML = `
                <div class="test-result ${healthScore >= 90 ? "pass" : healthScore >= 70 ? "warning" : "fail"}">
                    <h3>System Health Summary</h3>
