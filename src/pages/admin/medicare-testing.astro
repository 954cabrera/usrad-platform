      async function performMedicareComparison(state, county, medicareInput) {
        // Parse Medicare rates input
        const lines = medicareInput.trim().split("\n");
        const medicareRates = {};

        lines.forEach((line, index) => {
          if (index === 0 && line.toLowerCase().includes("cpt")) return; // Skip header
          const [cpt, rate] = line.split(",");
          if (cpt && rate) {
            medicareRates[cpt.trim()] = parseFloat(rate.trim());
          }
        });

        if (Object.keys(medicareRates).length === 0) {
          throw new Error("No valid Medicare rates found in input");
        }

        const results = [];

        for (const [cpt, expectedRate] of Object.entries(medicareRates)) {
          try {
            // Get our rate from database
            const { data: ourData } = await supabase
              .from("medicare_pricing")
              .select("*")
              .eq("cpt_code", cpt)
              .eq("county", county)
              .eq("state", state)
              .single();

            if (ourData) {
              const ourRate = parseFloat(ourData.medicare_rate);
              const difference = Math.abs(ourRate - expectedRate);
              const percentDiff = (difference / expectedRate) * 100;
              const isMatch = percentDiff <= 1; // 1% tolerance

              results.push({
                cpt: cpt,
                description: ourData.description,
                expectedRate: expectedRate,
                ourRate: ourRate,
                difference: difference,
                percentDiff: percentDiff,
                isMatch: isMatch,
                status: isMatch ? "pass" : "fail",
              });
            } else {
              results.push({
                cpt: cpt,
                description: "Not found",
                expectedRate: expectedRate,
                ourRate: null,
                difference: null,
                percentDiff: null,
                isMatch: false,
                status: "fail",
              });
            }
          } catch (error) {
            results.push({
              cpt: cpt,
              description: "Error",
              expectedRate: expectedRate,
              ourRate: null,
              difference: null,
              percentDiff: null,
              isMatch: false,
              status: "fail",
            });
          }
        }

        return results;
      }

      function displayMedicareComparison(results) {
        const resultsDiv = document.getElementById("comparison-results");

        const passed = results.filter((r) => r.isMatch).length;
        const failed = results.filter((r) => !r.isMatch).length;
        const accuracy =
          results.length > 0 ? Math.round((passed / results.length) * 100) : 0;

        let resultsHTML = `
                <div class="test-result ${accuracy >= 95 ? "pass" : accuracy >= 80 ? "warning" : "fail"}">
                    <h3>Medicare.gov Comparison Summary</h3>
                    <p><strong>Accuracy:</strong> ${accuracy}% (${passed}/${results.length} matched)</p>
                    <p><strong>Tolerance:</strong> ±1% difference allowed</p>
                </div>
                
