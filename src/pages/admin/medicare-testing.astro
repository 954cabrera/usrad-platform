                    <thead>
                        <tr>
                            <th>CPT Code</th>
                            <th>Description</th>
                            <th>Medicare.gov Rate</th>
                            <th>Our Rate</th>
                            <th>Difference</th>
                            <th>% Diff</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

        results.forEach((result) => {
          const statusIcon = result.isMatch ? "✅" : "❌";
          const ourRateDisplay =
            result.ourRate !== null
              ? `$${result.ourRate.toFixed(2)}`
              : "Not Found";
          const diffDisplay =
            result.difference !== null
              ? `$${result.difference.toFixed(2)}`
              : "N/A";
          const percentDisplay =
            result.percentDiff !== null
              ? `${result.percentDiff.toFixed(2)}%`
              : "N/A";

          resultsHTML += `
                    <tr>
                        <td><strong>${result.cpt}</strong></td>
                        <td>${result.description}</td>
                        <td>$${result.expectedRate.toFixed(2)}</td>
                        <td>${ourRateDisplay}</td>
                        <td>${diffDisplay}</td>
                        <td>${percentDisplay}</td>
                        <td>${statusIcon}</td>
                    </tr>
                `;
        });

        resultsHTML += "</tbody></table>";
        resultsDiv.innerHTML = resultsHTML;
      }

