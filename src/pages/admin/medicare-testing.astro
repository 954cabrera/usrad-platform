      // Stress Test Function
      window.stressTestAPIs = async function () {
        const resultsDiv = document.getElementById("system-monitor-results");
        resultsDiv.innerHTML =
          '<div class="loading"><div class="spinner"></div></div>';

        try {
          const stressResults = await performStressTest();
          displayStressResults(stressResults);
        } catch (error) {
          showError(
            "system-monitor-results",
            `Stress test failed: ${error.message}`
          );
        }
      };

      async function performStressTest() {
        const testCases = [
          { state: "FL", county: "Miami-Dade", cpt: "72148" },
          { state: "FL", county: "Broward", cpt: "70551" },
          { state: "GA", county: "Fulton", cpt: "72158" },
          { state: "GA", county: "Cherokee", cpt: "70450" },
        ];

        const concurrentRequests = 20;
        const results = [];

        console.log(
          `Starting stress test with ${concurrentRequests} concurrent requests...`
        );

        const startTime = performance.now();

        // Run concurrent requests
        const promises = [];
        for (let i = 0; i < concurrentRequests; i++) {
          const testCase = testCases[i % testCases.length];
          const promise = fetch(
            `/api/pricing/calculate-db?cpt=${testCase.cpt}&county=${encodeURIComponent(testCase.county)}&state=${testCase.state}`
          )
            .then((response) => ({
              success: response.ok,
              status: response.status,
              testCase: testCase,
            }))
            .catch((error) => ({
              success: false,
              error: error.message,
              testCase: testCase,
            }));
          promises.push(promise);
        }

        const responses = await Promise.all(promises);
        const endTime = performance.now();

        const totalTime = endTime - startTime;
        const successful = responses.filter((r) => r.success).length;
        const failed = responses.filter((r) => !r.success).length;
        const avgTimePerRequest = totalTime / concurrentRequests;

        return {
          totalRequests: concurrentRequests,
          successful: successful,
          failed: failed,
          totalTime: Math.round(totalTime),
          avgTimePerRequest: Math.round(avgTimePerRequest),
          requestsPerSecond: Math.round(
            (concurrentRequests / totalTime) * 1000
          ),
          responses: responses,
        };
      }

      function displayStressResults(stressResults) {
        const resultsDiv = document.getElementById("system-monitor-results");
        const successRate =
          (stressResults.successful / stressResults.totalRequests) * 100;

        let resultsHTML = `
                <div class="test-result ${successRate >= 95 ? "pass" : successRate >= 80 ? "warning" : "fail"}">
                    <h3>API Stress Test Results</h3>
                    <p><strong>Concurrent Requests:</strong> ${stressResults.totalRequests}</p>
                    <p><strong>Success Rate:</strong> ${successRate.toFixed(1)}% (${stressResults.successful}/${stressResults.totalRequests})</p>
                    <p><strong>Total Time:</strong> ${stressResults.totalTime}ms</p>
                    <p><strong>Avg Time per Request:</strong> ${stressResults.avgTimePerRequest}ms</p>
                    <p><strong>Requests per Second:</strong> ${stressResults.requestsPerSecond}</p>
                </div>
            `;

        if (stressResults.failed > 0) {
          resultsHTML += `
                    <div class="test-result warning">
                        <h4>Failed Requests: ${stressResults.failed}</h4>
                        <p>Some requests failed during stress testing. This may indicate rate limiting or capacity issues.</p>
                    </div>
                `;
        }

        resultsDiv.innerHTML = resultsHTML;
      }

      // Additional Integrity Functions
      window.validateRVUCalculations = async function () {
        const resultsDiv = document.getElementById("integrity-results");
        resultsDiv.innerHTML =
          '<div class="loading"><div class="spinner"></div></div>';

        try {
          const rvuResults = await performRVUValidation();
          displayRVUResults(rvuResults);
        } catch (error) {
          showError(
            "integrity-results",
            `RVU validation failed: ${error.message}`
          );
        }
      };

      async function performRVUValidation() {
        // Get sample data for RVU validation
        const { data: sampleData, error } = await supabase
          .from("medicare_pricing")
          .select("*")
          .limit(50);

        if (error) {
          throw new Error(`Failed to get sample data: ${error.message}`);
        }

        const results = [];
        const conversionFactor = 32.3465; // 2025 Medicare conversion factor

        sampleData.forEach((record, index) => {
          // Recalculate Medicare rate
          const workAmount =
            parseFloat(record.work_rvu) *
            parseFloat(record.work_gpci) *
            conversionFactor;
          const peAmount =
            parseFloat(record.pe_rvu_facility) *
            parseFloat(record.pe_gpci) *
            conversionFactor;
          const mpAmount =
            parseFloat(record.mp_rvu) *
            parseFloat(record.mp_gpci) *
            conversionFactor;

          const calculatedRate = workAmount + peAmount + mpAmount;
          const storedRate = parseFloat(record.medicare_rate);
          const difference = Math.abs(calculatedRate - storedRate);

          if (difference < 0.01) {
            results.push({
              status: "pass",
              cpt: record.cpt_code,
              county: record.county,
              calculated: calculatedRate.toFixed(2),
              stored: storedRate.toFixed(2),
              message: `✅ ${record.cpt_code} in ${record.county}: RVU calculation correct`,
            });
          } else {
            results.push({
              status: "fail",
              cpt: record.cpt_code,
              county: record.county,
              calculated: calculatedRate.toFixed(2),
              stored: storedRate.toFixed(2),
              message: `❌ ${record.cpt_code} in ${record.county}: Calculated ${calculatedRate.toFixed(2)} ≠ Stored ${storedRate.toFixed(2)}`,
            });
          }
        });

        return results;
      }

      function displayRVUResults(results) {
        const resultsDiv = document.getElementById("integrity-results");
        const passed = results.filter((r) => r.status === "pass").length;
        const failed = results.filter((r) => r.status === "fail").length;
        const accuracy =
          results.length > 0 ? Math.round((passed / results.length) * 100) : 0;

        let resultsHTML = `
                <div class="test-result ${accuracy >= 99 ? "pass" : accuracy >= 95 ? "warning" : "fail"}">
                    <h3>RVU Calculation Validation</h3>
                    <p><strong>Accuracy:</strong> ${accuracy}% (${passed}/${results.length} calculations correct)</p>
                    <p><strong>Formula:</strong> (Work RVU × Work GPCI + PE RVU × PE GPCI + MP RVU × MP GPCI) × $32.3465</p>
                </div>
            `;

        // Show failed calculations first
        const failedResults = results.filter((r) => r.status === "fail");
        if (failedResults.length > 0) {
          resultsHTML += "<h4>Failed Calculations (Require Investigation)</h4>";
          failedResults.forEach((result) => {
            resultsHTML += `<div class="test-result ${result.status}">${result.message}</div>`;
          });
        }

        // Show sample passed calculations
        const passedResults = results.filter((r) => r.status === "pass");
        if (passedResults.length > 0) {
          resultsHTML += "<h4>Sample Correct Calculations</h4>";
          passedResults.slice(0, 5).forEach((result) => {
            resultsHTML += `<div class="test-result ${result.status}">${result.message}</div>`;
          });
        }

        resultsDiv.innerHTML = resultsHTML;
      }

      window.checkGPCIConsistency = async function () {
        const resultsDiv = document.getElementById("integrity-results");
        resultsDiv.innerHTML =
          '<div class="loading"><div class="spinner"></div></div>';

        try {
          const gpciResults = await performGPCICheck();
          displayGPCIResults(gpciResults);
        } catch (error) {
          showError("integrity-results", `GPCI check failed: ${error.message}`);
        }
      };

      async function performGPCICheck() {
        // Get unique locality codes and their GPCI factors
        const { data: localityData, error } = await supabase
          .from("medicare_pricing")
          .select("locality_code, locality_name, work_gpci, pe_gpci, mp_gpci")
          .limit(1000);

        if (error) {
          throw new Error(`Failed to get locality data: ${error.message}`);
        }

        // Group by locality code to check consistency
        const localityGroups = {};
        localityData.forEach((record) => {
          if (!localityGroups[record.locality_code]) {
            localityGroups[record.locality_code] = [];
          }
          localityGroups[record.locality_code].push(record);
        });

        const results = [];

        Object.entries(localityGroups).forEach(([localityCode, records]) => {
          const firstRecord = records[0];
          let isConsistent = true;

          records.forEach((record) => {
            if (
              record.work_gpci !== firstRecord.work_gpci ||
              record.pe_gpci !== firstRecord.pe_gpci ||
              record.mp_gpci !== firstRecord.mp_gpci
            ) {
              isConsistent = false;
            }
          });

          if (isConsistent) {
            results.push({
              status: "pass",
              locality: localityCode,
              name: firstRecord.locality_name,
              message: `✅ ${localityCode} (${firstRecord.locality_name}): GPCI factors consistent across all records`,
            });
          } else {
            results.push({
              status: "fail",
              locality: localityCode,
              name: firstRecord.locality_name,
              message: `❌ ${localityCode} (${firstRecord.locality_name}): Inconsistent GPCI factors found`,
            });
          }
        });

        return results;
      }

      function displayGPCIResults(results) {
        const resultsDiv = document.getElementById("integrity-results");
        const passed = results.filter((r) => r.status === "pass").length;
        const failed = results.filter((r) => r.status === "fail").length;

        let resultsHTML = `
                <div class="test-result ${failed === 0 ? "pass" : "fail"}">
                    <h3>GPCI Consistency Check</h3>
                    <p><strong>Localities Checked:</strong> ${results.length}</p>
                    <p><strong>Consistent:</strong> ${passed}</p>
                    <p><strong>Inconsistent:</strong> ${failed}</p>
                </div>
            `;

        results.forEach((result) => {
          resultsHTML += `<div class="test-result ${result.status}">${result.message}</div>`;
        });

        resultsDiv.innerHTML = resultsHTML;
      }

      window.findDataAnomalies = async function () {
        const resultsDiv = document.getElementById("integrity-results");
        resultsDiv.innerHTML =
          '<div class="loading"><div class="spinner"></div></div>';

        try {
          const anomalies = await detectAnomalies();
          displayAnomalies(anomalies);
        } catch (error) {
          showError(
            "integrity-results",
            `Anomaly detection failed: ${error.message}`
          );
        }
      };

      async function detectAnomalies() {
        const anomalies = [];

        // Check for unusually high Medicare rates
        const { data: highRates } = await supabase
          .from("medicare_pricing")
          .select("cpt_code, description, county, state, medicare_rate")
          .gt("medicare_rate", 1000)
          .limit(10);

        if (highRates && highRates.length > 0) {
          highRates.forEach((record) => {
            anomalies.push({
              type: "High Medicare Rate",
              status: "warning",
              message: `⚠️ ${record.cpt_code} in ${record.county}: ${record.medicare_rate} (unusually high)`,
            });
          });
        }

        // Check for unusually low savings percentages
        const { data: lowSavings } = await supabase
          .from("medicare_pricing")
          .select("cpt_code, description, county, state, savings_percentage")
          .lt("savings_percentage", 30)
          .limit(10);

        if (lowSavings && lowSavings.length > 0) {
          lowSavings.forEach((record) => {
            anomalies.push({
              type: "Low Savings",
              status: "warning",
              message: `⚠️ ${record.cpt_code} in ${record.county}: ${record.savings_percentage}% savings (unusually low)`,
            });
          });
        }

        // Check for potential duplicate records
        const { data: duplicateCheck } = await supabase.rpc("check_duplicates"); // This would be a custom SQL function

        if (anomalies.length === 0) {
          anomalies.push({
            type: "System Health",
            status: "pass",
            message: "✅ No significant anomalies detected in the data",
          });
        }

        return anomalies;
      }

      function displayAnomalies(anomalies) {
        const resultsDiv = document.getElementById("integrity-results");

        let resultsHTML = `
                <div class="test-result ${anomalies.length === 1 && anomalies[0].status === "pass" ? "pass" : "warning"}">
                    <h3>Data Anomaly Detection</h3>
                    <p><strong>Anomalies Found:</strong> ${anomalies.length === 1 && anomalies[0].status === "pass" ? 0 : anomalies.length}</p>
                </div>
            `;

        anomalies.forEach((anomaly) => {
          resultsHTML += `<div class="test-result ${anomaly.status}">${anomaly.message}</div>`;
        });

        resultsDiv.innerHTML = resultsHTML;
      }

