      async function performDataIntegrityCheck() {
        const results = [];

        // Check for missing required fields
        const { count: missingData } = await supabase
          .from("medicare_pricing")
          .select("*", { count: "exact", head: true })
          .or(
            "medicare_rate.is.null,cpt_code.is.null,county.is.null,state.is.null"
          );

        if (missingData === 0) {
          results.push({
            status: "pass",
            message: "✅ All records have required fields populated",
          });
        } else {
          results.push({
            status: "fail",
            message: `❌ Found ${missingData} records with missing required fields`,
          });
        }

        // Check for negative or zero Medicare rates
        const { count: invalidRates } = await supabase
          .from("medicare_pricing")
          .select("*", { count: "exact", head: true })
          .lte("medicare_rate", 0);

        if (invalidRates === 0) {
          results.push({
            status: "pass",
            message: "✅ All Medicare rates are positive",
          });
        } else {
          results.push({
            status: "warning",
            message: `⚠️ Found ${invalidRates} records with zero or negative Medicare rates`,
          });
        }

        // Check for negative patient savings
        const { count: negativeSavings } = await supabase
          .from("medicare_pricing")
          .select("*", { count: "exact", head: true })
          .lt("patient_savings", 0);

        if (negativeSavings === 0) {
          results.push({
            status: "pass",
            message: "✅ All patient savings are positive",
          });
        } else {
          results.push({
            status: "fail",
            message: `❌ Found ${negativeSavings} records with negative patient savings`,
          });
        }

        // Check USRad markup consistency
        const { data: markupCheck } = await supabase
          .from("medicare_pricing")
          .select("medicare_rate, usrad_price, usrad_markup")
          .limit(100);

        let markupInconsistent = 0;
        markupCheck?.forEach((record) => {
          const expectedUSRad =
            parseFloat(record.medicare_rate) + parseFloat(record.usrad_markup);
          const actualUSRad = parseFloat(record.usrad_price);
          if (Math.abs(expectedUSRad - actualUSRad) > 0.01) {
            markupInconsistent++;
          }
        });

        if (markupInconsistent === 0) {
          results.push({
            status: "pass",
            message: "✅ USRad markup calculations are consistent",
          });
        } else {
          results.push({
            status: "fail",
            message: `❌ Found ${markupInconsistent} records with inconsistent USRad markup`,
          });
        }

        return results;
      }

