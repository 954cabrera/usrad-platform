---
// src/pages/admin/medicare-testing.astro
export const prerender = false;

// Server-side environment variables (secure)
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Medicare Compliance Testing Dashboard - USRad</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 20px;
      }

      .container {
        max-width: 1600px;
        margin: 0 auto;
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        overflow: hidden;
      }

      .header {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
      }

      .header h1 {
        font-size: 2.5rem;
        margin-bottom: 10px;
        font-weight: 300;
      }

      .header p {
        opacity: 0.9;
        font-size: 1.1rem;
      }

      .system-status {
        position: absolute;
        top: 20px;
        right: 30px;
        background: rgba(255, 255, 255, 0.1);
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
      }

      .tabs {
        display: flex;
        background: #e9ecef;
        border-bottom: 1px solid #dee2e6;
        overflow-x: auto;
      }

      .tab {
        flex: 1;
        min-width: 150px;
        padding: 20px 15px;
        text-align: center;
        background: none;
        border: none;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        color: #666;
        white-space: nowrap;
      }

      .tab.active {
        background: #4361ee;
        color: white;
      }

      .tab:hover:not(.active) {
        background: #f1f3f4;
      }

      .tab-content {
        padding: 30px;
        min-height: 700px;
      }

      .tab-panel {
        display: none;
      }

      .tab-panel.active {
        display: block;
      }

      .controls {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
      }

      .form-group {
        display: flex;
        flex-direction: column;
      }

      label {
        font-weight: 600;
        margin-bottom: 8px;
        color: #2c3e50;
      }

      select,
      input {
        padding: 12px;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.3s ease;
      }

      select:focus,
      input:focus {
        outline: none;
        border-color: #4361ee;
      }

      .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .btn-primary {
        background: #4361ee;
        color: white;
      }

      .btn-primary:hover {
        background: #3651d4;
        transform: translateY(-2px);
      }

      .btn-success {
        background: #28a745;
        color: white;
      }

      .btn-success:hover {
        background: #218838;
      }

      .btn-warning {
        background: #ffc107;
        color: #212529;
      }

      .btn-warning:hover {
        background: #e0a800;
      }

      .btn-danger {
        background: #dc3545;
        color: white;
      }

      .btn-danger:hover {
        background: #c82333;
      }

      .results-container {
        margin-top: 20px;
      }

      .test-result {
        padding: 15px;
        margin-bottom: 10px;
        border-radius: 8px;
        border-left: 4px solid;
      }

      .test-result.pass {
        background: #d4edda;
        border-color: #28a745;
        color: #155724;
      }

      .test-result.fail {
        background: #f8d7da;
        border-color: #dc3545;
        color: #721c24;
      }

      .test-result.warning {
        background: #fff3cd;
        border-color: #ffc107;
        color: #856404;
      }

      .data-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      .data-table th,
      .data-table td {
        padding: 12px 15px;
        text-align: left;
        border-bottom: 1px solid #e9ecef;
      }

      .data-table th {
        background: #f8f9fa;
        font-weight: 600;
        color: #2c3e50;
        position: sticky;
        top: 0;
      }

      .data-table tr:hover {
        background: #f8f9fa;
      }

      .loading {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px;
      }

      .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #f3f3f3;
        border-top: 4px solid #4361ee;
        border-radius: 50%;
        animation: spin 1s linear infinite;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
      }

      .stat-card {
        background: white;
        padding: 20px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
      }

      .stat-card:hover {
        transform: translateY(-5px);
      }

      .stat-value {
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 5px;
      }

      .stat-label {
        color: #666;
        font-size: 0.9rem;
      }

      .search-box {
        width: 100%;
        margin-bottom: 20px;
        padding: 12px;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        font-size: 1rem;
      }

      .error-message {
        background: #f8d7da;
        color: #721c24;
        padding: 15px;
        border-radius: 8px;
        margin: 10px 0;
        border-left: 4px solid #dc3545;
      }

      .success-message {
        background: #d4edda;
        color: #155724;
        padding: 15px;
        border-radius: 8px;
        margin: 10px 0;
        border-left: 4px solid #28a745;
      }

      .comparison-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
      }

      .comparison-card {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        border: 2px solid #e9ecef;
      }

      .comparison-card h4 {
        margin-bottom: 10px;
        color: #2c3e50;
      }

      .rate-comparison {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        background: white;
        border-radius: 4px;
        margin: 5px 0;
      }

      .export-controls {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
      }

      @media (max-width: 768px) {
        .controls {
          grid-template-columns: 1fr;
        }

        .tabs {
          flex-direction: column;
        }

        .data-table {
          font-size: 0.9rem;
        }

        .comparison-row {
          grid-template-columns: 1fr;
        }

        .export-controls {
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <div class="system-status" id="system-status">System: Loading...</div>
        <h1>Medicare Compliance Testing Dashboard</h1>
        <p>
          Enhanced validation with direct database access and Medicare.gov
          comparison tools
        </p>
      </div>

      <div class="tabs">
        <button class="tab active" onclick="showTab('quick-test')"
          >Quick Test</button
        >
        <button class="tab" onclick="showTab('bulk-validation')"
          >Bulk Validation</button
        >
        <button class="tab" onclick="showTab('state-explorer')"
          >State Explorer</button
        >
        <button class="tab" onclick="showTab('data-integrity')"
          >Data Integrity</button
        >
        <button class="tab" onclick="showTab('medicare-comparison')"
          >Medicare Compare</button
        >
        <button class="tab" onclick="showTab('system-monitor')"
          >System Monitor</button
        >
      </div>

      <div class="tab-content">
        <!-- Quick Test Tab -->
        <div id="quick-test" class="tab-panel active">
          <h2>Quick Procedure Test</h2>
          <p>Test individual procedures with API and database validation</p>

          <div class="controls">
            <div class="form-group">
              <label for="test-state">State</label>
              <select id="test-state" onchange="updateCounties()">
                <option value="">Select State</option>
                <option value="FL">Florida</option>
                <option value="GA">Georgia</option>
              </select>
            </div>

            <div class="form-group">
              <label for="test-county">County</label>
              <select id="test-county">
                <option value="">Select County</option>
              </select>
            </div>

            <div class="form-group">
              <label for="test-cpt">CPT Code</label>
              <input type="text" id="test-cpt" placeholder="e.g., 72148" />
            </div>

            <div class="form-group">
              <label for="expected-rate">Expected Medicare Rate</label>
              <input
                type="number"
                id="expected-rate"
                step="0.01"
                placeholder="e.g., 196.34"
              />
            </div>

            <div class="form-group">
              <label>&nbsp;</label>
              <button class="btn btn-primary" onclick="runEnhancedQuickTest()"
                >Enhanced Test</button
              >
            </div>
          </div>

          <div id="quick-test-results" class="results-container"></div>
        </div>

        <!-- Bulk Validation Tab -->
        <div id="bulk-validation" class="tab-panel">
          <h2>Enhanced Bulk Validation</h2>
          <p>Comprehensive testing with database sampling and API validation</p>

          <div class="controls">
            <div class="form-group">
              <label for="bulk-state">State</label>
              <select id="bulk-state">
                <option value="">All States</option>
                <option value="FL">Florida</option>
                <option value="GA">Georgia</option>
              </select>
            </div>

            <div class="form-group">
              <label for="bulk-modality">Modality</label>
              <select id="bulk-modality">
                <option value="">All Modalities</option>
                <option value="MRI">MRI</option>
                <option value="CT">CT</option>
                <option value="X-Ray">X-Ray</option>
                <option value="Ultrasound">Ultrasound</option>
              </select>
            </div>

            <div class="form-group">
              <label for="sample-size">Sample Size</label>
              <select id="sample-size">
                <option value="25">25 procedures</option>
                <option value="50">50 procedures</option>
                <option value="100">100 procedures</option>
                <option value="200">200 procedures</option>
              </select>
            </div>

            <div class="form-group">
              <label>&nbsp;</label>
              <button
                class="btn btn-warning"
                onclick="runEnhancedBulkValidation()"
                >Database Sampling Test</button
              >
            </div>
          </div>

          <div class="stats-grid" id="bulk-stats" style="display: none;">
            <div class="stat-card">
              <div class="stat-value" id="total-tested">0</div>
              <div class="stat-label">Total Tested</div>
            </div>
            <div class="stat-card">
              <div class="stat-value" id="passed-tests">0</div>
              <div class="stat-label">Passed</div>
            </div>
            <div class="stat-card">
              <div class="stat-value" id="failed-tests">0</div>
              <div class="stat-label">Failed</div>
            </div>
            <div class="stat-card">
              <div class="stat-value" id="accuracy-rate">0%</div>
              <div class="stat-label">API-DB Consistency</div>
            </div>
          </div>

          <div id="bulk-validation-results" class="results-container"></div>
        </div>

        <!-- State Explorer Tab -->
        <div id="state-explorer" class="tab-panel">
          <h2>Enhanced State & County Explorer</h2>
          <p>Browse complete database with export capabilities</p>

          <div class="controls">
            <div class="form-group">
              <label for="explorer-state">State</label>
              <select id="explorer-state" onchange="updateExplorerCounties()">
                <option value="">Select State</option>
                <option value="FL">Florida</option>
                <option value="GA">Georgia</option>
              </select>
            </div>

            <div class="form-group">
              <label for="explorer-county">County</label>
              <select id="explorer-county">
                <option value="">Select County</option>
              </select>
            </div>

            <div class="form-group">
              <label for="explorer-modality">Filter by Modality</label>
              <select id="explorer-modality">
                <option value="">All Modalities</option>
                <option value="MRI">MRI</option>
                <option value="CT">CT</option>
                <option value="X-Ray">X-Ray</option>
                <option value="Ultrasound">Ultrasound</option>
                <option value="Nuclear Medicine">Nuclear Medicine</option>
                <option value="PET/CT">PET/CT</option>
              </select>
            </div>

            <div class="form-group">
              <label>&nbsp;</label>
              <button
                class="btn btn-success"
                onclick="exploreEnhancedStateCounty()"
                >Load from Database</button
              >
            </div>
          </div>

          <div
            class="export-controls"
            id="export-controls"
            style="display: none;"
          >
            <button class="btn btn-primary" onclick="exportToCSV()"
              >Export to CSV</button
            >
            <button class="btn btn-success" onclick="exportToExcel()"
              >Export to Excel</button
            >
            <button class="btn btn-warning" onclick="generateMedicareReport()"
              >Medicare Report</button
            >
          </div>

          <input
            type="text"
            id="procedure-search"
            class="search-box"
            placeholder="Search procedures by CPT code or description..."
            onkeyup="filterProcedures()"
            style="display: none;"
          />

          <div id="explorer-results" class="results-container"></div>
        </div>

        <!-- Data Integrity Tab -->
        <div id="data-integrity" class="tab-panel">
          <h2>Database Integrity Validation</h2>
          <p>Comprehensive data quality and consistency checks</p>

          <div class="controls">
            <div class="form-group">
              <label>&nbsp;</label>
              <button class="btn btn-primary" onclick="runDataIntegrityCheck()"
                >Full Integrity Check</button
              >
            </div>

            <div class="form-group">
              <label>&nbsp;</label>
              <button
                class="btn btn-warning"
                onclick="validateRVUCalculations()">Validate RVU Math</button
              >
            </div>

            <div class="form-group">
              <label>&nbsp;</label>
              <button class="btn btn-success" onclick="checkGPCIConsistency()"
                >GPCI Consistency</button
              >
            </div>

            <div class="form-group">
              <label>&nbsp;</label>
              <button class="btn btn-danger" onclick="findDataAnomalies()"
                >Find Anomalies</button
              >
            </div>
          </div>

          <div id="integrity-results" class="results-container"></div>
        </div>

        <!-- Medicare Comparison Tab -->
        <div id="medicare-comparison" class="tab-panel">
          <h2>Medicare.gov Rate Comparison</h2>
          <p>Compare your rates against official Medicare allowables</p>

          <div class="controls">
            <div class="form-group">
              <label for="compare-state">State</label>
              <select id="compare-state" onchange="updateCompareCounties()">
                <option value="">Select State</option>
                <option value="FL">Florida</option>
                <option value="GA">Georgia</option>
              </select>
            </div>

            <div class="form-group">
              <label for="compare-county">County</label>
              <select id="compare-county">
                <option value="">Select County</option>
              </select>
            </div>

            <div class="form-group">
              <label for="medicare-rates-input"
                >Medicare.gov Rates (CSV format)</label
              >
              <textarea
                id="medicare-rates-input"
                placeholder="CPT,Rate
72148,196.34
70551,193.58"
                rows="4"
                style="width: 100%; padding: 8px; border: 2px solid #e9ecef; border-radius: 4px;"
              ></textarea>
            </div>

            <div class="form-group">
              <label>&nbsp;</label>
              <button class="btn btn-primary" onclick="compareWithMedicare()"
                >Compare Rates</button
              >
            </div>
          </div>

          <div id="comparison-results" class="results-container"></div>
        </div>

        <!-- System Monitor Tab -->
        <div id="system-monitor" class="tab-panel">
          <h2>System Performance Monitor</h2>
          <p>Real-time system health and performance metrics</p>

          <div class="controls">
            <div class="form-group">
              <label>&nbsp;</label>
              <button class="btn btn-primary" onclick="runSystemHealthCheck()"
                >Health Check</button
              >
            </div>

            <div class="form-group">
              <label>&nbsp;</label>
              <button class="btn btn-success" onclick="validateAllStates()"
                >Validate All States</button
              >
            </div>

            <div class="form-group">
              <label>&nbsp;</label>
              <button class="btn btn-warning" onclick="stressTestAPIs()"
                >Stress Test APIs</button
              >
            </div>
          </div>

          <div class="stats-grid" id="system-stats">
            <div class="stat-card">
              <div class="stat-value" id="total-procedures">0</div>
              <div class="stat-label">Total Procedures</div>
            </div>
            <div class="stat-card">
              <div class="stat-value" id="total-states">0</div>
              <div class="stat-label">States Covered</div>
            </div>
            <div class="stat-card">
              <div class="stat-value" id="total-counties">0</div>
              <div class="stat-label">Counties Available</div>
            </div>
            <div class="stat-card">
              <div class="stat-value" id="avg-response-time">0ms</div>
              <div class="stat-label">Avg Response Time</div>
            </div>
          </div>

          <div id="system-monitor-results" class="results-container"></div>
        </div>
      </div>
    </div>

    <script type="module">
      // Import Supabase client
      import { createClient } from "https://cdn.skypack.dev/@supabase/supabase-js";

      // Initialize Supabase with server-provided credentials
      const SUPABASE_URL = `{SUPABASE_URL}`;
      const SUPABASE_ANON_KEY = `{SUPABASE_ANON_KEY}`;
      const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      // Make supabase available globally
      window.supabase = supabase;

      // County mappings
      window.stateCounties = {
        FL: [
          "Miami-Dade",
          "Monroe",
          "Broward",
          "Collier",
          "Indian River",
          "Lee",
          "Martin",
          "Palm Beach",
          "St. Lucie",
          "All Other Florida Counties",
        ],
        GA: [
          "Butts",
          "Cherokee",
          "Clayton",
          "Cobb",
          "DeKalb",
          "Douglas",
          "Fayette",
          "Forsyth",
          "Fulton",
          "Gwinnett",
          "Henry",
          "Newton",
          "Paulding",
          "Rockdale",
          "Walton",
          "All Other Georgia Counties",
        ],
      };

      let allProcedures = [];
      let currentData = [];

      // Tab management
      window.showTab = function (tabName) {
        document.querySelectorAll(".tab-panel").forEach((panel) => {
          panel.classList.remove("active");
        });

        document.querySelectorAll(".tab").forEach((tab) => {
          tab.classList.remove("active");
        });

        document.getElementById(tabName).classList.add("active");
        event.target.classList.add("active");
      };

      // County update functions
      window.updateCounties = function () {
        const stateSelect = document.getElementById("test-state");
        const countySelect = document.getElementById("test-county");
        updateCountyDropdown(stateSelect.value, countySelect);
      };

      window.updateExplorerCounties = function () {
        const stateSelect = document.getElementById("explorer-state");
        const countySelect = document.getElementById("explorer-county");
        updateCountyDropdown(stateSelect.value, countySelect);
      };

      window.updateCompareCounties = function () {
        const stateSelect = document.getElementById("compare-state");
        const countySelect = document.getElementById("compare-county");
        updateCountyDropdown(stateSelect.value, countySelect);
      };

      function updateCountyDropdown(state, countySelect) {
        countySelect.innerHTML = '<option value="">Select County</option>';

        if (state && window.stateCounties[state]) {
          window.stateCounties[state].forEach((county) => {
            const option = document.createElement("option");
            option.value = county;
            option.textContent = county;
            countySelect.appendChild(option);
          });
        }
      }

      // Enhanced Quick Test
      window.runEnhancedQuickTest = async function () {
        const state = document.getElementById("test-state").value;
        const county = document.getElementById("test-county").value;
        const cpt = document.getElementById("test-cpt").value;
        const expectedRate = parseFloat(
          document.getElementById("expected-rate").value
        );

        if (!state || !county || !cpt) {
          showError("quick-test-results", "Please fill in all required fields");
          return;
        }

        const resultsDiv = document.getElementById("quick-test-results");
        resultsDiv.innerHTML =
          '<div class="loading"><div class="spinner"></div></div>';

        try {
          // Get data from both API and database
          const [apiData, dbData] = await Promise.all([
            getAPIData(cpt, county, state),
            getDirectDBData(cpt, county, state),
          ]);

          displayEnhancedQuickResults(apiData, dbData, expectedRate);
        } catch (error) {
          showError(
            "quick-test-results",
            `Enhanced test failed: ${error.message}`
          );
        }
      };

      async function getAPIData(cpt, county, state) {
        const response = await fetch(
          `/api/pricing/calculate-db?cpt=${cpt}&county=${encodeURIComponent(county)}&state=${state}`
        );

        if (!response.ok) {
          throw new Error(`API Error: ${response.status}`);
        }

        const data = await response.json();

        if (data.error) {
          throw new Error(`API Error: ${data.error}`);
        }

        return data;
      }

      async function getDirectDBData(cpt, county, state) {
        const { data, error } = await supabase
          .from("medicare_pricing")
          .select("*")
          .eq("cpt_code", cpt)
          .eq("county", county)
          .eq("state", state)
          .single();

        if (error) {
          throw new Error(`Database Error: ${error.message}`);
        }

        if (!data) {
          throw new Error("No data found in database");
        }

        return data;
      }

      function displayEnhancedQuickResults(apiData, dbData, expectedRate) {
        const resultsDiv = document.getElementById("quick-test-results");

        const apiRate = parseFloat(apiData.pricing.medicare_rate);
        const dbRate = parseFloat(dbData.medicare_rate);
        const apiDbDiff = Math.abs(apiRate - dbRate);
        const apiDbMatch = apiDbDiff < 0.01;

        let expectedComparison = "";
        if (expectedRate) {
          const expectedDiff = Math.abs(apiRate - expectedRate);
