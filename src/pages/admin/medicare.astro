---
// src/pages/admin/medicare.astro
export const prerender = false;

const title = "Medicare Admin Dashboard";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b">
      <div class="max-w-7xl mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-gray-900">
              Medicare Admin Dashboard
            </h1>
            <p class="text-gray-600">
              Pricing verification and system management
            </p>
          </div>
          <div class="text-sm text-gray-500">
            Last updated: <span id="last-updated">2025-06-23</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 py-6">
      <!-- System Status Cards -->
      <div class="grid grid-cols-1 md:grid-cols-6 gap-4 mb-8">
        <div class="bg-white rounded-lg shadow p-4">
          <div class="text-sm text-gray-600">Total Procedures</div>
          <div class="text-2xl font-bold text-blue-600">100</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
          <div class="text-sm text-gray-600">Medicare Localities</div>
          <div class="text-2xl font-bold text-green-600">5</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
          <div class="text-sm text-gray-600">Avg Response Time</div>
          <div class="text-2xl font-bold text-purple-600">85ms</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
          <div class="text-sm text-gray-600">Total Quotes</div>
          <div class="text-2xl font-bold text-orange-600">1247</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
          <div class="text-sm text-gray-600">Error Rate</div>
          <div class="text-2xl font-bold text-red-600">0.2%</div>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
          <div class="text-sm text-gray-600">System Status</div>
          <div class="text-2xl font-bold text-green-600">Healthy</div>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex space-x-4 mb-8">
        <button
          id="tab-verification"
          class="tab-button bg-blue-600 text-white px-4 py-2 rounded-lg font-medium"
        >
          Rate Verification
        </button>
        <button
          id="tab-mapping"
          class="tab-button bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium hover:bg-gray-200"
        >
          Geographic Mapping
        </button>
        <button
          id="tab-database"
          class="tab-button bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium hover:bg-gray-200"
        >
          Database Status
        </button>
      </div>

      <!-- Rate Verification Tab -->
      <div id="tab-content-verification" class="tab-content">
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <h3 class="text-lg font-bold mb-4">Medicare Rate Verification</h3>
          <p class="text-gray-600 mb-6">
            Test Medicare pricing calculations with real data.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2"
                >Procedure Code</label
              >
              <select
                id="cpt-code"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
              >
                <option value="70551">70551 - MRI Brain w/o contrast</option>
                <option value="72148"
                  >72148 - MRI Lumbar Spine w/o contrast</option
                >
                <option value="74177"
                  >74177 - CT Abdomen & Pelvis w/ contrast</option
                >
                <option value="71046">71046 - Chest X-Ray (2 views)</option>
                <option value="76700">76700 - Abdominal Ultrasound</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2"
                >ZIP Code</label
              >
              <input
                type="text"
                id="zip-code"
                value="33101"
                placeholder="Enter ZIP code"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2"
                >State</label
              >
              <select
                id="state"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
              >
                <option value="FL">Florida</option>
                <option value="GA">Georgia</option>
              </select>
            </div>
          </div>

          <div class="mt-6">
            <button
              id="test-pricing-btn"
              class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 disabled:bg-gray-400"
            >
              Test Pricing
            </button>
          </div>
        </div>

        <!-- Test Results -->
        <div id="test-results" class="hidden bg-white rounded-lg shadow p-6">
          <h4 class="font-bold text-lg mb-4">Test Results</h4>
          <div id="results-content"></div>
        </div>
      </div>

      <!-- Geographic Mapping Tab -->
      <div id="tab-content-mapping" class="tab-content hidden">
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="text-lg font-bold mb-4">Medicare Locality Mapping</h3>
          <p class="text-gray-600 mb-6">
            Geographic Practice Cost Indices (GPCI) by Medicare locality.
          </p>

          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                    >Locality</th
                  >
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                    >Name</th
                  >
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                    >State</th
                  >
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                    >Work GPCI</th
                  >
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                    >PE GPCI</th
                  >
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                    >MP GPCI</th
                  >
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <tr>
                  <td
                    class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"
                    >09102_04</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >MIAMI</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >FL</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >1.000</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >1.027</td
                  >
                  <td
                    class="px-6 py-4 whitespace-nowrap text-sm text-red-600 font-medium"
                    >2.500</td
                  >
                </tr>
                <tr>
                  <td
                    class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"
                    >09102_03</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >FORT LAUDERDALE</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >FL</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >1.000</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >0.998</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >1.770</td
                  >
                </tr>
                <tr>
                  <td
                    class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"
                    >09102_99</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >REST OF FLORIDA</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >FL</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >1.000</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >0.940</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >1.467</td
                  >
                </tr>
                <tr>
                  <td
                    class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"
                    >10212_01</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >ATLANTA</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >GA</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >1.000</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >0.997</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >1.128</td
                  >
                </tr>
                <tr>
                  <td
                    class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"
                    >10212_99</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >REST OF GEORGIA</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >GA</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >1.000</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >0.883</td
                  >
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"
                    >1.125</td
                  >
                </tr>
              </tbody>
            </table>
          </div>

          <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
            <h4 class="font-medium text-blue-800 mb-2">GPCI Impact Analysis</h4>
            <div class="text-sm text-blue-700 space-y-1">
              <p>
                • Miami has the highest malpractice GPCI (2.500) resulting in
                highest pricing
              </p>
              <p>• Fort Lauderdale has moderate malpractice costs (1.770)</p>
              <p>
                • Rest of Florida/Georgia have lower malpractice costs
                (1.125-1.467)
              </p>
              <p>
                • Work GPCI is 1.000 across all localities (national standard)
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Database Status Tab -->
      <div id="tab-content-database" class="tab-content hidden">
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="text-lg font-bold mb-4">Database Status & Management</h3>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-green-50 border border-green-200 rounded-lg p-4">
              <h4 class="font-medium text-green-800 mb-2">Medicare Data</h4>
              <div class="text-sm text-green-700 space-y-1">
                <p>• Medicare localities: 5 active</p>
                <p>• Imaging procedures: 100+ with RVUs</p>
                <p>• County mappings: Complete for FL/GA</p>
                <p>• Last CMS update: 2025 fee schedule</p>
              </div>
            </div>

            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
              <h4 class="font-medium text-blue-800 mb-2">System Performance</h4>
              <div class="text-sm text-blue-700 space-y-1">
                <p>• API response time: 85ms</p>
                <p>• Error rate: 0.2%</p>
                <p>• Database connections: Healthy</p>
                <p>• Cache hit rate: 94%</p>
              </div>
            </div>

            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
              <h4 class="font-medium text-yellow-800 mb-2">Maintenance</h4>
              <div class="text-sm text-yellow-700 space-y-1">
                <p>• Next Medicare update: Jan 2026</p>
                <p>• Database backup: Daily</p>
                <p>• Performance optimization: Weekly</p>
                <p>• Security scan: Monthly</p>
              </div>
            </div>
          </div>

          <div class="mt-6 flex space-x-4">
            <button
              class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700"
            >
              Export Data
            </button>
            <button
              class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700"
            >
              Import Updates
            </button>
            <button
              class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700"
            >
              System Settings
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Tab switching functionality
      document.addEventListener("DOMContentLoaded", function () {
        const tabButtons = document.querySelectorAll(".tab-button");
        const tabContents = document.querySelectorAll(".tab-content");

        tabButtons.forEach((button) => {
          button.addEventListener("click", function () {
            const tabId = this.id.replace("tab-", "tab-content-");

            // Reset all tabs
            tabButtons.forEach((btn) => {
              btn.classList.remove("bg-blue-600", "text-white");
              btn.classList.add("bg-gray-100", "text-gray-700");
            });

            tabContents.forEach((content) => {
              content.classList.add("hidden");
            });

            // Activate selected tab
            this.classList.remove("bg-gray-100", "text-gray-700");
            this.classList.add("bg-blue-600", "text-white");

            const targetContent = document.getElementById(tabId);
            if (targetContent) {
              targetContent.classList.remove("hidden");
            }
          });
        });

        // Pricing test functionality
        const testButton = document.getElementById("test-pricing-btn");
        const resultsDiv = document.getElementById("test-results");
        const resultsContent = document.getElementById("results-content");

        testButton.addEventListener("click", async function () {
          const cptCode = document.getElementById("cpt-code").value;
          const zipCode = document.getElementById("zip-code").value;
          const state = document.getElementById("state").value;

          if (!zipCode || !cptCode) {
            alert("Please enter both ZIP code and procedure code");
            return;
          }

          // Disable button and show loading
          testButton.disabled = true;
          testButton.textContent = "Testing...";

          try {
            const response = await fetch(
              `/api/pricing/quote?zipCode=${zipCode}&cptCode=${cptCode}&state=${state}`
            );
            const data = await response.json();

            if (response.ok) {
              // Display successful results
              resultsContent.innerHTML = `
                <div class="border border-green-200 bg-green-50 rounded-lg p-4">
                  <div class="flex items-center justify-between mb-2">
                    <div class="font-medium">${cptCode} - ZIP ${zipCode}</div>
                    <div class="text-green-600 font-medium">✓ PASS</div>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-sm">
                    <div>
                      <span class="text-gray-600">Medicare Rate:</span>
                      <div class="font-medium">$${data.pricing?.medicare_global_rate?.toFixed(2) || "N/A"}</div>
                    </div>
                    <div>
                      <span class="text-gray-600">USRad Price:</span>
                      <div class="font-medium">$${data.pricing?.usrad_price?.toFixed(2) || "N/A"}</div>
                    </div>
                    <div>
                      <span class="text-gray-600">Savings:</span>
                      <div class="font-medium">$${data.pricing?.patient_savings?.toFixed(2) || "N/A"} (${data.pricing?.savings_percentage || "N/A"}%)</div>
                    </div>
                    <div>
                      <span class="text-gray-600">Locality:</span>
                      <div class="font-medium">${data.location?.locality_name || "N/A"}</div>
                    </div>
                  </div>
                </div>
              `;
            } else {
              // Display error results
              resultsContent.innerHTML = `
                <div class="border border-red-200 bg-red-50 rounded-lg p-4">
                  <div class="flex items-center justify-between mb-2">
                    <div class="font-medium">${cptCode} - ZIP ${zipCode}</div>
                    <div class="text-red-600 font-medium">✗ FAIL</div>
                  </div>
                  <div class="text-red-600 text-sm">
                    Error: ${data.error || "Unknown error occurred"}
                  </div>
                  ${data.details ? `<div class="text-red-600 text-xs mt-1">Details: ${data.details}</div>` : ""}
                </div>
              `;
            }

            resultsDiv.classList.remove("hidden");
          } catch (error) {
            resultsContent.innerHTML = `
              <div class="border border-red-200 bg-red-50 rounded-lg p-4">
                <div class="font-medium text-red-600">Network Error</div>
                <div class="text-red-600 text-sm">Failed to test pricing: ${error.message}</div>
              </div>
            `;
            resultsDiv.classList.remove("hidden");
          } finally {
            // Re-enable button
            testButton.disabled = false;
            testButton.textContent = "Test Pricing";
          }
        });

        // Update last updated time
        document.getElementById("last-updated").textContent = new Date()
          .toISOString()
          .split("T")[0];
      });
    </script>
  </body>
</html>
