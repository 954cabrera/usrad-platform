// Categories with post counts
const categories = [
  { name: "All Posts", count: 11, active: true },
  { name: "Patient Guide", count: 4 },
  { name: "Cost & Savings", count: 3 },
  { name: "Health & Wellness", count: 2 },
  { name: "Innovation", count: 1 },
  { name: "Healthcare Policy", count: 1 },
