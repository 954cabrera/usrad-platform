  <style>
    .line-clamp-3 {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    @keyframes blob {
      0%,
      100% {
        transform: translate(0px, 0px) scale(1);
      }
      33% {
        transform: translate(30px, -50px) scale(1.1);
      }
      66% {
        transform: translate(-20px, 20px) scale(0.9);
      }
    }

    .animate-blob {
      animation: blob 7s infinite;
    }

    .animation-delay-2000 {
      animation-delay: 2s;
    }

    .animation-delay-4000 {
      animation-delay: 4s;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const categoryButtons = document.querySelectorAll("[data-category-btn]");
      const articles = document.querySelectorAll("[data-article-category]");
      const loadMoreBtn = document.getElementById("load-more-btn");

      let articlesPerPage = 6;
      let currentlyVisible = articlesPerPage;

      // Function to show/hide articles based on current count
      function updateArticleVisibility() {
        const visibleArticles = Array.from(articles).filter(
          (article) => article.style.display !== "none"
        );

        visibleArticles.forEach((article, index) => {
          if (index < currentlyVisible) {
            article.classList.remove("hidden");
          } else {
            article.classList.add("hidden");
          }
        });

        // Hide load more button if all visible articles are shown
        if (currentlyVisible >= visibleArticles.length) {
          loadMoreBtn?.classList.add("hidden");
        } else {
          loadMoreBtn?.classList.remove("hidden");
        }
      }

      // Initial setup - hide articles beyond the first 6
      updateArticleVisibility();

      // Load More button functionality
      loadMoreBtn?.addEventListener("click", () => {
        currentlyVisible += articlesPerPage;
        updateArticleVisibility();
      });

      // Category filter functionality
      categoryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const selectedCategory = button.dataset.categoryBtn;

          categoryButtons.forEach((btn) => {
            btn.classList.remove("bg-[#003087]", "text-white", "shadow-md");
            btn.classList.add(
              "bg-gray-50",
              "text-gray-700",
              "border",
              "border-gray-200"
            );
          });
          button.classList.remove(
            "bg-gray-50",
            "text-gray-700",
            "border",
            "border-gray-200"
          );
          button.classList.add("bg-[#003087]", "text-white", "shadow-md");

          // Filter articles by category
          articles.forEach((article) => {
            const articleCategory = article.dataset.articleCategory;
            if (
              selectedCategory === "All Posts" ||
              articleCategory === selectedCategory
            ) {
              article.style.display = "block";
            } else {
              article.style.display = "none";
            }
          });

          // Reset pagination when category changes
          currentlyVisible = articlesPerPage;
          updateArticleVisibility();

          // Smooth scroll to articles section
          const articlesSection = document.getElementById("articles-section");
          if (articlesSection) {
            const offset = 100; // Adjust this value to control how much space above the section
            const elementPosition = articlesSection.getBoundingClientRect().top;
            const offsetPosition =
              elementPosition + window.pageYOffset - offset;

            window.scrollTo({
              top: offsetPosition,
              behavior: "smooth",
            });
          }
        });
      });
    });
  </script>
