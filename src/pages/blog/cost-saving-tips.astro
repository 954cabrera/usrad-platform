---
import CarbonLayout from "../../layouts/CarbonLayout.astro";
import AOSInit from "../../components/AOSInit.astro";
import { getRelatedPosts } from "../../data/blogPosts.js";

export const prerender = true;

// Specify which related posts to show (just the slugs!)
const relatedPostSlugs = [
  "real-cost-of-mri",
  "uninsured-imaging-guide",
  "price-transparency-healthcare",
];

// Get the full post data automatically from blogPosts.js
const relatedArticles = getRelatedPosts("cost-saving-tips", relatedPostSlugs);
---

<CarbonLayout
  title="Cost Saving Tips: How to Reduce Medical Imaging Expenses | USRad"
  description="Learn proven strategies to save hundreds or thousands on MRI, CT scans, and ultrasounds. Expert money-saving tips from the USRad Healthcare Team."
>
  <AOSInit />

  <!-- Hero Section -->
  <section
    class="relative bg-gradient-to-br from-yellow-50 via-white to-orange-50/30 pt-24 pb-16 overflow-hidden"
  >
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-40">
      <div
        class="absolute top-20 right-20 w-72 h-72 bg-yellow-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob"
      >
      </div>
      <div
        class="absolute top-40 left-20 w-72 h-72 bg-orange-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"
      >
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <!-- Breadcrumb -->
      <nav class="mb-8" data-aos="fade-up">
        <ol class="flex items-center gap-2 text-sm text-gray-600">
          <li>
            <a href="/blog" class="hover:text-[#003087] transition">Blog</a>
          </li>
          <li><span class="text-gray-400">/</span></li>
          <li>
            <a
              href="/blog/topic/cost-saving-tips"
              class="hover:text-[#003087] transition">Cost Saving Tips</a
            >
          </li>
          <li><span class="text-gray-400">/</span></li>
          <li class="text-gray-900 font-medium">Complete Guide</li>
        </ol>
      </nav>

      <!-- Title Section -->
      <div class="max-w-3xl" data-aos="fade-up" data-aos-delay="100">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-yellow-100 text-yellow-700 rounded-full text-sm font-medium mb-6"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"
            ></path>
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z"
              clip-rule="evenodd"></path>
          </svg>
          Cost Saving Tips • Money-Saving Guide
        </div>

        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight"
        >
          How to Reduce Your Medical Imaging Expenses
        </h1>

        <p class="text-xl text-gray-600 leading-relaxed mb-8">
          Discover proven strategies to save hundreds—even thousands—on MRIs, CT
          scans, ultrasounds, and X-rays without sacrificing quality.
        </p>

        <!-- Author & Date -->
        <div
          class="flex flex-wrap items-center gap-6 pb-8 border-b border-gray-200"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-12 h-12 bg-gradient-to-br from-[#cc9933] to-yellow-600 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">USRad Healthcare Team</p>
              <p class="text-sm text-gray-600">
                Healthcare Cost Transparency Experts
              </p>
            </div>
          </div>
          <div class="flex items-center gap-4 text-sm text-gray-600">
            <span>Updated July 2025</span>
            <span>•</span>
            <span>10 min read</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <article class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Key Takeaway Banner -->
      <div
        class="bg-gradient-to-r from-[#cc9933] to-yellow-600 rounded-2xl p-8 mb-12 text-white"
        data-aos="fade-up"
      >
        <h2 class="text-2xl font-bold mb-3">💰 The Bottom Line</h2>
        <p class="text-lg text-yellow-50">
          Medical imaging prices can vary by <strong>300-400%</strong> for the exact
          same scan. By following these strategies, you can save an average of <strong
            >$1,500-$3,000</strong
          > on your next MRI, CT scan, or ultrasound.
        </p>
      </div>

      <!-- Table of Contents -->
      <div
        class="bg-gradient-to-br from-yellow-50 to-white rounded-2xl p-8 mb-12 border border-yellow-100"
        data-aos="fade-up"
      >
        <h2
          class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"
        >
          <svg
            class="w-5 h-5 text-[#cc9933]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          Money-Saving Strategies
        </h2>
        <ul class="space-y-2 text-gray-700">
          <li>
            <a href="#shop-around" class="hover:text-[#cc9933] transition"
              >Shop Around for the Best Price</a
            >
          </li>
          <li>
            <a
              href="#independent-centers"
              class="hover:text-[#cc9933] transition"
              >Use Independent Imaging Centers</a
            >
          </li>
          <li>
            <a href="#cash-pay" class="hover:text-[#cc9933] transition"
              >Ask About Cash/Self-Pay Rates</a
            >
          </li>
          <li>
            <a href="#negotiate" class="hover:text-[#cc9933] transition"
              >Negotiate Before You Schedule</a
            >
          </li>
          <li>
            <a href="#insurance-tricks" class="hover:text-[#cc9933] transition"
              >Understand Your Insurance</a
            >
          </li>
          <li>
            <a href="#timing" class="hover:text-[#cc9933] transition"
              >Time Your Scan Strategically</a
            >
          </li>
          <li>
            <a href="#bundling" class="hover:text-[#cc9933] transition"
              >Bundle Multiple Scans</a
            >
          </li>
          <li>
            <a href="#payment-plans" class="hover:text-[#cc9933] transition"
              >Use Payment Plans & Financial Assistance</a
            >
          </li>
        </ul>
      </div>

      <!-- Featured Image Section -->
      <div class="mb-12" data-aos="fade-up">
        <div
          class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-yellow-100 to-orange-100 aspect-video flex items-center justify-center"
        >
          <!-- Placeholder for image - replace src with actual image path -->
          <img
            src="/images/blog/patient-reviewing-cost.webp"
            alt="Patient reviewing medical imaging costs and savings options"
            class="w-full h-full object-cover"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"
          >
          </div>
        </div>
        <p class="text-sm text-gray-600 text-center mt-3 italic">
          Smart consumers save thousands by comparing prices before booking
          medical imaging
        </p>
      </div>

      <!-- Content Section 1: Shop Around -->
      <section
        id="shop-around"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-[#cc9933] to-yellow-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >1</span
          >
          Shop Around for the Best Price
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p class="text-lg">
            <strong>This is the single most important tip:</strong> Medical imaging
            prices vary wildly—even within the same city. The same MRI can cost $400
            at one facility and $3,000 at another.
          </p>

          <div
            class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-lg my-6"
          >
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              Real Example: Miami MRI Costs
            </h3>
            <div class="space-y-2 text-gray-700">
              <p>• <strong>Hospital A:</strong> $4,200 for knee MRI</p>
              <p>• <strong>Hospital B:</strong> $3,800 for knee MRI</p>
              <p>• <strong>Imaging Center:</strong> $1,200 for knee MRI</p>
              <p>• <strong>USRad:</strong> $395 for knee MRI</p>
            </div>
            <p class="text-sm text-red-700 font-semibold mt-4">
              Potential savings: <strong>$3,805</strong> (90% off hospital price!)
            </p>
          </div>

          <div class="bg-blue-50 rounded-xl p-6 my-6 border border-blue-200">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              How to Compare Prices
            </h3>
            <ol class="space-y-3 text-gray-700">
              <li class="flex gap-3">
                <span class="font-bold text-[#003087]">1.</span>
                <span
                  ><strong>Get the CPT code</strong> from your doctor's referral
                  (e.g., 73721 for knee MRI)</span
                >
              </li>
              <li class="flex gap-3">
                <span class="font-bold text-[#003087]">2.</span>
                <span
                  ><strong>Call 5-10 facilities</strong> in your area and ask for
                  cash/self-pay price</span
                >
              </li>
              <li class="flex gap-3">
                <span class="font-bold text-[#003087]">3.</span>
                <span
                  ><strong>Use price transparency websites</strong> like Fair Health
                  Consumer or Healthcare Bluebook</span
                >
              </li>
              <li class="flex gap-3">
                <span class="font-bold text-[#003087]">4.</span>
                <span
                  ><strong>Check USRad's pricing</strong> for instant transparent
                  quotes</span
                >
              </li>
            </ol>
          </div>
        </div>
      </section>

      <!-- Content Section 2: Independent Centers -->
      <section
        id="independent-centers"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-[#cc9933] to-yellow-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >2</span
          >
          Use Independent Imaging Centers
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p>
            Hospital-based imaging is often <strong>2-4x more expensive</strong>
            than independent imaging centers—but the quality is identical. Both use
            the same FDA-approved equipment and board-certified radiologists.
          </p>

          <div class="grid md:grid-cols-2 gap-6 my-8">
            <div class="bg-white border-2 border-red-200 rounded-xl p-6">
              <div class="flex items-center gap-2 mb-4">
                <svg
                  class="w-6 h-6 text-red-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                    clip-rule="evenodd"></path>
                </svg>
                <h3 class="text-xl font-bold text-gray-900">
                  Hospital Imaging
                </h3>
              </div>
              <ul class="space-y-2 text-sm text-gray-700">
                <li>✗ Higher facility fees</li>
                <li>✗ Administrative overhead</li>
                <li>✗ Less price transparency</li>
                <li>✗ Longer wait times</li>
                <li>✗ Complex billing</li>
              </ul>
              <div class="mt-4 pt-4 border-t border-red-200">
                <p class="text-2xl font-bold text-red-600">$2,500-$5,000</p>
                <p class="text-sm text-gray-600">Average MRI cost</p>
              </div>
            </div>

            <div class="bg-white border-2 border-green-200 rounded-xl p-6">
              <div class="flex items-center gap-2 mb-4">
                <svg
                  class="w-6 h-6 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <h3 class="text-xl font-bold text-gray-900">
                  Independent Centers
                </h3>
              </div>
              <ul class="space-y-2 text-sm text-gray-700">
                <li>✓ Lower overhead costs</li>
                <li>✓ Transparent pricing</li>
                <li>✓ Same quality equipment</li>
                <li>✓ Faster appointments</li>
                <li>✓ Simple billing</li>
              </ul>
              <div class="mt-4 pt-4 border-t border-green-200">
                <p class="text-2xl font-bold text-green-600">$250-$1,200</p>
                <p class="text-sm text-gray-600">Average MRI cost</p>
              </div>
            </div>
          </div>

          <div
            class="bg-green-50 border-l-4 border-green-500 p-6 rounded-r-lg my-6"
          >
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              Quality Assurance
            </h3>
            <p class="text-gray-700">
              All imaging centers must meet the same accreditation standards
              (ACR, IAC) regardless of whether they're hospital-based or
              independent. Your results will be read by the same board-certified
              radiologists.
            </p>
          </div>
        </div>
      </section>

      <!-- Content Section 3: Cash Pay -->
      <section
        id="cash-pay"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-[#cc9933] to-yellow-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >3</span
          >
          Ask About Cash/Self-Pay Rates
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p>
            This might sound counterintuitive, but <strong
              >paying cash can be cheaper than using insurance</strong
            >—especially if you have a high deductible plan.
          </p>

          <div
            class="bg-yellow-50 border-l-4 border-[#cc9933] p-6 rounded-r-lg my-6"
          >
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              The Insurance Paradox
            </h3>
            <div class="space-y-3 text-gray-700">
              <p><strong>With Insurance:</strong></p>
              <ul class="ml-6 space-y-1">
                <li>• Hospital bills insurance: $3,500</li>
                <li>• Insurance "negotiated rate": $2,800</li>
                <li>• You pay deductible: $2,800</li>
                <li>• <strong>Your cost: $2,800</strong></li>
              </ul>
              <p class="mt-4">
                <strong>Cash/Self-Pay at Independent Center:</strong>
              </p>
              <ul class="ml-6 space-y-1">
                <li>• Facility quotes cash price: $450</li>
                <li>• No insurance involved</li>
                <li>• <strong>Your cost: $450</strong></li>
              </ul>
              <p class="font-bold text-[#cc9933] text-lg mt-4">
                Savings: $2,350 by paying cash!
              </p>
            </div>
          </div>

          <div class="bg-blue-50 rounded-xl p-6 my-6 border border-blue-200">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              When to Use Cash vs Insurance
            </h3>
            <div class="grid md:grid-cols-2 gap-4 text-sm">
              <div>
                <p class="font-semibold text-green-700 mb-2">✓ Use Cash If:</p>
                <ul class="space-y-1 text-gray-700">
                  <li>• You have high deductible ($1,000+)</li>
                  <li>• Haven't met deductible yet</li>
                  <li>• Cash price is lower than deductible</li>
                  <li>• Faster appointment availability</li>
                  <li>• You're uninsured</li>
                </ul>
              </div>
              <div>
                <p class="font-semibold text-blue-700 mb-2">
                  ✓ Use Insurance If:
                </p>
                <ul class="space-y-1 text-gray-700">
                  <li>• Low or no deductible</li>
                  <li>• Already met deductible</li>
                  <li>• Good coverage with low copay</li>
                  <li>• Approaching out-of-pocket max</li>
                  <li>• Need for HSA/FSA reimbursement</li>
                </ul>
              </div>
            </div>
          </div>

          <p class="font-semibold text-gray-900">
            Pro Tip: Always ask for both the insurance price AND the cash price
            before booking. Choose whichever is lower!
          </p>
        </div>
      </section>

      <!-- Content Section 4: Negotiate -->
      <section
        id="negotiate"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-[#cc9933] to-yellow-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >4</span
          >
          Negotiate Before You Schedule
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p>
            Medical prices are more negotiable than you think. Facilities would
            rather give you a discount than lose your business entirely.
          </p>

          <div
            class="bg-gradient-to-br from-gray-50 to-white rounded-2xl p-8 my-6 border border-gray-200"
          >
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              Negotiation Script
            </h3>

            <div class="space-y-6">
              <div class="border-l-4 border-[#003087] pl-4">
                <p class="font-semibold text-gray-900 mb-2">
                  Step 1: Get Quote
                </p>
                <p class="text-sm text-gray-600 italic">
                  "Hi, I need a [scan type] and I'm comparing prices. What's
                  your best cash price for CPT code [XXXXX]?"
                </p>
              </div>

              <div class="border-l-4 border-[#003087] pl-4">
                <p class="font-semibold text-gray-900 mb-2">
                  Step 2: Mention Competition
                </p>
                <p class="text-sm text-gray-600 italic">
                  "I've gotten quotes from other facilities for around $[lower
                  price]. Can you match or beat that?"
                </p>
              </div>

              <div class="border-l-4 border-[#003087] pl-4">
                <p class="font-semibold text-gray-900 mb-2">
                  Step 3: Ask for Discounts
                </p>
                <p class="text-sm text-gray-600 italic">
                  "Do you offer any discounts for paying upfront? What about
                  financial assistance programs?"
                </p>
              </div>

              <div class="border-l-4 border-[#003087] pl-4">
                <p class="font-semibold text-gray-900 mb-2">
                  Step 4: Be Willing to Walk
                </p>
                <p class="text-sm text-gray-600 italic">
                  "That's still higher than I was hoping. I'll need to check
                  with other facilities. Can you do any better?"
                </p>
              </div>
            </div>
          </div>

          <div class="grid md:grid-cols-3 gap-4 my-6">
            <div class="bg-green-50 rounded-lg p-4 border border-green-200">
              <p class="text-2xl font-bold text-green-700 mb-1">10-30%</p>
              <p class="text-sm text-gray-600">
                Average discount from negotiation
              </p>
            </div>
            <div class="bg-blue-50 rounded-lg p-4 border border-blue-200">
              <p class="text-2xl font-bold text-blue-700 mb-1">$300-$900</p>
              <p class="text-sm text-gray-600">Typical savings per MRI</p>
            </div>
            <div class="bg-purple-50 rounded-lg p-4 border border-purple-200">
              <p class="text-2xl font-bold text-purple-700 mb-1">2-5 calls</p>
              <p class="text-sm text-gray-600">
                Average calls needed to find best price
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Content Section 5: Insurance Tricks -->
      <section
        id="insurance-tricks"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-[#cc9933] to-yellow-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >5</span
          >
          Understand Your Insurance
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p>
            Many people overpay because they don't understand how their
            insurance actually works. Here's what you need to know:
          </p>

          <div class="space-y-4 my-6">
            <div
              class="bg-white border border-gray-200 rounded-xl p-6 hover:border-[#003087] transition"
            >
              <h3 class="text-lg font-semibold text-gray-900 mb-2">
                Check if Pre-Authorization is Required
              </h3>
              <p class="text-gray-600 mb-2">
                Some insurance plans require approval before imaging. Getting
                scanned without authorization can result in <strong
                  >denied claims</strong
                > and you paying the full cost.
              </p>
              <p class="text-sm text-[#003087] font-medium">
                Action: Call your insurance before booking to confirm
                requirements
              </p>
            </div>

            <div
