---
import CarbonLayout from "../../layouts/CarbonLayout.astro";
import AOSInit from "../../components/AOSInit.astro";
import { getRelatedPosts } from "../../data/blogPosts.js";

export const prerender = true;

// Specify which related posts to show - Patient Guide posts work well together!
const relatedPostSlugs = [
  "managing-mri-anxiety",
  "mri-basics",
  "understanding-mri-results",
];

// Get the full post data automatically from blogPosts.js
const relatedArticles = getRelatedPosts(
  "first-mri-preparation-guide",
  relatedPostSlugs
);
---

<CarbonLayout
  title="How to Prepare for Your First MRI: A Complete Guide | USRad"
  description="Everything you need to know before your MRI appointment, from what to wear to managing anxiety. A complete first-timer's guide to MRI scans."
>
  <AOSInit />

  <!-- Hero Section -->
  <section
    class="relative bg-gradient-to-br from-indigo-50 via-white to-blue-50/30 pt-24 pb-16 overflow-hidden"
  >
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-40">
      <div
        class="absolute top-20 right-20 w-72 h-72 bg-indigo-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob"
      >
      </div>
      <div
        class="absolute top-40 left-20 w-72 h-72 bg-blue-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"
      >
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <!-- Breadcrumb -->
      <nav class="mb-8" data-aos="fade-up">
        <ol class="flex items-center gap-2 text-sm text-gray-600">
          <li>
            <a href="/blog" class="hover:text-[#003087] transition">Blog</a>
          </li>
          <li><span class="text-gray-400">/</span></li>
          <li class="text-gray-900 font-medium">
            How to Prepare for Your First MRI
          </li>
        </ol>
      </nav>

      <!-- Title Section -->
      <div class="max-w-3xl" data-aos="fade-up" data-aos-delay="100">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-100 text-indigo-700 rounded-full text-sm font-medium mb-6"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
              clip-rule="evenodd"></path>
          </svg>
          Patient Guide • MRI Preparation
        </div>

        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight"
        >
          How to Prepare for Your First MRI: A Complete Guide
        </h1>

        <p class="text-xl text-gray-600 leading-relaxed mb-8">
          Everything you need to know before your MRI appointment, from what to
          wear to managing anxiety. We'll walk you through every step so you
          feel confident and prepared.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <article class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Key Takeaway Banner -->
      <div
        class="bg-gradient-to-r from-indigo-600 to-blue-600 rounded-2xl p-8 mb-12 text-white"
        data-aos="fade-up"
      >
        <h2 class="text-2xl font-bold mb-3">🤝 You're in Good Hands</h2>
        <p class="text-lg text-indigo-50">
          Feeling nervous about your first MRI is completely normal. This guide
          will answer all your questions and help you feel confident and
          prepared. Thousands of people get MRIs every day—and most say it was
          much easier than they expected!
        </p>
      </div>

      <!-- Quick Reference Card -->
      <div
        class="bg-gradient-to-br from-green-50 to-white rounded-2xl p-8 mb-12 border-2 border-green-200"
        data-aos="fade-up"
      >
        <h2 class="text-2xl font-bold text-gray-900 mb-4 text-center">
          ⏱️ Quick Timeline
        </h2>
        <div class="grid md:grid-cols-4 gap-6">
          <div class="text-center">
            <div
              class="w-16 h-16 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-white text-2xl font-bold"
            >
              1
            </div>
            <p class="font-semibold text-gray-900">Day Before</p>
            <p class="text-sm text-gray-600 mt-1">Check what to avoid</p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-white text-2xl font-bold"
            >
              2
            </div>
            <p class="font-semibold text-gray-900">Day Of</p>
            <p class="text-sm text-gray-600 mt-1">What to wear & bring</p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-white text-2xl font-bold"
            >
              3
            </div>
            <p class="font-semibold text-gray-900">At Facility</p>
            <p class="text-sm text-gray-600 mt-1">Check-in & screening</p>
          </div>
          <div class="text-center">
            <div
              class="w-16 h-16 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-white text-2xl font-bold"
            >
              4
            </div>
            <p class="font-semibold text-gray-900">During Scan</p>
            <p class="text-sm text-gray-600 mt-1">20-60 minutes</p>
          </div>
        </div>
      </div>

      <!-- Featured Image Section -->
      <div class="mb-12" data-aos="fade-up">
        <div
          class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-indigo-100 to-blue-100 aspect-video flex items-center justify-center"
        >
          <img
            src="/images/blog/tech-patient.webp"
            alt="Patient preparing for MRI scan with technologist"
            class="w-full h-full object-cover"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"
          >
          </div>
        </div>
        <p class="text-sm text-gray-600 text-center mt-3 italic">
          Our experienced technologists will guide you through every step of
          your MRI
        </p>
      </div>

      <!-- Introduction -->
      <section class="prose prose-lg max-w-none mb-16" data-aos="fade-up">
        <p class="text-xl text-gray-700 leading-relaxed">
          Getting your first MRI can feel intimidating, especially if you've
          heard stories about the noise or enclosed space. But with the right
          preparation and knowing what to expect, most patients find the
          experience much easier than anticipated. This guide covers everything
          from what to wear to how to stay calm during your scan.
        </p>
      </section>

      <!-- Content Section 1: Day Before -->
      <section class="prose prose-lg max-w-none mb-16" data-aos="fade-up">
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-indigo-600 to-blue-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >1</span
          >
          The Day Before Your MRI
        </h2>

        <div class="space-y-6 text-gray-700 leading-relaxed">
          <!-- What to Do -->
          <div
            class="bg-gradient-to-br from-green-50 to-white rounded-xl p-6 border border-green-200"
          >
            <h3
              class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"
            >
              <span class="text-2xl">✅</span>
              Things to Do
            </h3>
            <div class="space-y-3 text-sm">
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">
                    Review Your Instructions
                  </p>
                  <p class="text-gray-600">
                    Read any paperwork or emails from the imaging center
                    carefully. Some scans require specific preparation.
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">
                    Check Fasting Requirements
                  </p>
                  <p class="text-gray-600">
                    Some MRIs (especially abdomen/pelvis) require fasting 4-6
                    hours before. Confirm with the facility.
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">Plan Your Outfit</p>
                  <p class="text-gray-600">
                    Lay out comfortable, metal-free clothing (more on this
                    below).
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">
                    Arrange Transportation (If Sedation)
                  </p>
                  <p class="text-gray-600">
                    If you're receiving sedation or anti-anxiety medication,
                    you'll need someone to drive you home.
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">Get Good Rest</p>
                  <p class="text-gray-600">
                    A good night's sleep helps you stay still during the scan
                    and reduces anxiety.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- What to Avoid -->
          <div
            class="bg-gradient-to-br from-red-50 to-white rounded-xl p-6 border border-red-200"
          >
            <h3
              class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"
            >
              <span class="text-2xl">⚠️</span>
              Things to Avoid
            </h3>
            <div class="space-y-3 text-sm">
              <div class="flex items-start gap-3">
                <span class="text-red-600 font-bold mt-0.5">✗</span>
                <div>
                  <p class="font-semibold text-gray-900">
                    Don't Apply Makeup or Nail Polish
                  </p>
                  <p class="text-gray-600">
                    Some cosmetics contain metallic particles that can interfere
                    with imaging.
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-red-600 font-bold mt-0.5">✗</span>
                <div>
                  <p class="font-semibold text-gray-900">Skip Hair Products</p>
                  <p class="text-gray-600">
                    Hair gel, spray, or extensions may contain metal. Wash hair
                    if possible.
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-red-600 font-bold mt-0.5">✗</span>
                <div>
                  <p class="font-semibold text-gray-900">
                    Avoid Alcohol or Sedatives
                  </p>
                  <p class="text-gray-600">
                    Unless prescribed by your doctor for the MRI itself.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-blue-50 border-l-4 border-blue-500 p-6 rounded-r-lg">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">💡 Pro Tip</h3>
            <p class="text-gray-700">
              If you're claustrophobic or anxious, call the imaging center and
              ask about open MRI options or anti-anxiety medication. Many
              facilities offer solutions to make you more comfortable!
            </p>
          </div>
        </div>
      </section>

      <!-- Content Section 2: What to Wear -->
      <section class="prose prose-lg max-w-none mb-16" data-aos="fade-up">
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-indigo-600 to-blue-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >2</span
          >
          What to Wear to Your MRI
        </h2>

        <div class="space-y-6 text-gray-700 leading-relaxed">
          <p class="text-lg">
            The MRI machine uses powerful magnets, so <strong
              >nothing with metal</strong
            > can enter the scanning room. Here's what to wear and what to leave
            at home:
          </p>

          <div class="grid md:grid-cols-2 gap-6 my-8">
            <!-- What to Wear -->
            <div
              class="bg-gradient-to-br from-green-50 to-white rounded-xl p-6 border-2 border-green-300"
            >
              <h3
                class="text-lg font-bold text-green-800 mb-4 flex items-center gap-2"
              >
                <span class="text-2xl">👕</span>
                Perfect MRI Outfit
              </h3>
              <ul class="space-y-2 text-sm text-gray-700">
                <li class="flex items-start gap-2">
                  <span class="text-green-600 font-bold">✓</span>
                  <span
                    ><strong>Cotton t-shirt or sweatshirt</strong> (no zippers/buttons)</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 font-bold">✓</span>
                  <span
                    ><strong>Yoga pants, sweatpants, or leggings</strong> (no metal
                    drawstring)</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 font-bold">✓</span>
                  <span
                    ><strong>Athletic clothing</strong> (check for hidden metal)</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 font-bold">✓</span>
                  <span><strong>Sports bra</strong> (no underwire)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-green-600 font-bold">✓</span>
                  <span><strong>Slip-on shoes or socks</strong></span>
                </li>
              </ul>
              <div class="mt-4 bg-green-100 rounded-lg p-3">
                <p class="text-xs text-gray-700">
                  <strong>Best Choice:</strong> Many facilities provide a gown. Wear
                  comfortable underwear and you're all set!
                </p>
              </div>
            </div>

            <!-- What NOT to Wear -->
            <div
              class="bg-gradient-to-br from-red-50 to-white rounded-xl p-6 border-2 border-red-300"
            >
              <h3
                class="text-lg font-bold text-red-800 mb-4 flex items-center gap-2"
              >
                <span class="text-2xl">🚫</span>
                Leave These at Home
              </h3>
              <ul class="space-y-2 text-sm text-gray-700">
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold">✗</span>
                  <span><strong>Bras with underwire</strong></span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold">✗</span>
                  <span
                    ><strong>Jeans</strong> (metal buttons/rivets/zippers)</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold">✗</span>
                  <span><strong>Belts</strong></span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold">✗</span>
                  <span><strong>Jewelry</strong> (including wedding rings)</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold">✗</span>
                  <span><strong>Watches</strong></span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold">✗</span>
                  <span><strong>Hair clips, bobby pins, barrettes</strong></span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-red-600 font-bold">✗</span>
                  <span
                    ><strong>Eyeglasses</strong> (if possible, wear contacts)</span
                  >
                </li>
              </ul>
            </div>
          </div>

          <div
            class="bg-yellow-50 border-l-4 border-yellow-500 p-6 rounded-r-lg"
          >
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              ⚠️ Important: Body Piercings
            </h3>
            <p class="text-gray-700 mb-2">
              You'll need to remove all body piercings before the scan. If you
              can't remove them yourself, tell the staff—they can help or
              reschedule if necessary.
            </p>
            <p class="text-sm text-gray-600">
              This includes: Nose rings, tongue piercings, nipple piercings,
              belly button rings, etc.
            </p>
          </div>
        </div>
      </section>

      <!-- Content Section 3: What to Bring -->
      <section class="prose prose-lg max-w-none mb-16" data-aos="fade-up">
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-indigo-600 to-blue-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >3</span
          >
          What to Bring to Your Appointment
        </h2>

        <div class="space-y-6 text-gray-700 leading-relaxed">
          <div class="grid md:grid-cols-2 gap-6">
            <!-- Essential Items -->
            <div
              class="bg-gradient-to-br from-blue-50 to-white rounded-xl p-6 border border-blue-200"
            >
              <h3 class="text-lg font-bold text-gray-900 mb-4">
                📋 Essential Documents
              </h3>
              <ul class="space-y-2 text-sm text-gray-700">
                <li class="flex items-start gap-2">
                  <span class="text-blue-600">•</span>
                  <span
                    ><strong>Doctor's order/prescription</strong> for the MRI</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-600">•</span>
                  <span
                    ><strong>Photo ID</strong> (driver's license or passport)</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-600">•</span>
                  <span><strong>Insurance card</strong> (if applicable)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-600">•</span>
                  <span
                    ><strong>Payment information</strong> (credit card or cash)</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-600">•</span>
                  <span
                    ><strong>Previous imaging CDs</strong> (if requested)</span
                  >
                </li>
              </ul>
            </div>

            <!-- Optional Comfort Items -->
            <div
              class="bg-gradient-to-br from-purple-50 to-white rounded-xl p-6 border border-purple-200"
            >
              <h3 class="text-lg font-bold text-gray-900 mb-4">
                🎧 Comfort Items
              </h3>
              <ul class="space-y-2 text-sm text-gray-700">
                <li class="flex items-start gap-2">
                  <span class="text-purple-600">•</span>
                  <span><strong>Book or magazine</strong> for waiting room</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-purple-600">•</span>
                  <span
                    ><strong>Headphones</strong> (facility usually provides)</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-purple-600">•</span>
                  <span
                    ><strong>Music playlist</strong> (some facilities allow this)</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-purple-600">•</span>
                  <span
                    ><strong>Light jacket</strong> (MRI rooms can be cold)</span
                  >
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-purple-600">•</span>
                  <span
                    ><strong>Eye mask</strong> (helps some people relax)</span
                  >
                </li>
              </ul>
            </div>
          </div>

          <div class="bg-red-50 rounded-xl p-6 border border-red-200 my-6">
            <h3 class="text-lg font-bold text-gray-900 mb-3">
              🔒 What to Leave at Home or in Your Locker
            </h3>
            <div class="grid md:grid-cols-2 gap-4 text-sm">
              <ul class="space-y-1 text-gray-700">
                <li>• Wallet (bring only ID and payment)</li>
                <li>• Cell phone</li>
                <li>• Keys (especially electronic car keys)</li>
                <li>• Credit cards with magnetic strips</li>
              </ul>
              <ul class="space-y-1 text-gray-700">
                <li>• Hearing aids</li>
                <li>• Dentures (if removable)</li>
                <li>• Medication patches</li>
                <li>• Anything valuable</li>
              </ul>
            </div>
            <p class="text-xs text-gray-600 mt-3">
              Most facilities provide secure lockers for your belongings.
            </p>
          </div>
        </div>
      </section>

      <!-- Content Section 4: At the Facility -->
      <section class="prose prose-lg max-w-none mb-16" data-aos="fade-up">
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-indigo-600 to-blue-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >4</span
          >
          What Happens at the Imaging Center
        </h2>

        <div class="space-y-6 text-gray-700 leading-relaxed">
          <p class="text-lg">
            Here's a step-by-step walkthrough of what to expect from check-in to
            completion:
          </p>

          <!-- Timeline -->
          <div class="space-y-6">
            <!-- Step 1: Check-In -->
            <div
              class="bg-white border-l-4 border-indigo-500 p-6 rounded-r-lg shadow-sm"
            >
              <div class="flex items-start gap-4">
                <div
                  class="w-10 h-10 bg-indigo-500 rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  1
                </div>
                <div>
                  <h3 class="text-lg font-bold text-gray-900 mb-2">
                    Check-In (10 minutes)
                  </h3>
                  <ul class="space-y-1 text-sm text-gray-700">
                    <li>• Arrive 15-30 minutes before your appointment</li>
                    <li>• Present your ID, insurance, and doctor's order</li>
                    <li>
                      • Fill out paperwork (medical history, consent forms)
                    </li>
                    <li>• Verify your insurance information</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Step 2: Safety Screening -->
            <div
              class="bg-white border-l-4 border-blue-500 p-6 rounded-r-lg shadow-sm"
            >
              <div class="flex items-start gap-4">
                <div
                  class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  2
                </div>
                <div>
                  <h3 class="text-lg font-bold text-gray-900 mb-2">
                    Safety Screening (5-10 minutes)
                  </h3>
                  <p class="text-sm text-gray-700 mb-3">
                    A technologist will review a detailed questionnaire with you
                    about:
                  </p>
                  <ul class="space-y-1 text-sm text-gray-700">
                    <li>
                      • Metal implants (pacemaker, artificial joints, surgical
                      clips)
                    </li>
                    <li>
                      • Tattoos or permanent makeup (may contain metallic ink)
                    </li>
                    <li>• Previous surgeries</li>
                    <li>• Pregnancy or possibility of pregnancy</li>
                    <li>• Kidney function (if contrast is needed)</li>
                    <li>• Claustrophobia or anxiety</li>
                  </ul>
                  <div
                    class="bg-yellow-50 border-l-2 border-yellow-500 pl-3 py-2 mt-3"
                  >
                    <p class="text-xs text-gray-700">
                      <strong>Be Honest:</strong> This isn't about judgment—it's
                      about your safety. Metal in the MRI room can cause serious
                      injury.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Step 3: Change & Prep -->
            <div
              class="bg-white border-l-4 border-purple-500 p-6 rounded-r-lg shadow-sm"
            >
              <div class="flex items-start gap-4">
                <div
                  class="w-10 h-10 bg-purple-500 rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  3
                </div>
                <div>
                  <h3 class="text-lg font-bold text-gray-900 mb-2">
                    Change Into Gown (5 minutes)
                  </h3>
                  <ul class="space-y-1 text-sm text-gray-700">
                    <li>
                      • Change into a hospital gown if wearing inappropriate
                      clothing
                    </li>
                    <li>
                      • Remove ALL metal items (jewelry, hairpins, glasses,
                      etc.)
                    </li>
                    <li>• Store belongings in a secure locker</li>
                    <li>
                      • Use the restroom (you'll be lying still for 20-60
                      minutes)
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Step 4: Positioning -->
            <div
              class="bg-white border-l-4 border-green-500 p-6 rounded-r-lg shadow-sm"
            >
              <div class="flex items-start gap-4">
                <div
                  class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  4
                </div>
                <div>
                  <h3 class="text-lg font-bold text-gray-900 mb-2">
                    Positioning on the Table (5 minutes)
                  </h3>
                  <ul class="space-y-1 text-sm text-gray-700">
                    <li>• Lie down on the padded scanning table</li>
                    <li>• Technologist will position you for optimal images</li>
                    <li>• Coil (antenna) placed over the area being scanned</li>
                    <li>• Pillows and blankets provided for comfort</li>
                    <li>• Given earplugs or headphones (MRI is loud!)</li>
                    <li>• Receive a "panic button" to squeeze if needed</li>
                  </ul>
                  <div class="bg-green-50 rounded-lg p-3 mt-3">
                    <p class="text-xs text-gray-700">
                      <strong>Important:</strong> Once scanning starts, you need
                      to stay as still as possible. Even small movements can blur
                      the images.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Step 5: The Scan -->
            <div
              class="bg-white border-l-4 border-orange-500 p-6 rounded-r-lg shadow-sm"
            >
              <div class="flex items-start gap-4">
                <div
                  class="w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  5
                </div>
                <div>
                  <h3 class="text-lg font-bold text-gray-900 mb-2">
                    During the Scan (20-60 minutes)
                  </h3>
                  <ul class="space-y-1 text-sm text-gray-700">
                    <li>• Table slides into the MRI machine</li>
                    <li>
                      • You'll hear loud knocking, thumping, and buzzing sounds
                    </li>
                    <li>• Technologist watches you through a window</li>
                    <li>• You can talk to them through a microphone</li>
                    <li>
                      • Multiple series of images taken (each 2-15 minutes)
                    </li>
                    <li>• You may be asked to hold your breath briefly</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Step 6: Done -->
            <div
              class="bg-white border-l-4 border-teal-500 p-6 rounded-r-lg shadow-sm"
            >
              <div class="flex items-start gap-4">
                <div
                  class="w-10 h-10 bg-teal-500 rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  6
                </div>
                <div>
                  <h3 class="text-lg font-bold text-gray-900 mb-2">
                    All Done! (5 minutes)
                  </h3>
                  <ul class="space-y-1 text-sm text-gray-700">
                    <li>• Table slides back out</li>
                    <li>• Technologist helps you off the table</li>
                    <li>• Change back into your clothes</li>
                    <li>• Collect your belongings</li>
                    <li>• Schedule CD pickup or discuss results timeline</li>
                    <li>• You're free to go! (Unless sedation was used)</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
