---
import CarbonLayout from "../../layouts/CarbonLayout.astro";
import AOSInit from "../../components/AOSInit.astro";
import { getRelatedPosts } from "../../data/blogPosts.js";

export const prerender = true;

// For Health & Wellness, link to the other wellness post and relevant patient guides
const relatedPostSlugs = [
  "preventive-care-checklist",
  "managing-mri-anxiety",
  "first-mri-preparation-guide",
];

// Get the full post data automatically from blogPosts.js
const relatedArticles = getRelatedPosts("health-tips", relatedPostSlugs);
---

<CarbonLayout
  title="Health Tips: Wellness Advice from Medical Experts | USRad"
  description="Expert health and wellness tips to help you stay healthy, prevent illness, and make informed medical decisions. Science-backed advice from healthcare professionals."
>
  <AOSInit />

  <!-- Hero Section -->
  <section
    class="relative bg-gradient-to-br from-purple-50 via-white to-pink-50/30 pt-24 pb-16 overflow-hidden"
  >
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-40">
      <div
        class="absolute top-20 right-20 w-72 h-72 bg-purple-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob"
      >
      </div>
      <div
        class="absolute top-40 left-20 w-72 h-72 bg-pink-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"
      >
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <!-- Breadcrumb -->
      <nav class="mb-8" data-aos="fade-up">
        <ol class="flex items-center gap-2 text-sm text-gray-600">
          <li>
            <a href="/blog" class="hover:text-[#003087] transition">Blog</a>
          </li>
          <li><span class="text-gray-400">/</span></li>
          <li class="text-gray-900 font-medium">
            Essential Health Tips for Better Living
          </li>
        </ol>
      </nav>

      <!-- Title Section -->
      <div class="max-w-3xl" data-aos="fade-up" data-aos-delay="100">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-medium mb-6"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"
              clip-rule="evenodd"></path>
          </svg>
          Health Tips • Wellness Guide
        </div>

        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight"
        >
          Essential Health Tips for Better Living
        </h1>

        <p class="text-xl text-gray-600 leading-relaxed mb-8">
          Science-backed wellness advice from medical experts to help you stay
          healthy, prevent illness, and make informed decisions about your
          healthcare.
        </p>

        <!-- Author & Date -->
        <div
          class="flex flex-wrap items-center gap-6 pb-8 border-b border-gray-200"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">USRad Healthcare Team</p>
              <p class="text-sm text-gray-600">
                Medical Experts & Wellness Advisors
              </p>
            </div>
          </div>
          <div class="flex items-center gap-4 text-sm text-gray-600">
            <span>Updated May 2025</span>
            <span>•</span>
            <span>8 min read</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <article class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Key Takeaway Banner -->
      <div
        class="bg-gradient-to-r from-purple-600 to-pink-600 rounded-2xl p-8 mb-12 text-white"
        data-aos="fade-up"
      >
        <h2 class="text-2xl font-bold mb-3">💜 Your Health Matters</h2>
        <p class="text-lg text-purple-50">
          Small, consistent actions create lasting health benefits. These
          evidence-based tips from medical professionals can help you prevent
          illness, boost energy, and live your best life.
        </p>
      </div>

      <!-- Table of Contents -->
      <div
        class="bg-gradient-to-br from-purple-50 to-white rounded-2xl p-8 mb-12 border border-purple-100"
        data-aos="fade-up"
      >
        <h2
          class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"
        >
          <svg
            class="w-5 h-5 text-purple-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          Health & Wellness Topics
        </h2>
        <ul class="space-y-2 text-gray-700">
          <li>
            <a href="#preventive-care" class="hover:text-purple-600 transition"
              >The Power of Preventive Care</a
            >
          </li>
          <li>
            <a href="#nutrition" class="hover:text-purple-600 transition"
              >Nutrition & Healthy Eating</a
            >
          </li>
          <li>
            <a href="#exercise" class="hover:text-purple-600 transition"
              >Exercise & Movement</a
            >
          </li>
          <li>
            <a href="#sleep" class="hover:text-purple-600 transition"
              >Quality Sleep</a
            >
          </li>
          <li>
            <a href="#mental-health" class="hover:text-purple-600 transition"
              >Mental Health & Stress Management</a
            >
          </li>
          <li>
            <a href="#screening" class="hover:text-purple-600 transition"
              >Medical Screenings You Need</a
            >
          </li>
          <li>
            <a
              href="#chronic-conditions"
              class="hover:text-purple-600 transition"
              >Managing Chronic Conditions</a
            >
          </li>
        </ul>
      </div>

      <!-- Featured Image Section -->
      <div class="mb-12" data-aos="fade-up">
        <div
          class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-purple-100 to-pink-100 aspect-video flex items-center justify-center"
        >
          <img
            src="/images/blog/healthy-lifestyle.webp"
            alt="Healthy lifestyle habits and wellness tips"
            class="w-full h-full object-cover"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"
          >
          </div>
        </div>
        <p class="text-sm text-gray-600 text-center mt-3 italic">
          Small daily habits compound into significant long-term health benefits
        </p>
      </div>

      <!-- Content Section 1: Preventive Care -->
      <section
        id="preventive-care"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-purple-600 to-pink-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >1</span
          >
          The Power of Preventive Care
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p class="text-lg">
            <strong>Prevention is always better than treatment.</strong> Regular
            check-ups and screenings can catch health issues early when they're most
            treatable—and often less expensive to manage.
          </p>

          <div
            class="bg-gradient-to-br from-blue-50 to-white rounded-2xl p-8 my-6 border border-blue-200"
          >
            <h3 class="text-xl font-semibold text-gray-900 mb-4">
              Annual Check-Up Checklist
            </h3>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">
                    Blood Pressure Check
                  </p>
                  <p class="text-sm text-gray-600">
                    Catch hypertension early to prevent heart disease and stroke
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">
                    Cholesterol Screening
                  </p>
                  <p class="text-sm text-gray-600">
                    Monitor heart health and prevent cardiovascular disease
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">Blood Sugar Test</p>
                  <p class="text-sm text-gray-600">
                    Detect prediabetes or diabetes before complications develop
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">
                    BMI & Weight Assessment
                  </p>
                  <p class="text-sm text-gray-600">
                    Track healthy weight and address obesity-related risks
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-6 h-6 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">Vaccinations Update</p>
                  <p class="text-sm text-gray-600">
                    Stay current on flu shots, COVID boosters, and other
                    vaccines
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div
            class="bg-yellow-50 border-l-4 border-yellow-500 p-6 rounded-r-lg my-6"
          >
            <h3 class="text-lg font-semibold text-gray-900 mb-2">💡 Pro Tip</h3>
            <p class="text-gray-700">
              Schedule your annual check-up at the same time each year (like
              your birthday month) to make it a consistent habit. Early
              detection can save your life—and save you thousands in medical
              costs.
            </p>
          </div>
        </div>
      </section>

      <!-- Content Section 2: Nutrition -->
      <section
        id="nutrition"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-purple-600 to-pink-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >2</span
          >
          Nutrition & Healthy Eating
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p class="text-lg">
            You don't need a perfect diet—just better habits. Small, sustainable
            changes to your eating patterns can dramatically improve your health
            over time.
          </p>

          <div class="grid md:grid-cols-2 gap-6 my-8">
            <div class="bg-green-50 border border-green-200 rounded-xl p-6">
              <h3
                class="text-lg font-bold text-green-800 mb-4 flex items-center gap-2"
              >
                <span class="text-2xl">✓</span>
                Foods to Eat More Of
              </h3>
              <ul class="space-y-2 text-sm text-gray-700">
                <li>
                  • <strong>Colorful vegetables</strong> - Aim for 5+ servings daily
                </li>
                <li>
                  • <strong>Whole grains</strong> - Brown rice, quinoa, oats
                </li>
                <li>
                  • <strong>Lean proteins</strong> - Fish, chicken, beans, tofu
                </li>
                <li>
                  • <strong>Healthy fats</strong> - Nuts, avocado, olive oil
                </li>
                <li>
                  • <strong>Fruits</strong> - 2-3 servings daily, especially berries
                </li>
                <li>• <strong>Water</strong> - 8+ glasses daily</li>
              </ul>
            </div>

            <div class="bg-red-50 border border-red-200 rounded-xl p-6">
              <h3
                class="text-lg font-bold text-red-800 mb-4 flex items-center gap-2"
              >
                <span class="text-2xl">✗</span>
                Foods to Limit
              </h3>
              <ul class="space-y-2 text-sm text-gray-700">
                <li>
                  • <strong>Processed foods</strong> - Pre-packaged meals, chips
                </li>
                <li>
                  • <strong>Added sugars</strong> - Sodas, candy, baked goods
                </li>
                <li>
                  • <strong>Refined carbs</strong> - White bread, pastries
                </li>
                <li>• <strong>Trans fats</strong> - Fried foods, margarine</li>
                <li>
                  • <strong>Excessive salt</strong> - Processed meats, canned foods
                </li>
                <li>
                  • <strong>Alcohol</strong> - No more than 1-2 drinks/day
                </li>
              </ul>
            </div>
          </div>

          <div
            class="bg-gradient-to-br from-blue-50 to-white rounded-xl p-6 my-6 border border-blue-200"
          >
            <h3 class="text-lg font-semibold text-gray-900 mb-4">
              Simple Nutrition Rules
            </h3>
            <div class="space-y-3 text-gray-700">
              <p class="flex items-start gap-2">
                <span class="text-blue-600 font-bold">1.</span>
                <span
                  ><strong>Fill half your plate with vegetables</strong> at each
                  meal</span
                >
              </p>
              <p class="flex items-start gap-2">
                <span class="text-blue-600 font-bold">2.</span>
                <span
                  ><strong>Eat the rainbow</strong> - Different colored foods provide
                  different nutrients</span
                >
              </p>
              <p class="flex items-start gap-2">
                <span class="text-blue-600 font-bold">3.</span>
                <span
                  ><strong>Read nutrition labels</strong> - Avoid foods with more
                  than 5 ingredients</span
                >
              </p>
              <p class="flex items-start gap-2">
                <span class="text-blue-600 font-bold">4.</span>
                <span
                  ><strong>Practice portion control</strong> - Use smaller plates</span
                >
              </p>
              <p class="flex items-start gap-2">
                <span class="text-blue-600 font-bold">5.</span>
                <span
                  ><strong>Meal prep</strong> - Prepare healthy meals in advance</span
                >
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Content Section 3: Exercise -->
      <section
        id="exercise"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-purple-600 to-pink-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >3</span
          >
          Exercise & Movement
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p class="text-lg">
            Regular physical activity is one of the most powerful ways to
            prevent disease, boost mood, and extend your lifespan. The good
            news? You don't need to run marathons—consistency matters more than
            intensity.
          </p>

          <div
            class="bg-gradient-to-r from-purple-600 to-pink-600 rounded-2xl p-8 text-white my-8"
          >
            <h3 class="text-2xl font-bold mb-4">Weekly Exercise Goals</h3>
            <div class="grid md:grid-cols-2 gap-6">
              <div class="bg-white/20 backdrop-blur-sm rounded-xl p-6">
                <p class="text-4xl font-bold mb-2">150</p>
                <p class="text-sm text-purple-100">
                  minutes of moderate aerobic activity
                </p>
                <p class="text-xs text-purple-200 mt-2">
                  Examples: Brisk walking, cycling, swimming
                </p>
              </div>
              <div class="bg-white/20 backdrop-blur-sm rounded-xl p-6">
                <p class="text-4xl font-bold mb-2">2+</p>
                <p class="text-sm text-purple-100">days of strength training</p>
                <p class="text-xs text-purple-200 mt-2">
                  Examples: Weights, resistance bands, bodyweight
                </p>
              </div>
            </div>
          </div>

          <div class="space-y-4 my-6">
            <div class="bg-white border border-gray-200 rounded-xl p-6">
              <h3 class="text-lg font-bold text-gray-900 mb-3">
                🚶 Start Small: Easy Ways to Move More
              </h3>
              <ul class="space-y-2 text-sm text-gray-700">
                <li>• Take the stairs instead of the elevator</li>
                <li>• Park farther away from entrances</li>
                <li>• Walk during phone calls</li>
                <li>• Set hourly reminders to stand and stretch</li>
                <li>• Do bodyweight exercises during TV commercials</li>
                <li>• Join a walking group or sports league</li>
                <li>• Dance to your favorite music for 10 minutes</li>
              </ul>
            </div>
          </div>

          <div
            class="bg-blue-50 border-l-4 border-blue-500 p-6 rounded-r-lg my-6"
          >
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              Health Benefits of Regular Exercise
            </h3>
            <div class="grid md:grid-cols-2 gap-4 text-sm text-gray-700">
              <ul class="space-y-1">
                <li>✓ Reduces risk of heart disease</li>
                <li>✓ Helps control weight</li>
                <li>✓ Lowers blood pressure</li>
                <li>✓ Improves cholesterol levels</li>
              </ul>
              <ul class="space-y-1">
                <li>✓ Boosts mood and reduces anxiety</li>
                <li>✓ Strengthens bones and muscles</li>
                <li>✓ Improves sleep quality</li>
                <li>✓ Increases energy levels</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Content Section 4: Sleep -->
      <section
        id="sleep"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-purple-600 to-pink-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >4</span
          >
          Quality Sleep: The Foundation of Health
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p class="text-lg">
            Sleep isn't a luxury—it's a biological necessity. Poor sleep is
            linked to obesity, diabetes, heart disease, weakened immunity, and
            mental health issues.
          </p>

          <div
            class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl p-8 my-6 border border-indigo-200"
          >
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              Sleep Recommendations by Age
            </h3>
            <div class="space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-gray-700">Adults (18-64)</span>
                <span class="font-bold text-indigo-700">7-9 hours</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-700">Older Adults (65+)</span>
                <span class="font-bold text-indigo-700">7-8 hours</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-700">Teenagers (14-17)</span>
                <span class="font-bold text-indigo-700">8-10 hours</span>
              </div>
            </div>
          </div>

          <div class="bg-white border-2 border-purple-200 rounded-xl p-6 my-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4">
              😴 Better Sleep Habits
            </h3>
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <p class="font-semibold text-green-700 mb-3">✓ Do This:</p>
                <ul class="space-y-2 text-sm text-gray-700">
                  <li>• Stick to consistent sleep/wake times</li>
                  <li>• Create a dark, cool, quiet bedroom</li>
                  <li>• Develop a relaxing bedtime routine</li>
                  <li>• Exercise regularly (but not before bed)</li>
                  <li>• Limit caffeine after 2pm</li>
                </ul>
              </div>
              <div>
                <p class="font-semibold text-red-700 mb-3">✗ Avoid This:</p>
                <ul class="space-y-2 text-sm text-gray-700">
                  <li>• Screen time 1 hour before bed</li>
                  <li>• Large meals late at night</li>
                  <li>• Alcohol before bedtime</li>
                  <li>• Inconsistent sleep schedules</li>
                  <li>• Hitting the snooze button</li>
                </ul>
              </div>
            </div>
          </div>

          <div
            class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-lg my-6"
          >
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              ⚠️ When to See a Doctor
            </h3>
            <p class="text-gray-700 mb-2">
              Consult a healthcare provider if you experience:
            </p>
            <ul class="space-y-1 text-sm text-gray-700">
              <li>• Chronic insomnia (difficulty falling or staying asleep)</li>
              <li>
