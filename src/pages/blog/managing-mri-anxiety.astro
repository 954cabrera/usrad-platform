---
import CarbonLayout from "../../layouts/CarbonLayout.astro";
import AOSInit from "../../components/AOSInit.astro";
import { getRelatedPosts } from "../../data/blogPosts.js";
import NewsletterPopup from "../../components/NewsletterPopup.astro";

export const prerender = true;

// For MRI anxiety, link to other helpful Patient Guide posts
const relatedPostSlugs = [
  "first-mri-preparation-guide",
  "mri-basics",
  "health-tips",
];

// Get the full post data automatically from blogPosts.js
const relatedArticles = getRelatedPosts(
  "managing-mri-anxiety",
  relatedPostSlugs
);
---

<CarbonLayout
  title="Overcoming MRI Anxiety & Claustrophobia: Expert Tips for a Calm Scan | USRad"
  description="Feeling anxious about your MRI? Learn proven strategies to manage claustrophobia and anxiety during your scan. Expert tips from experienced technologists."
>
  <AOSInit />

  <!-- Hero Section -->
  <section
    class="relative bg-gradient-to-br from-purple-50 via-white to-pink-50/30 pt-24 pb-16 overflow-hidden"
  >
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-40">
      <div
        class="absolute top-20 right-20 w-72 h-72 bg-purple-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob"
      >
      </div>
      <div
        class="absolute top-40 left-20 w-72 h-72 bg-pink-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"
      >
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <!-- Breadcrumb -->
      <nav class="mb-8" data-aos="fade-up">
        <ol class="flex items-center gap-2 text-sm text-gray-600">
          <li>
            <a href="/blog" class="hover:text-[#003087] transition">Blog</a>
          </li>
          <li><span class="text-gray-400">/</span></li>
          <li class="text-gray-900 font-medium">
            Overcoming MRI Anxiety & Claustrophobia
          </li>
        </ol>
      </nav>

      <!-- Title Section -->
      <div class="max-w-3xl" data-aos="fade-up" data-aos-delay="100">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-medium mb-6"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"
            ></path>
          </svg>
          Patient Guide • Mental Health & Wellness
        </div>

        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight"
        >
          Overcoming MRI Anxiety & Claustrophobia
        </h1>

        <p class="text-xl text-gray-600 leading-relaxed mb-8">
          If the thought of an MRI makes you nervous, you're not alone. Learn
          proven strategies from our experienced team to stay calm, manage
          claustrophobia, and successfully complete your scan.
        </p>

        <!-- Author & Date -->
        <div
          class="flex flex-wrap items-center gap-6 pb-8 border-b border-gray-200"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-12 h-12 bg-gradient-to-br from-purple-600 to-pink-600 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">USRad Healthcare Team</p>
              <p class="text-sm text-gray-600">
                Radiologic Technologists & Patient Care Specialists
              </p>
            </div>
          </div>
          <div class="flex items-center gap-4 text-sm text-gray-600">
            <span>August 15, 2025</span>
            <span>•</span>
            <span>8 min read</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <article class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Key Takeaway Banner -->
      <div
        class="bg-gradient-to-r from-purple-600 to-pink-600 rounded-2xl p-8 mb-12 text-white"
        data-aos="fade-up"
      >
        <h2 class="text-2xl font-bold mb-3">💜 You're Not Alone</h2>
        <p class="text-lg text-purple-50">
          Up to <strong>37% of patients</strong> experience anxiety before an MRI.
          Claustrophobia affects about 5-10% of the population. Your feelings are
          valid, common, and manageable. This guide will show you exactly how thousands
          of anxious patients successfully complete their MRIs every single day.
        </p>
      </div>

      <!-- Stats Section -->
      <div class="grid md:grid-cols-3 gap-6 mb-12" data-aos="fade-up">
        <div
          class="bg-gradient-to-br from-blue-50 to-white rounded-xl p-6 border border-blue-200 text-center"
        >
          <p class="text-4xl font-bold text-blue-600 mb-2">37%</p>
          <p class="text-sm text-gray-700">Experience MRI anxiety</p>
          <p class="text-xs text-gray-500 mt-1">Journal of Radiology, 2023</p>
        </div>
        <div
          class="bg-gradient-to-br from-green-50 to-white rounded-xl p-6 border border-green-200 text-center"
        >
          <p class="text-4xl font-bold text-green-600 mb-2">95%</p>
          <p class="text-sm text-gray-700">Complete their scan successfully</p>
          <p class="text-xs text-gray-500 mt-1">With proper preparation</p>
        </div>
        <div
          class="bg-gradient-to-br from-purple-50 to-white rounded-xl p-6 border border-purple-200 text-center"
        >
          <p class="text-4xl font-bold text-purple-600 mb-2">100%</p>
          <p class="text-sm text-gray-700">Say it wasn't as bad as expected</p>
          <p class="text-xs text-gray-500 mt-1">Patient satisfaction surveys</p>
        </div>
      </div>

      <!-- Featured Image Section -->
      <div class="mb-12" data-aos="fade-up">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img
            src="/images/blog/comfort-patient.webp"
            alt="Patient feeling calm and relaxed during MRI"
            class="w-full h-auto"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent pointer-events-none"
          >
          </div>
        </div>
        <p class="text-sm text-gray-600 text-center mt-3 italic">
          With the right techniques, you can stay calm and comfortable during
          your MRI
        </p>
      </div>

      <!-- Introduction -->
      <section class="prose prose-lg max-w-none mb-16" data-aos="fade-up">
        <p class="text-xl text-gray-700 leading-relaxed">
          The enclosed space. The loud noises. The need to stay perfectly still.
          It's no wonder so many people feel anxious about MRIs. But here's the
          truth: <strong
            >anxiety doesn't have to stop you from getting the medical imaging
            you need</strong
          >. This comprehensive guide shares proven techniques that have helped
          thousands of anxious patients—from mild nervousness to severe
          claustrophobia—successfully complete their scans.
        </p>
      </section>

      <!-- Content Section 1: Understanding Your Anxiety -->
      <section class="prose prose-lg max-w-none mb-16" data-aos="fade-up">
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-purple-600 to-pink-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >1</span
          >
          Understanding Your Anxiety: You're Not Being Irrational
        </h2>

        <div class="space-y-6 text-gray-700 leading-relaxed">
          <p class="text-lg">
            First, let's acknowledge something important: <strong
              >Your fear is completely valid</strong
            >. Your brain is doing its job by identifying a potentially
            uncomfortable situation. That's normal human psychology, not
            weakness.
          </p>

          <div
            class="bg-gradient-to-br from-blue-50 to-white rounded-xl p-6 border border-blue-200"
          >
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Common MRI Anxiety Triggers
            </h3>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div
                  class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white text-sm font-bold shrink-0"
                >
                  1
                </div>
                <div>
                  <p class="font-semibold text-gray-900">
                    Enclosed Space (Claustrophobia)
                  </p>
                  <p class="text-sm text-gray-600">
                    The tube-like structure of traditional MRI machines can
                    trigger feelings of being trapped
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div
                  class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white text-sm font-bold shrink-0"
                >
                  2
                </div>
                <div>
                  <p class="font-semibold text-gray-900">
                    Loud, Unexpected Noises
                  </p>
                  <p class="text-sm text-gray-600">
                    Banging, thumping, and buzzing sounds can be startling and
                    overwhelming
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div
                  class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white text-sm font-bold shrink-0"
                >
                  3
                </div>
                <div>
                  <p class="font-semibold text-gray-900">Loss of Control</p>
                  <p class="text-sm text-gray-600">
                    Having to stay completely still while others control the
                    machine and process
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div
                  class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white text-sm font-bold shrink-0"
                >
                  4
                </div>
                <div>
                  <p class="font-semibold text-gray-900">Fear of the Unknown</p>
                  <p class="text-sm text-gray-600">
                    Not knowing what to expect or what the results might show
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div
                  class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white text-sm font-bold shrink-0"
                >
                  5
                </div>
                <div>
                  <p class="font-semibold text-gray-900">Physical Discomfort</p>
                  <p class="text-sm text-gray-600">
                    Worry about having to stay still for 20-60 minutes,
                    potential back pain, or needing the bathroom
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div
                  class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white text-sm font-bold shrink-0"
                >
                  6
                </div>
                <div>
                  <p class="font-semibold text-gray-900">
                    Previous Bad Experiences
                  </p>
                  <p class="text-sm text-gray-600">
                    Past traumatic medical experiences or stories you've heard
                    from others
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-green-50 border-l-4 border-green-500 p-6 rounded-r-lg">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              💚 Good News
            </h3>
            <p class="text-gray-700">
              Every single one of these triggers has a solution or coping
              strategy. And most importantly: <strong
                >You don't have to suffer through this alone</strong
              >. MRI facilities are experienced in helping anxious patients, and
              they want you to succeed.
            </p>
          </div>
        </div>
      </section>

      <!-- Content Section 2: Before Your Appointment -->
      <section class="prose prose-lg max-w-none mb-16" data-aos="fade-up">
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-purple-600 to-pink-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >2</span
          >
          Preparation Strategies: Set Yourself Up for Success
        </h2>

        <div class="space-y-6 text-gray-700 leading-relaxed">
          <p class="text-lg">
            The work starts <strong>before</strong> you even arrive at the imaging
            center. These preparation strategies can dramatically reduce your anxiety:
          </p>

          <!-- Talk to Your Doctor -->
          <div
            class="bg-white border-2 border-purple-200 rounded-xl p-6 hover:border-purple-400 transition"
          >
            <div class="flex items-start gap-4 mb-4">
              <div
                class="w-12 h-12 bg-purple-600 rounded-full flex items-center justify-center text-white text-xl font-bold shrink-0"
              >
                💊
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900">
                  Ask About Anti-Anxiety Medication
                </h3>
                <p class="text-sm text-purple-700 font-semibold">
                  Most effective intervention
                </p>
              </div>
            </div>
            <div class="space-y-3 text-sm">
              <p class="text-gray-700">
                <strong>Don't be embarrassed to ask.</strong> Your doctor can prescribe
                mild sedatives like:
              </p>
              <ul class="space-y-2 text-gray-700 ml-4">
                <li>
                  • <strong>Lorazepam (Ativan)</strong> - Taken 30-60 minutes before
                  scan
                </li>
                <li>
                  • <strong>Alprazolam (Xanax)</strong> - Fast-acting, short duration
                </li>
                <li>
                  • <strong>Diazepam (Valium)</strong> - Longer-lasting calm
                </li>
              </ul>
              <div
                class="bg-yellow-50 border-l-2 border-yellow-500 pl-3 py-2 mt-3"
              >
                <p class="text-xs text-gray-700">
                  <strong>Important:</strong> You'll need someone to drive you home
                  if you take sedative medication.
                </p>
              </div>
            </div>
          </div>

          <!-- Open MRI -->
          <div
            class="bg-white border-2 border-blue-200 rounded-xl p-6 hover:border-blue-400 transition"
          >
            <div class="flex items-start gap-4 mb-4">
              <div
                class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center text-white text-xl font-bold shrink-0"
              >
                🔓
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900">
                  Request an Open MRI or Wide-Bore MRI
                </h3>
                <p class="text-sm text-blue-700 font-semibold">
                  Specifically designed for claustrophobic patients
                </p>
              </div>
            </div>
            <div class="space-y-3 text-sm">
              <div class="grid md:grid-cols-2 gap-4">
                <div class="bg-blue-50 rounded-lg p-4">
                  <p class="font-semibold text-gray-900 mb-2">Open MRI</p>
                  <ul class="space-y-1 text-xs text-gray-700">
                    <li>✓ Open on multiple sides</li>
                    <li>✓ No enclosed tube feeling</li>
                    <li>✓ May take slightly longer</li>
                    <li>✓ Not available for all scan types</li>
                  </ul>
                </div>
                <div class="bg-blue-50 rounded-lg p-4">
                  <p class="font-semibold text-gray-900 mb-2">Wide-Bore MRI</p>
                  <ul class="space-y-1 text-xs text-gray-700">
                    <li>✓ 70cm opening (vs 60cm standard)</li>
                    <li>✓ Same quality as traditional</li>
                    <li>✓ Shorter tube length</li>
                    <li>✓ More widely available</li>
                  </ul>
                </div>
              </div>
              <div class="bg-blue-100 rounded-lg p-3 mt-3">
                <p class="text-xs text-gray-700">
                  <strong>Call ahead:</strong> Ask if the facility has open or wide-bore
                  options before booking your appointment.
                </p>
              </div>
            </div>
          </div>

          <!-- Visit Beforehand -->
          <div
            class="bg-white border-2 border-green-200 rounded-xl p-6 hover:border-green-400 transition"
          >
            <div class="flex items-start gap-4 mb-4">
              <div
                class="w-12 h-12 bg-green-600 rounded-full flex items-center justify-center text-white text-xl font-bold shrink-0"
              >
                👁️
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900">
                  Visit the Facility Beforehand
                </h3>
                <p class="text-sm text-green-700 font-semibold">
                  Eliminate fear of the unknown
                </p>
              </div>
            </div>
            <div class="space-y-3 text-sm text-gray-700">
              <p>
                Many imaging centers allow you to visit and see the MRI machine
                before your appointment. This helps:
              </p>
              <ul class="space-y-1 ml-4">
                <li>• Familiarize yourself with the environment</li>
                <li>• Meet the staff who'll be helping you</li>
                <li>• See that the machine isn't as scary as you imagined</li>
                <li>• Ask questions in a low-pressure setting</li>
                <li>
                  • Practice lying on the table (some facilities allow this)
                </li>
              </ul>
            </div>
          </div>

          <!-- Practice Relaxation -->
          <div
            class="bg-white border-2 border-indigo-200 rounded-xl p-6 hover:border-indigo-400 transition"
          >
            <div class="flex items-start gap-4 mb-4">
              <div
                class="w-12 h-12 bg-indigo-600 rounded-full flex items-center justify-center text-white text-xl font-bold shrink-0"
              >
                🧘
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900">
                  Practice Relaxation Techniques
                </h3>
                <p class="text-sm text-indigo-700 font-semibold">
                  Train your mind ahead of time
                </p>
              </div>
            </div>
            <div class="space-y-3 text-sm text-gray-700">
              <p>In the weeks before your scan, practice these daily:</p>
              <div class="grid md:grid-cols-2 gap-4 mt-3">
                <div class="bg-indigo-50 rounded-lg p-4">
                  <p class="font-semibold text-gray-900 mb-2">
                    4-7-8 Breathing
                  </p>
                  <ol class="space-y-1 text-xs text-gray-700">
                    <li>1. Breathe in for 4 counts</li>
                    <li>2. Hold for 7 counts</li>
                    <li>3. Exhale for 8 counts</li>
                    <li>4. Repeat 4 times</li>
                  </ol>
                </div>
                <div class="bg-indigo-50 rounded-lg p-4">
                  <p class="font-semibold text-gray-900 mb-2">
                    Progressive Muscle Relaxation
                  </p>
                  <ol class="space-y-1 text-xs text-gray-700">
                    <li>1. Tense feet for 5 seconds</li>
                    <li>2. Release and relax</li>
                    <li>3. Move up body (legs, stomach, arms)</li>
                    <li>4. Notice tension melting away</li>
                  </ol>
                </div>
                <div class="bg-indigo-50 rounded-lg p-4">
                  <p class="font-semibold text-gray-900 mb-2">
                    Guided Visualization
                  </p>
                  <ul class="space-y-1 text-xs text-gray-700">
                    <li>• Picture your "happy place"</li>
                    <li>• Beach, forest, childhood home</li>
                    <li>• Engage all 5 senses</li>
                    <li>• Practice 10 mins daily</li>
                  </ul>
                </div>
                <div class="bg-indigo-50 rounded-lg p-4">
                  <p class="font-semibold text-gray-900 mb-2">
                    Meditation Apps
                  </p>
                  <ul class="space-y-1 text-xs text-gray-700">
                    <li>• Calm</li>
                    <li>• Headspace</li>
                    <li>• Insight Timer</li>
                    <li>• 10% Happier</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- Bring Support -->
          <div
            class="bg-white border-2 border-pink-200 rounded-xl p-6 hover:border-pink-400 transition"
          >
            <div class="flex items-start gap-4 mb-4">
              <div
                class="w-12 h-12 bg-pink-600 rounded-full flex items-center justify-center text-white text-xl font-bold shrink-0"
              >
                🤝
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900">
                  Bring a Support Person
                </h3>
                <p class="text-sm text-pink-700 font-semibold">
                  You don't have to do this alone
                </p>
              </div>
            </div>
            <div class="space-y-3 text-sm text-gray-700">
              <p>Having someone with you provides:</p>
              <ul class="space-y-1 ml-4">
                <li>• Emotional support in the waiting room</li>
                <li>• Someone to talk to and distract you</li>
                <li>• Transportation if you take sedation</li>
                <li>• Reassurance that you're not alone</li>
              </ul>
              <p class="text-xs text-gray-600 mt-2">
                <strong>Note:</strong> They usually can't come into the scan room
                with you (metal safety), but they'll be just outside.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Content Section 3: During Your Scan -->
      <section class="prose prose-lg max-w-none mb-16" data-aos="fade-up">
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-purple-600 to-pink-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >3</span
          >
          During Your Scan: Real-Time Coping Strategies
        </h2>

        <div class="space-y-6 text-gray-700 leading-relaxed">
          <p class="text-lg">
            You're on the table. The anxiety is building. Here are <strong
              >proven techniques</strong
            > that work in the moment:
          </p>

          <!-- Close Your Eyes -->
          <div
            class="bg-gradient-to-br from-blue-50 to-white rounded-xl p-6 border border-blue-200"
          >
            <h3
              class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2"
            >
              <span class="text-2xl">👁️</span>
              Close Your Eyes BEFORE You Go In
            </h3>
            <p class="text-sm text-gray-700 mb-3">
              <strong>The #1 most effective technique:</strong> Close your eyes as
              soon as you lie down, and keep them closed the entire time.
            </p>
            <div class="bg-blue-100 rounded-lg p-4">
              <p class="text-xs font-semibold text-gray-900 mb-2">
                Why This Works:
              </p>
              <ul class="space-y-1 text-xs text-gray-700">
                <li>
                  • You can't see the enclosed space if your eyes are shut
                </li>
                <li>• Reduces visual stimulation and anxiety triggers</li>
                <li>• Helps you focus inward on breathing and relaxation</li>
                <li>
                  • Many patients report: "I didn't even know when I was fully
                  inside"
                </li>
              </ul>
            </div>
            <p class="text-xs text-gray-600 mt-3">
              <strong>Bonus:</strong> Ask for a washcloth or eye mask over your eyes
              for extra darkness.
            </p>
          </div>

          <!-- Focus on Breathing -->
          <div
            class="bg-gradient-to-br from-green-50 to-white rounded-xl p-6 border border-green-200"
          >
            <h3
              class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2"
            >
              <span class="text-2xl">🌬️</span>
              Focus Intensely on Your Breathing
            </h3>
            <p class="text-sm text-gray-700 mb-3">
              Your breath is the most powerful tool you have to control anxiety
              in real-time.
            </p>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="bg-green-100 rounded-lg p-4">
                <p class="font-semibold text-gray-900 mb-2 text-sm">
                  Box Breathing
