      }
      66% {
        transform: translate(-20px, 20px) scale(0.9);
      }
    }

    .animate-blob {
      animation: blob 7s infinite;
    }

    .animation-delay-2000 {
      animation-delay: 2s;
    }

    /* Smooth scroll for anchor links */
    html {
      scroll-behavior: smooth;
    }

    /* Prose styling for better readability */
