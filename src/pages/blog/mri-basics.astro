---
import CarbonLayout from "../../layouts/CarbonLayout.astro";
import AOSInit from "../../components/AOSInit.astro";
import { getRelatedPosts } from "../../data/blogPosts.js";
import NewsletterPopup from "../../components/NewsletterPopup.astro";

export const prerender = true;

// For MRI Basics, link to other helpful Patient Guide posts
const relatedPostSlugs = [
  "first-mri-preparation-guide",
  "managing-mri-anxiety",
  "understanding-mri-results",
];

// Get the full post data automatically from blogPosts.js
const relatedArticles = getRelatedPosts("mri-basics", relatedPostSlugs);
---

<CarbonLayout
  title="MRI Basics: Everything You Need to Know | USRad"
  description="Complete guide to MRI scans - learn how MRIs work, what to expect, preparation tips, and costs. Expert insights from the USRad Healthcare Team."
>
  <AOSInit />

  <!-- Hero Section -->
  <section
    class="relative bg-gradient-to-br from-blue-50 via-white to-blue-50/30 pt-24 pb-16 overflow-hidden"
  >
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-40">
      <div
        class="absolute top-20 right-20 w-72 h-72 bg-blue-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob"
      >
      </div>
      <div
        class="absolute top-40 left-20 w-72 h-72 bg-purple-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"
      >
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <!-- Breadcrumb -->
      <nav class="mb-8" data-aos="fade-up">
        <ol class="flex items-center gap-2 text-sm text-gray-600">
          <li>
            <a href="/blog" class="hover:text-[#003087] transition">Blog</a>
          </li>
          <li><span class="text-gray-400">/</span></li>
          <li class="text-gray-900 font-medium">
            Everything You Need to Know About MRI Scans
          </li>
        </ol>
      </nav>

      <!-- Title Section -->
      <div class="max-w-3xl" data-aos="fade-up" data-aos-delay="100">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-blue-100 text-blue-700 rounded-full text-sm font-medium mb-6"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"></path>
            <path
              fill-rule="evenodd"
              d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z"
              clip-rule="evenodd"></path>
          </svg>
          MRI Basics • Patient Guide
        </div>

        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight"
        >
          Everything You Need to Know About MRI Scans
        </h1>

        <p class="text-xl text-gray-600 leading-relaxed mb-8">
          A comprehensive guide to understanding MRI technology, what to expect
          during your scan, and how to prepare for the best results.
        </p>

        <!-- Author & Date -->
        <div
          class="flex flex-wrap items-center gap-6 pb-8 border-b border-gray-200"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-12 h-12 bg-gradient-to-br from-[#003087] to-blue-600 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">USRad Healthcare Team</p>
              <p class="text-sm text-gray-600">
                Board-Certified Radiologists & Imaging Specialists
              </p>
            </div>
          </div>
          <div class="flex items-center gap-4 text-sm text-gray-600">
            <span>Updated June 2025</span>
            <span>•</span>
            <span>12 min read</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <article class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Table of Contents -->
      <div
        class="bg-gradient-to-br from-blue-50 to-white rounded-2xl p-8 mb-12 border border-blue-100"
        data-aos="fade-up"
      >
        <h2
          class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"
        >
          <svg
            class="w-5 h-5 text-[#003087]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          Table of Contents
        </h2>
        <ul class="space-y-2 text-gray-700">
          <li>
            <a href="#what-is-mri" class="hover:text-[#003087] transition"
              >What is an MRI?</a
            >
          </li>
          <li>
            <a href="#how-it-works" class="hover:text-[#003087] transition"
              >How MRI Technology Works</a
            >
          </li>
          <li>
            <a href="#types-of-mri" class="hover:text-[#003087] transition"
              >Types of MRI Scans</a
            >
          </li>
          <li>
            <a href="#what-to-expect" class="hover:text-[#003087] transition"
              >What to Expect During Your MRI</a
            >
          </li>
          <li>
            <a href="#preparation" class="hover:text-[#003087] transition"
              >How to Prepare for Your MRI</a
            >
          </li>
          <li>
            <a href="#risks-safety" class="hover:text-[#003087] transition"
              >Safety and Risks</a
            >
          </li>
          <li>
            <a href="#costs" class="hover:text-[#003087] transition"
              >Understanding MRI Costs</a
            >
          </li>
          <li>
            <a href="#results" class="hover:text-[#003087] transition"
              >Understanding Your Results</a
            >
          </li>
        </ul>
      </div>

      <!-- Featured Image Section -->
      <div class="mb-12" data-aos="fade-up">
        <div
          class="relative rounded-2xl overflow-hidden bg-gray-100 aspect-video"
        >
          <!-- Placeholder for image - replace src with actual image path -->
          <img
            src="/images/blog/modern-mri.webp"
            alt="Modern MRI machine in medical imaging center"
            class="w-full h-full object-cover"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"
          >
          </div>
        </div>
        <p class="text-sm text-gray-600 text-center mt-3 italic">
          Modern MRI technology provides detailed images to help diagnose a wide
          range of conditions
        </p>
      </div>

      <!-- Content Section: What is an MRI? -->
      <section
        id="what-is-mri"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-[#003087] to-blue-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >1</span
          >
          What is an MRI?
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p class="text-lg">
            <strong>MRI (Magnetic Resonance Imaging)</strong> is a non-invasive medical
            imaging technique that uses powerful magnets, radio waves, and a computer
            to create detailed pictures of the organs, tissues, and structures inside
            your body.
          </p>

          <p>
            Unlike X-rays or CT scans, MRI doesn't use radiation, making it a
            safer option for many patients. Instead, it relies on the body's
            natural magnetic properties to generate incredibly detailed images
            that help doctors diagnose and monitor a wide range of conditions.
          </p>

          <div
            class="bg-blue-50 border-l-4 border-[#003087] p-6 rounded-r-lg my-6"
          >
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              Key Benefits of MRI
            </h3>
            <ul class="space-y-2 text-gray-700">
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-green-600 mt-0.5 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>No radiation exposure</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-green-600 mt-0.5 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Exceptional soft tissue detail</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-green-600 mt-0.5 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Can image from any angle</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-green-600 mt-0.5 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Painless and non-invasive</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Content Section: How It Works -->
      <section
        id="how-it-works"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-[#003087] to-blue-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >2</span
          >
          How MRI Technology Works
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p>
            The science behind MRI might sound complex, but the basic principle
            is fascinating. Your body is made up of millions of hydrogen atoms
            (mostly in water molecules). When you lie inside an MRI scanner,
            here's what happens:
          </p>

          <div class="grid md:grid-cols-3 gap-6 my-8">
            <div
              class="bg-white border border-gray-200 rounded-xl p-6 hover:shadow-lg transition"
            >
              <div
                class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4"
              >
                <span class="text-2xl font-bold text-[#003087]">1</span>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">
                Magnetic Field
              </h3>
              <p class="text-sm text-gray-600">
                A powerful magnet aligns hydrogen atoms in your body in one
                direction.
              </p>
            </div>

            <div
              class="bg-white border border-gray-200 rounded-xl p-6 hover:shadow-lg transition"
            >
              <div
                class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4"
              >
                <span class="text-2xl font-bold text-[#003087]">2</span>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">
                Radio Waves
              </h3>
              <p class="text-sm text-gray-600">
                Radio waves are pulsed through your body, disrupting the
                alignment.
              </p>
            </div>

            <div
              class="bg-white border border-gray-200 rounded-xl p-6 hover:shadow-lg transition"
            >
              <div
                class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4"
              >
                <span class="text-2xl font-bold text-[#003087]">3</span>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">
                Signal Detection
              </h3>
              <p class="text-sm text-gray-600">
                As atoms return to alignment, they emit signals that create
                detailed images.
              </p>
            </div>
          </div>

          <p>
            Different tissues in your body contain varying amounts of hydrogen
            and respond differently to the magnetic field. This creates contrast
            in the images, allowing radiologists to distinguish between normal
            and abnormal tissue, identify tumors, see inflammation, and detect
            other medical issues.
          </p>
        </div>
      </section>

      <!-- Content Section: Types of MRI -->
      <section
        id="types-of-mri"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-[#003087] to-blue-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >3</span
          >
          Types of MRI Scans
        </h2>

        <div class="space-y-6 text-gray-700 leading-relaxed">
          <p>
            MRI technology can be used to image virtually any part of your body.
            Here are the most common types:
          </p>

          <div class="space-y-4">
            <div
              class="bg-white border border-gray-200 rounded-xl p-6 hover:border-[#003087] transition"
            >
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Brain & Head MRI
              </h3>
              <p class="text-gray-600 mb-3">
                Used to diagnose strokes, brain tumors, aneurysms, multiple
                sclerosis, and other neurological conditions.
              </p>
              <span class="text-sm text-[#003087] font-medium"
                >Common for: Headaches, seizures, memory loss, dizziness</span
              >
            </div>

            <div
              class="bg-white border border-gray-200 rounded-xl p-6 hover:border-[#003087] transition"
            >
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Spine MRI
              </h3>
              <p class="text-gray-600 mb-3">
                Examines the vertebrae, spinal cord, and surrounding tissues to
                detect herniated discs, spinal stenosis, and tumors.
              </p>
              <span class="text-sm text-[#003087] font-medium"
                >Common for: Back pain, neck pain, numbness in extremities</span
              >
            </div>

            <div
              class="bg-white border border-gray-200 rounded-xl p-6 hover:border-[#003087] transition"
            >
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Joint MRI (Knee, Shoulder, Hip)
              </h3>
              <p class="text-gray-600 mb-3">
                Provides detailed images of cartilage, ligaments, tendons, and
                bones to diagnose sports injuries and arthritis.
              </p>
              <span class="text-sm text-[#003087] font-medium"
                >Common for: Sports injuries, joint pain, suspected tears</span
              >
            </div>

            <div
              class="bg-white border border-gray-200 rounded-xl p-6 hover:border-[#003087] transition"
            >
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Abdominal & Pelvic MRI
              </h3>
              <p class="text-gray-600 mb-3">
                Images organs including the liver, kidneys, pancreas, and
                reproductive organs to detect diseases and abnormalities.
              </p>
              <span class="text-sm text-[#003087] font-medium"
                >Common for: Abdominal pain, kidney issues, pelvic concerns</span
              >
            </div>

            <div
              class="bg-white border border-gray-200 rounded-xl p-6 hover:border-[#003087] transition"
            >
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Cardiac MRI
              </h3>
              <p class="text-gray-600 mb-3">
                Evaluates the structure and function of the heart, blood
                vessels, and can detect heart disease.
              </p>
              <span class="text-sm text-[#003087] font-medium"
                >Common for: Heart conditions, valve problems, blood flow issues</span
              >
            </div>

            <div
              class="bg-white border border-gray-200 rounded-xl p-6 hover:border-[#003087] transition"
            >
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Breast MRI
              </h3>
              <p class="text-gray-600 mb-3">
                Often used as a supplemental screening tool for high-risk
                patients or to evaluate known breast cancer.
              </p>
              <span class="text-sm text-[#003087] font-medium"
                >Common for: High-risk screening, cancer staging, dense breast
                tissue</span
              >
            </div>
          </div>
        </div>
      </section>

      <!-- Content Section: What to Expect -->
      <section
        id="what-to-expect"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-[#003087] to-blue-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >4</span
          >
          What to Expect During Your MRI
        </h2>

        <div class="space-y-4 text-gray-700 leading-relaxed">
          <p>
            Understanding what happens during an MRI can help reduce anxiety and
            ensure the best possible images. Here's a step-by-step walkthrough:
          </p>

          <div
            class="bg-gradient-to-br from-blue-50 to-white rounded-2xl p-8 my-6 border border-blue-100"
          >
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              The MRI Process
            </h3>

            <div class="space-y-6">
              <div class="flex gap-4">
                <div
                  class="w-10 h-10 bg-[#003087] rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  1
                </div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-1">
                    Check-In & Screening
                  </h4>
                  <p class="text-sm text-gray-600">
                    You'll complete a safety questionnaire about metal implants,
                    medical devices, and any health conditions.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div
                  class="w-10 h-10 bg-[#003087] rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  2
                </div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-1">Preparation</h4>
                  <p class="text-sm text-gray-600">
                    You'll change into a gown and remove all metal objects
                    (jewelry, watches, hairpins, glasses).
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div
                  class="w-10 h-10 bg-[#003087] rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  3
                </div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-1">Positioning</h4>
                  <p class="text-sm text-gray-600">
                    You'll lie down on a padded table that slides into the MRI
                    machine. Pillows and straps help you stay comfortable and
                    still.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div
                  class="w-10 h-10 bg-[#003087] rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  4
                </div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-1">
                    During the Scan
                  </h4>
                  <p class="text-sm text-gray-600">
                    The machine makes loud knocking and buzzing sounds. You'll
                    receive earplugs or headphones. The scan typically takes
                    30-60 minutes.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div
                  class="w-10 h-10 bg-[#003087] rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  5
                </div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-1">
                    Communication
                  </h4>
                  <p class="text-sm text-gray-600">
                    You can communicate with the technologist through an
                    intercom. They can see and hear you at all times.
                  </p>
                </div>
              </div>

              <div class="flex gap-4">
                <div
                  class="w-10 h-10 bg-[#003087] rounded-full flex items-center justify-center text-white font-bold shrink-0"
                >
                  6
                </div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-1">Completion</h4>
                  <p class="text-sm text-gray-600">
                    After the scan, you can immediately return to normal
                    activities. Results are typically available within a few
                    days
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div
            class="bg-yellow-50 border-l-4 border-yellow-500 p-6 rounded-r-lg my-6"
          >
            <h3
              class="text-lg font-semibold text-gray-900 mb-2 flex items-center gap-2"
            >
              <svg
                class="w-5 h-5 text-yellow-600"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                  clip-rule="evenodd"></path>
              </svg>
              Tips for a Successful MRI
            </h3>
            <ul class="space-y-2 text-gray-700 text-sm">
              <li>• Arrive 15 minutes early to complete paperwork</li>
              <li>• Wear comfortable, loose-fitting clothing without metal</li>
              <li>• Practice relaxation techniques if you feel anxious</li>
              <li>• Ask about open MRI options if you're claustrophobic</li>
              <li>
                • Stay as still as possible during imaging for clear results
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Content Section: Preparation -->
      <section
        id="preparation"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-[#003087] to-blue-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >5</span
          >
          How to Prepare for Your MRI
