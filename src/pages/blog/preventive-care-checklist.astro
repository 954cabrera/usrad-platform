---
import CarbonLayout from "../../layouts/CarbonLayout.astro";
import AOSInit from "../../components/AOSInit.astro";
import { getRelatedPosts } from "../../data/blogPosts.js";
import NewsletterPopup from "../../components/NewsletterPopup.astro";

export const prerender = true;

// For Preventive Care, link to wellness and innovation posts
const relatedPostSlugs = [
  "health-tips",
  "understanding-mri-results",
  "future-ai-medical-imaging",
];

// Get the full post data automatically from blogPosts.js
const relatedArticles = getRelatedPosts(
  "preventive-care-checklist",
  relatedPostSlugs
);
---

<CarbonLayout
  title="The Ultimate Preventive Care Checklist: Stay Healthy with Regular Screenings | USRad"
  description="Complete preventive care checklist by age. Learn which health screenings, tests, and check-ups you need to catch diseases early and stay healthy."
>
  <AOSInit />

  <!-- Hero Section -->
  <section
    class="relative bg-gradient-to-br from-green-50 via-white to-teal-50/30 pt-24 pb-16 overflow-hidden"
  >
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-40">
      <div
        class="absolute top-20 right-20 w-72 h-72 bg-green-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob"
      >
      </div>
      <div
        class="absolute top-40 left-20 w-72 h-72 bg-teal-200 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"
      >
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <!-- Breadcrumb -->
      <nav class="mb-8" data-aos="fade-up">
        <ol class="flex items-center gap-2 text-sm text-gray-600">
          <li>
            <a href="/blog" class="hover:text-[#003087] transition">Blog</a>
          </li>
          <li><span class="text-gray-400">/</span></li>
          <li class="text-gray-900 font-medium">
            The Ultimate Preventive Care Checklist
          </li>
        </ol>
      </nav>

      <!-- Title Section -->
      <div class="max-w-3xl" data-aos="fade-up" data-aos-delay="100">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-medium mb-6"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          Preventive Care • Complete Checklist
        </div>

        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight"
        >
          The Ultimate Preventive Care Checklist
        </h1>

        <p class="text-xl text-gray-600 leading-relaxed mb-8">
          Stay healthy with regular screenings and check-ups. This comprehensive
          guide tells you exactly which tests you need at every age to catch
          diseases early and live your healthiest life.
        </p>

        <!-- Author & Date -->
        <div
          class="flex flex-wrap items-center gap-6 pb-8 border-b border-gray-200"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-12 h-12 bg-gradient-to-br from-green-600 to-teal-600 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">USRad Healthcare Team</p>
              <p class="text-sm text-gray-600">Preventive Medicine Experts</p>
            </div>
          </div>
          <div class="flex items-center gap-4 text-sm text-gray-600">
            <span>Updated August 2025</span>
            <span>•</span>
            <span>15 min read</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <article class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Key Takeaway Banner -->
      <div
        class="bg-gradient-to-r from-green-600 to-teal-600 rounded-2xl p-8 mb-12 text-white"
        data-aos="fade-up"
      >
        <h2 class="text-2xl font-bold mb-3">✅ Why Preventive Care Matters</h2>
        <p class="text-lg text-green-50">
          Regular preventive screenings can detect diseases <strong
            >years before symptoms appear</strong
          >, when they're most treatable and often curable. Early detection
          saves lives—and saves money.
        </p>
      </div>

      <!-- Quick Jump Navigation -->
      <div
        class="bg-gradient-to-br from-green-50 to-white rounded-2xl p-8 mb-12 border border-green-100"
        data-aos="fade-up"
      >
        <h2
          class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"
        >
          <svg
            class="w-5 h-5 text-green-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
            ></path>
          </svg>
          Jump to Your Age Group
        </h2>
        <div class="grid md:grid-cols-4 gap-4">
          <a
            href="#ages-18-39"
            class="bg-white rounded-lg p-4 text-center hover:shadow-lg transition border border-gray-200 hover:border-green-400"
          >
            <p class="text-2xl font-bold text-green-600">18-39</p>
            <p class="text-sm text-gray-600">Young Adults</p>
          </a>
          <a
            href="#ages-40-49"
            class="bg-white rounded-lg p-4 text-center hover:shadow-lg transition border border-gray-200 hover:border-green-400"
          >
            <p class="text-2xl font-bold text-green-600">40-49</p>
            <p class="text-sm text-gray-600">Early Midlife</p>
          </a>
          <a
            href="#ages-50-64"
            class="bg-white rounded-lg p-4 text-center hover:shadow-lg transition border border-gray-200 hover:border-green-400"
          >
            <p class="text-2xl font-bold text-green-600">50-64</p>
            <p class="text-sm text-gray-600">Midlife</p>
          </a>
          <a
            href="#ages-65-plus"
            class="bg-white rounded-lg p-4 text-center hover:shadow-lg transition border border-gray-200 hover:border-green-400"
          >
            <p class="text-2xl font-bold text-green-600">65+</p>
            <p class="text-sm text-gray-600">Older Adults</p>
          </a>
        </div>
      </div>

      <!-- Featured Image Section -->
      <div class="mb-12" data-aos="fade-up">
        <div
          class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-green-100 to-teal-100 aspect-video flex items-center justify-center"
        >
          <img
            src="/images/blog/checklist.webp"
            alt="Patient getting preventive health screening"
            class="w-full h-full object-cover"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"
          >
          </div>
        </div>
        <p class="text-sm text-gray-600 text-center mt-3 italic">
          Regular preventive screenings catch diseases early when they're most
          treatable
        </p>
      </div>

      <!-- Introduction -->
      <section class="prose prose-lg max-w-none mb-16" data-aos="fade-up">
        <p class="text-xl text-gray-700 leading-relaxed">
          Preventive care is your best defense against serious illness. This
          comprehensive checklist outlines exactly which screenings, tests, and
          vaccinations you need at every stage of life—based on recommendations
          from the CDC, American Cancer Society, and major medical
          organizations.
        </p>

        <div
          class="bg-blue-50 border-l-4 border-blue-500 p-6 rounded-r-lg my-8"
        >
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            💡 How to Use This Checklist
          </h3>
          <ol class="space-y-2 text-gray-700 text-sm">
            <li>1. Find your age group below</li>
            <li>2. Review recommended screenings and tests</li>
            <li>3. Schedule appointments for any overdue screenings</li>
            <li>4. Save this page as a reference for future check-ups</li>
            <li>5. Discuss your personal risk factors with your doctor</li>
          </ol>
        </div>
      </section>

      <!-- Ages 18-39 Section -->
      <section
        id="ages-18-39"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-green-600 to-teal-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >1</span
          >
          Ages 18-39: Young Adults
        </h2>

        <div class="space-y-6 text-gray-700 leading-relaxed">
          <p class="text-lg">
            Even if you feel healthy, establishing baseline health metrics now
            helps track changes over time and catch problems early.
          </p>

          <!-- Annual Screenings -->
          <div
            class="bg-gradient-to-br from-blue-50 to-white rounded-xl p-6 border border-blue-200"
          >
            <h3
              class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"
            >
              <span class="text-2xl">📋</span>
              Annual Check-Up (Every Year)
            </h3>
            <div class="space-y-3 text-sm">
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">Blood Pressure</p>
                  <p class="text-gray-600">
                    Check annually; more often if elevated (>120/80)
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">BMI & Weight</p>
                  <p class="text-gray-600">
                    Track healthy weight and discuss nutrition concerns
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-green-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">Skin Check</p>
                  <p class="text-gray-600">
                    Self-exam monthly; doctor exam if high sun exposure
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Periodic Screenings -->
          <div
            class="bg-gradient-to-br from-purple-50 to-white rounded-xl p-6 border border-purple-200"
          >
            <h3
              class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"
            >
              <span class="text-2xl">🩺</span>
              Periodic Screenings
            </h3>
            <div class="space-y-4 text-sm">
              <div class="bg-white rounded-lg p-4 border border-gray-200">
                <p class="font-semibold text-gray-900 mb-1">
                  Cholesterol Screening
                </p>
                <p class="text-gray-600 mb-2">
                  Every 4-6 years starting at age 20; more often if at risk
                </p>
                <p class="text-xs text-gray-500">
                  ⚠️ Test earlier if family history of heart disease
                </p>
              </div>
              <div class="bg-white rounded-lg p-4 border border-gray-200">
                <p class="font-semibold text-gray-900 mb-1">
                  Diabetes Screening
                </p>
                <p class="text-gray-600 mb-2">
                  Every 3 years if overweight/obese or at risk
                </p>
                <p class="text-xs text-gray-500">
                  Risk factors: family history, PCOS, sedentary lifestyle
                </p>
              </div>
              <div class="bg-white rounded-lg p-4 border border-gray-200">
                <p class="font-semibold text-gray-900 mb-1">Dental Exam</p>
                <p class="text-gray-600">
                  Every 6 months for cleaning and check-up
                </p>
              </div>
              <div class="bg-white rounded-lg p-4 border border-gray-200">
                <p class="font-semibold text-gray-900 mb-1">Eye Exam</p>
                <p class="text-gray-600 mb-2">
                  Every 2 years, or annually if you wear glasses/contacts
                </p>
                <p class="text-xs text-gray-500">
                  More frequent if diabetes or family history of glaucoma
                </p>
              </div>
            </div>
          </div>

          <!-- Women's Health -->
          <div
            class="bg-gradient-to-br from-pink-50 to-white rounded-xl p-6 border border-pink-200"
          >
            <h3
              class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"
            >
              <span class="text-2xl">👩‍⚕️</span>
              Women's Health Screenings
            </h3>
            <div class="space-y-3 text-sm">
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-pink-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">Pap Smear</p>
                  <p class="text-gray-600">
                    Every 3 years (ages 21-29) or Pap + HPV test every 5 years
                    (30-39)
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-pink-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">
                    Clinical Breast Exam
                  </p>
                  <p class="text-gray-600">
                    Every 1-3 years starting at age 25; discuss with doctor
                  </p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-pink-600 shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <div>
                  <p class="font-semibold text-gray-900">STI Screening</p>
                  <p class="text-gray-600">
                    Annually if sexually active; discuss with doctor
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Vaccinations -->
          <div
            class="bg-gradient-to-br from-yellow-50 to-white rounded-xl p-6 border border-yellow-200"
          >
            <h3
              class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2"
            >
              <span class="text-2xl">💉</span>
              Recommended Vaccinations
            </h3>
            <div class="grid md:grid-cols-2 gap-4 text-sm">
              <div class="bg-white rounded-lg p-4 border border-gray-200">
                <p class="font-semibold text-gray-900">Flu Shot</p>
                <p class="text-gray-600">Annually, every fall</p>
              </div>
              <div class="bg-white rounded-lg p-4 border border-gray-200">
                <p class="font-semibold text-gray-900">COVID-19</p>
                <p class="text-gray-600">As recommended by CDC</p>
              </div>
              <div class="bg-white rounded-lg p-4 border border-gray-200">
                <p class="font-semibold text-gray-900">Tdap Booster</p>
                <p class="text-gray-600">Every 10 years</p>
              </div>
              <div class="bg-white rounded-lg p-4 border border-gray-200">
                <p class="font-semibold text-gray-900">HPV Vaccine</p>
                <p class="text-gray-600">Up to age 26 (3 doses)</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Ages 40-49 Section -->
      <section
        id="ages-40-49"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
            class="w-10 h-10 bg-gradient-to-br from-green-600 to-teal-600 rounded-lg flex items-center justify-center text-white text-xl font-bold shrink-0"
            >2</span
          >
          Ages 40-49: Early Midlife
        </h2>

        <div class="space-y-6 text-gray-700 leading-relaxed">
          <p class="text-lg">
            Your 40s are a critical decade for preventive care. Many chronic
            diseases begin developing now, but early detection dramatically
            improves outcomes.
          </p>

          <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-lg">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              ⚠️ NEW Screenings Starting at Age 40
            </h3>
            <ul class="space-y-2 text-gray-700 text-sm">
              <li>
                • <strong>Mammogram:</strong> Annual breast cancer screening for
                women
              </li>
              <li>
                • <strong>Diabetes screening:</strong> Every 3 years for everyone
              </li>
              <li>
                • <strong>Cardiovascular risk assessment:</strong> Especially if
                risk factors present
              </li>
            </ul>
          </div>

          <!-- Continue All Previous Screenings -->
          <div class="bg-blue-50 rounded-xl p-6 border border-blue-200">
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              ✅ Continue All Screenings from Ages 18-39, Plus:
            </h3>
            <p class="text-sm text-gray-600">
              Blood pressure, cholesterol, BMI, dental, eye exams, Pap smear
              (women), vaccinations
            </p>
          </div>

          <!-- New & Key Screenings -->
          <div class="grid md:grid-cols-2 gap-6">
            <div
              class="bg-gradient-to-br from-pink-50 to-white rounded-xl p-6 border-2 border-pink-300"
            >
              <h3
                class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2"
              >
                <span class="text-2xl">🎗️</span>
                Mammogram (Women)
              </h3>
              <p class="text-sm text-gray-700 mb-3">
                <strong>Starting at age 40:</strong> Annual mammograms for breast
                cancer screening
              </p>
              <div class="bg-pink-100 rounded-lg p-3">
                <p class="text-xs text-gray-700">
                  <strong>High Risk?</strong> Start earlier if family history of
                  breast cancer. Consider genetic testing (BRCA1/BRCA2).
                </p>
              </div>
              <div class="mt-3 bg-[#003087] rounded-lg p-3 text-white">
                <p class="text-xs">
                  <strong>💰 USRad Pricing:</strong> Screening mammograms from $99
                </p>
              </div>
            </div>

            <div
              class="bg-gradient-to-br from-purple-50 to-white rounded-xl p-6 border-2 border-purple-300"
            >
              <h3
                class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2"
              >
                <span class="text-2xl">🩸</span>
                Diabetes Screening
              </h3>
              <p class="text-sm text-gray-700 mb-3">
                <strong>Every 3 years:</strong> Hemoglobin A1C or fasting glucose
                test
              </p>
              <div class="bg-purple-100 rounded-lg p-3">
                <p class="text-xs text-gray-700">
                  <strong>Risk Factors:</strong> Overweight, sedentary lifestyle,
                  family history, PCOS, gestational diabetes history
                </p>
              </div>
            </div>
          </div>

          <!-- Additional Important Screenings -->
          <div
            class="bg-gradient-to-br from-blue-50 to-white rounded-xl p-6 border border-blue-200"
          >
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              📊 Heart Health Assessments
            </h3>
            <div class="space-y-3 text-sm">
              <div>
                <p class="font-semibold text-gray-900">Cholesterol Panel</p>
                <p class="text-gray-600">
                  Every 4-6 years; annually if high cholesterol or on medication
                </p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">Blood Pressure</p>
                <p class="text-gray-600">
                  Annually; more often if elevated or on medication
                </p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">
                  Cardiovascular Risk Assessment
                </p>
                <p class="text-gray-600">
                  Discuss 10-year risk score with doctor if you have risk
                  factors
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Ages 50-64 Section -->
      <section
        id="ages-50-64"
        class="prose prose-lg max-w-none mb-16"
        data-aos="fade-up"
      >
        <h2
          class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span
