---
// src/pages/book.astro
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import PatientBookingFlow from "../components/PatientBookingFlow.jsx";

const url = new URL(Astro.request.url);
const facilityId = url.searchParams.get("facilityId");
const procedure = url.searchParams.get("procedure");
const cptCode = url.searchParams.get("cptCode");
const price = url.searchParams.get("price");

if (!facilityId) {
  return Astro.redirect("/search-test");
}
---

<MainPatientLayout>
  <Fragment slot="title">Book Your Appointment - USRad</Fragment>

  <!-- Remove the search bar line and breadcrumb -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Back to Search Button - Enhanced -->
    <div class="mb-8">
      <a
        href="/search-test"
        class="inline-flex items-center text-[#003087] hover:text-blue-800 font-medium transition-all duration-200 group bg-white px-4 py-2 rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-md"
      >
        <svg
          class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform duration-200"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Search Results
      </a>
    </div>

    <!-- Page Header -->
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-[#003087] mb-3">
        Book Your Appointment
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Complete your booking in just a few simple steps. We'll confirm your
        appointment within 4 hours.
      </p>
    </div>

    <!-- Booking Component Container - Enhanced -->
    <div class="max-w-5xl mx-auto">
      <div
        class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100"
      >
        <!-- Optional: Add a subtle gradient header -->
        <div
          class="bg-gradient-to-r from-blue-50 to-indigo-50 px-8 py-6 border-b border-gray-100"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <div
                class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                  ></path>
                </svg>
              </div>
              <div>
                <h2 class="text-xl font-semibold text-[#003087]">
                  Secure Booking Process
                </h2>
                <p class="text-sm text-gray-600">
                  Your information is protected and secure
                </p>
              </div>
            </div>
            <div
              class="hidden md:flex items-center space-x-4 text-sm text-gray-600"
            >
              <div class="flex items-center">
                <svg
                  class="w-4 h-4 mr-1 text-green-500"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                Secure Payment
              </div>
              <div class="flex items-center">
                <svg
                  class="w-4 h-4 mr-1 text-green-500"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                4-Hour Confirmation
              </div>
              <div class="flex items-center">
                <svg
                  class="w-4 h-4 mr-1 text-green-500"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                Guaranteed Pricing
              </div>
            </div>
          </div>
        </div>

        <!-- Booking Flow Content -->
        <div class="p-8">
          <PatientBookingFlow
            facilityId={facilityId}
            procedure={procedure}
            cptCode={cptCode}
            price={price}
            client:load
          />
        </div>
      </div>
    </div>

    <!-- Help Section -->
    <div class="max-w-3xl mx-auto mt-12 text-center">
      <div
        class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-xl p-6 border border-amber-200"
      >
        <h3 class="text-lg font-semibold text-[#003087] mb-2">Need Help?</h3>
        <p class="text-gray-600 mb-4">
          Our Patient Navigators are here to assist you with your booking
          process.
        </p>
        <div
          class="flex flex-col sm:flex-row items-center justify-center space-y-2 sm:space-y-0 sm:space-x-6"
        >
          <a
            href="tel:1-800-877-2324"
            class="flex items-center text-[#003087] hover:text-blue-800 font-medium transition-colors"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            1-800-USRAD24
          </a>
          <a
            href="mailto:support@usrad.com"
            class="flex items-center text-[#003087] hover:text-blue-800 font-medium transition-colors"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            support@usrad.com
          </a>
        </div>
      </div>
    </div>
  </div>
</MainPatientLayout>

<style>
  /* Enhanced styling */
  :global(.booking-flow) {
    font-family: "Manrope", system-ui, sans-serif;
  }

  /* Add smooth scrolling */
  :global(html) {
    scroll-behavior: smooth;
  }

  /* Custom scrollbar */
  :global(::-webkit-scrollbar) {
    width: 8px;
  }

  :global(::-webkit-scrollbar-track) {
    background: #f8fafc;
  }

  :global(::-webkit-scrollbar-thumb) {
    background: #cbd5e1;
    border-radius: 4px;
  }

  :global(::-webkit-scrollbar-thumb:hover) {
    background: #94a3b8;
  }

  /* Add subtle animations */
  .booking-container {
    animation: fadeInUp 0.6s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
