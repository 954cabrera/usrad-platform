<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>USRad - Not Just Another Booking Tool</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: #0a0e27;
        color: white;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        overflow: hidden;
        height: 100vh;
        width: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        margin: 0;
        padding: 0;
      }

      /* Animated gradient background */
      .bg-gradient {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 200%;
        height: 200%;
        background:
          radial-gradient(
            circle at 20% 50%,
            rgba(204, 153, 51, 0.3) 0%,
            transparent 50%
          ),
          radial-gradient(
            circle at 80% 50%,
            rgba(0, 48, 135, 0.3) 0%,
            transparent 50%
          );
        animation: rotateGradient 20s linear infinite;
      }

      @keyframes rotateGradient {
        0% {
          transform: rotate(0deg) translate(-50%, -50%);
        }
        100% {
          transform: rotate(360deg) translate(-50%, -50%);
        }
      }

      .container {
        position: relative;
        z-index: 10;
        text-align: center;
        width: 100%;
        max-width: 1400px;
        padding: 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      /* Countdown timer */
      .countdown {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 8rem;
        font-weight: bold;
        color: #cc9933;
        text-shadow: 0 0 40px rgba(204, 153, 51, 0.5);
        z-index: 100;
      }

      /* All animated elements start hidden */
      .main-title {
        font-size: 3.5rem;
        font-weight: 900;
        margin-bottom: 20px;
        line-height: 1.1;
        opacity: 0;
        text-align: center;
      }

      .main-title.animate {
        animation: titleSlam 0.6s ease-out forwards;
      }

      @keyframes titleSlam {
        0% {
          opacity: 0;
          transform: scale(1.5) translateY(-50px);
        }
        60% {
          opacity: 1;
          transform: scale(0.95) translateY(0);
        }
        100% {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }

      .highlight {
        background: linear-gradient(45deg, #cc9933, #f59e0b);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        display: inline-block;
        animation: shimmer 2s ease-in-out infinite;
      }

      @keyframes shimmer {
        0%,
        100% {
          filter: brightness(1);
        }
        50% {
          filter: brightness(1.4);
        }
      }

      .subtitle {
        font-size: 1.8rem;
        color: #94a3b8;
        font-weight: 300;
        opacity: 0;
        transform: translateY(20px);
        margin-bottom: 50px;
      }

      .subtitle.animate {
        animation: fadeInUp 0.6s ease-out forwards;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Value props grid */
      .value-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin: 40px auto;
        width: 100%;
        max-width: 1200px;
      }

      .value-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 25px 20px;
        opacity: 0;
        transform: translateY(50px) rotateX(-10deg);
        transition: all 0.3s ease;
        min-height: 200px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .value-card.animate {
        animation: flipIn 0.6s ease-out forwards;
      }

      @keyframes flipIn {
        to {
          opacity: 1;
          transform: translateY(0) rotateX(0);
        }
      }

      .value-card:hover {
        transform: translateY(-10px);
        background: rgba(255, 255, 255, 0.1);
        border-color: #cc9933;
        box-shadow: 0 20px 40px rgba(204, 153, 51, 0.3);
      }

      .value-icon {
        font-size: 3rem;
        margin-bottom: 15px;
        display: block;
        filter: drop-shadow(0 0 20px rgba(204, 153, 51, 0.5));
      }

      .value-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #cc9933;
        margin-bottom: 10px;
      }

      .value-desc {
        font-size: 1rem;
        color: #cbd5e1;
        line-height: 1.5;
      }

      /* Bottom guarantee banner */
      .guarantee-banner {
        position: fixed;
        bottom: 60px;
        left: 50%;
        transform: translateX(-50%) translateY(200px);
        background: linear-gradient(90deg, #cc9933, #f59e0b);
        padding: 20px 60px;
        border-radius: 50px;
        opacity: 0;
        box-shadow: 0 10px 40px rgba(204, 153, 51, 0.4);
        z-index: 100;
      }

      .guarantee-banner.animate {
        animation: bannerSlide 0.8s ease-out forwards;
      }

      @keyframes bannerSlide {
        0% {
          opacity: 0;
          transform: translateX(-50%) translateY(100px);
        }
        100% {
          opacity: 1;
          transform: translateX(-50%) translateY(0);
        }
      }

      .guarantee-text {
        font-size: 1.5rem;
        font-weight: 800;
        color: #003087;
        display: flex;
        align-items: center;
        gap: 15px;
      }

      .guarantee-text span {
        display: inline-block;
        animation: pulse 1s ease-in-out infinite;
      }

      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.1);
        }
      }

      /* Particle effects */
      .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: #cc9933;
        border-radius: 50%;
        opacity: 0;
        animation: floatUp 3s ease-out infinite;
      }

      @keyframes floatUp {
        0% {
          opacity: 0;
          transform: translateY(100vh) scale(0);
        }
        10% {
          opacity: 1;
          transform: translateY(80vh) scale(1);
        }
        90% {
          opacity: 1;
          transform: translateY(20vh) scale(1);
        }
        100% {
          opacity: 0;
          transform: translateY(0) scale(0);
        }
      }

      /* Strike-through effect for comparison */
      .strike {
        text-decoration: line-through;
        opacity: 0.5;
        color: #ef4444;
      }
    </style>
  </head>
  <body>
    <div class="bg-gradient"></div>

    <div class="countdown" id="countdown">15</div>

    <div class="container">
      <h1 class="main-title" id="title">
        That's Why We Built <span class="highlight">USRad</span>
      </h1>

      <p class="subtitle" id="subtitle">
        <span class="strike">Not just another booking tool</span> → A TRUE Managed
        Care Platform
      </p>

      <div class="value-grid">
        <div class="value-card" id="card1">
          <span class="value-icon">🎯</span>
          <h3 class="value-title">We Find Patients</h3>
          <p class="value-desc">90M+ target market actively acquired for you</p>
        </div>

        <div class="value-card" id="card2">
          <span class="value-icon">📅</span>
          <h3 class="value-title">We Handle Scheduling</h3>
          <p class="value-desc">Complete coordination & 96% show rate</p>
        </div>

        <div class="value-card" id="card3">
          <span class="value-icon">💰</span>
          <h3 class="value-title">We Collect Payment</h3>
          <p class="value-desc">100% upfront collection guaranteed</p>
        </div>

        <div class="value-card" id="card4">
          <span class="value-icon">✅</span>
          <h3 class="value-title">You Get Paid</h3>
          <p class="value-desc">10-day guarantee, every time</p>
        </div>
      </div>

      <div class="guarantee-banner" id="banner">
        <div class="guarantee-text">
          <span>🚫</span> NO Billing • NO Insurance • NO Nonsense
        </div>
      </div>
    </div>

    <script>
      // Countdown and animation controller
      let count = 15;
      const countdownEl = document.getElementById("countdown");

      // Countdown timer
      const countInterval = setInterval(() => {
        count--;
        if (count > 0) {
          countdownEl.textContent = count;
        } else if (count === 0) {
          countdownEl.style.display = "none";
          clearInterval(countInterval);
          // Start animations
          startAnimations();
        }
      }, 1000);

      // Animation sequence
      function startAnimations() {
        // Title
        document.getElementById("title").classList.add("animate");

        // Subtitle after 300ms
        setTimeout(() => {
          document.getElementById("subtitle").classList.add("animate");
        }, 300);

        // Cards
        setTimeout(() => {
          document.getElementById("card1").classList.add("animate");
        }, 800);

        setTimeout(() => {
          document.getElementById("card2").classList.add("animate");
        }, 1100);

        setTimeout(() => {
          document.getElementById("card3").classList.add("animate");
        }, 1400);

        setTimeout(() => {
          document.getElementById("card4").classList.add("animate");
        }, 1700);

        // Banner
        setTimeout(() => {
          document.getElementById("banner").classList.add("animate");
        }, 2300);
      }

      // Create floating particles
      function createParticle() {
        const particle = document.createElement("div");
        particle.className = "particle";
        particle.style.left = Math.random() * 100 + "%";
        particle.style.animationDelay = Math.random() * 3 + "s";
        document.body.appendChild(particle);

        setTimeout(() => particle.remove(), 3000);
      }

      // Create particles periodically
      setInterval(createParticle, 200);

      // Manual restart with 'R' key
      document.addEventListener("keypress", (e) => {
        if (e.key === "r" || e.key === "R") {
          location.reload();
        }
      });
    </script>
  </body>
</html>
