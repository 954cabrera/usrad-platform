---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;

// Job openings data
const jobOpenings = [
  {
    title: "Senior Radiologist",
    department: "Medical",
    location: "Remote",
    type: "Full-time",
    status: "Coming Soon",
    description:
      "Lead our network of expert radiologists in delivering exceptional patient care",
  },
  {
    title: "Customer Success Manager",
    department: "Operations",
    location: "Fort Lauderdale, FL",
    type: "Full-time",
    status: "Coming Soon",
    description:
      "Help patients navigate their imaging journey with empathy and expertise",
  },
  {
    title: "Medical Director",
    department: "Leadership",
    location: "Remote",
    type: "Part-time",
    status: "Coming Soon",
    description:
      "Shape the future of affordable medical imaging across our network",
  },
  {
    title: "Software Engineer",
    department: "Technology",
    location: "Remote",
    type: "Full-time",
    status: "Coming Soon",
    description:
      "Build the platform that's democratizing access to medical imaging",
  },
];

const benefits = [
  {
    icon: "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z",
    title: "Mission-Driven Impact",
    description: "Help 90 million Americans access affordable healthcare",
  },
  {
    icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
    title: "Remote-First Culture",
    description: "Work from anywhere while transforming healthcare",
  },
  {
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    title: "Comprehensive Benefits",
    description: "Health, dental, vision, 401k, and unlimited PTO",
  },
  {
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    title: "Growth Opportunities",
    description: "Learn from industry leaders and shape your career path",
  },
];
---

<CarbonLayout
  title="Careers at USRad - Join Our Mission"
  description="Build your career while making healthcare accessible to millions. Join USRad's mission-driven team."
>
  <AOSInit />

  <!-- Hero Section with Animated Background -->
  <section
    class="relative min-h-[600px] overflow-hidden bg-gradient-to-br from-[#003087] via-blue-600 to-[#003087]"
  >
    <!-- Animated particle background -->
    <div class="absolute inset-0">
      <div class="particle-container">
        <div class="particle particle-1"></div>
        <div class="particle particle-2"></div>
        <div class="particle particle-3"></div>
        <div class="particle particle-4"></div>
        <div class="particle particle-5"></div>
        <div class="particle particle-6"></div>
        <div class="particle particle-7"></div>
        <div class="particle particle-8"></div>
      </div>
    </div>

    <!-- Animated network lines -->
    <svg class="absolute inset-0 w-full h-full" style="opacity: 0.1;">
      <defs>
        <pattern
          id="network-pattern"
          x="0"
          y="0"
          width="100"
          height="100"
          patternUnits="userSpaceOnUse"
        >
          <circle cx="50" cy="50" r="1" fill="#ffffff" class="animate-pulse"
          ></circle>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#network-pattern)"></rect>
      <g class="network-lines">
        <line
          x1="10%"
          y1="20%"
          x2="30%"
          y2="40%"
          stroke="#ffffff"
          stroke-width="0.5"
          opacity="0.3"></line>
        <line
          x1="30%"
          y1="40%"
          x2="50%"
          y2="30%"
          stroke="#ffffff"
          stroke-width="0.5"
          opacity="0.3"></line>
        <line
          x1="50%"
          y1="30%"
          x2="70%"
          y2="50%"
          stroke="#ffffff"
          stroke-width="0.5"
          opacity="0.3"></line>
        <line
          x1="70%"
          y1="50%"
          x2="90%"
          y2="40%"
          stroke="#ffffff"
          stroke-width="0.5"
          opacity="0.3"></line>
        <line
          x1="20%"
          y1="60%"
          x2="40%"
          y2="70%"
          stroke="#ffffff"
          stroke-width="0.5"
          opacity="0.3"></line>
        <line
          x1="40%"
          y1="70%"
          x2="60%"
          y2="65%"
          stroke="#ffffff"
          stroke-width="0.5"
          opacity="0.3"></line>
        <line
          x1="60%"
          y1="65%"
          x2="80%"
          y2="75%"
          stroke="#ffffff"
          stroke-width="0.5"
          opacity="0.3"></line>
      </g>
    </svg>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="text-center">
        <div
          class="inline-flex items-center justify-center px-4 py-2 mb-6 text-sm font-medium text-blue-100 bg-blue-800/30 backdrop-blur-sm border border-blue-400/30 rounded-full"
          data-aos="fade-down"
        >
          <span class="animate-pulse mr-2">●</span>
          We're Hiring
        </div>

        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6"
          data-aos="fade-up"
        >
          Join the
          <span class="relative inline-block">
            <span class="relative z-10 text-[#cc9933] font-bold">
              Revolution
            </span>
            <svg
              class="absolute -bottom-2 left-0 w-full"
              viewBox="0 0 300 12"
              preserveAspectRatio="none"
            >
              <path
                d="M0,6 Q150,0 300,6"
                stroke="#cc9933"
                stroke-width="3"
                fill="none"
                class="path-underline"></path>
            </svg>
          </span>
        </h1>

        <p
          class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-8"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Help us make quality medical imaging accessible to 90 million
          Americans. Build your career while building a better healthcare
          system.
        </p>

        <div
          class="flex flex-col sm:flex-row gap-4 justify-center"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <a
            href="#openings"
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-[#003087] font-semibold rounded-full hover:bg-gray-100 transition transform hover:scale-105"
          >
            View Open Positions
            <svg
              class="ml-2 w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
          <a
            href="#culture"
            class="inline-flex items-center justify-center px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-full hover:bg-white hover:text-[#003087] transition transform hover:scale-105"
          >
            Learn About Our Culture
            <svg
              class="ml-2 w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>

        <!-- Animated stats -->
        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-16"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-white mb-2">
              90M+
            </div>
            <div class="text-blue-200">People We Serve</div>
          </div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-white mb-2">
              80%
            </div>
            <div class="text-blue-200">Cost Savings</div>
          </div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-white mb-2">
              1,000+
            </div>
            <div class="text-blue-200">Partner Centers</div>
          </div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-white mb-2">
              24hr
            </div>
            <div class="text-blue-200">Result Turnaround</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Animated wave bottom -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg
        viewBox="0 0 1440 120"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none"
        class="w-full h-20"
      >
        <path
          d="M0 120V60C240 20 480 20 720 60C960 100 1200 100 1440 60V120H0Z"
          fill="white"
          class="wave-path"></path>
      </svg>
    </div>
  </section>

  <!-- Culture Section -->
  <section id="culture" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2
          class="text-4xl md:text-5xl font-bold text-gray-900 mb-4"
          data-aos="fade-up"
        >
          Why USRad?
        </h2>
        <p
          class="text-xl text-gray-600 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="50"
        >
          Join a team that's passionate about making healthcare accessible while
          building rewarding careers
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          benefits.map((benefit, index) => (
            <div class="group" data-aos="fade-up" data-aos-delay={index * 50}>
              <div class="bg-gradient-to-br from-gray-50 to-white p-8 rounded-2xl border border-gray-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 h-full">
                <div class="w-14 h-14 bg-gradient-to-br from-[#003087] to-blue-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                  <svg
                    class="w-7 h-7 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d={benefit.icon}
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-3">
                  {benefit.title}
                </h3>
                <p class="text-gray-600">{benefit.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-20 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div data-aos="fade-right">
          <h2 class="text-4xl font-bold text-gray-900 mb-6">
            Our Values Drive Everything We Do
          </h2>
          <div class="space-y-6">
            <div class="flex items-start">
              <div
                class="flex-shrink-0 w-1 h-16 bg-gradient-to-b from-[#003087] to-blue-600 rounded-full mr-4"
              >
              </div>
              <div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">
                  Patient First
                </h3>
                <p class="text-gray-600">
                  Every decision we make starts with how it impacts patient
                  access to care
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="flex-shrink-0 w-1 h-16 bg-gradient-to-b from-[#cc9933] to-yellow-500 rounded-full mr-4"
              >
              </div>
              <div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">
                  Radical Transparency
                </h3>
                <p class="text-gray-600">
                  From pricing to processes, we believe in complete openness
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="flex-shrink-0 w-1 h-16 bg-gradient-to-b from-blue-600 to-[#003087] rounded-full mr-4"
              >
              </div>
              <div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">
                  Innovation with Purpose
                </h3>
                <p class="text-gray-600">
                  We use technology to solve real healthcare problems, not just
                  to be trendy
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative" data-aos="fade-left">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl">
            <img
              src="/images/usrad-team-collaboration.webp"
              alt="USRad team collaboration"
              loading="lazy"
              decoding="async"
              class="w-full h-auto"
            />

            <div
              class="absolute inset-0 bg-gradient-to-t from-[#003087]/80 to-transparent flex items-end p-8"
            >
              <blockquote class="text-white">
                <p class="text-lg font-medium mb-2">
                  "At USRad, we're not just building a company – we're building
                  a movement to democratize healthcare access."
                </p>
                <cite class="text-blue-200">- Leadership Team</cite>
              </blockquote>
            </div>
          </div>
          <div
            class="absolute -top-4 -right-4 w-24 h-24 bg-[#cc9933] rounded-full opacity-20 blur-2xl"
          >
          </div>
          <div
            class="absolute -bottom-4 -left-4 w-32 h-32 bg-[#003087] rounded-full opacity-20 blur-2xl"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Open Positions -->
  <section id="openings" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2
          class="text-4xl md:text-5xl font-bold text-gray-900 mb-4"
          data-aos="fade-up"
        >
          Open Positions
        </h2>
        <p class="text-xl text-gray-600" data-aos="fade-up" data-aos-delay="50">
          Find your place in our growing team
        </p>
      </div>

      <div class="space-y-4">
        {
          jobOpenings.map((job, index) => (
            <div
              class="group bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-xl transition-all duration-300 cursor-pointer"
              data-aos="fade-up"
              data-aos-delay={index * 50}
            >
              <div class="flex flex-col lg:flex-row lg:items-center justify-between">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <h3 class="text-2xl font-semibold text-gray-900 group-hover:text-[#003087] transition-colors">
                      {job.title}
                    </h3>
                    <span class="inline-flex items-center px-3 py-1 text-xs font-medium text-[#cc9933] bg-yellow-50 rounded-full">
                      {job.status}
                    </span>
                  </div>
                  <p class="text-gray-600 mb-3">{job.description}</p>
                  <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
                    <span class="flex items-center">
                      <svg
                        class="w-4 h-4 mr-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                        />
                      </svg>
                      {job.department}
                    </span>
                    <span class="flex items-center">
                      <svg
                        class="w-4 h-4 mr-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                        />
                      </svg>
                      {job.location}
                    </span>
                    <span class="flex items-center">
                      <svg
                        class="w-4 h-4 mr-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        />
                      </svg>
                      {job.type}
                    </span>
                  </div>
                </div>
                <div class="mt-4 lg:mt-0 lg:ml-8">
                  <div class="inline-flex items-center text-[#003087] group-hover:translate-x-2 transition-transform">
                    <span class="font-medium">Learn more</span>
                    <svg
                      class="w-5 h-5 ml-2"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"
                      />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- CTA Box -->
      <div
        class="mt-16 bg-gradient-to-r from-[#003087] to-blue-700 rounded-3xl p-8 md:p-12 text-center"
        data-aos="fade-up"
      >
        <h3 class="text-3xl font-bold text-white mb-4">
          Don't See Your Perfect Role?
        </h3>
        <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
          We're always looking for exceptional talent. Send us your resume and
          let's start a conversation about your future at USRad.
        </p>
        <a
          href="mailto:hello@usrad.com"
          class="inline-flex items-center justify-center px-8 py-4 bg-white text-[#003087] font-semibold rounded-full hover:bg-gray-100 transition transform hover:scale-105"
        >
          <svg
            class="w-5 h-5 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          Send Your Resume
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Particle animations */
    .particle-container {
      position: absolute;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .particle {
      position: absolute;
      width: 4px;
      height: 4px;
      background: white;
      border-radius: 50%;
      opacity: 0.3;
    }

    .particle-1 {
      top: 10%;
      left: 10%;
      animation: float-1 20s infinite ease-in-out;
    }

    .particle-2 {
      top: 20%;
      left: 80%;
      animation: float-2 18s infinite ease-in-out;
    }

    .particle-3 {
      top: 60%;
      left: 30%;
      animation: float-3 22s infinite ease-in-out;
    }

    .particle-4 {
      top: 40%;
      left: 70%;
      animation: float-1 25s infinite ease-in-out;
    }

    .particle-5 {
      top: 80%;
      left: 20%;
      animation: float-2 15s infinite ease-in-out;
    }

    .particle-6 {
      top: 30%;
      left: 50%;
      animation: float-3 19s infinite ease-in-out;
    }

    .particle-7 {
      top: 70%;
      left: 90%;
      animation: float-1 21s infinite ease-in-out;
    }

    .particle-8 {
      top: 50%;
      left: 40%;
      animation: float-2 17s infinite ease-in-out;
    }

    @keyframes float-1 {
      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }
      33% {
        transform: translate(30px, -30px) scale(1.1);
      }
      66% {
        transform: translate(-20px, 20px) scale(0.9);
      }
    }

    @keyframes float-2 {
      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }
      33% {
        transform: translate(-30px, -20px) scale(1.2);
      }
      66% {
        transform: translate(20px, 30px) scale(0.8);
      }
    }

    @keyframes float-3 {
      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }
      33% {
        transform: translate(20px, 30px) scale(0.9);
      }
      66% {
        transform: translate(-30px, -10px) scale(1.1);
      }
    }

    /* Network line animations */
    .network-lines line {
      animation: pulse-line 3s infinite ease-in-out;
    }

    @keyframes pulse-line {
      0%,
      100% {
        opacity: 0.3;
      }
      50% {
        opacity: 0.8;
      }
    }

    /* Underline animation */
    .path-underline {
      stroke-dasharray: 300;
      stroke-dashoffset: 300;
      animation: draw-underline 2s ease-out forwards;
      animation-delay: 0.5s;
    }

    @keyframes draw-underline {
      to {
        stroke-dashoffset: 0;
      }
    }

    /* Wave animation */
    .wave-path {
      animation: wave-motion 20s linear infinite;
    }

    @keyframes wave-motion {
      0% {
        d: path(
          "M0 120V60C240 20 480 20 720 60C960 100 1200 100 1440 60V120H0Z"
        );
      }
      50% {
        d: path(
          "M0 120V60C240 100 480 100 720 60C960 20 1200 20 1440 60V120H0Z"
        );
      }
      100% {
        d: path(
          "M0 120V60C240 20 480 20 720 60C960 100 1200 100 1440 60V120H0Z"
        );
      }
    }
  </style>
</CarbonLayout>
