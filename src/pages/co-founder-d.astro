---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="Donna Cabrera - Co-Founder & Patient Advocacy Advisor | USRad"
>
  <AOSInit />

  <!-- Hero Section - Full Screen with Gradient Background -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-[#0a0e27] via-[#003087] to-black"
  >
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 opacity-30">
      <div
        class="absolute top-60 -right-40 w-96 h-96 bg-[#cc9933]/20 rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute bottom-20 -left-20 w-96 h-96 bg-[#003087]/30 rounded-full blur-3xl animate-float-delayed"
      >
      </div>
    </div>

    <!-- Heartbeat Animation Canvas -->
    <canvas id="heartbeat-canvas" class="absolute inset-0 opacity-10"></canvas>

    <div class="relative z-10 max-w-7xl mx-auto px-6 py-32">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Image Column -->
        <div class="relative" data-aos="fade-right">
          <div class="relative inline-block">
            <!-- Warm Glow Effect Behind Image -->
            <div
              class="absolute inset-0 bg-gradient-to-r from-[#cc9933] to-rose-400 opacity-25 blur-xl scale-110"
            >
            </div>

            <picture>
              <source
                srcset="/images/donna-website-sm-profile.webp"
                type="image/webp"
              />
              <img
                src="/images/donna-website-sm-profile.png"
                alt="Donna Cabrera, Co-Founder & Patient Advocacy Advisor"
                width="480"
                height="600"
                class="relative w-full max-w-md mx-auto rounded-2xl shadow-2xl border border-[#cc9933]/20"
                style="aspect-ratio: 4 / 5; object-fit: cover;"
                loading="eager"
                decoding="async"
              />
            </picture>

            <!-- Floating Badge -->
            <div
              class="absolute -bottom-6 -right-6 bg-gradient-to-r from-rose-500 to-rose-600 text-white px-6 py-3 rounded-full shadow-xl"
            >
              <span class="font-bold">Heart of Healthcare</span>
            </div>
          </div>
        </div>

        <!-- Bio Column -->
        <div class="space-y-8 text-white" data-aos="fade-left">
          <div>
            <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold mb-4">
              Donna<br />
              <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-rose-400"
              >
                Cabrera
              </span>
            </h1>
            <p class="text-2xl text-[#cc9933] font-light">
              Co-Founder & Patient Advocacy Advisor
            </p>
          </div>

          <p class="text-xl leading-relaxed text-gray-300">
            Donna Cabrera's work in medical imaging began in the early 1990s,
            redefining the patient experience from the ground up. As co-founder
            of our original imaging venture and architect of the groundbreaking
            'One Step Service' model, she continues to shape our patient-first
            vision as a trusted advisor at USRad.
          </p>

          <div class="flex flex-wrap gap-4">
            <a
              href="#legacy"
              class="group inline-flex items-center gap-3 bg-gradient-to-r from-rose-500 to-rose-600 text-white px-8 py-4 rounded-xl font-bold hover:shadow-2xl transition-all transform hover:scale-105"
            >
              <span>Explore Her Legacy</span>
              <svg
                class="w-5 h-5 group-hover:translate-y-1 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact Statement Section -->
  <section class="py-24 bg-gradient-to-b from-black to-[#0a0e27] text-white">
    <div class="max-w-4xl mx-auto px-6 text-center" data-aos="zoom-in">
      <div class="space-y-8">
        <div class="inline-block">
          <h2
            class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-[#cc9933] mb-4"
          >
            "One Step Service"
          </h2>
          <div
            class="h-1 bg-gradient-to-r from-rose-400 to-[#cc9933] rounded-full"
          >
          </div>
        </div>
        <p class="text-xl text-gray-400 max-w-3xl mx-auto leading-relaxed">
          The revolutionary model that transformed medical imaging by putting
          patients first— 72-hour scheduling, urgent case accommodation, and
          seamless communication that became the national benchmark for
          compassionate healthcare delivery.
        </p>
      </div>
    </div>
  </section>

  <!-- Legacy Section with Modern Cards -->
  <section
    id="legacy"
    class="py-32 bg-gradient-to-br from-gray-50 to-white px-6"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20" data-aos="fade-up">
        <h2 class="text-5xl md:text-6xl font-bold text-gray-900 mb-4">
          Her Legacy in
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-[#cc9933]"
          >
            Practice
          </span>
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Building healthcare systems where empathy and efficiency unite
        </p>
      </div>

      <!-- Story and Principles Grid -->
      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Story Column -->
        <div class="space-y-8" data-aos="fade-right">
          <div
            class="bg-white rounded-2xl p-10 shadow-xl border border-gray-100"
          >
            <p class="text-lg text-gray-700 leading-relaxed mb-6">
              Donna's early leadership helped define our culture of care. At
              AnciCare PPO, she launched "One Step Service"—a coordinated model
              delivering 72-hour scheduling, urgent case accommodation, and
              streamlined reporting across the entire referral chain. The system
              became a national benchmark in patient service design.
            </p>
            <p class="text-lg text-gray-700 leading-relaxed">
              Today, she guides USRad's service strategy with a singular goal:
              never lose the human connection in pursuit of scale. Her influence
              ensures that as our platform evolves, empathy remains its
              foundation.
            </p>
          </div>

          <!-- Quote Block -->
          <div
            class="relative bg-gradient-to-br from-rose-50 to-orange-50 rounded-2xl p-10 border border-rose-100"
          >
            <div
              class="absolute -top-4 -left-4 text-rose-200 text-6xl opacity-50"
            >
              "
            </div>
            <blockquote
              class="relative z-10 text-xl italic text-gray-700 font-light"
            >
              Her presence reminds us that even in a world of innovation, care
              is still personal — and always should be.
            </blockquote>
            <div
              class="absolute -bottom-4 -right-4 text-rose-200 text-6xl opacity-50 rotate-180"
            >
              "
            </div>
          </div>
        </div>

        <!-- Principles Cards -->
        <div class="grid gap-6" data-aos="fade-left">
          <!-- Clear Communication Card -->
          <div class="group relative">
            <div
              class="absolute inset-0 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl opacity-0 group-hover:opacity-100 blur-xl transition-all duration-500"
            >
            </div>
            <div
              class="relative bg-white rounded-xl p-8 shadow-lg border border-gray-100 group-hover:border-blue-200 transition-all duration-500 group-hover:-translate-y-1"
            >
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-lg flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2">
                    Clear Communication
                  </h3>
                  <p class="text-gray-600">
                    Ensuring patients understand procedures and next steps
                    without confusion or jargon.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Emotional Support Card -->
          <div class="group relative">
            <div
              class="absolute inset-0 bg-gradient-to-r from-rose-500 to-pink-500 rounded-xl opacity-0 group-hover:opacity-100 blur-xl transition-all duration-500"
            >
            </div>
            <div
              class="relative bg-white rounded-xl p-8 shadow-lg border border-gray-100 group-hover:border-rose-200 transition-all duration-500 group-hover:-translate-y-1"
            >
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-gradient-to-br from-rose-500 to-pink-500 rounded-lg flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2">
                    Emotional Support
                  </h3>
                  <p class="text-gray-600">
                    Addressing anxiety with timely, compassionate care at every
                    step.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Personalized Attention Card -->
          <div class="group relative">
            <div
              class="absolute inset-0 bg-gradient-to-r from-purple-500 to-indigo-500 rounded-xl opacity-0 group-hover:opacity-100 blur-xl transition-all duration-500"
            >
            </div>
            <div
              class="relative bg-white rounded-xl p-8 shadow-lg border border-gray-100 group-hover:border-purple-200 transition-all duration-500 group-hover:-translate-y-1"
            >
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-gradient-to-br from-purple-500 to-indigo-500 rounded-lg flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2">
                    Personalized Attention
                  </h3>
                  <p class="text-gray-600">
                    Treating every patient as an individual—not just an
                    appointment.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Results Delivery Card -->
          <div class="group relative">
            <div
              class="absolute inset-0 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-xl opacity-0 group-hover:opacity-100 blur-xl transition-all duration-500"
            >
            </div>
            <div
              class="relative bg-white rounded-xl p-8 shadow-lg border border-gray-100 group-hover:border-emerald-200 transition-all duration-500 group-hover:-translate-y-1"
            >
              <div class="flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-teal-500 rounded-lg flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-gray-900 mb-2">
                    Results Delivery
                  </h3>
                  <p class="text-gray-600">
                    Closing the loop with fast, accurate reports and clarity for
                    all.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact Metrics Section -->
  <section
    class="py-32 bg-gradient-to-br from-[#0a0e27] via-[#003087] to-black text-white px-6"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20" data-aos="fade-up">
        <h2 class="text-5xl md:text-6xl font-bold mb-4">
          A Legacy of
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-[#cc9933]"
          >
            Compassion
          </span>
        </h2>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
          Three decades of putting patients first, one caring interaction at a
          time
        </p>
      </div>

      <!-- Metrics Grid -->
      <div class="grid md:grid-cols-3 gap-8" data-aos="fade-up">
        <div class="text-center">
          <div class="inline-block">
            <p
              class="text-6xl md:text-7xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-[#cc9933]"
            >
              30+
            </p>
            <div
              class="h-1 bg-gradient-to-r from-rose-400 to-[#cc9933] rounded-full mt-2"
            >
            </div>
          </div>
          <p class="text-xl text-gray-300 mt-4">
            Years of Healthcare Innovation
          </p>
        </div>

        <div class="text-center">
          <div class="inline-block">
            <p
              class="text-6xl md:text-7xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-rose-400"
            >
              72hr
            </p>
            <div
              class="h-1 bg-gradient-to-r from-[#cc9933] to-rose-400 rounded-full mt-2"
            >
            </div>
          </div>
          <p class="text-xl text-gray-300 mt-4">Scheduling Standard Set</p>
        </div>

        <div class="text-center">
          <div class="inline-block">
            <p
              class="text-6xl md:text-7xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-[#cc9933]"
            >
              ∞
            </p>
            <div
              class="h-1 bg-gradient-to-r from-rose-400 to-[#cc9933] rounded-full mt-2"
            >
            </div>
          </div>
          <p class="text-xl text-gray-300 mt-4">Lives Touched with Care</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section
    class="py-24 bg-gradient-to-b from-black to-[#0a0e27] text-white text-center px-6"
  >
    <div class="max-w-4xl mx-auto" data-aos="zoom-in">
      <h2 class="text-4xl md:text-5xl font-bold mb-8">
        Experience Healthcare That Cares
      </h2>
      <p class="text-xl text-gray-400 mb-12">
        Discover how Donna's vision of compassionate care shapes every patient
        interaction at USRad
      </p>
      <div class="flex flex-wrap gap-6 justify-center">
        <a
          href="/contact-carbon"
          class="group inline-flex items-center gap-3 bg-gradient-to-r from-rose-500 to-rose-600 text-white px-10 py-5 rounded-xl font-bold text-lg hover:shadow-2xl transition-all transform hover:scale-105"
        >
          <span>Get in Touch</span>
          <svg
            class="w-6 h-6 group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Float animations */
    @keyframes float {
      0%,
      100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    @keyframes float-delayed {
      0%,
      100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-15px);
      }
    }

    .animate-float {
      animation: float 6s ease-in-out infinite;
    }

    .animate-float-delayed {
      animation: float-delayed 6s ease-in-out infinite;
      animation-delay: 3s;
    }
  </style>

  <script>
    // Heartbeat Animation Canvas
    const canvas = document.getElementById("heartbeat-canvas");
    if (canvas) {
      const ctx = canvas.getContext("2d");
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;

      let progress = 0;
      const heartbeatPattern = [0, 0.2, 0, 0.8, 0.3, 1, 0.2, 0, 0];

      function drawHeartbeat() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.strokeStyle = "rgba(244, 63, 94, 0.3)"; // Rose color
        ctx.lineWidth = 2;
        ctx.beginPath();

        const segmentWidth = canvas.width / (heartbeatPattern.length - 1);
        const centerY = canvas.height / 2;
        const amplitude = 50;

        for (let i = 0; i < heartbeatPattern.length; i++) {
          const x = i * segmentWidth;
          const y = centerY - heartbeatPattern[i] * amplitude;

          if (i === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
        }

        ctx.stroke();

        // Animate the line
        progress += 0.01;
        if (progress > 1) progress = 0;

        requestAnimationFrame(drawHeartbeat);
      }

      drawHeartbeat();
    }

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute("href"));
        if (target) {
          target.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }
      });
    });

    // Window resize handler
    window.addEventListener("resize", () => {
      if (canvas) {
        canvas.width = canvas.offsetWidth;
        canvas.height = canvas.offsetHeight;
      }
    });
  </script>
</CarbonLayout>
