---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout title="Michael Cabrera - Founder & CEO | USRad">
  <AOSInit />

  <!-- Hero Section - Full Screen with Gradient Background -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-[#0a0e27] via-[#003087] to-[#001a4d]"
  >
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 opacity-30">
      <div
        class="absolute top-40 -left-20 w-96 h-96 bg-[#cc9933]/20 rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute bottom-40 -right-20 w-96 h-96 bg-[#003087]/30 rounded-full blur-3xl animate-float-delayed"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 py-32">
      <div class="grid lg:grid-cols-2 gap-20 items-center">
        <!-- Image Column -->
        <div
          class="relative lg:justify-self-start justify-self-center lg:-translate-y-8"
          data-aos="fade-right"
        >
          <div class="relative inline-block">
            <!-- Glow Effect Behind Image -->
            <div
              class="absolute inset-0 bg-gradient-to-r from-[#cc9933] to-[#FFA500] opacity-25 blur-3xl scale-110"
            >
            </div>

            <picture>
              <source
                srcset="/images/mac-website-sm-profile.webp"
                type="image/webp"
              />
              <img
                src="/images/mac-website-sm-profile.png"
                alt="Michael Cabrera"
                width="480"
                height="600"
                class="relative w-[380px] lg:w-[440px] max-w-full rounded-2xl lg:mx-0 mx-auto"
                style="aspect-ratio: 4 / 5; object-fit: cover; object-position: center top; box-shadow: 0 32px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.08), inset 0 1px 0 rgba(255,255,255,0.12);"
                loading="eager"
                decoding="async"
              />
            </picture>
          </div>
        </div>

        <!-- Bio Column -->
        <div class="space-y-6 text-white relative" data-aos="fade-left">
          <!-- Background depth gradient behind text (section 3.6) -->
          <div class="absolute -inset-8 bg-radial-glow pointer-events-none">
          </div>

          <div class="relative">
            <h1
              class="text-6xl md:text-7xl lg:text-8xl font-bold mb-2 tracking-tight leading-[0.95]"
            >
              Michael<br />
              <span
                class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-[#FFA500]"
              >
                Cabrera
              </span>
            </h1>
            <p class="text-2xl text-[#cc9933] font-light mt-3 tracking-wide">
              Founder & CEO
            </p>
            <div
              class="w-12 h-[2px] bg-gradient-to-r from-[#cc9933] to-transparent mt-4"
            >
            </div>
          </div>

          <p class="text-xl leading-relaxed text-gray-300 relative">
            He previously led AnciCare PPO, which was acquired by CorVel
            Corporation (NASDAQ: CRVL) in May 2002. Now focused on expanding
            access to affordable, high-quality imaging through systems built on
            empathy, simplicity, and trust.
          </p>

          <div class="flex flex-wrap gap-4 relative">
            <a
              href="https://www.linkedin.com/in/usradfl/"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-3 bg-gradient-to-r from-[#cc9933] to-[#FFA500] text-white px-8 py-4 rounded-xl font-bold hover:shadow-2xl transition-all transform hover:scale-105"
            >
              <span>Connect on LinkedIn</span>
              <svg
                class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div><!-- end grid -->
    </div>
  </section>
  <!-- Contained 2026-08-17: a full-width section whose only content was one animated figure and its caption. The figure was a people-count barred under §4b/§4c; the caption relabelled it and asserted clinical outcomes. THE SECTION WAS THE FIGURE — nothing survives its removal, so the section went entire. Removed with it: the count-up script, its IntersectionObserver and the #counter CSS rule; observer.observe() on a null element throws and would have broken every script after it. The value was held in a data-target attribute and written to the DOM at runtime, so the built HTML rendered "0" and no sweep could see it — #54, tenth mode. No numerical substitute made. See TRACKER #78. -->

  <!-- Values Section - Modern Cards -->
  <section class="py-32 bg-gradient-to-br from-gray-50 to-white px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20" data-aos="fade-up">
        <h2 class="text-5xl md:text-6xl font-bold text-gray-900 mb-4">
          Driven by
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#003087] to-[#0052cc]"
          >
            Purpose
          </span>
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Building healthcare systems that put humanity first
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Mission Card -->
        <div class="group relative" data-aos="fade-up" data-aos-delay="100">
          <div
            class="absolute inset-0 bg-gradient-to-r from-[#003087] to-[#0052cc] rounded-2xl opacity-0 group-hover:opacity-100 blur-xl transition-all duration-500"
          >
          </div>
          <div
            class="relative bg-white rounded-2xl p-10 shadow-xl border border-gray-100 group-hover:border-[#003087]/20 transition-all duration-500 group-hover:-translate-y-2"
          >
            <div
              class="w-16 h-16 bg-gradient-to-br from-[#003087] to-[#0052cc] rounded-xl flex items-center justify-center mb-6"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Mission</h3>
            <p class="text-gray-600 leading-relaxed">
              Expand access to affordable, high-quality imaging—with
              transparency, empathy, and innovation at every step.
            </p>
          </div>
        </div>

        <!-- Vision Card -->
        <div class="group relative" data-aos="fade-up" data-aos-delay="200">
          <div
            class="absolute inset-0 bg-gradient-to-r from-[#cc9933] to-[#FFA500] rounded-2xl opacity-0 group-hover:opacity-100 blur-xl transition-all duration-500"
          >
          </div>
          <div
            class="relative bg-white rounded-2xl p-10 shadow-xl border border-gray-100 group-hover:border-[#cc9933]/20 transition-all duration-500 group-hover:-translate-y-2"
          >
            <div
              class="w-16 h-16 bg-gradient-to-br from-[#cc9933] to-[#FFA500] rounded-xl flex items-center justify-center mb-6"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Vision</h3>
            <p class="text-gray-600 leading-relaxed">
              A healthcare system where no one delays care due to confusion or
              cost, and where imaging centers thrive through shared values.
            </p>
          </div>
        </div>

        <!-- Promise Card -->
        <div class="group relative" data-aos="fade-up" data-aos-delay="300">
          <div
            class="absolute inset-0 bg-gradient-to-r from-green-500 to-emerald-500 rounded-2xl opacity-0 group-hover:opacity-100 blur-xl transition-all duration-500"
          >
          </div>
          <div
            class="relative bg-white rounded-2xl p-10 shadow-xl border border-gray-100 group-hover:border-green-500/20 transition-all duration-500 group-hover:-translate-y-2"
          >
            <div
              class="w-16 h-16 bg-gradient-to-br from-green-500 to-emerald-500 rounded-xl flex items-center justify-center mb-6"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Promise</h3>
            <p class="text-gray-600 leading-relaxed">
              Built to treat every patient like family—with dignity, trust, and
              clear, honest pricing.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recognition Section -->
  <section
    class="py-32 bg-gradient-to-br from-[#0a0e27] via-[#003087] to-black text-white px-6"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20" data-aos="fade-up">
        <h2 class="text-5xl md:text-6xl font-bold mb-4">
          Experience That Informs
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-[#FFA500]"
          >
            the Work
          </span>
        </h2>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
          More than three decades in medical imaging.
        </p>
      </div>

      <div class="max-w-3xl mx-auto">
        <!-- Career Highlights -->
        <div
          class="bg-white/5 backdrop-blur-md rounded-2xl p-10 border border-white/10"
          data-aos="fade-up"
        >
          <h3
            class="text-3xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-[#FFA500]"
          >
            Career Highlights
          </h3>
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-2 h-2 bg-[#cc9933] rounded-full mt-2">
              </div>
              <p class="text-lg text-gray-300">
                AnciCare PPO was founded in 1994 and acquired by CorVel
                Corporation (NASDAQ: CRVL) in May 2002.
              </p>
            </li>
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-2 h-2 bg-[#cc9933] rounded-full mt-2">
              </div>
              <p class="text-lg text-gray-300">
                Michael Cabrera participated in the Birthing of Giants executive
                program, a joint program of MIT, the Young Entrepreneurs'
                Organization and Inc. magazine, Class of 2001.
              </p>
            </li>
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-2 h-2 bg-[#cc9933] rounded-full mt-2">
              </div>
              <p class="text-lg text-gray-300">
                AnciCare PPO ranked #210 on the 1999 Inc. 500.
              </p>
            </li>
          </ul>
        </div>
      </div>

      <!-- Quote Section -->
      <div class="mt-20 max-w-4xl mx-auto text-center" data-aos="fade-up">
        <blockquote class="relative">
          <div class="absolute -top-8 -left-8 text-[#cc9933]/20 text-8xl">
            "
          </div>
          <p
            class="text-2xl md:text-3xl font-light italic leading-relaxed text-gray-300 relative z-10"
          >
            Follow the value. It will tell you how the market really works.
          </p>
          <div
            class="absolute -bottom-8 -right-8 text-[#cc9933]/20 text-8xl rotate-180"
          >
            "
          </div>
        </blockquote>
        <p class="mt-8 text-[#cc9933] font-medium">— Michael Cabrera</p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section
    class="py-24 bg-gradient-to-b from-black to-[#0a0e27] text-white text-center px-6"
  >
    <div class="max-w-4xl mx-auto" data-aos="zoom-in">
      <h2 class="text-4xl md:text-5xl font-bold mb-8">
        Let's Build the Future of Healthcare Together
      </h2>
      <p class="text-xl text-gray-400 mb-12">
        Connect with Michael to discuss partnerships, innovation, or the future
        of medical imaging
      </p>
      <div class="flex flex-wrap gap-6 justify-center">
        <a
          href="https://www.linkedin.com/in/usradfl/"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-3 bg-gradient-to-r from-[#cc9933] to-[#FFA500] text-white px-10 py-5 rounded-xl font-bold text-lg hover:shadow-2xl transition-all transform hover:scale-105"
        >
          <span>Connect on LinkedIn</span>
          <svg
            class="w-6 h-6 group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</CarbonLayout>

<style>
  /* Float animations */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes float-delayed {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float-delayed 6s ease-in-out infinite;
    animation-delay: 3s;
  }

  /* Background depth gradient behind bio column (section 3.6) */
  .bg-radial-glow {
    background: radial-gradient(
      ellipse at 30% 50%,
      rgba(0, 48, 135, 0.35) 0%,
      transparent 70%
    );
    border-radius: 2rem;
    pointer-events: none;
  }
</style>

<script>
  // Subtle parallax on portrait (desktop only) - section 3.7
  function setupParallax() {
    if (window.innerWidth < 1024) return;
    const portrait = document.querySelector('[data-aos="fade-right"]');
    if (!portrait) return;
    window.addEventListener(
      "scroll",
      () => {
        const scrollY = window.scrollY;
        const offset = scrollY * 0.08;
        portrait.style.transform = `translateY(calc(-2rem - ${offset}px))`;
      },
      { passive: true },
    );
  }

  document.addEventListener("DOMContentLoaded", () => {
    setupParallax();
  });
</script>
