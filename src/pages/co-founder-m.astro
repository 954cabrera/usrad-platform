---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout title="Michael Cabrera - Founder & CEO | USRad">
  <AOSInit />

  <!-- Hero Section - Full Screen with Gradient Background -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-[#0a0e27] via-[#003087] to-[#001a4d]"
  >
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 opacity-30">
      <div
        class="absolute top-40 -left-20 w-96 h-96 bg-[#cc9933]/20 rounded-full blur-3xl animate-float"
      >
      </div>
      <div
        class="absolute bottom-40 -right-20 w-96 h-96 bg-[#003087]/30 rounded-full blur-3xl animate-float-delayed"
      >
      </div>
    </div>

    <!-- Particle System -->

    <div class="relative z-10 max-w-6xl mx-auto px-6 py-32">
      <div class="grid lg:grid-cols-2 gap-20 items-center">

      <!-- Image Column -->
      <div
        class="relative lg:justify-self-start justify-self-center lg:-translate-y-8"
        data-aos="fade-right"
      >
        <div class="relative inline-block">
          <!-- Glow Effect Behind Image -->
          <div
            class="absolute inset-0 bg-gradient-to-r from-[#cc9933] to-[#FFA500] opacity-25 blur-3xl scale-110"
          >
          </div>

          <picture>
            <source
              srcset="/images/mac-website-sm-profile.webp"
              type="image/webp"
            />
            <img
              src="/images/mac-website-sm-profile.png"
              alt="Michael Cabrera"
              width="480"
              height="600"
              class="relative w-[380px] lg:w-[440px] max-w-full rounded-2xl lg:mx-0 mx-auto"
              style="aspect-ratio: 4 / 5; object-fit: cover; object-position: center top; box-shadow: 0 32px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.08), inset 0 1px 0 rgba(255,255,255,0.12);"
              loading="eager"
              decoding="async"
            />
          </picture>

          <!-- Floating Badge -->
          <div
            class="absolute -bottom-6 -right-6 bg-gradient-to-r from-[#003087] to-[#0052cc] text-white px-6 py-3 rounded-full shadow-xl"
          >
            <span class="font-bold">MIT Birthing of Giants</span>
          </div>
        </div>
      </div>

      <!-- Bio Column -->
      <div class="space-y-6 text-white relative" data-aos="fade-left">
        <!-- Background depth gradient behind text (section 3.6) -->
        <div class="absolute -inset-8 bg-radial-glow pointer-events-none"></div>

        <div class="relative">
          <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold mb-2 tracking-tight leading-[0.95]">
            Michael<br />
            <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-[#FFA500]"
            >
              Cabrera
            </span>
          </h1>
          <p class="text-2xl text-[#cc9933] font-light mt-3 tracking-wide">
            Co-Founder & CEO
          </p>
          <div class="w-12 h-[2px] bg-gradient-to-r from-[#cc9933] to-transparent mt-4"></div>
        </div>

        <p class="text-xl leading-relaxed text-gray-300 relative">
          Healthcare entrepreneur who previously led a national imaging network
          to a successful exit with a publicly traded company. Selected for
          MIT's prestigious "Birthing of Giants" program. Now focused on
          expanding access to affordable, high-quality imaging through systems
          built on empathy, simplicity, and trust.
        </p>

        <div class="flex flex-wrap gap-4 relative">
          <a
            href="https://www.linkedin.com/in/usradfl/"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 bg-gradient-to-r from-[#cc9933] to-[#FFA500] text-white px-8 py-4 rounded-xl font-bold hover:shadow-2xl transition-all transform hover:scale-105"
          >
            <span>Connect on LinkedIn</span>
            <svg
              class="w-5 h-5 group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
          </a>
        </div>

        <a
          href="/press-kit"
          class="group inline-flex items-center gap-3 border-2 border-white/30 text-white px-8 py-4 rounded-xl font-bold hover:bg-white/10 transition-all relative"
        >
          <span>View Press Kit</span>

          <svg
            class="w-5 h-5 group-hover:translate-y-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"
            ></path>
          </svg>
        </a>
      </div>
      </div><!-- end grid -->
    </div>
  </section>
  <section class="py-24 bg-gradient-to-b from-black to-[#0a0e27] text-white">
    <div class="max-w-4xl mx-auto px-6 text-center" data-aos="zoom-in">
      <div class="inline-block">
        <p
          class="text-7xl md:text-8xl lg:text-9xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-[#FFA500]"
