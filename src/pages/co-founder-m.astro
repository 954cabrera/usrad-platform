          <span id="counter" data-target="168000">0</span>+
        </p>
        <div
          class="h-1 bg-gradient-to-r from-[#cc9933] to-[#FFA500] rounded-full mt-4"
        >
        </div>
      </div>
      <p class="text-xl text-gray-400 mt-8 max-w-2xl mx-auto">
        Imaging procedures delivered under Michael's leadership—each one a step
        toward earlier diagnoses and better outcomes.
      </p>
    </div>
  </section>

  <!-- Values Section - Modern Cards -->
  <section class="py-32 bg-gradient-to-br from-gray-50 to-white px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20" data-aos="fade-up">
        <h2 class="text-5xl md:text-6xl font-bold text-gray-900 mb-4">
          Driven by
          <span
