---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";
import ContactHero from "../components/ContactHero.astro";

export const prerender = true;
---

<CarbonLayout title="Contact USRad - Get Answers in Minutes">
  <ContactHero />

  <!-- Track Record Section -->
  <section
    class="bg-gray-50 py-20 px-4 sm:px-6 border-y border-gray-100"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-4xl sm:text-5xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
        >
          Why trust our support team?
        </h2>
        <p
          class="text-xl text-gray-600 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Because we've done this before. Successfully. At scale.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
        <div data-aos="fade-up" data-aos-delay="100">
          <div class="text-3xl md:text-4xl font-bold text-[#003087] mb-2">
            30 Years
          </div>
          <div class="text-base text-gray-600">Healthcare experience</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="200">
          <div class="text-3xl md:text-4xl font-bold text-[#003087] mb-2">
            &lt;2hrs
          </div>
          <div class="text-base text-gray-600">Response guarantee</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="300">
          <div class="text-3xl md:text-4xl font-bold text-[#003087] mb-2">
            99.8%
          </div>
          <div class="text-base text-gray-600">Issue resolution</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="400">
          <div class="text-3xl md:text-4xl font-bold text-[#003087] mb-2">
            4.9★
          </div>
          <div class="text-base text-gray-600">Customer rating</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Methods Section -->
  <section
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-white via-blue-50/20 to-white"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20">
        <h2
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
        >
          How can we help you today?
        </h2>
        <p
          class="text-2xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Choose your preferred way to connect
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-12 max-w-6xl mx-auto">
        <!-- Phone Support -->
        <div class="text-center group" data-aos="fade-up" data-aos-delay="200">
          <div class="relative h-56 flex items-center justify-center mb-8">
            <div
              class="w-40 h-40 bg-[#003087] rounded-2xl flex items-center justify-center group-hover:scale-105 transition-transform duration-300"
            >
              <!-- Flaticon medical phone icon -->
              <img
                src="/images/icons/phone-medical.svg"
                alt="Medical phone support"
                class="w-16 h-16 contact-icon"
              />
            </div>
          </div>
          <h3 class="text-2xl font-semibold mb-4">Call us directly</h3>
          <p class="text-lg text-gray-600 mb-6">
            Speak with medical imaging specialists who understand your needs.
          </p>
          <div class="bg-gray-50 rounded-xl p-4 mb-6">
            <p class="text-2xl font-bold text-[#003087] mb-2">(800) USRad-24</p>
            <p class="text-sm text-gray-600">Available 8AM-8PM EST</p>
          </div>
          <a
            href="tel:8005558723"
            class="inline-block bg-[#003087] text-white px-8 py-3 rounded-lg font-medium hover:bg-[#002266] transition"
          >
            Call now →
          </a>
        </div>

        <!-- Email Support -->
        <div class="text-center group" data-aos="fade-up" data-aos-delay="300">
          <div class="relative h-56 flex items-center justify-center mb-8">
            <div
              class="w-40 h-40 bg-[#cc9933] rounded-2xl flex items-center justify-center group-hover:scale-105 transition-transform duration-300"
            >
              <!-- Flaticon medical email icon -->
              <img
                src="/images/icons/email.svg"
                alt="Medical email support"
                class="w-16 h-16 contact-icon"
              />
            </div>
          </div>
          <h3 class="text-2xl font-semibold mb-4">Email support</h3>
          <p class="text-lg text-gray-600 mb-6">
            Detailed responses with documentation and resources you can save.
          </p>
          <div class="bg-gray-50 rounded-xl p-4 mb-6">
            <p class="text-lg font-semibold text-[#003087] mb-2">
              support@usrad.com
            </p>
            <p class="text-sm text-gray-600">&lt;2 hour response guarantee</p>
          </div>
          <a
            href="mailto:support@usrad.com"
            class="inline-block bg-[#cc9933] text-[#003087] px-8 py-3 rounded-lg font-medium hover:bg-yellow-400 transition"
          >
            Send email →
          </a>
        </div>

        <!-- Live Chat -->
        <div class="text-center group" data-aos="fade-up" data-aos-delay="400">
          <div class="relative h-56 flex items-center justify-center mb-8">
            <div
              class="w-40 h-40 bg-gradient-to-r from-[#003087] to-[#002266] rounded-2xl flex items-center justify-center group-hover:scale-105 transition-transform duration-300"
            >
              <!-- Flaticon medical professional/headset icon -->
              <img
                src="/images/icons/medical-professional.svg"
                alt="Medical chat support"
                class="w-16 h-16 contact-icon"
              />
            </div>
          </div>
          <h3 class="text-2xl font-semibold mb-4">Live chat</h3>
          <p class="text-lg text-gray-600 mb-6">
            Quick answers without leaving the page. Perfect for simple
            questions.
          </p>
          <div class="bg-gray-50 rounded-xl p-4 mb-6">
            <p class="text-lg font-semibold text-[#003087] mb-2">
              Available 9AM-6PM EST
            </p>
            <p class="text-sm text-gray-600">2-3 minute response time</p>
          </div>
          <button
            onclick="startChat()"
            class="inline-block bg-[#003087] text-white px-8 py-3 rounded-lg font-medium hover:bg-[#002266] transition"
          >
            Start chat →
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section
    id="contact-form"
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-50 via-white to-gray-50"
    data-aos="fade-up"
  >
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
        >
          Send us a message
        </h2>
        <p
          class="text-2xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          We'll respond within 2 hours during business hours
        </p>
      </div>

      <div
        class="bg-white rounded-2xl shadow-xl p-8 md:p-12"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <form id="contactForm" class="space-y-6">
          <!-- Name Fields -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                class="block text-sm font-semibold text-gray-700 mb-2"
                for="firstName">First Name *</label
              >
              <input
                type="text"
                id="firstName"
                name="firstName"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
                placeholder="Your first name"
              />
              <div class="error-message hidden text-red-600 text-sm mt-1"></div>
            </div>
            <div>
              <label
                class="block text-sm font-semibold text-gray-700 mb-2"
                for="lastName">Last Name *</label
              >
              <input
                type="text"
                id="lastName"
                name="lastName"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
                placeholder="Your last name"
              />
              <div class="error-message hidden text-red-600 text-sm mt-1"></div>
            </div>
          </div>

          <!-- Contact Fields -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                class="block text-sm font-semibold text-gray-700 mb-2"
                for="email">Email *</label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
                placeholder="your.email@example.com"
              />
              <div class="error-message hidden text-red-600 text-sm mt-1"></div>
            </div>
            <div>
              <label
                class="block text-sm font-semibold text-gray-700 mb-2"
                for="phone">Phone</label
              >
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
                placeholder="(555) 123-4567"
              />
              <div class="error-message hidden text-red-600 text-sm mt-1"></div>
            </div>
          </div>

          <!-- Topic Selection -->
          <div>
            <label
              class="block text-sm font-semibold text-gray-700 mb-2"
              for="topic">How can we help? *</label
            >
            <select
              id="topic"
              name="topic"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
            >
              <option value="">Select a topic</option>
              <option value="scheduling">Schedule an appointment</option>
              <option value="pricing">Questions about pricing</option>
              <option value="results">Get my results</option>
              <option value="insurance">Insurance questions</option>
              <option value="locations">Find a location near me</option>
              <option value="network">Join our provider network</option>
              <option value="other">Other</option>
            </select>
            <div class="error-message hidden text-red-600 text-sm mt-1"></div>
          </div>

          <!-- Message -->
          <div>
            <label
              class="block text-sm font-semibold text-gray-700 mb-2"
              for="message">Your message *</label
            >
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Tell us how we can help you..."
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition resize-none"
            ></textarea>
            <div class="error-message hidden text-red-600 text-sm mt-1"></div>
          </div>

          <!-- Submit Button -->
          <div class="text-center pt-4">
            <button
              type="submit"
              class="bg-[#003087] hover:bg-[#002266] text-white px-12 py-4 rounded-xl font-semibold text-lg transition-all transform hover:scale-105 shadow-lg disabled:opacity-50 disabled:cursor-not-allowed"
              id="submitBtn"
            >
              <span class="submit-text">Send message →</span>
              <span class="loading-text hidden">Sending...</span>
            </button>
            <p class="text-sm text-gray-500 mt-3">
              We'll respond within 2 hours during business hours
            </p>
          </div>

          <!-- Success Message -->
          <div
            id="successMessage"
            class="hidden bg-green-50 border border-green-200 rounded-lg p-4 text-green-700 text-center"
          >
            <svg
              class="w-6 h-6 mx-auto mb-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            <p class="font-semibold">Message sent successfully!</p>
            <p class="text-sm">We'll get back to you within 2 hours.</p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Why Choose USRad Support -->
  <section class="py-24 px-4 sm:px-6 bg-white" data-aos="fade-up">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-4xl sm:text-5xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
        >
          Why our support is different
        </h2>
        <p
          class="text-xl text-gray-600 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Healthcare experience that shows in every interaction
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-12">
        <!-- Medical Expertise -->
        <div class="text-center group" data-aos="zoom-in" data-aos-delay="100">
          <div
            class="w-24 h-24 mx-auto mb-6 bg-[#003087] rounded-2xl flex items-center justify-center group-hover:scale-105 group-hover:shadow-xl transition-all duration-300"
          >
            <!-- Enhanced Flaticon medical expertise icon -->
            <img
              src="/images/icons/brain.svg"
              alt="Medical expertise with brain analysis"
              class="w-14 h-14 medical-icon-white"
            />
          </div>
          <h3 class="text-2xl font-semibold mb-4 text-gray-900">
            Medical expertise
          </h3>
          <p class="text-lg text-gray-600 leading-relaxed">
            Our team understands imaging procedures, facility networks, and
            healthcare navigation.
          </p>
        </div>

        <!-- Complete Transparency -->
        <div class="text-center group" data-aos="zoom-in" data-aos-delay="200">
          <div
            class="w-24 h-24 mx-auto mb-6 bg-[#cc9933] rounded-2xl flex items-center justify-center group-hover:scale-105 group-hover:shadow-xl transition-all duration-300"
          >
            <!-- Enhanced Flaticon transparency icon -->
            <img
              src="/images/icons/evidence.svg"
              alt="Medical document transparency and clarity"
              class="w-14 h-14 medical-icon-white"
            />
          </div>
          <h3 class="text-2xl font-semibold mb-4 text-gray-900">
            Complete transparency
          </h3>
          <p class="text-lg text-gray-600 leading-relaxed">
            Clear pricing, honest timelines, and straightforward answers. No
            healthcare jargon.
          </p>
        </div>

        <!-- Genuine Care -->
        <div class="text-center group" data-aos="zoom-in" data-aos-delay="300">
          <div
            class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-green-500 to-green-600 rounded-2xl flex items-center justify-center group-hover:scale-105 group-hover:shadow-xl transition-all duration-300"
          >
            <!-- Enhanced Flaticon genuine care icon -->
            <img
              src="/images/icons/handshake.svg"
              alt="Caring partnership and genuine healthcare support"
              class="w-14 h-14 medical-icon-white"
            />
          </div>
          <h3 class="text-2xl font-semibold mb-4 text-gray-900">
            Genuine care
          </h3>
          <p class="text-lg text-gray-600 leading-relaxed">
            We understand healthcare can be stressful. Our team is here to make
            it easier.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Enhanced CSS for medical icons */
    .medical-icon-white {
      filter: brightness(0) saturate(100%) invert(100%);
      transition:
        filter 0.3s ease,
        transform 0.3s ease;
    }

    .medical-icon-white:hover {
      filter: brightness(0) saturate(100%) invert(100%)
        drop-shadow(0 2px 8px rgba(255, 255, 255, 0.4));
      transform: scale(1.05);
    }

    /* Enhanced hover effects for icon containers */
    .group:hover .medical-icon-white {
      transform: scale(1.1);
    }

    /* Smooth transitions for all elements */
    .group {
      transition: transform 0.3s ease;
    }

    .group:hover {
      transform: translateY(-4px);
    }
  </style>

  <!-- Quick Help Section -->
  <section
    class="py-20 px-4 sm:px-6 bg-[#003087] text-white"
    data-aos="fade-up"
  >
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Need quick answers?</h2>
        <p class="text-xl opacity-90">Common questions with instant answers</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- How much does it cost? -->
        <a
          href="/pricing"
          class="group bg-white/10 hover:bg-white/20 p-6 rounded-xl transition-all duration-300 backdrop-blur-sm border border-white/20 hover:scale-105 hover:shadow-xl"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div class="flex items-center gap-4 mb-3">
            <div
              class="w-14 h-14 bg-[#cc9933] rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <!-- Enhanced Flaticon medical pricing icon -->
              <img
                src="/images/icons/medical-invoice.svg"
                alt="Medical pricing and cost transparency"
                class="w-8 h-8 quick-help-icon"
              />
            </div>
            <h3
              class="font-semibold text-lg group-hover:text-[#cc9933] transition-colors"
            >
              How much does it cost?
            </h3>
          </div>
          <p class="text-white/80 text-sm mb-4 leading-relaxed">
            See transparent pricing starting at $260
          </p>
          <div
            class="text-[#cc9933] font-medium group-hover:translate-x-2 transition-transform duration-300 flex items-center gap-2"
          >
            View pricing
            <svg
              class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>

        <!-- How fast can I get scanned? -->
        <a
          href="/how-it-works"
          class="group bg-white/10 hover:bg-white/20 p-6 rounded-xl transition-all duration-300 backdrop-blur-sm border border-white/20 hover:scale-105 hover:shadow-xl"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div class="flex items-center gap-4 mb-3">
            <div
              class="w-14 h-14 bg-[#cc9933] rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <!-- Enhanced Flaticon medical scheduling icon -->
              <img
                src="/images/icons/schedule.svg"
                alt="Fast medical appointment scheduling"
                class="w-8 h-8 quick-help-icon"
              />
            </div>
            <h3
              class="font-semibold text-lg group-hover:text-[#cc9933] transition-colors"
            >
              How fast can I get scanned?
            </h3>
          </div>
          <p class="text-white/80 text-sm mb-4 leading-relaxed">
            Most appointments within 48 - 72 hours
          </p>
          <div
            class="text-[#cc9933] font-medium group-hover:translate-x-2 transition-transform duration-300 flex items-center gap-2"
          >
            Learn more
            <svg
              class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>

        <!-- When will I get results? -->
        <a
          href="/how-it-works#results"
          class="group bg-white/10 hover:bg-white/20 p-6 rounded-xl transition-all duration-300 backdrop-blur-sm border border-white/20 hover:scale-105 hover:shadow-xl"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div class="flex items-center gap-4 mb-3">
            <div
              class="w-14 h-14 bg-[#cc9933] rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
            >
              <!-- Enhanced Flaticon medical results icon -->
              <img
                src="/images/icons/paper-clip.svg"
                alt="Medical results and report delivery"
                class="w-8 h-8 quick-help-icon"
              />
            </div>
            <h3
              class="font-semibold text-lg group-hover:text-[#cc9933] transition-colors"
            >
              When will I get results?
            </h3>
          </div>
          <p class="text-white/80 text-sm mb-4 leading-relaxed">
            Board-certified radiologists review in 24-48 hours
          </p>
          <div
            class="text-[#cc9933] font-medium group-hover:translate-x-2 transition-transform duration-300 flex items-center gap-2"
          >
            See process
            <svg
              class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Enhanced CSS for quick help medical icons */
    .quick-help-icon {
      filter: brightness(0) saturate(100%) invert(100%);
      transition:
        filter 0.3s ease,
        transform 0.3s ease;
    }

    .quick-help-icon:hover {
      filter: brightness(0) saturate(100%) invert(100%)
        drop-shadow(0 2px 8px rgba(255, 255, 255, 0.4));
      transform: scale(1.1);
    }

    /* Enhanced hover effects for entire cards */
    .group:hover .quick-help-icon {
      transform: scale(1.2);
    }

    /* Smooth transitions for all interactive elements */
    .group:hover h3 {
      color: #cc9933;
    }

    /* Enhanced arrow animations */
    .group:hover svg {
      transform: translateX(4px);
    }
  </style>

  <!-- Provider CTA -->
  <section
    class="py-20 px-4 sm:px-6 bg-gradient-to-r from-[#cc9933] to-yellow-400"
    data-aos="fade-up"
  >
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-[#003087] mb-4">
        Medical imaging provider?
      </h2>
      <p class="text-xl text-[#003087]/80 mb-8 max-w-2xl mx-auto">
        Join our network and fill your empty time slots with methods that
        delivered over 168,000 appointments
      </p>
      <a
        href="/providers"
        class="inline-block bg-[#003087] hover:bg-[#002266] text-white px-10 py-4 rounded-xl font-semibold text-lg transition-all transform hover:scale-105 shadow-lg"
      >
        Join our network →
      </a>
    </div>
  </section>

  <style>
    /* CSS Filters for Flaticon SVGs to match USRad brand colors */
    .filter-white {
      filter: brightness(0) saturate(100%) invert(100%);
    }

    .filter-medical-blue {
      filter: brightness(0) saturate(100%) invert(13%) sepia(94%)
        saturate(4107%) hue-rotate(216deg) brightness(94%) contrast(101%);
    }

    .filter-green {
      filter: brightness(0) saturate(100%) invert(64%) sepia(78%)
        saturate(1933%) hue-rotate(85deg) brightness(117%) contrast(119%);
    }

    .filter-blue {
      filter: brightness(0) saturate(100%) invert(48%) sepia(96%)
        saturate(1206%) hue-rotate(200deg) brightness(97%) contrast(94%);
    }

    .filter-gold {
      filter: brightness(0) saturate(100%) invert(79%) sepia(50%)
        saturate(1500%) hue-rotate(359deg) brightness(1.1) contrast(0.9);
    }

    /* Ensure icons are visible on colored backgrounds */
    .contact-icon {
      filter: brightness(0) saturate(100%) invert(100%);
      transition: filter 0.3s ease;
    }

    .contact-icon:hover {
      filter: brightness(0) saturate(100%) invert(100%)
        drop-shadow(0 2px 4px rgba(255, 255, 255, 0.3));
    }

    /* Smooth animations */
    @keyframes float {
      0%,
      100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    .animate-float {
      animation: float 3s ease-in-out infinite;
    }
  </style>

  <script>
    // Form validation and submission
    const contactForm = document.getElementById("contactForm");
    const submitBtn = document.getElementById("submitBtn");
    const successMessage = document.getElementById("successMessage");

    // Real-time validation
    function validateField(field) {
      const errorDiv = field.parentNode.querySelector(".error-message");
      let isValid = true;
      let message = "";

      // Remove previous error styling
      field.classList.remove("border-red-500");
      errorDiv.classList.add("hidden");

      // Check if required field is empty
      if (field.hasAttribute("required") && !field.value.trim()) {
        isValid = false;
        message = "This field is required";
      }

      // Email validation
      if (field.type === "email" && field.value) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(field.value)) {
          isValid = false;
          message = "Please enter a valid email address";
        }
      }

      // Phone validation (optional but if provided, should be valid)
      if (field.type === "tel" && field.value) {
        const phoneRegex = /^[\+]?[1-9][\d]{0,15}$/;
        if (!phoneRegex.test(field.value.replace(/[\s\-\(\)]/g, ""))) {
          isValid = false;
          message = "Please enter a valid phone number";
        }
      }

      if (!isValid) {
        field.classList.add("border-red-500");
        errorDiv.textContent = message;
        errorDiv.classList.remove("hidden");
      }

      return isValid;
    }

    // Add event listeners for real-time validation
    const formFields = contactForm.querySelectorAll("input, select, textarea");
    formFields.forEach((field) => {
      field.addEventListener("blur", () => validateField(field));
      field.addEventListener("input", () => {
        if (field.classList.contains("border-red-500")) {
          validateField(field);
        }
      });
    });

    // Form submission
    contactForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Validate all fields
      let isFormValid = true;
      formFields.forEach((field) => {
        if (!validateField(field)) {
          isFormValid = false;
        }
      });

      if (!isFormValid) {
        return;
      }

      // Show loading state
      submitBtn.disabled = true;
      submitBtn.querySelector(".submit-text").classList.add("hidden");
      submitBtn.querySelector(".loading-text").classList.remove("hidden");

      try {
        // Simulate form submission (replace with actual endpoint)
        await new Promise((resolve) => setTimeout(resolve, 2000));

        // Show success message
        contactForm.style.display = "none";
        successMessage.classList.remove("hidden");

        // Optional: Send data to actual endpoint
        // const formData = new FormData(contactForm);
        // const response = await fetch('/api/contact', {
        //   method: 'POST',
        //   body: formData
        // });
      } catch (error) {
        console.error("Form submission error:", error);
        alert(
          "Sorry, there was an error sending your message. Please try again."
        );
      } finally {
        // Reset button state
        submitBtn.disabled = false;
        submitBtn.querySelector(".submit-text").classList.remove("hidden");
        submitBtn.querySelector(".loading-text").classList.add("hidden");
      }
    });

    // Chat function (placeholder)
    function startChat() {
      // Implement chat widget integration
      console.log("Starting chat...");
      alert(
        "Chat feature coming soon! Please call (800) USRad-24 for immediate assistance."
      );
    }

    // Smooth scroll enhancement
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute("href"));
        if (target) {
          target.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }
      });
    });
  </script>
</CarbonLayout>
