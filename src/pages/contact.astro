---
import MainLayout from "../layouts/MainLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import AOSInit from "../components/AOSInit.astro";
---

<MainLayout>
  <fragment slot="title">Contact Us | USRad</fragment>
  <AOSInit />

  <!-- Proven Support Banner -->
  <section
    class="bg-gradient-to-r from-[#cc9933] to-[#003087] text-white py-3 px-6"
  >
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-sm font-medium">
        🎯 <strong>PROVEN SUPPORT:</strong> Customer service model perfected through
        AnciCare (1994-2002) • 400,000+ patient interactions • Acquired by CorVel
        (NYSE: CVL)
      </p>
    </div>
  </section>

  <!-- Hero Section - More Dynamic -->
  <section
    class="relative bg-gradient-to-br from-[#003087] via-[#0052cc] to-[#003087] py-20 px-6 text-white overflow-hidden"
  >
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute top-20 left-20 w-32 h-32 bg-white rounded-full animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-20 right-20 w-24 h-24 bg-white rounded-full animate-pulse delay-1000"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/4 w-16 h-16 bg-white rounded-full animate-pulse delay-500"
      >
      </div>
    </div>

    <div class="max-w-6xl mx-auto text-center relative z-10" data-aos="fade-up">
      <!-- Credibility Badge -->
      <div
        class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md rounded-full px-6 py-3 border border-white/20 mb-6"
      >
        <svg
          class="w-5 h-5 text-[#cc9933]"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        <span class="text-sm font-medium"
          >PROVEN BY 400K+ PATIENTS • CORVEL ACQUISITION VALIDATED</span
        >
      </div>

      <h1 class="text-6xl md:text-7xl font-bold mb-6 leading-tight">
        We're Here to <span class="text-[#cc9933]">Help</span>
      </h1>
      <p class="text-xl md:text-2xl mb-8 max-w-3xl mx-auto opacity-90">
        Expert medical imaging made simple. Get answers in minutes, not
        days—backed by the <strong class="text-[#cc9933]"
          >AnciCare track record (1994-2002)</strong
        >
        that earned CorVel Corporation acquisition.
      </p>

      <!-- Immediate Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="tel:8005558723"
          class="bg-[#cc9933] hover:bg-[#b8862e] text-[#003087] px-8 py-4 rounded-full font-bold text-lg transition-all transform hover:scale-105 shadow-xl"
        >
          📞 Call Now: (800) USRad-24
        </a>
        <a
          href="#contact-form"
          class="bg-transparent border-2 border-white hover:bg-white hover:text-[#003087] px-8 py-4 rounded-full font-bold text-lg transition-all"
        >
          💬 Send Message
        </a>
      </div>

      <!-- Trust Indicators Row -->
      <div class="flex flex-wrap justify-center gap-6 text-sm opacity-90 mt-8">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
          <span>400K+ patients served successfully</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
          <span>CorVel Corporation acquisition validation</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
          <span>&lt;2 hour response guarantee</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats/Trust Section - Enhanced -->
  <section class="bg-white py-16 border-b border-gray-100" data-aos="fade-up">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Track Record Header -->
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#003087] mb-4">
          Support Excellence Proven Through Results
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Our customer support isn't just helpful—it's proven. We perfected our
          patient communication model through <strong class="text-[#cc9933]"
            >AnciCare (1994-2002)</strong
          >, where we successfully guided <strong class="text-blue-600"
            >400,000+ patients</strong
          >
          through their imaging journey.
        </p>
        <div class="mt-4">
          <span
            class="inline-flex items-center gap-2 bg-blue-50 rounded-full px-4 py-2"
          >
            <svg
              class="w-4 h-4 text-blue-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-blue-700 text-sm font-semibold"
              >Acquired by CorVel Corporation (NYSE: CVL) • Still operating 20+
              years later</span
            >
          </span>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div
          class="group bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl p-6 hover:shadow-lg transition-all"
        >
          <div
            class="text-3xl font-bold text-[#003087] mb-2 group-hover:text-[#cc9933] transition-colors"
          >
            400K+
          </div>
          <div class="text-gray-700 text-sm font-medium">Patients Served</div>
          <div
            class="text-xs text-blue-600 font-semibold mt-2 bg-white/50 rounded px-2 py-1"
          >
            AnciCare Legacy (1994-2002)
          </div>
        </div>
        <div
          class="group bg-gradient-to-br from-green-50 to-green-100 rounded-2xl p-6 hover:shadow-lg transition-all"
        >
          <div
            class="text-3xl font-bold text-[#003087] mb-2 group-hover:text-[#cc9933] transition-colors"
          >
            &lt;2hrs
          </div>
          <div class="text-gray-700 text-sm font-medium">Average Response</div>
          <div
            class="text-xs text-green-600 font-semibold mt-2 bg-white/50 rounded px-2 py-1"
          >
            Proven Process Excellence
          </div>
        </div>
        <div
          class="group bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl p-6 hover:shadow-lg transition-all"
        >
          <div
            class="text-3xl font-bold text-[#003087] mb-2 group-hover:text-[#cc9933] transition-colors"
          >
            $400M+
          </div>
          <div class="text-gray-700 text-sm font-medium">Savings Delivered</div>
          <div
            class="text-xs text-purple-600 font-semibold mt-2 bg-white/50 rounded px-2 py-1"
          >
            Track Record Validation
          </div>
        </div>
        <div
          class="group bg-gradient-to-br from-orange-50 to-orange-100 rounded-2xl p-6 hover:shadow-lg transition-all"
        >
          <div
            class="text-3xl font-bold text-[#003087] mb-2 group-hover:text-[#cc9933] transition-colors"
          >
            99.8%
          </div>
          <div class="text-gray-700 text-sm font-medium">Issue Resolution</div>
          <div
            class="text-xs text-orange-600 font-semibold mt-2 bg-white/50 rounded px-2 py-1"
          >
            AnciCare Standard Maintained
          </div>
        </div>
      </div>

      <!-- Additional Proof Points -->
      <div
        class="mt-12 bg-gradient-to-r from-blue-50 to-green-50 rounded-2xl p-8"
      >
        <div class="text-center">
          <h3 class="text-xl font-bold text-[#003087] mb-4">
            The CorVel Validation
          </h3>
          <p class="text-gray-700 max-w-4xl mx-auto">
            Our support model was so effective that <strong
              class="text-blue-600">CorVel Corporation (NYSE: CVL)</strong
            >
            acquired AnciCare in 2002 and continues operating our customer service
            approach 20+ years later. When a public company invests in your support
            system and keeps using it for two decades, that's the ultimate validation.
          </p>
          <div class="grid md:grid-cols-3 gap-4 mt-6">
            <div class="bg-white rounded-lg p-4">
              <div class="text-lg font-bold text-blue-600">2002</div>
              <div class="text-sm text-gray-600">CorVel Acquisition Year</div>
            </div>
            <div class="bg-white rounded-lg p-4">
              <div class="text-lg font-bold text-green-600">20+ Years</div>
              <div class="text-sm text-gray-600">Still Operating Our Model</div>
            </div>
            <div class="bg-white rounded-lg p-4">
              <div class="text-lg font-bold text-purple-600">NYSE: CVL</div>
              <div class="text-sm text-gray-600">Public Company Validation</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Methods - Enhanced with Credibility -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2
        class="text-4xl font-bold text-center text-[#003087] mb-4"
        data-aos="fade-up"
      >
        How Can We Help You Today?
      </h2>
      <p
        class="text-xl text-center text-gray-600 mb-4 max-w-2xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Choose the option that works best for you
      </p>
      <p
        class="text-center text-[#cc9933] font-semibold mb-12"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        ✅ Support system proven through AnciCare (1994-2002) and validated by
        CorVel Corporation acquisition
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Phone Card -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div
            class="bg-[#cc9933]/20 w-16 h-16 rounded-full flex items-center justify-center mb-6 mx-auto border-2 border-[#cc9933]"
          >
            <span class="text-2xl">📞</span>
          </div>
          <h3 class="text-2xl font-bold text-[#003087] mb-4 text-center">
            Call Us Now
          </h3>
          <p class="text-gray-600 mb-4 text-center">
            Speak with our experienced patient care team immediately
          </p>
          <div class="bg-blue-50 rounded-lg p-4 mb-6">
            <p class="text-xs text-center text-gray-700">
              <strong class="text-blue-600">AnciCare Proven Experience:</strong>
              Our team has guided 400,000+ patients through the imaging process using
              the same support model that earned CorVel Corporation's acquisition.
            </p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-[#003087] mb-4">(800) USRad-24</p>
            <a
              href="tel:8005558723"
              class="bg-[#003087] hover:bg-[#002366] text-white px-6 py-3 rounded-full font-bold transition-all inline-block"
            >
              Call Now
            </a>
            <p class="text-xs text-gray-500 mt-2">Available 8AM-8PM EST</p>
          </div>
        </div>

        <!-- Email Card -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div
            class="bg-blue-50 w-16 h-16 rounded-full flex items-center justify-center mb-6 mx-auto border-2 border-[#003087]"
          >
            <span class="text-2xl">✉️</span>
          </div>
          <h3 class="text-2xl font-bold text-[#003087] mb-4 text-center">
            Email Support
          </h3>
          <p class="text-gray-600 mb-4 text-center">
            Get detailed answers from our expert support team
          </p>
          <div class="bg-green-50 rounded-lg p-4 mb-6">
            <p class="text-xs text-center text-gray-700">
              <strong class="text-green-600">Expert Knowledge:</strong> 8+ years
              of medical imaging network experience from AnciCare (1994-2002), now
              enhanced for today's patient needs.
            </p>
          </div>
          <div class="text-center">
            <p class="text-lg font-semibold text-[#003087] mb-4">
              support@usrad.com
            </p>
            <a
              href="mailto:support@usrad.com"
              class="bg-[#cc9933] hover:bg-[#b8862e] text-[#003087] px-6 py-3 rounded-full font-bold transition-all inline-block"
            >
              Send Email
            </a>
            <p class="text-xs text-gray-500 mt-2">
              &lt;2 hour response guarantee
            </p>
          </div>
        </div>

        <!-- Chat Card -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div
            class="bg-gradient-to-br from-[#003087] to-[#0052cc] w-16 h-16 rounded-full flex items-center justify-center mb-6 mx-auto"
          >
            <span class="text-2xl text-white">💬</span>
          </div>
          <h3 class="text-2xl font-bold text-[#003087] mb-4 text-center">
            Live Chat
          </h3>
          <p class="text-gray-600 mb-4 text-center">
            Quick answers from healthcare imaging specialists
          </p>
          <div class="bg-purple-50 rounded-lg p-4 mb-6">
            <p class="text-xs text-center text-gray-700">
              <strong class="text-purple-600">Proven Fast Response:</strong> 2-3
              minute average response time using the communication protocols perfected
              through AnciCare's 400,000+ patient interactions.
            </p>
          </div>
          <div class="text-center">
            <p class="text-lg font-semibold text-[#003087] mb-4">
              Available 9AM-6PM EST
            </p>
            <button
              class="bg-[#cc9933] hover:bg-[#b8862e] text-[#003087] px-6 py-3 rounded-full font-bold transition-all"
            >
              Start Chat
            </button>
            <p class="text-xs text-gray-500 mt-2">Instant connection</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section id="contact-form" class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12" data-aos="fade-up">
        <h2 class="text-4xl font-bold text-[#003087] mb-4">
          Send Us a Message
        </h2>
        <p class="text-xl text-gray-600 mb-4">
          We'll get back to you within 2 hours during business hours
        </p>
        <div
          class="inline-flex items-center gap-2 bg-blue-50 rounded-full px-6 py-3"
        >
          <svg
            class="w-5 h-5 text-blue-600"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-blue-700 text-sm font-bold"
            >Proven Response System:</span
          >
          <span class="text-gray-600 text-sm"
            >Perfected through AnciCare's 400,000+ patient interactions</span
          >
        </div>
      </div>

      <div
        class="bg-gray-50 rounded-2xl p-8 md:p-12"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <form class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >First Name *</label
              >
              <input
                type="text"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Last Name *</label
              >
              <input
                type="text"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Email *</label
              >
              <input
                type="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Phone</label
              >
              <input
                type="tel"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2"
              >How can we help? *</label
            >
            <select
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
            >
              <option value="">Select a topic</option>
              <option value="scheduling">Schedule an Appointment</option>
              <option value="pricing">Questions About Pricing</option>
              <option value="results">Get My Results</option>
              <option value="insurance">Insurance Questions</option>
              <option value="locations">Find a Location</option>
              <option value="network">Join Our Provider Network</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2"
              >Message *</label
            >
            <textarea
              required
              rows="5"
              placeholder="Tell us more about how we can help you..."
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition resize-none"
            ></textarea>
          </div>

          <div class="text-center pt-4">
            <button
              type="submit"
              class="bg-[#003087] hover:bg-[#002366] text-white px-12 py-4 rounded-full font-bold text-lg transition-all transform hover:scale-105 shadow-lg"
            >
              Send Message →
            </button>
            <p class="text-xs text-gray-500 mt-2">
              Guaranteed response within 2 hours during business hours
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Support Excellence Proof Section -->
  <section class="bg-gradient-to-r from-blue-50 to-green-50 py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="bg-white rounded-2xl p-8 shadow-xl" data-aos="fade-up">
        <div class="text-center mb-8">
          <h3 class="text-3xl font-bold text-[#003087] mb-4">
            Why Our Support is Different
          </h3>
          <p class="text-gray-700 max-w-4xl mx-auto text-lg leading-relaxed">
            Our customer support isn't just helpful—it's <strong
              class="text-[#cc9933]">proven by acquisition</strong
            >. We perfected our patient communication model through <strong
              class="text-[#cc9933]">AnciCare (1994-2002)</strong
            >, where we successfully guided <strong class="text-blue-600"
              >400,000+ patients</strong
            >
            through their imaging journey. The model was so effective that
            <strong class="text-purple-600"
              >CorVel Corporation (NYSE: CVL) acquired us</strong
            >
            and continues operating our support approach 20+ years later.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <div
            class="text-center p-6 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg"
          >
            <div class="text-3xl font-bold text-blue-600 mb-2">400K+</div>
            <div class="text-sm text-gray-700 font-medium">
              Patient Interactions
            </div>
            <div class="text-xs text-blue-600 mt-2 font-semibold">
              AnciCare Proven Experience
            </div>
          </div>
          <div
            class="text-center p-6 bg-gradient-to-br from-green-50 to-green-100 rounded-lg"
          >
            <div class="text-3xl font-bold text-green-600 mb-2">99.8%</div>
            <div class="text-sm text-gray-700 font-medium">
              Issue Resolution Rate
            </div>
            <div class="text-xs text-green-600 mt-2 font-semibold">
              Track Record Excellence
            </div>
          </div>
          <div
            class="text-center p-6 bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg"
          >
            <div class="text-3xl font-bold text-purple-600 mb-2">20+</div>
            <div class="text-sm text-gray-700 font-medium">
              Years CorVel Operating
            </div>
            <div class="text-xs text-purple-600 mt-2 font-semibold">
              Continued Validation
            </div>
          </div>
        </div>

        <div
          class="bg-gradient-to-r from-[#003087]/5 to-[#cc9933]/5 rounded-xl p-6 text-center"
        >
          <p class="text-gray-700 text-lg">
            <strong class="text-[#cc9933]">Bottom Line:</strong> When you contact
            USRad, you're getting support from the team that built a customer service
            model so effective that a NYSE-listed company acquired it and has operated
            it successfully for over two decades.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Quick Links -->
  <section class="bg-[#003087] text-white py-16">
    <div class="max-w-6xl mx-auto px-6 text-center" data-aos="fade-up">
      <h2 class="text-3xl font-bold mb-4">Common Questions</h2>
      <p class="text-lg opacity-90 mb-8">
        Quick answers from our AnciCare-proven knowledge base
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a
          href="/pricing"
          class="bg-white/10 hover:bg-white/20 p-6 rounded-xl transition-all"
        >
          <h3 class="font-semibold mb-2">💰 How much does it cost?</h3>
          <p class="text-sm opacity-80">See transparent pricing →</p>
          <div class="text-xs text-[#cc9933] mt-2">
            Same pricing model CorVel acquired
          </div>
        </a>
        <a
          href="/how-it-works"
          class="bg-white/10 hover:bg-white/20 p-6 rounded-xl transition-all"
        >
          <h3 class="font-semibold mb-2">🏥 Do you take my insurance?</h3>
          <p class="text-sm opacity-80">Check coverage →</p>
          <div class="text-xs text-[#cc9933] mt-2">
            Proven insurance handling process
          </div>
        </a>
        <a
          href="/how-it-works#results"
          class="bg-white/10 hover:bg-white/20 p-6 rounded-xl transition-all"
        >
          <h3 class="font-semibold mb-2">📋 When will I get results?</h3>
          <p class="text-sm opacity-80">Learn more →</p>
          <div class="text-xs text-[#cc9933] mt-2">
            AnciCare-perfected timeline
