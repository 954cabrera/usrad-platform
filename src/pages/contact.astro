---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import AOSInit from "../components/AOSInit.astro";
---

<MainPatientLayout showPatientHeader={true}>
  <fragment slot="title">Contact Us | USRad</fragment>
  <AOSInit />

  <!-- Hero Section - More Dynamic -->
  <section
    class="relative bg-gradient-to-br from-[#003087] via-[#0052cc] to-[#003087] py-20 px-6 text-white overflow-hidden"
  >
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute top-20 left-20 w-32 h-32 bg-white rounded-full animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-20 right-20 w-24 h-24 bg-white rounded-full animate-pulse delay-1000"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/4 w-16 h-16 bg-white rounded-full animate-pulse delay-500"
      >
      </div>
    </div>

    <div class="max-w-6xl mx-auto text-center relative z-10" data-aos="fade-up">
      <!-- Credibility Badge -->
      <div
        class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md rounded-full px-6 py-3 border border-white/20 mb-6"
      >
        <svg
          class="w-5 h-5 text-[#cc9933]"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        <span class="text-sm font-medium"
          >PROVEN SUPPORT EXCELLENCE • NYSE-VALIDATED MODEL</span
        >
      </div>

      <h1 class="text-6xl md:text-7xl font-bold mb-6 leading-tight">
        We're Here to <span class="text-[#cc9933]">Help</span>
      </h1>
      <p class="text-xl md:text-2xl mb-8 max-w-3xl mx-auto opacity-90">
        Expert medical imaging made simple. Get answers in minutes, not
        days—from a team with
        <strong class="text-[#cc9933]">400,000+ patient success stories</strong
        >.
      </p>

      <!-- Immediate Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="tel:8005558723"
          class="bg-[#cc9933] hover:bg-[#b8862e] text-[#003087] px-8 py-4 rounded-full font-bold text-lg transition-all transform hover:scale-105 shadow-xl"
        >
          📞 Call Now: (800) USRad-24
        </a>
        <a
          href="#contact-form"
          class="bg-transparent border-2 border-white hover:bg-white hover:text-[#003087] px-8 py-4 rounded-full font-bold text-lg transition-all"
        >
          💬 Send Message
        </a>
      </div>

      <!-- Trust Indicators Row -->
      <div class="flex flex-wrap justify-center gap-6 text-sm opacity-90 mt-8">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
          <span>&lt;2 hour response guarantee</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
          <span>99.8% issue resolution rate</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
          <span>20+ years of healthcare excellence</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Trust Us Section - Consolidated -->
  <section class="bg-white py-16 border-b border-gray-100" data-aos="fade-up">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Track Record Header -->
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-[#003087] mb-4">
          Why Trust Our Support Team?
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Our approach to patient care isn't new or untested—it's backed by
          decades of real-world success. The AnciCare model (1994-2002) guided
          <strong class="text-blue-600">400,000+ patients</strong> through their
          healthcare journey before being
          <strong class="text-[#cc9933]"
            >acquired by CorVel Corporation (NYSE: CVL)</strong
          >.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div
          class="group bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl p-6 hover:shadow-lg transition-all"
        >
          <div
            class="text-3xl font-bold text-[#003087] mb-2 group-hover:text-[#cc9933] transition-colors"
          >
            400,000+
          </div>
          <div class="text-gray-700 text-sm font-medium">Patients Served</div>
          <div
            class="text-xs text-blue-600 font-semibold mt-2 bg-white/50 rounded px-2 py-1"
          >
            Healthcare Journey Expertise
          </div>
        </div>
        <div
          class="group bg-gradient-to-br from-green-50 to-green-100 rounded-2xl p-6 hover:shadow-lg transition-all"
        >
          <div
            class="text-3xl font-bold text-[#003087] mb-2 group-hover:text-[#cc9933] transition-colors"
          >
            &lt;2hrs
          </div>
          <div class="text-gray-700 text-sm font-medium">Average Response</div>
          <div
            class="text-xs text-green-600 font-semibold mt-2 bg-white/50 rounded px-2 py-1"
          >
            Rapid Resolution Process
          </div>
        </div>
        <div
          class="group bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl p-6 hover:shadow-lg transition-all"
        >
          <div
            class="text-3xl font-bold text-[#003087] mb-2 group-hover:text-[#cc9933] transition-colors"
          >
            $400 Million+
          </div>
          <div class="text-gray-700 text-sm font-medium">Savings Delivered</div>
          <div
            class="text-xs text-purple-600 font-semibold mt-2 bg-white/50 rounded px-2 py-1"
          >
            Value-Focused Approach
          </div>
        </div>
        <div
          class="group bg-gradient-to-br from-orange-50 to-orange-100 rounded-2xl p-6 hover:shadow-lg transition-all"
        >
          <div
            class="text-3xl font-bold text-[#003087] mb-2 group-hover:text-[#cc9933] transition-colors"
          >
            99.8%
          </div>
          <div class="text-gray-700 text-sm font-medium">Issue Resolution</div>
          <div
            class="text-xs text-orange-600 font-semibold mt-2 bg-white/50 rounded px-2 py-1"
          >
            Near-Perfect Success Rate
          </div>
        </div>
      </div>

      <!-- Acquisition Proof - Consolidated -->
      <div
        class="mt-12 bg-gradient-to-r from-blue-50 to-green-50 rounded-2xl p-8"
      >
        <div class="text-center">
          <h3 class="text-xl font-bold text-[#003087] mb-4">
            Our Legacy of Excellence
          </h3>
          <p class="text-gray-700 max-w-4xl mx-auto">
            Our patient support approach proved so successful that after our
            acquisition in 2002, CorVel Corporation has continued using our
            service model for 20+ years. That's the ultimate validation of our
            approach to patient care—and now we're bringing that same expertise
            to you, enhanced with modern digital capabilities.
          </p>
          <div class="grid md:grid-cols-3 gap-4 mt-6">
            <div class="bg-white rounded-lg p-4">
              <div class="text-lg font-bold text-blue-600">Radiology Focus</div>
              <div class="text-sm text-gray-600">Specialized Expertise</div>
            </div>
            <div class="bg-white rounded-lg p-4">
              <div class="text-lg font-bold text-green-600">
                Patient-Centric
              </div>
              <div class="text-sm text-gray-600">Compassionate Approach</div>
            </div>
            <div class="bg-white rounded-lg p-4">
              <div class="text-lg font-bold text-purple-600">
                Clinically Informed
              </div>
              <div class="text-sm text-gray-600">
                Medical Knowledge Integrated
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Methods - Focused on Unique Benefits -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2
        class="text-4xl font-bold text-center text-[#003087] mb-4"
        data-aos="fade-up"
      >
        How Can We Help You Today?
      </h2>
      <p
        class="text-xl text-center text-gray-600 mb-12 max-w-2xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Choose your preferred contact method
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Phone Card - Focused on Immediacy -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div
            class="bg-[#cc9933]/20 w-16 h-16 rounded-full flex items-center justify-center mb-6 mx-auto border-2 border-[#cc9933]"
          >
            <span class="text-2xl">📞</span>
          </div>
          <h3 class="text-2xl font-bold text-[#003087] mb-4 text-center">
            Call Us Now
          </h3>
          <p class="text-gray-600 mb-4 text-center">
            Immediate assistance for your most urgent questions
          </p>
          <div class="bg-blue-50 rounded-lg p-4 mb-6">
            <p class="text-xs text-center text-gray-700">
              <strong class="text-blue-600">Direct Access:</strong>
              Speak immediately with our medical imaging specialists who can answer
              complex questions and guide you through the process.
            </p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold text-[#003087] mb-4">(800) USRad-24</p>
            <a
              href="tel:8005558723"
              class="bg-[#003087] hover:bg-[#002366] text-white px-6 py-3 rounded-full font-bold transition-all inline-block"
            >
              Call Now
            </a>
            <p class="text-xs text-gray-500 mt-2">Available 8AM-8PM EST</p>
          </div>
        </div>

        <!-- Email Card - Focused on Detailed Responses -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div
            class="bg-blue-50 w-16 h-16 rounded-full flex items-center justify-center mb-6 mx-auto border-2 border-[#003087]"
          >
            <span class="text-2xl">✉️</span>
          </div>
          <h3 class="text-2xl font-bold text-[#003087] mb-4 text-center">
            Email Support
          </h3>
          <p class="text-gray-600 mb-4 text-center">
            Get detailed answers with supporting documentation
          </p>
          <div class="bg-green-50 rounded-lg p-4 mb-6">
            <p class="text-xs text-center text-gray-700">
              <strong class="text-green-600">Thorough Responses:</strong> Receive
              comprehensive answers with links to resources, pricing documentation,
              and appointment details you can save and reference whenever needed.
            </p>
          </div>
          <div class="text-center">
            <p class="text-lg font-semibold text-[#003087] mb-4">
              support@usrad.com
            </p>
            <a
              href="mailto:support@usrad.com"
              class="bg-[#cc9933] hover:bg-[#b8862e] text-[#003087] px-6 py-3 rounded-full font-bold transition-all inline-block"
            >
              Send Email
            </a>
            <p class="text-xs text-gray-500 mt-2">
              &lt;2 hour response guarantee
            </p>
          </div>
        </div>

        <!-- Chat Card - Focused on Convenience -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div
            class="bg-gradient-to-br from-[#003087] to-[#0052cc] w-16 h-16 rounded-full flex items-center justify-center mb-6 mx-auto"
          >
            <span class="text-2xl text-white">💬</span>
          </div>
          <h3 class="text-2xl font-bold text-[#003087] mb-4 text-center">
            Live Chat
          </h3>
          <p class="text-gray-600 mb-4 text-center">
            Quick, convenient answers without leaving the page
          </p>
          <div class="bg-purple-50 rounded-lg p-4 mb-6">
            <p class="text-xs text-center text-gray-700">
              <strong class="text-purple-600">Perfect For:</strong> Quick questions
              about pricing, scheduling, or finding the right location while you
              browse our site. Multi-task while getting answers.
            </p>
          </div>
          <div class="text-center">
            <p class="text-lg font-semibold text-[#003087] mb-4">
              Available 9AM-6PM EST
            </p>
            <button
              class="bg-[#cc9933] hover:bg-[#b8862e] text-[#003087] px-6 py-3 rounded-full font-bold transition-all"
            >
              Start Chat
            </button>
            <p class="text-xs text-gray-500 mt-2">
              2-3 minute avg. response time
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section - Streamlined -->
  <section id="contact-form" class="bg-white py-20">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12" data-aos="fade-up">
        <h2 class="text-4xl font-bold text-[#003087] mb-4">
          Send Us a Message
        </h2>
        <p class="text-xl text-gray-600 mb-4">
          We'll get back to you within 2 hours during business hours
        </p>
        <div
          class="inline-flex items-center gap-2 bg-blue-50 rounded-full px-6 py-3"
        >
          <svg
            class="w-5 h-5 text-blue-600"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-blue-700 text-sm font-bold"
            >Healthcare-Specific Support:</span
          >
          <span class="text-gray-600 text-sm"
            >Our team understands medical imaging</span
          >
        </div>
      </div>

      <div
        class="bg-gray-50 rounded-2xl p-8 md:p-12"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <form class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >First Name *</label
              >
              <input
                type="text"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Last Name *</label
              >
              <input
                type="text"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Email *</label
              >
              <input
                type="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Phone</label
              >
              <input
                type="tel"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2"
              >How can we help? *</label
            >
            <select
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition"
            >
              <option value="">Select a topic</option>
              <option value="scheduling">Schedule an Appointment</option>
              <option value="pricing">Questions About Pricing</option>
              <option value="results">Get My Results</option>
              <option value="insurance">Insurance Questions</option>
              <option value="locations">Find a Location</option>
              <option value="network">Join Our Provider Network</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2"
              >Message *</label
            >
            <textarea
              required
              rows="5"
              placeholder="Tell us more about how we can help you..."
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#003087] focus:border-[#003087] transition resize-none"
            ></textarea>
          </div>

          <div class="text-center pt-4">
            <button
              type="submit"
              class="bg-[#003087] hover:bg-[#002366] text-white px-12 py-4 rounded-full font-bold text-lg transition-all transform hover:scale-105 shadow-lg"
            >
              Send Message →
            </button>
            <p class="text-xs text-gray-500 mt-2">
              Guaranteed response within 2 hours during business hours
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Our Support Approach - Focused on Details -->
  <section class="bg-gradient-to-r from-blue-50 to-green-50 py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="bg-white rounded-2xl p-8 shadow-xl" data-aos="fade-up">
        <div class="text-center mb-8">
          <h3 class="text-3xl font-bold text-[#003087] mb-4">
            How We'll Support You
          </h3>
          <p class="text-gray-700 max-w-4xl mx-auto text-lg leading-relaxed">
            Our support experience is designed specifically for medical imaging
            patients. We combine healthcare expertise with compassionate service
            to make your imaging journey as smooth as possible.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <div
            class="text-center p-6 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg"
          >
            <div class="text-3xl font-bold text-blue-600 mb-2">
              Medical Knowledge
            </div>
            <div class="text-sm text-gray-700 font-medium">
              Our team understands imaging procedures
            </div>
            <div class="text-xs text-blue-600 mt-2 font-semibold">
              We speak your language
            </div>
          </div>
          <div
            class="text-center p-6 bg-gradient-to-br from-green-50 to-green-100 rounded-lg"
          >
            <div class="text-3xl font-bold text-green-600 mb-2">
              Transparent Pricing
            </div>
            <div class="text-sm text-gray-700 font-medium">
              We provide clear, upfront costs
            </div>
            <div class="text-xs text-green-600 mt-2 font-semibold">
              No surprise bills
            </div>
          </div>
          <div
            class="text-center p-6 bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg"
          >
            <div class="text-3xl font-bold text-purple-600 mb-2">
              Clinical Coordination
            </div>
            <div class="text-sm text-gray-700 font-medium">
              We connect with your care team
            </div>
            <div class="text-xs text-purple-600 mt-2 font-semibold">
              Streamlined process
            </div>
          </div>
        </div>

        <div
          class="bg-gradient-to-r from-[#003087]/5 to-[#cc9933]/5 rounded-xl p-6 text-center"
        >
          <p class="text-gray-700 text-lg">
            <strong class="text-[#cc9933]">Our Promise:</strong>
            When you contact USRad, you'll receive clear, accurate information from
            specialists who understand medical imaging and genuinely care about your
            healthcare journey.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Quick Links -->
  <section class="bg-[#003087] text-white py-16">
    <div class="max-w-6xl mx-auto px-6 text-center" data-aos="fade-up">
      <h2 class="text-3xl font-bold mb-4">Common Questions</h2>
      <p class="text-lg opacity-90 mb-8">
        Quick answers to frequently asked questions
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a
          href="/pricing"
          class="bg-white/10 hover:bg-white/20 p-6 rounded-xl transition-all"
        >
          <h3 class="font-semibold mb-2">💰 How much does it cost?</h3>
          <p class="text-sm opacity-80">See transparent pricing →</p>
        </a>
        <a
          href="/how-it-works"
          class="bg-white/10 hover:bg-white/20 p-6 rounded-xl transition-all"
        >
          <h3 class="font-semibold mb-2">💸 No Insurance Needed</h3>
          <p class="text-sm opacity-80">See how our cash-pay model works →</p>
        </a>
        <a
          href="/how-it-works#results"
          class="bg-white/10 hover:bg-white/20 p-6 rounded-xl transition-all"
        >
          <h3 class="font-semibold mb-2">📋 When will I get results?</h3>
          <p class="text-sm opacity-80">Learn more →</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Provider CTA - Focused -->
  <section class="bg-[#cc9933] py-16">
    <div class="max-w-4xl mx-auto px-6 text-center" data-aos="fade-up">
      <h2 class="text-3xl font-bold text-[#003087] mb-4">
        Medical Imaging Provider?
      </h2>
      <p class="text-xl text-[#003087] mb-4 opacity-80">
        Join our network and grow your practice with USRad
      </p>
      <div class="bg-[#003087]/10 rounded-lg p-6 mb-6 max-w-3xl mx-auto">
        <p class="text-sm text-[#003087] leading-relaxed">
          <strong>Partner Success Story:</strong> We've built successful partnerships
          with 1,200+ imaging centers, generating 400,000+ patient referrals and
          over $160 Million in provider revenue. Our network model continues to deliver
          results for imaging centers just like yours.
        </p>
      </div>
      <a
        href="/managed-care/"
        class="bg-[#003087] hover:bg-[#002366] text-white px-8 py-4 rounded-full font-bold text-lg transition-all inline-block transform hover:scale-105"
      >
        Join Our Provider Network →
      </a>
    </div>
  </section>

  <ChatbotToggle chatbotLabel="💬 Let's Talk" />
</MainPatientLayout>
