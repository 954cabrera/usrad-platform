---
// src/pages/dashboard/patient-management/index.astro
// Executive-level Patient Management Dashboard

import PatientManagementDashboardLayout from "../../../components/dashboard/PatientManagementDashboardLayout.astro";
import PatientManagementSystem from "../../../components/dashboard/PatientManagementSystem";
---

<PatientManagementDashboardLayout
  title="Patient Management Dashboard - Executive Command Center"
  user={null}
>
  <!-- Executive Command Center Header -->
  <div
    class="bg-gradient-to-r from-primary to-blue-800 text-white rounded-lg shadow-xl mb-6"
  >
    <div class="p-6">
      <div class="flex justify-between items-start mb-6">
        <div>
          <h1 class="text-3xl font-bold mb-2 font-manrope">
            Patient Management Command Center
          </h1>
          <p class="text-blue-100 text-lg">
            Complete Patient Lifecycle Management • Real-Time Operations
          </p>
          <p class="text-blue-200 text-sm">
            Role: Patient Manager | Executive Access
          </p>
        </div>
        <div class="text-right">
          <div class="text-blue-100 font-medium">Executive Dashboard</div>
          <div class="text-blue-200 text-sm" id="live-timestamp">
            {
              new Date().toLocaleTimeString([], {
                hour: "2-digit",
                minute: "2-digit",
              })
            }
          </div>
          <div class="text-blue-200 text-xs mt-1">Auto-refresh: Active</div>
        </div>
      </div>

      <!-- Executive KPI Dashboard -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white bg-opacity-10 rounded-lg p-4 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-2xl font-bold text-white">$12,485</div>
              <div class="text-blue-200 text-sm">Today's Revenue</div>
              <div class="text-blue-300 text-xs">+23% vs yesterday</div>
            </div>
            <div class="text-3xl opacity-80">💰</div>
          </div>
        </div>

        <div class="bg-white bg-opacity-10 rounded-lg p-4 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-2xl font-bold text-white">94.2%</div>
              <div class="text-blue-200 text-sm">SLA Compliance</div>
              <div class="text-blue-300 text-xs">Target: 95%</div>
            </div>
            <div class="text-3xl opacity-80">📋</div>
          </div>
        </div>

        <div class="bg-white bg-opacity-10 rounded-lg p-4 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-2xl font-bold text-white">4.3⭐</div>
              <div class="text-blue-200 text-sm">Avg Rating</div>
              <div class="text-blue-300 text-xs">+0.2 this month</div>
            </div>
            <div class="text-3xl opacity-80">⭐</div>
          </div>
        </div>

        <div class="bg-white bg-opacity-10 rounded-lg p-4 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-2xl font-bold text-white">73%</div>
              <div class="text-blue-200 text-sm">Response Rate</div>
              <div class="text-blue-300 text-xs">+8% improvement</div>
            </div>
            <div class="text-3xl opacity-80">📊</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Time-based Navigation (like Corporate Dashboard) -->
  <div class="mb-6">
    <div class="flex space-x-4">
      <button
        class="bg-primary text-white px-4 py-2 rounded-lg text-sm font-medium"
        >Today</button
      >
      <button
        class="bg-white text-gray-700 px-4 py-2 rounded-lg text-sm font-medium border border-gray-300 hover:bg-gray-50"
        >Week</button
      >
      <button
        class="bg-white text-gray-700 px-4 py-2 rounded-lg text-sm font-medium border border-gray-300 hover:bg-gray-50"
        >Month</button
      >
    </div>
  </div>

  <!-- Status Alerts Row -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <!-- System Health -->
    <div class="bg-white rounded-lg p-4 shadow-sm border-l-4 border-green-500">
      <div class="flex items-center">
        <div class="w-3 h-3 bg-green-500 rounded-full mr-3"></div>
        <div>
          <div class="text-sm font-medium text-gray-900">
            System Health: All platforms operational (99.8% uptime)
          </div>
        </div>
      </div>
    </div>

    <!-- Capacity Alert -->
    <div class="bg-white rounded-lg p-4 shadow-sm border-l-4 border-yellow-500">
      <div class="flex items-center">
        <div class="w-3 h-3 bg-yellow-500 rounded-full mr-3"></div>
        <div>
          <div class="text-sm font-medium text-gray-900">
            Capacity Alert: Miami market at 85% provider utilization
          </div>
        </div>
      </div>
    </div>

    <!-- Growth Opportunity -->
    <div class="bg-white rounded-lg p-4 shadow-sm border-l-4 border-blue-500">
      <div class="flex items-center">
        <div class="w-3 h-3 bg-blue-500 rounded-full mr-3"></div>
        <div>
          <div class="text-sm font-medium text-gray-900">
            Growth Opportunity: 12 new high-value providers pending onboarding
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Executive Quick Actions -->
  <div class="bg-white rounded-lg shadow-sm mb-6">
    <div class="p-6 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">
        ⚡ Executive Quick Actions
      </h3>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <button
          class="flex items-center justify-center bg-blue-600 text-white px-4 py-3 rounded-lg hover:bg-blue-700 transition-colors"
        >
          <span class="mr-2">📊</span>
          <span class="font-medium">Monthly KPI summary with insights</span>
        </button>
        <button
          class="flex items-center justify-center bg-green-600 text-white px-4 py-3 rounded-lg hover:bg-green-700 transition-colors"
        >
          <span class="mr-2">🔍</span>
          <span class="font-medium">Market Expansion Analysis</span>
        </button>
        <button
          class="flex items-center justify-center bg-purple-600 text-white px-4 py-3 rounded-lg hover:bg-purple-700 transition-colors"
        >
          <span class="mr-2">🏥</span>
          <span class="font-medium">Provider Network Review</span>
        </button>
        <button
          class="flex items-center justify-center bg-orange-600 text-white px-4 py-3 rounded-lg hover:bg-orange-700 transition-colors"
        >
          <span class="mr-2">🧠</span>
          <span class="font-medium">Competitive Intelligence</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main Patient Management System -->
  <PatientManagementSystem client:load />

  <!-- Live updates script -->
  <script>
    function updateTimestamp() {
      const now = new Date();
      const timeString = now.toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      });

      const element = document.getElementById("live-timestamp");
      if (element) {
        element.textContent = timeString;
      }
    }

    setInterval(updateTimestamp, 1000);

    // Executive-level notifications
    function showExecutiveNotification(title, message, type = "info") {
      const notification = document.createElement("div");
      notification.className = `fixed top-4 right-4 bg-white border-l-4 ${
        type === "urgent"
          ? "border-red-500"
          : type === "success"
            ? "border-green-500"
            : "border-blue-500"
      } shadow-lg rounded-lg p-4 z-50 max-w-sm`;

      notification.innerHTML = `
        <div class="flex">
          <div class="flex-shrink-0">
            <span class="text-lg">${type === "urgent" ? "🚨" : type === "success" ? "✅" : "ℹ️"}</span>
          </div>
          <div class="ml-3">
            <h4 class="text-sm font-medium text-gray-900">${title}</h4>
            <p class="text-sm text-gray-600 mt-1">${message}</p>
          </div>
        </div>
      `;

      document.body.appendChild(notification);

      setTimeout(() => {
        notification.remove();
      }, 5000);
    }

    // Simulate executive-level alerts
    setTimeout(() => {
      showExecutiveNotification(
        "Revenue Milestone",
        "Daily revenue target achieved: $12,485 (+23% vs target)",
        "success"
      );
    }, 8000);

    setTimeout(() => {
      showExecutiveNotification(
        "SLA Alert",
        "Provider response time declining in Miami market. Intervention recommended.",
        "urgent"
      );
    }, 15000);

    setTimeout(() => {
      showExecutiveNotification(
        "Growth Opportunity",
        "New high-value provider inquiry: Orlando Regional Imaging",
        "info"
      );
    }, 22000);
  </script>
</PatientManagementDashboardLayout>
