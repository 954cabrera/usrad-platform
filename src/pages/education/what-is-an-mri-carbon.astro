---
// src/pages/education/what-is-mri-carbon.astro
import CarbonLayout from "../../layouts/CarbonLayout.astro";
import MultiModalViewer from "../../components/education/MultiModalViewer.jsx";
import AOSInit from "../../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout title="What is an MRI? | USRad Medical Imaging">
  <AOSInit />

  <!-- Hero Section with Optimized Video and Mobile Fallback -->
  <section
    class="relative pt-32 pb-20 px-4 sm:px-6 min-h-[700px] flex items-center overflow-hidden"
  >
    <!-- Media Background -->
    <div class="absolute inset-0 z-0">
      <!-- Fallback Image -->
      <img
        src="/images/education-mri-hero-blur.webp"
        alt="MRI Background"
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />

      <!-- Lazy Loaded Video -->
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/education-mri-hero-blur.webp"
        class="absolute inset-0 w-full h-full object-cover"
        data-src-desktop="/videos/education-mri-desktop.webm"
        data-src-mobile="/videos/education-mri-mobile.webm"></video>

      <!-- Overlay Gradients -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/60"
      >
      </div>
    </div>

    <!-- Floating Effects -->
    <div
      class="absolute top-20 right-10 w-64 h-64 bg-blue-500/20 rounded-full blur-3xl animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-20 left-10 w-96 h-96 bg-[#cc9933]/10 rounded-full blur-3xl animate-pulse delay-1000"
    >
    </div>

    <!-- Hero Content (unchanged) -->
    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="max-w-5xl">
        <div
          class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-8"
          data-aos="fade-down"
        >
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          <span class="text-white/80 text-sm font-medium"
            >From the team that revolutionized medical imaging</span
          >
        </div>
        <h1
          class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold mb-8 text-white leading-tight"
          data-aos="fade-up"
        >
          See Inside.<br />
          Without Surgery.<br />
          Without Radiation.<br />
          <span class="text-[#cc9933]"
            >In <span
              id="countdown"
              aria-label="Time until appointment available">48:00:00</span
            ></span
          >
        </h1>
        <p
          class="text-xl md:text-2xl text-gray-100 leading-relaxed max-w-3xl"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          MRI technology lets doctors see what's happening inside your
          body—safely, clearly, and without a single incision. Here's how it
          works.
        </p>
        <div
          class="mt-12 flex flex-col sm:flex-row gap-4"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <button
            onclick="document.getElementById('viewer-section').scrollIntoView({behavior: 'smooth'})"
            class="bg-white text-[#003087] px-8 py-4 rounded-xl font-semibold text-lg hover:bg-gray-100 transition-all transform hover:scale-105"
          >
            Explore Interactive MRI
          </button>
          <a
            href="/search-test"
            class="bg-transparent border-2 border-white text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-white/10 transition-all"
          >
            Find a Center Near You
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- The Science - Visual Storytelling -->
  <section class="py-24 px-4 sm:px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20" data-aos="fade-up">
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6"
        >
          The Invisible Made Visible
        </h2>
        <p class="text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto">
          Using magnetic fields 30,000 times stronger than Earth's, MRI creates
          detailed images without any radiation exposure.
        </p>
      </div>

      <!-- Photo Grid Explanation -->
      <div class="grid md:grid-cols-3 gap-8 mb-20">
        <div class="relative group" data-aos="fade-up">
          <div class="relative rounded-2xl overflow-hidden shadow-xl">
            <img
              src="/images/education/mri-alignment.webp"
              alt="MRI magnetic field visualization showing hydrogen atoms aligning in the body"
              class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
            >
              <div class="text-white">
                <h3 class="text-2xl font-bold mb-2">Magnetic Alignment</h3>
                <p class="text-sm opacity-90">
                  Hydrogen atoms in your body align with the magnetic field
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative group" data-aos="fade-up" data-aos-delay="100">
          <div class="relative rounded-2xl overflow-hidden shadow-xl">
            <img
              src="/images/education/radiowave.webp"
              alt="Radio waves creating detailed tissue images in MRI scanner"
              class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
            >
              <div class="text-white">
                <h3 class="text-2xl font-bold mb-2">Radio Wave Signals</h3>
                <p class="text-sm opacity-90">
                  Safe radio waves create detailed tissue images
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative group" data-aos="fade-up" data-aos-delay="200">
          <div class="relative rounded-2xl overflow-hidden shadow-xl">
            <img
              src="/images/education/crystalclear.webp"
              alt="Crystal clear MRI brain scan results on medical monitor"
              class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-6"
            >
              <div class="text-white">
                <h3 class="text-2xl font-bold mb-2">Crystal Clear Images</h3>
                <p class="text-sm opacity-90">
                  Detailed views help doctors make accurate diagnoses
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Simple Process Timeline -->
      <div class="relative">
        <div
          class="absolute left-1/2 top-0 bottom-0 w-px bg-gray-200 transform -translate-x-1/2 hidden md:block"
        >
        </div>

        <div class="space-y-16 md:space-y-24">
          <!-- You Arrive -->
          <div
            class="relative flex items-center timeline-step"
            data-aos="fade-right"
          >
            <div class="w-full md:w-1/2 text-right pr-8 md:pr-16">
              <h3 class="text-3xl font-bold text-gray-900 mb-3">You Arrive</h3>
              <p class="text-lg text-gray-600 max-w-md ml-auto">
                Change into comfortable clothing. Remove any metal objects. The
                technician explains everything.
              </p>
            </div>
            <div
              class="absolute left-1/2 transform -translate-x-1/2 z-10 hidden md:block"
            >
              <div
                class="w-16 h-16 bg-white rounded-full border-4 border-[#003087] flex items-center justify-center"
              >
                <span class="text-2xl">👤</span>
              </div>
            </div>
            <div class="hidden md:block w-1/2"></div>
          </div>

          <!-- The Scan -->
          <div
            class="relative flex items-center timeline-step"
            data-aos="fade-left"
          >
            <div class="hidden md:block w-1/2"></div>
            <div
              class="absolute left-1/2 transform -translate-x-1/2 z-10 hidden md:block"
            >
              <div
                class="w-16 h-16 bg-white rounded-full border-4 border-[#cc9933] flex items-center justify-center"
              >
                <span class="text-2xl">🔍</span>
              </div>
            </div>
            <div class="w-full md:w-1/2 pl-8 md:pl-16">
              <h3 class="text-3xl font-bold text-gray-900 mb-3">
                20-45 Minutes
              </h3>
              <p class="text-lg text-gray-600 max-w-md">
                Lie still while the machine creates images. You'll hear clicking
                sounds—that's normal. Headphones provided.
              </p>
            </div>
          </div>

          <!-- Results -->
          <div
            class="relative flex items-center timeline-step"
            data-aos="fade-right"
          >
            <div class="w-full md:w-1/2 text-right pr-8 md:pr-16">
              <h3 class="text-3xl font-bold text-gray-900 mb-3">24-48 Hours</h3>
              <p class="text-lg text-gray-600 max-w-md ml-auto">
                Board-certified radiologists review your images. Results sent
                directly to your doctor.
              </p>
            </div>
            <div
              class="absolute left-1/2 transform -translate-x-1/2 z-10 hidden md:block"
            >
              <div
                class="w-16 h-16 bg-white rounded-full border-4 border-green-500 flex items-center justify-center"
              >
                <span class="text-2xl">✓</span>
              </div>
            </div>
            <div class="hidden md:block w-1/2"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Viewer Section - Streamlined -->
  <section
    id="viewer-section"
    class="bg-gradient-to-br from-gray-50 to-white py-24 px-4 sm:px-6"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12" data-aos="fade-up">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Explore MRI Technology
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Interactive viewers showing real MRI, CT, and other medical imaging.
          See what your doctor sees.
        </p>
      </div>

      <!-- The Viewer with Loading State -->
      <div data-aos="zoom-in" class="min-h-[600px] relative">
        <!-- Loading skeleton -->
        <div
          class="animate-pulse bg-gray-200 rounded-lg h-[600px] absolute inset-0"
          id="viewer-skeleton"
        >
          <div class="flex items-center justify-center h-full">
            <div class="text-center">
              <div
                class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-[#003087]"
              >
              </div>
              <p class="text-gray-600 mt-4">Loading interactive viewer...</p>
            </div>
          </div>
        </div>
        <MultiModalViewer client:load />
        <!-- Add this attribution below the viewer -->
        <p class="text-center text-xs text-gray-500 mt-6">
          MRI imaging data provided by OASIS-1 (Open Access Series of Imaging
          Studies)
          <a
            href="https://www.oasis-brains.org"
            class="text-blue-600 hover:underline"
            target="_blank"
          >
            Learn more
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Human Impact Section -->
  <section
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-white via-blue-50/20 to-white"
  >
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6"
        >
          Why Every Day Matters
        </h2>
        <p class="text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto">
          For serious conditions, early detection can mean the difference
          between simple treatment and life-threatening complications.
        </p>
      </div>

      <!-- Impact Stories Grid -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8" data-aos="fade-right">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0"
            >
              <span class="text-2xl">⏰</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                14 Days Average Wait
              </h3>
              <p class="text-gray-600">
                At hospitals. Pain without answers. Anxiety building.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center flex-shrink-0"
            >
              <span class="text-2xl">💸</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                $3,200 Average Cost
              </h3>
              <p class="text-gray-600">
                Hospital pricing. Forcing people to delay or skip care entirely.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 relative">
            <div
              class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0 relative z-10"
            >
              <span class="text-2xl">✨</span>
            </div>
            <div class="relative z-10">
              <h3 class="text-xl font-semibold text-gray-900 mb-2 relative">
                <span class="highlight-text">48 Hours with USRad</span>
              </h3>
              <p class="text-gray-600 relative">
                <span class="highlight-text-2 inline-block">
                  Fast appointments. Clear pricing. Peace of mind.
                </span>
              </p>
            </div>
          </div>
        </div>

        <div
          class="relative rounded-3xl overflow-hidden shadow-2xl"
          data-aos="fade-left"
        >
          <img
            src="/images/education/goodnews.webp"
            alt="Patient receiving good news from doctor about MRI results"
            class="w-full h-96 object-cover"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-8"
          >
            <div class="text-white">
              <p class="text-3xl font-bold mb-2">$260 vs $3,200</p>
              <p class="text-lg opacity-90">
                Same scan. Same quality. Life-changing difference.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The USRad Difference - MRI Expertise Focus -->
  <section
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-[#003087] to-[#002266] text-white"
  >
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
          MRI Expertise You Can Trust.<br />
          <span class="text-[#cc9933]">From Day One.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="text-center" data-aos="zoom-in">
          <div class="text-6xl mb-4">🏆</div>
          <h3 class="text-2xl font-bold mb-3">168,224 MRIs Performed</h3>
          <p class="text-white/80">
            Our leadership team has overseen hundreds of thousands of MRI scans.
            We know what quality looks like.
          </p>
        </div>

        <div class="text-center" data-aos="zoom-in" data-aos-delay="100">
          <div class="text-6xl mb-4">👨‍⚕️</div>
          <h3 class="text-2xl font-bold mb-3">Board-Certified Radiologists</h3>
          <p class="text-white/80">
            Every scan reviewed by qualified specialists. Same radiologists
            hospitals use, without the hospital markup.
          </p>
        </div>

        <div class="text-center" data-aos="zoom-in" data-aos-delay="200">
          <div class="text-6xl mb-4">🛡️</div>
          <h3 class="text-2xl font-bold mb-3">Your MRI, Your Peace of Mind</h3>
          <p class="text-white/80">
            Clear explanations. Comfortable experience. Results in 24-48 hours.
            Healthcare how it should be.
          </p>
        </div>
      </div>

      <div class="text-center mt-16" data-aos="fade-up">
        <p class="text-lg text-white/70">
          ACR accredited facilities • Same-day appointments • Proven expertise
        </p>
        <p class="text-sm text-white/50 mt-4">
          <span class="font-semibold">4.9★</span> average rating from our imaging
          centers
        </p>
      </div>
    </div>
  </section>

  <!-- Final CTA - Simple and Direct -->
  <section class="py-24 px-4 sm:px-6 bg-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-8"
        data-aos="fade-up"
      >
        Ready to Get Answers?
      </h2>

      <p
        class="text-xl md:text-2xl text-gray-600 mb-12"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Quality MRI scans from $260. No insurance required. Book your
        appointment in under 60 seconds.
      </p>

      <div
        class="bg-gray-50 rounded-2xl p-3 max-w-2xl mx-auto"
        data-aos="zoom-in"
        data-aos-delay="200"
      >
        <form
          class="flex flex-col sm:flex-row gap-3"
          action="/search-results"
          method="GET"
        >
          <input
            type="text"
            name="zipCode"
            placeholder="Enter your ZIP code"
            pattern="[0-9]{5}"
            maxlength="5"
            required
            class="flex-1 px-6 py-4 rounded-xl text-lg text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#003087]"
          />
          <input type="hidden" name="procedure" value="70551" />
          <input type="hidden" name="state" value="FL" />
          <input type="hidden" name="autoSearch" value="true" />
          <button
            type="submit"
            class="bg-[#003087] text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-[#002266] transition-all transform hover:scale-105"
          >
            Find Centers Near You →
          </button>
        </form>
      </div>

      <p
        class="text-sm text-gray-500 mt-8"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        Join thousands who've already saved on medical imaging
      </p>
    </div>
  </section>

  <style>
    /* Smooth animations */
    @keyframes float {
      0%,
      100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    .animate-float {
      animation: float 3s ease-in-out infinite;
    }

    /* Countdown styling */
    #countdown {
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.05em;
    }

    /* Mobile timeline adjustments */
    @media (max-width: 768px) {
      .relative.flex.items-center {
        flex-direction: column !important;
      }

      .text-right {
        text-align: left !important;
      }

      .ml-auto {
        margin-left: 0 !important;
      }

      /* Add step numbers for mobile timeline */
      .timeline-step {
        counter-increment: step;
        position: relative;
        padding-left: 60px;
        margin-bottom: 2rem;
      }

      .timeline-step::before {
        content: counter(step);
        position: absolute;
        left: 0;
        top: 0;
        width: 40px;
        height: 40px;
        background: #003087;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.25rem;
      }

      /* Reset counter at section start */
      .space-y-16 {
        counter-reset: step;
      }
    }

    /* USRad highlight styling */
    .highlight-text,
    .highlight-text-2 {
      position: relative;
      z-index: 1;
    }

    /* Bright yellow highlighter for the title */
    .highlight-text::before {
      content: "";
      position: absolute;
      left: -8px;
      right: -8px;
      top: -3px;
      bottom: -1px;
      background: linear-gradient(
        to right,
        transparent 2%,
        #ffeb3b 5%,
        #ffd700 50%,
        #ffeb3b 95%,
        transparent 98%
      );
      opacity: 0.5;
      transform: rotate(-1deg) skew(-2deg);
      z-index: -1;
      filter: blur(1px);
      border-radius: 3px 8px 4px 6px;
    }

    /* Slightly different angle for the subtitle */
    .highlight-text-2::before {
      content: "";
      position: absolute;
      left: -6px;
      right: -6px;
      top: -2px;
      bottom: -2px;
      background: linear-gradient(
        to right,
        transparent 1%,
        #ffd700 4%,
        #ffeb3b 50%,
        #ffd700 96%,
        transparent 99%
      );
      opacity: 0.45;
      transform: rotate(0.5deg) skew(1deg);
      z-index: -1;
      filter: blur(0.8px);
      border-radius: 5px 3px 7px 4px;
    }

    /* Marker texture overlay for realism */
    .highlight-text::after,
    .highlight-text-2::after {
      content: "";
      position: absolute;
      left: -8px;
      right: -8px;
      top: -3px;
      bottom: -1px;
      background-image: repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 2px,
        rgba(255, 235, 59, 0.3) 2px,
        rgba(255, 235, 59, 0.3) 3px
      );
      z-index: -1;
      mix-blend-mode: multiply;
    }

    /* Animation */
    @keyframes highlight-draw {
      from {
        transform: scaleX(0) rotate(-1deg) skew(-2deg);
        transform-origin: left center;
      }
      to {
        transform: scaleX(1) rotate(-1deg) skew(-2deg);
        transform-origin: left center;
      }
    }

    .highlight-text::before {
      animation: highlight-draw 0.6s ease-out forwards;
      animation-delay: 1.5s;
      transform: scaleX(0) rotate(-1deg) skew(-2deg);
    }

    .highlight-text-2::before {
      animation: highlight-draw 0.6s ease-out forwards;
      animation-delay: 1.7s;
      transform: scaleX(0) rotate(0.5deg) skew(1deg);
    }

    /* Hover effect */
    .flex:hover .highlight-text::before,
    .flex:hover .highlight-text-2::before {
      opacity: 0.7;
      filter: blur(0.5px) brightness(1.1);
    }

    @media (max-width: 640px) {
      .highlight-text-2 {
        display: inline-block;
        min-width: 100%;
      }

      .highlight-text-2::before {
        left: -20px;
        right: -20px;
      }
    }
  </style>

  <script>
    // Countdown from 48 hours
    function updateCountdown() {
      const element = document.getElementById("countdown");
      if (!element) return;

      let totalSeconds = 48 * 3600; // 48 hours in seconds

      const interval = setInterval(() => {
        totalSeconds--;

        if (totalSeconds <= 0) {
          // Reset to 48 hours when it reaches 0
          totalSeconds = 48 * 3600;
        }

        const hours = Math.floor(totalSeconds / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        element.textContent = `${hours}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
      }, 1000);
    }

    // Start countdown when page loads
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", updateCountdown);
    } else {
      updateCountdown();
    }

    // Hide viewer skeleton when loaded
    document.addEventListener("DOMContentLoaded", function () {
      const viewer = document.querySelector("#viewer-skeleton");
