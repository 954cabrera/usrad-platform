---
// src/pages/education/what-is-mri.astro
import MultiModalViewer from "../../components/education/MultiModalViewer.jsx";
import Layout from "../../layouts/MainLayout.astro";

const title = "What is an MRI? | USRad Medical Imaging Education";
const description =
  "Experience professional-grade medical imaging education with interactive viewers. Founded by proven leaders who built AnciCare (1994-2002), served 400K+ patients, and were acquired by CorVel Corporation (NYSE: CVL).";
---

<Layout title={title} description={description}>
  <!-- Hero Section with Enhanced Track Record -->
  <section
    class="relative overflow-hidden bg-gradient-to-br from-blue-50 via-white to-purple-50 py-20 sm:py-32"
  >
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute top-20 left-10 w-32 h-32 bg-blue-500 rounded-full blur-xl animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-20 right-10 w-48 h-48 bg-purple-500 rounded-full blur-xl animate-pulse delay-1000"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 w-24 h-24 bg-green-500 rounded-full blur-xl animate-pulse delay-500"
      >
      </div>
    </div>

    <!-- Enhanced Proven Track Record Banner -->
    <div
      class="absolute top-0 left-0 right-0 bg-gradient-to-r from-[#cc9933] to-[#003087] text-white py-2 px-4 text-center"
    >
      <p class="text-sm font-medium">
        🏆 <strong>PROVEN HEALTHCARE PIONEERS:</strong> Created first managed care
        imaging network (1994-2002) • Served 400K+ patients • $400M+ savings delivered
        • Acquired by CorVel Corporation (NYSE: CVL)
      </p>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 text-center mt-8">
      <!-- Credibility Badge -->
      <div class="mb-6">
        <span
          class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-[#003087] to-[#0052cc] text-white text-sm font-bold rounded-full shadow-lg"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          🧠 Advanced Medical Imaging Education • Proven by CorVel Acquisition
        </span>
      </div>

      <h1
        class="text-4xl sm:text-6xl font-bold bg-gradient-to-r from-gray-900 via-blue-900 to-purple-900 bg-clip-text text-transparent mb-6"
      >
        What Is an MRI?
      </h1>

      <p
        class="text-xl sm:text-2xl text-gray-600 mb-4 max-w-4xl mx-auto leading-relaxed"
      >
        Magnetic Resonance Imaging lets us see inside the human body—without a
        single incision or any radiation.
      </p>

      <p class="text-lg text-blue-700 mb-8 max-w-3xl mx-auto font-medium">
        Educational experience brought to you by the proven team that built
        AnciCare (1994-2002), delivered $400M+ in savings, and earned CorVel
        Corporation (NYSE: CVL) acquisition
      </p>

      <!-- Enhanced Stats Counter with Track Record -->
      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-5xl mx-auto mb-12"
      >
        <div
          class="bg-white/90 backdrop-blur-sm rounded-xl p-4 shadow-lg border border-green-200 hover:shadow-xl transition-shadow"
        >
          <div class="text-2xl font-bold text-green-600" data-counter="400000">
            0
          </div>
          <div class="text-sm text-gray-600 font-medium">Patients Served</div>
          <div class="text-xs text-green-600 font-semibold">
            AnciCare Legacy (1994-2002)
          </div>
        </div>
        <div
          class="bg-white/90 backdrop-blur-sm rounded-xl p-4 shadow-lg border border-blue-200 hover:shadow-xl transition-shadow"
        >
          <div class="text-2xl font-bold text-blue-600" data-counter="1200">
            0
          </div>
          <div class="text-sm text-gray-600 font-medium">Centers Built</div>
          <div class="text-xs text-blue-600 font-semibold">
            Proven Network Success
          </div>
        </div>
        <div
          class="bg-white/90 backdrop-blur-sm rounded-xl p-4 shadow-lg border border-purple-200 hover:shadow-xl transition-shadow"
        >
          <div class="text-2xl font-bold text-purple-600" data-counter="400">
            0
          </div>
          <div class="text-sm text-gray-600 font-medium">Million+ Saved</div>
          <div class="text-xs text-purple-600 font-semibold">
            Proven Cost Reduction
          </div>
        </div>
        <div
          class="bg-white/90 backdrop-blur-sm rounded-xl p-4 shadow-lg border border-orange-200 hover:shadow-xl transition-shadow"
        >
          <div class="text-2xl font-bold text-orange-600" data-counter="2002">
            0
          </div>
          <div class="text-sm text-gray-600 font-medium">
            CorVel Acquisition
          </div>
          <div class="text-xs text-orange-600 font-semibold">
            NYSE: CVL Validation
          </div>
        </div>
      </div>

      <!-- Enhanced Mission Statement -->
      <div
        class="bg-gradient-to-r from-[#003087] to-[#0052cc] rounded-2xl p-8 mb-8 text-white shadow-xl"
      >
        <h2 class="text-2xl font-bold mb-4">
          Our Mission: Affordable Imaging for 90 Million Americans
        </h2>
        <p class="text-lg opacity-90 max-w-4xl mx-auto mb-4">
          After pioneering the managed care imaging model through AnciCare
          (1994-2002) and successfully earning CorVel Corporation (NYSE: CVL)
          acquisition, we're now focused on serving the 90 million uninsured and
          underinsured Americans who deserve access to high-quality, affordable
          medical imaging.
        </p>
        <div class="grid md:grid-cols-3 gap-4 mt-6">
          <div class="bg-white/10 rounded-lg p-4">
            <div class="text-[#cc9933] font-bold text-sm">
              ⚡ PROVEN INNOVATION
            </div>
            <div class="text-blue-100 text-sm">
              Created first-ever medical imaging carve-out model
            </div>
          </div>
          <div class="bg-white/10 rounded-lg p-4">
            <div class="text-[#cc9933] font-bold text-sm">
              💰 PROVEN SAVINGS
            </div>
            <div class="text-blue-100 text-sm">
              $400M+ delivered, 50%+ cost reductions achieved
            </div>
          </div>
          <div class="bg-white/10 rounded-lg p-4">
            <div class="text-[#cc9933] font-bold text-sm">
              🏆 PROVEN SUCCESS
            </div>
            <div class="text-blue-100 text-sm">
              CorVel acquisition validates our model excellence
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <button
          onclick="document.getElementById('viewer-section').scrollIntoView({behavior: 'smooth'})"
          class="px-8 py-3 bg-[#003087] hover:bg-[#002266] text-white font-semibold rounded-xl shadow-lg transition-all transform hover:scale-105 hover:shadow-xl"
        >
          Explore Interactive Viewer
        </button>
        <button
          onclick="document.getElementById('scheduling-widget').style.display = 'block'"
          class="px-8 py-3 bg-[#cc9933] hover:bg-[#b8851f] text-[#003087] font-semibold rounded-xl shadow-lg transition-all transform hover:scale-105 hover:shadow-xl"
        >
          Schedule Your Scan
        </button>
      </div>

      <div class="mt-6 text-sm text-gray-600">
        Join 400,000+ patients who've trusted our proven approach to medical
        imaging
      </div>
    </div>
  </section>

  <!-- Enhanced Proven Track Record Section -->
  <section
    class="bg-gradient-to-r from-gray-900 to-blue-900 text-white py-20 px-6"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          Built by Healthcare Revolution Pioneers
        </h2>
        <p class="text-xl text-blue-100 max-w-4xl mx-auto">
          USRad is led by the visionary team that created the first-ever managed
          care imaging model through AnciCare (1994-2002), revolutionizing
          healthcare efficiency and affordability before successfully being
          acquired by CorVel Corporation (NYSE: CVL).
        </p>
        <div class="mt-4">
          <span
            class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-6 py-3"
          >
            <svg
              class="w-5 h-5 text-[#cc9933]"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-sm font-semibold"
              >Model so successful, CorVel still operates it 20+ years later</span
            >
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <div
          class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center hover:bg-white/15 transition-all"
        >
          <div class="text-4xl font-bold text-green-400 mb-2">1,200</div>
          <div class="text-lg font-semibold mb-2">Imaging Centers</div>
          <p class="text-blue-100 text-sm">
            Built nationwide network from scratch through AnciCare
          </p>
        </div>

        <div
          class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center hover:bg-white/15 transition-all"
        >
          <div class="text-4xl font-bold text-blue-400 mb-2">400K+</div>
          <div class="text-lg font-semibold mb-2">Patients Served</div>
          <p class="text-blue-100 text-sm">
            Proven track record of quality care (1994-2002)
          </p>
        </div>

        <div
          class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center hover:bg-white/15 transition-all"
        >
          <div class="text-4xl font-bold text-purple-400 mb-2">$400M+</div>
          <div class="text-lg font-semibold mb-2">Savings Delivered</div>
          <p class="text-blue-100 text-sm">
            Total cost reduction achieved for clients
          </p>
        </div>
      </div>

      <div
        class="bg-white/5 backdrop-blur-sm rounded-2xl p-8 border border-white/10"
      >
        <h3 class="text-2xl font-bold mb-6 text-center">
          The AnciCare → CorVel Success Story
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold"
              >
                1
              </div>
              <div>
                <h4 class="font-semibold text-green-300">
                  Pioneered New Model (1994)
                </h4>
                <p class="text-blue-100 text-sm">
                  Created first-ever managed care imaging carve-out
                  revolutionizing healthcare efficiency
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold"
              >
                2
              </div>
              <div>
                <h4 class="font-semibold text-blue-300">
                  Revolutionary Results (1994-2002)
                </h4>
                <p class="text-blue-100 text-sm">
                  $400M+ total savings with 50%+ cost reductions and 2-3 day
                  appointment access
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold"
              >
                3
              </div>
              <div>
                <h4 class="font-semibold text-purple-300">
                  Quality Guarantee Innovation
                </h4>
                <p class="text-blue-100 text-sm">
                  First-ever service guarantee with peer-to-peer resolution or
                  free re-imaging
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 bg-orange-500 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold"
              >
                4
              </div>
              <div>
                <h4 class="font-semibold text-orange-300">
                  CorVel Acquisition (2002)
                </h4>
                <p class="text-blue-100 text-sm">
                  NYSE-listed company validated our model with acquisition •
                  Still operating 20+ years later
                </p>
              </div>
            </div>
          </div>

          <div class="text-center">
            <div
              class="bg-gradient-to-br from-[#cc9933] to-[#003087] rounded-2xl p-6 text-white"
            >
              <h4 class="text-xl font-bold mb-2">Now Innovating For</h4>
              <div class="text-3xl font-bold mb-2">90 Million</div>
              <p class="text-sm opacity-90 mb-3">
                Uninsured & Underinsured Americans
              </p>
              <div class="bg-white/20 rounded-lg p-3 text-xs">
                <strong>Same Proven Innovation:</strong> Fast access + Quality care
                + Affordable pricing
              </div>
              <div class="mt-3 text-xs text-blue-200">
                ✅ Validated by CorVel Corporation (NYSE: CVL) acquisition
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Enhanced How It Works with Experience Context -->
  <section class="bg-white py-20 px-6 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          How MRI Works
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto mb-4">
          Understanding the technology behind the most advanced medical imaging
          available today
        </p>
        <div
          class="inline-flex items-center gap-2 bg-blue-50 rounded-full px-6 py-3"
        >
          <svg
            class="w-5 h-5 text-blue-600"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-blue-700 font-semibold text-sm"
            >Explained by the team that's overseen 400,000+ MRI scans through
            AnciCare</span
          >
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0"
            >
              <span class="text-2xl">🧲</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Powerful Magnetic Field
              </h3>
              <p class="text-gray-600">
                Our MRI machines use magnetic fields 30,000 times stronger than
                Earth's magnetic field to align your body's hydrogen atoms. No
                radiation exposure—completely safe.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0"
            >
              <span class="text-2xl">📡</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Radio Wave Signals
              </h3>
              <p class="text-gray-600">
                Safe radio waves create detailed images of your organs and
                tissues without any radiation exposure. The same technology our
                AnciCare network used successfully for 8 years.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center flex-shrink-0"
            >
              <span class="text-2xl">🖥️</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Expert Interpretation
              </h3>
              <p class="text-gray-600">
                Our board-certified radiologists—with proven experience from
                AnciCare's 400,000+ scans—provide accurate diagnoses you can
                trust. The same quality standards that earned CorVel
                Corporation's acquisition.
              </p>
            </div>
          </div>

          <!-- Enhanced Experience Highlight -->
          <div
            class="bg-gradient-to-r from-blue-50 to-green-50 border border-blue-200 rounded-lg p-6"
          >
            <h4
              class="font-semibold text-[#003087] mb-3 flex items-center gap-2"
            >
              <span class="text-[#cc9933]">⭐</span> AnciCare Proven Excellence
            </h4>
            <p class="text-gray-700 mb-3">
              "Our leadership team personally overseen the quality and accuracy
              of hundreds of thousands of MRI scans through AnciCare
              (1994-2002), ensuring every patient receives the highest standard
              of care."
            </p>
            <div class="grid md:grid-cols-2 gap-4 text-sm">
              <div class="bg-white rounded p-3">
                <div class="text-blue-600 font-semibold">400,000+ Scans</div>
                <div class="text-gray-600">Successfully completed</div>
              </div>
              <div class="bg-white rounded p-3">
                <div class="text-green-600 font-semibold">CorVel Acquired</div>
                <div class="text-gray-600">Validated our quality</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Interactive MRI Machine Visualization -->
        <div class="relative">
          <div
            class="bg-gradient-to-br from-gray-100 to-gray-200 rounded-2xl p-8 shadow-xl"
          >
            <div class="relative">
              <!-- Simplified MRI Machine SVG -->
              <svg viewBox="0 0 400 300" class="w-full h-auto">
                <!-- MRI Machine Body -->
                <rect
                  x="50"
                  y="100"
                  width="300"
                  height="120"
                  rx="15"
                  fill="#4F46E5"
                  stroke="#3730A3"
                  stroke-width="2"></rect>
                <!-- Patient Table -->
                <rect
                  x="20"
                  y="140"
                  width="360"
                  height="40"
                  rx="5"
                  fill="#E5E7EB"
                  stroke="#9CA3AF"
                  stroke-width="1"></rect>
                <!-- Magnetic Field Lines -->
                <g class="animate-pulse">
                  <ellipse
                    cx="200"
                    cy="160"
                    rx="180"
                    ry="80"
                    fill="none"
                    stroke="#60A5FA"
                    stroke-width="2"
                    opacity="0.6"></ellipse>
                  <ellipse
                    cx="200"
                    cy="160"
                    rx="150"
                    ry="60"
                    fill="none"
                    stroke="#60A5FA"
                    stroke-width="2"
                    opacity="0.4"></ellipse>
                  <ellipse
                    cx="200"
                    cy="160"
                    rx="120"
                    ry="40"
                    fill="none"
                    stroke="#60A5FA"
                    stroke-width="2"
                    opacity="0.2"></ellipse>
                </g>
                <!-- Control Panel -->
                <rect
                  x="320"
                  y="80"
                  width="60"
                  height="80"
                  rx="8"
                  fill="#1F2937"></rect>
                <circle cx="340" cy="100" r="5" fill="#10B981"></circle>
                <circle cx="360" cy="100" r="5" fill="#F59E0B"></circle>
                <rect
                  x="330"
                  y="120"
                  width="40"
                  height="20"
                  rx="2"
                  fill="#374151"></rect>
              </svg>
            </div>
            <div class="text-center mt-4 text-sm text-gray-600">
              <strong>Professional-grade equipment</strong> - Same technology used
              in AnciCare's proven network
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Enhanced Multi-Modal Interactive Viewer Section -->
  <section
    id="viewer-section"
    class="bg-gradient-to-br from-gray-50 to-blue-50 py-20 px-6"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          Interactive Medical Imaging Hub
        </h2>
        <p class="text-lg text-gray-600 max-w-4xl mx-auto mb-4">
          Experience professional-grade medical imaging viewers for MRI, CT,
          Ultrasound, and PET scans. Explore real anatomical structures with
          advanced controls used by radiologists.
        </p>
        <div
          class="inline-flex items-center gap-2 bg-gradient-to-r from-[#003087] to-[#0052cc] text-white rounded-full px-6 py-3"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="font-semibold text-sm"
            >Educational tools developed by the team that built AnciCare's
            imaging network</span
          >
        </div>

        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <span
            class="px-4 py-2 bg-blue-100 text-blue-800 rounded-full text-sm font-medium"
            >No Radiation</span
          >
          <span
            class="px-4 py-2 bg-green-100 text-green-800 rounded-full text-sm font-medium"
            >400K+ Scans Experience</span
          >
          <span
            class="px-4 py-2 bg-purple-100 text-purple-800 rounded-full text-sm font-medium"
            >CorVel Acquisition Validated</span
          >
          <span
            class="px-4 py-2 bg-orange-100 text-orange-800 rounded-full text-sm font-medium"
            >From $260</span
          >
        </div>
      </div>

      <!-- The Enhanced Multi-Modal Viewer -->
      <MultiModalViewer client:load />

      <!-- Enhanced Educational Benefits -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div
          class="text-center bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-blue-100 to-blue-200 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">🏆</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            AnciCare Proven Track Record
          </h3>
          <p class="text-gray-600 mb-3">
            400,000+ successful scans completed through our proven network model
            (1994-2002)
          </p>
          <div class="text-xs text-blue-600 bg-blue-50 rounded px-3 py-1">
            CorVel Corporation acquisition validation
          </div>
        </div>

        <div
          class="text-center bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-green-100 to-green-200 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">⚡</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Rapid Results
          </h3>
          <p class="text-gray-600 mb-3">
            2-3 day appointments - efficiency model perfected through AnciCare
            (1994-2002)
          </p>
          <div class="text-xs text-green-600 bg-green-50 rounded px-3 py-1">
            Same model CorVel still operates 20+ years later
          </div>
        </div>

        <div
          class="text-center bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow"
