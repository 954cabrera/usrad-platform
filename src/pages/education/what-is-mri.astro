---
// src/pages/education/what-is-mri.astro
import MultiModalViewer from "../../components/education/MultiModalViewer.jsx";
import Layout from "../../layouts/MainLayout.astro";

const title = "What is an MRI? | USRad Medical Imaging";
const description =
  "Experience professional-grade medical imaging education with interactive viewers. Founded by proven leaders who built and sold a nationwide imaging network.";
---

<Layout title={title} description={description}>
  <!-- Hero Section with Track Record -->
  <section
    class="relative overflow-hidden bg-gradient-to-br from-blue-50 via-white to-purple-50 py-20 sm:py-32"
  >
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute top-20 left-10 w-32 h-32 bg-blue-500 rounded-full blur-xl animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-20 right-10 w-48 h-48 bg-purple-500 rounded-full blur-xl animate-pulse delay-1000"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 w-24 h-24 bg-green-500 rounded-full blur-xl animate-pulse delay-500"
      >
      </div>
    </div>

    <!-- Proven Track Record Banner -->
    <div
      class="absolute top-0 left-0 right-0 bg-gradient-to-r from-green-600 to-blue-600 text-white py-2 px-4 text-center"
    >
      <p class="text-sm font-medium">
        🚀 <strong>Industry Pioneers:</strong> Created the first managed care imaging
        network - revolutionizing healthcare efficiency
      </p>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 text-center mt-8">
      <div class="mb-6">
        <span
          class="inline-block px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-full shadow-lg"
        >
          🧠 Advanced Medical Imaging Education
        </span>
      </div>

      <h1
        class="text-4xl sm:text-6xl font-bold bg-gradient-to-r from-gray-900 via-blue-900 to-purple-900 bg-clip-text text-transparent mb-6"
      >
        What Is an MRI?
      </h1>

      <p
        class="text-xl sm:text-2xl text-gray-600 mb-4 max-w-4xl mx-auto leading-relaxed"
      >
        Magnetic Resonance Imaging lets us see inside the human body—without a
        single incision or any radiation.
      </p>

      <p class="text-lg text-blue-700 mb-8 max-w-3xl mx-auto font-medium">
        Brought to you by the proven team that built America's largest workers'
        comp imaging network
      </p>

      <!-- Enhanced Stats Counter with Track Record -->
      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-5xl mx-auto mb-12"
      >
        <div
          class="bg-white/90 backdrop-blur-sm rounded-xl p-4 shadow-lg border border-green-200"
        >
          <div class="text-2xl font-bold text-green-600" data-counter="400000">
            0
          </div>
          <div class="text-sm text-gray-600">Patients Served</div>
          <div class="text-xs text-green-600 font-medium">AnciCare Legacy</div>
        </div>
        <div
          class="bg-white/90 backdrop-blur-sm rounded-xl p-4 shadow-lg border border-blue-200"
        >
          <div class="text-2xl font-bold text-blue-600" data-counter="1200">
            0
          </div>
          <div class="text-sm text-gray-600">Centers Built</div>
          <div class="text-xs text-blue-600 font-medium">Proven Network</div>
        </div>
        <div
          class="bg-white/90 backdrop-blur-sm rounded-xl p-4 shadow-lg border border-purple-200"
        >
          <div class="text-2xl font-bold text-purple-600" data-counter="3000">
            0
          </div>
          <div class="text-sm text-gray-600">Radiologists</div>
          <div class="text-xs text-purple-600 font-medium">Board Certified</div>
        </div>
        <div
          class="bg-white/90 backdrop-blur-sm rounded-xl p-4 shadow-lg border border-orange-200"
        >
          <div class="text-2xl font-bold text-orange-600" data-counter="10">
            0
          </div>
          <div class="text-sm text-gray-600">Years Experience</div>
          <div class="text-xs text-orange-600 font-medium">Successful Exit</div>
        </div>
      </div>

      <!-- Mission Statement -->
      <div
        class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-2xl p-8 mb-8 text-white"
      >
        <h2 class="text-2xl font-bold mb-4">
          Our Mission: Affordable Imaging for 90 Million Americans
        </h2>
        <p class="text-lg opacity-90 max-w-4xl mx-auto mb-4">
          After pioneering the managed care imaging model and successfully
          building AnciCare, we're now focused on serving the 90 million
          uninsured and underinsured Americans who deserve access to
          high-quality, affordable medical imaging.
        </p>
        <p class="text-blue-100 text-sm">
          ⚡ <strong>Proven Innovation:</strong> Created the first-ever medical imaging
          carve-out model, achieving 50%+ cost savings while improving appointment
          access to 2-3 days
        </p>
      </div>

      <!-- Quick Actions -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <button
          onclick="document.getElementById('viewer-section').scrollIntoView({behavior: 'smooth'})"
          class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-lg transition-all transform hover:scale-105 hover:shadow-xl"
        >
          Explore Interactive Viewer
        </button>
        <button
          onclick="document.getElementById('scheduling-widget').style.display = 'block'"
          class="px-8 py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-xl shadow-lg transition-all transform hover:scale-105 hover:shadow-xl"
        >
          Schedule Your Scan
        </button>
      </div>
    </div>
  </section>

  <!-- Proven Track Record Section -->
  <section
    class="bg-gradient-to-r from-gray-900 to-blue-900 text-white py-20 px-6"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          Built by Industry Pioneers
        </h2>
        <p class="text-xl text-blue-100 max-w-3xl mx-auto">
          USRad is led by the visionary team that created the first-ever managed
          care imaging model, revolutionizing healthcare efficiency and
          affordability before successfully exiting to a public company.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center">
          <div class="text-4xl font-bold text-green-400 mb-2">1,200</div>
          <div class="text-lg font-semibold mb-2">Imaging Centers</div>
          <p class="text-blue-100 text-sm">
            Built nationwide network from scratch
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center">
          <div class="text-4xl font-bold text-blue-400 mb-2">400K+</div>
          <div class="text-lg font-semibold mb-2">Patients Served</div>
          <p class="text-blue-100 text-sm">
            Proven track record of quality care
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 text-center">
          <div class="text-4xl font-bold text-purple-400 mb-2">10</div>
          <div class="text-lg font-semibold mb-2">Years Success</div>
          <p class="text-blue-100 text-sm">Successful exit to public company</p>
        </div>
      </div>

      <div
        class="bg-white/5 backdrop-blur-sm rounded-2xl p-8 border border-white/10"
      >
        <h3 class="text-2xl font-bold mb-4 text-center">
          The AnciCare Innovation Story
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold"
              >
                1
              </div>
              <div>
                <h4 class="font-semibold text-green-300">
                  Pioneered New Model
                </h4>
                <p class="text-blue-100 text-sm">
                  Created first-ever managed care imaging carve-out
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold"
              >
                2
              </div>
              <div>
                <h4 class="font-semibold text-blue-300">
                  Revolutionary Results
                </h4>
                <p class="text-blue-100 text-sm">
                  50%+ cost savings with 2-3 day appointment access
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold"
              >
                3
              </div>
              <div>
                <h4 class="font-semibold text-purple-300">Quality Guarantee</h4>
                <p class="text-blue-100 text-sm">
                  First-ever service guarantee with peer-to-peer resolution or
                  free re-imaging
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 bg-orange-500 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold"
              >
                4
              </div>
              <div>
                <h4 class="font-semibold text-orange-300">Successful Exit</h4>
                <p class="text-blue-100 text-sm">
                  Validated model with acquisition by public company
                </p>
              </div>
            </div>
          </div>

          <div class="text-center">
            <div
              class="bg-gradient-to-br from-green-500 to-blue-500 rounded-2xl p-6 text-white"
            >
              <h4 class="text-xl font-bold mb-2">Now Innovating For</h4>
              <div class="text-3xl font-bold mb-2">90 Million</div>
              <p class="text-sm opacity-90 mb-3">
                Uninsured & Underinsured Americans
              </p>
              <div class="bg-white/20 rounded-lg p-3 text-xs">
                <strong>Same Innovation:</strong> Fast access + Quality care + Affordable
                pricing
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works with Experience Context -->
  <section class="bg-white py-20 px-6 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          How MRI Works
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto mb-4">
          Understanding the technology behind the most advanced medical imaging
          available today
        </p>
        <p class="text-blue-600 font-medium">
          Explained by the team that's overseen 400,000+ MRI scans
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0"
            >
              <span class="text-2xl">🧲</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Powerful Magnetic Field
              </h3>
              <p class="text-gray-600">
                Our MRI machines use magnetic fields 30,000 times stronger than
                Earth's magnetic field to align your body's hydrogen atoms.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0"
            >
              <span class="text-2xl">📡</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Radio Wave Signals
              </h3>
              <p class="text-gray-600">
                Safe radio waves create detailed images of your organs and
                tissues without any radiation exposure.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center flex-shrink-0"
            >
              <span class="text-2xl">🖥️</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-gray-900 mb-2">
                Expert Interpretation
              </h3>
              <p class="text-gray-600">
                Our board-certified radiologists—with experience from 400,000+
                scans—provide accurate diagnoses you can trust.
              </p>
            </div>
          </div>

          <!-- Experience Highlight -->
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <h4 class="font-semibold text-blue-900 mb-2">
              ⭐ Proven Excellence
            </h4>
            <p class="text-blue-700 text-sm">
              "Our leadership team has personally overseen the quality and
              accuracy of hundreds of thousands of MRI scans, ensuring every
              patient receives the highest standard of care."
            </p>
          </div>
        </div>

        <!-- Interactive MRI Machine Visualization -->
        <div class="relative">
          <div
            class="bg-gradient-to-br from-gray-100 to-gray-200 rounded-2xl p-8 shadow-xl"
          >
            <div class="relative">
              <!-- Simplified MRI Machine SVG -->
              <svg viewBox="0 0 400 300" class="w-full h-auto">
                <!-- MRI Machine Body -->
                <rect
                  x="50"
                  y="100"
                  width="300"
                  height="120"
                  rx="15"
                  fill="#4F46E5"
                  stroke="#3730A3"
                  stroke-width="2"></rect>
                <!-- Patient Table -->
                <rect
                  x="20"
                  y="140"
                  width="360"
                  height="40"
                  rx="5"
                  fill="#E5E7EB"
                  stroke="#9CA3AF"
                  stroke-width="1"></rect>
                <!-- Magnetic Field Lines -->
                <g class="animate-pulse">
                  <ellipse
                    cx="200"
                    cy="160"
                    rx="180"
                    ry="80"
                    fill="none"
                    stroke="#60A5FA"
                    stroke-width="2"
                    opacity="0.6"></ellipse>
                  <ellipse
                    cx="200"
                    cy="160"
                    rx="150"
                    ry="60"
                    fill="none"
                    stroke="#60A5FA"
                    stroke-width="2"
                    opacity="0.4"></ellipse>
                  <ellipse
                    cx="200"
                    cy="160"
                    rx="120"
                    ry="40"
                    fill="none"
                    stroke="#60A5FA"
                    stroke-width="2"
                    opacity="0.2"></ellipse>
                </g>
                <!-- Control Panel -->
                <rect
                  x="320"
                  y="80"
                  width="60"
                  height="80"
                  rx="8"
                  fill="#1F2937"></rect>
                <circle cx="340" cy="100" r="5" fill="#10B981"></circle>
                <circle cx="360" cy="100" r="5" fill="#F59E0B"></circle>
                <rect
                  x="330"
                  y="120"
                  width="40"
                  height="20"
                  rx="2"
                  fill="#374151"></rect>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Multi-Modal Interactive Viewer Section -->
  <section
    id="viewer-section"
    class="bg-gradient-to-br from-gray-50 to-blue-50 py-20 px-6"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          Interactive Medical Imaging Hub
        </h2>
        <p class="text-lg text-gray-600 max-w-4xl mx-auto mb-4">
          Experience professional-grade medical imaging viewers for MRI, CT,
          Ultrasound, and PET scans. Explore real anatomical structures with
          advanced controls used by radiologists.
        </p>
        <p class="text-blue-600 font-medium">
          Educational tools developed by the team that built AnciCare's imaging
          network
        </p>

        <div class="mt-6 flex flex-wrap justify-center gap-2">
          <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm"
            >No Radiation</span
          >
          <span
            class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm"
            >400K+ Scans Experience</span
          >
          <span
            class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm"
            >Board-Certified Team</span
          >
          <span
            class="px-3 py-1 bg-orange-100 text-orange-800 rounded-full text-sm"
            >From $260</span
          >
        </div>
      </div>

      <!-- The Enhanced Multi-Modal Viewer -->
      <MultiModalViewer client:load />

      <!-- Enhanced Educational Benefits -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div
            class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">🏆</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Proven Track Record
          </h3>
          <p class="text-gray-600">
            400,000+ successful scans with AnciCare's network of expert
            radiologists
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">⚡</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Rapid Results
          </h3>
          <p class="text-gray-600">
            2-3 day appointments - efficiency model perfected over 10 years
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">💰</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Affordable Access
          </h3>
          <p class="text-gray-600">
            Mission-driven pricing to serve 90 million uninsured Americans
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Smart Scheduling Widget -->
  <div
    id="scheduling-widget"
    style="display: none;"
    class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
  >
    <div class="bg-white rounded-2xl p-8 max-w-md w-full shadow-2xl">
      <div class="text-center mb-6">
        <h3 class="text-2xl font-bold text-gray-900 mb-2">Schedule Your MRI</h3>
        <p class="text-gray-600">
          Join 400,000+ patients who've trusted our network
        </p>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2"
            >ZIP Code</label
          >
          <input
            type="text"
            placeholder="Enter your ZIP code"
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2"
            >Scan Type</label
          >
          <select
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          >
            <option>MRI Brain</option>
            <option>MRI Spine</option>
            <option>MRI Joint</option>
            <option>MRI Abdomen</option>
            <option>Other</option>
          </select>
        </div>

        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
          <div class="flex items-center gap-2">
            <span class="text-green-600">✓</span>
            <span class="text-green-800 font-medium"
              >Proven network quality</span
            >
          </div>
          <p class="text-green-600 text-sm mt-1">
            400,000+ successful scans completed
          </p>
        </div>

        <div class="flex gap-3">
          <button
            onclick="document.getElementById('scheduling-widget').style.display = 'none'"
            class="flex-1 px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors"
          >
            Cancel
          </button>
          <button
            class="flex-1 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            Book Now
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- USRad vs Others Comparison -->
  <section class="bg-white py-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          Why USRad Is Different
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          We're not just another imaging company—we're the proven team behind
          AnciCare's success, now focused on serving everyday Americans.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center group">
          <div
            class="w-20 h-20 bg-gradient-to-br from-blue-100 to-blue-200 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform"
          >
            <span class="text-3xl">🏆</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Proven Leadership
          </h3>
          <p class="text-gray-600">
            Built, scaled, and successfully sold AnciCare after 10 years
          </p>
        </div>

        <div class="text-center group">
          <div
            class="w-20 h-20 bg-gradient-to-br from-green-100 to-green-200 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform"
          >
            <span class="text-3xl">💰</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Mission-Driven Pricing
          </h3>
          <p class="text-gray-600">
            From $260 to serve 90 million uninsured Americans
          </p>
        </div>

        <div class="text-center group">
          <div
            class="w-20 h-20 bg-gradient-to-br from-purple-100 to-purple-200 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform"
          >
            <span class="text-3xl">👨‍⚕️</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Expert Network
          </h3>
          <p class="text-gray-600">
            3,000+ radiologists with 400,000+ scan experience
          </p>
        </div>

        <div class="text-center group">
          <div
            class="w-20 h-20 bg-gradient-to-br from-orange-100 to-orange-200 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform"
          >
            <span class="text-3xl">🎯</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Market Focus</h3>
          <p class="text-gray-600">
            Dedicated to underserved patient populations
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA with Track Record -->
  <section
    class="bg-gradient-to-r from-blue-900 via-purple-900 to-blue-900 text-white py-20 px-6"
  >
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        Ready to Experience Proven Excellence?
      </h2>
      <p class="text-xl mb-4 opacity-90">
        Join the 400,000+ patients who've trusted our network for high-quality,
        affordable imaging
      </p>
      <p class="text-lg mb-8 text-blue-200">
        Now serving the 90 million uninsured and underinsured Americans who
        deserve better healthcare access
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <button
          onclick="document.getElementById('scheduling-widget').style.display = 'block'"
