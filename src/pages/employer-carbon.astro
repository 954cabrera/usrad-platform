---
import MainLayout from "../layouts/MainLayout.astro";
import HeroEmployer from "../components/employer/HeroEmployer.astro";
---

<MainLayout>
  <!-- Enhanced Hero Section - Unicorn Style -->
  <section
    class="relative min-h-[90vh] overflow-hidden bg-gradient-to-br from-[#0a0e27] via-[#0f1629] to-[#003087]"
  >
    <!-- Animated Background -->
    <div class="absolute inset-0">
      <!-- Gradient Orbs -->
      <div
        class="absolute top-20 left-10 w-96 h-96 bg-[#cc9933] rounded-full filter blur-[128px] opacity-20 animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-20 right-10 w-96 h-96 bg-[#4A90E2] rounded-full filter blur-[128px] opacity-20 animate-pulse"
      >
      </div>

      <!-- Grid Pattern -->
      <div class="absolute inset-0 opacity-10">
        <div
          class="absolute inset-0"
          style="background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.15) 1px, transparent 1px); background-size: 40px 40px;"
        >
        </div>
      </div>
    </div>

    <!-- Hero Content -->
    <div
      class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-20"
    >
      <!-- Trust Badge -->
      <div class="flex justify-center mb-8" data-aos="fade-down">
        <div
          class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-md rounded-full px-6 py-3 border border-white/20"
        >
          <div class="relative">
            <span
              class="absolute inline-flex h-3 w-3 rounded-full bg-[#cc9933] opacity-75 animate-ping"
            ></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-[#cc9933]"
            ></span>
          </div>
          <span class="text-white text-sm font-medium"
            >PROVEN IMAGING CARVE-OUT PIONEERS • EST. 1994</span
          >
        </div>
      </div>

      <!-- Main Heading -->
      <div class="text-center">
        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-8 leading-tight"
          data-aos="fade-up"
        >
          The Team That Saved<br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] via-[#FFA500] to-[#cc9933] animate-gradient"
          >
            $400 Million+
          </span><br />
          Is Back
        </h1>

        <p
          class="text-xl md:text-2xl text-gray-300 max-w-4xl mx-auto mb-12 leading-relaxed"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          We built the first managed care imaging carve-out (1994-2002),
          delivered proven savings to Fortune 500 companies, and achieved a
          successful exit. Now we're revolutionizing diagnostic imaging for <strong
            class="text-white">all employers</strong
          >.
        </p>

        <!-- Proof Points -->
        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto mb-12"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div
            class="bg-white/10 backdrop-blur-md rounded-xl p-6 border border-white/10"
          >
            <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
              400K+
            </div>
            <div class="text-sm text-gray-300">Claims Processed</div>
            <div class="text-xs text-[#4A90E2] mt-1">1994-2002</div>
          </div>
          <div
            class="bg-white/10 backdrop-blur-md rounded-xl p-6 border border-white/10"
          >
            <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
              $400M+
            </div>
            <div class="text-sm text-gray-300">Total Savings</div>
            <div class="text-xs text-green-400 mt-1">Verified Results</div>
          </div>
          <div
            class="bg-white/10 backdrop-blur-md rounded-xl p-6 border border-white/10"
          >
            <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
              50%+
            </div>
            <div class="text-sm text-gray-300">Cost Reduction</div>
            <div class="text-xs text-orange-400 mt-1">vs Hospital Rates</div>
          </div>
          <div
            class="bg-white/10 backdrop-blur-md rounded-xl p-6 border border-white/10"
          >
            <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
              NYSE
            </div>
            <div class="text-sm text-gray-300">Listed Exit</div>
            <div class="text-xs text-purple-400 mt-1">2002 Success</div>
          </div>
        </div>

        <!-- CTAs -->
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <a
            href="/employer/schedule"
            class="bg-gradient-to-r from-[#cc9933] to-[#FFA500] text-[#003087] px-8 py-4 rounded-lg font-bold hover:shadow-2xl hover:shadow-[#cc9933]/25 transition-all transform hover:scale-105 inline-flex items-center gap-2"
          >
            Schedule a Reunion Call
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href="#proven-impact"
            class="border-2 border-white/30 text-white px-8 py-4 rounded-lg font-bold hover:bg-white/10 hover:border-white/50 transition-all inline-flex items-center gap-2"
          >
            See Our Proven Impact
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Floating Elements -->
    <div
      class="absolute bottom-10 left-10 text-white/60 text-sm hidden lg:block"
    >
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        Same team that revolutionized workers' comp imaging
      </div>
    </div>
  </section>

  <!-- Proven Impact Timeline -->
  <section
    id="proven-impact"
    class="py-24 bg-gradient-to-b from-[#fcf9f0] to-white"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-[#003087] mb-6">
          Our Proven Track Record
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          From conference floors to Fortune 500 boardrooms, we've been
          transforming diagnostic imaging for decades
        </p>
      </div>

      <!-- Interactive Timeline -->
      <div class="relative">
        <!-- Timeline Line -->
        <div
          class="absolute left-1/2 transform -translate-x-1/2 w-1 h-full bg-gradient-to-b from-[#cc9933] to-[#003087] hidden md:block"
        >
        </div>

        <!-- Timeline Events -->
        <div class="space-y-12">
          <!-- 1994 -->
          <div
            class="relative flex items-center justify-between md:justify-start gap-8"
            data-aos="fade-right"
          >
            <div class="md:w-1/2 md:text-right md:pr-8">
              <div
                class="bg-white rounded-xl shadow-xl p-6 border-l-4 border-[#cc9933]"
              >
                <div class="text-3xl font-bold text-[#cc9933] mb-2">1994</div>
                <h3 class="text-xl font-bold text-[#003087] mb-2">
                  Revolutionary Beginning
                </h3>
                <p class="text-gray-600">
                  Created the first-ever managed care imaging carve-out model,
                  transforming how Fortune 500 companies manage diagnostic
                  costs.
                </p>
              </div>
            </div>
            <div
              class="absolute left-1/2 transform -translate-x-1/2 w-8 h-8 bg-[#cc9933] rounded-full border-4 border-white shadow-lg hidden md:block"
            >
            </div>
            <div class="md:w-1/2"></div>
          </div>

          <!-- 1996 -->
          <div
            class="relative flex items-center justify-between md:justify-end gap-8"
            data-aos="fade-left"
          >
            <div class="md:w-1/2"></div>
            <div
              class="absolute left-1/2 transform -translate-x-1/2 w-8 h-8 bg-[#4A90E2] rounded-full border-4 border-white shadow-lg hidden md:block"
            >
            </div>
            <div class="md:w-1/2 md:pl-8">
              <div
                class="bg-white rounded-xl shadow-xl p-6 border-r-4 border-[#4A90E2]"
              >
                <div class="text-3xl font-bold text-[#4A90E2] mb-2">1996</div>
                <h3 class="text-xl font-bold text-[#003087] mb-2">
                  Nationwide Expansion
                </h3>
                <p class="text-gray-600">
                  Built network to 600+ imaging centers, establishing 2-3 day
                  appointment access vs. industry standard 10-14 days.
                </p>
              </div>
            </div>
          </div>

          <!-- 1999 -->
          <div
            class="relative flex items-center justify-between md:justify-start gap-8"
            data-aos="fade-right"
          >
            <div class="md:w-1/2 md:text-right md:pr-8">
              <div
                class="bg-white rounded-xl shadow-xl p-6 border-l-4 border-[#cc9933]"
              >
                <div class="text-3xl font-bold text-[#cc9933] mb-2">1999</div>
                <h3 class="text-xl font-bold text-[#003087] mb-2">
                  Proven Scale
                </h3>
                <p class="text-gray-600">
                  Reached 1,200+ imaging centers, 400,000+ claims processed,
                  delivering $400M+ in total value to clients.
                </p>
              </div>
            </div>
            <div
              class="absolute left-1/2 transform -translate-x-1/2 w-8 h-8 bg-[#cc9933] rounded-full border-4 border-white shadow-lg hidden md:block"
            >
            </div>
            <div class="md:w-1/2"></div>
          </div>

          <!-- 2002 -->
          <div
            class="relative flex items-center justify-between md:justify-end gap-8"
            data-aos="fade-left"
          >
            <div class="md:w-1/2"></div>
            <div
              class="absolute left-1/2 transform -translate-x-1/2 w-8 h-8 bg-green-500 rounded-full border-4 border-white shadow-lg hidden md:block"
            >
            </div>
            <div class="md:w-1/2 md:pl-8">
              <div
                class="bg-white rounded-xl shadow-xl p-6 border-r-4 border-green-500"
              >
                <div class="text-3xl font-bold text-green-500 mb-2">2002</div>
                <h3 class="text-xl font-bold text-[#003087] mb-2">
                  Successful Exit
                </h3>
                <p class="text-gray-600">
                  Acquired by CorVel Corporation (NYSE: CRVL). Our model still
                  operates today—the ultimate validation.
                </p>
              </div>
            </div>
          </div>

          <!-- 2024 -->
          <div
            class="relative flex items-center justify-between md:justify-start gap-8"
            data-aos="fade-right"
          >
            <div class="md:w-1/2 md:text-right md:pr-8">
              <div
                class="bg-gradient-to-r from-[#cc9933] to-[#FFA500] text-white rounded-xl shadow-xl p-6"
              >
                <div class="text-3xl font-bold mb-2">2024</div>
                <h3 class="text-xl font-bold mb-2">The Next Chapter</h3>
                <p>
                  Same team, proven approach, now expanded beyond workers' comp
                  to serve ALL employers with transparent, accessible imaging.
                </p>
              </div>
            </div>
            <div
              class="absolute left-1/2 transform -translate-x-1/2 w-8 h-8 bg-gradient-to-r from-[#cc9933] to-[#FFA500] rounded-full border-4 border-white shadow-lg hidden md:block animate-pulse"
            >
            </div>
            <div class="md:w-1/2"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Modern Solutions Section -->
  <section
    class="py-24 bg-gradient-to-br from-[#003087] to-[#0052cc] text-white"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          How USRad Transforms Your Benefits
        </h2>
        <p class="text-xl text-blue-100 max-w-3xl mx-auto">
          The same revolutionary approach that saved Fortune 500 companies
          millions, now modernized with AI and digital innovation
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Benefit 1 -->
        <div class="group" data-aos="fade-up" data-aos-delay="100">
          <div
            class="bg-white/10 backdrop-blur-md rounded-xl p-8 border border-white/20 hover:bg-white/20 transition-all h-full"
          >
            <div
              class="w-16 h-16 bg-gradient-to-br from-[#cc9933] to-[#FFA500] rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">50%+ Cost Reduction</h3>
            <p class="text-blue-100">
              Replace inflated hospital charges with transparent, flat-rate
              pricing that delivers immediate savings.
            </p>
            <div class="mt-4 text-sm text-[#cc9933]">
              Proven: $400M+ saved historically
            </div>
          </div>
        </div>

        <!-- Benefit 2 -->
        <div class="group" data-aos="fade-up" data-aos-delay="200">
          <div
            class="bg-white/10 backdrop-blur-md rounded-xl p-8 border border-white/20 hover:bg-white/20 transition-all h-full"
          >
            <div
              class="w-16 h-16 bg-gradient-to-br from-[#4A90E2] to-[#00CED1] rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">2-3 Day Access</h3>
            <p class="text-blue-100">
              Digital scheduling and nationwide network ensure fast appointments
              vs. 10-14 day waits.
            </p>
            <div class="mt-4 text-sm text-[#4A90E2]">
              400K+ patients served successfully
            </div>
          </div>
        </div>

        <!-- Benefit 3 -->
        <div class="group" data-aos="fade-up" data-aos-delay="300">
          <div
            class="bg-white/10 backdrop-blur-md rounded-xl p-8 border border-white/20 hover:bg-white/20 transition-all h-full"
          >
            <div
              class="w-16 h-16 bg-gradient-to-br from-green-500 to-green-400 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">Zero Billing Issues</h3>
            <p class="text-blue-100">
              No surprise bills, no denials, no member friction. Just simple,
              predictable healthcare.
            </p>
            <div class="mt-4 text-sm text-green-400">
              100% payment collection rate
            </div>
          </div>
        </div>

        <!-- Benefit 4 -->
        <div class="group" data-aos="fade-up" data-aos-delay="400">
          <div
            class="bg-white/10 backdrop-blur-md rounded-xl p-8 border border-white/20 hover:bg-white/20 transition-all h-full"
          >
            <div
              class="w-16 h-16 bg-gradient-to-br from-purple-500 to-purple-400 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">Instant ROI Tracking</h3>
            <p class="text-blue-100">
              Real-time dashboards show savings on every scan. Transparent
              reporting you can trust.
            </p>
            <div class="mt-4 text-sm text-purple-400">
              NYSE-validated approach
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Types Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-[#003087] mb-6">
          Who We Partner With
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          From self-funded employers to digital health platforms, we're
          transforming diagnostic imaging access
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Self-Funded Employers -->
        <div class="group relative" data-aos="fade-up" data-aos-delay="100">
          <div
            class="absolute inset-0 bg-gradient-to-r from-[#cc9933] to-[#FFA500] rounded-2xl blur-xl opacity-0 group-hover:opacity-20 transition-opacity"
          >
          </div>
          <div
            class="relative bg-white border-2 border-gray-200 rounded-2xl p-8 hover:border-[#cc9933] transition-all"
          >
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#003087] to-[#0052cc] rounded-2xl flex items-center justify-center mb-6 mx-auto"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m9 0a2 2 0 01-2 2H7a2 2 0 01-2-2"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-4 text-center">
              Self-Funded Employers
            </h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start">
                <svg
                  class="w-5 h-5 text-[#cc9933] mr-2 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Immediate cost savings on diagnostic imaging</span>
              </li>
              <li class="flex items-start">
                <svg
                  class="w-5 h-5 text-[#cc9933] mr-2 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Better employee experience, zero billing friction</span>
              </li>
              <li class="flex items-start">
                <svg
                  class="w-5 h-5 text-[#cc9933] mr-2 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>No contracts or minimum commitments</span>
              </li>
            </ul>
            <div class="mt-6 text-center">
              <span class="text-sm text-[#cc9933] font-semibold"
                >500+ employee groups</span
              >
            </div>
          </div>
        </div>

        <!-- TPAs -->
        <div class="group relative" data-aos="fade-up" data-aos-delay="200">
          <div
            class="absolute inset-0 bg-gradient-to-r from-[#4A90E2] to-[#00CED1] rounded-2xl blur-xl opacity-0 group-hover:opacity-20 transition-opacity"
          >
          </div>
          <div
            class="relative bg-white border-2 border-gray-200 rounded-2xl p-8 hover:border-[#4A90E2] transition-all"
          >
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#cc9933] to-[#FFA500] rounded-2xl flex items-center justify-center mb-6 mx-auto"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
