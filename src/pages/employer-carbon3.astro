---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="USRad for Self-Insured Employers - Imaging Carve-Out Solution"
  isHeroPage={true}
>
  <AOSInit />

  <!-- Hero Section with Video Background -->
  <section
    class="relative pt-32 pb-20 px-4 sm:px-6 overflow-hidden min-h-[700px] flex items-center"
  >
    <!-- Background Video -->
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover"
      poster="/images/partner-hero-fallback-enhanced.webp"
    >
      <source
        src="/videos/partner-hero-softblur-mobile.mp4"
        type="video/mp4"
        media="(max-width: 768px)"
      />
      <source src="/videos/partner-hero-softblur.mp4" type="video/mp4" />
      <source src="/videos/partner-hero-softblur.webm" type="video/webm" />
    </video>

    <!-- Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/40"
    >
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="max-w-5xl">
        <!-- Trust Badge -->
        <div
          class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-6 py-3 mb-8"
          data-aos="fade-down"
        >
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          <span class="text-white text-sm font-medium"
            >Trusted by Fortune 500 Since 1994</span
          >
        </div>

        <h1
          class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold mb-8 text-white leading-tight"
          data-aos="fade-up"
        >
          Cut Imaging Costs by
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-300 drop-shadow-lg"
            >50-70%</span
          >
          <br />
          <span class="text-3xl sm:text-4xl md:text-5xl opacity-90"
            >Without Changing Your Health Plan</span
          >
        </h1>

        <p
          class="text-xl md:text-2xl text-gray-200 max-w-3xl mb-12 leading-relaxed"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          The imaging carve-out solution that transformed workers' comp is now
          available for all your employees. Direct contracts. Transparent
          pricing. Immediate ROI.
        </p>

        <!-- CTA Buttons -->
        <div
          class="flex flex-col sm:flex-row gap-4"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <a
            href="#roi-calculator"
            class="bg-gradient-to-r from-teal-500 to-cyan-500 hover:from-teal-600 hover:to-cyan-600 text-white px-8 py-4 rounded-xl font-semibold text-lg transition-all transform hover:scale-105 shadow-lg inline-flex items-center gap-2"
          >
            Calculate Your Savings
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
              ></path>
            </svg>
          </a>
          <a
            href="/employer/case-studies"
            class="bg-white/10 backdrop-blur-sm hover:bg-white/20 text-white px-8 py-4 rounded-xl font-semibold text-lg transition-all border border-white/30"
          >
            View Case Studies
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Value Props -->
  <section class="py-12 px-4 sm:px-6 bg-gray-900 border-t border-gray-800">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div data-aos="fade-up" data-aos-delay="100">
          <div class="text-3xl md:text-4xl font-bold text-teal-400">
            2-3 Days
          </div>
          <div class="text-sm text-gray-400">vs 14-day industry avg</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="200">
          <div class="text-3xl md:text-4xl font-bold text-teal-400">$260</div>
          <div class="text-sm text-gray-400">MRI vs $3,200 hospital</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="300">
          <div class="text-3xl md:text-4xl font-bold text-teal-400">100%</div>
          <div class="text-sm text-gray-400">Claims paid in 10 days</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="400">
          <div class="text-3xl md:text-4xl font-bold text-teal-400">Zero</div>
          <div class="text-sm text-gray-400">Implementation cost</div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Problem Section -->
  <section class="py-24 px-4 sm:px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div data-aos="fade-right">
          <div
            class="inline-flex items-center gap-2 bg-red-100 text-red-800 rounded-full px-4 py-2 mb-6"
          >
            <span class="text-sm font-medium">The Hidden Cost Center</span>
          </div>

          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Your Imaging Costs Are
            <span class="text-red-600"> Out of Control</span>
          </h2>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0"
              >
                <span class="text-2xl">💸</span>
              </div>
              <div>
                <h3 class="font-semibold text-lg text-gray-900">
                  Hospital Markups of 800-1,200%
                </h3>
                <p class="text-gray-600">
                  Same MRI: $3,200 at hospital, $400 at imaging center
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0"
              >
                <span class="text-2xl">📈</span>
              </div>
              <div>
                <h3 class="font-semibold text-lg text-gray-900">
                  15% Annual Growth Rate
                </h3>
                <p class="text-gray-600">
                  Imaging costs growing 3x faster than overall medical spend
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0"
              >
                <span class="text-2xl">🏥</span>
              </div>
              <div>
                <h3 class="font-semibold text-lg text-gray-900">
                  Network Steering Failures
                </h3>
                <p class="text-gray-600">
                  70% of scans still go to high-cost hospital facilities
                </p>
              </div>
            </div>
          </div>
        </div>

        <div data-aos="fade-left">
          <!-- Cost Comparison Visual -->
          <div
            class="bg-gradient-to-br from-red-50 to-white rounded-2xl shadow-xl p-8"
          >
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              Real Cost Example: Lumbar MRI
            </h3>

            <div class="space-y-4">
              <div class="relative">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-sm font-medium text-gray-700"
                    >Hospital Outpatient</span
                  >
                  <span class="text-lg font-bold text-red-600">$3,200</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-8">
                  <div class="bg-red-500 h-8 rounded-full" style="width: 100%">
                  </div>
                </div>
              </div>

              <div class="relative">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-sm font-medium text-gray-700"
                    >In-Network Rate</span
                  >
                  <span class="text-lg font-bold text-orange-600">$1,800</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-8">
                  <div
                    class="bg-orange-500 h-8 rounded-full"
                    style="width: 56%"
                  >
                  </div>
                </div>
              </div>

              <div class="relative">
                <div class="flex justify-between items-center mb-2">
                  <span class="text-sm font-medium text-gray-700"
                    >USRad Direct Price</span
                  >
                  <span class="text-lg font-bold text-green-600">$260</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-8">
                  <div class="bg-green-500 h-8 rounded-full" style="width: 8%">
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-6 p-4 bg-green-50 rounded-lg">
              <p class="text-center">
                <span class="text-3xl font-bold text-green-700">$2,940</span>
                <span class="text-lg text-gray-700"> saved per scan</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Solution Section -->
  <section class="py-24 px-4 sm:px-6 bg-gradient-to-br from-teal-50 to-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center gap-2 bg-teal-100 text-teal-800 rounded-full px-4 py-2 mb-6"
          data-aos="fade-down"
        >
          <span class="text-sm font-medium">The USRad Solution</span>
        </div>

        <h2
          class="text-4xl md:text-5xl font-bold text-gray-900 mb-6"
          data-aos="fade-up"
        >
          A Carve-Out That Actually Works
        </h2>

        <p
          class="text-xl text-gray-600 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Direct contracts with 1,500+ imaging centers. One flat rate. Zero
          friction.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div
          class="bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-all"
          data-aos="zoom-in"
          data-aos-delay="100"
        >
          <div
            class="w-16 h-16 bg-teal-100 rounded-2xl flex items-center justify-center mb-6"
          >
            <span class="text-3xl">🎯</span>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">
            Direct Contracting
          </h3>
          <p class="text-gray-600 mb-6">
            Bypass network markups with direct relationships to quality imaging
            centers
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>Medicare-based pricing</span>
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>No claims repricing</span>
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>Guaranteed acceptance</span>
            </li>
          </ul>
        </div>

        <div
          class="bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-all"
          data-aos="zoom-in"
          data-aos-delay="200"
        >
          <div
            class="w-16 h-16 bg-teal-100 rounded-2xl flex items-center justify-center mb-6"
          >
            <span class="text-3xl">⚡</span>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">
            Frictionless Access
          </h3>
          <p class="text-gray-600 mb-6">
            Members book directly online. No prior auth. No referrals. No
            paperwork.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>60-second booking</span>
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>Real-time availability</span>
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>Mobile-first platform</span>
            </li>
          </ul>
        </div>

        <div
          class="bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-all"
          data-aos="zoom-in"
          data-aos-delay="300"
        >
          <div
            class="w-16 h-16 bg-teal-100 rounded-2xl flex items-center justify-center mb-6"
          >
            <span class="text-3xl">📊</span>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4">
            Complete Visibility
          </h3>
          <p class="text-gray-600 mb-6">
            Real-time analytics on utilization, savings, and member satisfaction
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>Executive dashboards</span>
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>API integration</span>
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-teal-500 flex-shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>Monthly reporting</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator Section -->
  <section
    id="roi-calculator"
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-900 to-gray-800 text-white"
  >
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6" data-aos="fade-up">
          Calculate Your Potential Savings
        </h2>
        <p
          class="text-xl text-gray-300 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          See exactly how much you could save with a USRad imaging carve-out
        </p>
      </div>

      <div
        class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 md:p-12"
        data-aos="zoom-in"
      >
        <div class="grid md:grid-cols-2 gap-12">
          <!-- Input Side -->
          <div>
            <h3 class="text-2xl font-bold mb-6">Your Current State</h3>
            <div class="space-y-6">
              <div>
                <label class="block text-sm font-medium mb-2"
                  >Number of Covered Lives</label
                >
                <input
                  type="number"
                  id="covered-lives"
                  value="5000"
                  class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-teal-400"
                />
              </div>
              <div>
                <label class="block text-sm font-medium mb-2"
                  >Annual MRI/CT Scans (estimate)</label
                >
                <input
                  type="number"
                  id="annual-scans"
                  value="500"
                  class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-teal-400"
                />
              </div>
              <div>
                <label class="block text-sm font-medium mb-2"
                  >Average Cost per Scan</label
                >
                <input
                  type="number"
                  id="avg-cost"
                  value="2400"
                  class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-teal-400"
                />
              </div>
            </div>
          </div>

          <!-- Results Side -->
          <div>
            <h3 class="text-2xl font-bold mb-6">Your Potential Savings</h3>
            <div class="space-y-4">
              <div class="bg-white/10 rounded-xl p-6">
                <p class="text-sm text-gray-300 mb-2">Current Annual Spend</p>
                <p class="text-3xl font-bold text-red-400" id="current-spend">
                  $1,200,000
                </p>
              </div>
              <div class="bg-white/10 rounded-xl p-6">
                <p class="text-sm text-gray-300 mb-2">USRad Annual Cost</p>
                <p class="text-3xl font-bold text-teal-400" id="usrad-cost">
                  $350,000
                </p>
              </div>
              <div
                class="bg-gradient-to-r from-teal-600 to-cyan-600 rounded-xl p-6"
              >
                <p class="text-sm text-white mb-2">Annual Savings</p>
                <p class="text-4xl font-bold text-white" id="annual-savings">
                  $850,000
                </p>
                <p class="text-lg text-white/80 mt-2">71% cost reduction</p>
              </div>
            </div>

            <button
              class="w-full mt-6 bg-white text-gray-900 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors"
            >
              Get Detailed Analysis →
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Implementation Timeline -->
  <section class="py-24 px-4 sm:px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-4xl md:text-5xl font-bold text-gray-900 mb-6"
          data-aos="fade-up"
        >
          Go Live in 30 Days
        </h2>
        <p
          class="text-xl text-gray-600 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Our streamlined implementation process gets you saving money fast
        </p>
      </div>

      <div class="relative">
        <!-- Timeline Path -->
        <div
          class="absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-teal-500 to-cyan-500 transform -translate-x-1/2 hidden md:block"
        >
        </div>

        <!-- Timeline Items -->
        <div class="space-y-12">
          <!-- Week 1 -->
          <div class="relative flex items-center" data-aos="fade-right">
            <div class="w-full md:w-1/2 md:text-right md:pr-12">
              <div class="bg-white rounded-2xl shadow-lg p-6 inline-block">
                <h3 class="text-xl font-bold text-gray-900 mb-2">
                  Week 1: Contract & Setup
                </h3>
                <ul class="text-gray-600 space-y-1 text-sm">
                  <li>• Execute agreement</li>
                  <li>• API credentials provided</li>
                  <li>• Kick-off call scheduled</li>
                </ul>
              </div>
            </div>
            <div
              class="absolute left-1/2 transform -translate-x-1/2 w-12 h-12 bg-teal-500 rounded-full flex items-center justify-center text-white font-bold shadow-lg"
            >
              1
            </div>
            <div class="hidden md:block w-1/2"></div>
          </div>

          <!-- Week 2-3 -->
          <div class="relative flex items-center" data-aos="fade-left">
