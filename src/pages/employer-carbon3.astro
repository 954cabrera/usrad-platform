  <script>
    // ROI Calculator Logic
    function updateCalculator() {
      const coveredLives =
        parseInt(document.getElementById("covered-lives").value) || 0;
      const annualScans =
        parseInt(document.getElementById("annual-scans").value) || 0;
      const avgCost = parseInt(document.getElementById("avg-cost").value) || 0;

      const currentSpend = annualScans * avgCost;
      const usradCost = annualScans * 350; // Average USRad price
      const savings = currentSpend - usradCost;
      const savingsPercent = Math.round((savings / currentSpend) * 100);

      document.getElementById("current-spend").textContent =
        `$${currentSpend.toLocaleString()}`;
      document.getElementById("usrad-cost").textContent =
        `$${usradCost.toLocaleString()}`;
      document.getElementById("annual-savings").textContent =
        `$${savings.toLocaleString()}`;
      document.getElementById("annual-savings").nextElementSibling.textContent =
        `${savingsPercent}% cost reduction`;
    }

    // Add event listeners
    document
      .getElementById("covered-lives")
      ?.addEventListener("input", updateCalculator);
    document
      .getElementById("annual-scans")
      ?.addEventListener("input", updateCalculator);
    document
      .getElementById("avg-cost")
      ?.addEventListener("input", updateCalculator);

    // Initial calculation
    updateCalculator();
  </script>
