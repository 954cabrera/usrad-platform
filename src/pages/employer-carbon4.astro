        <script>
          // ROI Calculator Logic
          function updateCalculator() {
            const totalEmployees =
              parseInt(document.getElementById("total-employees").value) || 0;
            const wcScans =
              parseInt(document.getElementById("wc-scans").value) || 0;
            const healthScans =
              parseInt(document.getElementById("health-scans").value) || 0;
            const avgCost =
              parseInt(document.getElementById("avg-cost").value) || 0;

            const totalScans = wcScans + healthScans;
            const currentSpend = totalScans * avgCost;
            const usradCost = totalScans * 350; // Average USRad price
            const savings = currentSpend - usradCost;
            const savingsPercent = Math.round((savings / currentSpend) * 100);

            // Update main displays
            document.getElementById("current-spend").textContent =
              `$${currentSpend.toLocaleString()}`;
            document.getElementById("usrad-cost").textContent =
              `$${usradCost.toLocaleString()}`;
            document.getElementById("annual-savings").textContent =
              `$${savings.toLocaleString()}`;
            document.getElementById("savings-percent").textContent =
              `${savingsPercent}% cost reduction`;

            // Calculate split savings
            const wcCurrentSpend = wcScans * avgCost;
            const wcUsradCost = wcScans * 350;
            const wcSavings = wcCurrentSpend - wcUsradCost;

            const healthCurrentSpend = healthScans * avgCost;
            const healthUsradCost = healthScans * 350;
            const healthSavings = healthCurrentSpend - healthUsradCost;

            document.getElementById("wc-savings").textContent =
              `$${wcSavings.toLocaleString()}`;
            document.getElementById("health-savings").textContent =
              `$${healthSavings.toLocaleString()}`;
          }

          // Add event listeners
          document
            .getElementById("total-employees")
            ?.addEventListener("input", updateCalculator);
          document
            .getElementById("wc-scans")
            ?.addEventListener("input", updateCalculator);
          document
            .getElementById("health-scans")
            ?.addEventListener("input", updateCalculator);
          document
            .getElementById("avg-cost")
            ?.addEventListener("input", updateCalculator);

          // Initial calculation
          updateCalculator();
        </script>
