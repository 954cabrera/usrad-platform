---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="USRad for Self-Insured Employers - Imaging Solutions for Workers' Comp & Employee Benefits"
  isHeroPage={true}
>
  <AOSInit />

  <!-- Update your EmployerHero component -->
  <section
    class="relative pt-32 pb-20 px-4 sm:px-6 overflow-hidden bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900"
  >
    <!-- Keep the subtle pattern but make it lighter on dark background -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute inset-0"
        style="background-image: url('data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23FFFFFF' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="max-w-5xl">
        <!-- Problem Badge - update colors for dark background -->
        <div
          class="inline-flex items-center gap-2 bg-red-500/20 text-red-300 backdrop-blur-sm rounded-full px-4 py-2 mb-6"
          data-aos="fade-down"
        >
          <span class="w-2 h-2 bg-red-400 rounded-full animate-pulse"></span>
          <span class="text-sm font-medium">The Hidden Benefits Crisis</span>
        </div>

        <h1
          class="text-5xl sm:text-6xl md:text-7xl font-bold text-white mb-6 leading-tight"
          data-aos="fade-up"
        >
          Your Employees Can't Afford
          <span class="text-red-400 block">Your Health Plan</span>
        </h1>

        <p
          class="text-xl md:text-2xl text-gray-200 mb-8 leading-relaxed max-w-3xl"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          67% skip necessary imaging due to high deductibles. Extended
          disabilities. Lost productivity. Higher costs for everyone.
        </p>

        <!-- Update value props for dark background -->
        <div
          class="flex flex-wrap gap-6 text-lg mb-10"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <!-- svg path -->
            </svg>
            <span class="text-gray-200">$260 MRIs (not $3,200)</span>
          </div>
          <!-- other value props with text-gray-200 -->
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Credibility Bar -->
  <section class="py-8 px-4 sm:px-6 bg-gray-900 border-t border-gray-800">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap justify-center items-center gap-8 text-center">
        <div class="text-white">
          <span class="text-sm opacity-80">From the founders of</span>
          <span class="block text-lg font-semibold">AnciCare (1994)</span>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-700"></div>
        <div class="text-white">
          <span class="text-sm opacity-80">Served</span>
          <span class="block text-lg font-semibold">168,000+ Claimants</span>
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-700"></div>
        <div class="text-white">
          <span class="text-sm opacity-80">Model operating</span>
          <span class="block text-lg font-semibold">20+ Years Post-Exit</span>
        </div>
      </div>
    </div>
  </section>

  <!-- The Real Cost Section -->
  <section class="py-24 px-4 sm:px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-4xl md:text-5xl font-bold text-gray-900 mb-6"
          data-aos="fade-up"
        >
          The True Cost of Delayed Imaging
        </h2>
        <p
          class="text-xl text-gray-600 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          It's not just the scan price. It's the cascade of costs that follow.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Cost Breakdown -->
        <div data-aos="fade-right">
          <div class="space-y-6">
            <div
              class="bg-gradient-to-r from-red-50 to-white rounded-xl p-6 border-l-4 border-red-500"
            >
              <h3 class="font-semibold text-lg text-gray-900 mb-2">
                When Employees Delay Due to Cost
              </h3>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-center gap-2">
                  <span class="text-red-500">→</span>
                  <span
                    >Conditions worsen, requiring more complex treatment</span
                  >
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-red-500">→</span>
                  <span>Disability claims extend by 18+ days average</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-red-500">→</span>
                  <span>Productivity losses compound weekly</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-red-500">→</span>
                  <span>Workers' comp claims increase in severity</span>
                </li>
              </ul>
            </div>

            <div
              class="bg-gradient-to-r from-orange-50 to-white rounded-xl p-6 border-l-4 border-orange-500"
            >
              <h3 class="font-semibold text-lg text-gray-900 mb-2">
                The Hospital Markup Reality
              </h3>
              <div class="space-y-3">
                <div class="flex justify-between items-center">
                  <span class="text-gray-700">Medicare Rate (baseline)</span>
                  <span class="font-semibold">$450</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-700">Imaging Center Rate</span>
                  <span class="font-semibold">$600</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-700">Hospital Outpatient</span>
                  <span class="font-semibold text-red-600">$3,200</span>
                </div>
                <div class="pt-3 border-t">
                  <div class="flex justify-between items-center">
                    <span class="font-semibold text-gray-900"
                      >Hospital Markup</span
                    >
                    <span class="font-bold text-red-600">711%</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Visual Impact -->
        <div data-aos="fade-left">
          <div
            class="bg-gradient-to-br from-gray-50 to-white rounded-2xl shadow-xl p-8"
          >
            <h3 class="text-2xl font-bold text-gray-900 mb-6 text-center">
              Real Example: Lower Back Pain
            </h3>

            <!-- Timeline Comparison -->
            <div class="space-y-8">
              <div>
                <h4 class="font-semibold text-red-600 mb-3">
                  Without Affordable Access
                </h4>
                <div class="relative">
                  <div
                    class="absolute left-0 top-0 bottom-0 w-1 bg-red-200 rounded"
                  >
                  </div>
                  <div class="space-y-4 pl-6">
                    <div class="relative">
                      <div
                        class="absolute -left-8 w-4 h-4 bg-red-500 rounded-full"
                      >
                      </div>
                      <p class="text-sm">
                        <span class="font-semibold">Day 1:</span> Pain starts, employee
                        continues working
                      </p>
                    </div>
                    <div class="relative">
                      <div
                        class="absolute -left-8 w-4 h-4 bg-red-500 rounded-full"
                      >
                      </div>
                      <p class="text-sm">
                        <span class="font-semibold">Week 2:</span> Can't afford $3,200
                        MRI, tries PT
                      </p>
                    </div>
                    <div class="relative">
                      <div
                        class="absolute -left-8 w-4 h-4 bg-red-500 rounded-full"
                      >
                      </div>
                      <p class="text-sm">
                        <span class="font-semibold">Week 4:</span> Injury worsens,
                        files WC claim
                      </p>
                    </div>
                    <div class="relative">
                      <div
                        class="absolute -left-8 w-4 h-4 bg-red-500 rounded-full"
                      >
                      </div>
                      <p class="text-sm">
                        <span class="font-semibold">Week 8:</span> Surgery required,
                        6-month disability
                      </p>
                    </div>
                  </div>
                </div>
                <p class="text-red-600 font-semibold mt-4">
                  Total Cost: $45,000+
                </p>
              </div>

              <div>
                <h4 class="font-semibold text-green-600 mb-3">
                  With USRad Access
                </h4>
                <div class="relative">
                  <div
                    class="absolute left-0 top-0 bottom-0 w-1 bg-green-200 rounded"
                  >
                  </div>
                  <div class="space-y-4 pl-6">
                    <div class="relative">
                      <div
                        class="absolute -left-8 w-4 h-4 bg-green-500 rounded-full"
                      >
                      </div>
                      <p class="text-sm">
                        <span class="font-semibold">Day 1:</span> Pain starts, books
                        $260 MRI
                      </p>
                    </div>
                    <div class="relative">
                      <div
                        class="absolute -left-8 w-4 h-4 bg-green-500 rounded-full"
                      >
                      </div>
                      <p class="text-sm">
                        <span class="font-semibold">Day 3:</span> MRI reveals minor
                        disc issue
                      </p>
                    </div>
                    <div class="relative">
                      <div
                        class="absolute -left-8 w-4 h-4 bg-green-500 rounded-full"
                      >
                      </div>
                      <p class="text-sm">
                        <span class="font-semibold">Week 2:</span> Targeted treatment,
                        continues working
                      </p>
                    </div>
                    <div class="relative">
                      <div
                        class="absolute -left-8 w-4 h-4 bg-green-500 rounded-full"
                      >
                      </div>
                      <p class="text-sm">
                        <span class="font-semibold">Week 4:</span> Full recovery,
                        no lost time
                      </p>
                    </div>
                  </div>
                </div>
                <p class="text-green-600 font-semibold mt-4">
                  Total Cost: $1,200
                </p>
              </div>
            </div>

            <div
              class="mt-8 p-4 bg-blue-50 rounded-lg border border-blue-200 text-center"
            >
              <p class="text-2xl font-bold text-blue-900">97% Cost Reduction</p>
              <p class="text-sm text-blue-700">
                Plus retained productivity and employee satisfaction
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Proven Solution -->
  <section
    id="proven-solution"
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-50 to-white"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center gap-2 bg-green-100 text-green-800 rounded-full px-4 py-2 mb-6"
          data-aos="fade-down"
        >
          <span class="text-sm font-medium">The USRad Solution</span>
        </div>

        <h2
          class="text-4xl md:text-5xl font-bold text-gray-900 mb-6"
          data-aos="fade-up"
        >
          One Partner. Two Populations. Total Control.
        </h2>

        <p
          class="text-xl text-gray-600 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          The same proven model that transformed workers' comp imaging now
          available for your employee health benefits
        </p>
      </div>

      <!-- Two Solutions Side by Side -->
      <div class="grid lg:grid-cols-2 gap-8 mb-16">
        <!-- Workers' Comp Solution -->
        <div
          class="bg-white rounded-2xl shadow-lg p-8 border-t-4 border-blue-600"
          data-aos="zoom-in"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center"
            >
              <span class="text-2xl">🏗️</span>
            </div>
            <h3 class="text-2xl font-bold text-gray-900">
              For Workers' Comp Claimants
            </h3>
          </div>

          <p class="text-gray-700 mb-6">
            The industry standard we created, perfected over 168,000+ cases
          </p>

          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700"
                >48-hour appointments reduce disability duration</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700"
                >Direct billing eliminates claimant friction</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700"
                >Flat rates prevent cost escalation</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700"
                >Quality outcomes improve RTW rates</span
              >
            </li>
          </ul>

          <div class="mt-6 p-4 bg-blue-50 rounded-lg">
            <p class="text-sm text-blue-800">
              <span class="font-semibold">Proven Impact:</span> 50-70% imaging cost
              reduction, 18+ day faster return-to-work
            </p>
          </div>
        </div>

        <!-- Employee Health Solution -->
        <div
          class="bg-white rounded-2xl shadow-lg p-8 border-t-4 border-green-600"
          data-aos="zoom-in"
          data-aos-delay="100"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center"
            >
              <span class="text-2xl">👥</span>
            </div>
            <h3 class="text-2xl font-bold text-gray-900">
              For Health Plan Members
            </h3>
          </div>

          <p class="text-gray-700 mb-6">
            Breaking down the high-deductible barrier to necessary care
          </p>

          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700"
                >$260 MRIs employees can actually afford</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700"
                >No prior auth or referral requirements</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700"
                >Evening/weekend hours for convenience</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-700"
                >Mobile booking increases utilization</span
              >
            </li>
          </ul>

          <div class="mt-6 p-4 bg-green-50 rounded-lg">
            <p class="text-sm text-green-800">
              <span class="font-semibold">Member Impact:</span> 73% increase in necessary
              imaging, 92% satisfaction score
            </p>
          </div>
        </div>
      </div>

      <!-- Integration Benefits -->
      <div
        class="bg-gradient-to-r from-gray-900 to-gray-800 text-white rounded-2xl p-8 md:p-12"
        data-aos="fade-up"
      >
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold mb-4">
            The Power of One Integrated Solution
          </h3>
          <p class="text-gray-300 max-w-3xl mx-auto">
            Why managing both populations through USRad multiplies your benefits
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div
              class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-3xl">📊</span>
            </div>
            <h4 class="font-semibold text-lg mb-2">Unified Analytics</h4>
            <p class="text-gray-300 text-sm">
              Single dashboard for all imaging spend across both populations
            </p>
          </div>

          <div class="text-center">
            <div
              class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-3xl">🔄</span>
            </div>
            <h4 class="font-semibold text-lg mb-2">Seamless Transitions</h4>
            <p class="text-gray-300 text-sm">
              When injuries become WC claims, continuity of care is maintained
            </p>
          </div>

          <div class="text-center">
            <div
              class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-3xl">💰</span>
            </div>
            <h4 class="font-semibold text-lg mb-2">Volume Advantages</h4>
            <p class="text-gray-300 text-sm">
              Combined volume drives even better pricing and priority access
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator -->
  <section
    id="roi-calculator"
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-900 to-gray-800 text-white"
  >
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-6" data-aos="fade-up">
          Calculate Your Total Imaging Savings
        </h2>
        <p
          class="text-xl text-gray-300 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          See the combined impact across workers' comp and employee health
          benefits
        </p>
      </div>

      <div
        class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 md:p-12"
        data-aos="zoom-in"
      >
        <div class="grid md:grid-cols-2 gap-12">
          <!-- Input Side -->
          <div>
            <h3 class="text-2xl font-bold mb-6">Your Current Numbers</h3>
            <div class="space-y-6">
              <div>
                <label class="block text-sm font-medium mb-2"
                  >Total Employees</label
                >
                <input
                  type="number"
                  id="total-employees"
                  value="5000"
                  class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-green-400"
                />
              </div>

              <div>
                <label class="block text-sm font-medium mb-2"
                  >Annual WC Imaging Scans</label
                >
                <input
                  type="number"
                  id="wc-scans"
                  value="120"
                  class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-green-400"
                />
              </div>

              <div>
                <label class="block text-sm font-medium mb-2"
                  >Annual Employee Health Scans</label
                >
                <input
                  type="number"
                  id="health-scans"
                  value="380"
                  class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-green-400"
                />
              </div>

              <div>
                <label class="block text-sm font-medium mb-2"
                  >Average Cost per Scan Today</label
                >
                <input
                  type="number"
                  id="avg-cost"
                  value="2400"
                  class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-green-400"
                />
              </div>
            </div>
          </div>

