---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";
import EmployerHero from "../components/employer/EmployerHero.astro";
import CredibilityBar from "../components/employer/CredibilityBar.astro";
import CostAnalysis from "../components/employer/CostAnalysis.astro";
import DualSolution from "../components/employer/DualSolution.astro";
import ROICalculator from "../components/employer/ROICalculator.astro";
import AnciCareLegacy from "../components/employer/AnciCareLegacy.astro";
import Implementation from "../components/employer/Implementation.astro";
import ExecutiveFAQ from "../components/employer/ExecutiveFAQ.astro";
import ROIStatPanel from "../components/employer/ROIStatPanel.astro";
import FinalCTA from "../components/employer/FinalCTA.astro";

export const prerender = true;
---

<CarbonLayout
  title="USRad — Imaging Solutions for Employee Benefits"
  isHeroPage={true}
  hideNewsletter={true}
>
  <AOSInit />

  <EmployerHero />

  <CredibilityBar />

  <CostAnalysis />

  <AnciCareLegacy />

  <DualSolution />

  <ROIStatPanel />

  <ROICalculator />

  <Implementation />

  <ExecutiveFAQ />

  <FinalCTA />

  
</CarbonLayout>
