---
import CarbonLayout from "../../layouts/CarbonLayout.astro";
import AOSInit from "../../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="Employer Implementation Guide | USRad for Self-Insured Employers"
  isHeroPage={true}
  hideNewsletter={true}
>
  <AOSInit />

  <!-- Hero / Above-the-fold -->
  <section
    class="relative pt-24 sm:pt-32 pb-16 sm:pb-20 px-4 sm:px-6 overflow-hidden bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900"
  >
    <!-- Subtle grid pattern -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute inset-0"
        style="background-image: url('data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23FFFFFF' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-10 sm:gap-16 items-center">
        <!-- Left — PDF Preview + What's Inside -->
        <div data-aos="fade-right">
          <!-- Badge -->
          <div
            class="inline-flex items-center gap-2 bg-[#cc9933]/20 text-[#cc9933] backdrop-blur-sm rounded-full px-3 sm:px-4 py-1.5 sm:py-2 mb-4 sm:mb-6"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v3.586l-1.293-1.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V8z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-xs sm:text-sm font-semibold"
              >Free PDF Download</span
            >
          </div>

          <h1
            class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-4 sm:mb-6 leading-tight"
            data-aos="fade-up"
          >
            The Employer
            <span class="text-[#cc9933] block">Implementation Guide</span>
          </h1>

          <p
            class="text-lg sm:text-xl text-gray-300 mb-8 leading-relaxed"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            Everything a self-insured employer needs to reduce imaging costs by
            50–70% — workflows, timelines, compliance checklist, and a real
            composite case study.
          </p>

          <!-- What's inside list -->
          <div class="space-y-3 mb-8" data-aos="fade-up" data-aos-delay="150">
            {
              [
                "30-day implementation timeline with owner accountability",
                "WC and employee health referral workflows, step by step",
                "Every Verified Provider maintains an active state facility license where required and active accreditation from a recognized accrediting body — ACR, IAC, The Joint Commission, or RadSite — covering each modality offered through USRad.",
                "Reporting metrics and 90-day performance benchmarks",
                "Composite case study: $3.3M saved, 18-day faster RTW",
                "Bar chart: Hospital $3,200 → USRad $420",
              ].map((item) => (
                <div class="flex items-start gap-3">
                  <svg
                    class="w-5 h-5 text-[#cc9933] flex-shrink-0 mt-0.5"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span class="text-gray-200 text-sm sm:text-base">{item}</span>
                </div>
              ))
            }
          </div>

          <!-- Credibility strip -->
          <div
            class="flex flex-wrap gap-6 text-sm text-gray-400 border-t border-white/10 pt-6"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <div>
              <span class="block text-white font-semibold">168,000+</span>
              Cases managed
            </div>
            <div class="w-px bg-white/10"></div>
            <div>
              <span class="block text-white font-semibold">Est. 1994</span>
              Category founders
            </div>
            <div class="w-px bg-white/10"></div>
            <div>
              <span class="block text-white font-semibold"
                >CorVel (NASDAQ: CRVL)</span
              >
              Acquired our model
            </div>
          </div>
        </div>

        <!-- Right — Gate Form -->
        <div data-aos="zoom-in" data-aos-delay="200">
          <div class="bg-white rounded-2xl shadow-2xl p-6 sm:p-8">
            <!-- Form header -->
            <div class="mb-6">
              <h2 class="text-2xl font-bold text-gray-900 mb-1">
                Get Instant Access
              </h2>
              <p class="text-gray-500 text-sm">
                We'll send the guide to your inbox immediately.
              </p>
            </div>

            <!-- Success state (hidden by default) -->
            <div id="success-panel" class="hidden text-center py-8">
              <div
                class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <svg
                  class="w-8 h-8 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">
                Guide on its way!
              </h3>
              <p class="text-gray-600 text-sm mb-6">
                Check your inbox. While you wait — want to speak directly with
                Michael?
              </p>
              <a
                href="/employer/schedule"
                class="inline-flex items-center gap-2 bg-[#003087] hover:bg-[#002070] text-white px-6 py-3 rounded-xl font-semibold text-sm transition-all"
              >
                Schedule a 30-Minute Briefing
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </a>
            </div>

            <!-- The form -->
            <form id="guide-form" class="space-y-4" novalidate>
              <input type="hidden" id="form_start" name="form_start" value="" />
              <div
                style="position:absolute;left:-9999px;top:-9999px;"
                aria-hidden="true"
              >
                <input
                  type="text"
                  id="website_url"
                  name="website_url"
                  tabindex="-1"
                  autocomplete="off"
                  placeholder="https://yourcompany.com"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                  Full Name <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Sarah Johnson"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#003087]/30 focus:border-[#003087] text-gray-900 text-base transition-all"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                  Work Email <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="sarah@company.com"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#003087]/30 focus:border-[#003087] text-gray-900 text-base transition-all"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                  Company <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  required
                  placeholder="Acme Corp"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#003087]/30 focus:border-[#003087] text-gray-900 text-base transition-all"
                />
              </div>

              <!-- Error message -->
              <div
                id="form-error"
                class="hidden bg-red-50 border border-red-200 rounded-lg px-4 py-3 text-sm text-red-700"
              >
              </div>

              <button
                type="submit"
                id="submit-btn"
                class="w-full bg-[#003087] hover:bg-[#002070] text-white px-6 py-4 rounded-xl font-bold text-base transition-all duration-200 flex items-center justify-center gap-2 mt-2"
              >
                <span id="btn-text">Send Me the Guide</span>
                <svg
                  id="btn-arrow"
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
                <svg
                  id="btn-spinner"
                  class="hidden w-5 h-5 animate-spin"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
              </button>

              <p class="text-xs text-gray-400 text-center pt-1">
                No spam. No sales calls unless you ask. Unsubscribe anytime.
              </p>
            </form>
          </div>

          <!-- PDF stat preview under form -->
          <div class="mt-4 grid grid-cols-3 gap-3 text-center">
            <div class="bg-white/10 backdrop-blur-sm rounded-xl py-3 px-2">
              <div class="text-lg font-bold text-white">16</div>
              <div class="text-xs text-gray-400">Pages</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-xl py-3 px-2">
              <div class="text-lg font-bold text-white">8</div>
              <div class="text-xs text-gray-400">Sections</div>
            </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-xl py-3 px-2">
              <div class="text-lg font-bold text-[#cc9933]">Free</div>
              <div class="text-xs text-gray-400">No cost</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social proof / trust band -->
  <section class="py-10 px-4 sm:px-6 bg-gray-900 border-t border-gray-800">
    <div class="max-w-5xl mx-auto">
      <div
        class="flex flex-col sm:flex-row flex-wrap justify-center items-center gap-6 sm:gap-10 text-center text-sm text-gray-400"
      >
        <div>
          <span class="block text-white font-semibold text-base"
            >From the founders of AnciCare (1994)</span
          >
          First managed imaging network in the U.S.
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-700"></div>
        <div>
          <span class="block text-white font-semibold text-base"
            >Acquired by CorVel (NASDAQ: CRVL)</span
          >
          Model still operating 20+ years post-exit
        </div>
        <div class="hidden sm:block w-px h-8 bg-gray-700"></div>
        <div>
          <span class="block text-white font-semibold text-base"
            >50–70% cost reduction</span
          >
          Proven across 168,000+ imaging cases
        </div>
      </div>
    </div>
  </section>

  <!-- What's inside preview section -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12" data-aos="fade-up">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          A Practical Guide, Not a Sales Brochure
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Built for CFOs, HR directors, and risk managers who need to make the
          case internally — and get it done.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {
          [
            {
              icon: "📋",
              title: "30-Day Implementation Timeline",
              desc: "Week-by-week owner accountability matrix. Know exactly who does what, when — from contract execution through go-live.",
            },
            {
              icon: "🔄",
              title: "Referral Workflows",
              desc: "Step-by-step flows for both WC claimants and employee health plan members. Share directly with your TPA or adjuster.",
            },
            {
              icon: "✅",
              title: "Compliance Checklist",
              desc: "Every Verified Provider maintains an active state facility license where required and active accreditation from a recognized accrediting body — ACR, IAC, The Joint Commission, or RadSite — covering each modality offered through USRad.",
            },
            {
              icon: "📊",
              title: "Reporting & Analytics",
              desc: "The exact metrics to track, benchmarks to hit by 90 days, and dashboard data feeds available to your BI platform.",
            },
            {
              icon: "🏭",
              title: "Composite Case Study",
              desc: "4,800-employee regional logistics company. $5.1M → $1.8M imaging spend. 18 days faster return-to-work. Real numbers.",
            },
            {
              icon: "💰",
              title: "Cost Comparison Chart",
              desc: "Hospital outpatient $3,200 · PPO network $1,800 · Freestanding center $900 · USRad $420. Visualized clearly.",
            },
          ].map((card) => (
            <div
              class="bg-gray-50 rounded-2xl p-6 hover:shadow-md transition-shadow"
              data-aos="fade-up"
            >
              <div class="text-3xl mb-3">{card.icon}</div>
              <h3 class="font-semibold text-gray-900 text-lg mb-2">
                {card.title}
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed">{card.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bottom CTA repeat -->
  <section
    class="py-16 sm:py-20 px-4 sm:px-6 bg-gradient-to-br from-gray-900 to-gray-800 text-white"
  >
    <div class="max-w-3xl mx-auto text-center" data-aos="fade-up">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        Ready to make the case to leadership?
      </h2>
      <p class="text-lg text-gray-300 mb-8">
        Get the implementation guide free — then schedule 30 minutes with
        Michael if you want to go deeper.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#top"
          onclick="window.scrollTo({top:0,behavior:'smooth'}); return false;"
          class="bg-[#cc9933] hover:bg-[#b08829] text-white px-8 py-4 rounded-xl font-bold text-base transition-all inline-flex items-center justify-center gap-2"
        >
          Download the Guide
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v3.586l-1.293-1.293a1 1 0 10-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 11.586V8z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
        <a
          href="/employer/schedule"
          class="bg-transparent border-2 border-white text-white hover:bg-white hover:text-gray-900 px-8 py-4 rounded-xl font-bold text-base transition-all inline-flex items-center justify-center gap-2"
        >
          Schedule Briefing with Michael
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById("guide-form") as HTMLFormElement;
    const successPanel = document.getElementById(
      "success-panel",
    ) as HTMLDivElement;
    const submitBtn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement;
    const btnText = document.getElementById("btn-text") as HTMLSpanElement;
    const btnArrow = document.getElementById("btn-arrow") as HTMLElement;
    const btnSpinner = document.getElementById("btn-spinner") as HTMLElement;
    const formError = document.getElementById("form-error") as HTMLDivElement;

    function setLoading(loading: boolean) {
      submitBtn.disabled = loading;
      btnText.textContent = loading ? "Sending…" : "Send Me the Guide";
      btnArrow.classList.toggle("hidden", loading);
      btnSpinner.classList.toggle("hidden", !loading);
    }

    function showError(msg: string) {
      formError.textContent = msg;
      formError.classList.remove("hidden");
    }

    const formStartEl = document.getElementById(
      "form_start",
    ) as HTMLInputElement;
    if (formStartEl) formStartEl.value = Date.now().toString();

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      formError.classList.add("hidden");

      const name = (
        document.getElementById("name") as HTMLInputElement
      ).value.trim();
      const email = (
        document.getElementById("email") as HTMLInputElement
      ).value.trim();
      const company = (
        document.getElementById("company") as HTMLInputElement
      ).value.trim();

      if (!name || !email || !company) {
        showError("Please fill in all fields.");
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError("Please enter a valid work email address.");
        return;
      }
      const FREE_DOMAINS = [
        "gmail.com",
        "yahoo.com",
        "hotmail.com",
        "outlook.com",
        "aol.com",
        "icloud.com",
        "protonmail.com",
        "mail.com",
        "ymail.com",
        "live.com",
      ];
      if (FREE_DOMAINS.includes(email.split("@")[1]?.toLowerCase())) {
        showError("Please use your work email address.");
        return;
      }

      setLoading(true);

      try {
        const website_url = (
          document.getElementById("website_url") as HTMLInputElement
        ).value;
        const form_start = (
          document.getElementById("form_start") as HTMLInputElement
        ).value;

        const res = await fetch("/api/employer-guide-download", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name,
            email,
            company,
            source: "employer-implementation-guide",
            website_url,
            form_start,
          }),
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(
            data.message || "Something went wrong. Please try again.",
          );
        }

        // Show success
        form.classList.add("hidden");
        successPanel.classList.remove("hidden");
      } catch (err: any) {
        showError(err.message || "Something went wrong. Please try again.");
        setLoading(false);
      }
    });
  </script>
</CarbonLayout>
