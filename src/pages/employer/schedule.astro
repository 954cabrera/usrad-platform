---
import CarbonLayout from "../../layouts/CarbonLayout.astro";
import AOSInit from "../../components/AOSInit.astro";
import EmployerConsultationForm from "../../components/EmployerConsultationForm.astro";

export const prerender = true;
---

<CarbonLayout
  title="Schedule 30-Minute Executive Briefing | USRad for Self-Insured Employers"
  isHeroPage={true}
  hideNewsletter={true}
>
  <AOSInit />

  <!-- Hero Section -->
  <section
    class="relative pt-24 sm:pt-32 pb-16 sm:pb-20 px-4 sm:px-6 overflow-hidden bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900"
  >
    <!-- Subtle pattern background -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute inset-0"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23FFFFFF\' fill-opacity=\'0.05\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-8 sm:gap-12 items-center">
        <div>
          <!-- Badge -->
          <div
            class="inline-flex items-center gap-2 bg-green-500/20 text-green-300 backdrop-blur-sm rounded-full px-3 sm:px-4 py-1.5 sm:py-2 mb-4 sm:mb-6"
            data-aos="fade-down"
          >
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"
            ></span>
            <span class="text-xs sm:text-sm font-medium"
              >Complimentary Executive Briefing</span
            >
          </div>

          <h1
            class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-4 sm:mb-6 leading-tight"
            data-aos="fade-up"
          >
            Reduce Imaging Costs
            <span class="text-green-400 block">50–70% Without Changing</span>
            <span class="text-white block">Your Health Plan</span>
          </h1>

          <p
            class="text-lg sm:text-xl text-gray-200 mb-6 sm:mb-8 leading-relaxed"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            A 30-minute executive briefing directly with Michael Cabrera, USRad
            founder. No sales team. No pressure. Just a direct conversation
            about what's possible for your organization.
          </p>

          <!-- Benefits Preview -->
          <div
            class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 bg-green-500/20 rounded-lg flex items-center justify-center flex-shrink-0"
              >
                <span class="text-xl">💰</span>
              </div>
              <span class="text-gray-200 text-sm sm:text-base"
                >50–70% cost savings</span
              >
            </div>
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 bg-blue-500/20 rounded-lg flex items-center justify-center flex-shrink-0"
              >
                <span class="text-xl">🏥</span>
              </div>
              <span class="text-gray-200 text-sm sm:text-base"
                >Nationwide network</span
              >
            </div>
            <div class="flex items-center gap-3">
              <div
                class="w-10 h-10 bg-purple-500/20 rounded-lg flex items-center justify-center flex-shrink-0"
              >
                <span class="text-xl">⚡</span>
              </div>
              <span class="text-gray-200 text-sm sm:text-base"
                >30-day implementation</span
              >
            </div>
          </div>
        </div>

        <!-- Meeting Preview Card -->
        <div data-aos="zoom-in" data-aos-delay="300">
          <div
            class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 sm:p-8 border border-white/20"
          >
            <h2 class="text-xl sm:text-2xl font-bold text-white mb-4">
              Founder-Led Executive Briefing
            </h2>
            <p class="text-gray-300 mb-6">
              You'll speak directly with
              <a
                href="/co-founder-m"
                class="text-[#cc9933] underline font-semibold hover:text-[#b08829]"
                >Michael Cabrera</a
              >, President of USRad, who founded the managed imaging category
              with AnciCare. No sales team — just direct access to the person
              who will personally guide your implementation.
            </p>

            <div class="space-y-4">
              <div class="flex items-center gap-3">
                <svg
                  class="w-5 h-5 text-green-400 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-200">
                  Select your time on Calendly — right here on this page
                </span>
              </div>
              <div class="flex items-center gap-3">
                <svg
                  class="w-5 h-5 text-green-400 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-200">
                  Custom ROI analysis prepared for your company
                </span>
              </div>
              <div class="flex items-center gap-3">
                <svg
                  class="w-5 h-5 text-green-400 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-200">
                  Direct line to leadership — no sales pressure
                </span>
              </div>
            </div>

            <div class="mt-6 p-4 bg-[#cc9933]/20 rounded-lg">
              <p class="text-sm text-[#cc9933]">
                <strong>30 years of expertise:</strong> Michael personally managed
                168,000+ imaging cases and built the managed imaging category from
                the ground up.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Form + Inline Scheduling Section ─── -->
  <section
    id="consultation-form"
    class="py-16 sm:py-24 px-4 sm:px-6 bg-slate-50"
  >
    <div class="max-w-6xl mx-auto" id="formSectionInner">
      <div
        class="grid lg:grid-cols-2 gap-8 sm:gap-12 items-start"
        id="formLayoutGrid"
      >
        <!-- Left Column — Info (hidden after form submit) -->
        <div data-aos="fade-right" id="leftInfoColumn">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 sm:mb-6">
            Schedule Your Personal Briefing
          </h2>
          <p class="text-lg text-gray-600 mb-8">
            Get a one-on-one 30-minute briefing with Michael Cabrera to
            understand exactly how USRad reduces imaging costs 50–70% while
            improving employee benefits.
          </p>

          <!-- What to Expect -->
          <div
            class="bg-white rounded-2xl p-6 sm:p-8 mb-8 border border-gray-200 shadow-sm"
          >
            <h3 class="text-xl font-semibold text-gray-900 mb-4">
              What We'll Cover Together
            </h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <span class="text-[#cc9933] mt-1 font-bold">→</span>
                <span class="text-gray-700"
                  >Analysis of your current imaging spend and utilization</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#cc9933] mt-1 font-bold">→</span>
                <span class="text-gray-700"
                  >Detailed savings projection (typically 50–70% reduction)</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#cc9933] mt-1 font-bold">→</span>
                <span class="text-gray-700"
                  >Realistic 30-day implementation timeline for your
                  organization</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#cc9933] mt-1 font-bold">→</span>
                <span class="text-gray-700"
                  >Integration path with your existing TPA and benefits platform</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#cc9933] mt-1 font-bold">→</span>
                <span class="text-gray-700"
                  >Real case studies from employers in your industry</span
                >
              </li>
            </ul>
          </div>

          <!-- Trust Indicators -->
          <div class="grid grid-cols-3 gap-4 text-center">
            <div>
              <div class="text-2xl sm:text-3xl font-bold text-[#cc9933]">
                30+
              </div>
              <div class="text-xs sm:text-sm text-gray-600">
                Years Experience
              </div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-bold text-[#cc9933]">
                168K+
              </div>
              <div class="text-xs sm:text-sm text-gray-600">Cases Managed</div>
            </div>
            <div>
              <div class="text-2xl sm:text-3xl font-bold text-[#cc9933]">
                50–70%
              </div>
              <div class="text-xs sm:text-sm text-gray-600">Avg. Savings</div>
            </div>
          </div>
        </div>

        <!-- Right Column — Form (becomes scheduling panel after submit) -->
        <div data-aos="fade-left" data-aos-delay="100" id="formCardOuter">
          <div
            id="formCard"
            class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-gray-100"
          >
            <EmployerConsultationForm />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial Section -->
  <section class="py-16 sm:py-20 px-4 sm:px-6 bg-white">
    <div class="max-w-4xl mx-auto text-center" data-aos="fade-up">
      <div
        class="bg-slate-50 rounded-2xl shadow-sm border border-gray-100 p-8 sm:p-12"
      >
        <div class="mb-6">
          <span
            class="inline-block bg-[#cc9933]/10 text-[#cc9933] px-4 py-2 rounded-full text-sm font-semibold mb-4"
          >
            A Message From Our President
          </span>
        </div>
        <blockquote
          class="text-xl sm:text-2xl text-gray-700 italic mb-6 leading-relaxed"
        >
          "I built this business on relationships, not transactions. When you
          schedule a briefing, you're getting me directly — not a sales team.
          I'll personally analyze your situation, show you the real savings
          potential, and guide you through implementation. That's how I've
          always done business."
        </blockquote>
        <cite class="text-gray-900 font-semibold not-italic">
          — Michael Cabrera, President & Co-Founder, USRad
        </cite>
        <p class="text-sm text-gray-600 mt-2">
          Founded the managed imaging category with AnciCare (acquired by
          CorVel, NYSE: CVL)
        </p>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section
    class="py-16 px-4 sm:px-6 bg-gradient-to-br from-gray-900 to-gray-800 text-white"
  >
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4" data-aos="fade-up">
        Ready to Transform Your Benefits?
      </h2>
      <p
        class="text-lg sm:text-xl text-gray-300 mb-8"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Join progressive employers saving millions while improving employee
        satisfaction
      </p>
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <a
          href="#consultation-form"
          class="bg-white text-gray-900 px-8 py-4 rounded-xl font-semibold hover:bg-gray-100 transition-all inline-flex items-center justify-center gap-2"
        >
          Schedule 30-Minute Briefing
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
        </a>
        <a
          href="/employer#roi-calculator"
          class="bg-transparent border-2 border-white text-white px-8 py-4 rounded-xl font-semibold hover:bg-white hover:text-gray-900 transition-all inline-flex items-center justify-center gap-2"
        >
          Calculate Your Savings First
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Smooth Scroll Script -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document
        .querySelectorAll('a[href="#consultation-form"]')
        .forEach((anchor) => {
          anchor.addEventListener("click", function (e) {
            e.preventDefault();
            const target = document.querySelector("#consultation-form");
            if (target) {
              target.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          });
        });
    });
  </script>

  <!-- Layout Expansion Script: fires when form signals scheduling is ready -->
  <script>
    function expandToScheduler() {
      const leftCol = document.getElementById("leftInfoColumn");
      if (!leftCol || leftCol.style.display === "none") return;
      leftCol.style.transition = "opacity 0.3s ease";
      leftCol.style.opacity = "0";
      setTimeout(() => {
        leftCol.style.display = "none";
        const formCardOuter = document.getElementById("formCardOuter");
        if (formCardOuter) formCardOuter.style.gridColumn = "1 / -1";
        const formCard = document.getElementById("formCard");
        if (formCard) {
          formCard.style.background = "transparent";
          formCard.style.boxShadow = "none";
          formCard.style.border = "none";
          formCard.style.padding = "0";
          formCard.style.borderRadius = "0";
        }
      }, 320);
    }

    window.addEventListener("usrad:schedulingReady", () => {
      // 1. Fade out the left info column
      const leftCol = document.getElementById("leftInfoColumn");
      if (leftCol) {
        leftCol.style.transition = "opacity 0.3s ease";
        leftCol.style.opacity = "0";
        setTimeout(() => {
          leftCol.style.display = "none";

          // 2. Expand form card column to full width
          const formCardOuter = document.getElementById("formCardOuter");
          if (formCardOuter) {
            formCardOuter.style.gridColumn = "1 / -1";
          }

          // 3. Strip the white card shell so scheduling grid has full section width
          const formCard = document.getElementById("formCard");
          if (formCard) {
            formCard.style.background = "transparent";
            formCard.style.boxShadow = "none";
            formCard.style.border = "none";
            formCard.style.padding = "0";
            formCard.style.borderRadius = "0";
          }
        }, 320);
      }
    });

    // Handle ?continue=1 on page load — bypasses event timing race
    if (new URLSearchParams(window.location.search).get("continue") === "1") {
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", expandToScheduler);
      } else {
        expandToScheduler();
      }
    }
  </script>
</CarbonLayout>
