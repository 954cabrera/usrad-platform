---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="Frequently Asked Questions - USRad"
  description="Get answers to common questions about MRI scans, pricing, cancellations, refunds, and our imaging services."
>
  <AOSInit />

  <!-- Hero Section -->
  <section
    class="relative bg-gradient-to-b from-blue-50 to-white overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-grid-slate-100 [mask-image:linear-gradient(0deg,white,rgba(255,255,255,0.6))] -z-10"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16">
      <div class="text-center" data-aos="fade-up">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6"
        >
          Frequently Asked Questions
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Everything you need to know about getting an affordable MRI scan with
          USRad
        </p>
      </div>

      <!-- Search Bar -->
      <div
        class="max-w-2xl mx-auto mt-10"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="relative">
          <input
            type="text"
            id="faq-search"
            class="w-full px-6 py-4 pr-12 text-lg border-2 border-gray-200 rounded-full focus:outline-none focus:border-[#003087] transition-colors"
            placeholder="Search for answers..."
          />
          <button
            class="absolute right-2 top-1/2 -translate-y-1/2 p-3 text-gray-400 hover:text-[#003087]"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Guarantee Banner - NEW -->
  <section class="bg-gradient-to-r from-[#003087] to-[#001F4D] py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-col md:flex-row items-center justify-between gap-6"
        data-aos="fade-up"
      >
        <div class="flex items-center gap-4">
          <div
            class="w-14 h-14 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center flex-shrink-0"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>
          <div class="text-white">
            <h2 class="text-xl md:text-2xl font-bold">The USRad Guarantee</h2>
            <p class="text-blue-100 text-sm md:text-base">
              If your exam doesn't happen, you don't pay. One payment covers
              everything — no surprise bills.
            </p>
          </div>
        </div>
        <a
          href="/patient-promise"
          class="inline-flex items-center gap-2 bg-white text-[#003087] px-6 py-3 rounded-full font-semibold hover:bg-blue-50 transition-all transform hover:scale-105 whitespace-nowrap"
        >
          Learn More
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Categories -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Category Tabs -->
      <div
        class="flex flex-wrap justify-center gap-2 md:gap-4 mb-12"
        data-aos="fade-up"
      >
        <button
          class="category-tab active px-6 py-3 rounded-full text-sm md:text-base font-medium bg-[#003087] text-white transition-all"
          data-category="pricing"
        >
          Pricing & Policies
        </button>
        <button
          class="category-tab px-6 py-3 rounded-full text-sm md:text-base font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-all"
          data-category="process"
        >
          Booking & Process
        </button>
        <button
          class="category-tab px-6 py-3 rounded-full text-sm md:text-base font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-all"
          data-category="preparation"
        >
          Preparation
        </button>
        <button
          class="category-tab px-6 py-3 rounded-full text-sm md:text-base font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-all"
          data-category="results"
        >
          Results & Reports
        </button>
        <button
          class="category-tab px-6 py-3 rounded-full text-sm md:text-base font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-all"
          data-category="general"
        >
          General
        </button>
      </div>

      <!-- FAQ Content -->
      <div class="max-w-4xl mx-auto">
        <!-- Pricing & Policies Section (formerly Pricing & Payment) -->
        <div class="faq-section active" data-section="pricing">
          <div class="space-y-4">
            <!-- EXISTING: How much does an MRI cost -->
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  How much does an MRI cost at USRad?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  MRI scans at USRad network facilities typically cost
                  <strong>$260–$650</strong>, which is up to 80% less than
                  hospital prices. The exact cost depends on the type of MRI and
                  the body part being scanned. We provide transparent, upfront
                  pricing with no hidden fees or surprise bills.
                </p>
              </div>
            </div>

            <!-- EXISTING: Do I need insurance -->
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="50"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Do I need insurance to get an MRI at USRad?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  No, you don't need insurance! USRad specializes in providing
                  affordable imaging to Americans who are uninsured or
                  underinsured. We offer transparent cash prices
                  that are often lower than insurance copays and deductibles.
                </p>
              </div>
            </div>

            <!-- NEW: Does my payment cover everything? -->
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="75"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Does my payment cover everything?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed mb-3">
                  <strong>Yes — one payment covers everything.</strong> Your USRad
                  price includes:
                </p>
                <ul class="list-disc list-inside space-y-1 text-gray-600 mb-3">
                  <li>The imaging facility fee (the scan itself)</li>
                  <li>The radiologist fee (the doctor who reads your scan)</li>
                  <li>Digital results delivered to you and your doctor</li>
                </ul>
                <p class="text-gray-600 leading-relaxed">
                  You'll never receive a surprise bill from the imaging center
                  or radiologist. If anyone asks for additional payment related
                  to your prepaid exam — don't pay it. Contact us immediately.
                  <a
                    href="/patient-promise"
                    class="text-[#003087] font-medium hover:underline ml-1"
                    >See our full guarantee →</a
                  >
                </p>
              </div>
            </div>

            <!-- EXISTING: What payment methods (UPDATED) -->
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="100"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  What payment methods do you accept?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed mb-3">We accept:</p>
                <ul class="list-disc list-inside space-y-1 text-gray-600 mb-3">
                  <li>
                    All major credit cards (Visa, Mastercard, American Express,
                    Discover)
                  </li>
                  <li>Debit cards</li>
                  <li>HSA (Health Savings Account) cards</li>
                  <li>FSA (Flexible Spending Account) cards</li>
                </ul>
                <p class="text-gray-600 leading-relaxed">
                  <strong>Payment is due within 24 hours of scheduling.</strong>
                  For same-day or next-day appointments, payment is required immediately
                  to lock in your time slot.
                </p>
              </div>
            </div>

            <!-- EXISTING: Why are prices so low -->
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="125"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Why are USRad prices so much lower than hospitals?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  Our network of independent imaging centers operates with lower
                  overhead than hospitals. We don't have emergency room costs,
                  complex billing departments, or insurance negotiations. These
                  savings are passed directly to you, making quality imaging
                  affordable for everyone.
                </p>
              </div>
            </div>

            <!-- Policy Subsection Divider -->
            <div class="py-4" data-aos="fade-up" data-aos-delay="150">
              <div class="flex items-center gap-4">
                <div class="flex-1 h-px bg-gray-200"></div>
                <span
                  class="text-sm font-semibold text-[#003087] uppercase tracking-wide"
                  >Cancellations & Refunds</span
                >
                <div class="flex-1 h-px bg-gray-200"></div>
              </div>
            </div>

            <!-- NEW: How do I cancel or reschedule -->
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="175"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  How do I cancel or reschedule my appointment?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed mb-3">
                  <strong
                    >Cancel or reschedule in less than a minute through your
                    USRad Member Portal</strong
                  > — available 24/7 with instant confirmation.
                </p>
                <p class="text-gray-600 leading-relaxed mb-3">
                  When you cancel through the portal:
                </p>
                <ul class="list-disc list-inside space-y-1 text-gray-600 mb-3">
                  <li>Your refund is triggered instantly (when eligible)</li>
                  <li>The imaging center is notified in real-time</li>
                  <li>You receive confirmation on screen and via email</li>
                </ul>
                <div
                  class="bg-amber-50 border border-amber-200 rounded-lg p-3 mt-3"
                >
                  <p class="text-amber-800 text-sm">
                    <strong>Important:</strong> Don't call the imaging center to
                    cancel — they can't modify USRad appointments. If you cancel
                    with them instead of us, your refund won't process.
                  </p>
                </div>
              </div>
            </div>

            <!-- NEW: Cancellation policy -->
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="200"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  What is your cancellation policy?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed mb-3">
                  We keep it simple with a <strong
                    >24-hour cancellation policy</strong
                  >:
                </p>
                <div class="bg-gray-50 rounded-lg p-4 mb-3">
                  <div
                    class="flex justify-between items-center py-2 border-b border-gray-200"
                  >
                    <span class="text-gray-700">Cancel 24+ hours before</span>
                    <span class="font-semibold text-green-600">100% refund</span
                    >
                  </div>
                  <div class="flex justify-between items-center py-2">
                    <span class="text-gray-700"
                      >Cancel less than 24 hours before</span
                    >
                    <span class="font-semibold text-amber-600">75% refund</span>
                  </div>
                </div>
                <p class="text-gray-500 text-sm italic">
                  Why 24 hours? When you cancel last-minute, the imaging center
                  loses that slot — and another member misses out on affordable
                  care.
                </p>
                <a
                  href="/patient-promise#cancellation"
                  class="inline-block mt-3 text-[#003087] font-medium hover:underline text-sm"
                  >See full cancellation policy →</a
                >
              </div>
            </div>

            <!-- NEW: What if I miss my appointment -->
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="225"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  What happens if I miss my appointment?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed mb-3">
                  If you don't show up and don't cancel, it's treated the same
                  as a late cancellation:
                </p>
                <ul class="list-disc list-inside space-y-1 text-gray-600 mb-3">
                  <li>
                    <strong>You'll receive a 75% refund</strong> (25% no-show fee
                    applies)
                  </li>
                  <li>
                    You'll need to book a new appointment if you still want the
                    exam
                  </li>
                </ul>
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-3">
                  <p class="text-blue-800 text-sm">
                    <strong>Life happens.</strong> If you missed due to a medical
                    emergency, car trouble, or something outside your control — reach
                    out. We review special circumstances with compassion.
                  </p>
                </div>
              </div>
            </div>

            <!-- NEW: How do I get a refund -->
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="250"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  How do I get a refund?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed mb-3">
                  <strong>The fastest way:</strong> Cancel through your USRad Member
                  Portal — your refund starts processing immediately.
                </p>
                <p class="text-gray-600 leading-relaxed mb-3">
                  Refunds are processed within <strong
                    >5–10 business days</strong
                  >. Most members see it in under a week, depending on your
                  bank.
                </p>
                <p class="text-gray-600 leading-relaxed">
                  Can't access the portal? Email <a
                    href="mailto:support@usrad.com"
                    class="text-[#003087] font-medium hover:underline"
                    >support@usrad.com</a
                  > and we'll handle it within one business day.
                </p>
              </div>
            </div>

            <!-- NEW: What if imaging center cancels -->
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="275"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  What if the imaging center cancels my appointment?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed mb-3">
                  If the imaging center can't complete your exam due to
                  equipment issues, staffing problems, or scheduling conflicts
                  on their end — <strong>you're fully protected.</strong>
                </p>
                <p class="text-gray-600 leading-relaxed mb-3">
                  You'll receive either:
                </p>
                <ul class="list-disc list-inside space-y-1 text-gray-600 mb-3">
                  <li>A <strong>full refund</strong>, or</li>
                  <li>
                    A <strong>rescheduled appointment</strong> at no extra cost
                  </li>
                </ul>
                <p class="text-gray-600 font-medium italic">
                  USRad absorbs the risk — not you.
                </p>
              </div>
            </div>

            <!-- NEW: Money-back guarantee -->
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="300"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Do you offer a money-back guarantee?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed mb-3">
                  <strong>Yes!</strong> Every USRad appointment comes with a simple
                  promise: <strong
                    >if your exam doesn't happen, you don't pay.</strong
                  >
                </p>
                <p class="text-gray-600 leading-relaxed mb-3">
                  Whether the center cancels, equipment fails, or the study
                  can't be completed for any reason outside your control —
                  you'll receive a full refund, no questions asked.
                </p>
                <a
                  href="/patient-promise"
                  class="inline-flex items-center gap-2 bg-[#003087] text-white px-4 py-2 rounded-lg font-medium hover:bg-[#002266] transition text-sm"
                >
                  Learn About Our Guarantee
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Booking & Process Section -->
        <div class="faq-section hidden" data-section="process">
          <div class="space-y-4">
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
