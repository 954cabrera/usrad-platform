---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="Frequently Asked Questions - USRad"
  description="Get answers to common questions about MRI scans, pricing, and our imaging services."
>
  <AOSInit />

  <!-- Hero Section -->
  <section
    class="relative bg-gradient-to-b from-blue-50 to-white overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-grid-slate-100 [mask-image:linear-gradient(0deg,white,rgba(255,255,255,0.6))] -z-10"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16">
      <div class="text-center" data-aos="fade-up">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6"
        >
          Frequently Asked Questions
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Everything you need to know about getting an affordable MRI scan with
          USRad
        </p>
      </div>

      <!-- Search Bar -->
      <div
        class="max-w-2xl mx-auto mt-10"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="relative">
          <input
            type="text"
            id="faq-search"
            class="w-full px-6 py-4 pr-12 text-lg border-2 border-gray-200 rounded-full focus:outline-none focus:border-[#003087] transition-colors"
            placeholder="Search for answers..."
          />
          <button
            class="absolute right-2 top-1/2 -translate-y-1/2 p-3 text-gray-400 hover:text-[#003087]"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Categories -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Category Tabs -->
      <div
        class="flex flex-wrap justify-center gap-2 md:gap-4 mb-12"
        data-aos="fade-up"
      >
        <button
          class="category-tab active px-6 py-3 rounded-full text-sm md:text-base font-medium bg-[#003087] text-white transition-all"
          data-category="pricing"
        >
          Pricing & Payment
        </button>
        <button
          class="category-tab px-6 py-3 rounded-full text-sm md:text-base font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-all"
          data-category="process"
        >
          Booking & Process
        </button>
        <button
          class="category-tab px-6 py-3 rounded-full text-sm md:text-base font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-all"
          data-category="preparation"
        >
          Preparation
        </button>
        <button
          class="category-tab px-6 py-3 rounded-full text-sm md:text-base font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-all"
          data-category="results"
        >
          Results & Reports
        </button>
        <button
          class="category-tab px-6 py-3 rounded-full text-sm md:text-base font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 transition-all"
          data-category="general"
        >
          General
        </button>
      </div>

      <!-- FAQ Content -->
      <div class="max-w-4xl mx-auto">
        <!-- Pricing & Payment Section -->
        <div class="faq-section active" data-section="pricing">
          <div class="space-y-4">
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  How much does an MRI cost at USRad?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  MRI scans at USRad network facilities typically cost
                  <strong>$260–$650</strong>, which is up to 80% less than
                  hospital prices. The exact cost depends on the type of MRI and
                  the body part being scanned. We provide transparent, upfront
                  pricing with no hidden fees or surprise bills.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="50"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Do I need insurance to get an MRI at USRad?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  No, you don't need insurance! USRad specializes in providing
                  affordable imaging to the 90 million Americans who are
                  uninsured or underinsured. We offer transparent cash prices
                  that are often lower than insurance copays and deductibles.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="100"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  What payment methods do you accept?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  We accept cash, all major credit cards, debit cards, HSA/FSA
                  cards, and personal checks. Payment plans are available for
                  those who qualify. Payment is due at the time of service.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="150"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Why are USRad prices so much lower than hospitals?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  Our network of independent imaging centers operates with lower
                  overhead than hospitals. We don't have emergency room costs,
                  complex billing departments, or insurance negotiations. These
                  savings are passed directly to you, making quality imaging
                  affordable for everyone.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Booking & Process Section -->
        <div class="faq-section hidden" data-section="process">
          <div class="space-y-4">
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  How do I book an MRI appointment?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed mb-3">
                  Booking is simple:
                </p>
                <ol class="list-decimal list-inside space-y-2 text-gray-600">
                  <li>
                    Enter your ZIP code on our website to find nearby centers
                  </li>
                  <li>Choose a convenient location and time</li>
                  <li>
                    Provide basic information and upload your doctor's order
                  </li>
                  <li>
                    Receive instant confirmation with preparation instructions
                  </li>
                </ol>
                <p class="text-gray-600 mt-3">
                  Most appointments are available within 24-48 hours.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="50"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Do I need a doctor's referral?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  Yes, all MRI scans require a physician's order. If you don't
                  have one, our partner telehealth physicians can evaluate your
                  symptoms and provide an order if medically appropriate. This
                  service is available for an additional fee.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="100"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  How long does an MRI scan take?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  Most MRI scans take 15-45 minutes, depending on the body part
                  being examined. Plan to be at the facility for about an hour
                  total to allow time for check-in, changing clothes, and the
                  scan itself.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="150"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  What happens during the MRI scan?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  You'll lie on a comfortable table that slides into the MRI
                  machine. The machine makes loud knocking sounds, so we provide
                  earplugs or headphones with music. It's important to stay
                  still during the scan. Our technologists will communicate with
                  you throughout and you'll have a call button if you need
                  assistance.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Preparation Section -->
        <div class="faq-section hidden" data-section="preparation">
          <div class="space-y-4">
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  How should I prepare for my MRI?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed mb-3">
                  General preparation guidelines:
                </p>
                <ul class="list-disc list-inside space-y-2 text-gray-600">
                  <li>
                    Wear comfortable clothing without metal (zippers, buttons,
                    underwire)
                  </li>
                  <li>Remove all jewelry, watches, and piercings</li>
                  <li>Leave valuables at home</li>
                  <li>Arrive 15 minutes early for paperwork</li>
                  <li>
                    Continue taking medications unless instructed otherwise
                  </li>
                </ul>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="50"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Can I eat before my MRI?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  For most MRI scans, you can eat and drink normally. However,
                  some abdominal scans may require fasting for 4-6 hours. Your
                  appointment confirmation will include specific instructions
                  for your scan type.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="100"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  What if I'm claustrophobic?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  Many of our centers have wide-bore MRI machines that are more
                  spacious and comfortable. Let us know about your concerns when
                  booking. Options include bringing a friend, using relaxation
                  techniques, or in some cases, your doctor may prescribe a mild
                  sedative.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="150"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Can I have an MRI if I have metal implants?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  Some metal implants are MRI-safe, while others are not. Please
                  inform us about any implants, including pacemakers, cochlear
                  implants, aneurysm clips, or joint replacements. We'll verify
                  if your implant is MRI-compatible before your appointment.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Results & Reports Section -->
        <div class="faq-section hidden" data-section="results">
          <div class="space-y-4">
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  When will I get my results?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  A board-certified radiologist will review your images and send
                  a detailed report to your doctor within 24-48 hours. Your
                  doctor will discuss the results with you. In urgent cases,
                  preliminary results may be available sooner.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="50"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Can I get a copy of my MRI images?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  Yes! You can request a CD of your images at the time of your
                  appointment for a small fee, or access them through our secure
                  online portal. Many patients find it helpful to keep copies
                  for their records or future medical visits.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="100"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Who reads my MRI scan?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  Your MRI is interpreted by a board-certified radiologist who
                  specializes in reading medical images. Our radiologists have
                  completed extensive training and many have subspecialty
                  expertise in specific body areas.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="150"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  What if I need to share my results with another doctor?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  We can send your images and reports to any healthcare provider
                  with your written consent. Digital sharing through our secure
                  portal makes it easy to get second opinions or continue care
                  with specialists.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- General Section -->
        <div class="faq-section hidden" data-section="general">
          <div class="space-y-4">
            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
            >
              <button
                class="w-full px-6 py-5 flex items-center justify-between text-left"
              >
                <h3 class="text-lg font-semibold text-gray-900 pr-8">
                  Is the quality the same as hospital MRIs?
                </h3>
                <svg
                  class="w-6 h-6 text-gray-400 transform transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-gray-600 leading-relaxed">
                  Absolutely. Our network centers use the same high-quality MRI
                  machines as hospitals, including advanced 3T scanners. All
                  facilities are accredited and staffed by certified
                  technologists. The only difference is the price.
                </p>
              </div>
            </div>

            <div
              class="faq-item bg-white border border-gray-200 rounded-2xl hover:shadow-lg transition-shadow"
              data-aos="fade-up"
              data-aos-delay="50"
            >
              <button
