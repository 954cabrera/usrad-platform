---
// src/pages/holding.astro - A test page to verify domain is working
// Access at: usrad.com/holding
// Delete this file when ready to go live
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>USRad | Coming Soon</title>
    <meta
      name="description"
      content="USRad - Revolutionizing radiology services. Coming soon."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu,
          sans-serif;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #f8fafc;
        padding: 2rem;
        text-align: center;
      }

      .container {
        max-width: 600px;
      }

      .logo {
        display: block;
        margin: 0 auto 1rem auto;
        max-width: 280px;
        height: auto;
      }

      .tagline {
        font-size: 1.25rem;
        color: #94a3b8;
        margin-bottom: 3rem;
      }

      .message {
        font-size: 1.125rem;
        line-height: 1.7;
        color: #cbd5e1;
        margin-bottom: 2rem;
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 9999px;
        font-size: 0.875rem;
        color: #60a5fa;
      }

      .pulse {
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
      }

      .contact {
        margin-top: 3rem;
        font-size: 0.875rem;
        color: #64748b;
      }

      .contact a {
        color: #60a5fa;
        text-decoration: none;
      }

      .contact a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <img
        src="/logo/USRad-Logo-final-white-text.png"
        alt="USRad"
        class="logo"
      />
      <p class="tagline">Radiology Services Reimagined</p>

      <p class="message">
        We're building something new to transform how radiology services are
        delivered. Our platform is currently in development and will be
        launching soon.
      </p>

      <div class="status">
        <span class="pulse"></span>
        In Development
      </div>

      <div class="contact">
        <p>
          Questions? Reach out at <a href="mailto:info@usrad.com"
            >info@usrad.com</a>
        </p>
      </div>
    </div>
  </body>
</html>
