  <script>
    // No longer needed - using real form submission

    // Option Selection
    function selectOption(element) {
      // Remove selected from all
      document.querySelectorAll(".comparison-card").forEach((card) => {
        card.classList.remove("selected");
      });
      // Add selected to clicked
      element.classList.add("selected");
    }

    // Progress Tracking
    const sections = ["search", "compare", "book", "complete"];
    const sectionElements = sections.map((id) =>
      document.getElementById(`${id}-section`)
    );
    const progressNodes = document.querySelectorAll(".progress-node");

    // Intersection Observer for Progress
    const observerOptions = {
      threshold: 0.5,
      rootMargin: "-100px 0px",
    };

    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const sectionId = entry.target.id.replace("-section", "");
          updateProgress(sectionId);
        }
      });
    }, observerOptions);

    // Observe sections
    sectionElements.forEach((section) => {
      if (section) sectionObserver.observe(section);
    });

    // Update Progress
    function updateProgress(currentSection) {
      progressNodes.forEach((node) => {
        node.classList.remove("active");
        if (node.dataset.section === currentSection) {
          node.classList.add("active");
        }
      });

      // Update journey preview
      document.querySelectorAll(".journey-step-preview").forEach((step) => {
        step.classList.remove("active");
        const stepMap = { search: "1", compare: "2", book: "3", complete: "4" };
        if (step.dataset.step === stepMap[currentSection]) {
          step.classList.add("active");
        }
      });
    }

    // Progress Node Clicks
    progressNodes.forEach((node) => {
      node.addEventListener("click", () => {
        const targetSection = document.getElementById(
          `${node.dataset.section}-section`
        );
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      });
    });

    // Journey Step Preview Clicks
    document.querySelectorAll(".journey-step-preview").forEach((step) => {
      step.addEventListener("click", () => {
        const stepMap = {
          "1": "search",
          "2": "compare",
          "3": "book",
          "4": "complete",
        };
        const targetSection = document.getElementById(
          `${stepMap[step.dataset.step]}-section`
        );
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });

    // Add smooth scrolling to all sections
    document.addEventListener("DOMContentLoaded", () => {
      // Set initial progress
      updateProgress("search");
    });
  </script>
</CarbonLayout>
