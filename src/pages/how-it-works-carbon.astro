---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="How USRad Works - Your Journey to Affordable Medical Imaging"
  isHeroPage={false}
>
  <AOSInit />

  <!-- Interactive Hero with Journey Path -->
  <section
    class="relative pt-32 pb-20 px-4 sm:px-6 overflow-hidden bg-gradient-to-br from-slate-900 via-[#003087] to-teal-900"
  >
    <!-- Animated Journey Path Background -->
    <div class="absolute inset-0 opacity-20">
      <svg
        class="w-full h-full"
        viewBox="0 0 1200 600"
        preserveAspectRatio="none"
      >
        <path
          id="journey-path"
          d="M 0,300 Q 300,100 600,300 T 1200,300"
          stroke="#00CED1"
          stroke-width="3"
          fill="none"
          stroke-dasharray="5,5"
          class="animate-dash"></path>
        <!-- Animated dots along path -->
        <circle r="8" fill="#00CED1" class="journey-dot-1">
          <animateMotion dur="10s" repeatCount="indefinite">
            <mpath href="#journey-path"></mpath>
          </animateMotion>
        </circle>
        <circle r="6" fill="#40E0D0" class="journey-dot-2">
          <animateMotion dur="10s" begin="2s" repeatCount="indefinite">
            <mpath href="#journey-path"></mpath>
          </animateMotion>
        </circle>
        <circle r="7" fill="#00CED1" class="journey-dot-3">
          <animateMotion dur="10s" begin="4s" repeatCount="indefinite">
            <mpath href="#journey-path"></mpath>
          </animateMotion>
        </circle>
      </svg>
    </div>

    <!-- Floating Elements -->
    <div
      class="absolute top-20 right-10 w-64 h-64 bg-teal-500/20 rounded-full blur-3xl animate-float"
    >
    </div>
    <div
      class="absolute bottom-10 left-20 w-96 h-96 bg-[#003087]/30 rounded-full blur-3xl animate-float-delayed"
    >
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="text-center">
        <!-- Interactive Badge -->
        <div
          class="inline-flex items-center gap-2 bg-teal-500/20 backdrop-blur-sm rounded-full px-6 py-3 mb-8 cursor-pointer hover:bg-teal-500/30 transition-all"
          data-aos="fade-down"
        >
          <span class="w-2 h-2 bg-teal-400 rounded-full animate-pulse"></span>
          <span class="text-teal-100 text-sm font-medium"
            >Interactive Journey Guide</span
          >
          <svg
            class="w-4 h-4 text-teal-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </div>

        <h1
          class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold mb-8 text-white leading-tight tracking-tight"
          data-aos="fade-up"
        >
          Your Journey to
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-300 drop-shadow-lg"
          >
            Affordable Imaging
          </span>
        </h1>

        <p
          class="text-xl md:text-2xl text-gray-200 max-w-3xl mx-auto mb-12 leading-relaxed"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          Four simple steps. Zero confusion. Total transparency. Let's walk
          through your path to answers.
        </p>

        <!-- Journey Preview -->
        <div
          class="flex justify-center items-center gap-4 flex-wrap"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div class="journey-step-preview active" data-step="1">
            <span class="step-number">1</span>
            <span class="step-label">Search</span>
          </div>
          <div class="journey-connector"></div>
          <div class="journey-step-preview" data-step="2">
            <span class="step-number">2</span>
            <span class="step-label">Compare</span>
          </div>
          <div class="journey-connector"></div>
          <div class="journey-step-preview" data-step="3">
            <span class="step-number">3</span>
            <span class="step-label">Book</span>
          </div>
          <div class="journey-connector"></div>
          <div class="journey-step-preview" data-step="4">
            <span class="step-number">✓</span>
            <span class="step-label">Done</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fixed Progress Sidebar (Desktop) -->
  <div
    class="fixed left-8 top-1/2 transform -translate-y-1/2 z-50 hidden lg:block"
  >
    <div class="bg-white/10 backdrop-blur-md rounded-full p-4">
      <div class="space-y-6">
        <div class="progress-node active" data-section="search">
          <span class="node-icon">🔍</span>
          <span class="node-tooltip">Search</span>
        </div>
        <div class="progress-connector"></div>
        <div class="progress-node" data-section="compare">
          <span class="node-icon">⚖️</span>
          <span class="node-tooltip">Compare</span>
        </div>
        <div class="progress-connector"></div>
        <div class="progress-node" data-section="book">
          <span class="node-icon">📅</span>
          <span class="node-tooltip">Book</span>
        </div>
        <div class="progress-connector"></div>
        <div class="progress-node" data-section="complete">
          <span class="node-icon">✅</span>
          <span class="node-tooltip">Complete</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 1: Search - Interactive Demo -->
  <section
    id="search-section"
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-white to-teal-50/30 relative overflow-hidden"
  >
    <div class="absolute inset-0 opacity-5">
      <div
        class="absolute inset-0"
        style="background-image: repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(0,206,209,.1) 35px, rgba(0,206,209,.1) 70px);"
      >
      </div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div data-aos="fade-right">
          <div
            class="inline-flex items-center gap-2 bg-teal-100 text-teal-800 rounded-full px-4 py-2 mb-6"
          >
            <span class="text-lg font-bold">Step 1</span>
            <span class="w-1 h-1 bg-teal-600 rounded-full"></span>
            <span class="text-sm font-medium">15 seconds</span>
          </div>

          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Start with Your ZIP Code
          </h2>

          <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            No phone calls. No waiting on hold. Just enter your location and
            instantly see every quality imaging center near you.
          </p>

          <!-- Interactive ZIP Demo -->
          <div class="bg-white rounded-2xl shadow-xl p-6 mb-8">
            <div class="flex items-center justify-between mb-4">
              <label class="block text-sm font-semibold text-gray-700"
                >Try it yourself:</label
              >
              <span
                class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full"
                >MRI Lumbar Spine</span
              >
            </div>
            <form action="/search-results" method="GET" class="flex gap-3">
              <input
                type="text"
                name="zipCode"
                id="demo-zip"
                placeholder="Enter your ZIP code"
                pattern="[0-9]{5}"
                maxlength="5"
                required
                class="flex-1 px-4 py-3 rounded-lg border-2 border-gray-200 focus:border-teal-500 focus:outline-none transition-colors"
              />
              <input type="hidden" name="procedure" value="72148" />
              <input type="hidden" name="autoSearch" value="true" />
              <button
                type="submit"
                class="bg-teal-500 hover:bg-teal-600 text-white px-6 py-3 rounded-lg font-medium transition-colors"
              >
                Search
              </button>
            </form>
            <p class="text-xs text-gray-500 mt-3">
              💡 This is a real search - enter your ZIP code to see actual
              prices near you
            </p>
          </div>

          <!-- What happens -->
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div
                class="w-6 h-6 bg-teal-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1"
              >
                <span class="text-teal-600 text-xs">✓</span>
              </div>
              <p class="text-gray-700">Instantly see all available centers</p>
            </div>
            <div class="flex items-start gap-3">
              <div
                class="w-6 h-6 bg-teal-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1"
              >
                <span class="text-teal-600 text-xs">✓</span>
              </div>
              <p class="text-gray-700">Real prices displayed upfront</p>
            </div>
            <div class="flex items-start gap-3">
              <div
                class="w-6 h-6 bg-teal-100 rounded-full flex items-center justify-center flex-shrink-0 mt-1"
              >
                <span class="text-teal-600 text-xs">✓</span>
              </div>
              <p class="text-gray-700">Filter by distance, price, or rating</p>
            </div>
          </div>
        </div>

        <div class="relative" data-aos="fade-left">
          <!-- Interactive Map Visualization -->
          <div
            class="bg-white rounded-2xl shadow-2xl p-8 relative overflow-hidden"
          >
            <div class="absolute top-4 right-4">
              <span
                class="bg-green-100 text-green-700 text-xs font-medium px-3 py-1 rounded-full"
                >Live Demo</span
              >
            </div>

            <!-- Simulated search interface -->
            <div class="mb-6">
              <div class="text-xs text-gray-500 mb-2">
                Showing results for: MRI Lumbar Spine • ZIP: 33025
              </div>
              <div
                class="h-56 bg-gradient-to-br from-blue-50 to-teal-50 rounded-lg relative overflow-hidden"
              >
                <!-- Map styling -->
                <div class="absolute inset-0 opacity-10">
                  <div
                    class="absolute top-10 left-10 w-32 h-32 border-2 border-gray-300 rounded-full"
                  >
                  </div>
                  <div
                    class="absolute bottom-10 right-10 w-24 h-24 border-2 border-gray-300 rounded-full"
                  >
                  </div>
                </div>

                <!-- Your location -->
                <div
                  class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"
                >
                  <div class="w-4 h-4 bg-blue-500 rounded-full animate-pulse">
                  </div>
                  <div
                    class="text-xs bg-blue-500 text-white rounded px-2 py-1 mt-1 font-medium"
                  >
                    You
                  </div>
                </div>

                <!-- Animated pins with center names -->
                <div
                  class="absolute top-1/4 left-1/4 transform -translate-x-1/2 -translate-y-1/2"
                >
                  <div class="map-pin animate-bounce-slow">📍</div>
                  <div class="text-xs bg-white rounded px-2 py-1 shadow mt-1">
                    <span class="font-semibold text-teal-600">$260</span>
                    <span class="block text-gray-500">2.3 mi</span>
                  </div>
                </div>
                <div
                  class="absolute top-1/2 left-3/4 transform -translate-x-1/2 -translate-y-1/2"
                >
                  <div class="map-pin animate-bounce-slow animation-delay-200">
                    📍
                  </div>
                  <div class="text-xs bg-white rounded px-2 py-1 shadow mt-1">
                    <span class="font-semibold text-gray-700">$310</span>
                    <span class="block text-gray-500">3.7 mi</span>
                  </div>
                </div>
                <div
                  class="absolute bottom-1/4 right-1/4 transform translate-x-1/2 -translate-y-1/2"
                >
                  <div class="map-pin animate-bounce-slow animation-delay-400">
                    📍
                  </div>
                  <div class="text-xs bg-white rounded px-2 py-1 shadow mt-1">
                    <span class="font-semibold text-gray-700">$295</span>
                    <span class="block text-gray-500">4.1 mi</span>
                  </div>
                </div>
              </div>

              <!-- Map legend -->
              <div
                class="flex items-center justify-between mt-3 text-xs text-gray-600"
              >
                <span>📍 Imaging Centers</span>
                <span class="text-green-600 font-medium"
                  >✓ All centers MRI-ready</span
                >
              </div>
            </div>

            <!-- Results preview -->
            <div class="space-y-3">
              <div
                class="bg-gray-50 rounded-lg p-3 hover:bg-gray-100 transition-colors cursor-pointer"
              >
                <div class="flex justify-between items-start">
                  <div>
                    <p class="font-medium text-gray-900">
                      Imaging Center of Miami
                    </p>
                    <p class="text-sm text-gray-600">
                      2.3 miles • 4.9★ • Next appt: Tomorrow 10am
                    </p>
                  </div>
                  <div class="text-right">
                    <span class="text-xl font-bold text-teal-600">$260</span>
                    <span class="text-xs text-gray-500 block">MRI Lumbar</span>
                  </div>
                </div>
              </div>
              <div
                class="bg-gray-50 rounded-lg p-3 hover:bg-gray-100 transition-colors cursor-pointer"
              >
                <div class="flex justify-between items-start">
                  <div>
                    <p class="font-medium text-gray-900">
                      Advanced Diagnostics
                    </p>
                    <p class="text-sm text-gray-600">
                      3.7 miles • 4.8★ • Next appt: Today 3pm
                    </p>
                  </div>
                  <div class="text-right">
                    <span class="text-xl font-bold text-gray-700">$295</span>
                    <span class="text-xs text-gray-500 block">MRI Lumbar</span>
                  </div>
                </div>
              </div>
              <div class="bg-gray-50 rounded-lg p-3 opacity-60">
                <div class="flex justify-between items-start">
                  <div>
                    <p class="font-medium text-gray-900">
                      Premium Medical Imaging
                    </p>
                    <p class="text-sm text-gray-600">
                      4.1 miles • 4.7★ • Next appt: Thursday
                    </p>
                  </div>
                  <div class="text-right">
                    <span class="text-xl font-bold text-gray-700">$310</span>
                    <span class="text-xs text-gray-500 block">MRI Lumbar</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating feature cards -->
          <div
            class="absolute -top-4 -right-4 bg-white rounded-lg shadow-lg p-3 transform rotate-3 hover:rotate-0 transition-transform"
          >
            <p class="text-sm font-medium text-gray-900">No Login Required</p>
          </div>
          <div
            class="absolute -bottom-4 -left-4 bg-white rounded-lg shadow-lg p-3 transform -rotate-3 hover:rotate-0 transition-transform"
          >
            <p class="text-sm font-medium text-gray-900">100% Free Search</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Step 2: Compare - Interactive Comparison Tool -->
  <section
    id="compare-section"
    class="py-24 px-4 sm:px-6 bg-white relative overflow-hidden"
  >
    <div class="absolute inset-0 opacity-5">
      <div
        class="absolute inset-0"
        style="background-image: radial-gradient(circle at 2px 2px, #00CED1 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1" data-aos="fade-right">
          <!-- Interactive Comparison Tool -->
          <div
            class="bg-gradient-to-br from-teal-50 to-white rounded-2xl shadow-xl p-6"
          >
            <h3 class="font-semibold text-gray-900 mb-4">
              Compare Your Options
            </h3>

            <!-- Comparison Cards -->
            <div class="space-y-4">
              <!-- Option 1 -->
              <div
                class="comparison-card border-2 border-gray-200 rounded-lg p-4 cursor-pointer hover:border-teal-500 transition-all"
                onclick="selectOption(this)"
              >
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <h4 class="font-medium text-gray-900">
                      Miami Medical Imaging
                    </h4>
                    <p class="text-xs text-gray-500 mt-1">
                      MRI Lumbar Spine (CPT: 72148)
                    </p>
                  </div>
                  <span class="text-2xl font-bold text-teal-600">$260</span>
                </div>
                <div class="grid grid-cols-3 gap-4 text-sm">
                  <div>
                    <p class="text-gray-500">Distance</p>
                    <p class="font-medium">2.3 mi</p>
                  </div>
                  <div>
                    <p class="text-gray-500">Wait Time</p>
                    <p class="font-medium text-green-600">Tomorrow</p>
                  </div>
                  <div>
                    <p class="text-gray-500">Rating</p>
                    <p class="font-medium">4.9★</p>
                  </div>
                </div>
                <div class="mt-3 flex gap-2">
                  <span class="tag bg-green-100 text-green-700">Best Price</span
                  >
                  <span class="tag bg-blue-100 text-blue-700">Closest</span>
                </div>
              </div>

              <!-- Option 2 -->
              <div
                class="comparison-card border-2 border-gray-200 rounded-lg p-4 cursor-pointer hover:border-teal-500 transition-all"
                onclick="selectOption(this)"
              >
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <h4 class="font-medium text-gray-900">
                      Diagnostic Partners
                    </h4>
                    <p class="text-xs text-gray-500 mt-1">
                      MRI Lumbar Spine (CPT: 72148)
                    </p>
                  </div>
                  <span class="text-2xl font-bold text-gray-700">$340</span>
                </div>
                <div class="grid grid-cols-3 gap-4 text-sm">
                  <div>
                    <p class="text-gray-500">Distance</p>
                    <p class="font-medium">5.1 mi</p>
                  </div>
                  <div>
                    <p class="text-gray-500">Wait Time</p>
                    <p class="font-medium">3 days</p>
                  </div>
                  <div>
                    <p class="text-gray-500">Rating</p>
                    <p class="font-medium">4.7★</p>
                  </div>
                </div>
                <div class="mt-3 flex gap-2">
                  <span class="tag bg-purple-100 text-purple-700"
                    >Premium Service</span
                  >
                </div>
              </div>

              <!-- Hospital Comparison -->
              <div class="border-2 border-red-200 rounded-lg p-4 opacity-75">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <h4 class="font-medium text-gray-600">Hospital of Miami</h4>
                    <p class="text-xs text-gray-500 mt-1">MRI Lumbar Spine</p>
                  </div>
                  <span class="text-2xl font-bold text-red-600 line-through"
                    >$3,200</span
                  >
                </div>
                <div class="grid grid-cols-3 gap-4 text-sm">
                  <div>
                    <p class="text-gray-500">Distance</p>
                    <p class="font-medium text-gray-600">8.2 mi</p>
                  </div>
                  <div>
                    <p class="text-gray-500">Wait Time</p>
                    <p class="font-medium text-red-600">2 weeks</p>
                  </div>
                  <div>
                    <p class="text-gray-500">Rating</p>
                    <p class="font-medium text-gray-600">3.2★</p>
                  </div>
                </div>
                <div class="mt-3">
                  <span class="tag bg-red-100 text-red-700"
                    >Traditional Route</span
                  >
                </div>
              </div>
            </div>

            <div class="mt-6 bg-teal-50 rounded-lg p-4">
              <p class="text-sm text-teal-800">
                <span class="font-semibold">You save $2,940</span> by choosing USRad
                network
              </p>
            </div>
          </div>
        </div>

        <div class="order-1 lg:order-2" data-aos="fade-left">
          <div
            class="inline-flex items-center gap-2 bg-teal-100 text-teal-800 rounded-full px-4 py-2 mb-6"
          >
            <span class="text-lg font-bold">Step 2</span>
            <span class="w-1 h-1 bg-teal-600 rounded-full"></span>
            <span class="text-sm font-medium">45 seconds</span>
          </div>

          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Compare with Complete Transparency
          </h2>

          <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            See everything upfront: prices, wait times, ratings, and reviews. No
            hidden fees. No surprises. Just facts.
          </p>

          <!-- Comparison Features -->
          <div class="grid grid-cols-2 gap-6 mb-8">
            <div
              class="text-center p-4 bg-gray-50 rounded-xl hover:shadow-md transition-shadow"
            >
              <div class="text-3xl mb-2">💰</div>
              <h3 class="font-semibold text-gray-900">Real Prices</h3>
              <p class="text-sm text-gray-600 mt-1">
                Exact costs, no estimates
              </p>
            </div>
            <div
              class="text-center p-4 bg-gray-50 rounded-xl hover:shadow-md transition-shadow"
            >
              <div class="text-3xl mb-2">⏱️</div>
              <h3 class="font-semibold text-gray-900">Live Availability</h3>
              <p class="text-sm text-gray-600 mt-1">
                Real-time appointment slots
              </p>
            </div>
            <div
              class="text-center p-4 bg-gray-50 rounded-xl hover:shadow-md transition-shadow"
            >
              <div class="text-3xl mb-2">⭐</div>
              <h3 class="font-semibold text-gray-900">Patient Reviews</h3>
              <p class="text-sm text-gray-600 mt-1">From real patients</p>
            </div>
            <div
              class="text-center p-4 bg-gray-50 rounded-xl hover:shadow-md transition-shadow"
            >
              <div class="text-3xl mb-2">🏆</div>
              <h3 class="font-semibold text-gray-900">Quality Scores</h3>
              <p class="text-sm text-gray-600 mt-1">ACR accreditation status</p>
            </div>
          </div>

          <!-- Pro tip -->
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <p class="text-sm text-blue-800">
              <span class="font-semibold">💡 Pro tip:</span> Sort by "Best Value"
              to find the perfect balance of price, distance, and quality.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Step 3: Book - Interactive Booking Flow -->
  <section
    id="book-section"
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-teal-50/50 to-white relative overflow-hidden"
  >
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-teal-100/30 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-96 h-96 bg-blue-100/30 rounded-full blur-3xl"
    >
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div data-aos="fade-right">
          <div
            class="inline-flex items-center gap-2 bg-teal-100 text-teal-800 rounded-full px-4 py-2 mb-6"
          >
            <span class="text-lg font-bold">Step 3</span>
            <span class="w-1 h-1 bg-teal-600 rounded-full"></span>
            <span class="text-sm font-medium">60 seconds</span>
          </div>

          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Book in Under a Minute
          </h2>

          <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            Select your appointment time, enter basic information, and you're
            done. Instant confirmation sent to your email and phone.
          </p>

          <!-- Booking Steps -->
