---
// pages/how-it-works.astro
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import HowItWorksMetricsBar from "../components/HowItWorksMetricsBar.astro";
import AOSInit from "../components/AOSInit.astro";

const showPatientHeader = true;
---

<MainPatientLayout showPatientHeader={true}>
  <AOSInit />

  <!-- HERO SECTION - EVOLUTION FOCUSED -->
  <section class="relative w-full h-[600px] md:h-[700px] overflow-hidden">
    <!-- Background Image -->
    <img
      src="/images/how-it-works-hero-blank.webp"
      alt="Patient confidently using tablet to book scan"
      class="absolute inset-0 w-full h-full object-cover z-0"
      loading="eager"
    />

    <!-- Enhanced Gradient Overlay -->
    <div
      class="absolute inset-0 z-10 bg-gradient-to-r from-[#003087]/90 via-[#003087]/60 to-transparent"
    >
    </div>

    <!-- Text Content -->
    <div
      class="relative z-20 flex items-center justify-start h-full px-6 sm:px-12 text-white"
    >
      <div class="max-w-2xl space-y-6" data-aos="fade-up" data-aos-delay="100">
        <!-- Evolution Badge -->
        <div
          class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md rounded-full px-4 py-2 border border-white/20 mb-4"
        >
          <svg
            class="w-4 h-4 text-[#cc9933]"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-sm font-medium"
            >FOUNDATION: 400K Patients → EVOLUTION: Digital Platform → MISSION:
            90M Americans</span
          >
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight">
          The Evolution of
          <span class="text-[#cc9933]">Simple Healthcare</span>
        </h1>

        <p class="text-lg sm:text-xl leading-relaxed opacity-95">
          The same streamlined process we perfected while building a company
          that delivered <strong>$400 Million+ in savings</strong> and earned acquisition
          by a NYSE-listed corporation—now evolved with digital capabilities to serve
          millions.
        </p>

        <!-- Evolution Indicators -->
        <div class="flex flex-wrap gap-6 text-sm opacity-90 mt-6">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
            <span>Foundation: 8 years perfecting</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
            <span>Evolution: Digital efficiency</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
            <span>Mission: Serve everyone</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EVOLUTION BANNER -->
  <section
    class="relative bg-gradient-to-r from-[#003087] to-blue-700 text-white py-6 px-6"
  >
    <div
      class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-center gap-4 text-center md:text-left"
    >
      <div class="flex items-center gap-2">
        <svg
          class="w-5 h-5 text-[#cc9933]"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd"></path>
        </svg>
        <span class="text-sm sm:text-base font-semibold tracking-wide uppercase"
          >Process Evolution</span
        >
      </div>
      <span class="text-sm sm:text-base font-medium opacity-90">
        Foundation (10–14 days) → Enhanced (2–3 days) → Digital (Same-day
        possible)
      </span>
    </div>
  </section>

  <!-- PROCESS EVOLUTION OVERVIEW -->
  <section class="bg-gradient-to-br from-[#fefbf5] to-[#f8f5e8] py-24 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-[#003087] mb-4" data-aos="fade-up">
          How We Evolved Healthcare's Most Broken Process
        </h2>
        <p
          class="text-lg text-[#003087]/80 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          We didn’t just improve medical imaging—we revolutionized it. Built
          over 8 years, validated through a successful exit, now enhanced with
          digital capabilities.
        </p>
      </div>

      <!-- PROCESS TIMELINE ENHANCED -->
      <div
        class="space-y-12 mb-20"
        data-aos="fade-up"
        data-aos-anchor-placement="top-bottom"
      >
        <!-- Foundation Era -->
        <div class="flex items-start">
          <div
            class="w-16 h-16 bg-[#003087] rounded-full flex items-center justify-center text-white text-2xl font-bold flex-shrink-0 shadow-lg transition-all duration-700 ease-in-out hover:scale-105 animate-fade-in"
            data-aos="zoom-in"
          >
            F
          </div>
          <div class="ml-6 flex-1">
            <h4 class="font-bold text-[#003087] text-xl mb-3">
              Foundation Era (1994-2002)
            </h4>
            <p class="text-[#003087]/80 mb-4 text-lg">
              Built the first streamlined imaging process
            </p>
            <div class="grid md:grid-cols-3 gap-4">
              <div
                class="bg-gradient-to-br from-[#f0f4f9] to-[#e8f1fa] rounded-xl p-4 border border-[#003087]/10"
              >
                <strong class="text-[#003087] block mb-2"
                  >Problem Solved:</strong
                >
                <p class="text-sm">10–14 day wait times</p>
              </div>
              <div
                class="bg-gradient-to-br from-[#f0f4f9] to-[#e8f1fa] rounded-xl p-4 border border-[#003087]/10"
              >
                <strong class="text-[#003087] block mb-2">Innovation:</strong>
                <p class="text-sm">Direct center access</p>
              </div>
              <div
                class="bg-gradient-to-br from-[#f0f4f9] to-[#e8f1fa] rounded-xl p-4 border border-[#003087]/10"
              >
                <strong class="text-[#003087] block mb-2">Result:</strong>
                <p class="text-sm">2–3 day appointments</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Connecting Line -->
        <div
          class="ml-8 h-8 w-0.5 bg-gradient-to-b from-[#003087] to-[#cc9933]"
        >
        </div>

        <!-- Validation Era -->
        <div class="flex items-start">
          <div
            class="w-16 h-16 bg-[#cc9933] rounded-full flex items-center justify-center text-white text-2xl font-bold flex-shrink-0 shadow-lg transition-all duration-700 ease-in-out hover:scale-105 animate-fade-in"
            data-aos="zoom-in"
          >
            ✓
          </div>
          <div class="ml-6 flex-1">
            <h4 class="font-bold text-[#cc9933] text-xl mb-3">
              Validation Era (2002)
            </h4>
            <p class="text-[#003087]/80 mb-4 text-lg">
              Successful exit proved the model works
            </p>
            <div class="mt-6 flex items-center gap-4" data-aos="fade-in">
              <div class="relative group">
                <img
                  src="/images/inc500-badge.png"
                  alt="Inc 500 Honoree"
                  class="h-12 sm:h-16 object-contain border-2 border-[#cc9933] rounded-md shadow-md group-hover:scale-105 transition-transform duration-300"
                />
                <div
                  class="absolute left-0 bottom-full mb-2 w-64 p-2 rounded bg-[#003087] text-white text-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10 shadow-lg"
                >
                  The Inc. 500 list recognizes the fastest-growing private
                  companies in the U.S. We earned our spot by delivering
                  innovation, scale, and measurable savings.
                </div>
              </div>
              <span class="text-sm text-[#003087]/70 tracking-wide uppercase"
                >Inc. 500 Honoree · National Recognition</span
              >
            </div>
            <div class="grid md:grid-cols-3 gap-4">
              <div
                class="bg-gradient-to-br from-[#fefbf5] to-[#fef7ea] rounded-xl p-4 border border-[#cc9933]/20"
              >
                <strong class="text-[#cc9933] block mb-2">Proven:</strong>
                <p class="text-sm">400,000+ patients served</p>
              </div>
              <div
                class="bg-gradient-to-br from-[#fefbf5] to-[#fef7ea] rounded-xl p-4 border border-[#cc9933]/20"
              >
                <strong class="text-[#cc9933] block mb-2">Delivered:</strong>
                <p class="text-sm">$400M+ in savings</p>
              </div>
              <div
                class="bg-gradient-to-br from-[#fefbf5] to-[#fef7ea] rounded-xl p-4 border border-[#cc9933]/20"
              >
                <strong class="text-[#cc9933] block mb-2">Exit:</strong>
                <p class="text-sm">NYSE company acquisition</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Connecting Line -->
        <div
          class="ml-8 h-8 w-0.5 bg-gradient-to-b from-[#cc9933] to-[#003087]"
        >
        </div>

        <!-- Evolution Era -->
        <div class="flex items-start">
          <div
            class="w-16 h-16 bg-gradient-to-r from-[#003087] to-[#cc9933] rounded-full flex items-center justify-center text-white text-2xl font-bold flex-shrink-0 shadow-lg transition-all duration-700 ease-in-out hover:scale-105 animate-fade-in"
            data-aos="zoom-in"
          >
            E
          </div>
          <div class="ml-6 flex-1">
            <h4
              class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#003087] to-[#cc9933] text-xl mb-3"
            >
              Evolution Era (Now)
            </h4>
            <p class="text-[#003087]/80 mb-4 text-lg">
              Digital platform enhances proven process
            </p>
            <div class="grid md:grid-cols-3 gap-4">
              <div
                class="bg-gradient-to-br from-[#f0f4f9] via-[#f8f5ef] to-[#fefbf5] rounded-xl p-4 border border-transparent bg-clip-padding"
                style="background-image: linear-gradient(white, white), linear-gradient(to right, #003087, #cc9933); background-origin: border-box; background-clip: padding-box, border-box; border: 1px solid transparent;"
              >
                <strong class="text-[#003087] block mb-2">Enhanced:</strong>
                <p class="text-sm">Real-time booking</p>
              </div>
              <div
                class="bg-gradient-to-br from-[#f0f4f9] via-[#f8f5ef] to-[#fefbf5] rounded-xl p-4 border border-transparent bg-clip-padding"
                style="background-image: linear-gradient(white, white), linear-gradient(to right, #003087, #cc9933); background-origin: border-box; background-clip: padding-box, border-box; border: 1px solid transparent;"
              >
                <strong class="text-[#003087] block mb-2">Scaled:</strong>
                <p class="text-sm">1,500+ centers</p>
              </div>
              <div
                class="bg-gradient-to-br from-[#f0f4f9] via-[#f8f5ef] to-[#fefbf5] rounded-xl p-4 border border-transparent bg-clip-padding"
                style="background-image: linear-gradient(white, white), linear-gradient(to right, #003087, #cc9933); background-origin: border-box; background-clip: padding-box, border-box; border: 1px solid transparent;"
              >
                <strong class="text-[#003087] block mb-2">Mission:</strong>
                <p class="text-sm">Serve 90M Americans</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- COMPARISON GRID ENHANCED -->
      <div class="grid md:grid-cols-2 gap-8 mb-16">
        <div
          class="bg-white p-8 rounded-2xl shadow-lg border-t-4 border-red-500 transition-transform duration-700 hover:scale-[1.02]"
          data-aos="fade-right"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-10 h-10 bg-red-100 flex items-center justify-center rounded-full"
            >
              ❌
            </div>
            <h3 class="text-xl font-bold text-red-600">The Broken System</h3>
          </div>
          <ul class="space-y-3 text-[#003087]/80 text-sm">
            <li>
              ❌ <strong>10–14 day wait times</strong> (industry standard)
            </li>
            <li>
              ❌ <strong>Complex referral maze</strong> wastes everyone's time
            </li>
            <li>
              ❌ <strong>Hidden costs multiply</strong> with separate bills
            </li>
            <li>
              ❌ <strong>Insurance complexity</strong> adds weeks of delay
            </li>
            <li>
              ❌ <strong>Quality lottery</strong> across different providers
            </li>
            <li>❌ <strong>Results bottlenecks</strong> leave you waiting</li>
          </ul>
        </div>

        <div
          class="bg-white p-8 rounded-2xl shadow-lg border-t-4 border-[#cc9933] transition-transform duration-700 hover:scale-[1.02]"
          data-aos="fade-left"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-10 h-10 bg-[#cc9933]/20 flex items-center justify-center rounded-full"
            >
              ✅
            </div>
            <h3 class="text-xl font-bold text-[#cc9933]">
              Our Evolved Process
            </h3>
          </div>
          <ul class="space-y-3 text-[#003087]/80 text-sm">
            <li>
              ✅ <strong>2–3 days standard</strong> (same-day often available)
            </li>
            <li>
              ✅ <strong>Book direct online</strong> – no middleman needed
            </li>
            <li>
              ✅ <strong>One transparent price</strong> – everything included
            </li>
            <li>✅ <strong>Skip insurance hassles</strong> – direct payment</li>
            <li>
              ✅ <strong>Guaranteed quality</strong> – vetted network only
            </li>
            <li>✅ <strong>24–48 hour results</strong> – digital delivery</li>
          </ul>
          <div class="mt-4 text-sm bg-[#fefbf5] p-3 rounded-lg text-[#cc9933]">
            <strong>Evolution Advantage:</strong> Same proven process + digital efficiency
            = exponential impact
          </div>
        </div>
      </div>

      <!-- Success Metrics Bar -->
      <div data-aos="fade-up" data-aos-delay="200">
        <HowItWorksMetricsBar
          metrics={[
            { value: "400,000+", label: "Foundation: Patients Served" },
            { value: "$400M+", label: "Foundation: Savings Delivered" },
            { value: "1,500+", label: "Evolution: Centers Network" },
            { value: "90M", label: "Mission: Americans to Serve" },
          ]}
          animated={true}
        />
      </div>
    </div>

    <!-- DETAILED 4-STEP PROCESS - EVOLUTION ENHANCED -->
    <section class="bg-white py-20 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2
            class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
            data-aos="fade-up"
          >
            The Evolved 4-Step Journey
          </h2>
          <p
            class="text-lg text-[#003087]/80"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            Foundation proven by 400,000+ patients • Evolution powered by
            technology • Mission to transform healthcare
          </p>
        </div>

        <div class="space-y-16">
          <!-- Step 1: Choose Your Scan - EVOLUTION ENHANCED -->
          <div
            class="grid md:grid-cols-2 gap-12 items-center"
            data-aos="fade-up"
          >
            <div class="order-2 md:order-1">
              <div class="flex items-center mb-6">
                <div
                  class="w-16 h-16 bg-[#003087] rounded-full flex items-center justify-center text-white text-2xl font-bold mr-6"
                >
                  1
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-[#003087]">
                    Choose Your Scan
                  </h3>
                  <p class="text-[#cc9933] font-medium">
                    Foundation → Evolution → Your Choice
                  </p>
                </div>
              </div>
              <div class="space-y-4 text-[#003087]/90">
                <p class="text-lg">
                  Browse MRI, CT, and ultrasound options with the <strong
                    >transparent pricing we pioneered</strong
                  >. No hidden fees—the same innovation that revolutionized
                  imaging for Fortune 500 companies, now digitally enhanced for
                  everyone.
                </p>
                <div class="bg-[#f0f4f9] rounded-xl p-4">
                  <h4 class="font-bold text-[#003087] mb-2">
                    Evolution Benefits:
                  </h4>
                  <ul class="space-y-1 text-sm">
                    <li>✓ Real-time pricing (our foundation innovation)</li>
                    <li>✓ Instant availability (digital evolution)</li>
                    <li>✓ 1,500+ centers competing (market dynamics)</li>
                    <li>✓ Quality scores visible (transparency enhanced)</li>
                    <li>✓ One-click booking (friction eliminated)</li>
                  </ul>
                </div>
                <div
                  class="p-3 bg-[#fefbf5] rounded-lg border-l-4 border-[#cc9933]"
                >
                  <p class="text-sm font-medium text-[#003087]">
                    <strong>Foundation:</strong> Created transparent pricing<br
                    />
                    <strong>Evolution:</strong> Made it real-time and digital
                  </p>
                </div>
              </div>
            </div>
            <div class="order-1 md:order-2">
              <img
                src="/images/website/search-interface-mockup.webp"
                alt="USRad search interface showing transparent pricing"
                class="w-full h-auto rounded-2xl shadow-xl"
              />
            </div>
          </div>

          <!-- Step 2: Get Matched - EVOLUTION ENHANCED -->
          <div
            class="grid md:grid-cols-2 gap-12 items-center"
            data-aos="fade-up"
          >
            <div>
              <img
                src="/images/website/facility-matching.webp"
                alt="High-quality imaging center facilities"
                class="w-full h-auto rounded-2xl shadow-xl"
              />
            </div>
            <div>
              <div class="flex items-center mb-6">
                <div
                  class="w-16 h-16 bg-[#003087] rounded-full flex items-center justify-center text-white text-2xl font-bold mr-6"
                >
                  2
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-[#003087]">
                    Get Matched to Excellence
                  </h3>
                  <p class="text-[#cc9933] font-medium">
                    Same proven standards • Enhanced matching
                  </p>
                </div>
              </div>
              <div class="space-y-4 text-[#003087]/90">
                <p class="text-lg">
                  We connect you to <strong>top-rated imaging centers</strong> using
                  the same quality standards that served 400,000+ patients and earned
                  our successful exit—now with AI-powered matching for perfect fit.
                </p>
                <div class="bg-[#f0f4f9] rounded-xl p-4">
                  <h4 class="font-bold text-[#003087] mb-2">
                    Evolution in Quality:
                  </h4>
                  <ul class="space-y-1 text-sm">
                    <li>✓ Foundation: Manual quality vetting</li>
                    <li>✓ Evolution: Real-time quality monitoring</li>
                    <li>✓ AI matches your specific needs</li>
                    <li>✓ Patient feedback integrated instantly</li>
                    <li>✓ Continuous improvement loop</li>
                  </ul>
                </div>
                <div
                  class="p-3 bg-[#fefbf5] rounded-lg border-l-4 border-[#cc9933]"
                >
                  <p class="text-sm font-medium text-[#003087]">
                    <strong>Proven:</strong> 98% patient satisfaction over 8 years
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 3: Confirm & Pay - EVOLUTION ENHANCED -->
          <div
            class="grid md:grid-cols-2 gap-12 items-center"
            data-aos="fade-up"
          >
            <div class="order-2 md:order-1">
              <div class="flex items-center mb-6">
                <div
                  class="w-16 h-16 bg-[#003087] rounded-full flex items-center justify-center text-white text-2xl font-bold mr-6"
                >
                  3
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-[#003087]">
                    Confirm & Pay
                  </h3>
                  <p class="text-[#cc9933] font-medium">
                    Proven transparency • Digital simplicity
                  </p>
                </div>
              </div>
              <div class="space-y-4 text-[#003087]/90">
                <p class="text-lg">
                  <strong>All-inclusive pricing</strong>—the same model that
                  made our company worth acquiring, now with instant digital
                  payments and automated confirmations.
                </p>
                <div class="bg-[#f0f4f9] rounded-xl p-4">
                  <h4 class="font-bold text-[#003087] mb-2">
                    Payment Evolution:
                  </h4>
                  <ul class="space-y-1 text-sm">
                    <li>✓ Foundation: Phone/paper payments</li>
                    <li>✓ Evolution: One-click digital checkout</li>
                    <li>✓ Apple Pay, Google Pay, HSA/FSA</li>
                    <li>✓ Instant payment plans available</li>
                    <li>✓ Automated receipt delivery</li>
                  </ul>
                </div>
                <div
                  class="p-3 bg-[#fefbf5] rounded-lg border-l-4 border-[#cc9933]"
                >
                  <p class="text-sm font-medium text-[#003087]">
                    <strong>Same guarantee:</strong> No surprise bills, ever.<br
                    />
                    <strong>New efficiency:</strong> 30-second checkout
                  </p>
                </div>
              </div>
            </div>
            <div class="order-1 md:order-2">
              <img
                src="/images/website/payment-confirmation.webp"
                alt="Transparent pricing and payment confirmation"
                class="w-full h-auto rounded-2xl shadow-xl"
              />
            </div>
          </div>

          <!-- Step 4: Get Expert Care - EVOLUTION ENHANCED -->
          <div
            class="grid md:grid-cols-2 gap-12 items-center"
            data-aos="fade-up"
          >
            <div>
              <img
                src="/images/radiologist-virtual-consult.webp"
                alt="Board-certified radiologist reviewing scans"
                class="w-full h-auto rounded-2xl shadow-xl"
              />
            </div>
            <div>
              <div class="flex items-center mb-6">
                <div
                  class="w-16 h-16 bg-[#003087] rounded-full flex items-center justify-center text-white text-2xl font-bold mr-6"
                >
                  4
                </div>
                <div>
                  <h3 class="text-2xl font-bold text-[#003087]">
                    Get Expert Results
                  </h3>
                  <p class="text-[#cc9933] font-medium">
                    Proven expertise • Digital delivery
                  </p>
                </div>
              </div>
              <div class="space-y-4 text-[#003087]/90">
                <p class="text-lg">
                  Every scan reviewed by <strong
                    >board-certified radiologists</strong
                  >—the same expert standards from our foundation, now with
                  AI-assisted accuracy and digital delivery in 24-48 hours.
                </p>
                <div class="bg-[#f0f4f9] rounded-xl p-4">
                  <h4 class="font-bold text-[#003087] mb-2">
                    Results Evolution:
                  </h4>
                  <ul class="space-y-1 text-sm">
                    <li>✓ Foundation: Mailed/faxed results (3-5 days)</li>
                    <li>✓ Evolution: Digital portal (24-48 hours)</li>
                    <li>✓ AI-assisted accuracy checking</li>
                    <li>✓ Plain-language summaries included</li>
                    <li>✓ Direct integration with your doctor</li>
                  </ul>
                </div>
                <div
                  class="p-3 bg-[#fefbf5] rounded-lg border-l-4 border-[#cc9933]"
                >
                  <p class="text-sm font-medium text-[#003087]">
                    <strong>400,000+ scans:</strong> Zero quality compromises<br
                    />
                    <strong>Digital evolution:</strong> Results 2x faster
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- EVOLUTION IMPACT SECTION - NEW -->
