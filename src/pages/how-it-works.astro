---
// pages/how-it-works.astro
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import HowItWorksMetricsBar from "../components/HowItWorksMetricsBar.astro";
import AOSInit from "../components/AOSInit.astro";

const showPatientHeader = true;
---

<MainPatientLayout showPatientHeader={true}>
  <AOSInit />

  <!-- HERO SECTION - CREDIBILITY + ANXIETY REDUCTION -->
  <section class="relative w-full h-[600px] md:h-[700px] overflow-hidden">
    <!-- Background Image -->
    <img
      src="/images/how-it-works-hero-blank.webp"
      alt="Patient confidently using tablet to book scan"
      class="absolute inset-0 w-full h-full object-cover z-0"
      loading="eager"
    />

    <!-- Enhanced Gradient Overlay -->
    <div
      class="absolute inset-0 z-10 bg-gradient-to-r from-[#003087]/90 via-[#003087]/60 to-transparent"
    >
    </div>

    <!-- Text Content -->
    <div
      class="relative z-20 flex items-center justify-start h-full px-6 sm:px-12 text-white"
    >
      <div class="max-w-2xl space-y-6" data-aos="fade-up" data-aos-delay="100">
        <!-- Credibility Badge -->
        <div
          class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md rounded-full px-4 py-2 border border-white/20 mb-4"
        >
          <svg
            class="w-4 h-4 text-[#cc9933]"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-sm font-medium"
            >Proven Process • 400,000+ Patients Served • Successful Healthcare
            Exit</span
          >
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight">
          Simple Process,
          <span class="text-[#cc9933]">Proven Results</span>
        </h1>

        <p class="text-lg sm:text-xl leading-relaxed opacity-95">
          The same streamlined process we perfected while building AnciCare and
          delivering $400 Million+ in savings to 400,000+ patients.
          <strong>No referrals. No insurance hurdles. No surprises.</strong>
        </p>

        <!-- Trust Indicators -->
        <div class="flex flex-wrap gap-6 text-sm opacity-90 mt-6">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
            <span>2-3 day average (vs 10-14 days industry)</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
            <span>NYSE-listed company acquisition</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-[#cc9933] rounded-full"></div>
            <span>100% price guarantee</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS OVERVIEW - ANXIETY REDUCTION FOCUSED -->
  <section class="bg-gradient-to-br from-[#fefbf5] to-[#f8f5e8] py-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          A Process Perfected Over 8 Years
        </h2>
        <p
          class="text-lg text-[#003087]/80 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          We've eliminated every friction point that makes medical imaging
          stressful. This isn't theory—it's the proven system we built with
          AnciCare that earned acquisition by a NYSE-listed healthcare company.
        </p>
      </div>

      <!-- Problem vs Solution Comparison -->
      <div class="grid md:grid-cols-2 gap-8 mb-16">
        <!-- Traditional Process Problems -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg border-l-4 border-red-400"
          data-aos="fade-right"
        >
          <div class="flex items-center mb-6">
            <div
              class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mr-4"
            >
              <svg
                class="w-6 h-6 text-red-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-red-700">
              Traditional Healthcare Imaging
            </h3>
          </div>
          <div class="space-y-3 text-[#003087]/80">
            <p>❌ <strong>10-14 day wait times</strong> for appointments</p>
            <p>
              ❌ <strong>Complex referral requirements</strong> and authorization
              delays
            </p>
            <p>❌ <strong>Hidden costs</strong> and surprise billing</p>
            <p>❌ <strong>Insurance hassles</strong> and claim denials</p>
            <p>❌ <strong>Inconsistent quality</strong> across providers</p>
            <p>❌ <strong>Poor communication</strong> about results</p>
          </div>
        </div>

        <!-- USRad Solution -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg border-l-4 border-[#cc9933]"
          data-aos="fade-left"
        >
          <div class="flex items-center mb-6">
            <div
              class="w-12 h-12 bg-[#cc9933]/10 rounded-full flex items-center justify-center mr-4"
            >
              <svg
                class="w-6 h-6 text-[#cc9933]"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[#cc9933]">
              The USRad Proven Process
            </h3>
          </div>
          <div class="space-y-3 text-[#003087]/80">
            <p>
              ✅ <strong>2-3 day appointments</strong> (often next-day available)
            </p>
            <p>✅ <strong>No referrals needed</strong> - direct access</p>
            <p>✅ <strong>100% transparent pricing</strong> before you book</p>
            <p>✅ <strong>No insurance required</strong> - simple payment</p>
            <p>✅ <strong>Guaranteed quality</strong> at vetted facilities</p>
            <p>
              ✅ <strong>Results in 24-48 hours</strong> with clear communication
            </p>
          </div>
        </div>
      </div>

      <!-- Success Metrics Bar -->
      <HowItWorksMetricsBar
        metrics={[
          { value: "400,000+", label: "Patients Successfully Served" },
          { value: "$400 Million+", label: "Total Savings Delivered" },
          { value: "98%", label: "Patient Satisfaction Rate" },
          { value: "✓", label: "Successful Exit" },
        ]}
      />
    </div>
  </section>

  <!-- DETAILED 4-STEP PROCESS - ENHANCED -->
  <section class="bg-white py-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          Your Journey: From Click to Results
        </h2>
        <p
          class="text-lg text-[#003087]/80"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Every step optimized through 400,000+ patient experiences
        </p>
      </div>

      <div class="space-y-16">
        <!-- Step 1: Choose Your Scan -->
        <div class="grid md:grid-cols-2 gap-12 items-center" data-aos="fade-up">
          <div class="order-2 md:order-1">
            <div class="flex items-center mb-6">
              <div
                class="w-16 h-16 bg-[#003087] rounded-full flex items-center justify-center text-white text-2xl font-bold mr-6"
              >
                1
              </div>
              <div>
                <h3 class="text-2xl font-bold text-[#003087]">
                  Choose Your Scan
                </h3>
                <p class="text-[#cc9933] font-medium">
                  Select type & location • 30 seconds • Proven interface
                </p>
              </div>
            </div>
            <div class="space-y-4 text-[#003087]/90">
              <p class="text-lg">
                Browse MRI, CT, and ultrasound options with <strong
                  >transparent pricing</strong
                > displayed upfront. No hidden fees, no surprise bills—ever. The
                same pricing transparency we pioneered with AnciCare.
              </p>
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <h4 class="font-bold text-[#003087] mb-2">What You'll See:</h4>
                <ul class="space-y-1 text-sm">
                  <li>✓ Exact price before booking (our innovation)</li>
                  <li>✓ Available appointment times</li>
                  <li>✓ Facility ratings and credentials</li>
                  <li>✓ Distance and directions</li>
                  <li>✓ Insurance acceptance (if you choose to use it)</li>
                </ul>
              </div>
            </div>
          </div>
          <div class="order-1 md:order-2">
            <img
              src="/images/website/search-interface-mockup.webp"
              alt="USRad search interface showing transparent pricing"
              class="w-full h-auto rounded-2xl shadow-xl"
            />
          </div>
        </div>

        <!-- Step 2: Get Matched -->
        <div class="grid md:grid-cols-2 gap-12 items-center" data-aos="fade-up">
          <div>
            <img
              src="/images/website/facility-matching.webp"
              alt="High-quality imaging center facilities"
              class="w-full h-auto rounded-2xl shadow-xl"
            />
          </div>
          <div>
            <div class="flex items-center mb-6">
              <div
                class="w-16 h-16 bg-[#003087] rounded-full flex items-center justify-center text-white text-2xl font-bold mr-6"
              >
                2
              </div>
              <div>
                <h3 class="text-2xl font-bold text-[#003087]">
                  Get Matched to Excellence
                </h3>
                <p class="text-[#cc9933] font-medium">
                  Vetted facilities only • Quality guaranteed • Proven standards
                </p>
              </div>
            </div>
            <div class="space-y-4 text-[#003087]/90">
              <p class="text-lg">
                We connect you to <strong>top-rated imaging centers</strong> in our
                proven network—the same quality standards that served 400,000+ patients
                successfully.
              </p>
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <h4 class="font-bold text-[#003087] mb-2">
                  Our Quality Promise:
                </h4>
                <ul class="space-y-1 text-sm">
                  <li>✓ State-of-the-art equipment (same as hospitals)</li>
                  <li>✓ Board-certified technologists</li>
                  <li>✓ Comfortable, anxiety-reducing environments</li>
                  <li>✓ Regular quality audits and certification</li>
                  <li>✓ 8+ years of refinement perfected</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3: Confirm & Pay -->
        <div class="grid md:grid-cols-2 gap-12 items-center" data-aos="fade-up">
          <div class="order-2 md:order-1">
            <div class="flex items-center mb-6">
              <div
                class="w-16 h-16 bg-[#003087] rounded-full flex items-center justify-center text-white text-2xl font-bold mr-6"
              >
                3
              </div>
              <div>
                <h3 class="text-2xl font-bold text-[#003087]">Confirm & Pay</h3>
                <p class="text-[#cc9933] font-medium">
                  100% transparent pricing • Instant confirmation • Proven model
                </p>
              </div>
            </div>
            <div class="space-y-4 text-[#003087]/90">
              <p class="text-lg">
                <strong>All-inclusive pricing</strong> covers both facility and radiologist
                fees. No separate bills, no insurance hassles, no surprises—guaranteed.
                The same pricing model that made our previous venture worth acquiring.
              </p>
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <h4 class="font-bold text-[#003087] mb-2">
                  Pricing Transparency:
                </h4>
                <ul class="space-y-1 text-sm">
                  <li>✓ All-inclusive rate (facility + radiologist)</li>
                  <li>✓ 30-70% savings vs hospital rates</li>
                  <li>✓ Payment plans available</li>
                  <li>✓ HSA/FSA accepted</li>
                  <li>✓ Price lock guarantee</li>
                </ul>
              </div>
            </div>
          </div>
          <div class="order-1 md:order-2">
            <img
              src="/images/website/payment-confirmation.webp"
              alt="Transparent pricing and payment confirmation"
              class="w-full h-auto rounded-2xl shadow-xl"
            />
          </div>
        </div>

        <!-- Step 4: Get Expert Care -->
        <div class="grid md:grid-cols-2 gap-12 items-center" data-aos="fade-up">
          <div>
            <img
              src="/images/radiologist-virtual-consult.webp"
              alt="Board-certified radiologist reviewing scans"
              class="w-full h-auto rounded-2xl shadow-xl"
            />
          </div>
          <div>
            <div class="flex items-center mb-6">
              <div
                class="w-16 h-16 bg-[#003087] rounded-full flex items-center justify-center text-white text-2xl font-bold mr-6"
              >
                4
              </div>
              <div>
                <h3 class="text-2xl font-bold text-[#003087]">
                  Get Expert Care
                </h3>
                <p class="text-[#cc9933] font-medium">
                  Board-certified reads • 24-48 hour results • Proven quality
                </p>
              </div>
            </div>
            <div class="space-y-4 text-[#003087]/90">
              <p class="text-lg">
                Every scan is reviewed by <strong
                  >board-certified radiologists</strong
                >, with subspecialist consultation when needed. Results
                delivered directly to you and your doctor—the same expert
                process that served 400,000+ patients.
              </p>
              <div class="bg-[#f0f4f9] rounded-xl p-4">
                <h4 class="font-bold text-[#003087] mb-2">
                  Expert Review Process:
                </h4>
                <ul class="space-y-1 text-sm">
                  <li>✓ Board-certified radiologist primary review</li>
                  <li>✓ Subspecialist consultation if needed</li>
                  <li>✓ Results in 24-48 hours (vs 3-5 days typical)</li>
                  <li>✓ Direct delivery to you and your doctor</li>
                  <li>✓ Follow-up support available</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMFORT & ANXIETY REDUCTION SECTION -->
  <section class="bg-[#f0f4f9] py-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-[#003087] mb-4"
          data-aos="fade-up"
        >
          Designed for Your Comfort & Peace of Mind
        </h2>
        <p
          class="text-lg text-[#003087]/80"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          8 years serving patients taught us exactly what matters most
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Anxiety Support -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg text-center"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div
            class="w-16 h-16 bg-[#cc9933]/10 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-8 h-8 text-[#cc9933]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#003087] mb-4">Anxiety Support</h3>
          <div class="text-left space-y-2 text-[#003087]/80">
            <p>• Open MRI options for claustrophobia</p>
            <p>• Music and comfort items provided</p>
            <p>• Pre-scan consultation available</p>
            <p>• Experienced, caring technologists</p>
            <p>• Clear explanation of every step</p>
          </div>
        </div>

        <!-- Time Commitment -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg text-center"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div
            class="w-16 h-16 bg-[#cc9933]/10 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-8 h-8 text-[#cc9933]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#003087] mb-4">
            Quick & Efficient
          </h3>
          <div class="text-left space-y-2 text-[#003087]/80">
            <p>• Most scans: 15-45 minutes</p>
            <p>• Check-in: 5-10 minutes</p>
            <p>• Free parking at every location</p>
            <p>• Minimal wait times</p>
            <p>• Streamlined paperwork</p>
          </div>
        </div>

        <!-- Results & Follow-up -->
        <div
          class="bg-white rounded-2xl p-8 shadow-lg text-center"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div
            class="w-16 h-16 bg-[#cc9933]/10 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-8 h-8 text-[#cc9933]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#003087] mb-4">
            Clear Communication
          </h3>
          <div class="text-left space-y-2 text-[#003087]/80">
            <p>• Results within 24-48 hours</p>
            <p>• Sent directly to you & your doctor</p>
            <p>• Plain-language explanations</p>
            <p>• Follow-up support available</p>
            <p>• Secure online portal access</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF SECTION - TESTIMONIAL STYLE -->
  <section class="bg-white py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2
        class="text-3xl md:text-4xl font-bold text-[#003087] mb-8"
        data-aos="fade-up"
      >
        Proven Results You Can Trust
      </h2>

      <div
        class="bg-gradient-to-br from-[#f8f2e1] to-[#fcf9f0] rounded-3xl p-8 md:p-12 shadow-xl"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="text-6xl text-[#cc9933] opacity-30 mb-4">"</div>
        <blockquote
          class="text-xl md:text-2xl italic text-[#003087] leading-relaxed mb-8"
        >
          This process isn't experimental—it's the same proven system that
          revolutionized medical imaging for Fortune 500 companies. We built
          AnciCare from the ground up, eliminated the 10-14 day wait times, the
          hidden costs, and the quality inconsistencies that plagued traditional
          healthcare. Our success led to acquisition by CorVel Corporation
          (NYSE: CVL), and they continue operating our model over 20 years
          later.
        </blockquote>
        <div class="grid md:grid-cols-3 gap-6 text-center">
          <div>
            <div class="text-3xl font-bold text-[#cc9933]">400,000+</div>
            <div class="text-sm text-[#003087]">
              Patients Successfully Served
            </div>
          </div>
          <div>
            <div class="text-3xl font-bold text-[#cc9933]">$400 Million+</div>
            <div class="text-sm text-[#003087]">Total Savings Delivered</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-[#cc9933]">2-3 Days</div>
            <div class="text-sm text-[#003087]">Average Wait Time</div>
          </div>
        </div>
        <div class="mt-6 text-sm text-[#003087]/70">
          — The USRad Founding Team
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION - ADDRESSING COMMON CONCERNS -->
  <section class="bg-[#f0f4f9] py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <h2
        class="text-3xl md:text-4xl font-bold text-[#003087] text-center mb-12"
        data-aos="fade-up"
      >
        Common Questions About Our Process
      </h2>

      <div class="space-y-6">
        <div
          class="bg-white rounded-xl p-6 shadow-md"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <h3 class="text-lg font-bold text-[#003087] mb-3">
            Do I really not need a referral?
          </h3>
          <p class="text-[#003087]/80">
            Correct! You can book directly with us—the same direct access we
            pioneered years ago. However, if your doctor ordered the scan, make
            sure to bring that order to your appointment so we can include it in
            your results.
          </p>
        </div>

        <div
          class="bg-white rounded-xl p-6 shadow-md"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <h3 class="text-lg font-bold text-[#003087] mb-3">
            How are your prices so much lower than hospitals?
          </h3>
          <p class="text-[#003087]/80">
            We perfected the managed care model and delivered $400 Million+ in
            proven savings. By eliminating administrative overhead and working
            directly with imaging centers, we cut out the middleman costs that
            hospitals pass on to patients.
          </p>
        </div>

        <div
          class="bg-white rounded-xl p-6 shadow-md"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <h3 class="text-lg font-bold text-[#003087] mb-3">
            Is the quality really the same as hospitals?
          </h3>
          <p class="text-[#003087]/80">
            Often better! We only partner with accredited centers using the same
            equipment as hospitals—the same standards that earned our successful
            exit. Plus, all scans are read by board-certified radiologists with
            subspecialty consultation when needed.
          </p>
        </div>

        <div
          class="bg-white rounded-xl p-6 shadow-md"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <h3 class="text-lg font-bold text-[#003087] mb-3">
            What if I have anxiety about MRIs?
          </h3>
          <p class="text-[#003087]/80">
            We've helped thousands of anxious patients through our proven
            approach! We offer open MRI options, comfort items, pre-scan
            consultations, and our technologists are specially trained to help
            you feel at ease throughout the process.
          </p>
        </div>

        <div
