  <!-- ============================================================
    SCRIPT — scroll-driven crossfade + parallax + hero sync
  ============================================================ -->
  <script>
    (function () {
      const STEPS = [1, 2, 3, 4];
      const LABELS = ["Search", "Compare", "Request", "Appointment Secured"];
      let current = 1;
      let transitioning = false; // scroll-lock flag

      /* ── Crossfade transition ── */
      function showScreen(n) {
        if (n === current || transitioning) return;
        transitioning = true;

        const prevEl = document.getElementById(`sc-${current}`);
        const nextEl = document.getElementById(`sc-${n}`);
        if (!prevEl || !nextEl) {
          transitioning = false;
          return;
        }

        // Exit: fade prev down
        prevEl.classList.add("sc-exit");
        prevEl.addEventListener(
          "animationend",
          function onExit() {
            prevEl.removeEventListener("animationend", onExit);
            prevEl.classList.remove("active", "sc-exit");
            prevEl.style.display = "none";

            // Enter: show next, fade up
            nextEl.style.display = "block";
            nextEl.classList.add("active", "sc-enter");
            nextEl.addEventListener(
              "animationend",
              function onEnter() {
                nextEl.removeEventListener("animationend", onEnter);
                nextEl.classList.remove("sc-enter");
                transitioning = false;
              },
              { once: true },
            );
          },
          { once: true },
        );

        // Update dots, hero bar, step label
        document
          .querySelectorAll(".sdot")
          .forEach((d, i) => d.classList.toggle("active", i + 1 === n));
        document
          .querySelectorAll(".hero-step")
          .forEach((s, i) => s.classList.toggle("active", i + 1 === n));
        const lbl = document.getElementById("ssl-title");
        if (lbl) lbl.textContent = LABELS[n - 1];
        const num = document.querySelector(".ssl-num");
        if (num) num.textContent = n === 4 ? "Done" : `Step ${n}`;

        // Update progress strip
        document.querySelectorAll(".wps-step").forEach((el, i) => {
          const stepNum = i + 1;
          el.classList.remove("wps-active", "wps-done");
          if (stepNum === n) el.classList.add("wps-active");
          else if (stepNum < n) el.classList.add("wps-done");
        });

        current = n;
      }

      /* ── Scroll-driven swap ── */
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              const n = parseInt(e.target.id.replace("walk-", ""), 10);
              if (!isNaN(n)) showScreen(n);
            }
          });
        },
        { threshold: 0.45, rootMargin: "-80px 0px" },
      );
      STEPS.forEach((n) => {
        const el = document.getElementById(`walk-${n}`);
        if (el) obs.observe(el);
      });

      /* ── Dot clicks ── */
      document.querySelectorAll(".sdot").forEach((dot) => {
        dot.addEventListener("click", () => {
          const n = parseInt(dot.dataset.target, 10);
          showScreen(n);
          const target = document.getElementById(`walk-${n}`);
          if (target)
            target.scrollIntoView({ behavior: "smooth", block: "center" });
        });
      });

      /* ── Hero step bar clicks ── */
      document.querySelectorAll(".hero-step").forEach((step, i) => {
        step.addEventListener("click", () => {
          const target = document.getElementById(`walk-${i + 1}`);
          if (target)
            target.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      /* ── Mouse parallax on sticky screen stage ── */
      const stage = document.getElementById("sticky-panel");
      const activeCard = () => document.querySelector(".screen-card.active");
      let rafId = null;
      let targetX = 0,
        targetY = 0;
      let currentX = -3,
        currentY = 4; // matches default tilt

      function lerp(a, b, t) {
        return a + (b - a) * t;
      }

      function animateParallax() {
        currentX = lerp(currentX, targetX, 0.08);
        currentY = lerp(currentY, targetY, 0.08);
        const card = activeCard();
        if (card) {
          card.style.transform = `rotateX(${currentY}deg) rotateY(${currentX}deg) translateZ(0)`;
        }
        rafId = requestAnimationFrame(animateParallax);
      }

      if (stage) {
        stage.addEventListener("mousemove", (e) => {
          const rect = stage.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width - 0.5) * 7;
          const y = ((e.clientY - rect.top) / rect.height - 0.5) * 5;
          targetX = -3 + x; // center around resting -3deg Y
          targetY = 4 - y; // center around resting  4deg X
        });

        // Smooth reset on mouse leave
        stage.addEventListener("mouseleave", () => {
          targetX = -3;
          targetY = 4;
        });

        // Start the parallax RAF loop
        animateParallax();
      }

      // Don't animate cards that are in exit animation
      document.addEventListener("animationstart", (e) => {
        if (e.target.classList.contains("sc-exit")) {
          e.target.style.transform = ""; // let CSS animation handle it
        }
      });

      /* ── Init ── */
      const first = document.getElementById("sc-1");
      if (first) {
        first.style.display = "block";
        first.classList.add("active");
      }
      current = 1;
    })();
  </script>
</CarbonLayout>
