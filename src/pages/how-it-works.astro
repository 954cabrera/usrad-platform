---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";
import MemberRightsSummary from "../components/trust/MemberRightsSummary.astro";

export const prerender = true;
---

<CarbonLayout
  title="How USRad Works — Guided Imaging in Four Steps"
  isHeroPage={false}
>
  <AOSInit />

  <!-- ============================================================
    HERO — Process-first
  ============================================================ -->
  <section
    class="relative pt-28 pb-16 px-4 sm:px-6 overflow-hidden bg-gradient-to-br from-slate-900 via-[#003087] to-[#001a4d]"
    style="background-image: linear-gradient(180deg, rgba(255,255,255,0.055) 0%, rgba(255,255,255,0) 38%), linear-gradient(to bottom right, #0f172a, #003087, #001a4d);"
  >
    <!-- Subtle grid -->
    <div
      class="absolute inset-0 opacity-[0.07]"
      style="background-image: linear-gradient(rgba(255,255,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px); background-size: 60px 60px;"
    >
    </div>

    <!-- Ambient glows -->
    <div
      class="absolute top-0 right-0 w-[700px] h-[700px] rounded-full blur-[140px] opacity-20 pointer-events-none"
      style="background: radial-gradient(circle, #00CED1, transparent 70%);"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full blur-[100px] opacity-15 pointer-events-none"
      style="background: radial-gradient(circle, #C4982A, transparent 70%);"
    >
    </div>

    <div class="relative z-10 max-w-5xl mx-auto text-center">
      <!-- Eyebrow -->
      <div
        class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-5 py-2.5 mb-8"
        data-aos="fade-down"
      >
        <span class="w-2 h-2 bg-teal-400 rounded-full animate-pulse"></span>
        <span class="text-sm font-semibold text-teal-100 tracking-wide"
          >Guided Imaging by USRad</span
        >
      </div>

      <!-- Headline -->
      <h1
        class="text-5xl sm:text-6xl md:text-7xl font-black text-white mb-7 leading-[1.05] tracking-tight"
        data-aos="fade-up"
      >
        How USRad Works
      </h1>

      <!-- Step bar — PRIMARY visual anchor -->
      <div
        class="inline-flex justify-center items-center gap-2 sm:gap-3 flex-wrap mb-8 px-6 py-3 rounded-2xl step-bar-glass"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <button class="hero-step active" data-step="1">
          <span class="step-num">1</span>
          <span class="step-lbl">Search</span>
        </button>
        <svg
          class="step-arrow"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          ><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
          ></path></svg
        >
        <button class="hero-step" data-step="2">
          <span class="step-num">2</span>
          <span class="step-lbl">Compare</span>
        </button>
        <svg
          class="step-arrow"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          ><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
          ></path></svg
        >
        <button class="hero-step" data-step="3">
          <span class="step-num">3</span>
          <span class="step-lbl">Request</span>
        </button>
        <svg
          class="step-arrow"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          ><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
          ></path></svg
        >
        <button class="hero-step" data-step="4">
          <span class="step-num">✓</span>
          <span class="step-lbl">Done</span>
        </button>
      </div>

      <!-- Subheads -->
      <p
        class="text-xl md:text-2xl text-white/75 max-w-2xl mx-auto mb-3 leading-relaxed"
        data-aos="fade-up"
        data-aos-delay="150"
      >
        Four guided steps to transparent medical imaging.<br
          class="hidden sm:block"
        />No insurance required. No billing surprises.
      </p>
      <p
        class="text-base text-white/45 max-w-xl mx-auto mb-10"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        USRad coordinates the process behind the scenes — so you focus entirely
        on your health.
      </p>

      <!-- CTA -->
      <div data-aos="fade-up" data-aos-delay="250">
        <a
          href="/#hero-search"
          class="inline-flex items-center gap-2 bg-[#C4982A] hover:bg-[#b8891f] text-white font-bold px-8 py-4 rounded-xl text-lg transition-all transform hover:scale-105 shadow-2xl shadow-[#C4982A]/30"
        >
          Find Centers Near You
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
          >
        </a>
        <p class="text-xs text-white/35 mt-3 tracking-wide">
          No account needed · Free search · HIPAA compliant
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
    STICKY WALKTHROUGH — 4 Steps (left scroll / right sticky)
  ============================================================ -->
  <section id="walkthrough" class="bg-white relative">
    <!-- ── Sticky progress strip ── -->
    <div id="walk-progress" class="walk-progress-bar">
      <button class="wps-step wps-active" data-goto="1">
        <span class="wps-indicator"></span>
        <span class="wps-label">Search</span>
      </button>
      <span class="wps-connector"></span>
      <button class="wps-step" data-goto="2">
        <span class="wps-indicator"></span>
        <span class="wps-label">Compare</span>
      </button>
      <span class="wps-connector"></span>
      <button class="wps-step" data-goto="3">
        <span class="wps-indicator"></span>
        <span class="wps-label">Request</span>
      </button>
      <span class="wps-connector"></span>
      <button class="wps-step" data-goto="4">
        <span class="wps-indicator"></span>
        <span class="wps-label">Appointment Secured</span>
      </button>
    </div>

    <div class="max-w-[1400px] mx-auto">
      <div class="walkthrough-layout">
        <!-- ── LEFT: scrolling narrative ── -->
        <div class="walkthrough-narrative">
          <!-- STEP 1 -->
          <div class="walk-step" id="walk-1">
            <div class="walk-inner">
              <div class="walk-step-chip">
                <span class="chip-num chip-blue">1</span>
                <span class="chip-label">Search · Under 30 seconds</span>
              </div>
              <h2 class="walk-h2">
                Choose Your Scan.<br />Enter Your ZIP Code.
              </h2>
              <p class="walk-p">
                No phone calls. No referral required to search. Select your
                procedure from our curated list, enter your location, and
                instantly see imaging centers near you — with real,
                all-inclusive prices displayed upfront.
              </p>
              <ul class="walk-list">
                <li>
                  <span class="wl-check">✓</span><span
                    >MRI, CT, X-ray and more — browse from one search</span
                  >
                </li>
                <li>
                  <span class="wl-check">✓</span><span
                    >Medicare-anchored, all-inclusive pricing — no hidden fees</span
                  >
                </li>
                <li>
                  <span class="wl-check">✓</span><span
                    >Map and list views — filter by distance or network tier</span
                  >
                </li>
                <li>
                  <span class="wl-check">✓</span><span
                    >Completely anonymous — no login required to search</span
                  >
                </li>
              </ul>
            </div>
          </div>

          <!-- STEP 2 -->
          <div class="walk-step" id="walk-2">
            <div class="walk-inner">
              <div class="walk-step-chip">
                <span class="chip-num chip-blue">2</span>
                <span class="chip-label">Compare · Complete transparency</span>
              </div>
              <h2 class="walk-h2">Compare with<br />Complete Transparency</h2>
              <p class="walk-p">
                See everything upfront: all-inclusive prices, network status,
                distance, and availability. No hidden fees. No billing
                surprises. Results include two tiers — so you always have
                options.
              </p>
              <ul class="walk-list">
                <li>
                  <span class="wl-check">✓</span><span
                    ><strong>USRad Network Partners</strong> — available for immediate
                    online booking</span
                  >
                </li>
                <li>
                  <span class="wl-check">✓</span><span
                    ><strong>Discovery Network</strong> — ACR-accredited facilities;
                    register interest as network expands</span
                  >
                </li>
                <li>
                  <span class="wl-check">✓</span><span
                    >Facility names shown at city level — full details revealed
                    after booking</span
                  >
                </li>
                <li>
                  <span class="wl-check">✓</span><span
                    >Payment collected only after your appointment is confirmed</span
                  >
                </li>
              </ul>
              <div class="walk-callout">
                <span class="text-lg">🌐</span>
                <div>
                  <p class="font-semibold text-gray-900 text-sm mb-1">
                    About the Discovery Network
                  </p>
                  <p class="text-sm text-gray-600">
                    USRad displays 27,000+ ACR-accredited facilities nationwide
                    so members always see options — even before a center has
                    joined our contracted network. Discovery Network centers
                    allow you to register interest, feeding our provider
                    recruitment directly.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 3 -->
          <div class="walk-step" id="walk-3">
            <div class="walk-inner">
              <div class="walk-step-chip">
                <span class="chip-num chip-blue">3</span>
                <span class="chip-label">Request · Guided 6-step form</span>
              </div>
              <h2 class="walk-h2">Submit Your<br />Booking Request</h2>
              <p class="walk-p">
                No payment required today. Our guided form collects your
                preferences and USRad handles the coordination. You submit a
                request — we secure the appointment.
              </p>
              <div class="mini-steps">
                <div class="mini-step">
                  <span class="mini-num mini-navy">1</span><div>
                    <p class="font-semibold text-sm text-gray-900">
                      Verify Email
                    </p><p class="text-sm text-gray-500">
                      One-time secure link — no password needed
                    </p>
                  </div>
                </div>
                <div class="mini-step">
                  <span class="mini-num mini-navy">2</span><div>
                    <p class="font-semibold text-sm text-gray-900">
                      Member Information
                    </p><p class="text-sm text-gray-500">
                      Name, contact, DOB — encrypted &amp; HIPAA-compliant
                    </p>
                  </div>
                </div>
                <div class="mini-step">
                  <span class="mini-num mini-navy">3</span><div>
                    <p class="font-semibold text-sm text-gray-900">
                      Appointment Preferences
                    </p><p class="text-sm text-gray-500">
                      Two preferred dates + flexible scheduling option
                    </p>
                  </div>
                </div>
                <div class="mini-step">
                  <span class="mini-num mini-navy">4</span><div>
                    <p class="font-semibold text-sm text-gray-900">
                      Safety &amp; Prep
                    </p><p class="text-sm text-gray-500">
                      MRI safety screening shared with your imaging center
                    </p>
                  </div>
                </div>
                <div class="mini-step">
                  <span class="mini-num mini-navy">5</span><div>
                    <p class="font-semibold text-sm text-gray-900">
                      Doctor's Order (Rx)
                    </p><p class="text-sm text-gray-500">
                      Upload now or submit later via your Member Portal
                    </p>
                  </div>
                </div>
                <div class="mini-step">
                  <span class="mini-num mini-green">✓</span><div>
                    <p class="font-semibold text-sm text-gray-900">
                      Review &amp; Submit
                    </p><p class="text-sm text-gray-500">
                      Confirm everything — no payment at this step
                    </p>
                  </div>
                </div>
              </div>
              <div class="walk-callout walk-callout-navy">
                <span class="text-xl">🛡️</span>
                <div>
                  <p class="font-bold text-white text-sm mb-1">
                    Reserve First. Pay Later.
                  </p>
                  <p class="text-sm text-white/80">
                    As a USRad Member, you never pay at the front desk. Your
                    all-inclusive rate is collected only after your appointment
                    is confirmed — via a secure payment link sent directly to
                    you.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 4 -->
          <div class="walk-step" id="walk-4">
            <div class="walk-inner">
              <div class="walk-step-chip">
                <span class="chip-num chip-green">✓</span>
                <span class="chip-label chip-label-green"
                  >Secures Appointment</span
                >
              </div>
              <h2 class="walk-h2">USRad Secures<br />Your Appointment</h2>
              <p class="walk-p">
                The moment you submit, USRad's coordination layer activates. You
                receive a Booking ID and our team begins working with the
                imaging center on your behalf.
              </p>
              <ul class="walk-list">
                <li>
                  <span class="wl-check wl-green">✓</span><span
                    ><strong>Immediately</strong> — Booking ID + confirmation email
                    sent</span
                  >
                </li>
                <li>
                  <span class="wl-check wl-green">✓</span><span
                    ><strong>Within 4 hours</strong> — USRad coordinates with imaging
                    center</span
                  >
                </li>
                <li>
                  <span class="wl-check wl-green">✓</span><span
                    ><strong>Appointment confirmed</strong> — Facility details revealed
                    + secure payment link</span
                  >
                </li>
                <li>
                  <span class="wl-check wl-green">✓</span><span
                    ><strong>Scan day</strong> — 5 min check-in · 20–45 min scan
                    · Zero payment at facility</span
                  >
                </li>
                <li>
                  <span class="wl-check wl-green">✓</span><span
                    >Board-certified radiologist report delivered directly to
                    you and your doctor</span
                  >
                </li>
              </ul>
            </div>
          </div>
        </div><!-- /narrative -->

        <!-- ── RIGHT: sticky 3D screenshot panel ── -->
        <div class="walkthrough-sticky-col" id="sticky-col">
          <div class="sticky-panel" id="sticky-panel">
            <!-- Progress dots -->
            <div class="sticky-dots">
              <button
                class="sdot active"
                data-target="1"
                aria-label="Step 1 — Search"></button>
              <button class="sdot" data-target="2" aria-label="Step 2 — Compare"
              ></button>
              <button class="sdot" data-target="3" aria-label="Step 3 — Request"
              ></button>
              <button class="sdot" data-target="4" aria-label="Step 4 — Done"
              ></button>
            </div>

            <!-- Step label -->
            <div class="sticky-step-label" id="sticky-label">
              <span class="ssl-num">Step 1</span>
              <span class="ssl-title" id="ssl-title">Search</span>
            </div>

            <!-- 3D Screen wrapper — perspective set here -->
            <div class="screen-stage">
              <!--
                ═══════════════════════════════════════════════════
                SCREENSHOT SWAP SYSTEM
                ═══════════════════════════════════════════════════
                Each .screen-card is shown when its step is active.

                TO REPLACE A SCREEN WITH A REAL SCREENSHOT:
                  1. Remove the .screen-sim div inside the .screen-body
                  2. Add: <img src="/images/hiw/step[N]-[name].png"
                               alt="descriptive alt text"
                               class="w-full h-full object-cover object-top" />
                  3. Recommended crop: 1200×800px, no browser chrome,
                     zoom UI to 110–115% before cropping, clean demo data

                SCREENSHOT SOURCES (from your walkthrough session):
                  Screen 1 → Search modal (procedure selection)
                  Screen 2 → PBS search results page
                  Screen 3 → Booking form — Member Information (post-verification)
                  Screen 4 → My Bookings / tracking page
                ═══════════════════════════════════════════════════
              -->

              <!-- SCREEN 1: Search -->
              <div class="screen-card active" id="sc-1">
                <div class="screen-device">
                  <div class="screen-chrome">
                    <div class="chrome-dots">
                      <span></span><span></span><span></span>
                    </div>
                    <div class="chrome-bar">usrad.com</div>
                  </div>
                  <div class="screen-body">
                    <img
                      src="/images/hiw/step1-final.png"
                      alt="USRad procedure search modal showing MRI Knee options"
                      class="w-full h-full object-cover object-top"
                    />
                  </div>
                </div>
                <div class="screen-shadow"></div>
                <div class="screen-glow"></div>
              </div>

              <!-- SCREEN 2: Compare -->
              <div class="screen-card" id="sc-2">
                <div class="screen-device">
                  <div class="screen-chrome">
                    <div class="chrome-dots">
                      <span></span><span></span><span></span>
                    </div>
                    <div class="chrome-bar">usrad.com/pbs/search</div>
                  </div>
                  <div class="screen-body">
                    <img
                      src="/images/hiw/step2-final.png"
                      alt="USRad search results showing $267.30 pricing with Request Appointment button"
                      class="w-full h-full object-cover object-top"
                    />
                  </div>
                </div>
                <div class="screen-shadow"></div>
                <div class="screen-glow"></div>
              </div>

              <!-- SCREEN 3: Request -->
              <div class="screen-card" id="sc-3">
                <div class="screen-device">
                  <div class="screen-chrome">
                    <div class="chrome-dots">
                      <span></span><span></span><span></span>
                    </div>
                    <div class="chrome-bar">usrad.com/pbs/book</div>
                  </div>
                  <div class="screen-body">
                    <img
                      src="/images/hiw/step3-final.png"
                      alt="USRad booking form Member Information with verified email and $267.30 booking summary"
                      class="w-full h-full object-cover object-top"
                    />
                  </div>
                </div>
                <div class="screen-shadow"></div>
                <div class="screen-glow"></div>
              </div>

              <!-- SCREEN 4: Done / Tracking -->
              <div class="screen-card" id="sc-4">
                <div class="screen-device">
                  <div class="screen-chrome">
                    <div class="chrome-dots">
                      <span></span><span></span><span></span>
                    </div>
                    <div class="chrome-bar">usrad.com/pbs/my-bookings</div>
                  </div>
                  <div class="screen-body">
                    <img
                      src="/images/hiw/step4-final.png"
                      alt="USRad booking tracker showing Booking Submitted and Facility Confirmation in progress"
                      class="w-full h-full object-cover object-top"
                    />
                  </div>
                </div>
                <div class="screen-shadow"></div>
                <div class="screen-glow"></div>
              </div>
            </div><!-- /screen-stage -->
          </div><!-- /sticky-panel -->
        </div><!-- /sticky col -->
      </div><!-- /walkthrough-layout -->
    </div>
  </section>

  <MemberRightsSummary />

  <!-- ============================================================
    WHY USRAD PRICES ARE LOWER
  ============================================================ -->
  <section class="py-20 px-4 sm:px-6 bg-slate-50" data-aos="fade-up">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <p
          class="text-xs font-bold tracking-[0.2em] text-[#C4982A] uppercase mb-3"
        >
          Price Transparency
        </p>
        <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-4">
          Why USRad Prices Are Lower
        </h2>
        <p class="text-xl text-gray-500 max-w-2xl mx-auto">
          The scan is identical. The difference is structural — not in quality.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5 mb-10">
        <div class="bg-white border border-red-100 rounded-2xl p-7">
          <div class="flex items-center gap-3 mb-5">
            <div
              class="w-10 h-10 bg-red-50 rounded-xl flex items-center justify-center text-lg"
            >
              🏥
            </div>
            <div>
              <p class="font-bold text-gray-900">
                Traditional Hospital Imaging
              </p>
              <p class="text-sm text-red-500 font-semibold">
                ~$800–$3,200 per scan
              </p>
            </div>
          </div>
          <div class="space-y-2 text-sm text-gray-500">
            <p class="flex items-center gap-2">
              <span class="text-red-400 font-bold">✗</span> Insurance billing layers
            </p>
            <p class="flex items-center gap-2">
              <span class="text-red-400 font-bold">✗</span> Multiple bills (facility
              + radiologist)
            </p>
            <p class="flex items-center gap-2">
              <span class="text-red-400 font-bold">✗</span> Opaque chargemaster pricing
            </p>
            <p class="flex items-center gap-2">
              <span class="text-red-400 font-bold">✗</span> Self-navigate scheduling
              &amp; referrals
            </p>
            <p class="flex items-center gap-2">
              <span class="text-red-400 font-bold">✗</span> Co-pay or balance bill
              at the desk
            </p>
          </div>
        </div>
        <div class="bg-[#003087] rounded-2xl p-7 text-white">
          <div class="flex items-center gap-3 mb-5">
            <div
              class="w-10 h-10 bg-white/10 rounded-xl flex items-center justify-center text-lg"
            >
              🎯
            </div>
            <div>
              <p class="font-bold">USRad Guided Imaging</p>
              <p class="text-sm text-[#C4982A] font-bold">
                ~$200–$400 all-inclusive
              </p>
            </div>
          </div>
          <div class="space-y-2 text-sm text-white/80">
            <p class="flex items-center gap-2">
              <span class="text-teal-400 font-bold">✓</span> Medicare-anchored transparent
              pricing
            </p>
            <p class="flex items-center gap-2">
              <span class="text-teal-400 font-bold">✓</span> One all-inclusive rate
              (scan + report)
            </p>
            <p class="flex items-center gap-2">
              <span class="text-teal-400 font-bold">✓</span> Price shown upfront
              before you book
            </p>
            <p class="flex items-center gap-2">
              <span class="text-teal-400 font-bold">✓</span> USRad coordinates everything
              for you
            </p>
            <p class="flex items-center gap-2">
              <span class="text-teal-400 font-bold">✓</span> Zero payment at the
              facility — ever
            </p>
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <div
          class="text-center p-6 bg-white rounded-2xl border border-gray-100 shadow-sm"
        >
          <div
            class="w-14 h-14 bg-teal-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl"
          >
            📊
          </div>
          <h3 class="font-bold text-gray-900 mb-2">
            Medicare-Anchored Pricing
          </h3>
          <p class="text-sm text-gray-500">
            Every scan is priced as a percentage of Medicare rates — the same
            benchmark used across the healthcare industry. Consistent.
            Transparent. Explainable.
          </p>
        </div>
        <div
          class="text-center p-6 bg-white rounded-2xl border border-gray-100 shadow-sm"
        >
          <div
            class="w-14 h-14 bg-teal-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl"
          >
            🚫
          </div>
          <h3 class="font-bold text-gray-900 mb-2">No Insurance Billing</h3>
          <p class="text-sm text-gray-500">
            Insurance billing adds administrative layers that inflate prices.
            USRad removes that complexity entirely with one all-inclusive rate
            covering scan and radiologist report.
          </p>
        </div>
        <div
