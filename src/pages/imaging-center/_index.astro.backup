---
import MainLayout from "../../layouts/MainLayout.astro";
import AOSInit from "../../components/AOSInit.astro";
import NetworkMap from "../../components/imaging/NetworkMap.astro";
---

<style>
  @import url("https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap");

  body,
  html {
    font-family: "Manrope", sans-serif;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Manrope", sans-serif;
    font-weight: 600;
  }

  p,
  a,
  button,
  input,
  select,
  textarea {
    font-family: "Manrope", sans-serif;
  }

  .abstract-medical-accent {
    position: absolute;
    width: 300px;
    height: 300px;
    background-image: url("/images/abstract-medical-visual.svg");
    background-size: contain;
    background-repeat: no-repeat;
    opacity: 0.08;
    z-index: 0;
  }

  .relative-z-1 {
    position: relative;
    z-index: 1;
  }
</style>

<MainLayout>
  <AOSInit />

  <!-- Enhanced Hero Section with AnciCare Credibility -->
  <section
    class="relative w-full min-h-[700px] overflow-hidden bg-[#fcf9f0] text-[#003087]"
  >
    <!-- Credibility Banner -->
    <div
      class="absolute top-0 left-0 right-0 bg-gradient-to-r from-[#cc9933] to-[#003087] text-white py-2 px-4 text-center z-30"
    >
      <p class="text-sm font-medium">
        🏆 <strong>PROVIDER RECRUITMENT EXPERTS:</strong> Successfully recruited
        1,200+ centers through AnciCare (1994-2002) • $400M+ volume delivered • Acquired
        by CorVel Corporation (NYSE: CVL)
      </p>
    </div>

    <!-- Video Background -->
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover z-0 mt-8"
      poster="/images/website/imaging-center-hero-fallback.webp?v=2.1"
    >
      <source
        src="/videos/imaging-center-hero-mobile.mp4"
        type="video/mp4"
        media="(max-width: 768px)"
      />
      <source src="/videos/imaging-center-hero.mp4" type="video/mp4" />
      <source src="/videos/imaging-center-hero.webm" type="video/webm" />
      <img
        src="/images/website/imaging-center-hero-fallback.webp?v=2.1"
        alt="Radiologist collaboration - Join the proven USRad network"
        class="w-full h-full object-cover"
      />
    </video>

    <!-- Enhanced Radial Overlay -->
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.95)_0%,rgba(255,255,255,0.8)_40%,rgba(0,48,135,0.1)_85%)] z-10 mt-8"
    >
    </div>

    <!-- Hero Content -->
    <div class="max-w-6xl mx-auto relative z-20 px-6 py-24 mt-8">
      <div class="text-center mb-12">
        <!-- Credibility Badge -->
        <div class="mb-6" data-aos="fade-up" data-aos-delay="50">
          <span
            class="inline-flex items-center gap-2 px-6 py-3 bg-white/95 backdrop-blur-sm rounded-full shadow-lg border border-[#cc9933]/30"
          >
            <svg
              class="w-5 h-5 text-[#cc9933]"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-[#003087] font-bold text-sm"
              >PROVEN VOLUME DRIVERS • NOT JUST ANOTHER PLATFORM</span
            >
          </span>
        </div>

        <h1
          class="text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-tight font-manrope text-[#003087] drop-shadow-[0_2px_4px_rgba(0,0,0,0.15)]"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Join the <span class="text-[#cc9933] relative font-black">
            AnciCare Legacy
            <svg
              class="absolute -bottom-2 left-0 w-full"
              height="6"
              viewBox="0 0 340 6"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M2 3.5C2 3.5 70 0.5 170 3.5C270 6.5 338 3.5 338 3.5"
                stroke="#cc9933"
                stroke-width="4"
                stroke-linecap="round"></path>
            </svg>
          </span>
        </h1>

        <p
          class="mt-6 text-xl sm:text-2xl text-[#003087] max-w-4xl mx-auto leading-relaxed font-manrope"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          The same team that successfully recruited 1,200+ imaging centers and
          delivered $400M+ in volume through AnciCare is now building USRad.
          Join the proven network that imaging centers trust.
        </p>

        <p
          class="mt-4 text-lg text-[#003087]/80 max-w-3xl mx-auto font-manrope"
          data-aos="fade-up"
          data-aos-delay="250"
        >
          <strong>90 million uninsured and underinsured patients</strong> need direct-pay
          imaging. We bring them to your center with guaranteed payment and zero
          billing complexity.
        </p>
      </div>

      <!-- Enhanced Quick Stats with AnciCare Credibility -->
      <div
        class="mt-12 grid grid-cols-1 md:grid-cols-4 gap-4 max-w-5xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="400"
      >
        <div
          class="bg-white/95 p-4 rounded-xl shadow-lg text-center transform hover:scale-105 transition-all duration-300 border-t-4 border-[#cc9933]"
        >
          <div
            class="text-[#003087] text-3xl font-bold mb-2 font-manrope stat-number"
          >
            1,200+
          </div>
          <p class="text-[#003087] font-manrope text-sm">Centers Recruited</p>
          <div class="text-xs text-blue-600 mt-1">AnciCare Track Record</div>
        </div>
        <div
          class="bg-white/95 p-4 rounded-xl shadow-lg text-center transform hover:scale-105 transition-all duration-300 border-t-4 border-[#cc9933]"
        >
          <div
            class="text-[#003087] text-3xl font-bold mb-2 font-manrope stat-number"
          >
            $400M+
          </div>
          <p class="text-[#003087] font-manrope text-sm">Volume Delivered</p>
          <div class="text-xs text-green-600 mt-1">Proven Results</div>
        </div>
        <div
          class="bg-white/95 p-4 rounded-xl shadow-lg text-center transform hover:scale-105 transition-all duration-300 border-t-4 border-[#cc9933]"
        >
          <div
            class="text-[#003087] text-3xl font-bold mb-2 font-manrope stat-number"
          >
            90M+
          </div>
          <p class="text-[#003087] font-manrope text-sm">Target Patients</p>
          <div class="text-xs text-purple-600 mt-1">Market Opportunity</div>
        </div>

        <div
          class="bg-white/95 p-4 rounded-xl shadow-lg text-center transform hover:scale-105 transition-all duration-300 border-t-4 border-[#cc9933]"
        >
          <!-- Enhanced Rotating Benefits for Providers -->
          <div class="h-16 flex items-center justify-center overflow-hidden">
            <div
              id="rotating-benefits"
              class="text-center transition-opacity duration-500"
            >
              <div class="benefit-item opacity-100">
                <div
                  class="text-[#003087] text-3xl font-bold mb-1 font-manrope stat-number"
                >
                  15 Days
                </div>
                <p class="text-[#003087] font-manrope text-sm">
                  Payment Guarantee
                </p>
                <div class="text-xs text-orange-600 mt-1">
                  Proven Performance
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Primary CTA Section -->
      <div class="mt-12 text-center" data-aos="fade-up" data-aos-delay="500">
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
          <a
            href="/imaging-center/apply"
            class="bg-[#cc9933] hover:bg-[#b8862e] text-[#003087] px-8 py-4 rounded-xl font-bold text-lg transition-all shadow-lg transform hover:scale-105"
          >
            🚀 Apply to Join Network
          </a>
          <a
            href="#benefits-section"
            class="border-2 border-[#003087] text-[#003087] hover:bg-[#003087] hover:text-white px-8 py-4 rounded-xl font-bold text-lg transition-all"
          >
            📊 See Provider Benefits
          </a>
        </div>
        <p class="text-sm text-[#003087]/70">
          The same proven recruitment approach that built a 1,200+ center
          network
        </p>
      </div>
    </div>

    <script>
      // Enhanced rotation with provider-focused benefits
      const benefits = [
        {
          number: "15 Days",
          text: "Payment Guarantee",
          subtext: "Proven Performance",
          hasStatNumber: false,
        },
        {
          number: "20-40%",
          text: "Volume Increase",
          subtext: "Typical Results",
          hasStatNumber: true,
        },
        {
          number: "100%",
          text: "Payment Collection",
          subtext: "Zero Risk",
          hasStatNumber: true,
        },
        {
          number: "96%",
          text: "Patient Show Rate",
          subtext: "Proven Process",
          hasStatNumber: true,
        },
      ];

      const container = document.getElementById("rotating-benefits");
      let currentIndex = 0;

      function updateBenefit() {
        const benefit = benefits[currentIndex];
        const statNumberClass = benefit.hasStatNumber ? "stat-number" : "";

        container.style.opacity = "0";

        setTimeout(() => {
          container.innerHTML = `
            <div class="benefit-item">
              <div class="text-[#003087] text-3xl font-bold mb-1 font-manrope ${statNumberClass}">
                ${benefit.number}
              </div>
              <p class="text-[#003087] font-manrope text-sm">${benefit.text}</p>
              <div class="text-xs text-orange-600 mt-1">${benefit.subtext}</div>
            </div>
          `;
          container.style.opacity = "1";
        }, 250);

        currentIndex = (currentIndex + 1) % benefits.length;
      }

      setInterval(updateBenefit, 3000);
    </script>
  </section>

  <!-- NEW: AnciCare Provider Success Story -->
  <section
    class="py-20 bg-gradient-to-br from-[#003087] to-[#0052cc] text-white px-6 sm:px-12"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          We've Done This Before - Successfully
        </h2>
        <p class="text-xl text-blue-100 max-w-4xl mx-auto">
          Through AnciCare (1994-2002), we recruited and successfully managed
          1,200+ imaging centers, delivering consistent volume and $400M+ in
          revenue. Here's how we did it:
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <!-- AnciCare Success Timeline -->
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold"
            >
              1
            </div>
            <div>
              <h3 class="text-xl font-semibold text-[#cc9933] mb-2">
                Recruited Quality Partners (1994-1996)
              </h3>
              <p class="text-blue-100">
                Built relationships with imaging centers nationwide, focusing on
                quality facilities with excellent equipment and service.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold"
            >
              2
            </div>
            <div>
              <h3 class="text-xl font-semibold text-[#cc9933] mb-2">
                Delivered Consistent Volume (1996-2000)
              </h3>
              <p class="text-blue-100">
                Generated 400,000+ patient visits for our partner centers
                through effective marketing and patient acquisition programs.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold"
            >
              3
            </div>
            <div>
              <h3 class="text-xl font-semibold text-[#cc9933] mb-2">
                Guaranteed Partner Success (1994-2002)
              </h3>
              <p class="text-blue-100">
                Maintained 96%+ patient show rates, 100% payment collection, and
                15-day payment cycles throughout our operation.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold"
            >
              4
            </div>
            <div>
              <h3 class="text-xl font-semibold text-[#cc9933] mb-2">
                CorVel Corporation Acquisition (2002)
              </h3>
              <p class="text-blue-100">
                Our partner network was so valuable that CorVel Corporation
                (NYSE: CVL) acquired us. They're still operating our model
                today.
              </p>
            </div>
          </div>
        </div>

        <!-- Provider Value Delivered -->
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8">
          <h3 class="text-2xl font-bold text-center mb-6">
            Value Delivered to Partners
          </h3>
          <div class="grid grid-cols-2 gap-6">
            <div class="text-center">
              <div class="text-3xl font-bold text-[#cc9933]">1,200+</div>
              <div class="text-sm text-blue-100">Centers Partnered</div>
              <div class="text-xs text-blue-200">Nationwide Network</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-[#cc9933]">400K+</div>
              <div class="text-sm text-blue-100">Patient Visits</div>
              <div class="text-xs text-blue-200">Volume Generated</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-[#cc9933]">$400M+</div>
              <div class="text-sm text-blue-100">Revenue Delivered</div>
              <div class="text-xs text-blue-200">To Partner Centers</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-[#cc9933]">96%+</div>
              <div class="text-sm text-blue-100">Show Rate</div>
              <div class="text-xs text-blue-200">Reliable Patients</div>
            </div>
          </div>

          <div class="mt-6 p-4 bg-[#cc9933]/20 rounded-lg text-center">
            <div class="text-lg font-bold text-[#cc9933]">
              The Ultimate Validation
            </div>
            <div class="text-sm text-blue-100">
              CorVel Corporation acquired our network and still operates it 20+
              years later
            </div>
          </div>
        </div>
      </div>

      <!-- Partner Testimonial Style Quote -->
      <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 text-center">
        <div class="text-6xl text-[#cc9933] opacity-30 mb-4">"</div>
        <blockquote class="text-xl italic mb-6">
          We didn't just recruit imaging centers—we built lasting partnerships
          that delivered real value. Consistent volume, reliable patients,
          guaranteed payments, and operational simplicity. That's why our
          partners stayed with us and why CorVel wanted to acquire the entire
          network.
        </blockquote>
        <div class="text-sm text-blue-200">
          — The USRad Founding Team, Reflecting on AnciCare's Partner Success
          (1994-2002)
        </div>
      </div>
    </div>
  </section>

  <!-- Enhanced Core Benefits Section -->
  <section
    id="benefits-section"
    class="py-16 bg-white text-[#003087] relative overflow-hidden"
  >
    <div class="px-6 sm:px-8 lg:px-12">
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="text-center mb-12" data-aos="fade-up" data-aos-delay="100">
          <h2 class="text-4xl font-semibold text-[#003087] mb-4 font-manrope">
            AnciCare-Proven Provider Benefits
          </h2>
          <p class="text-xl text-gray-700 max-w-3xl mx-auto font-manrope">
            The same benefits that made 1,200+ imaging centers successful
            partners, now enhanced for today's self-pay market opportunity.
          </p>
          <div
            class="mt-4 inline-flex items-center gap-2 bg-blue-50 rounded-full px-6 py-3"
          >
            <svg
              class="w-5 h-5 text-blue-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-blue-700 font-semibold text-sm"
              >Validated by CorVel Corporation acquisition and 20+ years of
              continued operation</span
            >
          </div>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Benefit 1: Incremental Revenue -->
          <div
            class="bg-gradient-to-br from-blue-50 to-blue-100 p-8 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 border-t-4 border-[#cc9933]"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <div
              class="w-16 h-16 bg-[#003087] rounded-full flex items-center justify-center mb-6 mx-auto"
            >
              <svg
                class="h-8 w-8 text-white"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <h3
              class="text-xl font-semibold text-[#003087] text-center mb-4 font-manrope"
            >
              Proven Volume Growth
            </h3>
            <p class="text-[#003087] text-center font-manrope mb-4">
              Convert vacant appointment slots into immediate revenue. AnciCare
              partners typically saw 20-40% volume increases with zero
              additional overhead costs.
            </p>
            <div class="bg-white/50 rounded-lg p-3">
              <div class="text-sm text-blue-700 font-semibold">
                AnciCare Track Record:
              </div>
              <div class="text-xs text-blue-600">
                400,000+ patient visits generated for partners
              </div>
            </div>
          </div>

          <!-- Benefit 2: Simplified Operations -->
          <div
            class="bg-gradient-to-br from-green-50 to-green-100 p-8 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 border-t-4 border-[#cc9933]"
            data-aos="fade-up"
            data-aos-delay="300"
          >
            <div
              class="w-16 h-16 bg-[#cc9933] rounded-full flex items-center justify-center mb-6 mx-auto"
            >
              <svg
                class="h-8 w-8 text-white"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3
              class="text-xl font-semibold text-[#003087] text-center mb-4 font-manrope"
            >
              Complete Operational Support
            </h3>
            <p class="text-[#003087] text-center font-manrope mb-4">
              We handle patient acquisition, screening, scheduling, and payment
              processing. Same comprehensive support that made AnciCare partners
              successful for 8 years.
            </p>
            <div class="bg-white/50 rounded-lg p-3">
              <div class="text-sm text-green-700 font-semibold">
                Proven Efficiency:
              </div>
              <div class="text-xs text-green-600">
                96% patient show rate achieved through expert management
              </div>
            </div>
          </div>

          <!-- Benefit 3: Guaranteed Payment -->
          <div
            class="bg-gradient-to-br from-purple-50 to-purple-100 p-8 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 border-t-4 border-[#cc9933]"
            data-aos="fade-up"
            data-aos-delay="400"
          >
            <div
              class="w-16 h-16 bg-purple-600 rounded-full flex items-center justify-center mb-6 mx-auto"
            >
              <svg
                class="h-8 w-8 text-white"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <h3
              class="text-xl font-semibold text-[#003087] text-center mb-4 font-manrope"
            >
              Payment Guarantee
            </h3>
            <p class="text-[#003087] text-center font-manrope mb-4">
              100% payment collection with 15-day reimbursement cycles. No
              insurance claims, denials, or delays. Same reliable payment model
              that processed $400M+ through AnciCare.
            </p>
            <div class="bg-white/50 rounded-lg p-3">
              <div class="text-sm text-purple-700 font-semibold">
                Financial Security:
              </div>
              <div class="text-xs text-purple-600">
                $400M+ successfully processed with 100% collection rate
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Enhanced Michael Cabrera Founder Section -->
  <section
    class="py-16 bg-[#fcf9f0] text-gray-800 relative overflow-hidden"
    data-aos="fade-up"
    data-aos-delay="100"
  >
    <div class="px-6 sm:px-8 lg:px-12">
      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div
            class="relative flex justify-center items-center"
            data-aos="fade-right"
            data-aos-delay="200"
          >
            <img
              src="/images/michael.jpg"
              srcset="/images/michael-sm.jpg 400w, /images/michael.jpg 800w"
              sizes="(max-width: 768px) 85vw, 40vw"
              width="600"
              height="750"
              loading="lazy"
              alt="Michael Cabrera, Founder & CEO - AnciCare Builder and CorVel Success Story"
              class="w-[85%] h-auto rounded-xl shadow-lg relative z-10"
            />
            <div
              class="absolute -bottom-4 -left-4 w-24 h-24 rounded-full bg-[#e6c378] opacity-20"
            >
            </div>
          </div>

          <div class="space-y-5" data-aos="fade-left" data-aos-delay="300">
            <!-- Enhanced Positioning Badges -->
            <div class="flex items-center space-x-4 text-sm">
              <span
                class="px-3 py-1 bg-[#cc9933] text-white rounded-full font-semibold"
              >
                AnciCare Founder
              </span>
