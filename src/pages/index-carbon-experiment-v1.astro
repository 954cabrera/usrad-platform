---
// index-carbon-experiment-v1.astro
// EXPERIMENTAL: Minimal MDSave-Style Search Form
// Changes: Hero search form only - dramatically simplified
// Untouched: All other sections, all JavaScript, all functionality

import CarbonLayout from "../layouts/CarbonLayout.astro";
import NetworkMapPinsCarbon from "../components/NetworkMapPinsCarbon.astro";
import AOSInit from "../components/AOSInit.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import SecondaryButton from "../components/SecondaryButton.astro";

const REMIX_URL = import.meta.env.PUBLIC_REMIX_URL || "http://localhost:5173";
---

<CarbonLayout title="USRad - MRI Scans in 48 Hours, 70% Less" isHeroPage={true}>
  <meta name="remix-url" content={REMIX_URL} />
  <AOSInit />

  <!-- ✨ EXPERIMENTAL HERO SECTION - Minimal Search Form -->
  <section
    class="relative py-24 px-4 sm:px-6 bg-[#003087] text-white overflow-hidden"
    data-aos="fade-up"
  >
    <!-- Video Background (Unchanged) -->
    <div class="absolute inset-0 z-0">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        class="absolute inset-0 w-full h-full object-cover"
        poster="/images/home-hero-mri.webp?v=2.1"
      >
        <source
          src="/videos/home-hero-mri-mobile.mp4"
          type="video/mp4"
          media="(max-width: 768px)"
        />
        <source src="/videos/home-hero-mri.mp4" type="video/mp4" />
        <source src="/videos/home-hero-mri.webm" type="video/webm" />
      </video>
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/40"
      >
      </div>
    </div>

    <!-- Gradient blobs (Unchanged) -->
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-full blur-3xl opacity-30 z-10"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-96 h-96 bg-gradient-to-br from-[#cc9933]/20 to-orange-500/20 rounded-full blur-3xl opacity-20 z-10"
    >
    </div>

    <div class="max-w-7xl mx-auto relative z-20">
      <div class="max-w-5xl mx-auto text-center">
        <!-- Main Headline (Unchanged) -->
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-8 text-white leading-tight tracking-tight"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <span class="block">Same Radiologists.</span>
          <span class="block">Same Scanners.</span>
          <span class="text-[#cc9933] relative inline-block">
            70% Less
            <svg
              class="absolute -bottom-2 sm:-bottom-3 left-0 w-full"
              height="20"
              viewBox="0 0 200 20"
              preserveAspectRatio="none"
            >
              <path
                d="M2 14 Q50 4 100 14 T198 14"
                stroke="#cc9933"
                stroke-width="5"
                fill="none"
                class="animate-draw-line drop-shadow-md"
                stroke-linecap="round"
                opacity="0.8"></path>
            </svg>
          </span>
          <span class="text-white">.</span>
        </h1>

        <!-- Subheadline (Unchanged) -->
        <p
          class="text-xl sm:text-2xl md:text-3xl text-white/90 max-w-3xl mx-auto leading-relaxed drop-shadow-lg mb-16"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <span class="block">Book in minutes. Get scanned this week.</span>
          <span class="block">Pay hundreds, not thousands.</span>
        </p>

        <!-- ✨ NEW: MINIMAL SEARCH FORM (MDSave Style) -->
        <div
          class="relative z-50 bg-white rounded-2xl shadow-2xl p-6 sm:p-8 max-w-3xl mx-auto mb-16 sm:mb-20"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <form
            class="space-y-5"
            action={`${REMIX_URL}/pbs/search`}
            method="GET"
            id="hero-search-form"
          >
            <!-- Procedure Search -->
            <div class="relative">
              <label
                for="hero-procedure-search"
                class="block text-sm font-semibold text-gray-700 mb-2"
              >
                What scan do you need?
              </label>
              <div class="relative">
                <div
                  class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
                >
                  <svg
                    class="w-5 h-5 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <input
                  type="text"
                  id="hero-procedure-search"
                  placeholder="Type: MRI, CT, Ultrasound, X-Ray..."
                  class="w-full pl-12 pr-4 py-4 text-base text-gray-900 placeholder-gray-400 bg-white border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#003087] focus:border-transparent transition-all"
                  autocomplete="off"
                />

                <!-- Dropdown -->
                <div
                  id="hero-procedure-dropdown"
                  class="absolute z-[100] w-full bg-white border-2 border-gray-200 rounded-xl shadow-2xl mt-2 hidden overflow-hidden"
                >
                  <div class="py-2" id="hero-dropdown-content"></div>
                </div>
              </div>
            </div>

            <!-- Location Search -->
            <div class="relative">
              <label
                for="hero-location"
                class="block text-sm font-semibold text-gray-700 mb-2"
              >
                Your location
              </label>
              <div class="relative">
                <div
                  class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
                >
                  <svg
                    class="w-5 h-5 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
                <input
                  type="text"
                  id="hero-location"
                  placeholder="ZIP code or city"
                  class="w-full pl-12 pr-12 py-4 text-base text-gray-900 placeholder-gray-400 bg-white border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#003087] focus:border-transparent transition-all"
                />
                <button
                  type="button"
                  id="hero-detect-location"
                  class="absolute inset-y-0 right-0 pr-4 flex items-center text-[#003087] hover:text-[#002266] transition-colors"
                  title="Use my current location"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                    ></path>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Search Button -->
            <button
              type="submit"
              id="hero-search-button"
              class="w-full bg-[#cc9933] text-white px-8 py-4 rounded-xl font-bold text-lg shadow-lg hover:bg-[#b8862d] transition-all duration-300 transform hover:scale-[1.02] disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100"
              disabled
            >
              <span class="flex items-center justify-center gap-2">
                Search
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </span>
            </button>

            <!-- Hidden fields -->
            <input
              type="hidden"
              name="procedure"
              id="hero-selected-procedure"
              value=""
            />
            <input type="hidden" name="zip" id="hero-zip" value="" />
            <input type="hidden" name="state" value="" />
            <input type="hidden" name="radius" value="10" />
          </form>
        </div>

        <!-- Popular Searches - Moved Outside & Below Form -->
        <div class="text-center mb-8" data-aos="fade-up" data-aos-delay="400">
          <p class="text-sm font-semibold text-white/80 mb-3">
            Popular searches:
          </p>
          <div class="flex flex-wrap justify-center gap-2">
            <button
              class="hero-quick-search px-4 py-2 bg-white/20 hover:bg-white/30 text-white font-medium text-sm rounded-full border border-white/30 hover:border-white/50 backdrop-blur-sm transition-all duration-200"
              data-procedure="70551"
            >
              MRI Brain
            </button>
            <button
              class="hero-quick-search px-4 py-2 bg-white/20 hover:bg-white/30 text-white font-medium text-sm rounded-full border border-white/30 hover:border-white/50 backdrop-blur-sm transition-all duration-200"
              data-procedure="72148"
            >
              MRI Spine
            </button>
            <button
              class="hero-quick-search px-4 py-2 bg-white/20 hover:bg-white/30 text-white font-medium text-sm rounded-full border border-white/30 hover:border-white/50 backdrop-blur-sm transition-all duration-200"
              data-procedure="74177"
            >
              CT Scan
            </button>
            <button
              class="hero-quick-search px-4 py-2 bg-white/20 hover:bg-white/30 text-white font-medium text-sm rounded-full border border-white/30 hover:border-white/50 backdrop-blur-sm transition-all duration-200"
              data-procedure="76700"
            >
              Ultrasound
            </button>
          </div>
        </div>

        <!-- Trust Indicators (Unchanged) -->
        <div
          class="flex flex-wrap justify-center gap-4 sm:gap-6 md:gap-8 text-sm sm:text-base text-white font-semibold drop-shadow-lg"
          data-aos="fade-up"
          data-aos-delay="500"
        >
          <div class="flex items-center gap-2">
            <svg
              class="flex-shrink-0 w-5 h-5 text-green-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>No insurance required</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="flex-shrink-0 w-5 h-5 text-green-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Upfront pricing</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="flex-shrink-0 w-5 h-5 text-green-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>1,500+ locations</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Animations (Unchanged) */
    @keyframes draw-line {
      from {
        stroke-dashoffset: 200;
        opacity: 0;
      }
      to {
        stroke-dashoffset: 0;
        opacity: 0.8;
      }
    }
    .animate-draw-line {
      stroke-dasharray: 200;
      stroke-dashoffset: 200;
      animation: draw-line 1.5s ease-out 0.8s forwards;
    }
  </style>

  <!-- ALL JAVASCRIPT UNCHANGED - Exact copy from original -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      let searchTimeout;

      async function searchProcedures(query) {
        if (!query || query.length < 2) return [];
        try {
          const REMIX_URL =
            document.querySelector('meta[name="remix-url"]')?.content ||
            "http://localhost:5173";
          const response = await fetch(
            `${REMIX_URL}/api/procedures/search?q=${encodeURIComponent(query)}`
          );
          const data = await response.json();
          return data.procedures || [];
        } catch (error) {
          console.error("Search failed:", error);
          return [];
        }
      }

      function displayProcedureResults(results, dropdownId) {
        const dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;

        if (results.length === 0) {
          dropdown.innerHTML = `
            <div class="p-6 text-center">
              <div class="mb-4">
                <svg class="w-16 h-16 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">No matches found</h3>
              <p class="text-sm text-gray-600 mb-4">We couldn't find that procedure in our search.</p>
              <div class="space-y-3">
                <a href="tel:18008772324" class="inline-flex items-center justify-center gap-2 bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                  Call 1-800-877-2324
                </a>
                <p class="text-xs text-gray-500">Our team can help you find the right scan</p>
              </div>
            </div>
          `;
          dropdown.classList.remove("hidden");
          return;
        }

        dropdown.innerHTML = `
          <div class="p-3 bg-gray-50 border-b border-gray-200">
            <p class="text-sm text-gray-600">${results.length} ${results.length === 1 ? "match" : "matches"} found</p>
          </div>
          <div class="max-h-80 overflow-y-auto">
            ${results
              .map(
                (proc) => `
              <div class="border-b border-gray-100 last:border-b-0" data-procedure-id="${proc.id}">
                <button type="button" class="w-full px-4 py-4 hover:bg-blue-50 transition text-left procedure-card-header">
                  <div class="flex items-start gap-3">
                    <div class="text-3xl">${proc.icon || "📋"}</div>
                    <div class="flex-1">
                      <div class="flex items-center justify-between">
                        <h3 class="text-lg font-semibold text-gray-900">${proc.displayName}</h3>
                        <svg class="w-5 h-5 text-gray-400 expand-icon transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                      </div>
                      <p class="text-sm text-gray-600 mt-1">${proc.description || ""}</p>
                      <div class="flex items-center gap-3 mt-2">
                        ${proc.badge ? `<span class="text-xs font-medium text-blue-600">${proc.badge}</span>` : ""}
                        <span class="text-xs text-gray-500">${proc.options?.length || 0} options</span>
                      </div>
                    </div>
                  </div>
                </button>
                <div class="procedure-options hidden px-4 pb-4 bg-gray-50 space-y-2">
                  ${(proc.options || [])
                    .map(
                      (opt) => `
                    <button type="button" class="w-full text-left px-4 py-3 bg-white rounded-lg border-2 border-gray-200 hover:border-blue-500 hover:shadow-md transition procedure-option" 
                            data-cpt="${opt.cpt}" 
                            data-label="${proc.displayName} - ${opt.label}">
                      <div class="flex justify-between items-start">
                        <div class="flex-1">
                          <div class="font-semibold text-gray-900">${opt.label}</div>
                          <div class="text-sm text-gray-600 mt-1">${opt.detail || ""}</div>
                        </div>
                        <div class="text-right ml-4">
                          <div class="text-sm font-semibold text-blue-600">See pricing →</div>
                          <div class="text-xs text-gray-500 mt-1">${opt.cpt}</div>
                        </div>
                      </div>
                    </button>
                  `
                    )
                    .join("")}
                </div>
              </div>
            `
              )
              .join("")}
          </div>
          <div class="p-3 bg-blue-50 border-t border-blue-100">
            <p class="text-xs text-blue-800">💡 Click any card to see pricing and options</p>
          </div>
        `;

        dropdown.classList.remove("hidden");

        dropdown.querySelectorAll(".procedure-card-header").forEach((btn) => {
          btn.addEventListener("click", function () {
            const parent = this.closest("[data-procedure-id]");
            const options = parent.querySelector(".procedure-options");
            const icon = this.querySelector(".expand-icon");
            dropdown.querySelectorAll(".procedure-options").forEach((o) => {
              if (o !== options) o.classList.add("hidden");
            });
            dropdown.querySelectorAll(".expand-icon").forEach((i) => {
              if (i !== icon) i.classList.remove("rotate-90");
            });
            options.classList.toggle("hidden");
            icon.classList.toggle("rotate-90");
          });
        });

        dropdown.querySelectorAll(".procedure-option").forEach((btn) => {
          btn.addEventListener("click", function (e) {
            e.stopPropagation();
            const cpt = this.dataset.cpt;
            const label = this.dataset.label;
            const formType = dropdownId.replace("-procedure-dropdown", "");
            selectProcedure(formType, cpt, label);
          });
        });
      }

      function selectProcedure(formType, cpt, label) {
        const procedureInput = document.getElementById(
          `${formType}-procedure-search`
        );
        const selectedProcedure = document.getElementById(
          `${formType}-selected-procedure`
        );
        const dropdown = document.getElementById(
          `${formType}-procedure-dropdown`
        );
        if (procedureInput) procedureInput.value = label;
        if (selectedProcedure) selectedProcedure.value = cpt;
        if (dropdown) dropdown.classList.add("hidden");
        updateSearchButton(formType);
      }

      function updateSearchButton(formType) {
        const locationInput = document.getElementById(`${formType}-location`);
        const selectedProcedure = document.getElementById(
          `${formType}-selected-procedure`
        );
        const searchButton = document.getElementById(
          `${formType}-search-button`
        );
        if (!locationInput || !selectedProcedure || !searchButton) return;
        const hasLocation = locationInput.value.trim().length > 0;
        const hasProcedure = selectedProcedure.value.length > 0;
        searchButton.disabled = !(hasLocation && hasProcedure);
      }

      initializeSearchForm("hero");
      initializeSearchForm("cta");

      function initializeSearchForm(formType) {
        const procedureInput = document.getElementById(
          `${formType}-procedure-search`
        );
        const dropdown = document.getElementById(
          `${formType}-procedure-dropdown`
        );
        const searchButton = document.getElementById(
          `${formType}-search-button`
        );
        const selectedProcedure = document.getElementById(
          `${formType}-selected-procedure`
        );
        const locationInput = document.getElementById(`${formType}-location`);
        const detectLocationBtn = document.getElementById(
          `${formType}-detect-location`
        );

        if (
          !procedureInput ||
          !dropdown ||
          !searchButton ||
          !selectedProcedure ||
          !locationInput
        )
          return;

        procedureInput.addEventListener("input", function () {
          const query = this.value.trim();
          clearTimeout(searchTimeout);
          if (query.length > 1) {
            dropdown.innerHTML =
              '<div class="px-4 py-3 text-sm text-gray-500">Searching...</div>';
            dropdown.classList.remove("hidden");
            searchTimeout = setTimeout(async () => {
              const results = await searchProcedures(query);
              displayProcedureResults(
                results,
                `${formType}-procedure-dropdown`
              );
            }, 300);
          } else {
            dropdown.classList.add("hidden");
          }
          if (selectedProcedure.value) {
            selectedProcedure.value = "";
            updateSearchButton(formType);
          }
        });

        if (formType === "hero") {
          document.querySelectorAll(".hero-quick-search").forEach((button) => {
            button.addEventListener("click", function () {
              const cpt = this.dataset.procedure;
              const label = this.textContent.trim();
              selectProcedure(formType, cpt, label);
            });
          });
        }

        if (detectLocationBtn) {
          detectLocationBtn.addEventListener("click", function () {
            if (!navigator.geolocation) return;
            this.innerHTML =
              '<svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
            navigator.geolocation.getCurrentPosition(
              async (position) => {
                try {
                  const response = await fetch(
                    `https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${position.coords.latitude}&longitude=${position.coords.longitude}&localityLanguage=en`
                  );
                  const data = await response.json();
                  locationInput.value =
                    data.postcode ||
                    `${data.city}, ${data.principalSubdivision}`;
                  updateSearchButton(formType);
                } catch (error) {
                  console.error("Location detection failed:", error);
                  locationInput.placeholder = "Enter ZIP manually";
                }
                this.innerHTML =
                  '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"></path></svg>';
              },
              (error) => {
                console.error("Geolocation error:", error);
                locationInput.placeholder =
                  "Location access denied - enter ZIP";
                this.innerHTML =
                  '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"></path></svg>';
              }
            );
          });
        }

        locationInput.addEventListener("input", () =>
          updateSearchButton(formType)
        );

        document.addEventListener("click", function (e) {
          if (
            !procedureInput.contains(e.target) &&
            !dropdown.contains(e.target)
          ) {
            dropdown.classList.add("hidden");
          }
        });

        const form = document.getElementById(`${formType}-search-form`);
        if (form) {
          form.addEventListener("submit", function (e) {
            const locationInput = document.getElementById(
              `${formType}-location`
            );
            const zipField = document.getElementById(`${formType}-zip`);
            if (locationInput && zipField) {
              const locationValue = locationInput.value.trim();
              const zipMatch = locationValue.match(/\b\d{5}\b/);
              if (zipMatch) {
                zipField.value = zipMatch[0];
              } else {
                zipField.value = locationValue;
              }
            }
          });
        }
      }
    });
  </script>

