---
// index-carbon-experiment-v3.astro
// Enhanced Premium Clean - NO availability badge, NO popular searches
import CarbonLayout from "../layouts/CarbonLayout.astro";
import NetworkMapPinsCarbon from "../components/NetworkMapPinsCarbon.astro";
import AOSInit from "../components/AOSInit.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import SecondaryButton from "../components/SecondaryButton.astro";

const REMIX_URL = import.meta.env.PUBLIC_REMIX_URL || "http://localhost:5173";
---

<CarbonLayout title="USRad - MRI Scans in 48 Hours, 70% Less" isHeroPage={true}>
  <meta name="remix-url" content={REMIX_URL} />
  <AOSInit />

  <!-- ENHANCED PREMIUM HERO SECTION -->
  <section
    class="relative py-24 px-4 sm:px-6 bg-[#003087] text-white overflow-hidden"
    data-aos="fade-up"
  >
    <!-- Video Background -->
    <div class="absolute inset-0 z-0">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        class="absolute inset-0 w-full h-full object-cover"
        poster="/images/home-hero-mri.webp?v=2.1"
      >
        <source
          src="/videos/home-hero-mri-mobile.mp4"
          type="video/mp4"
          media="(max-width: 768px)"
        />
        <source src="/videos/home-hero-mri.mp4" type="video/mp4" />
        <source src="/videos/home-hero-mri.webm" type="video/webm" />
      </video>
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/40"
      >
      </div>
    </div>

    <!-- Gradient blobs -->
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-full blur-3xl opacity-30 z-10"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-96 h-96 bg-gradient-to-br from-[#cc9933]/20 to-orange-500/20 rounded-full blur-3xl opacity-20 z-10"
    >
    </div>

    <div class="max-w-7xl mx-auto relative z-20">
      <div class="max-w-5xl mx-auto text-center">
        <!-- Main Headline -->
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-8 text-white leading-tight tracking-tight"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <span class="block">Same Radiologists.</span>
          <span class="block">Same Scanners.</span>
          <span class="text-[#cc9933] relative inline-block">
            70% Less
            <svg
              class="absolute -bottom-2 sm:-bottom-3 left-0 w-full"
              height="20"
              viewBox="0 0 200 20"
              preserveAspectRatio="none"
            >
              <path
                d="M2 14 Q50 4 100 14 T198 14"
                stroke="#cc9933"
                stroke-width="5"
                fill="none"
                class="animate-draw-line drop-shadow-md"
                stroke-linecap="round"
                opacity="0.8"></path>
            </svg>
          </span>
          <span class="text-white">.</span>
        </h1>

        <!-- Subheadline -->
        <p
          class="text-xl sm:text-2xl md:text-3xl text-white/90 max-w-3xl mx-auto leading-relaxed drop-shadow-lg"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <span class="block">Book in minutes. Get scanned this week.</span>
          <span class="block">Pay hundreds, not thousands.</span>
        </p>

        <!-- ENHANCED PREMIUM SEARCH FORM - NO BADGE, NO POPULAR SEARCHES -->
        <div
          class="relative z-50 max-w-3xl mx-auto mb-16 sm:mb-24 mt-12"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div
            class="bg-white/30 backdrop-blur-2xl border border-white/40 rounded-3xl shadow-[0_8px_32px_rgba(255,255,255,0.25)] p-6 sm:p-8 transition-all duration-300 hover:shadow-[0_12px_48px_rgba(255,255,255,0.35)]"
          >
            <div
              class="absolute inset-0 bg-gradient-to-br from-white/20 to-white/5 rounded-3xl pointer-events-none"
            >
            </div>

            <div class="relative z-10">
              <form
                class="space-y-4"
                action={`${REMIX_URL}/pbs/search`}
                method="GET"
                id="hero-search-form"
              >
                <!-- Procedure Search -->
                <div class="relative">
                  <label
                    for="hero-procedure-search"
                    class="block text-sm font-bold text-white mb-2 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]"
                  >
                    What scan do you need?
                  </label>
                  <div class="relative group">
                    <div
                      class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none z-10"
                    >
                      <svg
                        id="search-icon"
                        class="w-5 h-5 text-gray-400 group-focus-within:text-[#003087] transition-colors"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        ></path>
                      </svg>
                      <svg
                        id="search-loading"
                        class="w-5 h-5 text-[#003087] animate-spin hidden"
                        fill="none"
                        viewBox="0 0 24 24"
                      >
                        <circle
                          class="opacity-25"
                          cx="12"
                          cy="12"
                          r="10"
                          stroke="currentColor"
                          stroke-width="4"></circle>
                        <path
                          class="opacity-75"
                          fill="currentColor"
                          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                        ></path>
                      </svg>
                    </div>
                    <input
                      type="text"
                      id="hero-procedure-search"
                      placeholder="Type: MRI, CT, Ultrasound, X-Ray..."
                      class="w-full pl-12 pr-4 py-4 sm:py-5 text-base sm:text-lg text-gray-900 placeholder-gray-500 bg-white/95 backdrop-blur-sm border-2 border-white/70 rounded-xl focus:ring-4 focus:ring-white/50 focus:border-white focus:shadow-[0_0_30px_rgba(255,255,255,0.5)] transition-all duration-300 shadow-lg group-hover:border-white/90 min-h-[56px]"
                      autocomplete="off"
                    />

                    <!-- Dropdown -->
                    <div
                      id="hero-procedure-dropdown"
                      class="absolute z-[100] w-full bg-white border-2 border-gray-200 rounded-xl shadow-[0_20px_60px_rgba(0,0,0,0.3)] mt-2 hidden overflow-hidden"
                    >
                      <div class="py-2" id="hero-dropdown-content"></div>
                    </div>
                  </div>
                </div>

                <!-- Location & Submit -->
                <div class="flex flex-col sm:flex-row gap-3">
                  <div class="flex-1">
                    <label
                      for="hero-location"
                      class="block text-sm font-bold text-white mb-2 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]"
                    >
                      Your location
                    </label>
                    <div class="relative group">
                      <div
                        class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"
                      >
                        <svg
                          class="w-5 h-5 text-gray-400 group-focus-within:text-[#003087] transition-colors"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                          ></path>
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                      </div>
                      <input
                        type="text"
                        id="hero-location"
                        placeholder="ZIP code or city"
                        inputmode="numeric"
                        pattern="[0-9]*"
                        class="w-full pl-12 pr-14 py-4 sm:py-5 text-base sm:text-lg text-gray-900 placeholder-gray-500 bg-white/95 backdrop-blur-sm border-2 border-white/70 rounded-xl focus:ring-4 focus:ring-white/50 focus:border-white focus:shadow-[0_0_30px_rgba(255,255,255,0.5)] transition-all duration-300 shadow-lg group-hover:border-white/90 min-h-[56px]"
                      />
                      <button
                        type="button"
                        id="hero-detect-location"
                        class="absolute inset-y-0 right-0 flex items-center pr-3 text-[#003087] hover:text-[#002266] transition-all hover:scale-110 min-h-[44px] min-w-[44px] justify-center"
                        title="Use my current location"
                      >
                        <svg
                          id="location-icon"
                          class="w-5 h-5"
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                          ></path>
                        </svg>
                        <svg
                          id="location-loading"
                          class="w-5 h-5 animate-spin hidden"
                          fill="none"
                          viewBox="0 0 24 24"
                        >
                          <circle
                            class="opacity-25"
                            cx="12"
                            cy="12"
                            r="10"
                            stroke="currentColor"
                            stroke-width="4"></circle>
                          <path
                            class="opacity-75"
                            fill="currentColor"
                            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                          ></path>
                        </svg>
                      </button>
                    </div>
                  </div>

                  <div class="flex items-end">
                    <button
                      type="submit"
                      id="hero-search-button"
                      class="w-full sm:w-auto bg-gradient-to-r from-[#cc9933] to-[#b8862d] text-white px-6 sm:px-8 py-4 sm:py-5 rounded-xl font-bold text-base sm:text-lg shadow-[0_8px_24px_rgba(204,153,51,0.4)] hover:shadow-[0_12px_32px_rgba(204,153,51,0.6)] transition-all duration-300 transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 hover:from-[#b8862d] hover:to-[#cc9933] min-h-[56px] relative overflow-hidden group"
                      disabled
                    >
                      <span
                        class="flex items-center justify-center gap-2 relative z-10"
                      >
                        Find Centers
                        <svg
                          class="w-5 h-5 transition-transform group-hover:translate-x-1"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                      </span>
                      <div
                        class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent transform -skew-x-12 translate-x-[-200%] group-hover:translate-x-[200%] transition-transform duration-1000"
                      >
                      </div>
                    </button>
                  </div>
                </div>

                <!-- Hidden fields -->
                <input
                  type="hidden"
                  name="procedure"
                  id="hero-selected-procedure"
                  value=""
                />
                <input type="hidden" name="zip" id="hero-zip" value="" />
                <input type="hidden" name="state" value="" />
                <input type="hidden" name="radius" value="10" />
              </form>
            </div>
          </div>
        </div>

        <!-- Trust Indicators -->
        <div
          class="flex flex-wrap justify-center gap-4 sm:gap-6 md:gap-8 text-sm sm:text-base text-white font-semibold mt-12 sm:mt-16 drop-shadow-lg"
          data-aos="fade-up"
          data-aos-delay="500"
        >
          <div class="flex items-center gap-2">
            <svg
              class="flex-shrink-0 w-5 h-5 text-green-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>No insurance required</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="flex-shrink-0 w-5 h-5 text-green-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Upfront pricing</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="flex-shrink-0 w-5 h-5 text-green-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>1,500+ locations</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    @keyframes draw-line {
      from {
        stroke-dashoffset: 200;
        opacity: 0;
      }
      to {
        stroke-dashoffset: 0;
        opacity: 0.8;
      }
    }
    .animate-draw-line {
      stroke-dasharray: 200;
      stroke-dashoffset: 200;
      animation: draw-line 1.5s ease-out 0.8s forwards;
    }

    #hero-procedure-search:focus,
    #hero-location:focus {
      outline: none;
    }

    @media (hover: none) and (pointer: coarse) {
      input,
      button,
      select {
        font-size: 16px !important;
      }
    }

    #hero-search-button:not(:disabled):active {
      transform: scale(0.98);
    }

    #hero-procedure-dropdown {
      animation: fadeInDown 0.3s ease-out;
    }

    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      let searchTimeout;

      const searchIcon = document.getElementById("search-icon");
      const searchLoading = document.getElementById("search-loading");
      const locationIcon = document.getElementById("location-icon");
      const locationLoading = document.getElementById("location-loading");

      async function searchProcedures(query) {
        if (!query || query.length < 2) return [];

        if (searchIcon) searchIcon.classList.add("hidden");
        if (searchLoading) searchLoading.classList.remove("hidden");

        try {
          const REMIX_URL =
            document.querySelector('meta[name="remix-url"]')?.content ||
            "http://localhost:5173";
          const response = await fetch(
            `${REMIX_URL}/api/procedures/search?q=${encodeURIComponent(query)}`
          );
          const data = await response.json();
          return data.procedures || [];
        } catch (error) {
          console.error("Search failed:", error);
          return [];
        } finally {
          if (searchLoading) searchLoading.classList.add("hidden");
          if (searchIcon) searchIcon.classList.remove("hidden");
        }
      }

      function displayProcedureResults(results, dropdownId) {
        const dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;

        if (results.length === 0) {
          dropdown.innerHTML = `
            <div class="p-6 text-center">
              <h3 class="text-lg font-semibold text-gray-900 mb-2">No matches found</h3>
              <p class="text-sm text-gray-600 mb-4">We couldn't find that procedure.</p>
            </div>
          `;
          dropdown.classList.remove("hidden");
          return;
        }

        dropdown.innerHTML = `
          <div class="p-3 bg-gray-50 border-b border-gray-200">
            <p class="text-sm text-gray-600">${results.length} ${results.length === 1 ? "match" : "matches"} found</p>
          </div>
          <div class="max-h-80 overflow-y-auto">
            ${results
              .map(
                (proc) => `
              <div class="border-b border-gray-100 last:border-b-0" data-procedure-id="${proc.id}">
                <button type="button" class="w-full px-4 py-4 hover:bg-blue-50 transition text-left procedure-card-header">
                  <div class="flex items-start gap-3">
                    <div class="text-3xl">${proc.icon || "📋"}</div>
                    <div class="flex-1">
                      <div class="flex items-center justify-between">
                        <h3 class="text-lg font-semibold text-gray-900">${proc.displayName}</h3>
                        <svg class="w-5 h-5 text-gray-400 expand-icon transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                      </div>
                      <p class="text-sm text-gray-600 mt-1">${proc.description || ""}</p>
                      <div class="flex items-center gap-3 mt-2">
                        ${proc.badge ? `<span class="text-xs font-medium text-blue-600">${proc.badge}</span>` : ""}
                        <span class="text-xs text-gray-500">${proc.options?.length || 0} options</span>
                      </div>
                    </div>
                  </div>
                </button>
                <div class="procedure-options hidden px-4 pb-4 bg-gray-50 space-y-2">
                  ${(proc.options || [])
                    .map(
                      (opt) => `
                    <button type="button" class="w-full text-left px-4 py-3 bg-white rounded-lg border-2 border-gray-200 hover:border-blue-500 hover:shadow-md transition procedure-option" 
                            data-cpt="${opt.cpt}" 
                            data-label="${proc.displayName} - ${opt.label}">
                      <div class="flex justify-between items-start">
                        <div class="flex-1">
                          <div class="font-semibold text-gray-900">${opt.label}</div>
                          <div class="text-sm text-gray-600 mt-1">${opt.detail || ""}</div>
                        </div>
                        <div class="text-right ml-4">
                          <div class="text-sm font-semibold text-blue-600">See pricing →</div>
                          <div class="text-xs text-gray-500 mt-1">${opt.cpt}</div>
                        </div>
                      </div>
                    </button>
                  `
                    )
                    .join("")}
                </div>
              </div>
            `
              )
              .join("")}
          </div>
        `;

        dropdown.classList.remove("hidden");

        dropdown.querySelectorAll(".procedure-card-header").forEach((btn) => {
          btn.addEventListener("click", function () {
            const parent = this.closest("[data-procedure-id]");
            const options = parent.querySelector(".procedure-options");
            const icon = this.querySelector(".expand-icon");
            dropdown.querySelectorAll(".procedure-options").forEach((o) => {
              if (o !== options) o.classList.add("hidden");
            });
            dropdown.querySelectorAll(".expand-icon").forEach((i) => {
              if (i !== icon) i.classList.remove("rotate-90");
            });
            options.classList.toggle("hidden");
            icon.classList.toggle("rotate-90");
          });
        });

        dropdown.querySelectorAll(".procedure-option").forEach((btn) => {
          btn.addEventListener("click", function (e) {
            e.stopPropagation();
            const cpt = this.dataset.cpt;
            const label = this.dataset.label;
            const formType = dropdownId.replace("-procedure-dropdown", "");
            selectProcedure(formType, cpt, label);
          });
        });
      }

      function selectProcedure(formType, cpt, label) {
        const procedureInput = document.getElementById(
          `${formType}-procedure-search`
        );
        const selectedProcedure = document.getElementById(
          `${formType}-selected-procedure`
        );
        const dropdown = document.getElementById(
          `${formType}-procedure-dropdown`
        );

        if (procedureInput) procedureInput.value = label;
        if (selectedProcedure) selectedProcedure.value = cpt;
        if (dropdown) dropdown.classList.add("hidden");

        updateSearchButton(formType);
      }

      function updateSearchButton(formType) {
        const locationInput = document.getElementById(`${formType}-location`);
        const selectedProcedure = document.getElementById(
          `${formType}-selected-procedure`
        );
        const searchButton = document.getElementById(
          `${formType}-search-button`
        );

        if (!locationInput || !selectedProcedure || !searchButton) return;

        const hasLocation = locationInput.value.trim().length > 0;
        const hasProcedure = selectedProcedure.value.length > 0;
        searchButton.disabled = !(hasLocation && hasProcedure);
      }

      initializeSearchForm("hero");

      function initializeSearchForm(formType) {
        const procedureInput = document.getElementById(
          `${formType}-procedure-search`
        );
        const dropdown = document.getElementById(
          `${formType}-procedure-dropdown`
        );
        const searchButton = document.getElementById(
          `${formType}-search-button`
        );
        const selectedProcedure = document.getElementById(
          `${formType}-selected-procedure`
        );
        const locationInput = document.getElementById(`${formType}-location`);
        const detectLocationBtn = document.getElementById(
          `${formType}-detect-location`
        );

        if (
          !procedureInput ||
          !dropdown ||
          !searchButton ||
          !selectedProcedure ||
          !locationInput
        )
          return;

        procedureInput.addEventListener("input", function () {
          const query = this.value.trim();
          clearTimeout(searchTimeout);
          if (query.length > 1) {
            dropdown.innerHTML =
              '<div class="px-4 py-3 text-sm text-gray-500">Searching...</div>';
            dropdown.classList.remove("hidden");
            searchTimeout = setTimeout(async () => {
              const results = await searchProcedures(query);
              displayProcedureResults(
                results,
                `${formType}-procedure-dropdown`
              );
            }, 300);
          } else {
            dropdown.classList.add("hidden");
          }
          if (selectedProcedure.value) {
            selectedProcedure.value = "";
            updateSearchButton(formType);
          }
        });

        if (detectLocationBtn) {
          detectLocationBtn.addEventListener("click", function () {
            if (!navigator.geolocation) return;

            if (locationIcon) locationIcon.classList.add("hidden");
            if (locationLoading) locationLoading.classList.remove("hidden");

            navigator.geolocation.getCurrentPosition(
              async (position) => {
                try {
                  const response = await fetch(
                    `https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${position.coords.latitude}&longitude=${position.coords.longitude}&localityLanguage=en`
                  );
                  const data = await response.json();
                  locationInput.value =
                    data.postcode ||
                    `${data.city}, ${data.principalSubdivision}`;
                  updateSearchButton(formType);
                } catch (error) {
                  console.error("Location detection failed:", error);
                  locationInput.placeholder = "Enter ZIP manually";
                }
                if (locationLoading) locationLoading.classList.add("hidden");
                if (locationIcon) locationIcon.classList.remove("hidden");
              },
              (error) => {
                console.error("Geolocation error:", error);
                locationInput.placeholder =
                  "Location access denied - enter ZIP";
                if (locationLoading) locationLoading.classList.add("hidden");
                if (locationIcon) locationIcon.classList.remove("hidden");
              }
            );
          });
        }

        locationInput.addEventListener("input", () =>
          updateSearchButton(formType)
        );

        document.addEventListener("click", function (e) {
          if (
            !procedureInput.contains(e.target) &&
            !dropdown.contains(e.target)
          ) {
            dropdown.classList.add("hidden");
          }
        });

        const form = document.getElementById(`${formType}-search-form`);
        if (form) {
          form.addEventListener("submit", function (e) {
            const locationInput = document.getElementById(
              `${formType}-location`
            );
            const zipField = document.getElementById(`${formType}-zip`);
            if (locationInput && zipField) {
              const locationValue = locationInput.value.trim();
              const zipMatch = locationValue.match(/\b\d{5}\b/);
              if (zipMatch) {
                zipField.value = zipMatch[0];
              } else {
                zipField.value = locationValue;
              }
            }
          });
        }
      }
    });
  </script>

