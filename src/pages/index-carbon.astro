---
// index-carbon.astro
import CarbonLayout from "../layouts/CarbonLayout.astro";
import NetworkMapPinsCarbon from "../components/NetworkMapPinsCarbon.astro";
import AOSInit from "../components/AOSInit.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import SecondaryButton from "../components/SecondaryButton.astro";

export const prerender = true;
---

<CarbonLayout title="USRad - MRI Scans in 48 Hours, 70% Less" isHeroPage={true}>
  <AOSInit />

  <!-- Hero Section with Video Background -->
  <section
    class="relative pt-32 sm:pt-36 md:pt-40 pb-20 px-4 sm:px-6 overflow-hidden"
    data-aos="fade-up"
  >
    <!-- Video Background -->
    <div class="absolute inset-0 z-0">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        class="absolute inset-0 w-full h-full object-cover"
        poster="/images/home-hero-mri.webp?v=2.1"
      >
        <source
          src="/videos/home-hero-mri-mobile.mp4"
          type="video/mp4"
          media="(max-width: 768px)"
        />
        <source src="/videos/home-hero-mri.mp4" type="video/mp4" />
        <source src="/videos/home-hero-mri.webm" type="video/webm" />
      </video>

      <!-- Enhanced Video Overlay for transparent header compatibility -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/40"
      >
      </div>
    </div>

    <!-- Gradient blobs (subtle over video) -->
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-full blur-3xl opacity-30 z-10"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-96 h-96 bg-gradient-to-br from-[#cc9933]/20 to-orange-500/20 rounded-full blur-3xl opacity-20 z-10"
    >
    </div>

    <div class="max-w-7xl mx-auto relative z-20">
      <div class="max-w-5xl mx-auto text-center">
        <!-- Main Headline - Properly Formatted -->
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-8 text-white leading-tight tracking-tight"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <span class="block">Same Radiologists.</span>
          <span class="block">Same Scanners.</span>
          <span class="text-[#cc9933] relative inline-block">
            70% Less
            <svg
              class="absolute -bottom-2 sm:-bottom-3 left-0 w-full"
              height="20"
              viewBox="0 0 200 20"
              preserveAspectRatio="none"
            >
              <path
                d="M2 14 Q50 4 100 14 T198 14"
                stroke="#cc9933"
                stroke-width="5"
                fill="none"
                class="animate-draw-line drop-shadow-md"
                stroke-linecap="round"
                opacity="0.8"></path>
            </svg>
          </span>
          <span class="text-white">.</span>
        </h1>

        <!-- Subheadline - Perfect Visual Balance -->
        <p
          class="text-xl sm:text-2xl md:text-3xl text-white/90 max-w-3xl mx-auto leading-relaxed drop-shadow-lg"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <span class="block">Book in minutes. Get scanned this week.</span>
          <span class="block">Pay hundreds, not thousands.</span>
        </p>

        <style>
          @keyframes draw-line {
            from {
              stroke-dashoffset: 200;
              opacity: 0;
            }
            to {
              stroke-dashoffset: 0;
              opacity: 0.8;
            }
          }
          .animate-draw-line {
            stroke-dasharray: 200;
            stroke-dashoffset: 200;
            animation: draw-line 1.5s ease-out 0.8s forwards;
          }
        </style>

        <!-- Availability badge - Moved down for better spacing -->
        <div
          class="flex justify-center mt-10 mb-10"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div
            class="inline-flex items-center gap-2 bg-white/90 backdrop-blur-md border border-green-200 rounded-full px-6 py-3 animate-float shadow-xl"
          >
            <span class="flex h-3 w-3">
              <span
                class="animate-ping absolute inline-flex h-3 w-3 rounded-full bg-green-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-3 w-3 bg-green-500"
              ></span>
            </span>
            <span class="text-base text-green-800 font-medium"
              >Appointments available tomorrow</span
            >
          </div>
        </div>

        <style>
          @keyframes float {
            0%,
            100% {
              transform: translateY(0px);
            }
            50% {
              transform: translateY(-10px);
            }
          }
          .animate-float {
            animation: float 3s ease-in-out infinite;
          }
        </style>

        <!-- Search Form -->
        <div
          class="bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl p-3 max-w-2xl mx-auto mb-8"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <form
            class="flex flex-col sm:flex-row gap-3"
            action="https://usrad-portal.vercel.app/pbs/search"
            method="GET"
          >
            <input
              type="text"
              name="zip"
              placeholder="Enter your ZIP code"
              pattern="[0-9]{5}"
              maxlength="5"
              required
              class="flex-1 px-6 py-4 rounded-xl text-lg text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#003087] focus:border-transparent bg-white"
            />
            <input type="hidden" name="procedure" value="70551" />
            <input type="hidden" name="autoSearch" value="true" />
            <input type="hidden" name="radius" value="25" />
            <button
              type="submit"
              class="bg-[#003087] text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-[#002266] transition whitespace-nowrap shadow-lg hover:scale-105 transform"
            >
              Check prices →
            </button>
          </form>
        </div>

        <!-- Trust Indicators -->
        <div
          class="flex flex-wrap justify-center gap-8 text-base text-white drop-shadow-md"
          data-aos="fade-up"
          data-aos-delay="500"
        >
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-400 drop-shadow"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>No insurance required</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-400 drop-shadow"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Upfront pricing</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-400 drop-shadow"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>1,500+ locations</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rest of your existing sections... -->
  <!-- I'm keeping the rest exactly as you had it -->

  <!-- Social Proof Bar - BIGGER NUMBERS -->
  <section
    class="bg-gray-50 py-10 px-4 sm:px-6 border-y border-gray-100"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
        <div data-aos="fade-up" data-aos-delay="100">
          <div class="text-3xl md:text-4xl font-bold text-[#003087]">
            168,244
          </div>
          <div class="text-base text-gray-600">Patients served</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="200">
          <div class="text-3xl md:text-4xl font-bold text-[#003087]">
            $246 Million
          </div>
          <div class="text-base text-gray-600">Amount clients saved</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="300">
          <div class="text-3xl md:text-4xl font-bold text-[#003087]">48hr</div>
          <div class="text-base text-gray-600">Average wait time</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="400">
          <div class="text-3xl md:text-4xl font-bold text-[#003087]">4.9★</div>
          <div class="text-base text-gray-600">Patient rating</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-white via-blue-50/20 to-white"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20">
        <h2
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
        >
          Getting your MRI is this easy
        </h2>
        <p
          class="text-2xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          From booking to results in 3 simple steps
        </p>
      </div>

      <!-- Add specific class for steps grid -->
      <div
        class="grid md:grid-cols-3 gap-12 max-w-6xl mx-auto how-it-works-steps"
      >
        <!-- Step 1 -->
        <div
          class="text-center flex flex-col"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <!-- Icon Container with Step Number -->
          <div class="relative h-56 flex items-center justify-center mb-8">
            <div class="absolute top-0 left-1/2 transform -translate-x-1/2">
              <span
                class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-gray-200 text-gray-600 text-sm font-semibold"
                >1</span
              >
            </div>
            <div
              class="w-40 h-40 bg-gray-50 rounded-2xl flex items-center justify-center"
            >
              <img
                src="/images/icons/expenses.svg"
                alt="Compare prices"
                class="w-24 h-24"
              />
            </div>
          </div>
          <h3 class="text-2xl font-semibold mb-4">Compare prices</h3>
          <p class="text-lg text-gray-600">
            See upfront costs from quality imaging centers near you. No hidden
            fees.
          </p>
        </div>

        <!-- Step 2 -->
        <div
          class="text-center flex flex-col"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <!-- Icon Container with Step Number -->
          <div class="relative h-56 flex items-center justify-center mb-8">
            <div class="absolute top-0 left-1/2 transform -translate-x-1/2">
              <span
                class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[#003087] text-white text-sm font-semibold"
                >2</span
              >
            </div>
            <div
              class="w-40 h-40 bg-[#fefbf5] rounded-2xl flex items-center justify-center"
            >
              <img
                src="/images/icons/appointment1.svg"
                alt="Book instantly"
                class="w-24 h-24"
              />
            </div>
          </div>
          <h3 class="text-2xl font-semibold mb-4">Book instantly</h3>
          <p class="text-lg text-gray-600">
            Choose your time and location. Most appointments within 2-3 days.
          </p>
        </div>

        <!-- Step 3 -->
        <div
          class="text-center flex flex-col"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <!-- Icon Container with Step Number -->
          <div class="relative h-56 flex items-center justify-center mb-8">
            <div class="absolute top-0 left-1/2 transform -translate-x-1/2">
              <span
                class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[#cc9933] text-white text-sm font-semibold"
                >3</span
              >
            </div>
            <div
              class="w-40 h-40 bg-gray-50 rounded-2xl flex items-center justify-center"
            >
              <img
                src="/images/icons/fast.svg"
                alt="Get results fast"
                class="w-24 h-24"
              />
            </div>
          </div>
          <h3 class="text-2xl font-semibold mb-4">Get results fast</h3>
          <p class="text-lg text-gray-600">
            Board-certified radiologists review your scan. Results in 24-48
            hours.
          </p>
        </div>
      </div>

      <!-- Style for connecting lines - ONLY for how-it-works section -->
      <style>
        @media (min-width: 768px) {
          .how-it-works-steps > div:not(:last-child)::after {
            content: "";
            position: absolute;
            top: 128px;
            right: -48px;
            width: 96px;
            height: 2px;
            background: linear-gradient(
              to right,
              #e5e7eb 0%,
              #e5e7eb 45%,
              transparent 45%,
              transparent 55%,
              #e5e7eb 55%,
              #e5e7eb 100%
            );
            background-size: 8px 2px;
          }
        }
      </style>
    </div>
  </section>

  <!-- Pricing Section -->
  <section
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-50 via-white to-gray-50"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20">
        <h2
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
        >
          Clear, upfront pricing
        </h2>
        <p
          class="text-2xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          No insurance? No problem. Save up to 70% vs hospital prices.
        </p>
      </div>

      <!-- Simple Price Display -->
      <div class="max-w-4xl mx-auto text-center">
        <!-- Main Price - MUCH BIGGER -->
        <div class="mb-16" data-aos="zoom-in" data-aos-delay="200">
          <p
            class="text-base font-medium text-[#cc9933] uppercase tracking-wide mb-4"
          >
            MRI Starting At
          </p>
          <p
            class="text-7xl md:text-8xl lg:text-9xl font-bold text-[#003087] mb-6"
          >
            $260
          </p>
          <p class="text-xl md:text-2xl text-gray-600">
            vs $3,200 average hospital price
          </p>
        </div>

        <!-- Benefits Grid - NO connecting lines class -->
        <div class="grid md:grid-cols-3 gap-12 mb-16 pricing-benefits">
          <!-- 48-hour booking -->
          <div data-aos="fade-up" data-aos-delay="300" class="group">
            <div
              class="w-20 h-20 mx-auto mb-6 flex items-center justify-center"
            >
              <img
                src="/images/icons/flash.svg"
                alt="Fast booking"
                class="w-16 h-16 filter-brand-blue group-hover:scale-110 transition-transform duration-300"
              />
            </div>
            <h3 class="font-semibold text-xl text-gray-900 mb-3">
              48-hour booking
            </h3>
            <p class="text-base text-gray-600">
              Get scanned this week, not next month
            </p>
          </div>

          <!-- Upfront pricing -->
          <div data-aos="fade-up" data-aos-delay="400" class="group">
            <div
              class="w-20 h-20 mx-auto mb-6 flex items-center justify-center"
            >
              <img
                src="/images/icons/protection2.svg"
                alt="Upfront pricing"
                class="w-16 h-16 filter-brand-blue group-hover:scale-110 transition-transform duration-300"
              />
            </div>
            <h3 class="font-semibold text-xl text-gray-900 mb-3">
              Upfront pricing
            </h3>
            <p class="text-base text-gray-600">No surprises, no hidden fees</p>
          </div>

          <!-- No insurance needed -->
          <div data-aos="fade-up" data-aos-delay="500" class="group">
            <div
              class="w-20 h-20 mx-auto mb-6 flex items-center justify-center"
            >
              <img
                src="/images/icons/no-insurance.svg"
                alt="No insurance needed"
                class="w-16 h-16 filter-brand-blue group-hover:scale-110 transition-transform duration-300"
              />
            </div>
            <h3 class="font-semibold text-xl text-gray-900 mb-3">
              No insurance needed
            </h3>
            <p class="text-base text-gray-600">
              Same quality care, direct pricing
            </p>
          </div>
        </div>

        <!-- CTA Button Section -->
        <div class="bg-gray-50 px-8 py-6 text-center rounded-2xl">
          <a
            href="/pricing"
            class="inline-block bg-[#003087] text-white px-8 py-3 rounded-lg font-medium hover:bg-[#002266] transition"
          >
            See prices in your area →
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* CSS filter to convert black SVGs to brand blue #003087 */
    .filter-brand-blue {
      filter: brightness(0) saturate(100%) invert(13%) sepia(94%)
        saturate(4107%) hue-rotate(216deg) brightness(94%) contrast(101%);
    }

    /* Optional: Add a subtle shadow on hover for more depth */
    .group:hover .filter-brand-blue {
      filter: brightness(0) saturate(100%) invert(13%) sepia(94%)
        saturate(4107%) hue-rotate(216deg) brightness(94%) contrast(101%)
        drop-shadow(0 4px 6px rgba(0, 48, 135, 0.1));
    }
  </style>

  <!-- Locations Map Section -->
  <section class="py-24 px-4 sm:px-6 bg-white" data-aos="fade-up">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
        >
          1,500+ locations nationwide
        </h2>
        <p
          class="text-2xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Quality imaging centers competing for your business
        </p>
      </div>
    </div>

    <NetworkMapPinsCarbon />
  </section>

  <!-- About/Trust Section - Fixed CTA Alignment -->
  <section
    class="py-20 px-4 sm:px-6 bg-gradient-to-br from-white via-gray-50/30 to-white"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Headline -->
        <h2
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-8 text-gray-900"
        >
          We've Done This Before —<br />
          <span class="text-[#cc9933]">And This Time, It's Even Smarter</span>
        </h2>

        <!-- Copy Block -->
        <p class="text-xl md:text-2xl text-gray-600 mb-8 leading-relaxed">
          After building one of the largest diagnostic imaging networks in the
          country—serving over 1,200 centers and leading to a
          <strong class="text-gray-900">public company acquisition</strong>—we
          saw an opportunity to go further.
        </p>

        <p
          class="text-xl md:text-2xl text-gray-900 mb-12 leading-relaxed font-semibold"
        >
          USRad is the next evolution: A transparent marketplace using
          <span class="text-[#cc9933]">Medicare-based pricing</span>. Simple,
          modern, and built for 90+ million Americans without adequate imaging
          coverage.
        </p>

        <!-- Visual Proof -->
        <div class="inline-flex items-center gap-8 text-center mb-10">
          <div>
            <p class="text-5xl font-bold text-[#003087]">1,200+</p>
            <p class="text-sm text-gray-600">Centers Built</p>
          </div>
          <div class="text-3xl text-gray-300">→</div>
          <div>
            <p class="text-5xl font-bold text-[#cc9933]">NASDAQ</p>
            <p class="text-sm text-gray-600">Acquired</p>
          </div>
          <div class="text-3xl text-gray-300">→</div>
          <div>
            <p class="text-5xl font-bold text-[#003087]">90 Million</p>
            <p class="text-sm text-gray-600">To Serve</p>
          </div>
        </div>

        <!-- CTA Button Centered -->
        <div
          class="flex justify-center"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <a
            href="/about-carbon"
            class="bg-[#003087] text-white px-10 py-4 rounded-xl font-semibold text-lg hover:bg-[#002266] transition-all duration-300 transform hover:scale-105"
          >
            See the full story →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section
    class="py-24 px-4 sm:px-6 bg-[#003087] text-white"
    data-aos="fade-up"
  >
    <div class="max-w-5xl mx-auto text-center">
      <h2
        class="text-4xl sm:text-5xl md:text-6xl font-bold mb-8"
        data-aos="fade-up"
      >
        Stop overpaying for medical imaging
      </h2>
      <p
        class="text-2xl mb-12 opacity-90"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Join thousands getting the same quality care for 70% less
      </p>
      <div
        class="bg-white/10 backdrop-blur-sm rounded-2xl p-3 max-w-2xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <form
          class="flex flex-col sm:flex-row gap-3"
          action="https://usrad-portal.vercel.app/pbs/search"
          method="GET"
        >
          <input
            type="text"
            name="zip"
            placeholder="Enter your ZIP code"
            pattern="[0-9]{5}"
            maxlength="5"
            required
            class="flex-1 px-6 py-4 rounded-xl text-lg text-gray-900 placeholder-gray-500 focus:outline-none"
          />
          <input type="hidden" name="procedure" value="70551" />
          <input type="hidden" name="autoSearch" value="true" />
          <input type="hidden" name="radius" value="25" />
          <button
            type="submit"
            class="bg-white text-[#003087] px-8 py-4 rounded-xl font-semibold text-lg hover:bg-gray-100 transition whitespace-nowrap"
          >
            Get started →
          </button>
        </form>
      </div>
    </div>
  </section>

  <style>
    /* Add any page-specific styles here */
    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.5;
      }
    }

    .animate-pulse {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
  </style>
</CarbonLayout>
