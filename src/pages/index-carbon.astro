  </style>

  <script>
    // Complete search functionality with contextual autocomplete
    document.addEventListener("DOMContentLoaded", function () {
      // Enhanced procedure database
      const procedures = [
        {
          code: "70551",
          name: "MRI Brain",
          detail: "without contrast",
          description: "Most common",
          price: "$260-400",
          keywords: ["mri", "brain", "head", "without"],
        },
        {
          code: "70552",
          name: "MRI Brain",
          detail: "with contrast",
          description: "Enhanced imaging",
          price: "$350-500",
          keywords: ["mri", "brain", "head", "with", "contrast"],
        },
        {
          code: "72148",
          name: "MRI Spine",
          detail: "Lumbar (Lower back)",
          description: "Back pain",
          price: "$280-450",
          keywords: ["mri", "spine", "back", "lumbar", "lower"],
        },
        {
          code: "72149",
          name: "MRI Spine",
          detail: "with contrast",
          description: "Enhanced spine",
          price: "$380-550",
          keywords: ["mri", "spine", "back", "contrast"],
        },
        {
          code: "74177",
          name: "CT Scan",
          detail: "Abdomen/Pelvis",
          description: "Body imaging",
          price: "$200-350",
          keywords: ["ct", "scan", "abdomen", "pelvis", "body"],
        },
        {
          code: "76700",
          name: "Ultrasound",
          detail: "Abdomen",
          description: "Sound waves",
          price: "$150-250",
          keywords: ["ultrasound", "abdomen", "sound"],
        },
        {
          code: "70450",
          name: "CT Head",
          detail: "without contrast",
          description: "Brain imaging",
          price: "$180-300",
          keywords: ["ct", "head", "brain", "without"],
        },
        {
          code: "73221",
          name: "MRI Knee",
          detail: "without contrast",
          description: "Joint imaging",
          price: "$250-400",
          keywords: ["mri", "knee", "joint", "leg"],
        },
      ];

      // Smart search function
      function searchProcedures(query) {
        if (!query || query.length < 2) return [];

        const searchTerms = query
          .toLowerCase()
          .split(" ")
          .filter((term) => term.length > 1);

        return procedures
          .map((proc) => {
            let score = 0;
            const allText =
              `${proc.name} ${proc.detail} ${proc.description} ${proc.keywords.join(" ")}`.toLowerCase();

            // Exact name match gets highest priority
            if (proc.name.toLowerCase().includes(query.toLowerCase()))
              score += 100;

            // Keyword matches
            searchTerms.forEach((term) => {
              if (proc.keywords.some((keyword) => keyword.includes(term)))
                score += 50;
              if (allText.includes(term)) score += 25;
            });

            return { ...proc, score };
          })
          .filter((proc) => proc.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 6);
      }

      // Display search results
      function displayProcedureResults(results, dropdownId) {
        const dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;

        if (results.length === 0) {
          dropdown.classList.add("hidden");
          return;
        }

        dropdown.innerHTML = `
      <div class="py-2">
        ${results
          .map(
            (proc) => `
          <div class="px-4 py-3 hover:bg-blue-50 cursor-pointer text-sm procedure-option border-b border-gray-100 last:border-b-0" data-procedure="${proc.code}">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="font-semibold text-gray-900">${proc.name}</div>
                <div class="text-gray-600 text-xs mt-1">${proc.detail}</div>
              </div>
              <div class="text-right ml-4">
                <div class="text-sm font-medium text-blue-600">${proc.price}</div>
                <div class="text-xs text-gray-500">${proc.description}</div>
              </div>
            </div>
          </div>
        `
          )
          .join("")}
      </div>
    `;

        dropdown.classList.remove("hidden");
      }

      // Initialize both forms
      initializeSearchForm("hero");
      initializeSearchForm("cta");

      function initializeSearchForm(formType) {
        const procedureInput = document.getElementById(
          `${formType}-procedure-search`
        );
        const dropdown = document.getElementById(
          `${formType}-procedure-dropdown`
        );
        const searchButton = document.getElementById(
          `${formType}-search-button`
        );
        const selectedProcedure = document.getElementById(
          `${formType}-selected-procedure`
        );
        const locationInput = document.getElementById(`${formType}-location`);
        const detectLocationBtn = document.getElementById(
          `${formType}-detect-location`
        );

        if (
          !procedureInput ||
          !dropdown ||
          !searchButton ||
          !selectedProcedure ||
          !locationInput
        ) {
          return;
        }

        // Enable search when both fields have values
        function updateSearchButton() {
          const hasLocation = locationInput.value.trim().length > 0;
          const hasProcedure = selectedProcedure.value.length > 0;
          searchButton.disabled = !(hasLocation && hasProcedure);
        }

        // Smart procedure autocomplete
        procedureInput.addEventListener("input", function () {
          const query = this.value.trim();

          if (query.length > 1) {
            const results = searchProcedures(query);
            displayProcedureResults(results, `${formType}-procedure-dropdown`);
          } else {
            dropdown.classList.add("hidden");
          }

          // Clear selection if user is typing new text
          if (selectedProcedure.value) {
            const currentSelection = procedures.find(
              (p) => p.code === selectedProcedure.value
            );
            if (
              currentSelection &&
              !query.toLowerCase().includes(currentSelection.name.toLowerCase())
            ) {
              selectedProcedure.value = "";
              updateSearchButton();
            }
          }
        });

        // Select procedure from dropdown
        dropdown.addEventListener("click", function (e) {
          const option = e.target.closest(".procedure-option");
          if (option) {
            const procedureCode = option.dataset.procedure;
            const procedure = procedures.find((p) => p.code === procedureCode);

            if (procedure) {
              procedureInput.value = `${procedure.name} ${procedure.detail}`;
              selectedProcedure.value = procedureCode;
              dropdown.classList.add("hidden");
              updateSearchButton();
            }
          }
        });

        // Quick search buttons (only for hero form)
        if (formType === "hero") {
          document.querySelectorAll(".hero-quick-search").forEach((button) => {
            button.addEventListener("click", function () {
              const procedureCode = this.dataset.procedure;
              const procedure = procedures.find(
                (p) => p.code === procedureCode
              );

              if (procedure) {
                procedureInput.value = `${procedure.name} ${procedure.detail}`;
                selectedProcedure.value = procedureCode;
                updateSearchButton();
              }
            });
          });
        }

        // Location detection
        if (detectLocationBtn) {
          detectLocationBtn.addEventListener("click", function () {
            if (navigator.geolocation) {
              this.innerHTML =
                '<svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

              navigator.geolocation.getCurrentPosition(
                async (position) => {
                  try {
                    const response = await fetch(
                      `https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${position.coords.latitude}&longitude=${position.coords.longitude}&localityLanguage=en`
                    );
                    const data = await response.json();
                    locationInput.value =
                      data.postcode ||
                      data.city + ", " + data.principalSubdivision;
                    updateSearchButton();
                  } catch (error) {
                    console.error("Location detection failed:", error);
                    locationInput.placeholder =
                      "Location detection failed - enter ZIP manually";
                  }

                  this.innerHTML =
                    '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>';
                },
                (error) => {
                  console.error("Geolocation error:", error);
                  locationInput.placeholder =
                    "Location access denied - enter ZIP manually";
                  this.innerHTML =
                    '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>';
                }
              );
            }
          });
        }

        // Update search button when location changes
        locationInput.addEventListener("input", updateSearchButton);

        // Hide dropdown when clicking outside
        document.addEventListener("click", function (e) {
          if (
            !procedureInput.contains(e.target) &&
            !dropdown.contains(e.target)
          ) {
            dropdown.classList.add("hidden");
          }
        });
      }
    });
  </script>
