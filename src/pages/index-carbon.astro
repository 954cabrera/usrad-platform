---
// index-carbon.astro
import CarbonLayout from "../layouts/CarbonLayout.astro";
import NetworkMapPinsCarbon from "../components/NetworkMapPinsCarbon.astro";
import AOSInit from "../components/AOSInit.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import SecondaryButton from "../components/SecondaryButton.astro";

export const prerender = true;
---

<CarbonLayout title="USRad - MRI Scans in 48 Hours, 70% Less" isHeroPage={true}>
  <AOSInit />

  <!-- ENHANCED PREMIUM HERO SECTION - Replace your current hero section with this -->

  <section
    class="relative py-24 px-4 sm:px-6 bg-[#003087] text-white overflow-hidden"
    data-aos="fade-up"
  >
    <!-- Video Background (Keep as-is) -->
    <div class="absolute inset-0 z-0">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        class="absolute inset-0 w-full h-full object-cover"
        poster="/images/home-hero-mri.webp?v=2.1"
      >
        <source
          src="/videos/home-hero-mri-mobile.mp4"
          type="video/mp4"
          media="(max-width: 768px)"
        />
        <source src="/videos/home-hero-mri.mp4" type="video/mp4" />
        <source src="/videos/home-hero-mri.webm" type="video/webm" />
      </video>

      <!-- Enhanced Video Overlay -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/40"
      >
      </div>
    </div>

    <!-- Gradient blobs -->
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-full blur-3xl opacity-30 z-10"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-96 h-96 bg-gradient-to-br from-[#cc9933]/20 to-orange-500/20 rounded-full blur-3xl opacity-20 z-10"
    >
    </div>

    <div class="max-w-7xl mx-auto relative z-20">
      <div class="max-w-5xl mx-auto text-center">
        <!-- Main Headline (Keep as-is) -->
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-8 text-white leading-tight tracking-tight"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <span class="block">Same Radiologists.</span>
          <span class="block">Same Scanners.</span>
          <span class="text-[#cc9933] relative inline-block">
            70% Less
            <svg
              class="absolute -bottom-2 sm:-bottom-3 left-0 w-full"
              height="20"
              viewBox="0 0 200 20"
              preserveAspectRatio="none"
            >
              <path
                d="M2 14 Q50 4 100 14 T198 14"
                stroke="#cc9933"
                stroke-width="5"
                fill="none"
                class="animate-draw-line drop-shadow-md"
                stroke-linecap="round"
                opacity="0.8"></path>
            </svg>
          </span>
          <span class="text-white">.</span>
        </h1>

        <!-- Subheadline (Keep as-is) -->
        <p
          class="text-xl sm:text-2xl md:text-3xl text-white/90 max-w-3xl mx-auto leading-relaxed drop-shadow-lg"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <span class="block">Book in minutes. Get scanned this week.</span>
          <span class="block">Pay hundreds, not thousands.</span>
        </p>

        <!-- ✨ ENHANCED PREMIUM AVAILABILITY BADGE -->
        <div
          class="flex justify-center mt-10 mb-10"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div
            class="inline-flex items-center gap-3 bg-gradient-to-r from-green-50/95 to-emerald-50/95 backdrop-blur-xl border-2 border-green-400/60 rounded-full px-7 py-4 animate-float shadow-[0_8px_32px_rgba(34,197,94,0.25),0_0_60px_rgba(34,197,94,0.15)] hover:shadow-[0_12px_40px_rgba(34,197,94,0.35),0_0_80px_rgba(34,197,94,0.2)] hover:scale-105 transition-all duration-300"
          >
            <span class="flex h-4 w-4">
              <span
                class="animate-ping absolute inline-flex h-4 w-4 rounded-full bg-green-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-4 w-4 bg-gradient-to-br from-green-400 to-green-500 shadow-lg shadow-green-500/60"
              ></span>
            </span>
            <span
              class="text-base font-bold bg-gradient-to-r from-green-700 to-emerald-700 bg-clip-text text-transparent tracking-tight"
              >Appointments available tomorrow</span
            >
            <svg
              class="w-6 h-6 text-green-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>

        <!-- ✨ PREMIUM COMPACT SEARCH FORM (MDsave Size, Premium Styling) -->
        <!-- ELEVATED Z-INDEX to sit above trust indicators -->
        <div
          class="relative z-50 bg-white/40 backdrop-blur-2xl border-2 border-white/60 rounded-3xl shadow-[0_8px_32px_rgba(255,255,255,0.25),0_0_60px_rgba(255,255,255,0.15)] p-5 max-w-3xl mx-auto mb-24 transition-all duration-300 hover:shadow-[0_12px_48px_rgba(255,255,255,0.35),0_0_80px_rgba(255,255,255,0.2)]"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <!-- Stronger inner glow -->
          <div
            class="absolute inset-0 bg-gradient-to-br from-white/25 to-white/10 rounded-3xl pointer-events-none"
          >
          </div>

          <div class="relative z-10">
            <form
              class="space-y-4"
              action="https://usrad-portal.vercel.app/pbs/search"
              method="GET"
              id="hero-search-form"
            >
              <!-- Procedure Search -->
              <div class="relative">
                <label
                  for="hero-procedure-search"
                  class="block text-sm font-bold text-white mb-2 drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)]"
                >
                  What scan do you need?
                </label>
                <div class="relative group">
                  <input
                    type="text"
                    id="hero-procedure-search"
                    name="procedureSearch"
                    placeholder="Type: MRI, CT, Ultrasound, X-Ray..."
                    class="w-full px-4 py-3 pr-11 text-base text-gray-900 placeholder-gray-500 bg-white/95 backdrop-blur-sm border-2 border-white/70 rounded-xl focus:ring-4 focus:ring-white/50 focus:border-white focus:shadow-[0_0_30px_rgba(255,255,255,0.4)] transition-all duration-300 shadow-lg group-hover:border-white/90"
                    autocomplete="off"
                  />
                  <div
                    class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none"
                  >
                    <svg
                      class="w-5 h-5 text-gray-400 group-focus-within:text-blue-600 transition-colors"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                  </div>

                  <!-- ✨ SOLID OPAQUE DROPDOWN (No Bleed-Through) -->
                  <div
                    id="hero-procedure-dropdown"
                    class="absolute z-[100] w-full bg-white border-2 border-gray-200 rounded-xl shadow-[0_20px_60px_rgba(0,0,0,0.3)] mt-2 hidden overflow-hidden"
                  >
                    <div class="py-2" id="hero-dropdown-content">
                      <!-- Content populated by JavaScript -->
                    </div>
                  </div>
                </div>
              </div>

              <!-- Location with Enhanced Design -->
              <div class="flex flex-col sm:flex-row gap-3">
                <div class="flex-1">
                  <label
                    for="hero-location"
                    class="block text-sm font-semibold text-white/95 mb-2 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
                  >
                    Your location
                  </label>
                  <div class="relative group">
                    <input
                      type="text"
                      id="hero-location"
                      name="zip"
                      placeholder="ZIP code or city"
                      class="w-full px-4 py-3 pr-11 text-base text-gray-900 placeholder-gray-500 bg-white/95 backdrop-blur-sm border-2 border-white/70 rounded-xl focus:ring-4 focus:ring-white/50 focus:border-white focus:shadow-[0_0_30px_rgba(255,255,255,0.4)] transition-all duration-300 shadow-lg group-hover:border-white/90"
                    />
                    <button
                      type="button"
                      id="hero-detect-location"
                      class="absolute inset-y-0 right-0 flex items-center pr-3 text-blue-600 hover:text-blue-700 transition-all hover:scale-110"
                      title="Use my current location"
                    >
                      <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        ></path>
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="flex items-end">
                  <button
                    type="submit"
                    id="hero-search-button"
                    class="w-full sm:w-auto bg-white text-[#003087] px-7 py-3 rounded-xl font-bold text-base shadow-[0_4px_20px_rgba(255,255,255,0.4)] hover:shadow-[0_6px_30px_rgba(255,255,255,0.6)] transition-all duration-300 transform hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 hover:bg-gray-50"
                    disabled
                  >
                    <span class="flex items-center justify-center">
                      Find Centers
                      <svg
                        class="ml-2 w-5 h-5 transition-transform group-hover:translate-x-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                      </svg>
                    </span>
                  </button>
                </div>
              </div>

              <!-- Hidden fields -->
              <input
                type="hidden"
                name="procedure"
                id="hero-selected-procedure"
                value=""
              />
              <input type="hidden" name="autoSearch" value="true" />
              <input type="hidden" name="radius" value="25" />
            </form>

            <!-- Quick Options -->
            <div class="mt-5 pt-4 border-t border-white/30">
              <p class="text-sm font-bold text-white mb-2.5 drop-shadow-lg">
                Popular searches:
              </p>
              <div class="flex flex-wrap gap-2">
                <button
                  class="hero-quick-search px-3.5 py-1.5 bg-white/95 hover:bg-white text-gray-800 font-medium text-sm rounded-full border-2 border-white/70 hover:border-white shadow-md hover:shadow-xl transition-all duration-200 hover:scale-105"
                  data-procedure="70551"
                >
                  MRI Brain
                </button>
                <button
                  class="hero-quick-search px-3.5 py-1.5 bg-white/95 hover:bg-white text-gray-800 font-medium text-sm rounded-full border-2 border-white/70 hover:border-white shadow-md hover:shadow-xl transition-all duration-200 hover:scale-105"
                  data-procedure="72148"
                >
                  MRI Spine
                </button>
                <button
                  class="hero-quick-search px-3.5 py-1.5 bg-white/95 hover:bg-white text-gray-800 font-medium text-sm rounded-full border-2 border-white/70 hover:border-white shadow-md hover:shadow-xl transition-all duration-200 hover:scale-105"
                  data-procedure="74177"
                >
                  CT Scan
                </button>
                <button
                  class="hero-quick-search px-3.5 py-1.5 bg-white/95 hover:bg-white text-gray-800 font-medium text-sm rounded-full border-2 border-white/70 hover:border-white shadow-md hover:shadow-xl transition-all duration-200 hover:scale-105"
                  data-procedure="76700"
                >
                  Ultrasound
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Trust Indicators -->
        <div
          class="flex flex-wrap justify-center gap-8 text-base text-white font-semibold mt-16 drop-shadow-lg"
          data-aos="fade-up"
          data-aos-delay="500"
        >
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>No insurance required</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Upfront pricing</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>1,500+ locations</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Animations */
    @keyframes draw-line {
      from {
        stroke-dashoffset: 200;
        opacity: 0;
      }
      to {
        stroke-dashoffset: 0;
        opacity: 0.8;
      }
    }

    .animate-draw-line {
      stroke-dasharray: 200;
      stroke-dashoffset: 200;
      animation: draw-line 1.5s ease-out 0.8s forwards;
    }

    @keyframes float {
      0%,
      100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    .animate-float {
      animation: float 3s ease-in-out infinite;
    }

    /* Enhanced input focus states */
    #hero-procedure-search:focus,
    #hero-location:focus {
      outline: none;
    }

    /* Smooth transitions for all interactive elements */
    .hero-quick-search {
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Button group effect */
    #hero-search-button:not(:disabled):active {
      transform: scale(0.98);
    }
  </style>

  <!-- Rest of your existing sections... -->
  <!-- I'm keeping the rest exactly as you had it -->

  <!-- Social Proof Bar - BIGGER NUMBERS -->
  <section
    class="bg-gray-50 py-10 px-4 sm:px-6 border-y border-gray-100"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
        <div data-aos="fade-up" data-aos-delay="100">
          <div class="text-3xl md:text-4xl font-bold text-[#003087]">
            168,244
          </div>
          <div class="text-base text-gray-600">Patients served</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="200">
          <div class="text-3xl md:text-4xl font-bold text-[#003087]">
            $246 Million
          </div>
          <div class="text-base text-gray-600">Amount clients saved</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="300">
          <div class="text-3xl md:text-4xl font-bold text-[#003087]">48hr</div>
          <div class="text-base text-gray-600">Average wait time</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="400">
          <div class="text-3xl md:text-4xl font-bold text-[#003087]">4.9★</div>
          <div class="text-base text-gray-600">Patient rating</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-white via-blue-50/20 to-white"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20">
        <h2
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
        >
          Getting your MRI is this easy
        </h2>
        <p
          class="text-2xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          From booking to results in 3 simple steps
        </p>
      </div>

      <!-- Add specific class for steps grid -->
      <div
        class="grid md:grid-cols-3 gap-12 max-w-6xl mx-auto how-it-works-steps"
      >
        <!-- Step 1 -->
        <div
          class="text-center flex flex-col"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <!-- Icon Container with Step Number -->
          <div class="relative h-56 flex items-center justify-center mb-8">
            <div class="absolute top-0 left-1/2 transform -translate-x-1/2">
              <span
                class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-gray-200 text-gray-600 text-sm font-semibold"
                >1</span
              >
            </div>
            <div
              class="w-40 h-40 bg-gray-50 rounded-2xl flex items-center justify-center"
            >
              <img
                src="/images/icons/expenses.svg"
                alt="Compare prices"
                class="w-24 h-24"
              />
            </div>
          </div>
          <h3 class="text-2xl font-semibold mb-4">Compare prices</h3>
          <p class="text-lg text-gray-600">
            See upfront costs from quality imaging centers near you. No hidden
            fees.
          </p>
        </div>

        <!-- Step 2 -->
        <div
          class="text-center flex flex-col"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <!-- Icon Container with Step Number -->
          <div class="relative h-56 flex items-center justify-center mb-8">
            <div class="absolute top-0 left-1/2 transform -translate-x-1/2">
              <span
                class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[#003087] text-white text-sm font-semibold"
                >2</span
              >
            </div>
            <div
              class="w-40 h-40 bg-[#fefbf5] rounded-2xl flex items-center justify-center"
            >
              <img
                src="/images/icons/appointment1.svg"
                alt="Book instantly"
                class="w-24 h-24"
              />
            </div>
          </div>
          <h3 class="text-2xl font-semibold mb-4">Book instantly</h3>
          <p class="text-lg text-gray-600">
            Choose your time and location. Most appointments within 2-3 days.
          </p>
        </div>

        <!-- Step 3 -->
        <div
          class="text-center flex flex-col"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <!-- Icon Container with Step Number -->
          <div class="relative h-56 flex items-center justify-center mb-8">
            <div class="absolute top-0 left-1/2 transform -translate-x-1/2">
              <span
                class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[#cc9933] text-white text-sm font-semibold"
                >3</span
              >
            </div>
            <div
              class="w-40 h-40 bg-gray-50 rounded-2xl flex items-center justify-center"
            >
              <img
                src="/images/icons/fast.svg"
                alt="Get results fast"
                class="w-24 h-24"
              />
            </div>
          </div>
          <h3 class="text-2xl font-semibold mb-4">Get results fast</h3>
          <p class="text-lg text-gray-600">
            Board-certified radiologists review your scan. Results in 24-48
            hours.
          </p>
        </div>
      </div>

      <!-- Style for connecting lines - ONLY for how-it-works section -->
      <style>
        @media (min-width: 768px) {
          .how-it-works-steps > div:not(:last-child)::after {
            content: "";
            position: absolute;
            top: 128px;
            right: -48px;
            width: 96px;
            height: 2px;
            background: linear-gradient(
              to right,
              #e5e7eb 0%,
              #e5e7eb 45%,
              transparent 45%,
              transparent 55%,
              #e5e7eb 55%,
              #e5e7eb 100%
            );
            background-size: 8px 2px;
          }
        }
      </style>
    </div>
  </section>

  <!-- Pricing Section -->
  <section
    class="py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-50 via-white to-gray-50"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20">
        <h2
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
        >
          Clear, upfront pricing
        </h2>
        <p
          class="text-2xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          No insurance? No problem. Save up to 70% vs hospital prices.
        </p>
      </div>

      <!-- Simple Price Display -->
      <div class="max-w-4xl mx-auto text-center">
        <!-- Main Price - MUCH BIGGER -->
        <div class="mb-16" data-aos="zoom-in" data-aos-delay="200">
          <p
            class="text-base font-medium text-[#cc9933] uppercase tracking-wide mb-4"
          >
            MRI Starting At
          </p>
          <p
            class="text-7xl md:text-8xl lg:text-9xl font-bold text-[#003087] mb-6"
          >
            $260
          </p>
          <p class="text-xl md:text-2xl text-gray-600">
            vs $3,200 average hospital price
          </p>
        </div>

        <!-- Benefits Grid - NO connecting lines class -->
        <div class="grid md:grid-cols-3 gap-12 mb-16 pricing-benefits">
          <!-- 48-hour booking -->
          <div data-aos="fade-up" data-aos-delay="300" class="group">
            <div
              class="w-20 h-20 mx-auto mb-6 flex items-center justify-center"
            >
              <img
                src="/images/icons/flash.svg"
                alt="Fast booking"
                class="w-16 h-16 filter-brand-blue group-hover:scale-110 transition-transform duration-300"
              />
            </div>
            <h3 class="font-semibold text-xl text-gray-900 mb-3">
              48-hour booking
            </h3>
            <p class="text-base text-gray-600">
              Get scanned this week, not next month
            </p>
          </div>

          <!-- Upfront pricing -->
          <div data-aos="fade-up" data-aos-delay="400" class="group">
            <div
              class="w-20 h-20 mx-auto mb-6 flex items-center justify-center"
