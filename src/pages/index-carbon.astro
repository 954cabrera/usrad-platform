---
// index-carbon.astro
import CarbonLayout from "../layouts/CarbonLayout.astro";
import NetworkMapPinsCarbon from "../components/NetworkMapPinsCarbon.astro";
import AOSInit from "../components/AOSInit.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import SecondaryButton from "../components/SecondaryButton.astro";
---

<CarbonLayout title="USRad - MRI Scans in 48 Hours, 70% Less">
  <AOSInit />

  <!-- Hero Section -->
  <section
    class="relative pt-12 pb-16 px-4 sm:px-6 overflow-hidden"
    data-aos="fade-up"
  >
    <!-- Add subtle gradient blobs -->
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-blue-50 to-purple-50 rounded-full blur-3xl opacity-50"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-96 h-96 bg-gradient-to-br from-yellow-50 to-orange-50 rounded-full blur-3xl opacity-30"
    >
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2 bg-green-50 border"></div>

        <!-- Main Headline -->
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Get your MRI in <span class="text-[#003087] relative inline-block">
            48 hours
            <svg
              class="absolute -bottom-3 left-0 w-full"
              height="12"
              viewBox="0 0 200 12"
              preserveAspectRatio="none"
            >
              <path
                d="M2 8 Q50 2 100 8 T198 8"
                stroke="#cc9933"
                stroke-width="4"
                fill="none"
                class="animate-draw-line"
                stroke-linecap="round"></path>
            </svg>
          </span>,<br />not 6 weeks
        </h1>

        <style>
          @keyframes draw-line {
            from {
              stroke-dashoffset: 200;
            }
            to {
              stroke-dashoffset: 0;
            }
          }
          .animate-draw-line {
            stroke-dasharray: 200;
            animation: draw-line 1.5s ease-out 0.5s forwards;
          }
        </style>

        <!-- Subheadline -->
        <p
          class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          Same board-certified radiologists. Same quality imaging.
          <span class="font-semibold text-gray-900"
            >70% less than hospitals.</span
          >
        </p>

        <!-- Right after your hero subheading -->
        <div
          class="flex justify-center mb-8"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div
            class="inline-flex items-center gap-2 bg-green-50 border border-green-200 rounded-full px-4 py-2 animate-float"
          >
            <span class="flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-green-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
              ></span>
            </span>
            <span class="text-sm text-green-800 font-medium"
              >Appointments available tomorrow</span
            >
          </div>
        </div>

        <style>
          @keyframes float {
            0%,
            100% {
              transform: translateY(0px);
            }
            50% {
              transform: translateY(-10px);
            }
          }
          .animate-float {
            animation: float 3s ease-in-out infinite;
          }
        </style>

        <!-- Search Form -->
        <div
          class="bg-white rounded-2xl shadow-lg p-2 max-w-xl mx-auto mb-6"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <form
            class="flex flex-col sm:flex-row gap-2"
            action="/search-results"
            method="GET"
          >
            <input
              type="text"
              name="zipCode"
              placeholder="Enter your ZIP code"
              pattern="[0-9]{5}"
              maxlength="5"
              required
              class="flex-1 px-4 py-3 rounded-lg text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#003087] focus:border-transparent"
            />
            <input type="hidden" name="procedure" value="70551" />
            <input type="hidden" name="state" value="FL" />
            <input type="hidden" name="autoSearch" value="true" />
            <button
              type="submit"
              class="bg-[#003087] text-white px-6 py-3 rounded-lg font-medium hover:bg-[#002266] transition whitespace-nowrap"
            >
              Check prices →
            </button>
          </form>
        </div>

        <!-- Trust Indicators -->
        <div
          class="flex flex-wrap justify-center gap-6 text-sm text-gray-600"
          data-aos="fade-up"
          data-aos-delay="500"
        >
          <div class="flex items-center gap-2">
            <svg
              class="w-4 h-4 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>No insurance required</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-4 h-4 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Upfront pricing</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-4 h-4 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>1,500+ locations</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof Bar -->
  <section
    class="bg-gray-50 py-8 px-4 sm:px-6 border-y border-gray-100"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
        <div data-aos="fade-up" data-aos-delay="100">
          <div class="text-2xl font-bold text-[#003087]">400K+</div>
          <div class="text-sm text-gray-600">Patients served</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="200">
          <div class="text-2xl font-bold text-[#003087]">$400M+</div>
          <div class="text-sm text-gray-600">Saved for patients</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="300">
          <div class="text-2xl font-bold text-[#003087]">48hr</div>
          <div class="text-sm text-gray-600">Average wait time</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="400">
          <div class="text-2xl font-bold text-[#003087]">4.9★</div>
          <div class="text-sm text-gray-600">Patient rating</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section
    class="py-20 px-4 sm:px-6 bg-gradient-to-br from-white via-blue-50/20 to-white"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900"
          data-aos="fade-up"
        >
          Getting your scan is this easy
        </h2>
        <p
          class="text-xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          From booking to results in 3 simple steps
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-12 max-w-6xl mx-auto">
        <!-- Step 1 -->
        <div
          class="text-center flex flex-col"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <!-- Larger image without number -->
          <div class="h-48 flex items-center justify-center mb-6">
            <img
              src="/images/icons/envato_comparingprices.webp"
              alt="Compare prices"
              class="max-w-[192px] max-h-[192px] object-contain"
            />
          </div>
          <h3 class="text-xl font-semibold mb-3">Compare prices</h3>
          <p class="text-gray-600">
            See upfront costs from quality imaging centers near you. No hidden
            fees.
          </p>
        </div>

        <!-- Step 2 -->
        <div
          class="text-center flex flex-col"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <!-- Larger image without number -->
          <div class="h-48 flex items-center justify-center mb-6">
            <img
              src="/images/icons/envato_bookinstantly.webp"
              alt="Book instantly"
              class="max-w-[192px] max-h-[192px] object-contain"
            />
          </div>
          <h3 class="text-xl font-semibold mb-3">Book instantly</h3>
          <p class="text-gray-600">
            Choose your time and location. Most appointments within 2-3 days.
          </p>
        </div>

        <!-- Step 3 -->
        <div
          class="text-center flex flex-col"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <!-- Larger image without number -->
          <div class="h-48 flex items-center justify-center mb-6">
            <img
              src="/images/icons/envato_docpatient.webp"
              alt="Get results fast"
              class="max-w-[192px] max-h-[192px] object-contain"
            />
          </div>
          <h3 class="text-xl font-semibold mb-3">Get results fast</h3>
          <p class="text-gray-600">
            Board-certified radiologists review your scan. Results in 24-48
            hours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section
    class="py-20 px-4 sm:px-6 bg-gradient-to-br from-gray-50 via-white to-gray-50"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900"
          data-aos="fade-up"
        >
          Clear, upfront pricing
        </h2>
        <p
          class="text-xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          No insurance? No problem. Save up to 70% vs hospital prices.
        </p>
      </div>

      <!-- Simple Price Display -->
      <div class="max-w-3xl mx-auto text-center">
        <!-- Main Price -->
        <div class="mb-12" data-aos="zoom-in" data-aos-delay="200">
          <p
            class="text-sm font-medium text-[#cc9933] uppercase tracking-wide mb-2"
          >
            MRI Starting At
          </p>
          <p class="text-6xl md:text-7xl font-bold text-[#003087] mb-4">$260</p>
          <p class="text-lg text-gray-600">vs $3,200 average hospital price</p>
        </div>

        <!-- Benefits Grid -->
        <div class="grid md:grid-cols-3 gap-8 mb-12">
          <div data-aos="fade-up" data-aos-delay="300">
            <div class="text-3xl mb-2">⚡</div>
            <h3 class="font-semibold text-gray-900 mb-1">48-hour booking</h3>
            <p class="text-sm text-gray-600">
              Get scanned this week, not next month
            </p>
          </div>
          <div data-aos="fade-up" data-aos-delay="400">
            <div class="text-3xl mb-2">💰</div>
            <h3 class="font-semibold text-gray-900 mb-1">Upfront pricing</h3>
            <p class="text-sm text-gray-600">No surprises, no hidden fees</p>
          </div>
          <div data-aos="fade-up" data-aos-delay="500">
            <div class="text-3xl mb-2">✅</div>
            <h3 class="font-semibold text-gray-900 mb-1">
              No insurance needed
            </h3>
            <p class="text-sm text-gray-600">
              Same quality care, direct pricing
            </p>
          </div>
        </div>

        <!-- CTA Button Section -->
        <div class="bg-gray-50 px-8 py-6 text-center">
          <a
            href="/pricing"
            class="inline-block bg-[#003087] text-white px-8 py-3 rounded-lg font-medium hover:bg-[#002266] transition"
          >
            See prices in your area →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Locations Map Section -->
  <section class="py-20 px-4 sm:px-6 bg-white" data-aos="fade-up">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2
          class="text-3xl sm:text-4xl font-bold mb-4 text-gray-900"
          data-aos="fade-up"
        >
          1,500+ locations nationwide
        </h2>
        <p
          class="text-xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Quality imaging centers competing for your business
        </p>
      </div>
    </div>

    <NetworkMapPinsCarbon />
  </section>

  <!-- About/Trust Section -->
  <section
    class="py-20 px-4 sm:px-6 bg-gradient-to-br from-white via-gray-50/30 to-white"
    data-aos="fade-up"
  >
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto text-center">
        <h2
          class="text-3xl sm:text-4xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
        >
          Built by healthcare pioneers
        </h2>
        <p
          class="text-xl text-gray-600 mb-8"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          We created America's first managed care imaging network, serving
          400,000+ patients and saving $400 Million+. Now we're supercharging
          that proven model with AI and digital innovation to make world-class
          medical imaging affordable for everyone.
        </p>

        <!-- Credentials -->
        <div class="grid sm:grid-cols-3 gap-6 mb-12">
          <div
            class="bg-white rounded-xl p-6 hover:shadow-md transition-shadow"
            data-aos="zoom-in"
            data-aos-delay="200"
          >
            <div class="text-3xl mb-3">🏥</div>
            <h3 class="font-semibold mb-2">Medical excellence</h3>
            <p class="text-sm text-gray-600">
              All centers meet strict quality standards
            </p>
          </div>
          <div
            class="bg-white rounded-xl p-6 hover:shadow-md transition-shadow"
            data-aos="zoom-in"
            data-aos-delay="300"
          >
            <div class="text-3xl mb-3">🛡️</div>
            <h3 class="font-semibold mb-2">Price protection</h3>
            <p class="text-sm text-gray-600">
              What you see is what you pay, guaranteed
            </p>
          </div>
          <div
            class="bg-white rounded-xl p-6 hover:shadow-md transition-shadow"
            data-aos="zoom-in"
            data-aos-delay="400"
          >
            <div class="text-3xl mb-3">⚡</div>
            <h3 class="font-semibold mb-2">Fast results</h3>
            <p class="text-sm text-gray-600">
              24-48 hour turnaround from expert radiologists
            </p>
          </div>
        </div>

        <a
          href="/about"
          class="inline-block bg-[#003087] text-white px-8 py-3 rounded-lg font-medium hover:bg-[#002266] transition"
        >
          Read our story →
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section
    class="py-20 px-4 sm:px-6 bg-[#003087] text-white"
    data-aos="fade-up"
  >
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold mb-6" data-aos="fade-up">
        Stop overpaying for medical imaging
      </h2>
      <p
        class="text-xl mb-8 opacity-90"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Join thousands getting the same quality care for 70% less
      </p>
      <div
        class="bg-white/10 backdrop-blur-sm rounded-2xl p-2 max-w-md mx-auto"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <form
          class="flex flex-col sm:flex-row gap-2"
          action="/search-results"
          method="GET"
        >
          <input
            type="text"
            name="zipCode"
            placeholder="Enter your ZIP code"
            pattern="[0-9]{5}"
            maxlength="5"
            required
            class="flex-1 px-4 py-3 rounded-lg text-gray-900 placeholder-gray-500 focus:outline-none"
          />
          <input type="hidden" name="procedure" value="70551" />
          <input type="hidden" name="state" value="FL" />
          <input type="hidden" name="autoSearch" value="true" />
          <button
            type="submit"
            class="bg-white text-[#003087] px-6 py-3 rounded-lg font-medium hover:bg-gray-100 transition whitespace-nowrap"
          >
            Get started →
          </button>
        </form>
      </div>
    </div>
  </section>

  <style>
    /* Add any page-specific styles here */
    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.5;
      }
    }

    .animate-pulse {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
  </style>
</CarbonLayout>
