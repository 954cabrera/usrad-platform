---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import Footer from "../components/Footer.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import FadeIn from "../components/FadeIn.astro";
import AOSInit from "../components/AOSInit.astro";
import HomeProblemSolution from "../components/HomeProblemSolution.astro";
import FAQHome from "../components/FAQHome.astro";
import News from "../components/News.astro";
import HeroPatientIntro from "../components/HeroPatientIntro.astro";
import FAQPreview from "../components/FAQPreview.astro";
import CoreBenefits from "../components/CoreBenefits.astro";
import PatientTestimonials from "../components/PatientTestimonials.astro";
import ClinicalTrustSection from "../components/ClinicalTrustSection.astro";
import TrustBadgesBar from "../components/TrustBadgesBar.astro";
import CallToAction from "../components/CallToAction.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import ClinicalIntroWithImage from "../components/ClinicalIntroWithImage.astro";
import ClinicalCredentialsGrid from "../components/ClinicalCredentialsGrid.astro";
import SecondaryButton from "../components/SecondaryButton.astro";

const showPatientHeader = true;
---

<MainPatientLayout showPatientHeader={true}>
  <AOSInit />

  <!-- Enhanced Video Hero Section - CREDIBILITY FIRST -->
  <FadeIn effect="fade" delay={0}>
    <section class="relative h-[80vh] overflow-hidden hero-section-mobile">
      <video
        autoplay
        muted
        loop
        playsinline
        class="absolute inset-0 w-full h-full object-cover z-0"
        poster="/images/home-hero-mri.webp?v=2.1"
      >
        <source
          src="/videos/home-hero-mri-mobile.mp4"
          type="video/mp4"
          media="(max-width: 768px)"
        />
        <source src="/videos/home-hero-mri.mp4" type="video/mp4" />
        <source src="/videos/home-hero-mri.webm" type="video/webm" />
        <img
          src="/images/website/home-hero-mri.webp?v=2.1"
          alt="MRI Hero"
          class="w-full h-full object-cover"
        />
      </video>

      <!-- Enhanced Gradient Overlay -->
      <div
        class="absolute inset-0 bg-[#003087]/75 flex flex-col justify-center items-center text-white text-center px-4"
      >
        <!-- CREDIBILITY BANNER -->
        <div class="animate-fade-in-up mb-6">
          <div
            class="bg-white/10 backdrop-blur-md rounded-full px-6 py-2 border border-white/20"
          >
            <span class="text-[#cc9933] font-bold text-sm"
              >🏆 PROVEN TRACK RECORD:</span
            >
            <span class="text-white text-sm ml-2"
              >$400M+ saved • 400K+ patients served • Acquired by CorVel (NYSE:
              CVL)</span
            >
          </div>
        </div>

        <!-- PRIMARY HEADLINE - SPEED FOCUSED -->
        <h1
          class="text-3xl sm:text-5xl lg:text-6xl font-semibold mb-4 drop-shadow-lg animate-fade-in-up"
        >
          <span class="text-white"> Get Your MRI This Week, </span>
          <br />
          <span class="text-[#cc9933] font-bold">Not Next Month</span>
        </h1>

        <!-- CREDIBILITY-ENHANCED SUBTITLE -->
        <p
          class="max-w-2xl text-lg sm:text-xl mb-6 drop-shadow animate-fade-in-up animation-delay-300"
        >
          From the <span class="text-[#cc9933] font-semibold">proven team</span>
          that delivered
          <span class="text-yellow-300 font-bold">$400M+ in savings</span> to 400,000+
          patients.
          <br class="hidden sm:block" />
          <span class="text-white"
            >2-4 day appointments • 30-70% below hospitals</span
          >
        </p>

        <!-- Enhanced CTA Button with Dual Action -->
        <div class="animate-fade-in-up animation-delay-600">
          <div
            class="flex flex-col sm:flex-row gap-4 items-center justify-center"
          >
            <!-- Primary CTA - Quick Book -->
            <a
              href="/search-results?zipCode=33330&procedure=70551&state=FL&autoSearch=true"
              class="group bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-semibold px-8 py-5 sm:py-4 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center gap-2"
            >
              Book Your MRI Now
              <svg
                class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>

            <!-- Secondary CTA - Custom Search -->
            <button
              id="heroSearchToggle"
              class="group border-2 border-white text-white font-semibold px-6 py-5 sm:py-4 rounded-xl hover:bg-white hover:text-[#003087] transition-all duration-300 inline-flex items-center gap-2 backdrop-blur-sm"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z"
                ></path>
              </svg>
              Check Prices
            </button>
          </div>

          <!-- [Keep existing search form code unchanged] -->
          <div id="heroSearchForm" class="hidden mt-6 max-w-2xl mx-auto">
            <div
              class="bg-white/10 backdrop-blur-2xl rounded-3xl p-6 shadow-2xl border border-white/20"
            >
              <form id="heroSearchFormElement" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div>
                    <label
                      for="hero-zipcode"
                      class="block text-sm font-medium text-white mb-1"
                    >
                      ZIP Code *
                    </label>
                    <input
                      id="hero-zipcode"
                      type="text"
                      placeholder="Enter ZIP code"
                      required
                      pattern="[0-9]{5}"
                      maxLength="5"
                      class="w-full px-3 py-2 rounded-lg text-sm bg-white/10 backdrop-blur-md border border-white/20 text-white placeholder-white/70 focus:ring-2 focus:ring-white/30 focus:border-white/40 transition-colors"
                    />
                  </div>

                  <div>
                    <label
                      for="hero-procedure"
                      class="block text-sm font-medium text-white mb-1"
                    >
                      Procedure
                    </label>
                    <select
                      id="hero-procedure"
                      class="w-full px-3 py-2 rounded-lg text-sm bg-white/10 backdrop-blur-md border border-white/20 text-white focus:ring-2 focus:ring-white/30 focus:border-white/40 transition-colors"
                      style="color-scheme: dark;"
                    >
                      <option
                        value="70551"
                        style="background-color: rgba(255,255,255,0.9); color: #1f2937;"
                        >MRI Brain</option
                      >
                      <option
                        value="73721"
                        style="background-color: rgba(255,255,255,0.9); color: #1f2937;"
                        >MRI Knee</option
                      >
                      <option
                        value="72148"
                        style="background-color: rgba(255,255,255,0.9); color: #1f2937;"
                        >MRI Spine</option
                      >
                      <option
                        value="74181"
                        style="background-color: rgba(255,255,255,0.9); color: #1f2937;"
                        >CT Abdomen</option
                      >
                      <option
                        value="70450"
                        style="background-color: rgba(255,255,255,0.9); color: #1f2937;"
                        >CT Head</option
                      >
                    </select>
                  </div>

                  <div>
                    <label
                      for="hero-state"
                      class="block text-sm font-medium text-white mb-1"
                    >
                      State
                    </label>
                    <select
                      id="hero-state"
                      class="w-full px-3 py-2 rounded-lg text-sm bg-white/10 backdrop-blur-md border border-white/20 text-white focus:ring-2 focus:ring-white/30 focus:border-white/40 transition-colors"
                      style="color-scheme: dark;"
                    >
                      <option
                        value="FL"
                        style="background-color: rgba(255,255,255,0.9); color: #1f2937;"
                        >Florida</option
                      >
                      <option
                        value="GA"
                        style="background-color: rgba(255,255,255,0.9); color: #1f2937;"
                        >Georgia</option
                      >
                    </select>
                  </div>
                </div>

                <button
                  type="submit"
                  class="w-full bg-white/20 backdrop-blur-md text-white font-semibold py-3 rounded-lg hover:bg-white/30 transition-all duration-300 flex items-center justify-center gap-2 border border-white/30"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z"
                    ></path>
                  </svg>
                  Find Imaging Centers
                </button>
              </form>

              <!-- Popular Locations -->
              <div class="mt-4 pt-4 border-t border-white/20">
                <p class="text-xs text-white/80 mb-2">Popular locations:</p>
                <div class="flex flex-wrap gap-2">
                  <button
                    data-zip="33012"
                    data-city="Miami"
                    class="quick-location text-xs bg-white/10 backdrop-blur-md text-white px-3 py-1 rounded-full hover:bg-white/20 transition-all duration-200 border border-white/20"
                  >
                    Miami
                  </button>
                  <button
                    data-zip="32801"
                    data-city="Orlando"
                    class="quick-location text-xs bg-white/10 backdrop-blur-md text-white px-3 py-1 rounded-full hover:bg-white/20 transition-all duration-200 border border-white/20"
                  >
                    Orlando
                  </button>
                  <button
                    data-zip="33602"
                    data-city="Tampa"
                    class="quick-location text-xs bg-white/10 backdrop-blur-md text-white px-3 py-1 rounded-full hover:bg-white/20 transition-all duration-200 border border-white/20"
                  >
                    Tampa
                  </button>
                  <button
                    data-zip="30309"
                    data-city="Atlanta"
                    class="quick-location text-xs bg-white/10 backdrop-blur-md text-white px-3 py-1 rounded-full hover:bg-white/20 transition-all duration-200 border border-white/20"
                  >
                    Atlanta
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- CREDIBILITY TRUST INDICATORS -->
          <div class="mt-6 animate-fade-in-up animation-delay-900">
            <div
              class="flex flex-wrap justify-center items-center gap-6 text-base sm:text-sm opacity-90"
            >
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 bg-green-400 rounded-full animate-pulse">
                </div>
                <span>📅 Next available: Tomorrow</span>
              </div>
              <div class="flex items-center gap-2">
                <svg
                  class="w-4 h-4 text-[#cc9933]"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Same proven model as AnciCare</span>
              </div>
              <div class="flex items-center gap-2">
                <svg
                  class="w-4 h-4 text-green-400"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>100% price guarantee</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- NEW: PROOF SECTION - ANCICARE SUCCESS METRICS -->
    <section class="bg-gradient-to-br from-[#fefbf5] to-[#f8f5e8] py-16 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <div
            class="inline-flex items-center gap-2 bg-[#cc9933] text-white px-4 py-2 rounded-full text-sm font-semibold mb-4"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            PROVEN RESULTS
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-[#003087] mb-4">
            We've Done This Before – Successfully
          </h2>
          <p class="text-lg text-[#003087]/80 max-w-3xl mx-auto">
            Before USRad, our team built AnciCare – America's first managed care
            imaging network. The results speak for themselves.
          </p>
        </div>

        <!-- SUCCESS METRICS GRID -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
          <div class="text-center" data-aos="fade-up" data-aos-delay="100">
            <div
              class="bg-white rounded-2xl p-6 shadow-lg border border-[#e6c378]/20"
            >
              <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
                $400M+
              </div>
              <div class="text-sm text-[#003087] font-medium">
                Total Savings Delivered
              </div>
              <div class="text-xs text-[#003087]/60 mt-1">
                Medical + Indemnity costs
              </div>
            </div>
          </div>
          <div class="text-center" data-aos="fade-up" data-aos-delay="200">
            <div
              class="bg-white rounded-2xl p-6 shadow-lg border border-[#e6c378]/20"
            >
              <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
                400K+
              </div>
              <div class="text-sm text-[#003087] font-medium">
                Patients Served
              </div>
              <div class="text-xs text-[#003087]/60 mt-1">AnciCare legacy</div>
            </div>
          </div>
          <div class="text-center" data-aos="fade-up" data-aos-delay="300">
            <div
              class="bg-white rounded-2xl p-6 shadow-lg border border-[#e6c378]/20"
            >
              <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
                2-3
              </div>
              <div class="text-sm text-[#003087] font-medium">
                Day Average Wait
              </div>
              <div class="text-xs text-[#003087]/60 mt-1">
                vs 10-14 days industry
              </div>
            </div>
          </div>
          <div class="text-center" data-aos="fade-up" data-aos-delay="400">
            <div
              class="bg-white rounded-2xl p-6 shadow-lg border border-[#e6c378]/20"
            >
              <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
                30
              </div>
              <div class="text-sm text-[#003087] font-medium">
                Years Experience
              </div>
              <div class="text-xs text-[#003087]/60 mt-1">
                Industry pioneers
              </div>
            </div>
          </div>
        </div>

        <!-- CREDIBILITY STORY -->
        <div
          class="bg-white rounded-3xl p-8 md:p-12 shadow-xl border border-[#e6c378]/30"
          data-aos="fade-up"
          data-aos-delay="500"
        >
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <h3 class="text-2xl font-bold text-[#003087] mb-4">
                Same Innovation, Expanded Access
              </h3>
              <p class="text-[#003087]/90 mb-4">
                We pioneered the managed care imaging model with AnciCare,
                achieving
                <strong>50%+ cost savings</strong> while reducing appointment wait
                times from
                <strong>10-14 days to 2-3 days</strong>.
              </p>
              <p class="text-[#003087]/90 mb-6">
                After successfully exiting to a public company, we're now
                applying the same proven model to serve the 90 million uninsured
                and underinsured Americans who deserve access to affordable,
                high-quality imaging.
              </p>
              <div class="flex items-center gap-4">
                <a
                  href="/about"
                  class="bg-[#003087] text-white px-6 py-3 rounded-xl hover:bg-[#002266] transition-colors font-medium"
                >
                  Our Story →
                </a>
                <div class="text-sm text-[#003087]/70">
                  ⭐ Acquired by CorVel Corporation (NYSE: CVL)
                </div>
              </div>
            </div>
            <div class="relative">
              <img
                src="/images/two-rads-control-center.webp"
                alt="Proven medical imaging team"
                class="w-full h-auto rounded-2xl shadow-lg"
              />
              <div
                class="absolute -bottom-4 -right-4 bg-[#cc9933] text-white p-4 rounded-xl shadow-lg"
              >
                <div class="text-sm font-bold">✓ PROVEN</div>
                <div class="text-xs">Track Record</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ENHANCED "BEHIND THE SIMPLICITY" - NOW WITH CREDIBILITY -->
    <section class="bg-[#fefbf5] py-20 px-6 text-[#003087]">
      <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center">
        <!-- Image on Left -->
        <div data-aos="fade-right">
          <img
            src="/images/two-rads-control-center.webp"
            loading="lazy"
            alt="Expert medical team reviewing imaging results"
            class="w-full h-auto rounded-2xl shadow-xl"
          />
        </div>

        <!-- Text on Right - ENHANCED WITH CREDIBILITY -->
        <div data-aos="fade-left" class="text-left">
          <p
            class="text-sm uppercase tracking-wide font-semibold text-[#cc9933] mb-4"
          >
            Proven Infrastructure
          </p>
          <h2 class="text-2xl sm:text-3xl font-bold mb-6 text-[#003087]">
            Full-Scale Care Organization
            <span class="text-lg font-normal text-[#003087]/70 block mt-2">
              The same proven model that delivered $400M+ in savings
            </span>
          </h2>
          <div class="space-y-4 text-lg text-[#003087]/90">
            <p>
              USRad isn't just a booking tool or referral marketplace. We
              operate like a full-scale managed care organization — <strong
                >the same proven model</strong
              >
              we successfully built with AnciCare.
            </p>
            <p>
              With dedicated teams for provider relations, customer support,
              quality assurance, and medical oversight, we've already <strong
                >proven this works</strong
              > for 400,000+ patients.
            </p>
            <div class="bg-[#f0f4f9] rounded-xl p-4 mt-6">
              <div
                class="flex items-center gap-2 text-[#cc9933] font-semibold text-sm mb-2"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                PROVEN RESULTS
              </div>
              <div class="text-sm text-[#003087]">
                ✓ $200M+ in direct medical savings<br />
                ✓ $200M+ in productivity/indemnity savings<br />
                ✓ 30-year track record of success
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Benefits -->
    <section
      class="relative pt-16 pb-20"
      style="
        background: linear-gradient(135deg, #fcf9f0 0%, #f8f5e8 100%);
        background-image: 
          radial-gradient(circle at 25% 25%, rgba(0, 48, 135, 0.03) 0%, transparent 50%),
          radial-gradient(circle at 75% 75%, rgba(204, 153, 51, 0.03) 0%, transparent 50%);
        background-size: 120px 120px, 80px 80px;
      "
    >
      <div class="relative z-10">
        <CoreBenefits />
      </div>
    </section>

    <!-- Personal Care Section -->
    <section class="bg-white py-20 px-6">
      <div class="max-w-7xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold text-[#003087] mb-4" data-aos="fade-up">
          Personal Care Every Step
          <span class="text-lg font-normal text-[#003087]/70 block mt-2">
            Refined through AnciCare (1994-2002) and validated by CorVel's
            continued operation
          </span>
        </h2>
        <p
          class="text-lg text-[#003087]/80"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Our dedicated team guides you through your entire MRI experience,
          using processes perfected through 400,000+ patient interactions and
          proven valuable enough for CorVel Corporation (NYSE: CVL) to acquire
          and operate for 20+ years
        </p>
      </div>

      <div class="max-w-4xl mx-auto" data-aos="zoom-in" data-aos-delay="200">
        <img
          src="/images/website/trust-duo.webp"
          loading="lazy"
          alt="Technologist guiding patient through MRI process"
          class="w-full h-auto rounded-3xl shadow-2xl"
        />
      </div>
    </section>

    <!-- Enhanced Trust Badges section -->
    <section class="bg-[#f0f4f9] py-16 px-6">
      <div class="max-w-6xl mx-auto" data-aos="fade-up" data-aos-delay="300">
        <!-- Add credibility header -->
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold text-[#003087] mb-2">
            Backed by Proven Excellence
          </h3>
          <p class="text-[#003087]/70">
            The same quality standards that earned our public company
            acquisition
          </p>
        </div>
        <TrustBadgesBar />
      </div>
    </section>

    <!-- Network Map -->
    <FadeIn effect="fade" delay={100}>
      <section class="bg-white dark:bg-[#0f172a] py-24">
        <div class="max-w-5xl mx-auto px-6 sm:px-12 text-center">
          <div
            class="flex flex-col items-center justify-center sm:flex-row sm:justify-center gap-2 mb-4"
          >
            <p
              class="text-xl sm:text-2xl font-semibold uppercase tracking-wide text-[#cc9933]"
            >
              National Footprint
            </p>
            <span
              class="bg-[#003087] text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wide"
            >
              Initial Launch
            </span>
          </div>

          <div
            class="relative bg-[#fdfaf3] dark:bg-[#1e293b] border border-[#e6c378]/30 rounded-3xl p-8 shadow-2xl"
          >
            <!-- Transparent US Map -->
            <img
              src="/images/usa-transparent.svg"
              alt="US Map"
              loading="lazy"
              class="w-full mx-auto max-w-3xl rounded-xl"
            />

            <!-- Interactive Pin Container -->
            <div class="absolute inset-0">
              <!-- Each pin is wrapped for hover tooltip + scale effect -->
              <div class="group absolute" style="top: 77%; left: 77.5%;">
                <img
                  src="/images/usrad-pin-dark.png"
                  data-aos="fade-up"
                  data-aos-delay="100"
                  class="w-6 sm:w-7 md:w-8 h-auto transition-transform duration-200 group-hover:scale-125"
                />
                <div
                  class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex px-2 py-1 bg-[#003087] text-white text-xs rounded shadow"
                >
                  Florida
                </div>
              </div>
              <div class="group absolute" style="top: 74%; left: 46%;">
                <img
                  src="/images/usrad-pin-dark.png"
