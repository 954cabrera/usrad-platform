---
// index.astro - Optimized version
import CarbonLayout from "../layouts/CarbonLayout.astro";
import NetworkMapPinsCarbon from "../components/NetworkMapPinsCarbon.astro";
import SocialProofBar from "../components/SocialProofBar.astro";
import HowItWorksSection from "../components/HowItWorksSection.astro";
import PricingSection from "../components/PricingSection.astro";
import AboutSection from "../components/AboutSection.astro";
import BlogPreviewSection from "../components/BlogPreviewSection.astro";
import HeroSection from "../components/hero/HeroSection.astro";
import BrowseAllModal from "../components/BrowseAllModal.astro";
import MemberTrustBadge from "../components/trust/MemberTrustBadge.astro";
import AccessProblemSection from "../components/AccessProblemSection.astro";
import WhyLessCostSection from "../components/WhyLessCostSection.astro";
import CredibilitySection from "../components/CredibilitySection.astro";

const REMIX_URL = import.meta.env.PUBLIC_REMIX_URL || "http://localhost:5173";
---

<CarbonLayout
  title="USRad — Transparent Imaging for Employers and Patients"
  isHeroPage={true}
>
  <!-- PROGRESSIVE DISCLOSURE HERO SECTION -->
  <HeroSection remixUrl={REMIX_URL} />

  <!-- Member Trust Badge — inline pill below hero -->
  <div class="flex justify-center py-4 -mt-4 relative z-10">
    <MemberTrustBadge variant="inline" />
  </div>

  <BrowseAllModal />

  <!-- Social Proof Bar -->
  <!-- Contained at release gate 2026-08-13 (PR #7): three of four tiles carry retired or unsourced figures — 150,000+ (D1/#24), $246 Million (§6, named at §500), 4.9★ (#28). Component preserved; resolution belongs to the `/` page-by-page rewrite, §12 row 3. -->
  <!-- <SocialProofBar /> -->

  <!-- Access Problem Section — the "why" before the "how" -->
  <AccessProblemSection />

  <!-- Why Imaging Costs Less Section -->
  <WhyLessCostSection />

  <!-- How It Works Section -->
  <HowItWorksSection />

  <!-- Credibility Section -->
  <!-- Contained 2026-08-14 (Y3): three of four elements fail with no approved replacement available. H2 "Trusted by accredited imaging centers nationwide" and "connects patients with ACR-accredited facilities... across the United States" are rule 26 present-tense network and relationship claims — no provider is contracted. "All partner facilities meet ACR quality standards" asserts partner facilities that do not exist, and the single-body ACR formulation is too narrow on the draft Standard's own terms (§5.2 recognizes four bodies) — #44, blocked on Appendix B open decision 3. "Scans interpreted by licensed, board-certified physicians" is #46, which names this component at ×4. Per #45, copy may be REMOVED on the draft standard's basis but may NOT be APPROVED on it, so no rewrite is available in this pass. The fourth element, "Transparent All-Inclusive Pricing," is sound (D5) but duplicates what PricingSection now states better. B4 precedent: contain the unit rather than preserve a one-tile section. COMPONENT PRESERVED, NOT DELETED — resolution belongs to a future provider-proof/credibility pass once relationship and accreditation facts are supportable. -->
  <!-- <CredibilitySection /> -->

  <!-- Pricing Section -->
  <PricingSection />

  <!-- Member Trust Badge — banner above locations -->
  <div class="max-w-2xl mx-auto px-4 sm:px-6 mb-10">
    <MemberTrustBadge variant="banner" />
  </div>

  <!-- Locations Map Section -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16 animate-on-scroll">
        <p
          class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-3"
        >
          Nationwide Imaging Network
        </p>
        <div class="w-[120px] h-[2px] bg-[#cc9933] mx-auto mb-10"></div>
        <h2
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-gray-900"
        >
          1,500+ locations nationwide
        </h2>
        <p class="text-2xl text-gray-600">
          Find accredited MRI, CT, and ultrasound centers in major cities across
          the United States.
        </p>
        <p class="text-sm text-gray-400 mt-4 tracking-wide">
          Miami &bull; Dallas &bull; Phoenix &bull; Atlanta &bull; Chicago
          &bull; Los Angeles &bull; New York
        </p>
      </div>
    </div>
    <NetworkMapPinsCarbon />
  </section>

  <!-- About Section -->
  <AboutSection />

  <!-- Blog Preview Section -->
  <BlogPreviewSection />
</CarbonLayout>

<style>
  /* CSS-only scroll animations - no JS dependency */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Optional: Use Intersection Observer via CSS if you want scroll-triggered animations */
  @media (prefers-reduced-motion: reduce) {
    .animate-on-scroll {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
