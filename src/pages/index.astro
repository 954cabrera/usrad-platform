---
// index-carbon.astro - Complete working version built from v2
import CarbonLayout from "../layouts/CarbonLayout.astro";
import NetworkMapPinsCarbon from "../components/NetworkMapPinsCarbon.astro";
import AOSInit from "../components/AOSInit.astro";
import SocialProofBar from "../components/SocialProofBar.astro";
import HowItWorksSection from "../components/HowItWorksSection.astro";
import PricingSection from "../components/PricingSection.astro";
import AboutSection from "../components/AboutSection.astro";
import BlogPreviewSection from "../components/BlogPreviewSection.astro";
import HeroSection from "../components/HeroSection.astro";
import BrowseAllModal from "../components/BrowseAllModal.astro";

const REMIX_URL = import.meta.env.PUBLIC_REMIX_URL || "http://localhost:5173";
---

<CarbonLayout title="USRad - MRI Scans in 48 Hours, 70% Less" isHeroPage={true}>
  <meta name="remix-url" content={REMIX_URL} />
  <!-- <AOSInit /> -->

  <!-- PROGRESSIVE DISCLOSURE HERO SECTION -->
  <HeroSection remixUrl={REMIX_URL} />

  <script is:inline src="/js/hero-form-controller.js"></script>

  <BrowseAllModal />

  <!-- Social Proof Bar -->
  <SocialProofBar />

  <!-- How It Works Section -->
  <HowItWorksSection />

  <!-- Pricing Section -->
  <PricingSection />

  <!-- Locations Map Section -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 bg-white" data-aos="fade-up">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-gray-900"
          data-aos="fade-up"
        >
          1,500+ locations nationwide
        </h2>
        <p
          class="text-2xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Quality imaging centers competing for your business
        </p>
      </div>
    </div>
    <NetworkMapPinsCarbon />
  </section>

  <!-- About Section -->
  <AboutSection />

  <!-- NEW: Blog Preview Section -->
  <BlogPreviewSection />
</CarbonLayout>
