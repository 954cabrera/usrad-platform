---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="Invest in USRad - Healthcare's Next Unicorn"
  description="Join us in building the future of accessible healthcare. $100B+ market opportunity with proven leadership."
  ogTitle="USRad"
  ogDescription="USRad is building a transparent imaging network."
>
  <AOSInit />

  <!-- Hero Section with Dynamic Background -->
  <section
    class="relative min-h-[600px] md:min-h-[700px] overflow-hidden bg-gradient-to-br from-gray-900 via-[#003087] to-gray-900"
  >
    <!-- Animated background elements -->
    <div class="absolute inset-0">
      <div
        class="absolute top-0 left-0 w-72 md:w-96 h-72 md:h-96 bg-[#cc9933]/20 rounded-full blur-3xl animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-72 md:w-96 h-72 md:h-96 bg-blue-500/20 rounded-full blur-3xl animate-pulse"
        style="animation-delay: 2s;"
      >
      </div>
    </div>

    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute inset-0"
        style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 1px); background-size: 32px 32px;"
      >
      </div>
    </div>

    <div
      class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32"
    >
      <div class="text-center">
        <!-- Premium badge -->
        <div
          class="inline-flex items-center justify-center px-3 md:px-4 py-1.5 md:py-2 mb-6 md:mb-8 text-xs md:text-sm font-medium text-[#cc9933] bg-white/10 backdrop-blur-sm border border-[#cc9933]/30 rounded-full"
          data-aos="fade-down"
        >
          <span class="animate-pulse mr-2">●</span>
          Series A — Now Open
        </div>

        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-white mb-4 md:mb-6"
          data-aos="fade-up"
        >
          Built Before. Scaled to 1,200 Centers.
          <span
            class="block text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-yellow-300"
          >
            Doing It Again.
          </span>
        </h1>

        <p
          class="text-lg sm:text-xl md:text-2xl text-gray-300 max-w-4xl mx-auto mb-6 md:mb-8 px-4"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Founder of AnciCare (acquired by a public company) is building the
          infrastructure layer for diagnostic imaging — bringing a proven model
          to a $100B+ market serving 90 million underserved Americans.
        </p>

        <div
          class="flex flex-col sm:flex-row gap-4 justify-center px-4"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <button
            onclick="openInvestorModal()"
            class="inline-flex items-center justify-center px-6 md:px-8 py-3 md:py-4 bg-[#cc9933] text-gray-900 font-bold rounded-full hover:bg-yellow-400 transition transform hover:scale-105 text-sm md:text-base cursor-pointer"
          >
            Schedule Investor Briefing
            <svg
              class="ml-2 w-4 md:w-5 h-4 md:h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </button>
        </div>

        <!-- Scarcity / trust line -->
        <p
          class="mt-4 text-sm text-gray-400 tracking-wide"
          data-aos="fade-up"
          data-aos-delay="250"
        >
          Private investor briefings — limited availability
        </p>
      </div>

      <!-- Live metrics -->
      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8 mt-12 md:mt-20"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div class="text-center">
          <div
            class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#cc9933] mb-1 md:mb-2"
          >
            $100B+
          </div>
          <div class="text-sm md:text-base text-gray-400">TAM</div>
        </div>
        <div class="text-center">
          <div
            class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#cc9933] mb-1 md:mb-2"
          >
            90M
          </div>
          <div class="text-sm md:text-base text-gray-400">Target Users</div>
        </div>
        <div class="text-center">
          <div
            class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#cc9933] mb-1 md:mb-2"
          >
            80%
          </div>
          <div class="text-sm md:text-base text-gray-400">Cost Reduction</div>
        </div>
        <div class="text-center">
          <div
            class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#cc9933] mb-1 md:mb-2"
          >
            1000+
          </div>
          <div class="text-sm md:text-base text-gray-400">Partner Centers</div>
        </div>
      </div>
    </div>

    <!-- Animated bottom wave -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg
        viewBox="0 0 1440 120"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none"
        class="w-full h-16 md:h-20"
      >
        <path
          d="M0 120V60C240 20 480 20 720 60C960 100 1200 100 1440 60V120H0Z"
          fill="white"></path>
      </svg>
    </div>
  </section>

  <!-- Founder Section — MOVED ABOVE MARKET (Founder leads the narrative) -->
  <section class="py-20 bg-gradient-to-br from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <!-- Section label -->
      <p
        class="text-sm uppercase tracking-wider text-[#cc9933] mb-4"
        data-aos="fade-up"
      >
        Founder &amp; Track Record
      </p>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <!-- LEFT: EDITORIAL NARRATIVE -->
        <div data-aos="fade-right">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Built by the Founder Who Already Solved This Once
          </h2>

          <!-- Gold divider -->
          <div
            class="w-24 h-[3px] bg-gradient-to-r from-[#cc9933] to-yellow-400 mb-8"
          >
          </div>

          <div class="space-y-6 text-lg text-gray-700 leading-relaxed">
            <p>
              Michael Cabrera is the founder of <span
                class="font-semibold text-gray-900">AnciCare PPO</span
              > — the first national diagnostic imaging network focused on reducing
              costs and improving access.
            </p>
            <p>
              He built the network to over <span
                class="font-semibold text-gray-900">1,200 imaging centers</span
              >, scaled it to <span class="font-semibold text-gray-900"
                >$20M in annual revenue</span
              >, and successfully exited to a public company.
            </p>
            <p class="text-xl font-medium text-gray-900">
              USRad is not a new idea.
            </p>
            <p>
              It is the evolution of that model — rebuilt with modern
              infrastructure to scale nationally and serve a significantly
              larger market.
            </p>
          </div>

          <!-- Strategic positioning block -->
          <div
            class="mt-10 bg-[#003087]/5 border border-[#003087]/10 rounded-xl p-6"
          >
            <p class="text-lg font-medium text-gray-900 leading-relaxed">
              USRad transforms a traditional network into an infrastructure
              layer — one that actively directs patient demand based on
              performance, not relationships.
            </p>
          </div>

          <!-- Quote -->
          <blockquote class="mt-10 border-l-4 border-[#cc9933] pl-6 py-2">
            <p class="text-xl font-medium text-gray-900 italic leading-relaxed">
              "I've seen firsthand how broken the imaging market is — and how
              powerful it becomes when you fix it.
            </p>
            <p class="text-xl font-medium text-gray-900 italic mt-2">
              USRad is the next version of that system, built to scale
              nationally."
            </p>
            <cite
              class="block mt-4 text-sm md:text-base text-gray-600 not-italic"
            >
              — Michael Cabrera, Founder &amp; CEO
            </cite>
          </blockquote>

          <!-- Credibility strip -->
          <div class="flex flex-wrap gap-6 mt-6 text-sm text-gray-500">
            <span>30+ Years in Healthcare</span>
            <span>·</span>
            <span>Built First National Imaging Network</span>
            <span>·</span>
            <span>Successful Exit to Public Company</span>
          </div>
        </div>

        <!-- RIGHT: PROOF PANEL -->
        <div class="space-y-6" data-aos="fade-left">
          <!-- Metrics Card -->
          <div
            class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100"
          >
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              Proven Track Record
            </h3>
            <div class="grid grid-cols-2 gap-6">
              <div>
                <div class="text-3xl font-bold text-[#003087]">$20M+</div>
                <div class="text-sm text-gray-600 mt-1">Revenue Built</div>
              </div>
              <div>
                <div class="text-3xl font-bold text-[#003087]">1,200+</div>
                <div class="text-sm text-gray-600 mt-1">Centers Networked</div>
              </div>
              <div>
                <div class="text-3xl font-bold text-[#003087]">3,000+</div>
                <div class="text-sm text-gray-600 mt-1">Radiologists</div>
              </div>
              <div>
                <div class="text-3xl font-bold text-[#003087]">Exit</div>
                <div class="text-sm text-gray-600 mt-1">
                  Public Company Acquisition
                </div>
              </div>
            </div>
          </div>

          <!-- Why This Matters card -->
          <div class="bg-gray-900 text-white rounded-2xl p-6">
            <h4 class="text-lg font-semibold mb-4">Why This Matters</h4>
            <ul class="space-y-3 text-gray-300 text-sm leading-relaxed">
              <li>
                · First national imaging network built and scaled from zero
              </li>
              <li>· Deep provider relationships across major markets</li>
              <li>· Proven ability to execute, grow, and exit</li>
              <li>
                · Rebuilding the model with modern infrastructure at 10× scale
              </li>
            </ul>
          </div>

          <!-- Platform screenshot -->
          <div
            class="relative rounded-2xl overflow-hidden shadow-xl border border-gray-100"
          >
            <div class="bg-gray-900 rounded-t-lg p-2">
              <div class="flex items-center gap-2 px-2">
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-red-500"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                  <div class="w-3 h-3 rounded-full bg-green-500"></div>
                </div>
                <div class="flex-1 flex justify-center">
                  <div
                    class="bg-gray-800 rounded px-4 py-1 text-xs text-gray-400"
                  >
                    app.usrad.com
                  </div>
                </div>
              </div>
            </div>
            <img
              src="/images/usrad-platform-dashboard.png"
              alt="USRad Platform Dashboard showing real-time appointment management"
              class="w-full h-auto"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Market Opportunity -->
  <section class="py-12 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 md:mb-16">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-3 md:mb-4"
          data-aos="fade-up"
        >
          The Market Is Massive. And Overlooked.
        </h2>
        <p
          class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto px-4"
          data-aos="fade-up"
          data-aos-delay="50"
        >
          Traditional healthcare has failed 90 million Americans. We're building
          the solution.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        <div
          class="bg-gradient-to-br from-gray-50 to-white p-6 md:p-8 rounded-2xl border border-gray-100 hover:shadow-xl transition-all duration-300"
          data-aos="fade-up"
        >
          <div
            class="w-12 md:w-16 h-12 md:h-16 bg-gradient-to-br from-[#003087] to-blue-600 rounded-xl flex items-center justify-center mb-4 md:mb-6"
          >
            <svg
              class="w-6 md:w-8 h-6 md:h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">
            90M+
          </h3>
          <p class="text-base md:text-lg font-semibold text-gray-900 mb-2">
            Underserved Americans
          </p>
          <p class="text-sm md:text-base text-gray-600">
            Uninsured and underinsured patients forced to delay or skip
            necessary imaging
          </p>
        </div>

        <div
          class="bg-gradient-to-br from-gray-50 to-white p-6 md:p-8 rounded-2xl border border-gray-100 hover:shadow-xl transition-all duration-300"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div
            class="w-12 md:w-16 h-12 md:h-16 bg-gradient-to-br from-[#cc9933] to-yellow-500 rounded-xl flex items-center justify-center mb-4 md:mb-6"
          >
            <svg
              class="w-6 md:w-8 h-6 md:h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">
            $100B+
          </h3>
          <p class="text-base md:text-lg font-semibold text-gray-900 mb-2">
            Annual Market Spend
          </p>
          <p class="text-sm md:text-base text-gray-600">
            Medical imaging market with massive inefficiencies and price opacity
          </p>
        </div>

        <div
          class="bg-gradient-to-br from-gray-50 to-white p-6 md:p-8 rounded-2xl border border-gray-100 hover:shadow-xl transition-all duration-300 sm:col-span-2 lg:col-span-1"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div
            class="w-12 md:w-16 h-12 md:h-16 bg-gradient-to-br from-green-600 to-green-700 rounded-xl flex items-center justify-center mb-4 md:mb-6"
          >
            <svg
              class="w-6 md:w-8 h-6 md:h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
          <h3 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">
            30-80%
          </h3>
          <p class="text-base md:text-lg font-semibold text-gray-900 mb-2">
            Cost Savings
          </p>
          <p class="text-sm md:text-base text-gray-600">
            Typical patient savings versus hospital pricing through our network
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform Mechanics -->
  <section class="py-12 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 md:mb-16">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-3 md:mb-4"
          data-aos="fade-up"
        >
          How USRad Creates Value
        </h2>
        <p
          class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="50"
        >
          Four structural advantages that compound with scale
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        <div class="group" data-aos="fade-up">
          <div
            class="bg-gradient-to-br from-blue-50 to-white p-6 md:p-8 rounded-2xl border border-blue-100 h-full hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="w-12 md:w-14 h-12 md:h-14 bg-gradient-to-br from-[#003087] to-blue-600 rounded-xl flex items-center justify-center mb-4 md:mb-6 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-6 md:w-7 h-6 md:h-7 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <h3
              class="text-lg md:text-xl font-semibold text-gray-900 mb-2 md:mb-3"
            >
              Supply Aggregation at Scale
            </h3>
            <p class="text-sm md:text-base text-gray-600">
              ACR-accredited facilities recruited and credentialed into a
              proprietary network — supply that competitors cannot quickly
              replicate
            </p>
          </div>
        </div>

        <div class="group" data-aos="fade-up" data-aos-delay="100">
          <div
            class="bg-gradient-to-br from-yellow-50 to-white p-6 md:p-8 rounded-2xl border border-yellow-100 h-full hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="w-12 md:w-14 h-12 md:h-14 bg-gradient-to-br from-[#cc9933] to-yellow-500 rounded-xl flex items-center justify-center mb-4 md:mb-6 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-6 md:w-7 h-6 md:h-7 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <h3
              class="text-lg md:text-xl font-semibold text-gray-900 mb-2 md:mb-3"
            >
              Price Compression Engine
            </h3>
            <p class="text-sm md:text-base text-gray-600">
              Flat-rate upfront pricing drives systematic cost reduction across
              markets — creating a price benchmark competitors are measured
              against
            </p>
          </div>
        </div>

        <div class="group" data-aos="fade-up" data-aos-delay="200">
          <div
            class="bg-gradient-to-br from-purple-50 to-white p-6 md:p-8 rounded-2xl border border-purple-100 h-full hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="w-12 md:w-14 h-12 md:h-14 bg-gradient-to-br from-purple-600 to-purple-700 rounded-xl flex items-center justify-center mb-4 md:mb-6 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-6 md:w-7 h-6 md:h-7 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <h3
              class="text-lg md:text-xl font-semibold text-gray-900 mb-2 md:mb-3"
            >
              Quality Standardization Layer
            </h3>
            <p class="text-sm md:text-base text-gray-600">
              Subspecialized board-certified radiologists across all network
              centers establish a quality floor that protects the platform's
              reliability signal
            </p>
          </div>
        </div>

        <div class="group" data-aos="fade-up" data-aos-delay="300">
          <div
            class="bg-gradient-to-br from-green-50 to-white p-6 md:p-8 rounded-2xl border border-green-100 h-full hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="w-12 md:w-14 h-12 md:h-14 bg-gradient-to-br from-green-600 to-green-700 rounded-xl flex items-center justify-center mb-4 md:mb-6 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-6 md:w-7 h-6 md:h-7 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3
              class="text-lg md:text-xl font-semibold text-gray-900 mb-2 md:mb-3"
            >
              Automated Demand Routing
            </h3>
            <p class="text-sm md:text-base text-gray-600">
              Patient demand is systematically matched and routed to network
              providers — creating a scalable allocation engine that improves
              with volume
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Revenue Model -->
  <section
    class="py-12 md:py-20 bg-gradient-to-r from-[#003087] to-blue-700 text-white"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 md:mb-16">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl font-bold mb-3 md:mb-4"
          data-aos="fade-up"
        >
