---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="The USRad Investment Thesis"
  description="Explore USRad's model, strategy, infrastructure and growth thesis."
  hideNewsletter={true}
>
  <AOSInit />

  <!-- Hero Section with Dynamic Background -->
  <section
    class="relative min-h-[600px] md:min-h-[700px] overflow-hidden bg-gradient-to-br from-gray-900 via-[#003087] to-gray-900"
  >
    <!-- Animated background elements -->
    <div class="absolute inset-0">
      <div
        class="absolute top-0 left-0 w-72 md:w-96 h-72 md:h-96 bg-[#cc9933]/20 rounded-full blur-3xl animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-72 md:w-96 h-72 md:h-96 bg-blue-500/20 rounded-full blur-3xl animate-pulse"
        style="animation-delay: 2s;"
      >
      </div>
    </div>

    <!-- Grid pattern overlay -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute inset-0"
        style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 1px); background-size: 32px 32px;"
      >
      </div>
    </div>

    <div
      class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32"
    >
      <div class="text-center">
        <!-- Premium badge -->
        <div
          class="inline-flex items-center justify-center px-3 md:px-4 py-1.5 md:py-2 mb-6 md:mb-8 text-xs md:text-sm font-medium text-[#cc9933] bg-white/10 backdrop-blur-sm border border-[#cc9933]/30 rounded-full"
          data-aos="fade-down"
        >
          <span class="animate-pulse mr-2">●</span>
          THE USRAD INVESTMENT THESIS
        </div>

        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-white mb-4 md:mb-6"
          data-aos="fade-up"
        >
          Built Before. AnciCare Reached 1,200+ Centers by 2002.
          <span
            class="block text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-yellow-300"
          >
            Building Again.
          </span>
        </h1>

        <p
          class="text-lg sm:text-xl md:text-2xl text-gray-300 max-w-4xl mx-auto mb-6 md:mb-8 px-4"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          A co-founder of AnciCare PPO — acquired by CorVel Corporation (NASDAQ:
          CRVL) in May 2002 — is building the infrastructure layer for
          diagnostic imaging, applying that experience to a new model for
          self-funded employers and the patients they cover.
        </p>

        <div
          class="flex flex-col sm:flex-row gap-4 justify-center px-4"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <button
            onclick="openInvestorModal()"
            class="inline-flex items-center justify-center px-6 md:px-8 py-3 md:py-4 bg-[#cc9933] text-gray-900 font-bold rounded-full hover:bg-yellow-400 transition transform hover:scale-105 text-sm md:text-base cursor-pointer"
          >
            Connect With the Founder
            <svg
              class="ml-2 w-4 md:w-5 h-4 md:h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </button>
        </div>

        <!-- Founder conversation line -->
        <p
          class="mt-4 text-sm text-gray-400 tracking-wide"
          data-aos="fade-up"
          data-aos-delay="250"
        >
          Founder-led conversations about USRad's strategy and growth.
        </p>
      </div>

      <!-- Live metrics -->
      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8 mt-12 md:mt-20"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div class="text-center">
          <div
            class="text-xl sm:text-2xl font-bold text-[#cc9933] mb-1 md:mb-2"
          >
            Self-Funded Employers
          </div>
          <div class="text-sm md:text-base text-gray-400">
            Primary demand channel
          </div>
        </div>
        <div class="text-center">
          <div
            class="text-xl sm:text-2xl font-bold text-[#cc9933] mb-1 md:mb-2"
          >
            Uninsured &amp; Underinsured
          </div>
          <div class="text-sm md:text-base text-gray-400">
            Direct access to imaging
          </div>
        </div>
        <div class="text-center">
          <div
            class="text-xl sm:text-2xl font-bold text-[#cc9933] mb-1 md:mb-2"
          >
            Transparent Pricing
          </div>
          <div class="text-sm md:text-base text-gray-400">
            Contracted rates, published upfront
          </div>
        </div>
        <div class="text-center">
          <div
            class="text-xl sm:text-2xl font-bold text-[#cc9933] mb-1 md:mb-2"
          >
            Provider Network
          </div>
          <div class="text-sm md:text-base text-gray-400">
            Recruitment and contracting underway
          </div>
        </div>
      </div>
    </div>

    <!-- Animated bottom wave -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg
        viewBox="0 0 1440 120"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none"
        class="w-full h-16 md:h-20"
      >
        <path
          d="M0 120V60C240 20 480 20 720 60C960 100 1200 100 1440 60V120H0Z"
          fill="white"></path>
      </svg>
    </div>
  </section>

  <!-- Founder Section — MOVED ABOVE MARKET (Founder leads the narrative) -->
  <section class="py-20 bg-gradient-to-br from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <!-- Section label -->
      <p
        class="text-sm uppercase tracking-wider text-[#cc9933] mb-4"
        data-aos="fade-up"
      >
        Founder &amp; Track Record
      </p>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <!-- LEFT: EDITORIAL NARRATIVE -->
        <div data-aos="fade-right">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Built by the Founder Who Already Solved This Once
          </h2>

          <!-- Gold divider -->
          <div
            class="w-24 h-[3px] bg-gradient-to-r from-[#cc9933] to-yellow-400 mb-8"
          >
          </div>

          <div class="space-y-6 text-lg text-gray-700 leading-relaxed">
            <p>
              Michael Cabrera is a co-founder of <span
                class="font-semibold text-gray-900">AnciCare PPO</span
              > — a managed-care imaging carve-out for workers' compensation. USRad
              is being built for self-funded group health plans and people paying
              directly for their own imaging.
            </p>
            <p>
              He built the network to over <span
                class="font-semibold text-gray-900">1,200 imaging centers</span
              > by 2002 and <span class="font-semibold text-gray-900"
                >more than $16 million in annual revenue by 2001</span
              >, and it was acquired by CorVel Corporation (NASDAQ: CRVL) in May
              2002.
            </p>
            <p class="text-xl font-medium text-gray-900">
              USRad is not a new idea.
            </p>
            <p>
              It is the evolution of that model — rebuilt with modern
              infrastructure to scale nationally and serve a significantly
              larger market.
            </p>
          </div>

          <!-- Strategic positioning block -->
          <div
            class="mt-10 bg-[#003087]/5 border border-[#003087]/10 rounded-xl p-6"
          >
            <p class="text-lg font-medium text-gray-900 leading-relaxed">
              USRad is designed to transform a traditional network into an
              infrastructure layer — one that directs patient demand based on
              performance, not relationships.
            </p>
          </div>

          <!-- Quote -->
          <blockquote class="mt-10 border-l-4 border-[#cc9933] pl-6 py-2">
            <p class="text-xl font-medium text-gray-900 italic leading-relaxed">
              "I've seen firsthand how broken the imaging market is — and how
              powerful it becomes when you fix it.
            </p>
            <p class="text-xl font-medium text-gray-900 italic mt-2">
              USRad is the next version of that system, built to scale
              nationally."
            </p>
            <cite
              class="block mt-4 text-sm md:text-base text-gray-600 not-italic"
            >
              — Michael Cabrera, Founder &amp; CEO
            </cite>
          </blockquote>

          <!-- Credibility strip -->
          <div class="flex flex-wrap gap-6 mt-6 text-sm text-gray-500">
            <span>Built AnciCare PPO's National Imaging Network</span>
            <span>·</span>
            <span>Acquired by CorVel Corporation, May 2002</span>
          </div>
        </div>

        <!-- RIGHT: PROOF PANEL -->
        <div class="space-y-6" data-aos="fade-left">
          <!-- Metrics Card -->
          <div
            class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100"
          >
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              AnciCare Track Record
            </h3>
            <div class="grid grid-cols-2 gap-6">
              <div>
                <div class="text-3xl font-bold text-[#003087]">$16M+</div>
                <div class="text-sm text-gray-600 mt-1">
                  Annual Revenue by 2001
                </div>
              </div>
              <div>
                <div class="text-3xl font-bold text-[#003087]">1,200+</div>
                <div class="text-sm text-gray-600 mt-1">
                  AnciCare Centers by 2002
                </div>
              </div>
              <div>
                <div class="text-3xl font-bold text-[#003087]">1,020</div>
                <div class="text-sm text-gray-600 mt-1">
                  Radiologists Across 23 States, 1999
                </div>
              </div>
              <div>
                <div class="text-3xl font-bold text-[#003087]">May 2002</div>
                <div class="text-sm text-gray-600 mt-1">
                  Acquired by CorVel (NASDAQ: CRVL)
                </div>
              </div>
            </div>
          </div>

          <!-- Why This Matters card -->
          <div class="bg-gray-900 text-white rounded-2xl p-6">
            <h4 class="text-lg font-semibold mb-4">Why This Matters</h4>
            <ul class="space-y-3 text-gray-300 text-sm leading-relaxed">
              <li>· A national imaging network built and scaled from zero</li>
              <li>
                · Deep provider relationships built across major markets at
                AnciCare
              </li>
              <li>· Built, scaled and exited a national imaging network</li>
              <li>· Rebuilding the model with modern infrastructure</li>
            </ul>
          </div>

          <!-- Platform screenshot -->
          <div
            class="relative rounded-2xl overflow-hidden shadow-xl border border-gray-100"
          >
            <div class="bg-gray-900 rounded-t-lg p-2">
              <div class="flex items-center gap-2 px-2">
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-red-500"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                  <div class="w-3 h-3 rounded-full bg-green-500"></div>
                </div>
                <div class="flex-1 flex justify-center">
                  <div
                    class="bg-gray-800 rounded px-4 py-1 text-xs text-gray-400"
                  >
                    app.usrad.com
                  </div>
                </div>
              </div>
            </div>
            <img
              src="/images/usrad-platform-dashboard.png"
              alt="USRad provider portal appointments view, demonstration data"
              class="w-full h-auto"
            />
            <p
              class="px-4 py-3 text-xs text-gray-600 bg-white border-t border-gray-100"
            >
              USRad provider portal · demonstration data
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform State — infrastructure already developed -->
  <section
    class="py-12 md:py-20 bg-gradient-to-b from-[#fcfaf5] via-[#fbf8f1] to-white"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 md:mb-14">
        <p
          class="text-sm uppercase tracking-wider text-[#cc9933] mb-4"
          data-aos="fade-up"
        >
          BUILT FOR THE NEXT STAGE
        </p>
        <h2
          class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-3 md:mb-4"
          data-aos="fade-up"
          data-aos-delay="50"
        >
          Much of the Infrastructure Is Already Built.
        </h2>
        <p
          class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="75"
        >
          USRad is beyond the concept stage. Core infrastructure has already
          been developed across the member, provider and internal operating
          sides of the platform.
        </p>
      </div>

      <!-- Architecture: three developed sides resting on a shared foundation -->
      <div
        class="rounded-2xl border border-[#003087]/10 bg-white shadow-sm overflow-hidden"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <div class="grid md:grid-cols-3">
          <div
            class="p-6 md:p-8 border-b md:border-b-0 md:border-r border-[#003087]/10"
          >
            <p
              class="text-xs uppercase tracking-[0.14em] text-[#cc9933] font-semibold mb-3"
            >
              MEMBER
            </p>
            <h3 class="text-lg md:text-xl font-semibold text-[#003087] mb-2">
              Booking &amp; Portal
            </h3>
            <p class="text-sm md:text-base text-gray-600 leading-relaxed">
              Imaging search and booking infrastructure, payment collection and
              authenticated member access have been developed.
            </p>
          </div>

          <div
            class="p-6 md:p-8 border-b md:border-b-0 md:border-r border-[#003087]/10"
          >
            <p
              class="text-xs uppercase tracking-[0.14em] text-[#cc9933] font-semibold mb-3"
            >
              PROVIDER
            </p>
            <h3 class="text-lg md:text-xl font-semibold text-[#003087] mb-2">
              Onboarding &amp; Portal
            </h3>
            <p class="text-sm md:text-base text-gray-600 leading-relaxed">
              Provider onboarding and portal infrastructure have been developed
              to support contracting and network participation.
            </p>
          </div>

          <div class="p-6 md:p-8">
            <p
              class="text-xs uppercase tracking-[0.14em] text-[#cc9933] font-semibold mb-3"
            >
              INTERNAL
            </p>
            <h3 class="text-lg md:text-xl font-semibold text-[#003087] mb-2">
              Administration
            </h3>
            <p class="text-sm md:text-base text-gray-600 leading-relaxed">
              An internal administration and operations portal has been
              developed for USRad staff.
            </p>
          </div>
        </div>

        <!-- Foundation layer the three sides rest on -->
        <div
          class="border-t-2 border-[#003087]/15 bg-[#003087]/[0.04] p-6 md:p-8"
        >
          <p
            class="text-xs uppercase tracking-[0.14em] text-[#cc9933] font-semibold mb-3"
          >
            FOUNDATION
          </p>
          <div class="md:flex md:items-baseline md:gap-8">
            <h3
              class="text-lg md:text-xl font-semibold text-[#003087] mb-2 md:mb-0 md:w-1/3 md:flex-shrink-0"
            >
              Reference Pricing &amp; Provider Ranking
            </h3>
            <p class="text-sm md:text-base text-gray-600 leading-relaxed">
              Reference-pricing and provider-ranking infrastructure has been
              developed to support provider selection as contracted network
              supply comes online.
            </p>
          </div>
        </div>
      </div>

      <!-- Development-state progression -->
      <div
        class="mt-8 md:mt-10 rounded-2xl border border-gray-200 bg-white/70 overflow-hidden"
        data-aos="fade-up"
        data-aos-delay="150"
      >
        <div class="p-6 md:p-8 border-b border-gray-200">
          <div class="sm:flex sm:gap-6">
            <div class="sm:w-40 sm:flex-shrink-0 mb-3 sm:mb-0">
              <span
                class="inline-block px-3 py-1 rounded-full bg-[#003087] text-white text-xs font-semibold uppercase tracking-[0.12em]"
              >
                DEVELOPED
              </span>
            </div>
            <div>
              <h3 class="text-base md:text-lg font-semibold text-gray-900 mb-1">
                Platform Infrastructure
              </h3>
              <p class="text-sm md:text-base text-gray-600 leading-relaxed">
                Member booking and portal, provider onboarding and portal,
                internal administration, reference pricing and provider ranking.
              </p>
            </div>
          </div>
        </div>

        <div class="p-6 md:p-8 border-b border-gray-200">
          <div class="sm:flex sm:gap-6">
            <div class="sm:w-40 sm:flex-shrink-0 mb-3 sm:mb-0">
              <span
                class="inline-block px-3 py-1 rounded-full border border-[#cc9933] bg-[#cc9933]/10 text-[#8a6a1f] text-xs font-semibold uppercase tracking-[0.12em]"
              >
                UNDERWAY
              </span>
            </div>
            <div>
              <h3 class="text-base md:text-lg font-semibold text-gray-900 mb-1">
                Commercialization
              </h3>
              <p class="text-sm md:text-base text-gray-600 leading-relaxed">
                Provider recruitment and contracting, alongside development of
                the self-funded employer channel.
              </p>
            </div>
          </div>
        </div>

        <div class="p-6 md:p-8">
          <div class="sm:flex sm:gap-6">
            <div class="sm:w-40 sm:flex-shrink-0 mb-3 sm:mb-0">
              <span
                class="inline-block px-3 py-1 rounded-full border border-dashed border-gray-400 bg-white text-gray-500 text-xs font-semibold uppercase tracking-[0.12em]"
              >
                PLANNED
              </span>
            </div>
            <div>
              <h3 class="text-base md:text-lg font-semibold text-gray-900 mb-1">
                Employer Infrastructure
              </h3>
              <p class="text-sm md:text-base text-gray-600 leading-relaxed">
                A dedicated employer portal has not been built. It is planned as
                a future development layer for self-funded employer clients.
              </p>
            </div>
          </div>
        </div>

        <div class="px-6 md:px-8 py-5 md:py-6 bg-gray-50 border-t border-gray-200">
          <p class="text-sm md:text-base text-gray-700 leading-relaxed">
            The next stage is commercialization and scale against infrastructure
            that has already been developed, rather than building the business
            from concept stage.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Market Opportunity -->
  <section class="py-12 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 md:mb-16">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-3 md:mb-4"
          data-aos="fade-up"
        >
          The Market Is Massive. And Overlooked.
        </h2>
        <p
          class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto px-4"
          data-aos="fade-up"
          data-aos-delay="50"
        >
          Employers and patients still face a fragmented imaging market with
          wide price variation and limited transparency. USRad is being built to
          address that gap.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        <div
          class="bg-gradient-to-br from-gray-50 to-white p-6 md:p-8 rounded-2xl border border-gray-100 hover:shadow-xl transition-all duration-300"
          data-aos="fade-up"
        >
          <div
            class="w-12 md:w-16 h-12 md:h-16 bg-gradient-to-br from-[#003087] to-blue-600 rounded-xl flex items-center justify-center mb-4 md:mb-6"
          >
            <svg
              class="w-6 md:w-8 h-6 md:h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
            Self-Funded Employers
          </h3>
          <p class="text-sm md:text-base text-gray-600">
            Employers paying directly for imaging face wide price variation with
            limited visibility into what they are buying
          </p>
        </div>

        <div
          class="bg-gradient-to-br from-gray-50 to-white p-6 md:p-8 rounded-2xl border border-gray-100 hover:shadow-xl transition-all duration-300"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div
            class="w-12 md:w-16 h-12 md:h-16 bg-gradient-to-br from-[#cc9933] to-yellow-500 rounded-xl flex items-center justify-center mb-4 md:mb-6"
          >
            <svg
              class="w-6 md:w-8 h-6 md:h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
            Underserved Patients
          </h3>
          <p class="text-sm md:text-base text-gray-600">
            Uninsured and underinsured patients delay or skip necessary imaging
            on cost
          </p>
        </div>

        <div
          class="bg-gradient-to-br from-gray-50 to-white p-6 md:p-8 rounded-2xl border border-gray-100 hover:shadow-xl transition-all duration-300 sm:col-span-2 lg:col-span-1"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div
            class="w-12 md:w-16 h-12 md:h-16 bg-gradient-to-br from-green-600 to-green-700 rounded-xl flex items-center justify-center mb-4 md:mb-6"
          >
            <svg
              class="w-6 md:w-8 h-6 md:h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
          <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">
            Transparent Contracted Pricing
          </h3>
          <p class="text-sm md:text-base text-gray-600">
            Designed to reduce imaging costs relative to hospital-based care.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform Mechanics -->
