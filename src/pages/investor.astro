    class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden z-[9999] flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Schedule Investor Briefing"
  >
    <div
      class="bg-white rounded-2xl w-full max-w-3xl max-h-[90vh] overflow-hidden shadow-2xl flex flex-col"
    >
      <!-- Modal header -->
