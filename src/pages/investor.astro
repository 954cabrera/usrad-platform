        <div id="cal-embed-container" class="w-full min-h-[500px]"></div>
      </div>
    </div>
  </div>

  <script is:inline>
    // ── Cal.com lazy loader ─────────────────────────────────────────────
    let calLoaded = false;

    function loadCal() {
      if (calLoaded) return;
      calLoaded = true;

      (function (C, A, L) {
        let p = function (a, ar) {
          a.q.push(ar);
        };
        let d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement("script")).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === "string") {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ["initNamespace", namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
      })(window, "https://app.cal.com/embed/embed.js", "init");

      Cal("init", "investor-briefing", { origin: "https://cal.com" });

      Cal.ns["investor-briefing"]("inline", {
        elementOrSelector: "#cal-embed-container",
        config: { layout: "month_view", theme: "light" },
        calLink: "usrad/investor-briefing",
      });

      Cal.ns["investor-briefing"]("ui", {
        styles: { branding: { brandColor: "#003087" } },
        hideEventTypeDetails: false,
        layout: "month_view",
      });
    }

    // ── Modal open / close ──────────────────────────────────────────────
    function openInvestorModal() {
      const modal = document.getElementById("investor-cal-modal");
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden"; // prevent background scroll
      loadCal(); // lazy — only fires on first open
    }

    function closeInvestorModal() {
      document.getElementById("investor-cal-modal").classList.add("hidden");
      document.body.style.overflow = "";
    }

    // Close button
    document
      .getElementById("close-investor-modal")
      .addEventListener("click", closeInvestorModal);

    // Click outside modal to close
    document
      .getElementById("investor-cal-modal")
      .addEventListener("click", function (e) {
        if (e.target === this) closeInvestorModal();
      });

    // Escape key to close
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeInvestorModal();
    });
  </script>
