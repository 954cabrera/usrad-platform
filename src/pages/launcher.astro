<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>USRad Dashboard Launcher</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Manrope", sans-serif;
      }
      .usrad-navy {
        color: #003087;
      }
      .usrad-gold {
        color: #cc9933;
      }
      .bg-usrad-navy {
        background-color: #003087;
      }
      .bg-usrad-gold {
        background-color: #cc9933;
      }

      .dashboard-card {
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }

      .dashboard-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      }

      .dashboard-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.1),
          transparent
        );
        transition: left 0.5s;
      }

      .dashboard-card:hover::before {
        left: 100%;
      }

      @keyframes float {
        0%,
        100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-10px);
        }
      }

      .animate-float {
        animation: float 6s ease-in-out infinite;
      }

      .gradient-bg {
        background: linear-gradient(135deg, #f5f9ff 0%, #ffffff 100%);
      }
    </style>
  </head>
  <body class="gradient-bg min-h-screen">
    <div class="container mx-auto px-6 py-12">
      <!-- Header -->
      <div class="text-center mb-12">
        <div class="flex items-center justify-center mb-6">
          <img
            src="/logo/usrad-logo.png"
            alt="USRad Logo"
            class="w-16 h-16 rounded-xl animate-float mr-4"
          />
          <div>
            <h1 class="text-4xl font-bold usrad-navy">
              USRad Dashboard Launcher
            </h1>
            <p class="text-gray-600 mt-2">
              Select the dashboard you want to access
            </p>
          </div>
        </div>
      </div>

      <!-- Dashboard Grid -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-7xl mx-auto"
      >
        <!-- Corporate Dashboard -->
        <div
          class="dashboard-card bg-white rounded-2xl shadow-lg border border-gray-200 p-6 text-center hover:border-blue-300"
        >
          <div
            class="w-14 h-14 bg-gradient-to-br from-blue-600 to-blue-800 rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">🏢</span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">
            Corporate Dashboard
          </h3>
          <p class="text-gray-600 text-xs mb-4">
            Executive and corporate-level insights
          </p>
          <a
            href="/corporate-dashboard"
            class="block w-full bg-blue-600 text-white py-2 px-4 rounded-lg text-sm font-semibold hover:bg-blue-700 transition-colors"
          >
            Access Dashboard
          </a>
        </div>

        <!-- Provider Dashboard -->
        <div
          class="dashboard-card bg-white rounded-2xl shadow-lg border border-gray-200 p-6 text-center hover:border-blue-300"
        >
          <div
            class="w-14 h-14 bg-usrad-navy rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">🏥</span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">
            Provider Dashboard
          </h3>
          <p class="text-gray-600 text-xs mb-4">
            Imaging center operations & PSA
          </p>
          <a
            href="/dashboard"
            class="block w-full bg-usrad-navy text-white py-2 px-4 rounded-lg text-sm font-semibold hover:bg-blue-900 transition-colors"
          >
            Access Dashboard
          </a>
        </div>

        <!-- Patient Advocate -->
        <div
          class="dashboard-card bg-white rounded-2xl shadow-lg border border-gray-200 p-6 text-center hover:border-emerald-300"
        >
          <div
            class="w-14 h-14 bg-gradient-to-br from-emerald-600 to-emerald-800 rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">🎧</span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Patient Advocate</h3>
          <p class="text-gray-600 text-xs mb-4">
            Customer service & patient support
          </p>
          <a
            href="/patient-advocate"
            class="block w-full bg-emerald-600 text-white py-2 px-4 rounded-lg text-sm font-semibold hover:bg-emerald-700 transition-colors"
          >
            Access Dashboard
          </a>
        </div>

        <!-- Patient Management -->
        <div
          class="dashboard-card bg-white rounded-2xl shadow-lg border border-gray-200 p-6 text-center hover:border-blue-300"
        >
          <div
            class="w-14 h-14 bg-gradient-to-br from-blue-600 to-blue-800 rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">📊</span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">
            Patient Management
          </h3>
          <p class="text-gray-600 text-xs mb-4">
            Analytics & administrative tools
          </p>
          <a
            href="/patient-management"
            class="block w-full bg-blue-600 text-white py-2 px-4 rounded-lg text-sm font-semibold hover:bg-blue-700 transition-colors"
          >
            Access Dashboard
          </a>
        </div>

        <!-- Admin/Medicare -->
        <div
          class="dashboard-card bg-white rounded-2xl shadow-lg border border-gray-200 p-6 text-center hover:border-red-300"
        >
          <div
            class="w-14 h-14 bg-gradient-to-br from-red-600 to-red-800 rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">🏛️</span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Admin/Medicare</h3>
          <p class="text-gray-600 text-xs mb-4">
            Administrative & Medicare management
          </p>
          <a
            href="/admin/medicare"
            class="block w-full bg-red-600 text-white py-2 px-4 rounded-lg text-sm font-semibold hover:bg-red-700 transition-colors"
          >
            Access Dashboard
          </a>
        </div>

        <!-- Patient Dashboard -->
        <div
          class="dashboard-card bg-white rounded-2xl shadow-lg border border-gray-200 p-6 text-center hover:border-purple-300"
        >
          <div
            class="w-14 h-14 bg-gradient-to-br from-purple-600 to-purple-800 rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">👤</span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">
            Patient Dashboard
          </h3>
          <p class="text-gray-600 text-xs mb-4">
            Patient portal & appointment system
          </p>
          <a
            href="/patient-dashboard"
            class="block w-full bg-purple-600 text-white py-2 px-4 rounded-lg text-sm font-semibold hover:bg-purple-700 transition-colors"
          >
            Access Dashboard
          </a>
        </div>

        <!-- Investor Dashboard -->
        <div
          class="dashboard-card bg-white rounded-2xl shadow-lg border border-gray-200 p-6 text-center hover:border-green-300"
        >
          <div
            class="w-14 h-14 bg-gradient-to-br from-green-600 to-green-800 rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">💼</span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Investor Portal</h3>
          <p class="text-gray-600 text-xs mb-4">
            Financial metrics & investor relations
          </p>
          <a
            href="/investor"
            class="block w-full bg-green-600 text-white py-2 px-4 rounded-lg text-sm font-semibold hover:bg-green-700 transition-colors"
          >
            Access Dashboard
          </a>
        </div>

        <!-- USRad Presentation -->
        <div
          class="dashboard-card bg-white rounded-2xl shadow-lg border border-gray-200 p-6 text-center hover:border-yellow-300"
        >
          <div
            class="w-14 h-14 bg-gradient-to-br from-yellow-600 to-yellow-800 rounded-xl flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-2xl">📽️</span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Presentation</h3>
          <p class="text-gray-600 text-xs mb-4">USRad company presentation</p>
          <a
            href="/usrad-presentation.html"
            class="block w-full bg-yellow-600 text-white py-2 px-4 rounded-lg text-sm font-semibold hover:bg-yellow-700 transition-colors"
          >
            View Presentation
          </a>
        </div>
      </div>

      <!-- Additional Info -->
      <div class="text-center mt-12">
        <div
          class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 max-w-2xl mx-auto"
        >
          <h4 class="font-semibold text-gray-900 mb-2">Quick Access Tips</h4>
          <p class="text-gray-600 text-sm">
            Bookmark this page for easy access to all USRad dashboards. Each
            dashboard is optimized for different user roles and workflows.
          </p>
          <div
            class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-4 text-xs text-gray-500"
          >
            <div><strong>8</strong> Active Dashboards</div>
            <div><strong>4</strong> User Types</div>
            <div><strong>Dev</strong> Environment</div>
            <div><strong>v1.0</strong> Current</div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Add some nice hover effects
      document.querySelectorAll(".dashboard-card").forEach((card) => {
        card.addEventListener("mouseenter", () => {
          card.style.transform = "translateY(-8px) scale(1.02)";
        });

        card.addEventListener("mouseleave", () => {
          card.style.transform = "translateY(0) scale(1)";
        });
      });

      // Add click analytics (you can extend this)
      document.querySelectorAll('a[href^="/"]').forEach((link) => {
        link.addEventListener("click", (e) => {
          const dashboard = e.target.closest(".dashboard-card");
          const dashboardName = dashboard.querySelector("h3").textContent;
          console.log(`Accessing: ${dashboardName}`);
          // You could send analytics here
        });
      });
    </script>
  </body>
</html>
