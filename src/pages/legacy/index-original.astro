---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import FadeIn from "../components/FadeIn.astro";
import AOSInit from "../components/AOSInit.astro";
import FAQPreview from "../components/FAQPreview.astro";
import CoreBenefits from "../components/CoreBenefits.astro";
import TrustBadgesBar from "../components/TrustBadgesBar.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import ClinicalIntroWithImage from "../components/ClinicalIntroWithImage.astro";
import ClinicalCredentialsGrid from "../components/ClinicalCredentialsGrid.astro";
import SecondaryButton from "../components/SecondaryButton.astro";
import HeroSearchForm from "../components/HeroSearchForm.astro";
import ProofSection from "../components/ProofSection.astro";
import HeroVideoSection from "../components/HeroVideoSection.astro";
import NetworkMapPins from "../components/NetworkMapPins.astro";

const showPatientHeader = true;
---

<MainPatientLayout showPatientHeader={true}>
  <AOSInit />

  <!-- Professional Credibility Banner -->
  <section class="bg-gradient-to-r from-[#cc9933] to-[#e6c378] py-3 px-6">
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-sm text-white font-medium">
        🏆 <strong>PROVEN HEALTHCARE PIONEERS:</strong> Built America's first managed
        care imaging network • Served 400,000+ patients • $400 Million+ savings delivered
        • Successful healthcare exit
      </p>
    </div>
  </section>

  <!-- Enhanced Video Hero Section - EVOLUTION STORY -->
  <FadeIn effect="fade" delay={0}>
    <HeroVideoSection
      headlineText={`<span class="text-white">Get Your MRI This Week,</span><br /><span class="text-[#cc9933] font-bold">Not Next Month</span>`}
      subText={`From the team that revolutionized medical imaging access.<br class="hidden sm:block" /><span class="text-white">2-4 day appointments • 30-70% below hospitals • Board-certified radiologists</span>`}
      credibilityText="🔍 TOTAL TRANSPARENCY: See prices before booking • No hidden fees ever • Compare centers instantly"
      videoSources={[
        {
          src: "/videos/home-hero-mri-mobile.mp4",
          type: "video/mp4",
          media: "(max-width: 768px)",
        },
        { src: "/videos/home-hero-mri.mp4", type: "video/mp4" },
        { src: "/videos/home-hero-mri.webm", type: "video/webm" },
      ]}
      posterUrl="/images/home-hero-mri.webp?v=2.1"
      primaryCTA={{
        label: "Book Your MRI Now",
        href: "/search-results?zipCode=33330&procedure=70551&state=FL&autoSearch=true",
      }}
      secondaryCTA={{ label: "Check Prices", id: "heroSearchToggle" }}
      showSearchForm={true}
      trustIndicators={[
        {
          icon: `<div class='w-3 h-3 bg-green-400 rounded-full animate-pulse'></div>`,
          text: "📅 Next available: Tomorrow",
        },
        {
          icon: `<svg class='w-4 h-4 text-[#cc9933]' fill='currentColor' viewBox='0 0 20 20'><path fill-rule='evenodd' d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z' clip-rule='evenodd'></path></svg>`,
          text: "Proven healthcare model",
        },
        {
          icon: `<svg class='w-4 h-4 text-green-400' fill='currentColor' viewBox='0 0 20 20'><path fill-rule='evenodd' d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z' clip-rule='evenodd'></path></svg>`,
          text: "100% price guarantee",
        },
      ]}
    />

    <!-- Proof Section Component -->
    <ProofSection />

    <!-- THE EVOLUTION STORY - FOUNDATION → EVOLUTION → MISSION -->
    <section class="bg-[#fefbf5] py-20 px-6 text-[#003087]">
      <div class="max-w-7xl mx-auto">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <p
            class="text-sm uppercase tracking-wide font-semibold text-[#cc9933] mb-4"
          >
            The Evolution of Proven Healthcare
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold mb-6 text-[#003087]">
            Same Foundation. Exponentially More Powerful.
            <span class="text-lg font-normal text-[#003087]/70 block mt-2">
              How we transformed our proven model to serve millions
            </span>
          </h2>
        </div>

        <!-- The Power Grid -->
        <div class="bg-white rounded-2xl p-8 shadow-lg mb-12">
          <div class="grid md:grid-cols-3 gap-8 text-center">
            <div>
              <p class="text-sm text-[#cc9933] font-semibold mb-2">
                NETWORK SCALE
              </p>
              <div class="text-3xl font-bold text-[#003087] mb-1">225x</div>
              <p class="text-sm text-[#003087]/70">
                Market expansion<br />400K → 90M Americans
              </p>
            </div>
            <div>
              <p class="text-sm text-[#cc9933] font-semibold mb-2">
                BOOKING SPEED
              </p>
              <div class="text-3xl font-bold text-[#003087] mb-1">1000x</div>
              <p class="text-sm text-[#003087]/70">
                Faster scheduling<br />Hours → Seconds
              </p>
            </div>
            <div>
              <p class="text-sm text-[#cc9933] font-semibold mb-2">
                ACCESSIBILITY
              </p>
              <div class="text-3xl font-bold text-[#003087] mb-1">24/7</div>
              <p class="text-sm text-[#003087]/70">
                Always available<br />Not just business hours
              </p>
            </div>
          </div>
        </div>

        <!-- The Evolution Timeline -->
        <div class="grid md:grid-cols-3 gap-8 mb-12">
          <!-- Foundation Era -->
          <div
            class="bg-white rounded-xl p-8 border border-[#003087]/10"
            data-aos="fade-right"
          >
            <div class="text-center mb-6">
              <div class="text-6xl mb-4">🏛️</div>
              <h3 class="text-xl font-bold text-[#003087]">
                Proven Foundation
              </h3>
              <p class="text-sm text-[#cc9933] font-semibold">1994-2002</p>
            </div>
            <ul class="space-y-3 text-[#003087]/80">
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">✓</span>
                <span>Pioneered managed care imaging model</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">✓</span>
                <span>400,000+ patients successfully served</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">✓</span>
                <span>$400M+ in verified savings delivered</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">✓</span>
                <span>Professional validation achieved</span>
              </li>
            </ul>
          </div>

          <!-- Evolution Era -->
          <div
            class="bg-gradient-to-br from-[#f0f4f9] to-[#e8ecf4] rounded-xl p-8 border border-[#cc9933]/20"
            data-aos="fade-up"
          >
            <div class="text-center mb-6">
              <div class="text-6xl mb-4">⚡</div>
              <h3 class="text-xl font-bold text-[#003087]">Modern Evolution</h3>
              <p class="text-sm text-[#cc9933] font-semibold">2025</p>
            </div>
            <ul class="space-y-3 text-[#003087]">
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">⚡</span>
                <span>Digital transformation at scale</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">⚡</span>
                <span>Real-time pricing & booking</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">⚡</span>
                <span>1,500+ centers competing for you</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">⚡</span>
                <span>Same proven standards, modern delivery</span>
              </li>
            </ul>
          </div>

          <!-- Mission Era -->
          <div
            class="bg-gradient-to-br from-[#cc9933]/10 to-[#cc9933]/5 rounded-xl p-8 border border-[#cc9933]/30"
            data-aos="fade-left"
          >
            <div class="text-center mb-6">
              <div class="text-6xl mb-4">🚀</div>
              <h3 class="text-xl font-bold text-[#003087]">Expanded Mission</h3>
              <p class="text-sm text-[#cc9933] font-semibold">
                Serving Millions
              </p>
            </div>
            <ul class="space-y-3 text-[#003087]">
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">🎯</span>
                <span>90 million Americans to serve</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">🎯</span>
                <span>Uninsured & underinsured focus</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">🎯</span>
                <span>Transparent, affordable access</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2 mt-1">🎯</span>
                <span>Proven care for everyone</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- The Professional Power Statement -->
        <div
          class="bg-gradient-to-r from-[#003087]/5 to-[#cc9933]/5 rounded-2xl p-8 border border-[#003087]/10"
        >
          <h4 class="text-xl font-bold text-[#003087] mb-4 text-center">
            Evolution Validated by Excellence
          </h4>
          <p
            class="text-[#003087] text-center max-w-3xl mx-auto leading-relaxed"
          >
            We're not just another imaging company—we're the proven team that
            built AnciCare, underwent institutional financial review, completed
            a successful acquisition, and created
            a model that's still operating successfully 20+ years later. Now
            we're bringing that same excellence, enhanced with modern
            technology, to serve 90 million Americans.
          </p>
          <p class="text-center mt-6">
            <span
              class="inline-block bg-white px-6 py-3 rounded-full text-sm font-semibold text-[#003087] border border-[#cc9933]/30"
            >
              Proven past. Powerful present. Scaled for the future.
            </span>
          </p>
        </div>
      </div>
    </section>

    <!-- Enhanced "Behind the Simplicity" Section -->
    <section class="bg-white py-20 px-6 text-[#003087]">
      <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center">
        <!-- Image on Left -->
        <div data-aos="fade-right">
          <img
            src="/images/two-rads-control-center.webp"
            loading="lazy"
            alt="Expert medical team reviewing imaging results"
            class="w-full h-auto rounded-2xl shadow-xl"
          />
        </div>

        <!-- Text on Right - Enhanced with Evolution Story -->
        <div data-aos="fade-left" class="text-left">
          <p
            class="text-sm uppercase tracking-wide font-semibold text-[#cc9933] mb-4"
          >
            Built Different From Day One
          </p>
          <h2 class="text-2xl sm:text-3xl font-bold mb-6 text-[#003087]">
            Institutional Excellence, Startup Energy
            <span class="text-lg font-normal text-[#003087]/70 block mt-2">
              Enterprise discipline meets healthcare innovation
            </span>
          </h2>
          <div class="space-y-4 text-lg text-[#003087]/90">
            <p>
              Most healthcare startups never see Big Four involvement. We built
              AnciCare with the financial discipline and operational excellence
              that warranted Ernst & Young (EY) annual financial review and auditing.
            </p>
            <p>
              <strong>Those high standards are built into USRad's DNA.</strong> We're
              applying the same meticulous approach to quality, transparency, and
              patient care that earned our successful acquisition.
            </p>
            <div class="bg-[#f0f4f9] rounded-xl p-4 mt-6">
              <div
                class="flex items-center gap-2 text-[#cc9933] font-semibold text-sm mb-2"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                THE ONLY IMAGING COMPANY WITH THIS PEDIGREE
              </div>
              <div class="text-sm text-[#003087]">
                ✓ Professional annual financial review and auditing<br />
                ✓ First-tier legal counsel validated<br />
                ✓ Acquired by NYSE-listed company<br />
                ✓ Model proven sustainable for 20+ years
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Keep existing Core Benefits section -->
    <section
      class="relative pt-16 pb-20"
      style="
        background: linear-gradient(135deg, #fcf9f0 0%, #f8f5e8 100%);
        background-image: 
          radial-gradient(circle at 25% 25%, rgba(0, 48, 135, 0.03) 0%, transparent 50%),
          radial-gradient(circle at 75% 75%, rgba(204, 153, 51, 0.03) 0%, transparent 50%);
        background-size: 120px 120px, 80px 80px;
      "
    >
      <div class="relative z-10">
        <CoreBenefits />
      </div>
    </section>

    <!-- Enhanced Personal Care Section -->
    <section class="bg-white py-20 px-6">
      <div class="max-w-7xl mx-auto text-center mb-12">
        <h2 class="text-3xl font-bold text-[#003087] mb-4" data-aos="fade-up">
          Personal Care Perfected Over 400,000 Interactions
          <span class="text-lg font-normal text-[#003087]/70 block mt-2">
            The same patient-first approach, now digitally enhanced
          </span>
        </h2>
        <p
          class="text-lg text-[#003087]/80"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Our care model was validated through hundreds of thousands of patient
          experiences and refined through institutional standards—now evolved
          for modern healthcare
        </p>
      </div>

      <div class="max-w-4xl mx-auto" data-aos="zoom-in" data-aos-delay="200">
        <img
          src="/images/website/trust-duo.webp"
          loading="lazy"
          alt="Technologist guiding patient through MRI process"
          class="w-full h-auto rounded-3xl shadow-2xl"
        />
      </div>
    </section>

    <!-- Enhanced Trust Badges section -->
    <section class="bg-[#f0f4f9] py-16 px-6">
      <div class="max-w-6xl mx-auto" data-aos="fade-up" data-aos-delay="300">
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold text-[#003087] mb-2">
            What This Means for You
          </h3>
          <p class="text-[#003087]/70">
            AART certified radiologic technologists • Modern equipment •
            Accurate results • Lower prices
          </p>
        </div>
        <TrustBadgesBar />
      </div>
    </section>

    <!-- Network Map -->
    <FadeIn effect="fade" delay={100}>
      <NetworkMapPins />
    </FadeIn>

    <!-- Keep existing Clinical sections -->
    <section class="bg-white py-20 px-6">
      <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center">
        <ClinicalIntroWithImage />
        <ClinicalCredentialsGrid />
      </div>
    </section>

    <FAQPreview />

    <!-- Enhanced CTA with Evolution Story -->
    <FadeIn effect="fade" delay={100}>
      <section
        class="bg-gradient-to-br from-[#003087] to-[#002266] text-white py-20 px-6 sm:px-12 relative overflow-hidden"
        data-aos="fade-up"
      >
        <div
          class="absolute inset-0 bg-repeat opacity-[0.03]"
          style="background-image: url('/images/subtle-pattern.svg');"
        >
        </div>
        <div
          class="absolute top-20 right-20 w-64 h-64 rounded-full bg-[#cc9933] opacity-[0.05] blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-20 left-20 w-72 h-72 rounded-full bg-white opacity-[0.03] blur-3xl"
        >
        </div>

        <div class="max-w-6xl mx-auto text-center relative z-10">
          <!-- Evolution credibility banner -->
          <div
            class="bg-white/10 backdrop-blur-md rounded-full px-6 py-2 border border-white/20 inline-block mb-6"
          >
            <span class="text-[#cc9933] font-bold text-sm"
              >✓ PROVEN FOUNDATION • MODERN EVOLUTION • EXPANDED MISSION</span
            >
          </div>

          <h2 class="text-4xl font-semibold mb-6 font-manrope">
            Experience Healthcare Evolution
          </h2>
          <p class="text-xl max-w-3xl mx-auto mb-12 font-manrope">
            Join the healthcare revolution that started with 400,000 patients
            and is now evolving to serve millions. Same proven excellence,
            enhanced for the digital age.
          </p>

          <div class="flex flex-col sm:flex-row justify-center gap-6">
            <PrimaryButton
              href="/search-results"
              color="gold"
              text="Book Your Scan Today"
            />
            <SecondaryButton href="/about" text="Our Proven Journey" />
          </div>
        </div>
      </section>
    </FadeIn>

    <ChatbotToggle chatbotLabel="💬 Let's Talk" />
  </FadeIn>

  <!-- Load external JavaScript -->
  <script src="/js/heroSearch.js" is:inline></script>
</MainPatientLayout>
