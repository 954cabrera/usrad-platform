---
// imaginglogin.astro - Ultra Unicorn Theme
import { supabase } from "@/lib/supabase";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="supabase-url" content={supabaseUrl} />
    <meta name="supabase-anon-key" content={supabaseAnonKey} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Imaging Center Login | USRad</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      :root {
        --primary: #003087;
        --primary-dark: #001a4d;
        --accent: #cc9933;
        --accent-light: #e6c378;
        --text-primary: #1e293b;
        --text-secondary: #64748b;
        --surface: #ffffff;
        --surface-hover: #f8fafc;
        --border: #e2e8f0;
        --error: #dc2626;
        --success: #16a34a;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        background: #000000;
        overflow-x: hidden;
        animation: fadeIn 0.8s ease;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      @keyframes float {
        0%,
        100% {
          transform: translateY(0) rotate(0deg);
        }
        50% {
          transform: translateY(-20px) rotate(5deg);
        }
      }

      @keyframes pulse-glow {
        0%,
        100% {
          opacity: 0.5;
          transform: translate(-50%, -50%) scale(1);
        }
        50% {
          opacity: 0.8;
          transform: translate(-50%, -50%) scale(1.1);
        }
      }

      @keyframes gentle-float {
        0%,
        100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-15px);
        }
      }

      @keyframes gradient-shift {
        0%,
        100% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
      }

      @keyframes float-particle {
        from {
          transform: translateY(100vh) rotate(0deg);
          opacity: 0;
        }
        10% {
          opacity: 1;
        }
        90% {
          opacity: 1;
        }
        to {
          transform: translateY(-100vh) rotate(720deg);
          opacity: 0;
        }
      }

      @keyframes slideUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes slideIn {
        from {
          opacity: 0;
          transform: translateX(20px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      /* Cosmic background */
      .cosmic-bg {
        position: fixed;
        inset: 0;
        background:
          radial-gradient(
            ellipse at top left,
            rgba(0, 48, 135, 0.2) 0%,
            transparent 40%
          ),
          radial-gradient(
            ellipse at bottom right,
            rgba(204, 153, 51, 0.15) 0%,
            transparent 40%
          ),
          radial-gradient(
            ellipse at center,
            rgba(26, 79, 160, 0.1) 0%,
            transparent 50%
          ),
          linear-gradient(180deg, #000000 0%, #0a0a0a 100%);
        z-index: -2;
      }

      /* Animated particles */
      .particles {
        position: fixed;
        inset: 0;
        z-index: -1;
      }

      .particle {
        position: absolute;
        width: 2px;
        height: 2px;
        background: rgba(204, 153, 51, 0.5);
        border-radius: 50%;
        animation: float-particle 20s infinite linear;
      }

      /* Main layout */
      .login-layout {
        display: flex;
        min-height: 100vh;
        position: relative;
      }

      /* Left side - Logo section */
      .logo-side {
        flex: 1.2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem;
        position: relative;
        background: rgba(0, 48, 135, 0.03);
        border-right: 1px solid rgba(255, 255, 255, 0.05);
      }

      /* Back navigation */
      .back-nav {
        position: absolute;
        top: 2rem;
        left: 2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 100px;
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s ease;
      }

      .back-nav:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateX(-5px);
        border-color: rgba(204, 153, 51, 0.3);
      }

      /* 3D Logo container */
      .logo-3d-container {
        perspective: 1000px;
        margin-bottom: 3rem;
        position: relative;
      }

      .logo-3d-container img {
        width: 240px;
        height: auto;
        animation: gentle-float 6s ease-in-out infinite;
        filter: drop-shadow(0 20px 40px rgba(204, 153, 51, 0.3));
        display: block;
        position: relative;
        z-index: 2;
      }

      @keyframes gentle-float {
        0%,
        100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-15px);
        }
      }

      .logo-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 300px;
        height: 300px;
        background: radial-gradient(
          circle,
          rgba(204, 153, 51, 0.2) 0%,
          transparent 70%
        );
        filter: blur(60px);
        animation: pulse-glow 3s ease-in-out infinite;
        z-index: 1;
      }

      .logo-side img {
        width: 240px;
        height: auto;
        animation: gentle-float 6s ease-in-out infinite;
        filter: drop-shadow(0 20px 40px rgba(204, 153, 51, 0.3));
        display: block;
      }

      /* Brand content */
      .brand-content {
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 500px;
        animation: slideUp 0.8s ease-out;
      }

      .brand-title {
        color: white;
        font-size: 3.5rem;
        font-weight: 800;
        margin: 0 0 1.5rem 0;
        letter-spacing: -0.03em;
        line-height: 1.1;
        background: linear-gradient(
          135deg,
          #ffffff 0%,
          #cc9933 50%,
          #ffffff 100%
        );
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradient-shift 3s ease infinite;
      }

      .brand-tagline {
        color: rgba(255, 255, 255, 0.9);
        font-size: 1.25rem;
        font-weight: 400;
        line-height: 1.7;
        margin: 0 0 3rem 0;
        max-width: 450px;
      }

      /* Metrics container */
      .metrics-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        width: 100%;
        margin-bottom: 3rem;
      }

      .metric-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        min-width: 0;
      }

      .metric-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(204, 153, 51, 0.2),
          transparent
        );
        transition: left 0.5s ease;
      }

      .metric-card:hover::before {
        left: 100%;
      }

      .metric-card:hover {
        transform: translateY(-5px);
        border-color: rgba(204, 153, 51, 0.3);
        background: rgba(255, 255, 255, 0.05);
      }

      .metric-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--accent);
        display: block;
        margin-bottom: 0.5rem;
        white-space: nowrap;
        line-height: 1;
      }

      .metric-label {
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 500;
        white-space: nowrap;
        line-height: 1.2;
      }

      /* Trust indicators */
      .trust-indicators {
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 2rem;
      }

      .trust-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 100px;
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s ease;
      }

      .trust-item:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
      }

      /* Right side - Form section */
      .form-side {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(10px);
        padding: 2rem;
        position: relative;
      }

      /* Form container */
      .login-box {
        width: 100%;
        max-width: 440px;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        border-radius: 30px;
        padding: 3rem;
        box-shadow:
          0 20px 60px rgba(0, 0, 0, 0.3),
          0 0 100px rgba(204, 153, 51, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        position: relative;
        overflow: hidden;
        animation: slideUp 0.6s ease-out 0.2s both;
      }

      /* Animated border gradient */
      .login-box::before {
        content: "";
        position: absolute;
        inset: -2px;
        background: linear-gradient(
          45deg,
          var(--primary),
          var(--accent),
          var(--primary)
        );
        border-radius: 30px;
        opacity: 0;
        transition: opacity 0.3s ease;
        z-index: -1;
        animation: rotate-gradient 3s linear infinite;
      }

      @keyframes rotate-gradient {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }

      .login-box:hover::before {
        opacity: 0.1;
      }

      .form-header {
        text-align: center;
        margin-bottom: 2.5rem;
      }

      .form-title {
        font-size: 2.25rem;
        font-weight: 800;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
        letter-spacing: -0.03em;
      }

      .form-subtitle {
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.6;
      }

      /* Floating label inputs */
      .input-group {
        position: relative;
        margin-bottom: 2rem;
      }

      .input-wrapper {
        position: relative;
      }

      .form-input {
        width: 100%;
        padding: 1.25rem 1rem 0.75rem 1rem;
        border: 2px solid var(--border);
        border-radius: 16px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: var(--surface);
        font-family: inherit;
      }

      .form-input:focus {
        outline: none;
        border-color: var(--primary);
        background: var(--surface-hover);
        box-shadow: 0 0 0 4px rgba(0, 48, 135, 0.1);
      }

      .input-label {
        position: absolute;
        left: 1rem;
        top: 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-secondary);
        transition: all 0.3s ease;
        pointer-events: none;
        background: var(--surface);
        padding: 0 0.5rem;
      }

      .form-input:focus + .input-label,
      .form-input:not(:placeholder-shown) + .input-label {
        top: -0.5rem;
        font-size: 0.75rem;
        color: var(--primary);
      }

      .asterisk {
        color: var(--accent);
        margin-left: 2px;
      }

      .password-toggle {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 8px;
        transition: all 0.2s ease;
        color: var(--text-secondary);
      }

      .password-toggle:hover {
        background: var(--surface-hover);
        color: var(--primary);
      }

      /* Form options */
      .form-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
      }

      .remember-me {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
        cursor: pointer;
      }

      .checkbox {
        width: 20px;
        height: 20px;
        accent-color: var(--primary);
        cursor: pointer;
      }

      .forgot-link {
        color: var(--primary);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 600;
        position: relative;
        padding-bottom: 2px;
        transition: color 0.2s ease;
      }

      .forgot-link::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--accent);
        transition: width 0.3s ease;
      }

      .forgot-link:hover {
        color: #002268;
      }

      .forgot-link:hover::after {
        width: 100%;
      }

      /* Submit button */
      .login-button {
        width: 100%;
        padding: 1.25rem;
        background: linear-gradient(135deg, var(--primary) 0%, #1a4fa0 100%);
        color: white;
        border: none;
        border-radius: 16px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        margin-bottom: 1.5rem;
        font-family: "Inter", sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        box-shadow: 0 10px 30px rgba(0, 48, 135, 0.3);
      }

      .login-button::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.3);
        transform: translate(-50%, -50%);
        transition:
          width 0.6s ease,
          height 0.6s ease;
      }

      .login-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 40px rgba(0, 48, 135, 0.4);
      }

      .login-button:active {
        transform: translateY(0);
      }

      .login-button:active::before {
        width: 300px;
        height: 300px;
      }

      .login-button:disabled {
        background: #94a3b8;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }

      /* Divider */
      .divider {
        display: flex;
        align-items: center;
        margin: 2rem 0;
        color: var(--text-secondary);
        font-size: 0.875rem;
        font-weight: 500;
      }

      .divider::before,
      .divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(
          to right,
          transparent,
          var(--border),
          transparent
        );
      }

      .divider span {
        padding: 0 1rem;
      }

      /* SSO buttons */
      .sso-options {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .sso-button {
        flex: 1;
        padding: 1rem;
        border: 2px solid var(--border);
        border-radius: 16px;
        background: white;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-primary);
        position: relative;
        overflow: hidden;
      }

      .sso-button::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          135deg,
          transparent 40%,
          rgba(0, 48, 135, 0.05) 50%,
          transparent 60%
        );
        transform: translateX(-100%);
        transition: transform 0.6s ease;
      }

      .sso-button:hover {
        border-color: var(--primary);
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
      }

      .sso-button:hover::before {
        transform: translateX(100%);
      }

      /* Sign up link */
      .signup-link {
        text-align: center;
        color: var(--text-secondary);
        font-size: 0.875rem;
      }

      .signup-link a {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
        position: relative;
      }

      .signup-link a::after {
        content: "";
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--accent);
        transition: width 0.3s ease;
      }

      .signup-link a:hover {
        text-decoration: underline;
      }

      .signup-link a:hover::after {
        width: 100%;
      }

      /* Security footer */
      .security-footer {
        position: absolute;
        bottom: 1.5rem;
        right: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.75rem;
        font-weight: 500;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        padding: 0.5rem 1rem;
        border-radius: 100px;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      /* Messages */
      .message {
        padding: 1rem 1.25rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        animation: slideUp 0.3s ease-out;
        position: relative;
        overflow: hidden;
      }

      .message::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
      }

      .message.error {
        background: #fef2f2;
        color: var(--error);
        border: 1px solid #fecaca;
      }

      .message.error::before {
        background: var(--error);
      }

      .message.success {
        background: #f0fdf4;
        color: var(--success);
        border: 1px solid #bbf7d0;
      }

      .message.success::before {
        background: var(--success);
      }

      .message.hidden {
        display: none;
      }

      /* Forgot password form */
      .forgot-password-form {
        display: none;
        animation: slideIn 0.3s ease;
      }

      .forgot-password-form.active {
        display: block;
      }

      .back-to-login {
        color: var(--primary);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        padding: 0.5rem 1rem;
        border-radius: 100px;
        background: rgba(0, 48, 135, 0.05);
        transition: all 0.3s ease;
      }

      .back-to-login:hover {
        background: rgba(0, 48, 135, 0.1);
        transform: translateX(-5px);
      }

      /* Loading spinner */
      .loading-spinner {
        display: inline-block;
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
      }

      /* Responsive design */
      @media (max-width: 1024px) {
        .brand-title {
          font-size: 2.5rem;
        }

        .metrics-container {
          gap: 1rem;
        }

        .metric-number {
          font-size: 2rem;
        }
      }

      @media (max-width: 768px) {
        .login-layout {
          flex-direction: column;
        }

        .logo-side {
          min-height: 50vh;
          padding: 2rem 1rem;
          border-right: none;
          border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .back-nav {
          top: 1rem;
          left: 1rem;
          padding: 0.5rem 1rem;
          font-size: 0.75rem;
        }

        .logo-side img {
          width: 180px;
        }

        .brand-title {
          font-size: 2rem;
        }

        .brand-tagline {
          font-size: 1rem;
          margin-bottom: 2rem;
        }

        .metrics-container {
          margin-bottom: 2rem;
        }

        .metric-card {
          padding: 1rem;
        }

        .metric-number {
          font-size: 1.5rem;
        }

        .trust-indicators {
          position: static;
          transform: none;
          margin-top: 2rem;
          flex-wrap: wrap;
          gap: 1rem;
        }

        .form-side {
          padding: 2rem 1rem;
        }

        .login-box {
          padding: 2rem;
          border-radius: 20px;
        }

        .form-title {
          font-size: 1.75rem;
        }

        .sso-options {
          flex-direction: column;
        }

        .security-footer {
          position: static;
          margin-top: 2rem;
          justify-content: center;
        }
      }

      /* Accessibility */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <!-- Animated background -->
    <div class="particles" id="particles"></div>
    <div class="cosmic-bg"></div>

    <div class="login-layout">
      <div class="logo-side">
        <a href="/login" class="back-nav">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
