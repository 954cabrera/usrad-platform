      <script>
        let currentStep = 1;
        const totalSteps = 2;
        let clickCount = 0;
        let useMultiStep = true; // Toggle for multi-step vs single-page

        // Initialize
        document.addEventListener("DOMContentLoaded", () => {
          // Check if user prefers single-page (could be stored in localStorage)
          if (localStorage.getItem("preferSinglePage") === "true") {
            useMultiStep = false;
            convertToSinglePage();
          }

          const usernameInput = document.getElementById("username");
          usernameInput.focus();

          // Password strength checker
          const passwordInput = document.getElementById("password");
          passwordInput.addEventListener("input", checkPasswordStrength);

          // Form submission
          const form = document.getElementById("loginForm");
          form.addEventListener("submit", handleSubmit);

          // Enter key navigation
          usernameInput.addEventListener("keypress", (e) => {
            if (e.key === "Enter" && useMultiStep) {
              e.preventDefault();
              nextStep();
            }
          });

          // Logo click counter for easter egg
          const logo = document.querySelector(".logo");
          logo.addEventListener("click", () => {
            clickCount++;
            if (clickCount === 5) {
              document.getElementById("easterEgg").classList.add("revealed");
              showNotification("You found a hidden star! 🌟");
            }
          });
        });

        function convertToSinglePage() {
          // Show all form fields on one page
          document.getElementById("formStep1").innerHTML = `
          <div class="input-group">
            <label class="input-label">Username</label>
            <div class="input-wrapper">
              <input 
                type="text" 
                class="input-field" 
                id="username" 
                placeholder="Enter your username"
                autocomplete="username"
                required
              >
              <svg class="input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
          </div>

          <div class="input-group">
            <label class="input-label">Password</label>
            <div class="input-wrapper">
              <input 
                type="password" 
                class="input-field" 
                id="password" 
                placeholder="Enter your password"
                autocomplete="current-password"
                required
              >
              <svg class="input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </div>
            <div class="password-strength" id="passwordStrength">
              <div class="strength-bar"></div>
              <div class="strength-bar"></div>
              <div class="strength-bar"></div>
              <div class="strength-bar"></div>
            </div>
          </div>

          <div class="remember-section">
            <div class="checkbox-wrapper">
              <input type="checkbox" class="checkbox" id="remember">
              <label for="remember">Keep me signed in</label>
            </div>
            <a href="#" class="link">Forgot password?</a>
          </div>

          <div class="button-group">
            <button type="submit" class="btn btn-primary" id="submitBtn">
              Sign in securely
            </button>
          </div>

          <div class="signup-prompt">
            Don't have an account? <a href="#" class="link">Sign up here</a>
          </div>

          <div class="terms-notice">
            By signing in, you agree to our <a href="#" class="link">Terms of Use</a> and <a href="#" class="link">Privacy Policy</a>
          </div>

          <div class="health-tip">
            <div class="tip-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--primary)">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
              </svg>
            </div>
            <div class="tip-text">
              <strong>Quick tip:</strong> We use advanced imaging technology to provide clear, accurate results for better diagnosis.
            </div>
          </div>
        `;

          // Hide progress steps for single page
          document.querySelector(".progress-steps").style.display = "none";

          // Hide step 2
          document.getElementById("formStep2").style.display = "none";

          // Re-attach event listeners
          document
            .getElementById("password")
            .addEventListener("input", checkPasswordStrength);
        }

        function nextStep() {
          const username = document.getElementById("username").value;
          if (!username.trim()) {
            shakeInput("username");
            return;
          }

          if (currentStep < totalSteps) {
            // Hide current step
            document
              .getElementById(`formStep${currentStep}`)
              .classList.remove("active");

            // Update progress
            currentStep++;
            document
              .getElementById(`step${currentStep}`)
              .classList.add("active");

            // Show next step
            setTimeout(() => {
              document
                .getElementById(`formStep${currentStep}`)
                .classList.add("active");
              document.getElementById("password").focus();

              // Personalized greeting
              const greeting = document.querySelector(".greeting");
              greeting.textContent = `Hi ${username}! 👋`;
            }, 300);
          }
        }

        function prevStep() {
          if (currentStep > 1) {
            // Hide current step
            document
              .getElementById(`formStep${currentStep}`)
              .classList.remove("active");

            // Update progress
            document
              .getElementById(`step${currentStep}`)
              .classList.remove("active");
            currentStep--;

            // Show previous step
            setTimeout(() => {
              document
                .getElementById(`formStep${currentStep}`)
                .classList.add("active");
              document.getElementById("username").focus();
            }, 300);
          }
        }

        function checkPasswordStrength(e) {
          const password = e.target.value;
          const strengthIndicator = document.getElementById("passwordStrength");
          const bars = strengthIndicator.querySelectorAll(".strength-bar");

          if (password.length === 0) {
            strengthIndicator.classList.remove("visible");
            return;
          }

          strengthIndicator.classList.add("visible");

          let strength = 0;
          if (password.length >= 8) strength++;
          if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
          if (password.match(/[0-9]/)) strength++;
          if (password.match(/[^a-zA-Z0-9]/)) strength++;

          bars.forEach((bar, index) => {
            if (index < strength) {
              bar.classList.add("active");
            } else {
              bar.classList.remove("active");
            }
          });
        }

        function handleSubmit(e) {
          e.preventDefault();

          const username = document.getElementById("username").value;
          const password = document.getElementById("password").value;

          if (!username.trim() || !password.trim()) {
            if (!username.trim()) shakeInput("username");
            if (!password.trim()) shakeInput("password");
            return;
          }

          const submitBtn = document.getElementById("submitBtn");
          submitBtn.classList.add("loading");

          // Simulate authentication
          setTimeout(() => {
            // Hide form
            document.querySelector(".login-form").style.display = "none";
            document.querySelector(".progress-steps").style.display = "none";
            document.querySelector(".trust-badges").style.display = "none";

            // Show success animation
            document.getElementById("successAnimation").classList.add("active");

            // Update final progress
            if (useMultiStep) {
              document.getElementById("step3").classList.add("active");
            }

            // Redirect after animation
            setTimeout(() => {
              showNotification(
                "Login successful! Redirecting to your imaging portal..."
              );
              // window.location.href = '/patient-portal';
            }, 2000);
          }, 1500);
        }

        function shakeInput(inputId) {
          const input = document.getElementById(inputId);
          input.style.animation = "shake 0.5s ease";
          setTimeout(() => {
            input.style.animation = "";
          }, 500);
        }

        function activateEasterEgg() {
          const colors = [
            "#ff6b6b",
            "#4ecdc4",
            "#45b7d1",
            "#f9ca24",
            "#f0932b",
          ];
          const particles = document.querySelectorAll(".health-particle");
          particles.forEach((particle, index) => {
            particle.style.background = colors[index % colors.length];
            particle.style.animationDuration = "5s";
          });
          showNotification("Wellness mode activated! 🌈");
        }

        function showNotification(message) {
          const notification = document.createElement("div");
          notification.style.cssText = `
          position: fixed;
          bottom: 2rem;
          left: 50%;
          transform: translateX(-50%);
          background: var(--primary);
          color: white;
          padding: 1rem 2rem;
          border-radius: 50px;
          font-size: 0.9rem;
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
          z-index: 1000;
          animation: slideUp 0.5s ease;
        `;
          notification.textContent = message;
          document.body.appendChild(notification);

          setTimeout(() => {
            notification.style.animation = "fadeOut 0.5s ease";
            setTimeout(() => notification.remove(), 500);
          }, 3000);
        }

        // Add shake animation
        const style = document.createElement("style");
        style.textContent = `
        @keyframes shake {
          0%, 100% { transform: translateX(0); }
          10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
          20%, 40%, 60%, 80% { transform: translateX(5px); }
        }
        @keyframes fadeOut {
          to { opacity: 0; transform: translateY(10px); }
        }
      `;
        document.head.appendChild(style);
      </script>
    </div>
  </body>
</html>
