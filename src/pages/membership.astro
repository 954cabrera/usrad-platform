<script>
  // ============================================================
  // CTA Bill of Rights trigger — opens the MemberRightsSummary modal
  // from the page footer CTA, reusing the same modal already on page
  // ============================================================
  const ctaTrigger = document.getElementById("cta-mbor-trigger");
  const mborModal = document.getElementById("mbor-modal");

  if (ctaTrigger && mborModal) {
    ctaTrigger.addEventListener("click", () => {
      mborModal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    });
  }
</script>
