---
// src/pages/my-bookings.astro
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
---

<MainPatientLayout>
  <Fragment slot="title">My Bookings - USRad</Fragment>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Page Header -->
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-[#003087] mb-3">Track Your Booking</h1>
      <p class="text-lg text-gray-600">
        Enter your booking details to check your appointment status
      </p>
    </div>

    <!-- Booking Lookup Section -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-100 mb-8">
      <div
        class="bg-gradient-to-r from-blue-50 to-indigo-50 px-6 py-4 border-b border-gray-100 rounded-t-xl"
      >
        <h2 class="text-xl font-semibold text-[#003087]">Find Your Booking</h2>
      </div>

      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Option 1: Booking ID -->
          <div class="space-y-4">
            <h3 class="text-lg font-medium text-gray-900">
              Option 1: Booking ID
            </h3>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Booking ID
              </label>
              <input
                type="text"
                id="bookingId"
                placeholder="USR-ABC123XYZ"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
            </div>
            <button
              onclick="lookupByBookingId()"
              class="w-full bg-[#003087] text-white py-3 px-6 rounded-lg hover:bg-blue-800 transition duration-200 font-medium"
            >
              Track by Booking ID
            </button>
          </div>

          <!-- Option 2: Email -->
          <div class="space-y-4">
            <h3 class="text-lg font-medium text-gray-900">
              Option 2: Email Address
            </h3>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Email Address
              </label>
              <input
                type="email"
                id="email"
                placeholder="your.email@example.com"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
            </div>
            <button
              onclick="lookupByEmail()"
              class="w-full bg-green-600 text-white py-3 px-6 rounded-lg hover:bg-green-700 transition duration-200 font-medium"
            >
              Track by Email
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loading" class="hidden text-center py-8">
      <div
        class="animate-spin rounded-full h-12 w-12 border-b-2 border-[#003087] mx-auto mb-4"
      >
      </div>
      <p class="text-gray-600">Looking up your booking...</p>
    </div>

    <!-- Error State -->
    <div
      id="error"
      class="hidden bg-red-50 border border-red-200 rounded-lg p-4 mb-6"
    >
      <div class="flex">
        <svg
          class="w-5 h-5 text-red-400 mt-0.5 mr-3"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <h3 class="text-sm font-medium text-red-800">Booking Not Found</h3>
          <p class="text-sm text-red-700 mt-1">
            We couldn't find a booking with those details. Please check your
            information and try again.
          </p>
        </div>
      </div>
    </div>

    <!-- Booking Results -->
    <div id="bookingResults" class="hidden space-y-6">
      <!-- Status Timeline -->
      <div
        class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden"
      >
        <div
          class="bg-gradient-to-r from-green-50 to-blue-50 px-6 py-4 border-b border-gray-100"
        >
          <h2 class="text-xl font-semibold text-[#003087]">Booking Status</h2>
        </div>

        <div class="p-6">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center space-x-4">
              <div
                class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-green-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <h3
                  class="text-lg font-semibold text-gray-900"
                  id="statusTitle"
                >
                  Booking Submitted
                </h3>
                <p class="text-gray-600" id="statusDescription">
                  Your request is being processed
                </p>
              </div>
            </div>
            <div class="text-right">
              <div class="text-2xl font-bold text-[#003087]" id="timeRemaining">
                3h 45m
              </div>
              <div class="text-sm text-gray-500">remaining</div>
            </div>
          </div>

          <!-- Progress Steps -->
          <div class="flex items-center justify-between">
            <div class="flex flex-col items-center flex-1">
              <div
                class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center text-white text-sm font-medium mb-2"
              >
                ✓
              </div>
              <span class="text-xs text-center text-gray-600">Submitted</span>
            </div>
            <div class="flex-1 h-1 bg-yellow-200 mx-2"></div>
            <div class="flex flex-col items-center flex-1">
              <div
                class="w-8 h-8 bg-yellow-400 rounded-full flex items-center justify-center text-white text-sm font-medium mb-2 animate-pulse"
              >
                2
              </div>
              <span class="text-xs text-center text-gray-600">Coordinating</span
              >
            </div>
            <div class="flex-1 h-1 bg-gray-200 mx-2"></div>
            <div class="flex flex-col items-center flex-1">
              <div
                class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center text-white text-sm font-medium mb-2"
              >
                3
              </div>
              <span class="text-xs text-center text-gray-600">Confirmed</span>
            </div>
            <div class="flex-1 h-1 bg-gray-200 mx-2"></div>
            <div class="flex flex-col items-center flex-1">
              <div
                class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center text-white text-sm font-medium mb-2"
              >
                4
              </div>
              <span class="text-xs text-center text-gray-600">Complete</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Booking Details -->
      <div
        class="bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden"
      >
        <div
          class="bg-gradient-to-r from-blue-50 to-indigo-50 px-6 py-4 border-b border-gray-100"
        >
          <h2 class="text-xl font-semibold text-[#003087]">
            Appointment Details
          </h2>
        </div>

        <div class="p-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-4">
              <div>
                <label class="text-sm font-medium text-gray-500"
                  >Booking ID</label
                >
                <p
                  class="text-lg font-medium text-gray-900"
                  id="displayBookingId"
                >
                  USR-ABC123XYZ
                </p>
              </div>
              <div>
                <label class="text-sm font-medium text-gray-500">Patient</label>
                <p class="text-lg font-medium text-gray-900" id="patientName">
                  John Smith
                </p>
              </div>
              <div>
                <label class="text-sm font-medium text-gray-500"
                  >Procedure</label
                >
                <p class="text-lg font-medium text-gray-900" id="procedureName">
                  MRI Brain without contrast
                </p>
              </div>
            </div>
            <div class="space-y-4">
              <div>
                <label class="text-sm font-medium text-gray-500"
                  >Imaging Center</label
                >
                <p class="text-lg font-medium text-gray-900" id="facilityName">
                  <span class="text-[#003087] font-semibold">USRad</span> via Cleveland
                  Clinic Indian River Hospital
                </p>
              </div>
              <div>
                <label class="text-sm font-medium text-gray-500"
                  >Amount Paid</label
                >
                <p class="text-lg font-medium text-green-600" id="amountPaid">
                  $319.97
                </p>
              </div>
              <div>
                <label class="text-sm font-medium text-gray-500"
                  >Requested Date</label
                >
                <p class="text-lg font-medium text-gray-900" id="requestedDate">
                  Dec 15, 2024
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Next Steps -->
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-6">
        <div class="flex items-start">
          <svg
            class="w-6 h-6 text-amber-500 mt-1 mr-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div>
            <h3 class="text-lg font-semibold text-amber-800 mb-2">
              What Happens Next?
            </h3>
            <ul class="space-y-2 text-amber-700">
              <li class="flex items-start">
                <span
                  class="w-2 h-2 bg-amber-500 rounded-full mt-2 mr-3 flex-shrink-0"
                ></span>
                <span
                  ><strong>USRad</strong> will contact you within 4 hours to confirm
                  your appointment</span
                >
              </li>
              <li class="flex items-start">
                <span
                  class="w-2 h-2 bg-amber-500 rounded-full mt-2 mr-3 flex-shrink-0"
                ></span>
                <span
                  >We'll coordinate directly with the imaging center for
                  scheduling</span
                >
              </li>
              <li class="flex items-start">
                <span
                  class="w-2 h-2 bg-amber-500 rounded-full mt-2 mr-3 flex-shrink-0"
                ></span>
                <span
                  >Check your email for detailed appointment instructions</span
                >
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <button
          class="bg-[#003087] text-white py-3 px-6 rounded-lg hover:bg-blue-800 transition duration-200 font-medium"
        >
          Contact USRad
        </button>
        <button
          onclick="window.location.href = '/search-test'"
          class="bg-green-600 text-white py-3 px-6 rounded-lg hover:bg-green-700 transition duration-200 font-medium"
        >
          Book Another
        </button>
        <button
          onclick="showUpgradeModal()"
          class="bg-amber-500 text-white py-3 px-6 rounded-lg hover:bg-amber-600 transition duration-200 font-medium"
        >
          Create Account
        </button>
      </div>

      <!-- Auxiliary Demo Button -->
      <div class="flex justify-center mt-4">
        <button
          onclick="window.location.href = '/patient-dashboard'"
          class="bg-gradient-to-r from-gray-400 to-gray-500 text-white py-2 px-4 rounded-md hover:from-gray-500 hover:to-gray-600 transition duration-200 text-sm shadow-sm"
        >
          🎯 Demo to Dashboard
        </button>
      </div>
    </div>

    <!-- Help Section -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-100 mt-8">
      <div class="p-6 text-center">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Need Help?</h3>
        <p class="text-gray-600 mb-4">
          Our patient advocates are available to assist you with your booking.
        </p>
        <div
          class="flex flex-col sm:flex-row items-center justify-center space-y-2 sm:space-y-0 sm:space-x-6"
        >
          <a
            href="tel:1-866-877-2324"
            class="flex items-center text-[#003087] hover:text-blue-800 font-medium transition-colors"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            1-866-USRad-24
          </a>
          <a
            href="mailto:support@usrad.com"
            class="flex items-center text-[#003087] hover:text-blue-800 font-medium transition-colors"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            support@usrad.com
          </a>
        </div>
      </div>
    </div>

    <!-- Upgrade Modal -->
    <div
      id="upgradeModal"
      class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-[9999]"
    >
      <div
        class="relative top-32 mx-auto p-5 border w-11/12 sm:w-96 max-w-md shadow-lg rounded-md bg-white"
      >
        <div class="mt-3 text-center">
          <h3 class="text-lg font-medium text-gray-900 mb-4">
            Upgrade to Full Dashboard
          </h3>
          <p class="text-sm text-gray-500 mb-6">
            Create an account to access your complete health journey,
            appointment history, and advanced features.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <button
              onclick="hideUpgradeModal()"
              class="flex-1 bg-gray-300 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-400 transition duration-200"
            >
              Maybe Later
            </button>
            <button
              onclick="window.location.href = '/login/patientlogin'"
              class="flex-1 bg-[#003087] text-white py-2 px-4 rounded-md hover:bg-blue-800 transition duration-200"
            >
              Create Account
            </button>
            <button
              onclick="window.location.href = '/patient-dashboard'"
              class="flex-1 bg-gradient-to-r from-gray-400 to-gray-500 text-white py-2 px-4 rounded-md hover:from-gray-500 hover:to-gray-600 transition duration-200 text-sm"
            >
              🎯 Demo
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Global functions for booking lookup
      window.lookupByBookingId = async function () {
        const bookingId = document.getElementById("bookingId").value.trim();
        if (!bookingId) {
          alert("Please enter a booking ID");
          return;
        }
        await lookupBooking({ bookingId });
      };

      window.lookupByEmail = async function () {
        const email = document.getElementById("email").value.trim();
        if (!email) {
          alert("Please enter an email address");
          return;
        }
        await lookupBooking({ email });
      };

      async function lookupBooking(params) {
        showLoading();

        try {
          // Simulate API call - replace with real API
          await new Promise((resolve) => setTimeout(resolve, 1500));

          // Mock successful response
          const mockBooking = {
            bookingId: "USR-S3H9QE3S",
            patientName: "John Smith",
            procedure: "MRI Brain without contrast",
            facilityName: "Cleveland Clinic Indian River Hospital",
            amountPaid: "$319.97",
            status: "pending_confirmation",
            requestedDate: "Dec 15, 2024",
            timeRemaining: "3h 45m",
          };

          showBookingResults(mockBooking);
        } catch (error) {
          showError();
        }
      }

      function showLoading() {
        document.getElementById("loading").classList.remove("hidden");
        document.getElementById("error").classList.add("hidden");
        document.getElementById("bookingResults").classList.add("hidden");
      }

      function showError() {
        document.getElementById("loading").classList.add("hidden");
        document.getElementById("error").classList.remove("hidden");
        document.getElementById("bookingResults").classList.add("hidden");
      }

      function showBookingResults(booking) {
        document.getElementById("loading").classList.add("hidden");
        document.getElementById("error").classList.add("hidden");
        document.getElementById("bookingResults").classList.remove("hidden");

        // Populate booking details
        document.getElementById("displayBookingId").textContent =
          booking.bookingId;
        document.getElementById("patientName").textContent =
          booking.patientName;
        document.getElementById("procedureName").textContent =
          booking.procedure;
        document.getElementById("facilityName").innerHTML =
          `<span class="text-[#003087] font-semibold">USRad</span> via ${booking.facilityName}`;
        document.getElementById("amountPaid").textContent = booking.amountPaid;
        document.getElementById("requestedDate").textContent =
          booking.requestedDate;
        document.getElementById("timeRemaining").textContent =
          booking.timeRemaining;

        // Scroll to results
        document
          .getElementById("bookingResults")
          .scrollIntoView({ behavior: "smooth" });
      }

      window.showUpgradeModal = function () {
        document.getElementById("upgradeModal").classList.remove("hidden");
      };

      window.hideUpgradeModal = function () {
        document.getElementById("upgradeModal").classList.add("hidden");
      };

      // Auto-populate from URL params (if coming from booking confirmation)
      window.addEventListener("DOMContentLoaded", function () {
        const urlParams = new URLSearchParams(window.location.search);
        const bookingId = urlParams.get("bookingId");
        const email = urlParams.get("email");

        if (bookingId) {
          document.getElementById("bookingId").value = bookingId;
          lookupByBookingId();
        } else if (email) {
          document.getElementById("email").value = email;
          lookupByEmail();
        }
      });
    </script>

    <style>
      /* Custom animations for better UX */
      .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }

      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
      }
    </style>
  </div>
</MainPatientLayout>
