---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="Partner With USRad - Multiple Ways to Join Our Mission"
  description="Partner with USRad as an imaging center, employer, or investor. Join us in making healthcare accessible to millions."
>
  <AOSInit />

  <!-- Hero Section -->
  <section
    class="relative bg-gradient-to-b from-blue-50 to-white overflow-hidden py-20"
  >
    <div
      class="absolute inset-0 bg-grid-slate-100 [mask-image:linear-gradient(0deg,white,rgba(255,255,255,0.6))] -z-10"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center" data-aos="fade-up">
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6"
        >
          Partner With USRad
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-4">
          Join our mission to make quality medical imaging accessible and
          affordable for 90 million Americans
        </p>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          Whether you're a healthcare provider, employer, investor, or
          innovator, explore how we can work together to transform healthcare
          accessibility.
        </p>
      </div>
    </div>
  </section>

  <!-- Why Partner Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div data-aos="fade-right">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            Why Organizations Choose USRad
          </h2>
          <div class="space-y-4">
            <div class="flex items-start">
              <div
                class="flex-shrink-0 w-1 h-12 bg-gradient-to-b from-[#003087] to-blue-600 rounded-full mr-4"
              >
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-1">
                  Proven Business Model
                </h3>
                <p class="text-gray-600">
                  Built on 25+ years of healthcare industry experience with
                  successful exits
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="flex-shrink-0 w-1 h-12 bg-gradient-to-b from-[#cc9933] to-yellow-500 rounded-full mr-4"
              >
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-1">
                  Social Impact
                </h3>
                <p class="text-gray-600">
                  Directly improve healthcare access for 90 million underserved
                  Americans
                </p>
              </div>
            </div>
            <div class="flex items-start">
              <div
                class="flex-shrink-0 w-1 h-12 bg-gradient-to-b from-blue-600 to-[#003087] rounded-full mr-4"
              >
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-1">
                  Growth Opportunity
                </h3>
                <p class="text-gray-600">
                  Tap into a $100B+ market with massive untapped potential
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-8" data-aos="fade-left">
          <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">
              Partnership Benefits
            </h3>
            <p class="text-gray-600">What all our partners receive</p>
          </div>
          <ul class="space-y-3">
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-3"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-700"
                >Dedicated partnership success team</span
              >
            </li>
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-3"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-700">Co-marketing opportunities</span>
            </li>
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-3"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-700"
                >Access to our technology platform</span
              >
            </li>
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-3"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-700">Regular performance reporting</span>
            </li>
            <li class="flex items-center">
              <svg
                class="w-5 h-5 text-green-500 mr-3"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-700">Network growth opportunities</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="py-12 bg-white border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div data-aos="fade-up">
          <div class="text-3xl font-bold text-[#003087]">50+</div>
          <div class="text-gray-600">Partner Centers</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="50">
          <div class="text-3xl font-bold text-[#003087]">90M</div>
          <div class="text-gray-600">Americans Served</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="100">
          <div class="text-3xl font-bold text-[#003087]">80%</div>
          <div class="text-gray-600">Cost Savings</div>
        </div>
        <div data-aos="fade-up" data-aos-delay="150">
          <div class="text-3xl font-bold text-[#003087]">24hr</div>
          <div class="text-gray-600">Results Delivery</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partnership Options -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
          data-aos="fade-up"
        >
          Explore Partnership Opportunities
        </h2>
        <p
          class="text-xl text-gray-600 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="50"
        >
          Find the partnership model that aligns with your goals and helps
          expand access to affordable healthcare
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Imaging Centers -->
        <div class="group" data-aos="fade-up">
          <a href="/provider" class="block h-full">
            <div
              class="bg-white border-2 border-gray-200 rounded-2xl p-6 h-full hover:border-[#003087] hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
            >
              <div
                class="w-14 h-14 bg-gradient-to-br from-[#003087] to-blue-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
              >
                <svg
                  class="w-7 h-7 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                  ></path>
                </svg>
              </div>

              <h3
                class="text-xl font-bold text-gray-900 mb-3 group-hover:text-[#003087] transition-colors"
              >
                Imaging Centers
              </h3>

              <p class="text-gray-600 text-sm mb-4">
                Join our quality network and increase patient volume while
                serving communities in need.
              </p>

              <div
                class="flex items-center text-[#003087] font-medium text-sm group-hover:gap-3 transition-all gap-2"
              >
                Learn More
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </div>
            </div>
          </a>
        </div>

        <!-- Employers -->
        <div class="group" data-aos="fade-up" data-aos-delay="100">
          <a href="/employer-carbon4" class="block h-full">
            <div
              class="bg-white border-2 border-gray-200 rounded-2xl p-6 h-full hover:border-[#cc9933] hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
            >
              <div
                class="w-14 h-14 bg-gradient-to-br from-[#cc9933] to-yellow-500 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
              >
                <svg
                  class="w-7 h-7 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                  ></path>
                </svg>
              </div>

              <h3
                class="text-xl font-bold text-gray-900 mb-3 group-hover:text-[#cc9933] transition-colors"
              >
                Employers
              </h3>

              <p class="text-gray-600 text-sm mb-4">
                Offer employees affordable imaging as a valuable benefit that
                reduces healthcare costs.
              </p>

              <div
                class="flex items-center text-[#cc9933] font-medium text-sm group-hover:gap-3 transition-all gap-2"
              >
                Learn More
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </div>
            </div>
          </a>
        </div>

        <!-- Investors -->
        <div class="group" data-aos="fade-up" data-aos-delay="200">
          <a href="/investor-carbon" class="block h-full">
            <div
              class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-2xl p-6 h-full text-white shadow-xl hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 relative overflow-hidden"
            >
              <div
                class="w-14 h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
              >
                <svg
                  class="w-7 h-7 text-[#cc9933]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path>
                </svg>
              </div>

              <h3 class="text-xl font-bold mb-3">Investors</h3>

              <p class="text-gray-300 text-sm mb-4">
                Back a proven model that's scaling nationwide to serve 90M
                Americans.
              </p>

              <div
                class="flex items-center text-[#cc9933] font-medium text-sm group-hover:gap-3 transition-all gap-2"
              >
                View Opportunity
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </div>
            </div>
          </a>
        </div>

        <!-- Strategic Partners -->
        <div class="group" data-aos="fade-up" data-aos-delay="300">
          <div
            class="bg-white border-2 border-gray-200 rounded-2xl p-6 h-full hover:border-purple-600 hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="w-14 h-14 bg-gradient-to-br from-purple-600 to-purple-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-7 h-7 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>

            <h3
              class="text-xl font-bold text-gray-900 mb-3 group-hover:text-purple-600 transition-colors"
            >
              Strategic Partners
            </h3>

            <p class="text-gray-600 text-sm mb-4">
              Consultants, brokers, and healthcare innovators - let's explore
              collaboration.
            </p>

            <button
              class="flex items-center text-purple-600 font-medium text-sm group-hover:gap-3 transition-all gap-2 cursor-pointer"
              onclick="document.getElementById('other-partners-modal').classList.remove('hidden')"
            >
              Explore Options
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Additional CTAs -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4" data-aos="fade-up">
        Ready to Make Healthcare More Accessible?
      </h2>
      <p
        class="text-xl text-gray-600 mb-8"
        data-aos="fade-up"
        data-aos-delay="50"
      >
        Let's discuss how we can work together to transform healthcare delivery
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact-carbon"
          class="inline-flex items-center justify-center px-8 py-4 bg-[#003087] text-white font-semibold rounded-full hover:bg-[#002266] transition transform hover:scale-105"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Contact Partnership Team
          <svg
            class="ml-2 w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <a
          href="/about-carbon"
          class="inline-flex items-center justify-center px-8 py-4 bg-white border-2 border-[#003087] text-[#003087] font-semibold rounded-full hover:bg-gray-50 transition transform hover:scale-105"
          data-aos="fade-up"
          data-aos-delay="150"
        >
          Learn About USRad
          <svg
            class="ml-2 w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Modal for Strategic Partners -->
  <div
    id="other-partners-modal"
    class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4"
  >
    <div
      class="bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto"
    >
      <div class="p-8">
        <div class="flex justify-between items-start mb-6">
          <h3 class="text-2xl font-bold text-gray-900">
            Strategic Partnership Opportunities
          </h3>
          <button
            onclick="document.getElementById('other-partners-modal').classList.add('hidden')"
            class="text-gray-400 hover:text-gray-600"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <p class="text-gray-600 mb-8">
          We're always exploring innovative partnerships that expand access to
          affordable healthcare. Here are some ways we can collaborate:
        </p>

        <div class="space-y-6">
          <div class="border-l-4 border-[#003087] pl-6">
            <h4 class="text-lg font-semibold text-gray-900 mb-2">
              Healthcare Consultants & Brokers
            </h4>
            <p class="text-gray-600">
              Partner with us to offer your clients access to our nationwide
              imaging network at significant savings.
            </p>
          </div>

          <div class="border-l-4 border-[#cc9933] pl-6">
            <h4 class="text-lg font-semibold text-gray-900 mb-2">
              Technology Partners
            </h4>
            <p class="text-gray-600">
              Integrate our scheduling and pricing APIs into your healthcare
              platforms and applications.
            </p>
          </div>

          <div class="border-l-4 border-purple-600 pl-6">
            <h4 class="text-lg font-semibold text-gray-900 mb-2">
              Healthcare Innovators
            </h4>
            <p class="text-gray-600">
              Collaborate on new models of care delivery that prioritize
              accessibility and affordability.
            </p>
          </div>

          <div class="border-l-4 border-green-600 pl-6">
            <h4 class="text-lg font-semibold text-gray-900 mb-2">
              Community Organizations
            </h4>
            <p class="text-gray-600">
              Work together to bring affordable imaging services to underserved
              communities.
            </p>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t">
          <p class="text-center text-gray-600 mb-4">
            Have a unique partnership idea? We'd love to hear it.
          </p>
          <div class="text-center">
            <a
              href="/contact-carbon"
              class="inline-flex items-center justify-center px-6 py-3 bg-[#003087] text-white font-semibold rounded-full hover:bg-[#002266] transition"
            >
              Start a Conversation
              <svg
                class="ml-2 w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Close modal when clicking outside
    document
      .getElementById("other-partners-modal")
      .addEventListener("click", function (e) {
        if (e.target === this) {
          this.classList.add("hidden");
        }
      });
  </script>

  <style>
    .bg-grid-slate-100 {
      background-image: url("data:image/svg+xml,%3csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3e%3cg fill='none' fill-rule='evenodd'%3e%3cg fill='%23e2e8f0' fill-opacity='0.4'%3e%3cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3e%3c/g%3e%3c/g%3e%3c/svg%3e");
    }
  </style>
</CarbonLayout>
