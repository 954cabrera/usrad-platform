---
// src/pages/dashboard/patient-advocate/index.astro
// Patient Advocate Dashboard - Frontline customer service tools

import PatientAdvocateLayout from "../../components/dashboard/PatientAdvocateLayout.astro";
import PatientAdvocateSystem from "../../components/dashboard/PatientAdvocateSystem";
---

<PatientAdvocateLayout
  title="Patient Advocate Dashboard - Service Command Center"
  user={null}
>
  <!-- Service Status Header -->
  <div
    class="bg-gradient-to-r from-emerald-600 to-emerald-800 text-white rounded-lg shadow-xl mb-6"
  >
    <div class="p-6">
      <div class="flex justify-between items-start mb-6">
        <div>
          <h1 class="text-3xl font-bold mb-2 font-manrope">
            Patient Service Command Center
          </h1>
          <p class="text-emerald-100 text-lg">
            Real-Time Patient Support • Service Excellence • Issue Resolution
          </p>
          <p class="text-emerald-200 text-sm">
            Advocate: Patient Support Team | Service Level: Premium
          </p>
        </div>
        <div class="text-right">
          <div class="text-emerald-100 font-medium">Service Dashboard</div>
          <div class="text-emerald-200 text-sm" id="service-timestamp">
            {
              new Date().toLocaleTimeString([], {
                hour: "2-digit",
                minute: "2-digit",
              })
            }
          </div>
          <div class="text-emerald-200 text-xs mt-1">🟢 Ready for Service</div>
        </div>
      </div>

      <!-- Service Metrics -->
      <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
        <div class="bg-white bg-opacity-10 rounded-lg p-4 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-2xl font-bold text-white">8</div>
              <div class="text-emerald-200 text-sm">Active Calls</div>
              <div class="text-emerald-300 text-xs">Queue: 2 min wait</div>
            </div>
            <div class="text-3xl opacity-80">📞</div>
          </div>
        </div>

        <div class="bg-white bg-opacity-10 rounded-lg p-4 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-2xl font-bold text-white">23</div>
              <div class="text-emerald-200 text-sm">Today's Tickets</div>
              <div class="text-emerald-300 text-xs">12 resolved</div>
            </div>
            <div class="text-3xl opacity-80">🎧</div>
          </div>
        </div>

        <div class="bg-white bg-opacity-10 rounded-lg p-4 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-2xl font-bold text-white">3</div>
              <div class="text-emerald-200 text-sm">Urgent Issues</div>
              <div class="text-emerald-300 text-xs">Need attention</div>
            </div>
            <div class="text-3xl opacity-80">🚨</div>
          </div>
        </div>

        <div class="bg-white bg-opacity-10 rounded-lg p-4 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-2xl font-bold text-white">96%</div>
              <div class="text-emerald-200 text-sm">Satisfaction</div>
              <div class="text-emerald-300 text-xs">This month</div>
            </div>
            <div class="text-3xl opacity-80">⭐</div>
          </div>
        </div>

        <div class="bg-white bg-opacity-10 rounded-lg p-4 backdrop-blur-sm">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-2xl font-bold text-white">2.3min</div>
              <div class="text-emerald-200 text-sm">Avg Response</div>
              <div class="text-emerald-300 text-xs">Target: 3min</div>
            </div>
            <div class="text-3xl opacity-80">⚡</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Service Alerts -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <!-- Urgent Alerts -->
    <div class="bg-white rounded-lg p-4 shadow-sm border-l-4 border-red-500">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <span class="text-2xl">🚨</span>
        </div>
        <div class="ml-3 flex-1">
          <div class="text-sm font-medium text-gray-900">
            Urgent Patient Issue
          </div>
          <div class="text-sm text-gray-600">
            Sarah Johnson - Payment processing error, appointment tomorrow
          </div>
          <div class="mt-2">
            <button
              class="bg-red-600 text-white px-3 py-1 rounded text-xs hover:bg-red-700"
              >Take Action</button
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Service Updates -->
    <div class="bg-white rounded-lg p-4 shadow-sm border-l-4 border-blue-500">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <span class="text-2xl">ℹ️</span>
        </div>
        <div class="ml-3 flex-1">
          <div class="text-sm font-medium text-gray-900">System Update</div>
          <div class="text-sm text-gray-600">
            Miami Imaging Center - Online booking restored, notify waiting
            patients
          </div>
          <div class="mt-2">
            <button
              class="bg-blue-600 text-white px-3 py-1 rounded text-xs hover:bg-blue-700"
              >View Details</button
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Service Tools -->
  <div class="bg-white rounded-lg shadow-sm mb-6">
    <div class="p-6 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">⚡ Quick Service Tools</h3>
      <p class="text-sm text-gray-600">
        One-click access to common patient service tasks
      </p>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <button
          class="flex flex-col items-center bg-emerald-50 hover:bg-emerald-100 p-4 rounded-lg transition-colors border border-emerald-200"
        >
          <span class="text-2xl mb-2">🔍</span>
          <span class="font-medium text-emerald-800">Patient Lookup</span>
          <span class="text-xs text-emerald-600"
            >Search by name, phone, email</span
          >
        </button>
        <button
          class="flex flex-col items-center bg-blue-50 hover:bg-blue-100 p-4 rounded-lg transition-colors border border-blue-200"
        >
          <span class="text-2xl mb-2">📅</span>
          <span class="font-medium text-blue-800">Quick Schedule</span>
          <span class="text-xs text-blue-600">Book new appointments</span>
        </button>
        <button
          class="flex flex-col items-center bg-purple-50 hover:bg-purple-100 p-4 rounded-lg transition-colors border border-purple-200"
        >
          <span class="text-2xl mb-2">💳</span>
          <span class="font-medium text-purple-800">Payment Center</span>
          <span class="text-xs text-purple-600">Process payments & refunds</span
          >
        </button>
        <button
          class="flex flex-col items-center bg-orange-50 hover:bg-orange-100 p-4 rounded-lg transition-colors border border-orange-200"
        >
          <span class="text-2xl mb-2">📧</span>
          <span class="font-medium text-orange-800">Send Message</span>
          <span class="text-xs text-orange-600">Email, SMS, notifications</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main Patient Advocate System -->
  <PatientAdvocateSystem client:load />

  <!-- Service Enhancement Scripts -->
  <script>
    // Live timestamp update
    function updateServiceTimestamp() {
      const now = new Date();
      const timeString = now.toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      });

      const element = document.getElementById("service-timestamp");
      if (element) {
        element.textContent = timeString;
      }
    }

    setInterval(updateServiceTimestamp, 1000);

    // Service notifications
    function showServiceNotification(
      title,
      message,
      type = "info",
      priority = "normal"
    ) {
      const notification = document.createElement("div");
      const priorityClass =
        priority === "urgent"
          ? "border-red-500 bg-red-50"
          : priority === "high"
            ? "border-yellow-500 bg-yellow-50"
            : "border-blue-500 bg-blue-50";

      notification.className = `fixed top-4 right-4 bg-white border-l-4 ${priorityClass} shadow-lg rounded-lg p-4 z-50 max-w-sm`;

      notification.innerHTML = `
        <div class="flex">
          <div class="flex-shrink-0">
            <span class="text-lg">${priority === "urgent" ? "🚨" : priority === "high" ? "⚠️" : "ℹ️"}</span>
          </div>
          <div class="ml-3">
            <h4 class="text-sm font-medium text-gray-900">${title}</h4>
            <p class="text-sm text-gray-600 mt-1">${message}</p>
            <div class="mt-2">
              <button class="text-xs text-blue-600 hover:text-blue-800" onclick="this.closest('.fixed').remove()">
                Handle Now →
              </button>
            </div>
          </div>
        </div>
      `;

      document.body.appendChild(notification);

      // Auto-remove based on priority
      const autoRemoveTime =
        priority === "urgent" ? 10000 : priority === "high" ? 7000 : 5000;
      setTimeout(() => {
        if (notification.parentNode) {
          notification.remove();
        }
      }, autoRemoveTime);
    }

    // Simulate service notifications
    setTimeout(() => {
      showServiceNotification(
        "Incoming Call",
        "Patient asking about appointment status - Line 3",
        "info",
        "high"
      );
    }, 5000);

    setTimeout(() => {
      showServiceNotification(
        "Payment Alert",
        "Failed payment retry successful - Michael Chen appointment confirmed",
        "success",
        "normal"
      );
    }, 12000);

    setTimeout(() => {
      showServiceNotification(
        "Urgent Issue",
        "Patient complaint escalated - Dr. Rodriguez referral issue needs immediate attention",
        "urgent",
        "urgent"
      );
    }, 18000);

    setTimeout(() => {
      showServiceNotification(
        "Report Available",
        "3 new reports ready for patient notification - Auto-sending enabled",
        "info",
        "normal"
      );
    }, 25000);

    // Call simulation
    let callInProgress = false;
    function simulateIncomingCall() {
      if (!callInProgress) {
        callInProgress = true;
        const callModal = document.createElement("div");
        callModal.className =
          "fixed inset-0 bg-black bg-opacity-75 z-50 flex items-center justify-center";
        callModal.innerHTML = `
          <div class="bg-white rounded-lg p-8 text-center max-w-md">
            <div class="text-6xl mb-4">📞</div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Incoming Call</h3>
            <p class="text-gray-600 mb-4">Patient: Sarah Johnson<br>Phone: (555) 123-4567</p>
            <div class="flex gap-4 justify-center">
              <button onclick="acceptCall()" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700">
                📞 Accept Call
              </button>
              <button onclick="declineCall()" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700">
                ❌ Decline
              </button>
            </div>
          </div>
        `;
        document.body.appendChild(callModal);

        window.acceptCall = function () {
          callModal.remove();
          callInProgress = false;
          showServiceNotification(
            "Call Connected",
            "Sarah Johnson - Line 1 - Duration: Starting now",
            "info",
            "high"
          );
        };

        window.declineCall = function () {
          callModal.remove();
          callInProgress = false;
          showServiceNotification(
            "Call Declined",
            "Sarah Johnson - Sent to voicemail queue",
            "info",
            "normal"
          );
        };

        // Auto-decline after 15 seconds
        setTimeout(() => {
          if (document.body.contains(callModal)) {
            window.declineCall();
          }
        }, 15000);
      }
    }

    // Simulate incoming call
    setTimeout(simulateIncomingCall, 30000);
  </script>
</PatientAdvocateLayout>
