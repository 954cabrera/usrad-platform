---
// patient-promise.astro - The USRad Guarantee
// Carbon Health Style - Modern, Patient-First, Differentiated from Competitors
import CarbonLayout from "../layouts/CarbonLayout.astro";

const effectiveDate = "December 2025";
---

<CarbonLayout
  title="The USRad Guarantee | Patient Promise"
  description="If your exam doesn't happen, you don't pay. USRad's patient promise: transparent pricing, instant refunds, and real protection."
  isHeroPage={false}
>
  <!-- Hero Section - Confident, Not Transactional -->
  <section
    class="bg-gradient-to-br from-[#003087] via-[#0A2F6B] to-[#001F4D] text-white py-20 sm:py-32 relative overflow-hidden"
  >
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute top-20 left-10 w-64 h-64 bg-white rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-10 right-20 w-96 h-96 bg-white rounded-full blur-3xl"
      >
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-10">
      <div
        class="inline-block bg-white/20 backdrop-blur-sm rounded-full px-4 py-2 mb-6"
        data-aos="fade-up"
      >
        <span class="text-sm font-medium">Our Promise to Every Patient</span>
      </div>

      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        The USRad Guarantee
      </h1>

      <p
        class="text-2xl sm:text-3xl text-blue-100 mb-8 font-medium"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        If your exam doesn't happen, you don't pay.
      </p>

      <p
        class="text-lg sm:text-xl text-blue-200 max-w-2xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        One payment covers everything. No surprise bills. No fine print. Just
        straightforward protection that puts you first.
      </p>
    </div>
  </section>

  <!-- Trust Badges Bar -->
  <section class="bg-white border-b border-gray-200 py-6">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div
        class="flex flex-wrap items-center justify-center gap-6 sm:gap-12 text-center"
      >
        <div class="flex items-center gap-2">
          <svg
            class="w-6 h-6 text-green-500"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-gray-700 font-medium"
            >100% Money-Back Guarantee</span
          >
        </div>
        <div class="flex items-center gap-2">
          <svg
            class="w-6 h-6 text-green-500"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-gray-700 font-medium">No Hidden Fees</span>
        </div>
        <div class="flex items-center gap-2">
          <svg
            class="w-6 h-6 text-green-500"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-gray-700 font-medium"
            >Instant Self-Service Refunds</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- HOW REFUNDS WORK - Visual 3-Step Process -->
  <section class="py-16 sm:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12" data-aos="fade-up">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          How Refunds Work
        </h2>
        <p class="text-xl text-gray-600">
          No phone calls. No waiting on hold. No paperwork.
        </p>
      </div>

      <div
        class="grid md:grid-cols-3 gap-8"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <!-- Step 1 -->
        <div class="relative">
          <div
            class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 text-center h-full"
          >
            <div
              class="w-16 h-16 bg-[#003087] rounded-2xl flex items-center justify-center mx-auto mb-6"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <div class="text-sm font-bold text-[#003087] mb-2">STEP 1</div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              Cancel in Your Portal
            </h3>
            <p class="text-gray-600">
              Log into your Patient Portal and cancel with one click. Available
              24/7.
            </p>
          </div>
          <!-- Arrow -->
          <div
            class="hidden md:block absolute top-1/2 -right-4 transform -translate-y-1/2 z-10"
          >
            <svg
              class="w-8 h-8 text-[#003087]"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="relative">
          <div
            class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 text-center h-full"
          >
            <div
              class="w-16 h-16 bg-green-500 rounded-2xl flex items-center justify-center mx-auto mb-6"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div class="text-sm font-bold text-green-600 mb-2">STEP 2</div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              Refund Triggers Instantly
            </h3>
            <p class="text-gray-600">
              No waiting for approval. Your refund begins processing the moment
              you cancel.
            </p>
          </div>
          <!-- Arrow -->
          <div
            class="hidden md:block absolute top-1/2 -right-4 transform -translate-y-1/2 z-10"
          >
            <svg
              class="w-8 h-8 text-[#003087]"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="relative">
          <div
            class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 text-center h-full"
          >
            <div
              class="w-16 h-16 bg-emerald-500 rounded-2xl flex items-center justify-center mx-auto mb-6"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <div class="text-sm font-bold text-emerald-600 mb-2">STEP 3</div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">
              Money Back in Days
            </h3>
            <p class="text-gray-600">
              Refunds hit your account within 5–10 business days. Most see it in
              under a week.
            </p>
          </div>
        </div>
      </div>

      <!-- Comparison callout -->
      <div
        class="mt-12 bg-blue-50 border border-blue-200 rounded-2xl p-6 sm:p-8 text-center"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <p class="text-lg text-blue-800">
          <strong
            >Other programs make you call, wait on hold, and fill out paperwork.</strong
          ><br />
          With USRad, you're in control — cancel and get refunded on your schedule,
          not theirs.
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Navigation -->
  <section class="bg-white border-b border-gray-200 sticky top-16 z-40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <nav
        class="flex items-center justify-center gap-2 sm:gap-6 py-4 overflow-x-auto"
      >
        <a href="#whats-covered" class="nav-pill">What's Covered</a>
        <a href="#payment" class="nav-pill">Payment Terms</a>
        <a href="#cancellation" class="nav-pill">Cancellation</a>
        <a href="#refunds" class="nav-pill">Refunds</a>
      </nav>
    </div>
  </section>

  <!-- WHAT'S COVERED Section -->
  <section id="whats-covered" class="py-16 sm:py-20 bg-white scroll-mt-32">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12" data-aos="fade-up">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          One Payment. Everything Included.
        </h2>
        <p class="text-xl text-gray-600">
          Your USRad price covers the complete exam — no surprise bills.
        </p>
      </div>

      <div
        class="grid sm:grid-cols-2 gap-6"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <!-- Included -->
        <div class="bg-green-50 border border-green-200 rounded-2xl p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-green-800">
              Included in Your Price
            </h3>
          </div>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-green-800"
                ><strong>Imaging facility fee</strong> — the scan itself</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-green-800"
                ><strong>Radiologist fee</strong> — the doctor who reads your scan</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-green-800"
                ><strong>Digital results</strong> — delivered to you and your doctor</span
              >
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-green-800"
                ><strong>Patient support</strong> — real humans if you need help</span
              >
            </li>
          </ul>
        </div>

        <!-- Not Included -->
        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-10 h-10 bg-gray-400 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-700">
              Not Included (You Won't Be Charged)
            </h3>
          </div>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-600">Hidden admin fees</span>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-600">Surprise radiologist bills</span>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-600">Facility "convenience" charges</span>
            </li>
            <li class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-gray-400 flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                  clip-rule="evenodd"></path>
              </svg>
              <span class="text-gray-600">Post-visit "balance due" letters</span
              >
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: Payment Terms -->
  <section id="payment" class="py-16 sm:py-20 bg-gray-50 scroll-mt-32">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="flex items-center gap-4 mb-10" data-aos="fade-up">
        <div
          class="w-12 h-12 bg-[#003087] rounded-xl flex items-center justify-center text-white font-bold text-xl"
        >
          1
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">
          Payment Terms
        </h2>
      </div>

      <!-- Payment Deadline -->
      <div class="policy-card" data-aos="fade-up">
        <h3 class="policy-heading">When Payment is Due</h3>
        <div class="bg-[#003087] text-white rounded-xl p-6 mb-6">
          <p class="text-xl sm:text-2xl font-semibold text-center">
            Payment is due within 24 hours of scheduling.
          </p>
        </div>
        <p class="text-gray-600">
          Booking a same-day or next-day appointment? Payment is required <strong
            >immediately</strong
          > to lock in your time slot. If we don't receive payment by the deadline,
          your appointment may be released to another patient.
        </p>
      </div>

      <!-- What Happens If You Don't Pay -->
      <div class="policy-card" data-aos="fade-up">
        <h3 class="policy-heading">What Happens If You Don't Pay in Time</h3>
        <p class="text-gray-600 mb-4">
          If payment isn't received by the deadline:
        </p>
        <ul class="space-y-3 text-gray-700">
          <li class="flex items-start gap-3">
            <span class="text-gray-400">•</span>
            <span>Your reserved slot may be given to another patient</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gray-400">•</span>
            <span>You'll need to book a new appointment through USRad</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gray-400">•</span>
            <span>No penalty — you simply start fresh</span>
          </li>
        </ul>
      </div>

      <!-- Pay USRad, Not the Center -->
      <div class="policy-card" data-aos="fade-up">
        <h3 class="policy-heading">Pay USRad, Not the Imaging Center</h3>
        <p class="text-gray-600 mb-4">
          Your payment goes to USRad — <strong>never</strong> to the imaging center
          directly. We've already settled both the facility fee and the radiologist
          fee through our network agreement, so there's nothing left for you to pay.
        </p>
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
          <p class="text-amber-800">
            <strong>Heads up:</strong> If anyone asks you for additional payment
            related to your prepaid exam — <strong>don't pay it</strong>.
            Contact us immediately and we'll sort it out.
          </p>
        </div>
      </div>

      <!-- Accepted Payment Methods -->
      <div class="policy-card" data-aos="fade-up">
        <h3 class="policy-heading">Accepted Payment Methods</h3>
        <div class="grid sm:grid-cols-3 gap-4">
          <div class="flex items-center gap-3 bg-gray-50 rounded-lg p-4">
            <svg
              class="w-8 h-8 text-[#003087]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
              ></path>
            </svg>
            <span class="text-gray-700 font-medium">Credit / Debit</span>
          </div>
          <div class="flex items-center gap-3 bg-gray-50 rounded-lg p-4">
            <svg
              class="w-8 h-8 text-green-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
            <span class="text-gray-700 font-medium">HSA Cards</span>
          </div>
          <div class="flex items-center gap-3 bg-gray-50 rounded-lg p-4">
            <svg
              class="w-8 h-8 text-purple-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
