  }

  .policy-heading {
    @apply text-xl sm:text-2xl font-bold text-gray-900 mb-4;
  }

  /* Smooth scroll offset for sticky nav */
  .scroll-mt-32 {
    scroll-margin-top: 8rem;
  }

  /* Active nav state */
  .nav-pill.active {
    @apply bg-[#003087] text-white;
  }
</style>

<script>
  // Highlight active nav pill on scroll
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section[id]");
    const navPills = document.querySelectorAll(".nav-pill");

    const observerOptions = {
      root: null,
      rootMargin: "-20% 0px -70% 0px",
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          navPills.forEach((pill) => {
            pill.classList.remove("active", "bg-[#003087]", "text-white");
            if (pill.getAttribute("href") === `#${id}`) {
              pill.classList.add("active", "bg-[#003087]", "text-white");
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach((section) => {
      if (section.id) observer.observe(section);
    });
  });
</script>
