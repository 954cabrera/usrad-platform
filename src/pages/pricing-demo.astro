---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";

const title = "Medicare Pricing Engine Test";
---

<MainPatientLayout title={title}>
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-3xl font-bold text-gray-900 mb-4">
          Test Medicare Pricing Engine
        </h1>
        <p class="text-xl text-gray-600">
          Real pricing with your Medicare database
        </p>
      </div>

      <div class="bg-gray-50 rounded-xl p-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- ZIP Code Input -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2"
              >ZIP Code</label
            >
            <input
              type="text"
              id="pricingZipCode"
              placeholder="33012"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              maxlength="5"
            />
          </div>

          <!-- Procedure Selection -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2"
              >Procedure</label
            >
            <select
              id="pricingProcedure"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >
              <option value="70551">MRI Brain without contrast</option>
              <option value="72148">MRI Lumbar Spine without contrast</option>
              <option value="74177">CT Abdomen/Pelvis with contrast</option>
              <option value="76700">Ultrasound Abdomen</option>
              <option value="77067">Mammography</option>
            </select>
          </div>

          <!-- Search Button -->
          <div class="flex items-end">
            <button
              id="pricingSearchBtn"
              class="w-full bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-semibold"
            >
              Test Pricing
            </button>
          </div>
        </div>

        <!-- Results Area -->
        <div id="pricingResults" class="mt-8 hidden">
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-lg font-semibold mb-4">Medicare Pricing Results</h3>
            <div id="pricingContent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainPatientLayout>

<script>
  document
    .getElementById("pricingSearchBtn")
    .addEventListener("click", async function () {
      const zipCode = document.getElementById("pricingZipCode").value;
      const procedure = document.getElementById("pricingProcedure").value;

      if (!zipCode) {
        alert("Please enter a ZIP code");
        return;
      }

      const resultsDiv = document.getElementById("pricingResults");
      const contentDiv = document.getElementById("pricingContent");

      // Show loading
      resultsDiv.classList.remove("hidden");
      contentDiv.innerHTML =
        '<div class="text-center py-4">Loading pricing...</div>';

      try {
        const response = await fetch(
          `/api/pricing/quote?zipCode=${zipCode}&cptCode=${procedure}`
        );
        const data = await response.json();

        if (response.ok) {
          contentDiv.innerHTML = `
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="text-center">
              <div class="text-2xl font-bold text-blue-600">$${data.pricing.medicare_global_rate}</div>
              <div class="text-sm text-gray-600">Medicare Rate</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-green-600">$${data.pricing.usrad_price}</div>
              <div class="text-sm text-gray-600">USRad Price</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-red-600">$${data.pricing.hospital_estimate}</div>
              <div class="text-sm text-gray-600">Hospital Estimate</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-green-600">$${data.pricing.patient_savings}</div>
              <div class="text-sm text-gray-600">You Save (${data.pricing.savings_percentage}%)</div>
            </div>
          </div>
          <div class="mt-6 p-4 bg-blue-50 rounded-lg">
            <h4 class="font-semibold mb-2">${data.procedure.description} in ${data.location.locality_name}</h4>
            <p class="text-gray-600">ZIP: ${zipCode} → Medicare Locality: ${data.location.locality_code}</p>
            <div class="mt-2 text-sm text-gray-500">
              <p>Medicare Base Rate: $${data.pricing.medicare_base_rate} + Professional Component (35%) = $${data.pricing.medicare_global_rate}</p>
              <p>USRad Price: Medicare Rate + $75 markup = $${data.pricing.usrad_price}</p>
            </div>
          </div>
        `;
        } else {
          contentDiv.innerHTML = `<div class="text-red-600 text-center">Error: ${data.error}</div>`;
        }
      } catch (error) {
        contentDiv.innerHTML =
          '<div class="text-red-600 text-center">Error getting pricing. Please try again.</div>';
      }
    });
</script>
