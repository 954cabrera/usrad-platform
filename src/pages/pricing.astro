---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import FadeIn from "../components/FadeIn.astro";
import AOSInit from "../components/AOSInit.astro";
import TrustBadgesBar from "../components/TrustBadgesBar.astro";

const pageTitle =
  "Transparent Pricing - Medical Imaging 30-70% Below Hospital Rates | USRad";
const pageDescription =
  "Get high-quality MRI, CT, and ultrasound scans at transparent prices 30-70% below hospital rates. No insurance required. Same-day appointments. 100% quality guarantee.";
const canonicalURL = Astro.site
  ? new URL("/pricing", Astro.site).toString()
  : "/pricing";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: "USRad",
  description: pageDescription,
  url:
    typeof canonicalURL === "string" ? canonicalURL : canonicalURL.toString(),
  logo: "/images/usrad-logo.png",
  priceRange: "$85-$325",
  medicalSpecialty: "Diagnostic Radiology",
};
---

<MainPatientLayout
  showPatientHeader={true}
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  structuredData={structuredData}
>
  <AOSInit />

  <!-- Revised Hero Section (Light Variant) -->
  <FadeIn effect="fade" delay={0}>
    <section class="relative bg-[#fefbf5] py-24 px-6 text-[#003087]">
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">
        <!-- Text Content -->
        <div data-aos="fade-right">
          <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">
            Affordable Medical Imaging,<br />
            <span class="text-[#cc9933]">Backed by a Guarantee.</span>
          </h1>
          <p class="text-lg text-[#003087]/80 mb-6">
            Know your price before you arrive. Book MRI, CT, and ultrasound
            scans for up to <strong class="text-green-600">70% less</strong> than
            hospitals—without the stress.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/search-test"
              class="group bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-bold px-8 py-4 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center gap-2"
            >
              Find Imaging Centers
              <svg
                class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a
              href="#pricing-calculator"
              class="group border-2 border-[#cc9933] text-[#003087] font-semibold px-8 py-4 rounded-xl hover:bg-[#cc9933]/10 transition-all duration-300 inline-flex items-center gap-2"
            >
              Calculate Savings
            </a>
          </div>
        </div>

        <!-- Screenshot or Visual Preview -->
        <div data-aos="fade-left">
          <img
            src="/images/website/search-sample.webp"
            alt="Live pricing example screenshot"
            class="w-full rounded-2xl shadow-xl border border-[#e6c378]/40"
          />
        </div>
      </div>
    </section>
  </FadeIn>

  <!-- Pricing Calculator Section -->
  <section
    id="pricing-calculator"
    class="py-20 bg-gradient-to-br from-[#fefbf5] via-white to-[#f8f5e8]"
  >
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-4xl md:text-5xl font-bold text-[#003087] mb-6">
          Calculate Your Savings
        </h2>
        <p class="text-xl text-[#003087]/80 max-w-3xl mx-auto">
          See exactly how much you can save with transparent pricing
        </p>
      </div>

      <!-- Pricing Cards -->
      <div class="grid lg:grid-cols-3 gap-8 mb-16">
        <!-- MRI Card -->
        <div
          class="group bg-white rounded-3xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 border-2 border-transparent hover:border-[#cc9933]/30 hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div class="text-center mb-8">
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#003087] to-[#1a4fa0] rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M9 12a1 1 0 01-.117-1.993L9 10h2a3 3 0 10-3-3 1 1 0 012 0A1 1 0 1112 7a1 1 0 11-1 1H9a1 1 0 010 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-2">MRI Scan</h3>
            <p class="text-gray-600">Brain, Spine, Joints & More</p>
          </div>

          <div class="text-center mb-8">
            <div class="text-red-500 line-through text-xl mb-2 opacity-75">
              Hospital: $1,200-$8,000
            </div>
            <div class="text-5xl font-black text-[#003087] mb-3">
              $260<span class="text-2xl">-</span>$325
            </div>
            <div
              class="inline-flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-4 py-2 rounded-full text-sm font-bold animate-pulse"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z"
                  clip-rule="evenodd"></path>
              </svg>
              Save up to 96%
            </div>
          </div>

          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >Same equipment as hospitals</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >Results in 24-48 hours</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >No insurance required</span
              >
            </li>
          </ul>

          <a
            href="/search-test?type=mri"
            class="w-full bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-bold py-4 px-6 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            Find MRI Centers
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>

        <!-- CT Card -->
        <div
          class="group bg-white rounded-3xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 border-2 border-transparent hover:border-[#cc9933]/30 hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div class="text-center mb-8">
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#003087] to-[#1a4fa0] rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M4 3a2 2 0 100 4h12a2 2 0 100-4H4zM4 9a2 2 0 100 4h12a2 2 0 100-4H4zM4 15a2 2 0 100 4h12a2 2 0 100-4H4z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-2">CT Scan</h3>
            <p class="text-gray-600">Chest, Abdomen, Head</p>
          </div>

          <div class="text-center mb-8">
            <div class="text-red-500 line-through text-xl mb-2 opacity-75">
              Hospital: $800-$4,000
            </div>
            <div class="text-5xl font-black text-[#003087] mb-3">
              $150<span class="text-2xl">-</span>$225
            </div>
            <div
              class="inline-flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-4 py-2 rounded-full text-sm font-bold animate-pulse"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z"
                  clip-rule="evenodd"></path>
              </svg>
              Save up to 94%
            </div>
          </div>

          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium">Latest CT technology</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >Same-day appointments</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >Expert interpretation</span
              >
            </li>
          </ul>

          <a
            href="/search-test?type=ct"
            class="w-full bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-bold py-4 px-6 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            Find CT Centers
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>

        <!-- Ultrasound Card -->
        <div
          class="group bg-white rounded-3xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 border-2 border-transparent hover:border-[#cc9933]/30 hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div class="text-center mb-8">
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#003087] to-[#1a4fa0] rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM8 12a1 1 0 100-2 1 1 0 000 2zm2-1a1 1 0 11-2 0 1 1 0 012 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-2">Ultrasound</h3>
            <p class="text-gray-600">Abdominal, Pelvic, Vascular</p>
          </div>

          <div class="text-center mb-8">
            <div class="text-red-500 line-through text-xl mb-2 opacity-75">
              Hospital: $400-$1,500
            </div>
            <div class="text-5xl font-black text-[#003087] mb-3">
              $85<span class="text-2xl">-</span>$150
            </div>
            <div
              class="inline-flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-4 py-2 rounded-full text-sm font-bold animate-pulse"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z"
                  clip-rule="evenodd"></path>
              </svg>
              Save up to 90%
            </div>
          </div>

          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >High-resolution imaging</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >No radiation exposure</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >Immediate results available</span
              >
            </li>
          </ul>

          <a
            href="/search-test?type=ultrasound"
            class="w-full bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-bold py-4 px-6 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            Find Ultrasound Centers
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Single Enhanced Search Section -->
  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-4xl md:text-5xl font-bold text-[#003087] mb-6">
          Ready to Get Your Scan?
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Enter your ZIP code to see real-time pricing from imaging centers in
          your area
        </p>
      </div>

      <div
        class="bg-gradient-to-br from-[#fefbf5] to-white rounded-3xl p-8 shadow-2xl max-w-4xl mx-auto"
        data-aos="zoom-in"
      >
        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <div>
            <label class="block text-sm font-semibold text-[#003087] mb-3"
              >Enter Your ZIP Code</label
            >
            <input
              type="text"
              placeholder="ZIP Code"
              class="w-full px-4 py-4 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-[#cc9933] focus:border-transparent text-lg font-medium transition-all duration-300"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-[#003087] mb-3"
              >Study Type (Optional)</label
            >
            <select
              class="w-full px-4 py-4 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-[#cc9933] focus:border-transparent text-lg font-medium appearance-none bg-white transition-all duration-300"
            >
              <option>All imaging types</option>
              <option>MRI - Brain</option>
              <option>MRI - Knee</option>
              <option>CT - Chest</option>
              <option>Ultrasound</option>
            </select>
          </div>
        </div>

        <div class="text-center mb-8">
          <a
            href="/search-test"
            class="bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-bold px-12 py-5 rounded-2xl shadow-2xl hover:scale-105 transition-all duration-300 inline-flex items-center justify-center gap-3 text-xl"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"
                clip-rule="evenodd"></path>
            </svg>
            Find Imaging Centers Near Me
          </a>
        </div>

        <div
          class="flex items-center justify-center gap-8 text-sm text-gray-600 flex-wrap"
        >
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="font-medium">No insurance required</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="font-medium">Same-day booking</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="font-medium">100% guaranteed</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="bg-[#f0f4f9] py-16 px-6">
    <div class="max-w-6xl mx-auto" data-aos="fade-up">
      <TrustBadgesBar />
    </div>
  </section>

  

