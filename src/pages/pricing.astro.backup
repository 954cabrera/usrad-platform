              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Key Benefits -->
      <div
        class="grid md:grid-cols-3 gap-8 mt-16"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div
          class="text-center p-6 bg-white/50 rounded-xl hover:bg-white/80 transition-colors group"
        >
          <div
            class="w-16 h-16 bg-gradient-to-r from-[#cc9933] to-yellow-400 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
