---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import FadeIn from "../components/FadeIn.astro";
import AOSInit from "../components/AOSInit.astro";
import TrustBadgesBar from "../components/TrustBadgesBar.astro";

const pageTitle =
  "Transparent Pricing - Medical Imaging 30-70% Below Hospital Rates | USRad";
const pageDescription =
  "Get high-quality MRI, CT, and ultrasound scans at transparent prices 30-70% below hospital rates. No insurance required. Same-day appointments. 100% quality guarantee.";
const canonicalURL = Astro.site
  ? new URL("/pricing", Astro.site).toString()
  : "/pricing";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: "USRad",
  description: pageDescription,
  url:
    typeof canonicalURL === "string" ? canonicalURL : canonicalURL.toString(),
  logo: "/images/usrad-logo.png",
  priceRange: "$85-$325",
  medicalSpecialty: "Diagnostic Radiology",
};
---

<MainPatientLayout
  showPatientHeader={true}
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  structuredData={structuredData}
>
  <AOSInit />

  <!-- Proven Track Record Banner -->
  <section
    class="bg-gradient-to-r from-[#003087] to-blue-700 text-white py-3 px-6"
  >
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-sm font-medium">
        🏆 <strong>Proven Transparency:</strong> Pricing model perfected through
        400,000+ patient interactions with AnciCare network
      </p>
    </div>
  </section>

  <!-- Revised Hero Section (Light Variant) -->
  <FadeIn effect="fade" delay={0}>
    <section class="relative bg-[#fefbf5] py-24 px-6 text-[#003087]">
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">
        <!-- Text Content -->
        <div data-aos="fade-right">
          <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">
            Affordable Medical Imaging,<br />
            <span class="text-[#cc9933]">Backed by a Guarantee.</span>
          </h1>
          <p class="text-lg text-[#003087]/80 mb-6">
            Know your price before you arrive. Our transparent pricing model,
            perfected through
            <strong class="text-[#cc9933]">400,000+ patient interactions</strong
            >, offers scans for up to
            <strong class="text-green-600">70% less</strong> than hospitals—without
            the stress.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/search-test"
              class="group bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-bold px-8 py-4 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center gap-2"
            >
              Find Imaging Centers
              <svg
                class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a
              href="#pricing-calculator"
              class="group border-2 border-[#cc9933] text-[#003087] font-semibold px-8 py-4 rounded-xl hover:bg-[#cc9933]/10 transition-all duration-300 inline-flex items-center gap-2"
            >
              Calculate Savings
            </a>
          </div>
        </div>

        <!-- Screenshot or Visual Preview -->
        <div data-aos="fade-left">
          <img
            src="/images/website/search-sample.webp"
            alt="Live pricing example screenshot"
            class="w-full rounded-2xl shadow-xl border border-[#e6c378]/40"
          />
        </div>
      </div>
    </section>
  </FadeIn>

  <!-- Pricing Calculator Section -->
  <section
    id="pricing-calculator"
    class="py-20 bg-gradient-to-br from-[#fefbf5] via-white to-[#f8f5e8]"
  >
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-4xl md:text-5xl font-bold text-[#003087] mb-6">
          Calculate Your Savings
        </h2>
        <p class="text-xl text-[#003087]/80 max-w-3xl mx-auto mb-4">
          See exactly how much you can save with transparent pricing
        </p>
        <p class="text-[#cc9933] font-semibold">
          ✅ Pricing transparency perfected over 10 years with 1,200+ imaging
          centers
        </p>
      </div>

      <!-- Pricing Cards -->
      <div class="grid lg:grid-cols-3 gap-8 mb-16">
        <!-- MRI Card -->
        <div
          class="group bg-white rounded-3xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 border-2 border-transparent hover:border-[#cc9933]/30 hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div class="text-center mb-8">
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#003087] to-[#1a4fa0] rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M9 12a1 1 0 01-.117-1.993L9 10h2a3 3 0 10-3-3 1 1 0 012 0A1 1 0 1112 7a1 1 0 11-1 1H9a1 1 0 010 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-2">MRI Scan</h3>
            <p class="text-gray-600">Brain, Spine, Joints & More</p>
          </div>

          <div class="text-center mb-8">
            <div class="text-red-500 line-through text-xl mb-2 opacity-75">
              Hospital: $1,200-$8,000
            </div>
            <div class="text-5xl font-black text-[#003087] mb-3">
              $260<span class="text-2xl">-</span>$325
            </div>
            <div
              class="inline-flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-4 py-2 rounded-full text-sm font-bold animate-pulse"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z"
                  clip-rule="evenodd"></path>
              </svg>
              Save up to 96%
            </div>
          </div>

          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >Same equipment as hospitals</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >Results in 24-48 hours</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >No insurance required</span
              >
            </li>
          </ul>

          <a
            href="/search-test?type=mri"
            class="w-full bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-bold py-4 px-6 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            Find MRI Centers
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>

        <!-- CT Card -->
        <div
          class="group bg-white rounded-3xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 border-2 border-transparent hover:border-[#cc9933]/30 hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div class="text-center mb-8">
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#003087] to-[#1a4fa0] rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M4 3a2 2 0 100 4h12a2 2 0 100-4H4zM4 9a2 2 0 100 4h12a2 2 0 100-4H4zM4 15a2 2 0 100 4h12a2 2 0 100-4H4z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-2">CT Scan</h3>
            <p class="text-gray-600">Chest, Abdomen, Head</p>
          </div>

          <div class="text-center mb-8">
            <div class="text-red-500 line-through text-xl mb-2 opacity-75">
              Hospital: $800-$4,000
            </div>
            <div class="text-5xl font-black text-[#003087] mb-3">
              $150<span class="text-2xl">-</span>$225
            </div>
            <div
              class="inline-flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-4 py-2 rounded-full text-sm font-bold animate-pulse"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z"
                  clip-rule="evenodd"></path>
              </svg>
              Save up to 94%
            </div>
          </div>

          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium">Latest CT technology</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >Same-day appointments</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >Expert interpretation</span
              >
            </li>
          </ul>

          <a
            href="/search-test?type=ct"
            class="w-full bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-bold py-4 px-6 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            Find CT Centers
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>

        <!-- Ultrasound Card -->
        <div
          class="group bg-white rounded-3xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 border-2 border-transparent hover:border-[#cc9933]/30 hover:-translate-y-2"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div class="text-center mb-8">
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#003087] to-[#1a4fa0] rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM8 12a1 1 0 100-2 1 1 0 000 2zm2-1a1 1 0 11-2 0 1 1 0 012 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-2">Ultrasound</h3>
            <p class="text-gray-600">Abdominal, Pelvic, Vascular</p>
          </div>

          <div class="text-center mb-8">
            <div class="text-red-500 line-through text-xl mb-2 opacity-75">
              Hospital: $400-$1,500
            </div>
            <div class="text-5xl font-black text-[#003087] mb-3">
              $85<span class="text-2xl">-</span>$150
            </div>
            <div
              class="inline-flex items-center gap-2 bg-gradient-to-r from-green-500 to-emerald-500 text-white px-4 py-2 rounded-full text-sm font-bold animate-pulse"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z"
                  clip-rule="evenodd"></path>
              </svg>
              Save up to 90%
            </div>
          </div>

          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >High-resolution imaging</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >No radiation exposure</span
              >
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-6 h-6 bg-green-100 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700 font-medium"
                >Immediate results available</span
              >
            </li>
          </ul>

          <a
            href="/search-test?type=ultrasound"
            class="w-full bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-bold py-4 px-6 rounded-xl shadow-lg hover:scale-105 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            Find Ultrasound Centers
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Credibility Callout -->
  <section class="bg-gradient-to-r from-blue-50 to-[#fefbf5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div
        class="bg-white rounded-2xl p-8 shadow-xl border-l-4 border-[#cc9933]"
        data-aos="fade-up"
      >
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div>
            <h3 class="text-2xl font-bold text-[#003087] mb-4">
              Why Our Pricing Model Works
            </h3>
            <p class="text-gray-700 mb-4">
              We didn't just create transparent pricing overnight. Our model is
              the result of
              <strong class="text-[#cc9933]">10 years building AnciCare</strong
              >, where we processed
              <strong class="text-blue-600">400,000+ imaging procedures</strong>
              and proved that high-quality care can be both affordable and profitable.
            </p>
            <div class="flex items-center gap-2 text-green-600 font-medium">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>Proven model with successful exit to public company</span>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4 text-center">
            <div class="bg-blue-50 rounded-lg p-4">
              <div class="text-2xl font-bold text-blue-600">400K+</div>
              <div class="text-sm text-gray-600">Procedures Processed</div>
            </div>
            <div class="bg-green-50 rounded-lg p-4">
              <div class="text-2xl font-bold text-green-600">1,200+</div>
              <div class="text-sm text-gray-600">Centers Managed</div>
            </div>
            <div class="bg-purple-50 rounded-lg p-4">
              <div class="text-2xl font-bold text-purple-600">50%+</div>
              <div class="text-sm text-gray-600">Cost Savings Achieved</div>
            </div>
            <div class="bg-orange-50 rounded-lg p-4">
              <div class="text-2xl font-bold text-orange-600">10</div>
              <div class="text-sm text-gray-600">Years Experience</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Enhanced Search Section with Working Functionality + Map -->
  <section
    class="bg-gradient-to-br from-[#fefbf5] to-white py-20"
    id="search-section"
  >
    <div class="max-w-7xl mx-auto px-6">
      <!-- Top Badge -->
      <div class="text-center mb-6" data-aos="fade-up">
        <span
          class="inline-block bg-[#cc9933]/10 text-[#cc9933] px-4 py-2 rounded-full text-sm font-semibold"
        >
          Search powered by 10 years of imaging center partnerships
        </span>
      </div>

      <!-- Header -->
      <div class="text-center mb-12" data-aos="fade-up" data-aos-delay="100">
        <h2 class="text-4xl md:text-5xl font-bold text-[#003087] mb-6">
          Find Your Imaging Center. Save Hundreds.
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Search our network of trusted, board-certified imaging centers.
          Transparent pricing, proven quality, guaranteed results.
        </p>
      </div>

      <!-- Search Form -->
      <div class="max-w-5xl mx-auto" data-aos="fade-up" data-aos-delay="200">
        <div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
          <form id="searchForm" class="space-y-6">
            <div class="grid md:grid-cols-3 gap-6">
              <!-- ZIP Code -->
              <div>
                <label
                  for="zipCode"
                  class="block text-sm font-semibold text-[#003087] mb-2"
                >
                  ZIP Code *
                </label>
                <input
                  type="text"
                  id="zipCode"
                  name="zipCode"
                  placeholder="Enter ZIP code"
                  required
                  pattern="[0-9]{5}"
                  maxlength="5"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#cc9933] focus:border-[#cc9933] transition-colors"
                />
              </div>

              <!-- Procedure -->
              <div>
                <label
                  for="procedure"
                  class="block text-sm font-semibold text-[#003087] mb-2"
                >
                  Procedure
                </label>
                <select
                  id="procedure"
                  name="procedure"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#cc9933] focus:border-[#cc9933] transition-colors"
                >
                  <option value="70551">MRI Brain (without contrast)</option>
                </select>
              </div>

              <!-- State -->
              <div>
                <label
                  for="state"
                  class="block text-sm font-semibold text-[#003087] mb-2"
                >
                  State
                </label>
                <select
                  id="state"
                  name="state"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#cc9933] focus:border-[#cc9933] transition-colors"
                >
                  <option value="FL">Florida</option>
                  <option value="GA">Georgia</option>
                </select>
              </div>
            </div>

            <!-- Search Button -->
            <div class="flex justify-center pt-4">
              <button
                type="submit"
                id="searchButton"
                class="bg-gradient-to-r from-[#cc9933] to-yellow-400 text-white px-12 py-4 rounded-lg font-bold text-lg hover:from-[#b8862e] hover:to-yellow-500 transform hover:scale-105 transition-all duration-200 shadow-lg hover:shadow-xl"
              >
                <span id="buttonText">Search Providers</span>
                <span id="loadingSpinner" class="hidden">
                  <svg
                    class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <circle
                      class="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      stroke-width="4"></circle>
                    <path
                      class="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                    ></path>
                  </svg>
                  Searching...
