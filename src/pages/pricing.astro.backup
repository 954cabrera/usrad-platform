      <!-- Error Message -->
      <div
        id="errorMessage"
        class="hidden mt-8 bg-red-50 border border-red-200 rounded-lg p-6"
      >
        <div class="flex items-center">
          <svg
            class="w-6 h-6 text-red-600 mr-3"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div>
            <h4 class="text-lg font-semibold text-red-800">Search Error</h4>
            <p class="text-red-600" id="errorText">
              Something went wrong. Please try again.
            </p>
          </div>
        </div>
