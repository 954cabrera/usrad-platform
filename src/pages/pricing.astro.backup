      <!-- Help Section -->
      <div class="mt-16 text-center" data-aos="fade-up" data-aos-delay="400">
        <h3 class="text-2xl font-bold text-[#003087] mb-4">
          Need Help Finding the Right Scan?
        </h3>
        <p class="text-gray-600 mb-6">
          Our expert team has guided 400,000+ patients through their imaging
          journey. Call us for personalized assistance.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="tel:1-800-123-4567"
            class="bg-[#003087] text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-800 transition-colors"
          >
            Call (800) 123-4567
          </a>
          <a
            href="/contact"
            class="border-2 border-[#cc9933] text-[#cc9933] px-8 py-3 rounded-lg font-semibold hover:bg-[#cc9933] hover:text-white transition-colors"
          >
            Get Expert Guidance
          </a>
          <button
            onclick="testWithMockData()"
            class="bg-green-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors text-sm"
          >
            🧪 Test with Mock Data
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- JavaScript for search functionality with Map Integration -->
  <script is:inline>
    (function () {
      console.log("🚀 Enhanced search script with map loading...");

      // Global variables for map and search
      let map = null;
      let markers = [];
      let userMarker = null;
      let allProviders = [];
      let searchStartTime = 0;

      // Define initMap globally for Google Maps callback
      window.initMap = function () {
        console.log("🗺️ initMap function called");
        const mapContainer = document.getElementById("map");
        console.log("📍 Map container found:", mapContainer);

        if (!mapContainer) {
          console.error('❌ Map container with id="map" not found!');
          return;
        }

        console.log("🎯 Creating Google Map...");

        // Hide the map initially until we have results
        mapContainer.style.display = "none";

        try {
          window.map = new google.maps.Map(mapContainer, {
            zoom: 10,
            center: { lat: 26.1224, lng: -80.1373 }, // Default to Fort Lauderdale
            mapTypeControl: false,
            streetViewControl: false,
            styles: [
              {
                featureType: "poi",
                elementType: "labels",
                stylers: [{ visibility: "off" }],
              },
              {
                featureType: "transit",
                elementType: "labels",
                stylers: [{ visibility: "off" }],
              },
            ],
          });

          console.log("✅ Google Map created successfully!");

          // Set global map reference
          map = window.map;
          window.mapInitialized = true;
        } catch (error) {
          console.error("❌ Error creating map:", error);
        }
      };

      function initSearch() {
        const searchForm = document.getElementById("searchForm");
        const searchButton = document.getElementById("searchButton");
        const buttonText = document.getElementById("buttonText");
        const loadingSpinner = document.getElementById("loadingSpinner");
        const searchResults = document.getElementById("searchResults");
        const errorMessage = document.getElementById("errorMessage");
        const zipCodeInput = document.getElementById("zipCode");

        if (!searchForm) {
          console.log("Search form not found, retrying...");
          setTimeout(initSearch, 100);
          return;
        }

        console.log("✅ Search form initialized");

        // ZIP code validation
        zipCodeInput.addEventListener("input", function (e) {
          let value = e.target.value.replace(/\D/g, "");
          if (value.length > 5) {
            value = value.slice(0, 5);
          }
          e.target.value = value;
        });

        // Form submission
        searchForm.addEventListener("submit", function (e) {
          e.preventDefault();
          console.log("📝 Form submitted");
          searchProviders();
        });

        async function searchProviders() {
          searchStartTime = Date.now();
          const zipCode = document.getElementById("zipCode").value.trim();
          const procedure = document.getElementById("procedure").value;
          const state = document.getElementById("state").value;

          console.log("🔍 Search params:", { zipCode, procedure, state });

          const cptCode = procedure; // This will be "70551"
          console.log("💡 CPT Code:", cptCode);

          // Validate ZIP code
          if (!zipCode || zipCode.length !== 5) {
            showError("Please enter a valid 5-digit ZIP code.");
            return;
          }

          // Show loading state
          buttonText.classList.add("hidden");
          loadingSpinner.classList.remove("hidden");
          searchButton.disabled = true;
          hideError();
          hideResults();

          try {
            const startTime = Date.now();

            const apiUrl = `/api/centers/search-with-pricing?state=${state}&cptCode=${cptCode}&zipCode=${zipCode}`;
            console.log("🌐 API URL:", apiUrl);

            const response = await fetch(apiUrl);

            const endTime = Date.now();
            const searchTime = ((endTime - startTime) / 1000).toFixed(1);

            console.log("📡 API response status:", response.status);

            if (!response.ok) {
              throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();
            console.log("📊 API response data:", data);

            if (data.results && data.results.length > 0) {
              console.log("✅ Found", data.results.length, "providers");
              allProviders = data.results;

              // Hide loading and show results
              hideLoadingState();
              showResults();

              // Update search summary
              updateSearchSummary(allProviders, zipCode, cptCode);

              // Render results
              renderResults(allProviders, "price_low");

              // Add map markers
              addMapMarkers(allProviders);

              // Geocode user location
              if (zipCode) {
                await geocodeZipCode(zipCode);
              }
            } else {
              console.log("❌ No results found");
              showError(
                `No imaging centers found for ZIP ${zipCode}. Try a different ZIP code like 33012 (Miami) or contact us for assistance.`
              );
            }
          } catch (error) {
            console.error("💥 Search error:", error);
            showError(
              "Unable to search providers at this time. Please try again or contact us directly."
            );
          } finally {
            // Reset button state
            buttonText.classList.remove("hidden");
            loadingSpinner.classList.add("hidden");
            searchButton.disabled = false;
          }
        }

        // Enhanced loading state
        function showLoadingState() {
          document.getElementById("loadingState")?.classList.remove("hidden");
          document.getElementById("resultsContainer")?.classList.add("hidden");
        }

        function hideLoadingState() {
          document.getElementById("loadingState")?.classList.add("hidden");
        }

        function showResults() {
          searchResults.classList.remove("hidden");
        }

        function updateSearchSummary(providers, zipCode, procedure) {
          const searchTime = ((Date.now() - searchStartTime) / 1000).toFixed(1);
          const procedureText = "MRI Brain without contrast";

          // Calculate metrics
          const avgSavings =
            providers.length > 0
              ? Math.round(
                  providers.reduce(
                    (sum, p) => sum + (p.pricing?.savings_percentage || 0),
                    0
                  ) / providers.length
                )
              : 0;

          const bestSavings =
            providers.length > 0
              ? Math.max(
                  ...providers.map((p) => p.pricing?.patient_savings || 0)
                )
              : 0;

          // Update summary text
          document.getElementById("summaryText").textContent =
            `Found ${providers.length} providers for ${procedureText} near ${zipCode} • Searched in ${searchTime}s`;

          // Update metrics
          document.getElementById("avgSavings").textContent = `${avgSavings}%`;
          document.getElementById("totalSavings").textContent =
            `$${Math.round(bestSavings).toLocaleString()}`;
          document.getElementById("searchTime").textContent = `${searchTime}s`;
        }

        function renderResults(providers, sortBy = "price_low") {
          const container = document.getElementById("providerResults");
          const title = document.getElementById("resultsTitle");

          title.textContent = `Found ${providers.length} providers`;

          if (providers.length === 0) {
            container.innerHTML = `
          <div class="text-center py-12">
            <div class="text-gray-400 mb-4">
              <svg class="w-16 h-16 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No providers found</h3>
            <p class="text-gray-500">Try adjusting your search criteria or expanding your search radius.</p>
          </div>
        `;
            return;
          }

          // Sort providers
          const sortedProviders = [...providers].sort((a, b) => {
            switch (sortBy) {
              case "price_high":
                return (
                  (b.pricing?.patient_price || 0) -
                  (a.pricing?.patient_price || 0)
                );
              case "savings_high":
                return (
                  (b.pricing?.patient_savings || 0) -
                  (a.pricing?.patient_savings || 0)
                );
              case "distance":
                return (
                  (a.location?.distance_miles || 0) -
                  (b.location?.distance_miles || 0)
                );
              default: // price_low
                return (
                  (a.pricing?.patient_price || 0) -
                  (b.pricing?.patient_price || 0)
                );
            }
          });

          // Enhanced provider cards
          container.innerHTML = sortedProviders
            .map((provider, index) => {
              const pricing = provider.pricing || {};
              const location = provider.location || {};

              const price = pricing.patient_price || 0;
              const savings = pricing.patient_savings || 0;
              const hospitalPrice = pricing.hospital_estimate || 0;
              const savingsPercent = pricing.savings_percentage || 0;

              return `
          <div class="provider-card bg-white rounded-xl shadow-md p-6 mb-6 hover:shadow-xl transition-all duration-300 border-l-4 ${getBorderClass(index)}" 
               data-provider-index="${index}"
               onmouseenter="highlightMarker && highlightMarker(${index})" 
               onmouseleave="unhighlightMarker && unhighlightMarker(${index})">
            
            <!-- Provider Header -->
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <div class="flex items-center mb-2">
                  <h3 class="text-xl font-bold text-gray-900 mr-3">${provider.name}</h3>
                  ${getBadge(index)}
                </div>
                <div class="flex items-center text-gray-600 mb-2">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-sm">${location.city}, ${location.state}</span>
                </div>
                <div class="flex items-center text-green-600 text-sm font-medium mb-2">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                  ✅ Available for booking
                </div>
                <div class="inline-flex items-center bg-blue-50 text-blue-700 px-3 py-1 rounded-full text-sm font-medium mb-3">
                  <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                  </svg>
                  ${getRandomDistance()} miles away
                </div>
              </div>
              <div class="text-right">
                <div class="text-3xl font-bold text-green-600 mb-1">$${price.toFixed(2)}</div>
                <div class="text-sm text-gray-500">Medicare + $75</div>
                <div class="text-xs text-green-600 font-medium mt-1">${savingsPercent}% OFF Hospital</div>
              </div>
            </div>

            <!-- Enhanced Pricing Breakdown -->
            <div class="bg-gradient-to-r from-green-50 to-blue-50 rounded-lg p-4 mb-4 border border-green-200">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <div class="text-sm text-gray-600 mb-1">You Save</div>
                  <div class="text-2xl font-bold text-green-600">$${savings.toFixed(2)}</div>
                </div>
                <div>
                  <div class="text-sm text-gray-600 mb-1">vs Hospital</div>
                  <div class="text-lg text-red-500 line-through font-semibold">$${hospitalPrice.toFixed(2)}</div>
                </div>
              </div>
            </div>

            <!-- Book Now Button -->
            <div class="flex justify-end items-start mb-2">
              <a href="/book?facilityId=${provider.id}&procedure=MRI Brain without contrast&cptCode=70551&price=${price}"
                 class="inline-flex items-center gap-2 bg-gradient-to-r from-[#cc9933] to-yellow-400 text-[#003087] font-semibold text-sm px-5 py-2.5 rounded-full shadow hover:scale-105 hover:shadow-xl transition-all duration-200">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M17 16l4-4m0 0l-4-4m4 4H3" />
                </svg>
                Book Now & Save
              </a>
            </div>
          </div>
        `;
            })
            .join("");
        }

        // Map functionality
        function addMapMarkers(providers) {
          console.log(
            "🗺️ Adding map markers for",
            providers.length,
            "providers"
          );

          // Check if Google Maps is loaded at all
          if (!window.google) {
            console.log("❌ Google Maps API not loaded yet, waiting...");
            setTimeout(() => addMapMarkers(providers), 1000);
            return;
          }

          if (!window.map) {
            console.log("❌ Map not initialized yet, trying to initialize...");
            if (window.google && window.google.maps) {
              window.initMap();
              setTimeout(() => addMapMarkers(providers), 500);
            }
            return;
          }

          console.log("✅ Map is ready, proceeding with markers...");

          // Clear existing markers
          if (markers.length > 0) {
            markers.forEach((marker) => marker.setMap(null));
            markers = [];
          }

          const bounds = new google.maps.LatLngBounds();

          providers.forEach((provider, index) => {
            try {
              const coordinates = getProviderCoordinates(provider);

              let markerColor;
              const savingsPercent = provider.pricing?.savings_percentage || 0;

              if (index < 3) {
                markerColor = "#10B981"; // Top 3: Bright green
              } else if (savingsPercent >= 75) {
                markerColor = "#059669"; // High savings: Dark green
              } else if (savingsPercent >= 70) {
                markerColor = "#3B82F6"; // Good savings: Blue
              } else {
                markerColor = "#6B7280"; // Lower savings: Gray
              }

              const marker = new google.maps.Marker({
                position: coordinates,
                map: window.map,
                title: provider.name,
                icon: {
                  path: google.maps.SymbolPath.CIRCLE,
                  scale: index < 3 ? 10 : 8,
                  fillColor: markerColor,
                  fillOpacity: 1,
                  strokeColor: "#ffffff",
                  strokeWeight: 2,
                },
              });

              // Info window
              const infoWindow = new google.maps.InfoWindow({
                content: `
              <div style="padding: 6px; width: 180px; font-family: system-ui;">
                <h3 style="margin: 0; color: #1f2937; font-size: 12px; font-weight: 600;">${provider.name}</h3>
                <div style="color: #6b7280; font-size: 9px; margin-bottom: 6px;">📍 ${provider.location?.city}, ${provider.location?.state}</div>
                <div style="background: #f8f9fa; padding: 6px; border-radius: 4px;">
                  <div style="color: #10b981; font-size: 16px; font-weight: 800;">$${(provider.pricing?.patient_price || 0).toFixed(2)}</div>
                  <div style="font-size: 8px; color: #059669;">Save $${(provider.pricing?.patient_savings || 0).toFixed(0)} vs hospital</div>
                </div>
              </div>
            `,
                maxWidth: 180,
              });

              marker.addListener("click", () => {
                markers.forEach((m) => m.infoWindow?.close());
                infoWindow.open(window.map, marker);
              });

              marker.infoWindow = infoWindow;
              markers.push(marker);
              bounds.extend(coordinates);
            } catch (error) {
              console.error(
                "Error creating marker for provider:",
                provider.name,
                error
              );
            }
          });

          // Fit map to show all markers
          try {
            if (providers.length > 0) {
              window.map.fitBounds(bounds, { padding: 50 });

              google.maps.event.addListenerOnce(
                window.map,
                "bounds_changed",
                () => {
                  if (window.map.getZoom() > 12) {
                    window.map.setZoom(12);
                  }
                }
              );
            }
          } catch (error) {
            console.error("Error fitting map bounds:", error);
          }

          // Show the map container when we have results
          const mapContainer = document.getElementById("map");
          if (mapContainer && providers.length > 0) {
            mapContainer.style.display = "block";
            mapContainer.style.opacity = "0";
            mapContainer.style.transition = "opacity 0.5s ease";

            setTimeout(() => {
              mapContainer.style.opacity = "1";
            }, 50);

            console.log(
              "🎨 Map container made visible with",
              providers.length,
              "markers"
            );
          }
        }

        function getProviderCoordinates(provider) {
          const cityCoordinates = {
            Miami: { lat: 25.7617, lng: -80.1918 },
            "Fort Lauderdale": { lat: 26.1224, lng: -80.1373 },
            Tampa: { lat: 27.9506, lng: -82.4572 },
            Orlando: { lat: 28.5383, lng: -81.3792 },
            Jacksonville: { lat: 30.3322, lng: -81.6557 },
            "Vero Beach": { lat: 27.6386, lng: -80.3973 },
            "Ormond Beach": { lat: 29.2858, lng: -81.0659 },
            Hialeah: { lat: 25.8576, lng: -80.2781 },
            "Port Richey": { lat: 28.2697, lng: -82.7193 },
            Tallahassee: { lat: 30.4518, lng: -84.2807 },
            Lakeland: { lat: 28.0395, lng: -81.9498 },
            Atlanta: { lat: 33.749, lng: -84.388 },
            Gainesville: { lat: 29.6516, lng: -82.3248 },
            Pensacola: { lat: 30.4213, lng: -87.2169 },
            Sarasota: { lat: 27.3364, lng: -82.5307 },
          };

          const city = provider.location?.city;
          const coords = cityCoordinates[city];

          if (coords) {
            return {
              lat: coords.lat + (Math.random() - 0.5) * 0.01,
              lng: coords.lng + (Math.random() - 0.5) * 0.01,
            };
          }

          return { lat: 26.1224, lng: -80.1373 };
        }

        async function geocodeZipCode(zipCode) {
          if (!zipCode || !window.google) return null;

          try {
            const geocoder = new google.maps.Geocoder();
            const result = await new Promise((resolve, reject) => {
              geocoder.geocode(
                { address: zipCode + ", USA" },
                (results, status) => {
                  if (status === "OK" && results[0]) {
                    resolve(results[0]);
                  } else {
                    reject(new Error("Geocoding failed"));
                  }
                }
              );
            });

            const location = result.geometry.location;

            if (userMarker) {
              userMarker.setMap(null);
            }

            userMarker = new google.maps.Marker({
              position: location,
              map: window.map,
              title: `Your location: ${zipCode}`,
              icon: {
                path: google.maps.SymbolPath.CIRCLE,
                scale: 8,
                fillColor: "#1D4ED8",
                fillOpacity: 1,
                strokeColor: "#ffffff",
                strokeWeight: 3,
              },
            });

            console.log("✅ User location marker added");
          } catch (error) {
            console.error("Geocoding error:", error);
          }
        }

        // Helper functions
        function getRandomDistance() {
          return (Math.random() * 30 + 2).toFixed(1);
        }

        function getBorderClass(index) {
          if (index === 0) return "border-yellow-400";
          if (index === 1) return "border-green-400";
          if (index === 2) return "border-blue-400";
          return "border-gray-200";
        }

        function getBadge(index) {
          if (index === 0)
            return '<span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-xs font-bold">🥇 Best Deal</span>';
          if (index === 1)
            return '<span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-xs font-bold">🥈 Great Value</span>';
          if (index === 2)
            return '<span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-xs font-bold">🥉 Good Choice</span>';
          return "";
        }

        function showError(message) {
          document.getElementById("errorText").textContent = message;
          errorMessage.classList.remove("hidden");
          errorMessage.scrollIntoView({ behavior: "smooth", block: "start" });
        }

        function hideError() {
          errorMessage.classList.add("hidden");
        }

        function hideResults() {
          searchResults.classList.add("hidden");
        }

        // Test function with mock data
        function testWithMockData() {
          console.log("🧪 Testing with mock data...");

          const mockData = [
            {
              id: "test-1",
              name: "Pembroke Pines Imaging Center",
              location: {
                city: "Pembroke Pines",
                state: "FL",
                distance_miles: 2.1,
              },
              pricing: {
                patient_price: 285,
                hospital_estimate: 1200,
                patient_savings: 915,
                savings_percentage: 76,
              },
            },
            {
              id: "test-2",
              name: "Miramar Medical Imaging",
              location: { city: "Miramar", state: "FL", distance_miles: 4.8 },
              pricing: {
                patient_price: 265,
                hospital_estimate: 1200,
                patient_savings: 935,
                savings_percentage: 78,
              },
            },
          ];

          buttonText.classList.add("hidden");
          loadingSpinner.classList.remove("hidden");
          searchButton.disabled = true;
          hideError();
          hideResults();

          setTimeout(() => {
            buttonText.classList.remove("hidden");
            loadingSpinner.classList.add("hidden");
            searchButton.disabled = false;

            allProviders = mockData;
            showResults();
            updateSearchSummary(mockData, "33330", "70551");
            renderResults(mockData, "price_low");
            addMapMarkers(mockData);
          }, 1000);
        }

        // Global marker highlighting functions
        window.highlightMarker = function (index) {
          if (markers[index] && window.google) {
            markers[index].setAnimation(google.maps.Animation.BOUNCE);
            setTimeout(() => {
              if (markers[index]) {
                markers[index].setAnimation(null);
              }
            }, 1500);
          }
        };

        window.unhighlightMarker = function (index) {
          if (markers[index]) {
            markers[index].setAnimation(null);
          }
        };

        // Make functions globally available
        window.testWithMockData = testWithMockData;
        window.searchProviders = searchProviders;
      }

      // Initialize when DOM is ready
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initSearch);
      } else {
        initSearch();
      }
    })();
  </script>

  <!-- Google Maps API Script -->
  <script
    define:vars={{
      googleMapsApiKey: import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY,
    }}
  >
    // Load Google Maps API using your existing setup
    if (googleMapsApiKey) {
      console.log("🗺️ Loading Google Maps API with key");
      const script = document.createElement("script");
      script.src = `https://maps.googleapis.com/maps/api/js?key=${googleMapsApiKey}&callback=initMap&libraries=places`;
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    } else {
      console.error(
        "❌ Google Maps API key not found in environment variables"
      );
      // Show placeholder in map container
      setTimeout(() => {
        const mapContainer = document.getElementById("map");
        if (mapContainer) {
          mapContainer.innerHTML = `
          <div class="h-full flex items-center justify-center bg-gray-100">
            <div class="text-center text-gray-500">
              <svg class="w-16 h-16 mx-auto mb-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
              </svg>
              <p class="text-sm">Map view unavailable</p>
              <p class="text-xs mt-1">Google Maps API key needed</p>
            </div>
          </div>
        `;
        }
      }, 1000);
    }
  </script>

