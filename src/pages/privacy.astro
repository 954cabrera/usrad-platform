---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout title="Privacy Policy - USRad" isHeroPage={false}>
  <AOSInit />

  <!-- Clean Hero Section -->
  <section
    class="relative bg-gradient-to-b from-blue-50 to-white py-24 overflow-hidden"
  >
    <!-- Dot pattern background -->
    <div class="absolute inset-0 opacity-[0.15]">
      <div
        class="absolute inset-0"
        style="background-image: radial-gradient(circle at 1px 1px, #003087 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl" data-aos="fade-up">
        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 mb-6"
        >
          Privacy Policy
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 mb-8">
          Your privacy is our priority. Learn how USRad protects and handles
          your personal information.
        </p>
        <div class="text-sm text-gray-500">Last updated: January 2025</div>
      </div>
    </div>
  </section>

  <!-- Main Content - Clean and Minimal -->
  <section class="py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Effective Date - Simple -->
      <div class="text-center mb-16" data-aos="fade-up">
        <p class="text-gray-600">Effective Date</p>
        <p class="text-2xl font-bold text-gray-900">May 13, 2025</p>
        <p class="text-sm text-gray-500 mt-1">Last Updated: December 2024</p>
      </div>

      <!-- Introduction - Clean prose -->
      <div class="prose prose-lg max-w-none mb-20" data-aos="fade-up">
        <p class="text-xl text-gray-700 leading-relaxed">
          USRad is committed to protecting your privacy. This Privacy Policy
          describes how we collect, use, and protect your information when you
          use our services. We believe in complete transparency about our data
          practices.
        </p>
      </div>

      <!-- Section 1: What We Collect - Minimal Cards -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">What We Collect</h2>

        <div class="space-y-6">
          <div class="bg-gray-50 rounded-xl p-8">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">
              Personal Information
            </h3>
            <div class="space-y-3 text-gray-600">
              <p>• Name, email, and phone number when you book appointments</p>
              <p>• Physician information for result delivery</p>
              <p>• Location data (ZIP code) to find nearby centers</p>
            </div>
          </div>

          <div class="bg-gray-50 rounded-xl p-8">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">
              Technical Information
            </h3>
            <div class="space-y-3 text-gray-600">
              <p>• Browser type and device information</p>
              <p>• IP address for security and fraud prevention</p>
              <p>• Pages visited to improve our service</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: How We Use It - Clean List -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">
          How We Use Your Information
        </h2>

        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <div
              class="w-8 h-8 bg-[#003087] rounded-lg flex items-center justify-center flex-shrink-0 mt-1"
            >
              <span class="text-white text-sm">1</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">
                To Provide Our Service
              </h3>
              <p class="text-gray-600">
                Schedule appointments, send confirmations, and deliver your
                imaging results.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-8 h-8 bg-[#003087] rounded-lg flex items-center justify-center flex-shrink-0 mt-1"
            >
              <span class="text-white text-sm">2</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">
                To Coordinate Your Care
              </h3>
              <p class="text-gray-600">
                Share results with your physician when you authorize us to do
                so.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-8 h-8 bg-[#003087] rounded-lg flex items-center justify-center flex-shrink-0 mt-1"
            >
              <span class="text-white text-sm">3</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">
                To Improve Our Platform
              </h3>
              <p class="text-gray-600">
                Analyze usage patterns to enhance user experience and fix
                issues.
              </p>
            </div>
          </div>
        </div>

        <!-- Important Notice -->
        <div class="mt-8 p-6 bg-[#003087] text-white rounded-xl">
          <p class="font-semibold">We Never Sell Your Data</p>
          <p class="text-white/80 text-sm mt-1">
            Your health information stays between you, your doctor, and the
            imaging center.
          </p>
        </div>
      </div>

      <!-- Section 3: Data Security - Visual but Clean -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">
          How We Protect Your Data
        </h2>

        <div class="grid md:grid-cols-3 gap-6 text-center">
          <div>
            <div
              class="w-20 h-20 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-3xl">🔒</span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">256-bit Encryption</h3>
            <p class="text-sm text-gray-600">
              Bank-level security for all data transmission
            </p>
          </div>
          <div>
            <div
              class="w-20 h-20 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-3xl">🏥</span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">HIPAA Compliant</h3>
            <p class="text-sm text-gray-600">
              Full healthcare privacy compliance
            </p>
          </div>
          <div>
            <div
              class="w-20 h-20 bg-gray-100 rounded-2xl flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-3xl">🛡️</span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Regular Audits</h3>
            <p class="text-sm text-gray-600">
              Third-party security assessments
            </p>
          </div>
        </div>
      </div>

      <!-- Your Rights - Simple Grid -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Your Rights</h2>

        <p class="text-gray-600 mb-8">
          You have complete control over your personal information:
        </p>

        <div class="grid md:grid-cols-3 gap-4">
          <div
            class="border border-gray-200 rounded-lg p-6 text-center hover:border-[#003087] transition"
          >
            <h3 class="font-semibold text-gray-900 mb-2">Access</h3>
            <p class="text-sm text-gray-600">View all data we have about you</p>
          </div>
          <div
            class="border border-gray-200 rounded-lg p-6 text-center hover:border-[#003087] transition"
          >
            <h3 class="font-semibold text-gray-900 mb-2">Update</h3>
            <p class="text-sm text-gray-600">
              Correct any inaccurate information
            </p>
          </div>
          <div
            class="border border-gray-200 rounded-lg p-6 text-center hover:border-[#003087] transition"
          >
            <h3 class="font-semibold text-gray-900 mb-2">Delete</h3>
            <p class="text-sm text-gray-600">Request removal of your data</p>
          </div>
        </div>
      </div>

      <!-- Other Sections - Simplified -->
      <div class="space-y-16">
        <!-- Cookies -->
        <div data-aos="fade-up">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            Cookies & Tracking
          </h2>
          <p class="text-gray-600">
            We use essential cookies to make our site work and analytics cookies
            to understand how you use it. You can adjust your browser settings
            to control cookies at any time.
          </p>
        </div>

        <!-- Children's Privacy -->
        <div data-aos="fade-up">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            Children's Privacy
          </h2>
          <p class="text-gray-600">
            Our website is not intended for children under 13. We do not
            knowingly collect personal information from minors.
          </p>
        </div>

        <!-- Updates -->
        <div data-aos="fade-up">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Policy Updates</h2>
          <p class="text-gray-600">
            We may update this policy periodically. The latest version will
            always be available here with the updated effective date.
          </p>
        </div>
      </div>

      <!-- Contact Section - Matching Homepage Style -->
      <div
        class="mt-20 text-center py-16 border-t border-gray-200"
        data-aos="fade-up"
      >
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Privacy Questions?
        </h2>
        <p class="text-xl text-gray-600 mb-8">
          Our privacy team is here to help.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="mailto:support@usrad.com"
            class="inline-flex items-center gap-2 text-[#003087] hover:text-[#002266] font-medium text-lg transition"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            support@usrad.com
          </a>
          <span class="text-gray-400 hidden sm:inline">•</span>
          <a
            href="tel:1-866-872-7324"
            class="inline-flex items-center gap-2 text-[#003087] hover:text-[#002266] font-medium text-lg transition"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            1-866-USRad-24
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Minimal animations */
    .prose > * {
      margin-bottom: 1.5rem;
    }

    /* Clean hover states */
    a {
      transition: all 0.2s ease;
    }
  </style>
</CarbonLayout>
