---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <!-- Provider Marketplace Recruitment Page -->
  <!-- Hero Section
-->
  <section
    class="py-28 px-6 sm:px-12 bg-gradient-to-br from-[#fcf9f0]
to-[#ffffff]"
  >
    <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16
items-center">
      <div>
        <h1 class="text-6xl font-extrabold mb-6">
          Stop Leaving Money on the Table
        </h1>
        <p class="text-xl text-[#cc9933] font-semibold mb-4">
          Set your rate. Get booked. Get paid fast.
        </p>
        <p class="text-lg mb-8">
          Join USRad’s patient-facing marketplace and turn idle scan time into
          consistent monthly revenue. Competitive pricing gets you higher
          visibility—and more patient volume.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/login/imaginglogin"
            class="bg-[#cc9933] text-[#003087] px-10 py-4 rounded-full font-bold text-lg
text-center hover:bg-[#b8862e] shadow-md"
          >
            Start Onboarding →
          </a>
          <a
            href="#marketplace"
            class="border-2 border-[#003087] px-10 py-4 rounded-full
font-semibold text-lg text-center hover:bg-[#003087] hover:text-white"
          >
            Learn Marketplace Model
          </a>
        </div>
        <p class="text-sm text-gray-600 mt-4
italic">
          Network entry is open—regional panels may close as capacity fills.
        </p>
      </div>
      <div class="bg-white shadow-xl rounded-2xl p-8 border border-gray-100">
        <h2 class="text-2xl font-bold mb-6">Monthly Revenue Snapshot</h2>
        <div class="space-y-4">
          <div class="flex justify-between border-b pb-2">
            <span class="text-gray-600">MRI scans filled/month</span>
            <span class="font-bold
text-green-600">15–25</span>
          </div>
          <div class="flex justify-between border-b
pb-2">
            <span class="text-gray-600">Avg. reimbursement</span>
            <span class="font-bold text-green-600">$425–$650</span>
          </div>
          <div
            class="flex
justify-between pt-4 text-xl font-semibold text-[#003087]"
          >
            <span>Est. monthly revenue</span>
            <span class="text-[#cc9933] text-3xl
font-bold">$8,500–$15,200</span>
          </div>
        </div>
        <p class="text-sm text-gray-500
mt-4">
          Based on Medicare-based rates and market visibility.
        </p>
      </div>
    </div>
  </section>
  <!-- Marketplace Model -->
  <section id="marketplace" class="py-24
bg-white px-6 sm:px-12">
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-6">Transparent Marketplace Pricing</h2>
      <p class="text-lg text-gray-700 mb-12">
        Patients compare centers based on pricing. Providers who set competitive
        rates rank higher and earn more volume. Every facility is
        quality-screened—so patients can choose based on cost with confidence.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
        <div class="bg-[#fef8e5] p-6 rounded-xl shadow">
          <h3 class="text-xl font-bold
mb-2">📊 How Ranking Works</h3>
          <ul class="list-disc pl-6 text-gray-700
space-y-2">
            <li>Providers set their own reimbursement level</li>
            <li>
              Patient search results rank centers from lowest to highest price
            </li>
            <li>More competitive = more visibility = more bookings</li>
          </ul>
        </div>
        <div class="bg-[#fef8e5] p-6 rounded-xl shadow">
          <h3 class="text-xl font-bold
mb-2">📈 Sample Volume by Price</h3>
          <table class="w-full text-left text-sm
text-gray-700 mt-2">
            <thead>
              <tr class="font-bold">
                <th class="pb-2">Reimbursement</th>
                <th class="pb-2">Est. Volume</th>
              </tr>
            </thead>
            <tbody>
              <tr> <td>90% of Medicare</td> <td>🔥 30+ patients/mo</td> </tr>
              <tr>
                <td>100% of Medicare</td>
                <td>✅ 15–25 patients/mo</td>
              </tr>
              <tr> <td>110% of Medicare</td> <td>⚠️ 7–12 patients/mo</td> </tr>
              <tr>
                <td>130% of Medicare</td>
                <td>🔻 2–5 patients/mo</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
  <!-- Referral Flywheel -->
  <section class="py-24 bg-[#f8f2e1] px-6
sm:px-12 text-center">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl
font-bold mb-6">More Than Just Self-Pay Patients</h2>
      <p class="text-lg
text-gray-700 mb-10">
        Every patient is an opportunity to build new relationships with
        referring physicians—and with that comes access to new payor mix.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-4 text-sm text-gray-800">
        <div>📉 Competitive Pricing</div>
        <div>➡️ More Patient Volume</div>
        <div>➡️ Physician Visibility</div>
        <div>➡️ New Referral Relationships</div>
        <div>➡️ Diversified Payor Mix</div>
      </div>
    </div>
  </section>
  <!-- Final CTA -->
  <section
    class="py-20 bg-gradient-to-r from-[#003087] to-[#001f5c] text-white text-center
px-6"
  >
    <h2 class="text-4xl font-bold mb-4">Get Listed. Get Booked. Get Paid.</h2>
    <p class="text-lg mb-8">
      Start onboarding now. It takes 5 minutes and helps fill your unbooked
      capacity.
    </p>
    <a
      href="/login/imaginglogin"
      class="bg-[#cc9933] text-[#003087] font-bold text-lg px-10 py-4 rounded-full
inline-block hover:bg-white hover:text-[#003087] transition-all shadow-lg"
    >
      Join the Network →
    </a>
  </section>
</MainLayout>
