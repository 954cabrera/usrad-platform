---
import CarbonLayout from "../layouts/CarbonLayout.astro";

export const prerender = true;

/*
  ═══════════════════════════════════════════════════════════════════
  USRad — /provider-how-it-works
  Provider Lifecycle Design Contract v1.1 + Execution Charter
  ═══════════════════════════════════════════════════════════════════

  DESIGN CONTRACT COMPLIANCE NOTES (v1.1)
  ─────────────────────────────────────────
  § 3.1   Theme: Light institutional. Dark eliminated.
  § 3.3   Backgrounds: page=bg-gray-50, card=bg-white, navy=bg-[#003087],
          light accent=bg-[#E8EDF5]
  § 5.1   Canonical card: bg-white rounded-xl border border-gray-200 shadow-sm
  § 5.2   Left-border variants for status callouts
  § 6.1   Primary CTA: bg-[#003087] flat navy
  § 7.1   Gradients PROHIBITED. Hero uses flat bg-[#003087] per § 7.3
  § 8.1   Gold (#C9A24D): permitted on B2B recruitment CTA only
  § 8.2   Gold PROHIBITED on payment/financial surfaces
  § 8.3   Gold max 2 elements per viewport
  § 8.4   Gold + amber on same surface: prohibited
  § 4.5   Sidebar: bg-[#003087], active=bg-white/20, inactive=text-white/80
          White/opacity ONLY on navy surface — not elsewhere
  § 3.5   No backdrop-blur, no bg-white/*, no border-white/* on light surfaces
  § 2.5   No blue-*, indigo-*, purple-*, pink-*, slate-* tokens
  § 15.2  Motion: max 300ms, ease-in-out or ease-out only
  § 15.3  No animate-pulse, bounce, scale on hover, parallax, infinite loops
  § 15.8  prefers-reduced-motion respected

  ENGINEERING REPORT FIDELITY NOTES
  ─────────────────────────────────────
  Portal (provider-portal-full-system-engineering-report):
  - Sidebar nav (§ 4.1): Dashboard, Assignments, Centers, Equipment,
    Documents, Reports, Team, Support, Profile, Settings
  - Terminology: "Assignment" not "Booking" (terminology.ts abstraction)
  - Booking lifecycle (§ 3 workflow): PENDING → confirm → SCHEDULED →
    patient pays → PAID → upload report → COMPLETED
  - Go-Live Requirements (§ 4.2 dashboard): 4 items:
    Service Agreement, Credentialing, Insurance, Licensing
  - Authorization number generated at confirm time (§ 4.7)
  - Fulfillment: PDF upload → Anthropic AI extraction (§ 4.7)
  - Assignment list (§ 4.6): slate filter tabs + SLA timer badges
    (these get replaced with canonical tokens in Phase B)
  - Mockup mirrors POST-normalization light institutional design

  Onboarding (onboarding-system-full-engineering-report):
  - 4 steps: Organization → Facilities → Pricing → Agreement
  - Step gating: each step gates the next (§ 3 workflow)
  - Org size routes: single-center/multi-center → portfolio-pricing,
    enterprise → eportfolio-pricing (§ 4.3 / § 4.4)
  - onboarding._index uses CircularProgress + 4 StepCards
  - Dashboard shows progress ring + step completion status

  Execution Charter:
  - Phase A (onboarding) runs before Phase B (portal)
  - Mockups must reflect POST-normalization visual language
  - No pre-normalization dark patterns in the marketing page
  ═══════════════════════════════════════════════════════════════════
*/
---

<CarbonLayout
  title="How USRad Works for Imaging Centers — Provider Walkthrough"
  isHeroPage={false}
  hideNewsletter={true}
>
  <!-- ═══════════════════════════════════════════════════════════════
    HERO
    Flat bg-[#003087] per §7.3 replacement table — NOT gradient
    Marketing/acquisition surface
  ═══════════════════════════════════════════════════════════════════ -->
  <section
    class="relative pt-28 pb-20 px-4 sm:px-6 overflow-hidden bg-[#003087]"
  >
    <!-- Static dot texture — not animated, no glow orbs (§3.5 §15.3) -->
    <div
      class="absolute inset-0 opacity-[0.06] pointer-events-none select-none"
      aria-hidden="true"
      style="background-image: radial-gradient(circle, rgba(255,255,255,0.9) 1px, transparent 1px); background-size: 28px 28px;"
    >
    </div>

    <div class="relative z-10 max-w-6xl mx-auto">
      <!-- Eyebrow — bg-white/10 border-white/20 permitted on §4.5 navy surface -->
      <div
        class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-5 py-2 mb-10"
      >
        <span class="w-2 h-2 rounded-full bg-green-400"></span>
        <span
          class="text-sm font-semibold text-white/80 tracking-widest uppercase"
          >USRad Provider Network</span
        >
      </div>

      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h1
            class="text-5xl sm:text-6xl font-bold text-white leading-[1.08] tracking-tight mb-6"
          >
            From Application<br />to First Assignment<br />
            <span class="text-white/55 font-normal">in Four Steps.</span>
          </h1>
          <p class="text-lg text-white/55 mb-8 max-w-md leading-relaxed">
            USRad routes pre-verified cash-pay patients directly to your
            equipment. No marketing spend, no billing complexity, no prior auth
            delays. Guaranteed disbursement within 10 business days.
          </p>

          <!-- Step nav — static; drives scroll only -->
          <div class="flex items-center gap-0 mb-10 flex-wrap">
            {
              [
                { n: "1", label: "Apply" },
                { n: "2", label: "Credential" },
                { n: "3", label: "Assignments" },
                { n: "✓", label: "Get Paid" },
              ].map((s, i) => (
                <div class="flex items-center">
                  <button class="phiw-hstep" data-step={i + 1}>
                    <span class="phiw-hstep-badge">{s.n}</span>
                    <span class="phiw-hstep-lbl">{s.label}</span>
                  </button>
                  {i < 3 && (
                    <span class="text-white/20 px-1 text-sm select-none">
                      ›
                    </span>
                  )}
                </div>
              ))
            }
          </div>

          <div class="flex items-center gap-4 flex-wrap">
            <!--
              Gold CTA — §8.1 B2B recruitment context.
              Only gold element in this viewport (§8.3 max 2).
              Not on a payment surface (§8.2 compliant).
            -->
            <a
              href="/provider"
              class="inline-flex items-center gap-2 bg-[#C9A24D] hover:bg-[#b8901f] text-white font-semibold px-8 py-3.5 rounded-lg transition-colors duration-200"
            >
              Apply to Join
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a
              href="/contact"
              class="text-white/55 hover:text-white font-medium text-sm border-b border-white/20 hover:border-white/55 pb-px transition-colors duration-200"
            >
              Schedule a Call
            </a>
          </div>
          <p class="text-xs text-white/25 mt-3">
            No credit card required · ACR accreditation required · Live in 2–3
            weeks
          </p>
        </div>

        <!-- Stat cluster — bg-white/10 on navy: §4.5 permits -->
        <div class="hidden lg:grid grid-cols-2 gap-3">
          {
            [
              { num: "10 days", label: "Guaranteed disbursement window" },
              { num: "$0", label: "Marketing or acquisition cost" },
              { num: "27K+", label: "ACR-accredited facilities eligible" },
              { num: "2–3 wks", label: "Average time to first assignment" },
            ].map((s) => (
              <div class="bg-white/10 border border-white/15 rounded-xl p-5">
                <p class="text-2xl font-bold text-white mb-1">{s.num}</p>
                <p class="text-xs text-white/45 leading-snug">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
    STICKY METRIC BAR — bg-[#003087]
  ═══════════════════════════════════════════════════════════════════ -->
  <div
    class="phiw-metric-bar"
    role="complementary"
    aria-label="Key network metrics"
  >
    <div class="phiw-metric-inner">
      {
        [
          { v: "10-Day", l: "Payment Guarantee" },
          { v: "$0", l: "Marketing Cost" },
          { v: "HIPAA", l: "Compliant Platform" },
          { v: "ACR", l: "Accreditation Required" },
          { v: "24/7", l: "Portal Access" },
        ].map((m) => (
          <div class="phiw-metric-item">
            <span class="phiw-metric-val">{m.v}</span>
            <span class="phiw-metric-lbl">{m.l}</span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
    STICKY WALKTHROUGH
    bg-gray-50 page | bg-white cards | §3.3 §5.1
  ═══════════════════════════════════════════════════════════════════ -->
  <section
    id="provider-walkthrough"
    class="bg-gray-50"
    aria-label="Provider workflow walkthrough"
  >
    <!-- Progress strip — white bg, §2.6 navy active -->
    <nav
      id="phiw-progress"
      class="phiw-progress-bar"
      aria-label="Step progress"
    >
      <button class="phiw-ps phiw-ps-active" data-goto="1">
        <span class="phiw-ps-dot"></span>
        <span class="phiw-ps-lbl">Apply</span>
      </button>
      <span class="phiw-ps-line" aria-hidden="true"></span>
      <button class="phiw-ps" data-goto="2">
        <span class="phiw-ps-dot"></span>
        <span class="phiw-ps-lbl">Credential</span>
      </button>
      <span class="phiw-ps-line" aria-hidden="true"></span>
      <button class="phiw-ps" data-goto="3">
        <span class="phiw-ps-dot"></span>
        <span class="phiw-ps-lbl">Receive Assignments</span>
      </button>
      <span class="phiw-ps-line" aria-hidden="true"></span>
      <button class="phiw-ps" data-goto="4">
        <span class="phiw-ps-dot"></span>
        <span class="phiw-ps-lbl">Fulfill &amp; Get Paid</span>
      </button>
    </nav>

    <div class="max-w-[1400px] mx-auto">
      <div class="phiw-walk-layout">
        <!-- ── LEFT: Scrolling narrative ── -->
        <div class="phiw-narrative">
          <!-- ────────────────────────────────────────
            STEP 1: Apply
            Source: onboarding._index + organization route
            Real flow: 4-step gated onboarding
            Steps: Organization → Facilities → Pricing → Agreement
          ──────────────────────────────────────────── -->
          <div class="phiw-step" id="phiw-1">
            <div class="phiw-step-inner">
              <div class="phiw-chip">
                <span class="phiw-chip-num">1</span>
                <span class="phiw-chip-label">Apply · ~10 minutes online</span>
              </div>
              <h2 class="phiw-h2">Apply Online.<br />No Meetings Required.</h2>
              <p class="phiw-p">
                A streamlined 4-step digital onboarding built for imaging center
                administrators. Submit once — your portal is provisioned
                automatically and your progress is saved at every step.
              </p>

              <!-- 4 real onboarding steps with gating logic -->
              <div class="space-y-2 mb-6">
                {
                  [
                    {
                      n: "1",
                      title: "Organization Profile",
                      sub: "Legal name, EIN, corporate address, authorized signer",
                      always: true,
                    },
                    {
                      n: "2",
                      title: "Facility Registration",
                      sub: "Center name, address, modalities (MRI/CT/US/XR), MRI equipment specs",
                      always: false,
                    },
                    {
                      n: "3",
                      title: "Pricing Configuration",
                      sub: "Contracted rates per modality — Medicare benchmark reference included",
                      always: false,
                    },
                    {
                      n: "4",
                      title: "Service Agreement",
                      sub: "DocuSeal e-signature — sign in under 2 minutes",
                      always: false,
                    },
                  ].map((item, i) => (
                    <div class="flex gap-3 items-start">
                      <div class="w-7 h-7 rounded-lg flex items-center justify-center text-xs font-bold text-white flex-shrink-0 mt-0.5 bg-[#003087]">
                        {item.n}
                      </div>
                      <div class="flex-1 pt-0.5">
                        <div class="flex items-center gap-2">
                          <p class="text-sm font-semibold text-gray-900">
                            {item.title}
                          </p>
                          {item.always && (
                            <span class="text-xs text-[#003087] bg-[#E8EDF5] border border-[#003087]/15 px-2 py-0.5 rounded-full font-medium">
                              Always available
                            </span>
                          )}
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">{item.sub}</p>
                      </div>
                    </div>
                  ))
                }
              </div>

              <!-- Info callout — §5.2 Status: Info -->
              <div
                class="bg-[#E8EDF5] border border-[#003087]/15 border-l-4 border-l-[#003087] rounded-xl p-4 flex gap-3"
              >
                <span class="text-base mt-0.5 flex-shrink-0">⚡</span>
                <div>
                  <p class="text-sm font-semibold text-gray-900 mb-1">
                    Autosave at Every Field
                  </p>
                  <p class="text-sm text-gray-600">
                    Each step saves automatically as you type — 2-second
                    debounce. Lose power mid-form? Your data is safe. Return any
                    time to continue where you left off.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- ────────────────────────────────────────
            STEP 2: Credential
            Source: onboarding workflow + portal dashboard Go-Live Requirements
            4 Go-Live items: Agreement, Credentialing, Insurance, Licensing
          ──────────────────────────────────────────── -->
          <div class="phiw-step" id="phiw-2">
            <div class="phiw-step-inner">
              <div class="phiw-chip">
                <span class="phiw-chip-num">2</span>
                <span class="phiw-chip-label"
                  >Credentialing · 2–3 weeks standard</span
                >
              </div>
              <h2 class="phiw-h2">We Handle<br />Credentialing Entirely.</h2>
              <p class="phiw-p">
                After your Service Agreement is executed, USRad's operations
                team manages the full credentialing process. Your Go-Live
                Requirements dashboard tracks progress in real time — no
                follow-up calls needed.
              </p>

              <!-- Timeline — §9.3 semantic colors -->
              <div class="phiw-timeline mb-6">
                <div class="phiw-tl-row">
                  <div class="phiw-tl-dot bg-[#003087]"></div>
                  <div>
                    <p class="text-sm font-semibold text-gray-900">
                      PSA Fully Executed
                    </p>
                    <p class="text-xs text-gray-500">
                      Both parties sign — portal activates immediately
                    </p>
                  </div>
                </div>
                <div class="phiw-tl-line"></div>
                <div class="phiw-tl-row">
                  <div class="phiw-tl-dot bg-amber-500"></div>
                  <div>
                    <p class="text-sm font-semibold text-gray-900">
                      Days 1–3 — Document Verification
                    </p>
                    <p class="text-xs text-gray-500">
                      ACR accreditation · radiologist credentials · insurance
                      docs · state licensing
                    </p>
                  </div>
                </div>
                <div class="phiw-tl-line"></div>
                <div class="phiw-tl-row">
                  <div class="phiw-tl-dot bg-[#003087]"></div>
                  <div>
                    <p class="text-sm font-semibold text-gray-900">
                      Days 3–14 — Network Integration
                    </p>
                    <p class="text-xs text-gray-500">
                      Facility geocoded · modality rates locked · portal fully
                      configured
                    </p>
                  </div>
                </div>
                <div class="phiw-tl-line"></div>
                <div class="phiw-tl-row">
                  <div class="phiw-tl-dot bg-green-600"></div>
                  <div>
                    <p class="text-sm font-semibold text-gray-900">
                      Week 2–3 — Live on Network
                    </p>
                    <p class="text-xs text-gray-500">
                      All 4 Go-Live Requirements cleared · assignments begin
                      routing
                    </p>
                  </div>
                </div>
              </div>

              <!-- 4 real Go-Live Requirements from dashboard loader -->
              <div
                class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm"
              >
                <div class="flex items-center justify-between mb-3">
                  <p
                    class="text-xs font-bold uppercase tracking-wider text-gray-400"
                  >
                    Go-Live Requirements
                  </p>
                  <span
                    class="text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-lg"
                    >In Progress</span
                  >
                </div>
                <div class="space-y-2">
                  {
                    [
                      { label: "Service Agreement", done: true },
                      { label: "Credentialing", done: false, active: true },
                      { label: "Insurance", done: false },
                      { label: "Licensing", done: false },
                    ].map((item) => (
                      <div class="flex items-center gap-2.5">
                        <div
                          class={`w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 ${item.done ? "bg-green-600 text-white" : item.active ? "bg-amber-100 text-amber-600 border border-amber-300" : "bg-gray-100 text-gray-400 border border-gray-200"}`}
                        >
                          {item.done ? "✓" : item.active ? "⟳" : "○"}
                        </div>
                        <span
                          class={`text-xs font-medium ${item.done ? "text-gray-700" : item.active ? "text-amber-700" : "text-gray-400"}`}
                        >
                          {item.label}
                        </span>
                        {item.done && (
                          <span class="ml-auto text-xs text-green-600 font-semibold">
                            Complete
                          </span>
                        )}
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <!-- ────────────────────────────────────────
            STEP 3: Receive Assignments
            Source: bookings._index + bookings.$id loader logic
            Terminology: "Assignment" (terminology.ts abstraction)
            Privacy gate: pre-payment masked, post-payment revealed
            Authorization number generated at confirm time
          ──────────────────────────────────────────── -->
          <div class="phiw-step" id="phiw-3">
            <div class="phiw-step-inner">
              <div class="phiw-chip">
                <span class="phiw-chip-num">3</span>
                <span class="phiw-chip-label"
                  >Assignments · Pre-verified patients</span
                >
              </div>
              <h2 class="phiw-h2">Assignments Arrive<br />Scan-Ready.</h2>
              <p class="phiw-p">
                Every assignment routed to your portal has been pre-verified
                upstream. The physician's order is on file, the member identity
                is confirmed, and payment is secured. Your staff confirms the
                appointment — USRad handles everything else.
              </p>

              <!-- Assignment lifecycle — real states from bookings route -->
              <div class="mb-6">
                <p
                  class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3"
                >
                  Assignment Lifecycle
                </p>
                <div class="flex items-center gap-1.5 flex-wrap">
                  {
                    [
                      { label: "New", color: "navy" },
                      { label: "Confirmed", color: "navy" },
                      { label: "Scheduled", color: "amber" },
                      { label: "Paid", color: "blue" },
                      { label: "Completed", color: "green" },
                    ].map((s, i) => (
                      <div class="flex items-center gap-1.5">
                        <span
                          class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${s.color === "green" ? "bg-green-50 text-green-700 border-green-200" : s.color === "amber" ? "bg-amber-50 text-amber-700 border-amber-200" : s.color === "blue" ? "bg-[#E8EDF5] text-[#003087] border-[#003087]/20" : "bg-gray-900 text-white border-gray-700"}`}
                        >
                          {s.label}
                        </span>
                        {i < 4 && (
                          <span
                            class="text-gray-300 text-xs"
                            aria-hidden="true"
                          >
                            →
                          </span>
                        )}
                      </div>
                    ))
                  }
                </div>
                <p class="text-xs text-gray-400 mt-2">
                  You confirm at "New." Patient pays after scheduling. USRad
                  collects upstream — you never handle payment.
                </p>
              </div>

              <ul class="phiw-list mb-6">
                <li>
                  <span class="phiw-check">✓</span>
                  <div>
                    <p class="text-sm font-semibold text-gray-900">
                      Member identity &amp; demographics confirmed
                    </p>
                    <p class="text-xs text-gray-500">
                      Revealed post-payment · pre-payment shows first name +
                      last initial only
                    </p>
                  </div>
                </li>
                <li>
                  <span class="phiw-check">✓</span>
                  <div>
                    <p class="text-sm font-semibold text-gray-900">
                      CPT code &amp; procedure pre-specified
                    </p>
                    <p class="text-xs text-gray-500">
                      e.g. MRI Abdomen With Contrast · CPT 74182
                    </p>
                  </div>
                </li>
                <li>
                  <span class="phiw-check">✓</span>
                  <div>
                    <p class="text-sm font-semibold text-gray-900">
                      Ordering physician &amp; NPI on file
                    </p>
                    <p class="text-xs text-gray-500">
                      Prescription pre-verified — USRad has already confirmed it
                    </p>
                  </div>
                </li>
                <li>
                  <span class="phiw-check">✓</span>
                  <div>
                    <p class="text-sm font-semibold text-gray-900">
                      Authorization code generated at confirmation
                    </p>
                    <p class="text-xs text-gray-500">
                      Member presents code at arrival — no insurance card
                      required
                    </p>
                  </div>
                </li>
                <li>
                  <span class="phiw-check">✓</span>
                  <div>
                    <p class="text-sm font-semibold text-gray-900">
                      Contracted rate locked — payment guaranteed
                    </p>
                    <p class="text-xs text-gray-500">
                      Your disbursement is not contingent on member collection
                      status
                    </p>
                  </div>
                </li>
              </ul>

              <!-- Navy callout §4.1 -->
              <div class="bg-[#003087] rounded-xl p-4 flex gap-3">
                <span class="text-base mt-0.5 flex-shrink-0">📋</span>
                <div>
                  <p class="text-sm font-semibold text-white mb-1">
                    No Billing. No Front Desk Friction.
                  </p>
                  <p class="text-sm text-white/70">
                    Members never pay at your facility. USRad collects payment
                    upstream before scheduling. Your revenue flows through the
                    portal — clean, trackable, and guaranteed.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- ────────────────────────────────────────
            STEP 4: Fulfill & Get Paid
            Source: bookings.$id.tsx upload_report action
            Real flow: PDF upload → Anthropic AI extraction →
            verification → disbursement
            File constraints: PDF, 50KB–20MB
          ──────────────────────────────────────────── -->
          <div class="phiw-step" id="phiw-4">
            <div class="phiw-step-inner">
              <div class="phiw-chip">
                <span class="phiw-chip-num phiw-chip-green">✓</span>
                <span class="phiw-chip-label phiw-chip-green-label"
                  >Fulfillment · 10-day disbursement</span
                >
              </div>
              <h2 class="phiw-h2">
                Upload the Report.<br />Get Paid in 10 Days.
              </h2>
              <p class="phiw-p">
                After the scan, your radiologist generates a signed professional
                report. Upload it through the Fulfillment Report panel — USRad's
                system verifies it and marks the assignment complete.
                Disbursement initiates within 10 business days. No invoicing, no
                collections calls, no billing staff required.
              </p>

              <!-- Real fulfillment steps from bookings.$id upload_report action -->
              <div class="space-y-3 mb-6">
                {
                  [
                    {
                      n: "1",
                      title: "Scan complete — member checked out",
                      sub: "Assignment status updates automatically in your portal",
                      green: false,
                    },
                    {
                      n: "2",
                      title: "Radiologist generates signed report",
                      sub: "Board-certified professional report required as PDF",
                      green: false,
                    },
                    {
                      n: "3",
                      title: "Upload via Fulfillment Report panel",
                      sub: "PDF only · 50 KB – 20 MB · Drag & drop or file picker",
                      green: false,
                    },
                    {
                      n: "4",
                      title: "AI-assisted verification",
                      sub: "USRad's system extracts and validates report content automatically",
