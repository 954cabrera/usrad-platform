      font-size: 12px;
      font-weight: 600;
      color: #6b7280;
    }

    /* ── Screen stage ── */
    .phiw-screen-stage {
      width: 100%;
      max-width: 430px;
      perspective: 1400px;
      position: relative;
    }
    /* Subtle navy ambient under screen — not an orb §3.5 */
    .phiw-screen-stage::before {
      content: "";
      position: absolute;
      inset: -50px;
      background: radial-gradient(
        circle at 50% 60%,
        rgba(0, 48, 135, 0.08),
        transparent 68%
      );
      filter: blur(24px);
      z-index: -1;
      pointer-events: none;
    }

    .phiw-screen {
      display: none;
      width: 100%;
      transform-style: preserve-3d;
      transform: rotateX(4deg) rotateY(-3deg) translateZ(0);
      filter: drop-shadow(0 28px 40px rgba(0, 0, 0, 0.09))
        drop-shadow(0 6px 16px rgba(0, 48, 135, 0.07))
        drop-shadow(0 2px 4px rgba(0, 0, 0, 0.04));
    }
    .phiw-screen.active {
      display: block;
    }

    /* Hover — §15.4 transition-shadow, NOT transform scale (§15.3 prohibited) */
    .phiw-screen.active:hover {
      transform: rotateX(2deg) rotateY(-1.5deg) translateZ(6px);
      filter: drop-shadow(0 36px 52px rgba(0, 0, 0, 0.12))
        drop-shadow(0 10px 24px rgba(0, 48, 135, 0.09));
    }

    /* Crossfade — §15.2 ≤300ms, ease-out */
    .phiw-sc-enter {
      animation: phiwEnter 280ms ease-out forwards;
    }
    .phiw-sc-exit {
      animation: phiwExit 200ms ease-in forwards;
    }
    @keyframes phiwEnter {
      from {
        opacity: 0;
        transform: rotateX(4deg) rotateY(-3deg) translateY(16px);
      }
      to {
        opacity: 1;
        transform: rotateX(4deg) rotateY(-3deg) translateY(0);
      }
    }
    @keyframes phiwExit {
      from {
        opacity: 1;
        transform: rotateX(4deg) rotateY(-3deg) translateY(0);
      }
      to {
        opacity: 0;
        transform: rotateX(4deg) rotateY(-3deg) translateY(-16px);
      }
    }

    /* Device shell */
    .phiw-device {
      background: white;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid #e5e7eb;
