  </style>

  <!-- ═══════════════════════════════════════════════════════════════
    SCRIPT
    Scroll-driven — no parallax §15.3
    All transitions ≤300ms §15.2
  ═══════════════════════════════════════════════════════════════════ -->
  <script>
    (function () {
      const LABELS = [
        "Apply",
        "Credential",
        "Receive Assignments",
        "Fulfill & Get Paid",
      ];
      const STEPNUM = ["Step 1", "Step 2", "Step 3", "Done"];
      let current = 1;
      let transitioning = false;

      function showScreen(n) {
        if (n === current || transitioning) return;
        transitioning = true;

        const prevEl = document.getElementById("phiw-sc-" + current);
        const nextEl = document.getElementById("phiw-sc-" + n);
        if (!prevEl || !nextEl) {
          transitioning = false;
          return;
        }

        prevEl.classList.add("phiw-sc-exit");
        prevEl.addEventListener(
          "animationend",
          function onExit() {
            prevEl.removeEventListener("animationend", onExit);
            prevEl.classList.remove("active", "phiw-sc-exit");
            prevEl.style.display = "none";

            nextEl.style.display = "block";
            nextEl.classList.add("active", "phiw-sc-enter");
            nextEl.addEventListener(
              "animationend",
              function onEnter() {
                nextEl.removeEventListener("animationend", onEnter);
                nextEl.classList.remove("phiw-sc-enter");
                transitioning = false;
              },
              { once: true },
            );
          },
          { once: true },
        );

        // Dots
        document.querySelectorAll(".phiw-dot").forEach(function (d, i) {
          d.classList.toggle("phiw-dot-active", i + 1 === n);
          d.setAttribute("aria-selected", String(i + 1 === n));
        });

        // Hero step bar highlight
        document.querySelectorAll(".phiw-hstep").forEach(function (s, i) {
          s.style.background =
            i + 1 === n ? "rgba(255,255,255,0.22)" : "rgba(255,255,255,0.10)";
        });

        // Step label
        var t = document.getElementById("phiw-ssl-title");
        var num = document.getElementById("phiw-ssl-num");
        if (t) t.textContent = LABELS[n - 1];
        if (num) num.textContent = STEPNUM[n - 1];

        // Progress strip
        document.querySelectorAll(".phiw-ps").forEach(function (el, i) {
          var s = i + 1;
          el.classList.remove("phiw-ps-active", "phiw-ps-done");
          if (s === n) el.classList.add("phiw-ps-active");
          else if (s < n) el.classList.add("phiw-ps-done");
        });

        current = n;
      }

      // Scroll-driven IntersectionObserver — no parallax
      var obs = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              var n = parseInt(e.target.id.replace("phiw-", ""), 10);
              if (!isNaN(n) && n >= 1 && n <= 4) showScreen(n);
            }
          });
        },
        { threshold: 0.45, rootMargin: "-80px 0px" },
      );

      [1, 2, 3, 4].forEach(function (n) {
        var el = document.getElementById("phiw-" + n);
        if (el) obs.observe(el);
      });

      // Dot clicks
      document.querySelectorAll(".phiw-dot").forEach(function (dot) {
        dot.addEventListener("click", function () {
          var n = parseInt(dot.dataset.target, 10);
          showScreen(n);
          var target = document.getElementById("phiw-" + n);
          if (target)
            target.scrollIntoView({ behavior: "smooth", block: "center" });
        });
      });

      // Progress strip clicks
      document.querySelectorAll(".phiw-ps").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var n = parseInt(btn.dataset.goto, 10);
          var target = document.getElementById("phiw-" + n);
          if (target)
            target.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      // Hero step bar clicks
      document.querySelectorAll(".phiw-hstep").forEach(function (step, i) {
        step.addEventListener("click", function () {
          var target = document.getElementById("phiw-" + (i + 1));
          if (target)
            target.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      // Init first screen
      var first = document.getElementById("phiw-sc-1");
      if (first) {
        first.style.display = "block";
        first.classList.add("active");
      }
    })();
  </script>
