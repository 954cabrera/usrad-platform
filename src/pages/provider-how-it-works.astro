    .phiw-narrative {
      padding: 40px 48px;
    }
    @media (max-width: 1100px) {
      .phiw-narrative {
        padding: 40px 32px;
      }
    }

    .walk-step {
      min-height: 90vh;
      display: flex;
      align-items: center;
    }
    .walk-inner {
      padding: 48px 0;
      max-width: 520px;
    }
    .walk-chip {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }
    .chip-num {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 800;
    }
    .chip-label {
      font-size: 13px;
      font-weight: 600;
      color: #64748b;
      letter-spacing: 0.04em;
    }
    .walk-h2 {
      font-size: clamp(2rem, 3vw, 2.6rem);
      font-weight: 900;
      color: #0f172a;
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 20px;
    }
    .walk-p {
      font-size: 17px;
      color: #475569;
      line-height: 1.75;
      margin-bottom: 28px;
    }
    .walk-list {
      list-style: none;
      margin: 0 0 28px;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .walk-list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 15px;
      color: #334155;
      line-height: 1.5;
    }
    .wl-check {
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: rgba(0, 48, 135, 0.09);
      color: #003087;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 900;
      margin-top: 2px;
    }
    .walk-callout {
      display: flex;
      align-items: flex-start;
      gap: 10px;
