---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="How the USRad Provider Portal Works — See the Dashboard Before You Sign Up"
  isHeroPage={true}
  hideNewsletter={true}
>
  <AOSInit />

  <!-- ============================================================
    HERO
  ============================================================ -->
  <section
    style="
    position: relative;
    padding: 112px 24px 88px;
    overflow: hidden;
    background: linear-gradient(135deg, #0a0f1e 0%, #001a4d 40%, #003087 70%, #0a1628 100%);
  "
  >
    <!-- Grid overlay -->
    <div
      style="
      position: absolute; inset: 0; pointer-events: none; opacity: 0.05;
      background-image: linear-gradient(rgba(255,255,255,1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px);
      background-size: 48px 48px;
    "
    >
    </div>

    <!-- Glow top-right -->
    <div
      style="
      position: absolute; top: 0; right: 0;
      width: 600px; height: 600px; border-radius: 50%; pointer-events: none;
      background: radial-gradient(circle, rgba(0,206,209,0.20), transparent 65%);
      filter: blur(80px);
    "
    >
    </div>

    <!-- Glow bottom-left -->
    <div
      style="
      position: absolute; bottom: 0; left: 40px;
      width: 400px; height: 400px; border-radius: 50%; pointer-events: none;
      background: radial-gradient(circle, rgba(196,152,42,0.22), transparent 65%);
      filter: blur(100px);
    "
    >
    </div>

    <div
      style="position: relative; z-index: 10; max-width: 860px; margin: 0 auto; text-align: center;"
    >
      <!-- Eyebrow -->
      <div
        style="
        display: inline-flex; align-items: center; gap: 10px;
        margin-bottom: 32px; padding: 10px 22px; border-radius: 999px;
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.15);
        backdrop-filter: blur(8px);
      "
        data-aos="fade-down"
      >
        <span
          style="width:8px;height:8px;border-radius:50%;background:#00CED1;display:inline-block;"
        ></span>
        <span
          style="font-size:13px;font-weight:600;color:#a5f3fc;letter-spacing:0.05em;"
        >
          USRad Provider Platform
        </span>
      </div>

      <!-- Headline -->
      <h1
        style="
        font-size: clamp(2.4rem, 5vw, 4rem);
        font-weight: 900; color: #fff;
        line-height: 1.06; letter-spacing: -0.025em;
        margin-bottom: 24px;
      "
        data-aos="fade-up"
      >
        See the Dashboard<br />
        <span
          style="background:linear-gradient(90deg,#00CED1,#C4982A);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;"
        >
          Before You Sign Up
        </span>
      </h1>

      <p
        style="
        font-size: 19px; color: rgba(255,255,255,0.65);
        max-width: 580px; margin: 0 auto 16px; line-height: 1.7;
      "
        data-aos="fade-up"
        data-aos-delay="80"
      >
        From onboarding to your first paid scan — here's exactly what happens
        inside the USRad provider portal, step by step.
      </p>
      <p
        style="
        font-size: 15px; color: rgba(255,255,255,0.38);
        max-width: 460px; margin: 0 auto 40px;
      "
        data-aos="fade-up"
        data-aos-delay="130"
      >
        No demos required. No sales calls. Scroll through the real workflow.
      </p>

      <!-- Step pill nav -->
      <div
        style="display:inline-flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:8px;"
        data-aos="fade-up"
        data-aos-delay="180"
      >
        <button class="hero-pill active" data-pill="1"
          ><span class="pill-num">1</span><span class="pill-lbl">Apply</span
          ></button
        >
        <button class="hero-pill" data-pill="2"
          ><span class="pill-num">2</span><span class="pill-lbl">Onboard</span
          ></button
        >
        <button class="hero-pill" data-pill="3"
          ><span class="pill-num">3</span><span class="pill-lbl">Go Live</span
          ></button
        >
        <button class="hero-pill" data-pill="4"
          ><span class="pill-num">4</span><span class="pill-lbl"
            >Manage Bookings</span
          ></button
        >
        <button class="hero-pill" data-pill="5"
          ><span class="pill-num">5</span><span class="pill-lbl">Get Paid</span
          ></button
        >
      </div>

      <!-- CTA -->
      <div style="margin-top:40px;" data-aos="fade-up" data-aos-delay="220">
        <a
          href="/provider"
          style="
          display:inline-flex;align-items:center;gap:8px;
          padding:14px 28px;border-radius:12px;
          font-size:16px;font-weight:700;color:#fff;text-decoration:none;
          background:linear-gradient(135deg,#C4982A,#e0b53a);
          box-shadow:0 8px 32px rgba(196,152,42,0.38);
          transition:transform 0.2s;
        "
          onmouseover="this.style.transform='scale(1.04)'"
          onmouseout="this.style.transform='scale(1)'"
        >
          Apply to Join the Network
          <svg
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
    STICKY PROGRESS BAR
  ============================================================ -->
  <div
    id="phiw-progress"
    style="
    position:sticky;top:0;z-index:50;
    display:flex;align-items:center;justify-content:center;
    padding:13px 24px;
    background:rgba(255,255,255,0.97);
    backdrop-filter:blur(12px);
    border-bottom:1px solid #e2e8f0;
    box-shadow:0 2px 20px rgba(0,0,0,0.07);
    gap:0;
  "
  >
    <button class="phiw-step phiw-active" data-goto="1"
      ><span class="phiw-dot"></span><span class="phiw-lbl">Apply</span></button
    >
    <span class="phiw-connector"></span>
    <button class="phiw-step" data-goto="2"
      ><span class="phiw-dot"></span><span class="phiw-lbl">Onboard</span
      ></button
    >
    <span class="phiw-connector"></span>
    <button class="phiw-step" data-goto="3"
      ><span class="phiw-dot"></span><span class="phiw-lbl">Go Live</span
      ></button
    >
    <span class="phiw-connector"></span>
    <button class="phiw-step" data-goto="4"
      ><span class="phiw-dot"></span><span class="phiw-lbl"
        >Manage Bookings</span
      ></button
    >
    <span class="phiw-connector"></span>
    <button class="phiw-step" data-goto="5"
      ><span class="phiw-dot"></span><span class="phiw-lbl">Get Paid</span
      ></button
    >
  </div>

  <!-- ============================================================
    WALKTHROUGH — left scroll / right sticky
  ============================================================ -->
  <section style="background:#fff;position:relative;">
    <div class="phiw-layout">
      <!-- ── LEFT: scrolling narrative ── -->
      <div class="phiw-narrative">
        <!-- STEP 1 -->
        <div class="walk-step" id="phiw-1">
          <div class="walk-inner">
            <div class="walk-chip">
              <span class="chip-num" style="background:#003087;color:#fff;"
                >1</span
              >
              <span class="chip-label">Apply · Takes 5 minutes</span>
            </div>
            <h2 class="walk-h2">Tell Us About<br />Your Imaging Center</h2>
            <p class="walk-p">
              The application is simple and fast. You'll describe your
              organization — legal name, NPI, tax ID, authorized signer — and
              add the facilities you want to list. There's no paper. No fax. No
              broker meeting.
            </p>
            <ul class="walk-list">
              <li>
                <span class="wl-check">✓</span><span
                  >Organization profile: legal name, EIN, signer details</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >List each facility: address, modalities, scanner specs</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >View live Medicare reference rates for your ZIPs</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >No commitment until your PSA is countersigned</span>
              </li>
            </ul>
            <div class="walk-callout">
              <span class="callout-icon">⚡</span><span
                >Most providers complete Step 1 in under 8 minutes.</span>
            </div>
          </div>
        </div>

        <!-- STEP 2 -->
        <div class="walk-step" id="phiw-2">
          <div class="walk-inner">
            <div class="walk-chip">
              <span class="chip-num" style="background:#006B4E;color:#fff;"
                >2</span
              >
              <span class="chip-label">Onboard · Set your rates</span>
            </div>
            <h2 class="walk-h2">Configure Pricing.<br />Sign Your PSA.</h2>
            <p class="walk-p">
              Our onboarding wizard shows you real market intelligence for every
              ZIP code you serve. You see what competitor independent centers
              charge, what hospitals charge, and where Medicare anchors the rate
              — then you decide your cash-pay price.
            </p>
            <ul class="walk-list">
              <li>
                <span class="wl-check">✓</span><span
                  >Facility-level pricing — set different rates per location</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >Medicare rate benchmarks for every modality you offer</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >Exhibit A (rates) and Exhibit B (centers) auto-generated</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >PSA signed electronically — countersigned within 24 hours</span>
              </li>
            </ul>
            <div class="walk-callout">
              <span class="callout-icon">📄</span><span
                >Your Provider Service Agreement lives in your portal forever —
                no digging through email.</span>
            </div>
          </div>
        </div>

        <!-- STEP 3 -->
        <div class="walk-step" id="phiw-3">
          <div class="walk-inner">
            <div class="walk-chip">
              <span class="chip-num" style="background:#7C3AED;color:#fff;"
                >3</span
              >
              <span class="chip-label">Go Live · Portal access granted</span>
            </div>
            <h2 class="walk-h2">Your Dashboard<br />Is Live Immediately</h2>
            <p class="walk-p">
              The moment your PSA is countersigned, your centers are activated
              in the USRad patient-facing search. Your portal dashboard becomes
              your command center — booking queue, center management, team
              access, and documents all in one place.
            </p>
            <ul class="walk-list">
              <li>
                <span class="wl-check">✓</span><span
                  >Centers appear in patient-facing search within hours</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >Dashboard shows verification checklist and account health</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >Invite your front desk, billing, and admin staff</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >Role-based access — control exactly what each team member
                  sees</span>
              </li>
            </ul>
            <div class="walk-callout">
              <span class="callout-icon">🏥</span><span
                >Add multiple facilities to a single account — one login,
                complete visibility across all centers.</span>
            </div>
          </div>
        </div>

        <!-- STEP 4 -->
        <div class="walk-step" id="phiw-4">
          <div class="walk-inner">
            <div class="walk-chip">
              <span class="chip-num" style="background:#B45309;color:#fff;"
                >4</span
              >
              <span class="chip-label">Manage Bookings · Full lifecycle</span>
            </div>
            <h2 class="walk-h2">Every Referral.<br />One Queue.</h2>
            <p class="walk-p">
              When a patient selects your center, the booking arrives in your
              portal instantly. You confirm the appointment, upload the
              completed scan, and mark it done — no phone tag with USRad. You
              control the workflow from your side.
            </p>
            <ul class="walk-list">
              <li>
                <span class="wl-check">✓</span><span
                  >Booking queue shows patient name, scan type, and scheduled
                  date</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >Status lifecycle: New → Confirmed → Completed → Paid</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >Prescription upload and verification tracked per booking</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >Support ticket system for any booking issue — response
                  guaranteed</span>
              </li>
            </ul>
            <div class="walk-callout">
              <span class="callout-icon">📋</span><span
                >No calls to confirm. No faxed referrals. The booking is in your
                queue before the patient hangs up the phone.</span>
            </div>
          </div>
        </div>

        <!-- STEP 5 -->
        <div class="walk-step" id="phiw-5">
          <div class="walk-inner">
            <div class="walk-chip">
              <span class="chip-num" style="background:#C4982A;color:#fff;"
                >5</span
              >
              <span class="chip-label">Get Paid · 10-day guarantee</span>
            </div>
            <h2 class="walk-h2">Scan Completed.<br />Payment in 10 Days.</h2>
            <p class="walk-p">
              USRad collects payment from the patient at booking. Once your
              center marks a scan completed, your payment processes
              automatically — no invoicing, no chasing, no aging AR. Your
              Reports dashboard shows every transaction, every period.
            </p>
            <ul class="walk-list">
              <li>
                <span class="wl-check">✓</span><span
                  >Guaranteed payment within 10 business days of scan completion</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >Reports tab: earnings by period, by facility, by modality</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >No insurance denials. No remittance headaches. No
                  collections.</span>
              </li>
              <li>
                <span class="wl-check">✓</span><span
                  >Stripe-powered ACH direct deposit to your bank</span>
              </li>
            </ul>
            <div
              class="walk-callout"
              style="border-left-color:#C4982A;background:rgba(196,152,42,0.06);"
            >
              <span class="callout-icon">💰</span>
              <span
                ><strong>Your net rate is your rate.</strong> USRad never claws back,
                rebills, or recalculates after the fact.</span
              >
            </div>
            <!-- Final CTA -->
            <div
              style="margin-top:40px;padding-top:40px;border-top:1px solid #e2e8f0;"
            >
              <p
                style="font-size:12px;font-weight:700;color:#94a3b8;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:16px;"
              >
                Ready to see this for your center?
              </p>
              <a
                href="/provider"
                style="
                display:inline-flex;align-items:center;gap:8px;
                padding:14px 28px;border-radius:12px;
                font-size:16px;font-weight:700;color:#fff;text-decoration:none;
                background:linear-gradient(135deg,#C4982A,#e0b53a);
                box-shadow:0 8px 28px rgba(196,152,42,0.35);
              "
                onmouseover="this.style.transform='scale(1.03)'"
                onmouseout="this.style.transform='scale(1)'"
              >
                Apply to Join the Network
                <svg
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
                >
              </a>
              <a
                href="/provider#consultation"
                style="display:block;margin-top:14px;font-size:14px;color:#003087;font-weight:500;text-decoration:none;opacity:0.75;"
                >Schedule a 20-min call instead →</a
              >
            </div>
          </div>
        </div>
      </div><!-- /phiw-narrative -->

      <!-- ── RIGHT: sticky panel ── -->
      <div class="phiw-sticky-col">
        <div id="phiw-sticky-panel">
          <!-- Label bar -->
          <div class="screen-label-bar">
            <span class="ssl-badge" id="ssl-badge">Step 1</span>
            <span class="ssl-title" id="ssl-title"
              >Application — Organization Setup</span
            >
            <div class="ssl-dots">
              <button class="sdot active" data-target="1"></button>
              <button class="sdot" data-target="2"></button>
              <button class="sdot" data-target="3"></button>
              <button class="sdot" data-target="4"></button>
              <button class="sdot" data-target="5"></button>
            </div>
          </div>

          <!-- 3D Stage -->
          <div class="screen-stage" id="phiw-stage">
            <!-- SCREEN 1 — Application -->
            <div class="screen-card active" id="sc-1">
              <div class="sc-chrome">
                <div class="sc-dots">
                  <span
                    style="background:#ff5f57;width:11px;height:11px;border-radius:50%;display:block;"
                  ></span><span
                    style="background:#febc2e;width:11px;height:11px;border-radius:50%;display:block;"
                  ></span><span
                    style="background:#28c840;width:11px;height:11px;border-radius:50%;display:block;"
                  ></span>
                </div>
                <div class="sc-url">app.usrad.com/onboarding/organization</div>
              </div>
              <div
                class="sc-body"
                style="background:#f8fafc;padding:20px 22px;overflow:hidden;display:flex;flex-direction:column;gap:12px;"
              >
                <div style="text-align:center;">
                  <div style="font-size:15px;font-weight:900;color:#0f172a;">
                    Welcome to USRad
                  </div>
                  <div style="font-size:11px;color:#64748b;margin-top:3px;">
                    Step 1 of 5 — Organization Setup
                  </div>
                </div>
                <div
                  style="height:5px;background:#e2e8f0;border-radius:999px;overflow:hidden;"
                >
                  <div
                    style="width:20%;height:100%;background:linear-gradient(90deg,#003087,#00CED1);border-radius:999px;"
                  >
                  </div>
                </div>
                <div style="display:flex;flex-direction:column;gap:9px;">
                  <div style="display:flex;flex-direction:column;gap:3px;">
                    <label
                      style="font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.04em;"
                      >Legal Organization Name</label
                    ><div
                      style="padding:7px 10px;border-radius:7px;font-size:12px;border:1px solid #e2e8f0;background:#fff;color:#0f172a;"
                    >
                      Advanced Medical Imaging, LLC
                    </div>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:3px;">
                    <label
                      style="font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.04em;"
                      >Federal Tax ID (EIN)</label
                    ><div
                      style="padding:7px 10px;border-radius:7px;font-size:12px;border:1px solid #e2e8f0;background:#fff;color:#0f172a;"
                    >
                      87-4521093
                    </div>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:3px;">
                    <label
                      style="font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.04em;"
                      >Organization NPI</label
                    ><div
                      style="padding:7px 10px;border-radius:7px;font-size:12px;border:1px solid #e2e8f0;background:#fff;color:#0f172a;"
                    >
                      1234567890
                    </div>
                  </div>
                  <div style="display:flex;flex-direction:column;gap:3px;">
                    <label
                      style="font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.04em;"
                      >Authorized Signer</label
                    ><div
                      style="padding:7px 10px;border-radius:7px;font-size:12px;border:1px solid #e2e8f0;background:#fff;color:#0f172a;"
                    >
                      Dr. Maria Santos, CEO
                    </div>
                  </div>
                  <button
                    style="margin-top:4px;padding:9px 14px;background:#003087;color:#fff;border:none;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;align-self:flex-end;"
                    >Continue to Facilities →</button
                  >
                </div>
              </div>
            </div>

            <!-- SCREEN 2 — Pricing -->
            <div class="screen-card" id="sc-2">
              <div class="sc-chrome">
                <div class="sc-dots">
                  <span
                    style="background:#ff5f57;width:11px;height:11px;border-radius:50%;display:block;"
                  ></span><span
                    style="background:#febc2e;width:11px;height:11px;border-radius:50%;display:block;"
                  ></span><span
                    style="background:#28c840;width:11px;height:11px;border-radius:50%;display:block;"
                  ></span>
                </div>
                <div class="sc-url">app.usrad.com/onboarding/pricing</div>
              </div>
              <div
                class="sc-body"
                style="background:#1e293b;overflow:hidden;display:flex;flex-direction:column;"
              >
                <div style="padding:16px 16px 8px;">
                  <div style="font-size:14px;font-weight:800;color:#e2e8f0;">
                    Set Your Cash-Pay Rates
                  </div><div
                    style="font-size:11px;color:#64748b;margin-top:3px;"
                  >
                    Advanced Imaging — Pembroke Pines, FL (ZIP 33025)
                  </div>
                </div>
                <div
                  style="flex:1;padding:0 12px 8px;display:flex;flex-direction:column;gap:2px;"
                >
                  <div
                    style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:6px;padding:7px 8px;border-radius:7px;background:rgba(255,255,255,0.04);font-size:9px;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:0.05em;"
                  >
                    <span>Procedure</span><span style="text-align:right;"
                      >Medicare</span
                    ><span style="text-align:right;">Your Price</span><span
                      style="text-align:right;">%</span>
                  </div>
                  <div
                    style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:6px;padding:7px 8px;border-radius:7px;background:rgba(255,255,255,0.04);"
                  >
                    <span style="font-size:11px;color:#e2e8f0;"
                      >Brain MRI (no contrast)</span
                    ><span
                      style="font-size:11px;color:#94a3b8;text-align:right;"
                      >$312</span
                    ><span
                      style="font-size:12px;color:#4ade80;font-weight:700;text-align:right;"
                      >$249</span
                    ><span
                      style="font-size:10px;color:#94a3b8;text-align:right;"
                      >80%</span>
                  </div>
                  <div
                    style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:6px;padding:7px 8px;border-radius:7px;background:rgba(255,255,255,0.04);"
                  >
                    <span style="font-size:11px;color:#e2e8f0;"
                      >Lumbar Spine MRI</span
                    ><span
                      style="font-size:11px;color:#94a3b8;text-align:right;"
                      >$298</span
                    ><span
                      style="font-size:12px;color:#4ade80;font-weight:700;text-align:right;"
                      >$229</span
                    ><span
                      style="font-size:10px;color:#94a3b8;text-align:right;"
                      >77%</span>
