    }
    .phiw-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: 2px solid #cbd5e1;
      background: transparent;
      flex-shrink: 0;
      transition: all 0.25s;
    }
    .phiw-lbl {
      font-size: 13px;
      font-weight: 500;
      color: #94a3b8;
      transition: color 0.25s;
    }
    .phiw-step.phiw-active .phiw-dot {
      background: #003087;
      border-color: #003087;
      box-shadow: 0 0 0 3px rgba(0, 48, 135, 0.15);
    }
    .phiw-step.phiw-active .phiw-lbl {
      color: #003087;
      font-weight: 700;
    }
    .phiw-step.phiw-done .phiw-dot {
      background: #22c55e;
      border-color: #22c55e;
    }
    .phiw-step.phiw-done .phiw-lbl {
      color: #64748b;
    }
    .phiw-connector {
      flex-shrink: 0;
      width: 32px;
      height: 1px;
      background: #e2e8f0;
    }
    @media (max-width: 640px) {
      .phiw-lbl {
        display: none;
      }
      .phiw-connector {
        width: 16px;
      }
    }

    .phiw-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      max-width: 1360px;
      margin: 0 auto;
      align-items: start;
    }
    @media (max-width: 900px) {
      .phiw-layout {
        grid-template-columns: 1fr;
      }
      .phiw-sticky-col {
        display: none;
      }
