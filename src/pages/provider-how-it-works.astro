    }
    .sc-dots {
      display: flex;
      gap: 6px;
    }
    .sc-url {
      flex: 1;
      background: #fff;
      border-radius: 5px;
      padding: 4px 10px;
      font-size: 11px;
      color: #64748b;
      font-family: "SF Mono", "Fira Code", monospace;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sc-body {
      flex: 1;
      overflow: hidden;
    }
  </style>

  <script>
    (function () {
      const LABELS = [
        "Application — Organization Setup",
        "Onboarding — Pricing Configuration",
        "Provider Portal — Dashboard",
        "Provider Portal — Booking Queue",
        "Provider Portal — Earnings Report",
      ];
      const BADGES = ["Step 1", "Step 2", "Step 3", "Step 4", "Step 5"];
      let cur = 1,
        busy = false;

      function show(n) {
        if (n === cur || busy) return;
        busy = true;
        const prev = document.getElementById("sc-" + cur);
        const next = document.getElementById("sc-" + n);
        if (!prev || !next) {
          busy = false;
          return;
        }
        prev.classList.add("sc-exit");
        prev.addEventListener(
          "animationend",
          function h() {
            prev.removeEventListener("animationend", h);
            prev.classList.remove("active", "sc-exit");
            prev.style.display = "none";
            next.style.display = "flex";
            next.classList.add("active", "sc-enter");
            next.addEventListener(
              "animationend",
              function h2() {
                next.removeEventListener("animationend", h2);
                next.classList.remove("sc-enter");
                busy = false;
              },
              { once: true },
            );
          },
          { once: true },
        );
        document
          .querySelectorAll(".sdot")
          .forEach((d, i) => d.classList.toggle("active", i + 1 === n));
        const t = document.getElementById("ssl-title");
        const b = document.getElementById("ssl-badge");
        if (t) t.textContent = LABELS[n - 1];
        if (b) b.textContent = BADGES[n - 1];
        document.querySelectorAll(".phiw-step").forEach((el, i) => {
          const s = i + 1;
          el.classList.remove("phiw-active", "phiw-done");
          if (s === n) el.classList.add("phiw-active");
          else if (s < n) el.classList.add("phiw-done");
        });
        document
          .querySelectorAll(".hero-pill")
          .forEach((el, i) => el.classList.toggle("active", i + 1 === n));
        cur = n;
      }

      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              const n = parseInt(e.target.id.replace("phiw-", ""), 10);
              if (!isNaN(n)) show(n);
            }
          });
        },
        { threshold: 0.45, rootMargin: "-80px 0px" },
      );
      for (let n = 1; n <= 5; n++) {
        const el = document.getElementById("phiw-" + n);
        if (el) obs.observe(el);
      }

      document.querySelectorAll(".sdot").forEach((d) => {
        d.addEventListener("click", () => {
          const n = parseInt(d.dataset.target, 10);
          show(n);
          const t = document.getElementById("phiw-" + n);
          if (t) t.scrollIntoView({ behavior: "smooth", block: "center" });
        });
      });
      document.querySelectorAll(".phiw-step").forEach((el, i) => {
        el.addEventListener("click", () => {
          const t = document.getElementById("phiw-" + (i + 1));
          if (t) t.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });
      document.querySelectorAll(".hero-pill").forEach((el, i) => {
        el.addEventListener("click", () => {
          const t = document.getElementById("phiw-" + (i + 1));
          if (t) t.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      const stage = document.getElementById("phiw-stage");
      let tX = -3,
        tY = 4,
        cX = -3,
        cY = 4;
      function lerp(a, b, t) {
        return a + (b - a) * t;
      }
      function loop() {
        cX = lerp(cX, tX, 0.08);
        cY = lerp(cY, tY, 0.08);
        const c = document.querySelector(".screen-card.active");
        if (
          c &&
          !c.classList.contains("sc-exit") &&
          !c.classList.contains("sc-enter")
        ) {
          c.style.transform =
            "rotateX(" + cY + "deg) rotateY(" + cX + "deg) translateZ(0)";
        }
        requestAnimationFrame(loop);
      }
      if (stage) {
        stage.addEventListener("mousemove", (e) => {
          const r = stage.getBoundingClientRect();
          tX = -3 + ((e.clientX - r.left) / r.width - 0.5) * 7;
          tY = 4 - ((e.clientY - r.top) / r.height - 0.5) * 5;
        });
        stage.addEventListener("mouseleave", () => {
          tX = -3;
          tY = 4;
        });
        loop();
      }

      const first = document.getElementById("sc-1");
      if (first) {
        first.style.display = "flex";
        first.classList.add("active");
      }
    })();
  </script>
</CarbonLayout>
