---
import MainLayout from "../layouts/MainLayout.astro";
import AOSInit from "../components/AOSInit.astro";

// Page metadata
const title = "Stop Leaving Money on the Table - USRad Provider Marketplace";
const description =
  "Set your own reimbursement. Get patients directly. Turn unfilled MRI slots into reliable monthly revenue with transparent marketplace pricing.";
---

<MainLayout>
  <Fragment slot="title">{title}</Fragment>

  <AOSInit />

  <!-- Hero Section - Enhanced Mobile Optimized -->
  <section
    class="relative overflow-hidden min-h-[60vh] sm:min-h-[70vh] lg:min-h-[80vh] pt-16 sm:pt-20 lg:pt-24 pb-8 sm:pb-12 lg:pb-16"
  >
    <!-- Video Background -->
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover z-0"
      poster="/images/website/imaging-center-hero-fallback.webp?v=2.1"
    >
      <source
        src="/videos/imaging-center-hero-mobile.mp4"
        type="video/mp4"
        media="(max-width: 768px)"
      />
      <source src="/videos/imaging-center-hero.mp4" type="video/mp4" />
      <source src="/videos/imaging-center-hero.webm" type="video/webm" />
      <img
        src="/images/website/imaging-center-hero-fallback.webp?v=2.1"
        alt="Radiologist collaboration"
        class="w-full h-full object-cover"
      />
    </video>

    <!-- Radial Overlay -->
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.9)_0%,rgba(255,255,255,0.7)_40%,transparent_85%)] z-0"
    >
    </div>

    <div
      class="relative max-w-7xl mx-auto px-3 sm:px-4 lg:px-8 h-full flex items-center z-10"
    >
      <div class="max-w-2xl mx-auto text-center w-full">
        <!-- Status Badge -->
        <div
          class="inline-flex items-center justify-center px-3 py-2 bg-gradient-to-r from-red-500 to-pink-500 text-white text-xs sm:text-sm font-semibold rounded-full animate-pulse mb-4 sm:mb-6 lg:mb-8"
          data-aos="fade-down"
        >
          <span class="w-2 h-2 bg-white rounded-full mr-2 animate-ping"></span>
          <span class="whitespace-nowrap"
            >Provider Panels Closing Soon by Region</span
          >
        </div>

        <!-- Headlines -->
        <div
          class="space-y-3 sm:space-y-4 lg:space-y-6 mb-4 sm:mb-6 lg:mb-8"
          data-aos="fade-up"
        >
          <h1
            class="text-2xl sm:text-3xl md:text-4xl lg:text-6xl font-bold text-gray-900 leading-tight px-2 sm:px-0"
          >
            Turn Empty Slots<br />
            Into <span
              class="bg-gradient-to-r from-blue-600 to-amber-600 bg-clip-text text-transparent"
              >Revenue</span
            ><br />
            Within Days
          </h1>

          <p
            class="text-base sm:text-lg md:text-xl lg:text-2xl text-gray-700 leading-relaxed px-2 sm:px-0"
          >
            Set your rate. Get booked. Get paid fast.
          </p>
        </div>

        <!-- Quote Box -->
        <div
          class="bg-gradient-to-r from-amber-50 to-blue-50 p-3 sm:p-4 lg:p-6 rounded-lg sm:rounded-xl border-l-4 border-amber-400 mb-4 sm:mb-6 lg:mb-8 backdrop-blur-sm bg-opacity-90 mx-2 sm:mx-0"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <p class="text-sm sm:text-base lg:text-lg text-gray-700 italic mb-2">
            "You're already offering discounts. You're already sitting on unused
            capacity."
          </p>
          <p
            class="text-sm sm:text-base lg:text-lg font-semibold text-amber-700"
          >
            Why not turn that into consistent revenue—and new referring
            physicians?
          </p>
        </div>

        <!-- CTA Buttons -->
        <div
          class="flex flex-col gap-3 sm:gap-4 justify-center items-center mb-4 sm:mb-6 lg:mb-8 px-2 sm:px-0"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <a
            href="/login/imaginglogin"
            class="w-full max-w-md sm:w-auto bg-gradient-to-r from-amber-500 to-amber-600 text-white px-4 sm:px-6 lg:px-8 py-3 sm:py-4 rounded-lg sm:rounded-xl font-semibold text-sm sm:text-base lg:text-lg hover:from-amber-600 hover:to-amber-700 transform hover:scale-105 transition-all duration-300 shadow-lg text-center min-h-[48px] flex items-center justify-center"
          >
            Start Onboarding – Takes 5 Minutes →
          </a>
          <a
            href="#"
            class="w-full max-w-md sm:w-auto border-2 border-blue-600 text-blue-600 px-4 sm:px-6 lg:px-8 py-3 sm:py-4 rounded-lg sm:rounded-xl font-semibold text-sm sm:text-base lg:text-lg hover:bg-blue-600 hover:text-white transition-all duration-300 backdrop-blur-sm text-center min-h-[48px] flex items-center justify-center"
          >
            <span class="hidden sm:inline"
              >How We Built AnciCare serving over 400,000 patients</span
            >
            <span class="sm:hidden">AnciCare Success Story</span>
          </a>
        </div>

        <!-- Trust Indicators -->
        <div
          class="flex flex-wrap justify-center gap-2 sm:gap-3 lg:gap-4 text-xs sm:text-sm text-gray-600 mb-3 sm:mb-4 lg:mb-6 px-2 sm:px-0"
          data-aos="fade-up"
          data-aos-delay="600"
        >
          <span class="flex items-center whitespace-nowrap">
            <svg
              class="w-3 h-3 sm:w-4 sm:h-4 text-green-500 mr-1"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
            No setup cost
          </span>
          <span class="flex items-center whitespace-nowrap">
            <svg
              class="w-3 h-3 sm:w-4 sm:h-4 text-green-500 mr-1"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
            Set your own rates
          </span>
          <span class="flex items-center whitespace-nowrap">
            <svg
              class="w-3 h-3 sm:w-4 sm:h-4 text-green-500 mr-1"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
            Consistent volume
          </span>
        </div>

        <p
          class="text-blue-600 font-medium text-xs sm:text-sm lg:text-base px-2 sm:px-0"
          data-aos="fade-up"
          data-aos-delay="800"
        >
          Already started? <a
            href="/login/imaginglogin"
            class="underline hover:no-underline">Resume here</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- Dynamic Revenue Calculator - Enhanced Mobile -->
  <section class="py-12 sm:py-16 lg:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8">
      <div class="text-center mb-8 sm:mb-12 lg:mb-16" data-aos="fade-up">
        <h2
          class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-3 sm:mb-4 lg:mb-6 px-2 sm:px-0"
        >
          Calculate Your Revenue Potential
        </h2>
        <p
          class="text-base sm:text-lg lg:text-xl text-gray-600 max-w-3xl mx-auto px-2 sm:px-0"
        >
          See how your pricing strategy affects your monthly revenue with real
          volume data from our marketplace.
        </p>
      </div>

      <div
        class="bg-white rounded-xl sm:rounded-2xl shadow-2xl p-4 sm:p-6 lg:p-8 max-w-4xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <!-- Calculator Controls -->
        <div class="grid grid-cols-1 gap-4 sm:gap-6 lg:gap-8 mb-6 sm:mb-8">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2 sm:mb-3"
              >Modality</label
            >
            <select
              id="modality"
              class="w-full px-3 sm:px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base min-h-[48px]"
            >
              <option value="mri">MRI</option>
              <option value="ct">CT Scan - Coming Soon!</option>
              <option value="ultrasound">Ultrasound - Coming Soon!</option>
              <option value="xray">X-Ray - Coming Soon!</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2 sm:mb-3"
              >Current Empty Slots/Day</label
            >
            <input
              type="range"
              id="emptySlots2"
              min="1"
              max="10"
              value="3"
              class="w-full h-3 bg-blue-200 rounded-lg appearance-none cursor-pointer"
            />
            <div
              class="flex justify-between items-center text-sm text-gray-600 mt-2"
            >
              <span>1</span>
              <span
                id="slotsDisplay"
                class="text-xl sm:text-2xl font-bold text-blue-600 bg-blue-50 px-3 py-2 rounded-lg border-2 border-blue-200 min-w-[48px] text-center"
                >3</span
              >
              <span>10</span>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2 sm:mb-3"
              >Your Pricing Strategy</label
            >
            <select
              id="pricingStrategy"
              class="w-full px-3 sm:px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base min-h-[48px]"
            >
              <option value="100">100% of Medicare ($270) - High Volume</option>
              <option value="120">120% of Medicare ($300) - Balanced</option>
              <option value="140">140% of Medicare ($330) - Premium</option>
            </select>
          </div>
        </div>

        <!-- Results Display -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-6">
          <div
            class="bg-blue-50 rounded-lg sm:rounded-xl p-3 sm:p-4 lg:p-6 text-center"
          >
            <div
              class="text-lg sm:text-xl lg:text-2xl font-bold text-blue-600 mb-1 sm:mb-2"
              id="expectedVolume"
            >
              25
            </div>
            <div class="text-xs sm:text-sm text-gray-600">Monthly Scans</div>
          </div>

          <div
            class="bg-green-50 rounded-lg sm:rounded-xl p-3 sm:p-4 lg:p-6 text-center"
          >
            <div
              class="text-lg sm:text-xl lg:text-2xl font-bold text-green-600 mb-1 sm:mb-2"
              id="revenuePerScan"
            >
              $270
            </div>
            <div class="text-xs sm:text-sm text-gray-600">Revenue/Scan</div>
          </div>

          <div
            class="bg-purple-50 rounded-lg sm:rounded-xl p-3 sm:p-4 lg:p-6 text-center"
          >
            <div
              class="text-lg sm:text-xl lg:text-2xl font-bold text-purple-600 mb-1 sm:mb-2"
              id="monthlyRevenue"
            >
              $6,750
            </div>
            <div class="text-xs sm:text-sm text-gray-600">Monthly Revenue</div>
          </div>

          <div
            class="bg-amber-50 rounded-lg sm:rounded-xl p-3 sm:p-4 lg:p-6 text-center"
          >
            <div
              class="text-lg sm:text-xl lg:text-2xl font-bold text-amber-600 mb-1 sm:mb-2"
              id="marketplaceRank"
            >
              Top 20%
            </div>
            <div class="text-xs sm:text-sm text-gray-600">Marketplace Rank</div>
          </div>
        </div>

        <!-- CTA -->
        <div class="text-center mt-6 sm:mt-8">
          <a
            href="/login/imaginglogin"
            class="w-full sm:w-auto inline-block bg-gradient-to-r from-blue-600 to-blue-700 text-white px-6 sm:px-8 py-4 rounded-xl font-semibold text-base sm:text-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-300 shadow-lg min-h-[48px]"
          >
            Lock in These Numbers →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust & Quality Reassurance - Enhanced Mobile -->
  <section
    class="py-12 sm:py-16 lg:py-24 bg-gradient-to-br from-[#fefbf5] to-[#f8f5e8] relative overflow-hidden"
  >
    <div class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-8">
      <div class="text-center mb-8 sm:mb-12 lg:mb-16" data-aos="fade-up">
        <h2
          class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-[#003087] mb-4 sm:mb-6 lg:mb-8 font-manrope px-2 sm:px-0"
        >
          Patients Choose Price. We Ensure Quality.
        </h2>
        <p
          class="text-base sm:text-lg md:text-xl lg:text-2xl text-gray-600 max-w-4xl mx-auto leading-relaxed px-2 sm:px-0"
        >
          All USRad centers are pre-vetted for licensure, accreditation, and
          service reputation. Every patient knows that no matter the price,
          they'll receive world-class imaging.
        </p>
      </div>

      <!-- Quality Standards Grid -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8 mb-8 sm:mb-12 lg:mb-16"
      >
        <!-- Standard 1 -->
        <div
          class="bg-white rounded-lg sm:rounded-2xl lg:rounded-3xl p-4 sm:p-6 lg:p-8 shadow-xl border border-gray-100 text-center group hover:-translate-y-2 transition-all duration-300"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div
            class="w-12 h-12 sm:w-16 sm:h-16 lg:w-20 lg:h-20 bg-gradient-to-br from-[#003087] to-[#0052cc] rounded-lg sm:rounded-xl lg:rounded-2xl flex items-center justify-center mx-auto mb-3 sm:mb-4 lg:mb-6 text-white text-xl sm:text-2xl lg:text-3xl group-hover:scale-110 transition-transform"
          >
            🏥
          </div>
          <h3
            class="text-base sm:text-lg lg:text-xl font-bold text-[#003087] mb-2 sm:mb-3 lg:mb-4"
          >
            Full Accreditation
          </h3>
          <p class="text-xs sm:text-sm lg:text-base text-gray-600">
            ACR or equivalent accreditation required for all network centers
          </p>
        </div>

        <!-- Standard 2 -->
        <div
          class="bg-white rounded-lg sm:rounded-2xl lg:rounded-3xl p-4 sm:p-6 lg:p-8 shadow-xl border border-gray-100 text-center group hover:-translate-y-2 transition-all duration-300"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div
            class="w-12 h-12 sm:w-16 sm:h-16 lg:w-20 lg:h-20 bg-gradient-to-br from-[#cc9933] to-[#e6c378] rounded-lg sm:rounded-xl lg:rounded-2xl flex items-center justify-center mx-auto mb-3 sm:mb-4 lg:mb-6 text-white text-xl sm:text-2xl lg:text-3xl group-hover:scale-110 transition-transform"
          >
            👨‍⚕️
          </div>
          <h3
            class="text-base sm:text-lg lg:text-xl font-bold text-[#003087] mb-2 sm:mb-3 lg:mb-4"
          >
            Board-Certified Reads
          </h3>
          <p class="text-xs sm:text-sm lg:text-base text-gray-600">
            Every scan interpreted by board-certified radiologists within 24-48
            hours
          </p>
        </div>

        <!-- Standard 3 -->
        <div
          class="bg-white rounded-lg sm:rounded-2xl lg:rounded-3xl p-4 sm:p-6 lg:p-8 shadow-xl border border-gray-100 text-center group hover:-translate-y-2 transition-all duration-300"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div
            class="w-12 h-12 sm:w-16 sm:h-16 lg:w-20 lg:h-20 bg-gradient-to-br from-green-500 to-green-600 rounded-lg sm:rounded-xl lg:rounded-2xl flex items-center justify-center mx-auto mb-3 sm:mb-4 lg:mb-6 text-white text-xl sm:text-2xl lg:text-3xl group-hover:scale-110 transition-transform"
          >
            🔧
          </div>
          <h3
            class="text-base sm:text-lg lg:text-xl font-bold text-[#003087] mb-2 sm:mb-3 lg:mb-4"
          >
            Modern Equipment
          </h3>
          <p class="text-xs sm:text-sm lg:text-base text-gray-600">
            Only centers with 1.5T or higher MRI and 64-slice or higher CT
            scanners from leading manufacturers are eligible.
          </p>
        </div>

        <!-- Standard 4 -->
        <div
          class="bg-white rounded-lg sm:rounded-2xl lg:rounded-3xl p-4 sm:p-6 lg:p-8 shadow-xl border border-gray-100 text-center group hover:-translate-y-2 transition-all duration-300"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <div
            class="w-12 h-12 sm:w-16 sm:h-16 lg:w-20 lg:h-20 bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg sm:rounded-xl lg:rounded-2xl flex items-center justify-center mx-auto mb-3 sm:mb-4 lg:mb-6 text-white text-xl sm:text-2xl lg:text-3xl group-hover:scale-110 transition-transform"
          >
            ⭐
          </div>
          <h3
            class="text-base sm:text-lg lg:text-xl font-bold text-[#003087] mb-2 sm:mb-3 lg:mb-4"
          >
            Patient Satisfaction
          </h3>
          <p class="text-xs sm:text-sm lg:text-base text-gray-600">
            Continuous monitoring of patient experience and outcomes across
            network
          </p>
        </div>
      </div>

      <!-- Quality Guarantee -->
      <div
        class="bg-gradient-to-r from-[#003087] to-[#0052cc] rounded-lg sm:rounded-2xl lg:rounded-3xl p-4 sm:p-6 lg:p-10 text-white text-center shadow-2xl"
        data-aos="fade-up"
        data-aos-delay="500"
      >
        <h3
          class="text-xl sm:text-2xl lg:text-3xl font-bold mb-3 sm:mb-4 lg:mb-6"
        >
          🛡️ Our Quality Guarantee
        </h3>
        <p
          class="text-sm sm:text-base lg:text-xl leading-relaxed max-w-4xl mx-auto mb-4 sm:mb-6 lg:mb-8 px-2 sm:px-0"
        >
          Price competition drives volume, but quality standards are
          non-negotiable. Every USRad center meets the same rigorous standards,
          regardless of their marketplace pricing strategy.
        </p>
        <div
          class="inline-flex items-center gap-2 sm:gap-4 bg-white/20 rounded-lg sm:rounded-xl lg:rounded-2xl px-4 sm:px-6 lg:px-8 py-2 sm:py-3 lg:py-4"
        >
          <span class="text-[#cc9933] text-lg sm:text-xl lg:text-2xl">✓</span>
          <span class="font-semibold text-xs sm:text-sm lg:text-base"
            >Same quality at every price point</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Referral Growth Path – Enhanced Mobile -->
  <section
    class="py-12 sm:py-16 lg:py-20 bg-gradient-to-br from-blue-50 to-white"
  >
    <div class="max-w-6xl mx-auto px-3 sm:px-4 lg:px-6">
      <h2
        class="text-center text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#003087] mb-4 sm:mb-6 font-manrope px-2 sm:px-0"
        data-aos="fade-up"
      >
        The Referral Growth Path
      </h2>
      <p
        class="text-center text-sm sm:text-base lg:text-lg text-gray-700 max-w-2xl mx-auto mb-8 sm:mb-12 lg:mb-16 px-2 sm:px-0"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Every patient is a strategic opportunity to build trust, expand referral
        networks, and elevate your reimbursement mix.
      </p>

      <div
        class="relative border-l-4 border-blue-200 pl-4 sm:pl-6 space-y-8 sm:space-y-10 lg:space-y-14 mb-12 sm:mb-16 lg:mb-20"
      >
        <!-- Step 1 -->
        <div
          class="relative pl-8 sm:pl-12"
          data-aos="fade-right"
          data-aos-delay="200"
        >
          <div
            class="absolute -left-[33px] sm:-left-[45px] top-1 bg-green-500 text-white w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center font-bold shadow-lg text-sm sm:text-base"
          >
            1
          </div>
          <div class="flex items-start gap-3 sm:gap-4">
            <svg
              class="w-5 h-5 sm:w-6 sm:h-6 text-green-500 mt-1 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 8c-1.1 0-2 .9-2 2v4h4v-4c0-1.1-.9-2-2-2z"
              ></path><path d="M12 2v2"></path><path d="M12 20v2"></path><path
                d="M4.93 4.93l1.41 1.41"></path><path d="M17.66 17.66l1.41 1.41"
              ></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path
                d="M4.93 19.07l1.41-1.41"></path><path d="M17.66 6.34l1.41-1.41"
              ></path></svg
            >
            <div>
              <h3
                class="text-green-600 font-bold text-base sm:text-lg lg:text-xl mb-1 sm:mb-2"
              >
                Strategic Pricing Advantage
              </h3>
              <p class="text-gray-600 text-sm sm:text-base">
                Position your center for optimal visibility and case volume.
              </p>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div
          class="relative pl-8 sm:pl-12"
          data-aos="fade-left"
          data-aos-delay="300"
        >
          <div
            class="absolute -left-[33px] sm:-left-[45px] top-1 bg-blue-500 text-white w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center font-bold shadow-lg text-sm sm:text-base"
          >
            2
          </div>
          <div class="flex items-start gap-3 sm:gap-4">
            <svg
              class="w-5 h-5 sm:w-6 sm:h-6 text-blue-500 mt-1 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              stroke-linecap="round"
              stroke-linejoin="round"
