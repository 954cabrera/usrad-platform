  <!-- JavaScript for Calculator -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const slotsSlider = document.getElementById("emptySlots2");
      const slotsDisplay = document.getElementById("slotsDisplay");
      const pricingStrategy = document.getElementById("pricingStrategy");
      const expectedVolume = document.getElementById("expectedVolume");
      const revenuePerScan = document.getElementById("revenuePerScan");
      const monthlyRevenue = document.getElementById("monthlyRevenue");
      const marketplaceRank = document.getElementById("marketplaceRank");

      function updateCalculator() {
        const slots = parseInt(slotsSlider.value);
        const strategy = parseInt(pricingStrategy.value);

        // Update slots display
        slotsDisplay.textContent = slots;

        // Volume calculation based on pricing strategy
        let volume;
        let rank;

        if (strategy === 100) {
          volume = Math.floor(slots * 8.5); // Higher volume at 100%
          rank = "Top 20%";
        } else if (strategy === 120) {
          volume = Math.floor(slots * 5.5); // Medium volume at 120%
          rank = "Top 50%";
        } else {
          // 140%
          volume = Math.floor(slots * 2.5); // Lower volume at 140%
          rank = "Top 80%";
        }

        // Revenue per scan based on strategy
        let perScan;
        if (strategy === 100) {
          perScan = 270;
        } else if (strategy === 120) {
          perScan = 300;
        } else {
          perScan = 330;
        }

        // Calculate monthly revenue
        const monthly = volume * perScan;

        // Update display
        expectedVolume.textContent = volume;
        revenuePerScan.textContent = `$${perScan}`;
        monthlyRevenue.textContent = `$${monthly.toLocaleString()}`;
        marketplaceRank.textContent = rank;
      }

      // Event listeners
      slotsSlider.addEventListener("input", updateCalculator);
      pricingStrategy.addEventListener("change", updateCalculator);

      // Initialize
      updateCalculator();
    });
  </script>

