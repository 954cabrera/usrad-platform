---
import MainLayout from "../layouts/MainLayout.astro";
import AOSInit from "../components/AOSInit.astro";

// Page metadata
const title =
  "Turn Empty Slots into Revenue Within Days - USRad Provider Network";
const description =
  "Stop leaving money on the table. Fill your empty MRI and CT slots with consistent Medicare+ volume. No setup costs, 5-7 day payments, panels closing soon.";
---

<MainLayout>
  <Fragment slot="title">{title}</Fragment>

  <AOSInit />

  <!-- Premium Hero Section -->
  <section
    class="relative min-h-[85vh] overflow-hidden bg-gradient-to-br from-[#fefbf5] via-white to-[#f8f5e8]"
  >
    <!-- Background Elements -->
    <div class="absolute inset-0">
      <div
        class="absolute top-20 right-20 w-96 h-96 bg-gradient-to-br from-[#cc9933]/10 to-[#e6c378]/5 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-20 left-20 w-80 h-80 bg-gradient-to-br from-[#003087]/10 to-[#0052cc]/5 rounded-full blur-3xl"
      >
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left Content -->
        <div class="space-y-8" data-aos="fade-up">
          <!-- Status Badge -->
          <div
            class="inline-flex items-center justify-center px-4 py-2 bg-gradient-to-r from-red-500 to-pink-500 text-white text-sm font-semibold rounded-full animate-pulse"
          >
            <span class="w-2 h-2 bg-white rounded-full mr-2 animate-ping"
            ></span>
            Provider Panels Closing Soon by Region
          </div>

          <h1
            class="text-5xl sm:text-6xl lg:text-7xl font-bold text-[#003087] mb-8 leading-[0.9] font-manrope"
          >
            Turn Empty Slots<br />
            Into <span
              class="bg-gradient-to-r from-[#cc9933] to-[#e6c378] bg-clip-text text-transparent"
              >Revenue</span
            ><br />
            Within Days
          </h1>

          <p
            class="text-xl sm:text-2xl text-gray-600 mb-8 leading-relaxed font-medium"
          >
            Set your rate. Get booked. Get paid fast!
          </p>

          <!-- Key Industry Insight -->
          <div
            class="bg-gradient-to-r from-[#fef8e5] to-[#fcf9f0] border border-[#e6c378]/30 rounded-2xl p-8 mb-8 text-left shadow-lg"
          >
            <p
              class="text-lg font-semibold text-[#003087] leading-relaxed font-manrope"
            >
              "You're already offering discounts. You're already sitting on
              unused capacity.<br />
              <span
                class="bg-gradient-to-r from-[#cc9933] to-[#e6c378] bg-clip-text text-transparent font-bold"
                >Why not turn that into consistent revenue—and new referring
                physicians?"</span
              >
            </p>
          </div>

          <!-- Primary CTA -->
          <div
            class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-6"
          >
            <a
              href="/login/imaginglogin"
              class="group relative overflow-hidden bg-gradient-to-r from-[#cc9933] to-[#e6c378] text-[#003087] font-bold text-lg px-10 py-5 rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 text-center"
            >
              <span class="relative z-10"
                >Start Onboarding – Takes 5 Minutes →</span
              >
              <div
                class="absolute inset-0 bg-gradient-to-r from-[#e6c378] to-[#cc9933] opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              >
              </div>
            </a>

            <a
              href="/managed-care"
              class="border-2 border-[#003087] text-[#003087] hover:bg-[#003087] hover:text-white font-semibold px-8 py-5 rounded-2xl transition-all duration-300 text-center"
            >
              How We Built $20M AnciCare
            </a>
          </div>

          <!-- Trust Indicators -->
          <div class="text-sm text-gray-500">
            <p class="mb-2">
              No setup cost • Medicare-based rates • Consistent volume
            </p>
            <p>
              Already started? <a
                href="/login/imaginglogin"
                class="underline text-[#003087] hover:text-[#cc9933] font-medium"
                >Resume here</a
              >
            </p>
          </div>
        </div>

        <!-- Right: Premium Revenue Calculator -->
        <div data-aos="fade-left" data-aos-delay="200">
          <div
            class="bg-white/80 backdrop-blur-sm rounded-3xl p-8 shadow-2xl border border-white/50"
          >
            <div class="text-center mb-8">
              <h3 class="text-2xl font-bold text-[#003087] mb-2 font-manrope">
                Your Empty Slots Are Costing You
              </h3>
              <p class="text-gray-600">
                See the real impact of unused capacity
              </p>
            </div>

            <!-- Interactive Calculator -->
            <div class="space-y-6">
              <!-- Input Section -->
              <div
                class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-6 border border-blue-100"
              >
                <label class="block text-sm font-semibold text-gray-700 mb-3"
                  >Empty MRI slots per day:</label
                >
                <div class="flex items-center gap-4">
                  <input
                    type="range"
                    id="emptySlots"
                    min="1"
                    max="8"
                    value="3"
                    class="flex-1 h-3 bg-blue-200 rounded-lg appearance-none cursor-pointer"
                  />
                  <span
                    id="slotsValue"
                    class="text-2xl font-bold text-[#003087] w-8">3</span
                  >
                </div>
              </div>

              <!-- Results Section -->
              <div class="space-y-4">
                <!-- Current Loss -->
                <div
                  class="bg-gradient-to-r from-red-50 to-pink-50 border border-red-200 rounded-xl p-5"
                >
                  <div class="flex justify-between items-center">
                    <span class="font-semibold text-red-800"
                      >Monthly lost opportunity</span
                    >
                    <span
                      id="lostRevenue"
                      class="text-2xl font-bold text-red-600">$0</span
                    >
                  </div>
                  <div class="text-sm text-red-700 mt-1">
                    Zero revenue from million-dollar+ equipment
                  </div>
                </div>

                <!-- Medicare Baseline -->
                <div
                  class="bg-gradient-to-r from-yellow-50 to-amber-50 border border-yellow-200 rounded-xl p-5"
                >
                  <div class="flex justify-between items-center">
                    <span class="font-semibold text-yellow-800"
                      >Your Reimbursement Strategy</span
                    >
                    <span class="text-xl font-bold text-yellow-600"
                      >$250-450</span
                    >
                  </div>
                  <div class="text-sm text-yellow-700 mt-1">
                    You choose between 100% - $140% Medicare Allowable
                  </div>
                </div>

                <!-- USRad Solution -->
                <div
                  class="bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200 rounded-xl p-5"
                >
                  <div class="flex justify-between items-center">
                    <span class="font-semibold text-green-800"
                      >With USRad volume</span
                    >
                    <span
                      id="usradRevenue"
                      class="text-2xl font-bold text-green-600">+$22,500</span
                    >
                  </div>
                  <div class="text-sm text-green-700 mt-1">
                    Additional monthly revenue at Medicare+ rates
                  </div>
                </div>
              </div>

              <!-- CTA -->
              <a
                href="/login/imaginglogin"
                class="block w-full bg-gradient-to-r from-[#003087] to-[#0052cc] text-white font-bold py-4 rounded-2xl hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 text-center"
              >
                Lock in My Center →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Centers Choose USRad -->
  <section class="py-24 bg-white relative overflow-hidden">
    <div
      class="absolute inset-0 bg-gradient-to-br from-[#fcf9f0]/30 via-transparent to-[#f8f5e8]/20"
    >
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-12">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-4xl font-bold text-[#003087] mb-6 font-manrope">
          Why Centers Love USRad
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Four simple reasons providers join our network and stay
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Benefit 1 -->
        <div
          class="group bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:border-[#cc9933]/30 transition-all duration-300 hover:-translate-y-2 text-center"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-[#cc9933] to-[#e6c378] rounded-2xl flex items-center justify-center mx-auto mb-6 text-white text-2xl"
          >
            📅
          </div>
          <h3 class="text-xl font-bold text-[#003087] mb-4 font-manrope">
            Fill Unbooked Time
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Turn afternoon gaps and cancellations into consistent revenue
            streams
          </p>
        </div>

        <!-- Benefit 2 -->
        <div
          class="group bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:border-[#cc9933]/30 transition-all duration-300 hover:-translate-y-2 text-center"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-[#003087] to-[#0052cc] rounded-2xl flex items-center justify-center mx-auto mb-6 text-white text-2xl"
          >
            💰
          </div>
          <h3 class="text-xl font-bold text-[#003087] mb-4 font-manrope">
            No Setup Cost
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Zero upfront investment. No monthly fees. Pure incremental revenue
          </p>
        </div>

        <!-- Benefit 3 -->
        <div
          class="group bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:border-[#cc9933]/30 transition-all duration-300 hover:-translate-y-2 text-center"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-2xl flex items-center justify-center mx-auto mb-6 text-white text-2xl"
          >
            🏥
          </div>
          <h3 class="text-xl font-bold text-[#003087] mb-4 font-manrope">
            Medicare-Based Rates
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Fair, consistent pricing you already know and accept
          </p>
        </div>

        <!-- Benefit 4 -->
        <div
          class="group bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:border-[#cc9933]/30 transition-all duration-300 hover:-translate-y-2 text-center"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <div
            class="w-16 h-16 bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-6 text-white text-2xl"
          >
            ⚡
          </div>
          <h3 class="text-xl font-bold text-[#003087] mb-4 font-manrope">
            Get Paid in 5–7 Days
          </h3>
          <p class="text-gray-600 leading-relaxed">
            No insurance delays. No denied claims. Guaranteed payment
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Industry Insight Section -->
  <section
    class="py-24 bg-gradient-to-br from-[#003087] via-[#0052cc] to-[#003087] text-white relative overflow-hidden"
  >
    <div class="absolute inset-0">
      <div
        class="absolute top-20 left-20 w-72 h-72 bg-[#cc9933]/10 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-20 right-20 w-96 h-96 bg-white/5 rounded-full blur-3xl"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 sm:px-12 text-center">
      <div class="mb-12" data-aos="fade-up">
        <h2 class="text-4xl font-bold mb-6 font-manrope">
          Get In While Panels Are Open
        </h2>
        <p class="text-xl opacity-90 max-w-4xl mx-auto leading-relaxed">
          This industry has always worked the same way: when a network shows
          promise, you want to join while the panel is open. Once we have areas
          covered, it becomes much harder for new providers to join.
        </p>
      </div>

      <!-- Key Insight Cards -->
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div
          class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20"
          data-aos="fade-right"
          data-aos-delay="100"
        >
          <h3 class="text-2xl font-bold mb-4 text-[#cc9933]">
            Why Limited Access?
          </h3>
          <p class="text-left opacity-90 leading-relaxed">
            USRad needs to be loyal to participating providers and drive volume
            to those who accepted our reimbursement rates early. Once we achieve
            market density, we protect existing relationships.
          </p>
        </div>

        <div
          class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20"
          data-aos="fade-left"
          data-aos-delay="200"
        >
          <h3 class="text-2xl font-bold mb-4 text-[#cc9933]">
            First-Mover Advantage
          </h3>
          <p class="text-left opacity-90 leading-relaxed">
            Early providers get first access to patient volume, referral
            relationships, and preferred status as we scale. Later entrants
            compete for remaining capacity.
          </p>
        </div>
      </div>

      <!-- Urgency Stats -->
      <div
        class="bg-gradient-to-r from-[#cc9933]/20 to-[#e6c378]/20 rounded-2xl p-8 border border-[#cc9933]/30 mb-12"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div class="grid md:grid-cols-3 gap-8 text-center">
          <div>
            <div class="text-3xl font-bold text-[#cc9933] mb-2">12 States</div>
            <div class="text-sm opacity-80">Currently accepting providers</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-[#cc9933] mb-2">Q4 2025</div>
            <div class="text-sm opacity-80">Major metro panels close</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-[#cc9933] mb-2">Limited</div>
            <div class="text-sm opacity-80">Spots per geographic region</div>
          </div>
        </div>
      </div>

      <!-- Final CTA -->
      <div class="text-center" data-aos="fade-up" data-aos-delay="400">
        <a
          href="/login/imaginglogin"
          class="bg-gradient-to-r from-[#cc9933] to-[#e6c378] text-[#003087] font-bold text-xl px-12 py-6 rounded-2xl shadow-2xl hover:shadow-3xl transition-all duration-300 transform hover:-translate-y-1 mb-4 inline-block"
        >
          Secure My Spot Now →
        </a>
        <p class="text-sm opacity-70">
          Join while panels are open • 5-minute onboarding • Start earning
          within days
        </p>
      </div>
    </div>
  </section>

  <!-- Proven Experience -->
  <section class="py-24 bg-gradient-to-br from-[#fefbf5] to-[#f8f5e8]">
    <div class="max-w-6xl mx-auto px-6 sm:px-12">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Left: Track Record -->
        <div data-aos="fade-right">
          <h2 class="text-4xl font-bold text-[#003087] mb-6 font-manrope">
            We've Done This Before
          </h2>
          <p class="text-xl text-gray-700 mb-8 leading-relaxed">
            Our founder Michael Cabrera built AnciCare PPO from startup to $20M+
            annual revenue with 1,200+ imaging centers before its successful
            acquisition.
          </p>

          <!-- Achievement Grid -->
          <div class="grid grid-cols-2 gap-6 mb-8">
            <div
              class="bg-white rounded-2xl p-6 shadow-lg text-center border border-gray-100"
            >
              <div class="text-3xl font-bold text-[#cc9933] mb-2">$20M+</div>
              <div class="text-sm text-gray-600 font-medium">
                Annual Revenue
              </div>
            </div>
            <div
              class="bg-white rounded-2xl p-6 shadow-lg text-center border border-gray-100"
            >
              <div class="text-3xl font-bold text-[#003087] mb-2">1,200+</div>
              <div class="text-sm text-gray-600 font-medium">
                Provider Centers
              </div>
            </div>
            <div
              class="bg-white rounded-2xl p-6 shadow-lg text-center border border-gray-100"
            >
              <div class="text-3xl font-bold text-[#cc9933] mb-2">3,000+</div>
              <div class="text-sm text-gray-600 font-medium">Radiologists</div>
            </div>
            <div
              class="bg-white rounded-2xl p-6 shadow-lg text-center border border-gray-100"
            >
              <div class="text-3xl font-bold text-[#003087] mb-2">2002</div>
              <div class="text-sm text-gray-600 font-medium">
                Successful Exit
              </div>
            </div>
          </div>

          <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
            <h4 class="font-bold text-[#003087] mb-3">What We Learned:</h4>
            <ul class="text-sm space-y-2 text-gray-700">
              <li class="flex items-start gap-3">
                <span
                  class="w-2 h-2 bg-[#cc9933] rounded-full mt-2 flex-shrink-0"
                ></span>
                <span
                  >Imaging centers need <strong>consistent volume</strong> more than
                  high per-scan rates</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="w-2 h-2 bg-[#cc9933] rounded-full mt-2 flex-shrink-0"
                ></span>
                <span
                  >Fast payment creates <strong>provider loyalty</strong> and referrals</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="w-2 h-2 bg-[#cc9933] rounded-full mt-2 flex-shrink-0"
                ></span>
                <span
                  >Early providers get <strong>preferred status</strong> as networks
                  scale</span
                >
              </li>
            </ul>
          </div>
        </div>

        <!-- Right: Dashboard Preview -->
        <div
          class="bg-white rounded-3xl p-8 shadow-2xl border border-gray-100"
          data-aos="fade-left"
          data-aos-delay="200"
        >
          <h3
            class="text-2xl font-bold text-[#003087] mb-6 text-center font-manrope"
          >
            Your USRad Dashboard Experience
          </h3>

          <div class="space-y-6">
            <div
              class="bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200 rounded-xl p-5"
            >
              <div class="flex items-center gap-3 mb-2">
                <div
                  class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center text-white text-sm font-bold"
                >
                  1
                </div>
                <span class="font-semibold text-green-800"
                  >Volume Calculator</span
                >
              </div>
              <div class="text-sm text-green-700">
                See potential: 15-25 additional scans/month
              </div>
            </div>

            <div
              class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-xl p-5"
            >
              <div class="flex items-center gap-3 mb-2">
                <div
                  class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white text-sm font-bold"
                >
                  2
                </div>
                <span class="font-semibold text-blue-800"
                  >Complete PSA Online</span
                >
              </div>
              <div class="text-sm text-blue-700">
                Digital signature in 5-10 minutes
              </div>
            </div>

            <div
              class="bg-gradient-to-r from-purple-50 to-violet-50 border border-purple-200 rounded-xl p-5"
            >
              <div class="flex items-center gap-3 mb-2">
                <div
                  class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center text-white text-sm font-bold"
                >
                  3
                </div>
                <span class="font-semibold text-purple-800"
                  >Track Setup Progress</span
                >
              </div>
              <div class="text-sm text-purple-700">
                Real-time credentialing status
              </div>
            </div>

            <div
              class="bg-gradient-to-r from-yellow-50 to-amber-50 border border-yellow-200 rounded-xl p-5"
            >
              <div class="flex items-center gap-3 mb-2">
                <div
                  class="w-8 h-8 bg-yellow-500 rounded-full flex items-center justify-center text-white text-sm font-bold"
                >
                  4
                </div>
                <span class="font-semibold text-yellow-800"
                  >Start Receiving Patients</span
                >
              </div>
              <div class="text-sm text-yellow-700">
                Payment in 5-7 days guaranteed
              </div>
            </div>
          </div>

          <a
            href="/login/imaginglogin"
            class="block w-full mt-8 bg-gradient-to-r from-[#cc9933] to-[#e6c378] text-[#003087] font-bold py-4 rounded-2xl hover:shadow-lg transition-all duration-300 text-center"
          >
            Access My Dashboard →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final High-Converting CTA -->
  <section
    class="py-24 bg-gradient-to-r from-[#003087] via-[#0052cc] to-[#003087] text-white relative overflow-hidden"
  >
    <div class="absolute inset-0">
      <div
        class="absolute top-10 left-10 w-64 h-64 bg-[#cc9933]/10 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-10 right-10 w-80 h-80 bg-white/5 rounded-full blur-3xl"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 sm:px-12 text-center">
      <h2 class="text-5xl font-bold mb-8 font-manrope" data-aos="fade-up">
        Get Started in Under 5 Minutes
      </h2>
      <p
        class="text-2xl mb-12 opacity-90 leading-relaxed"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Stop watching revenue walk out the door. Fill your empty slots with
        Medicare+ rates starting this week.
      </p>

      <!-- Final Stats Row -->
      <div class="grid md:grid-cols-3 gap-8 mb-12">
        <div
          class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20"
          data-aos="zoom-in"
          data-aos-delay="200"
        >
          <div class="text-3xl font-bold text-[#cc9933] mb-2">5 min</div>
          <div class="text-sm opacity-80">Complete onboarding</div>
        </div>
        <div
          class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20"
          data-aos="zoom-in"
          data-aos-delay="300"
        >
          <div class="text-3xl font-bold text-[#cc9933] mb-2">7 days</div>
          <div class="text-sm opacity-80">First payment received</div>
        </div>
        <div
          class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20"
          data-aos="zoom-in"
          data-aos-delay="400"
        >
          <div class="text-3xl font-bold text-[#cc9933] mb-2">$0</div>
          <div class="text-sm opacity-80">Setup cost or risk</div>
        </div>
      </div>

      <!-- Ultimate CTA -->
      <div class="mb-8" data-aos="fade-up" data-aos-delay="500">
        <a
          href="/login/imaginglogin"
          class="group relative overflow-hidden bg-gradient-to-r from-[#cc9933] to-[#e6c378] text-[#003087] font-bold text-2xl px-16 py-6 rounded-2xl shadow-2xl hover:shadow-3xl transition-all duration-300 transform hover:-translate-y-2 inline-block"
        >
          <span class="relative z-10">Start Onboarding Now →</span>
          <div
            class="absolute inset-0 bg-gradient-to-r from-[#e6c378] to-[#cc9933] opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
          </div>
        </a>
      </div>

      <p class="text-lg opacity-80" data-aos="fade-up" data-aos-delay="600">
        Join the network that understands your business • Built by imaging
        industry veterans
      </p>
    </div>
  </section>

  <!-- JavaScript for Interactive Calculator -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const slider = document.getElementById("emptySlots");
      const slotsValue = document.getElementById("slotsValue");
      const lostRevenue = document.getElementById("lostRevenue");
      const usradRevenue = document.getElementById("usradRevenue");

      function updateCalculator() {
        const slots = parseInt(slider.value);
        slotsValue.textContent = slots;

        // Calculate lost opportunity (slots * $300 average * 22 working days)
        const monthlyLost = slots * 300 * 22;
        lostRevenue.textContent = `$${monthlyLost.toLocaleString()}`;

        // Calculate USRad revenue (slots * $350 average * 22 working days)
        const monthlyUSRad = slots * 350 * 22;
        usradRevenue.textContent = `+$${monthlyUSRad.toLocaleString()}`;
      }

      if (slider) {
        slider.addEventListener("input", updateCalculator);
        updateCalculator(); // Initialize
      }
    });
  </script>

  <style>
    /* Custom slider styling */
    #emptySlots {
      background: linear-gradient(
        to right,
        #3b82f6 0%,
        #3b82f6 37.5%,
        #d1d5db 37.5%,
        #d1d5db 100%
      );
    }

    #emptySlots::-webkit-slider-thumb {
      appearance: none;
      height: 24px;
      width: 24px;
      border-radius: 50%;
      background: #003087;
      cursor: pointer;
      border: 2px solid #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }

    #emptySlots::-moz-range-thumb {
      height: 24px;
      width: 24px;
      border-radius: 50%;
      background: #003087;
      cursor: pointer;
      border: 2px solid #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }

    /* Premium animations */
    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .blur-backdrop {
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    /* Gradient text fallback */
    @supports not (background-clip: text) {
      .bg-clip-text {
        color: #cc9933;
      }
    }
  </style>
</MainLayout>
