---
// imaging-center-carbon.astro
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";
import HeroSection from "../components/provider/HeroSection.astro";
import TrustBar from "../components/provider/TrustBar.astro";
import HowItWorks from "../components/provider/HowItWorks.astro";
import ProvenSuccess from "../components/provider/ProvenSuccess.astro";
import GuaranteeSection from "../components/provider/GuaranteeSection.astro";
import AnciCareStory from "../components/provider/AnciCareStory.astro";
import FAQSection from "../components/provider/FAQSection.astro";
import NetworkBuilding from "../components/provider/NetworkBuilding.astro";
import ConsultationCTA from "../components/provider/ConsultationCTA.astro";
import ExitModal from "../components/provider/ExitModal.astro";
import PriorityMarketsMap from "../components/provider/PriorityMarketsMap.astro";
import MarketScopeShowcase from "../components/provider/MarketScopeShowcase.astro";

export const prerender = true;
---

<CarbonLayout
  title="Join USRad Network - 10 Day Payment Guarantee"
  isHeroPage={true}
  hideNewsletter={true}
>
  <AOSInit />

  <HeroSection />

  <TrustBar />

  <GuaranteeSection />

  <PriorityMarketsMap />

  <HowItWorks />

  <!-- MarketScope Intelligence Showcase - linked from "View Detailed Market Analysis" -->
  <MarketScopeShowcase />

  <ProvenSuccess />

  <AnciCareStory />

  <ConsultationCTA />

  <FAQSection />

  <NetworkBuilding />

  <style>
    /* Float animations */
    @keyframes float {
      0%,
      100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    @keyframes float-delayed {
      0%,
      100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-15px);
      }
    }

    .animate-float {
      animation: float 6s ease-in-out infinite;
    }

    .animate-float-delayed {
      animation: float-delayed 6s ease-in-out infinite;
      animation-delay: 3s;
    }

    /* Pulse animation */
    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.5;
      }
    }

    .animate-pulse {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    /* Animation delays */
    .delay-100 {
      animation-delay: 0.1s;
    }
    .delay-200 {
      animation-delay: 0.2s;
    }
    .delay-300 {
      animation-delay: 0.3s;
    }
    .delay-500 {
      animation-delay: 0.5s;
    }
  </style>

  <ExitModal />
</CarbonLayout>
