<script>
  // Enhanced FAQ Accordion with smooth animations
  document.addEventListener("DOMContentLoaded", () => {
    const accordionButtons = document.querySelectorAll(".faq-accordion-button");

    accordionButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const content = button.nextElementSibling as HTMLElement;
        const iconPlus = button.querySelector(".icon-plus");
        const iconMinus = button.querySelector(".icon-minus");
        const isOpen =
          content.style.maxHeight && content.style.maxHeight !== "0px";

        // Close all other accordions with smooth transition
        document.querySelectorAll(".faq-accordion-content").forEach((item) => {
          (item as HTMLElement).style.maxHeight = "0";
        });
        document
          .querySelectorAll(".icon-plus")
          .forEach((icon) => icon.classList.remove("hidden"));
        document
          .querySelectorAll(".icon-minus")
          .forEach((icon) => icon.classList.add("hidden"));

        // Toggle current accordion
        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + 50 + "px";
          iconPlus?.classList.add("hidden");
          iconMinus?.classList.remove("hidden");

          // Smooth scroll to opened item
          setTimeout(() => {
            button.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }, 300);
        }
      });
    });

    // Enhanced Category filtering with count updates
    const categoryButtons = document.querySelectorAll(".category-button");
    const faqCategories = document.querySelectorAll(".faq-category");
    const faqItems = document.querySelectorAll(".faq-item");
    const visibleCountEl = document.getElementById("visible-count");
    const totalCountEl = document.getElementById("total-count");

    // Set initial counts
    if (totalCountEl) totalCountEl.textContent = faqItems.length.toString();
    if (visibleCountEl) visibleCountEl.textContent = faqItems.length.toString();

    function updateCounts() {
      const visible = document.querySelectorAll(
        '.faq-item:not([style*="display: none"])'
      ).length;
      if (visibleCountEl) visibleCountEl.textContent = visible.toString();
    }

    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const category = button.getAttribute("data-category");

        // Update active button with animation
        categoryButtons.forEach((btn) => {
          btn.classList.remove("active", "bg-[#003087]", "text-white");
          btn.classList.add(
            "bg-white",
            "text-[#003087]",
            "border-2",
            "border-gray-200"
          );
        });
        button.classList.add("active", "bg-[#003087]", "text-white");
        button.classList.remove("bg-white", "border-2", "border-gray-200");

        // Filter FAQs with fade effect
        faqCategories.forEach((cat) => {
          const catElement = cat as HTMLElement;
          if (
            category === "all" ||
            cat.getAttribute("data-category") === category
          ) {
            catElement.style.display = "block";
            // Trigger AOS animation
            catElement.classList.add("aos-animate");
          } else {
            catElement.style.display = "none";
          }
        });

        updateCounts();
      });
    });

    // Enhanced Search with real-time results count
    const searchInput = document.getElementById(
      "faq-search"
    ) as HTMLInputElement;
    const searchResultsCount = document.getElementById(
      "search-results-count"
    ) as HTMLElement;

    searchInput?.addEventListener("input", (e) => {
      const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
      const allFaqItems = document.querySelectorAll(".faq-item");
      let visibleCount = 0;

      allFaqItems.forEach((item) => {
        const question =
          item.querySelector("h3")?.textContent?.toLowerCase() || "";
        const answer =
          item
            .querySelector(".faq-accordion-content")
            ?.textContent?.toLowerCase() || "";

        if (question.includes(searchTerm) || answer.includes(searchTerm)) {
          (item as HTMLElement).style.display = "block";
          visibleCount++;
        } else {
          (item as HTMLElement).style.display = "none";
        }
      });

      // Show all categories when searching
      if (searchTerm) {
        faqCategories.forEach((cat) => {
          (cat as HTMLElement).style.display = "block";
        });

        // Update search results message
        if (searchResultsCount) {
          if (visibleCount === 0) {
            searchResultsCount.textContent = `No results found for "${searchTerm}"`;
            searchResultsCount.className = "text-red-600";
          } else {
            searchResultsCount.textContent = `Found ${visibleCount} result${visibleCount !== 1 ? "s" : ""} for "${searchTerm}"`;
            searchResultsCount.className = "text-green-600 font-semibold";
          }
        }
      } else {
        if (searchResultsCount) searchResultsCount.textContent = "";
        // Reset to active category filter
        const activeButton = document.querySelector(".category-button.active");
        activeButton?.dispatchEvent(new Event("click"));
      }

      updateCounts();
    });

    // Keyboard navigation
    document.addEventListener("keydown", (e) => {
      if (e.key === "/" && e.target !== searchInput) {
        e.preventDefault();
        searchInput?.focus();
      }
    });
  });
</script>

