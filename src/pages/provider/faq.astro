---
// src/pages/provider/faq.astro
import CarbonLayout from "../../layouts/CarbonLayout.astro";
import AOSInit from "../../components/AOSInit.astro";
---

<CarbonLayout
  title="Provider Network FAQs | USRad"
  isHeroPage={false}
  hideNewsletter={true}
>
  <AOSInit />

  <!-- Hero Section - Enhanced Carbon Style -->
  <section
    class="relative bg-gradient-to-br from-[#001a4d] via-[#003087] to-[#004299] text-white pt-32 pb-28 px-6 overflow-hidden"
  >
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div
        class="absolute top-20 right-20 w-96 h-96 rounded-full bg-[#cc9933] opacity-10 blur-3xl animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-20 left-20 w-96 h-96 rounded-full bg-[#cc9933] opacity-10 blur-3xl animate-pulse"
        style="animation-delay: 2s;"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-[#cc9933] opacity-5 blur-3xl"
      >
      </div>
    </div>

    <div class="max-w-6xl mx-auto relative z-10">
      <div class="text-center">
        <!-- Back Link -->
        <div class="mb-8" data-aos="fade-down">
          <a
            href="/provider"
            class="inline-flex items-center text-[#cc9933] hover:text-white transition-all duration-300 text-sm font-semibold group"
          >
            <svg
              class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Provider Page
          </a>
        </div>

        <!-- Title with Icon -->
        <div
          class="flex items-center justify-center mb-6"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <svg
            class="w-16 h-16 text-[#cc9933] mr-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
        </div>

        <h1
          class="text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-tight text-white mb-6"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          Provider Network <span class="text-[#cc9933]">FAQs</span>
        </h1>

        <p
          class="mt-6 text-xl sm:text-2xl text-gray-200 max-w-3xl mx-auto leading-relaxed"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          Get answers to your questions about joining the USRad network
        </p>

        <!-- Quick Stats -->
        <div
          class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <div
            class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20"
          >
            <div class="text-4xl font-bold text-[#cc9933]">48hrs</div>
            <div class="text-sm text-gray-200 mt-2">
              Average Onboarding Time
            </div>
          </div>
          <div
            class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20"
          >
            <div class="text-4xl font-bold text-[#cc9933]">$0</div>
            <div class="text-sm text-gray-200 mt-2">Joining Costs</div>
          </div>
          <div
            class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20"
          >
            <div class="text-4xl font-bold text-[#cc9933]">10 Days</div>
            <div class="text-sm text-gray-200 mt-2">Payment Guarantee</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Search & Filter Section - Enhanced -->
  <section class="py-12 bg-gradient-to-b from-[#f8f9fa] to-white">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Search Bar with Enhanced Styling -->
      <div class="max-w-3xl mx-auto mb-12" data-aos="fade-up">
        <div class="relative group">
          <div
            class="absolute inset-0 bg-gradient-to-r from-[#cc9933] to-[#b8861f] rounded-xl blur opacity-25 group-hover:opacity-40 transition duration-300"
          >
          </div>
          <div class="relative">
            <input
              type="text"
              id="faq-search"
              class="w-full border-2 border-gray-300 bg-white h-16 px-6 pr-16 rounded-xl text-lg focus:outline-none focus:border-[#cc9933] focus:ring-4 focus:ring-[#cc9933]/20 transition-all"
              placeholder="Search for answers..."
            />
            <button
              type="submit"
              class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-[#cc9933] hover:bg-[#b8861f] text-white p-2 rounded-lg transition-colors"
            >
              <svg
                class="h-6 w-6"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </button>
          </div>
        </div>
        <p class="text-center text-sm text-gray-500 mt-3">
          <span id="search-results-count"></span>
        </p>
      </div>

      <!-- Enhanced Category Pills -->
      <div class="mb-12" data-aos="fade-up" data-aos-delay="100">
        <div class="flex flex-wrap justify-center gap-3">
          <button
            class="category-button active px-8 py-4 bg-[#003087] text-white rounded-full font-semibold hover:bg-[#002266] transition-all transform hover:scale-105 shadow-lg"
            data-category="all"
          >
            <span class="flex items-center gap-2">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
              All Questions
            </span>
          </button>
          <button
            class="category-button px-8 py-4 bg-white text-[#003087] border-2 border-gray-200 rounded-full font-semibold hover:border-[#cc9933] hover:text-[#cc9933] hover:shadow-lg transition-all transform hover:scale-105"
            data-category="joining"
          >
            <span class="flex items-center gap-2">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
                ></path>
              </svg>
              Joining
            </span>
          </button>
          <button
            class="category-button px-8 py-4 bg-white text-[#003087] border-2 border-gray-200 rounded-full font-semibold hover:border-[#cc9933] hover:text-[#cc9933] hover:shadow-lg transition-all transform hover:scale-105"
            data-category="financial"
          >
            <span class="flex items-center gap-2">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
              Financial
            </span>
          </button>
          <button
            class="category-button px-8 py-4 bg-white text-[#003087] border-2 border-gray-200 rounded-full font-semibold hover:border-[#cc9933] hover:text-[#cc9933] hover:shadow-lg transition-all transform hover:scale-105"
            data-category="operations"
          >
            <span class="flex items-center gap-2">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                ></path><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              Operations
            </span>
          </button>
          <button
            class="category-button px-8 py-4 bg-white text-[#003087] border-2 border-gray-200 rounded-full font-semibold hover:border-[#cc9933] hover:text-[#cc9933] hover:shadow-lg transition-all transform hover:scale-105"
            data-category="technical"
          >
            <span class="flex items-center gap-2">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              Technical
            </span>
          </button>
        </div>
      </div>

      <!-- Results Counter -->
      <div class="text-center mb-8">
        <p class="text-sm text-gray-600">
          Showing <span id="visible-count" class="font-semibold text-[#003087]"
            >12</span
          > of <span id="total-count" class="font-semibold text-[#003087]"
            >12</span
          > questions
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Content Section - Enhanced Cards -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Joining USRad FAQs -->
      <div class="faq-category mb-20" data-category="joining">
        <div class="flex items-center gap-4 mb-10" data-aos="fade-up">
          <div class="w-12 h-1 bg-[#cc9933] rounded"></div>
          <h2 class="text-4xl font-bold text-[#003087]">Joining USRad</h2>
          <div class="flex-1 h-1 bg-gray-200 rounded"></div>
        </div>

        <!-- FAQ 1 -->
        <div
          class="faq-item bg-white rounded-2xl shadow-xl border-2 border-gray-100 overflow-hidden mb-6 hover:border-[#cc9933] transition-all duration-300 hover:shadow-2xl"
          data-aos="fade-up"
          data-aos-delay="50"
        >
          <div class="faq-accordion">
            <button
              class="faq-accordion-button w-full p-8 text-left focus:outline-none flex justify-between items-center group"
            >
              <h3
                class="text-2xl font-bold text-[#003087] pr-6 group-hover:text-[#cc9933] transition-colors"
              >
                What is the process to join USRad?
              </h3>
              <div class="flex-shrink-0">
                <div
                  class="w-12 h-12 rounded-full bg-[#cc9933]/10 flex items-center justify-center group-hover:bg-[#cc9933] transition-all"
                >
                  <svg
                    class="icon-plus w-6 h-6 text-[#cc9933] group-hover:text-white transition-colors"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="3"
                      d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                  </svg>
                  <svg
                    class="icon-minus w-6 h-6 text-white hidden"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="3"
                      d="M18 12H6"></path>
                  </svg>
                </div>
              </div>
            </button>
            <div
              class="faq-accordion-content"
              style="max-height: 0; overflow: hidden; transition: max-height 0.4s ease-out;"
            >
              <div class="p-8 pt-0 bg-gradient-to-b from-gray-50 to-white">
                <div class="border-l-4 border-[#cc9933] pl-6">
                  <p class="text-lg text-gray-700 mb-6 leading-relaxed">
                    Joining USRad is quick, guided, and built to minimize
                    disruption to your daily operations:
                  </p>
                  <ol class="space-y-4 text-gray-700">
                    <li class="flex items-start gap-4">
                      <span
                        class="flex-shrink-0 w-8 h-8 bg-[#cc9933] text-white rounded-full flex items-center justify-center font-bold"
                        >1</span
                      >
                      <span class="pt-1"
                        ><strong>Apply online</strong> - Complete our short application
                        in just 20 minutes</span
                      >
                    </li>
                    <li class="flex items-start gap-4">
                      <span
                        class="flex-shrink-0 w-8 h-8 bg-[#cc9933] text-white rounded-full flex items-center justify-center font-bold"
                        >2</span
                      >
                      <span class="pt-1"
                        ><strong>Sign your agreement</strong> - Secure digital e-signature
                        process</span
                      >
                    </li>
                    <li class="flex items-start gap-4">
                      <span
                        class="flex-shrink-0 w-8 h-8 bg-[#cc9933] text-white rounded-full flex items-center justify-center font-bold"
                        >3</span
                      >
                      <span class="pt-1"
                        ><strong>Set up your center profile</strong> - Configure
                        your services and availability through our portal</span
                      >
                    </li>
                    <li class="flex items-start gap-4">
                      <span
                        class="flex-shrink-0 w-8 h-8 bg-[#cc9933] text-white rounded-full flex items-center justify-center font-bold"
                        >4</span
                      >
                      <span class="pt-1"
                        ><strong>Credentialing review</strong> - We verify your documentation
                        and imaging credentials to ensure compliance</span
                      >
                    </li>
                    <li class="flex items-start gap-4">
                      <span
                        class="flex-shrink-0 w-8 h-8 bg-[#cc9933] text-white rounded-full flex items-center justify-center font-bold"
                        >5</span
                      >
                      <span class="pt-1"
                        ><strong>Orientation and go-live</strong> - Access quick
                        training, then start receiving patient referrals once approved</span
                      >
                    </li>
                  </ol>
                  <div class="mt-8 p-6 bg-[#cc9933]/10 rounded-xl">
                    <p class="text-gray-800 font-semibold">
                      ⚡ <strong>Fast Track:</strong> Most centers complete onboarding
                      and are ready to go live within 7–10 business days, depending
                      on credentialing and profile setup.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- FAQ 2 -->
        <div
          class="faq-item bg-white rounded-2xl shadow-xl border-2 border-gray-100 overflow-hidden mb-6 hover:border-[#cc9933] transition-all duration-300 hover:shadow-2xl"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div class="faq-accordion">
            <button
              class="faq-accordion-button w-full p-8 text-left focus:outline-none flex justify-between items-center group"
            >
              <h3
                class="text-2xl font-bold text-[#003087] pr-6 group-hover:text-[#cc9933] transition-colors"
              >
                What are the requirements to join the USRad network?
              </h3>
              <div class="flex-shrink-0">
                <div
                  class="w-12 h-12 rounded-full bg-[#cc9933]/10 flex items-center justify-center group-hover:bg-[#cc9933] transition-all"
                >
                  <svg
                    class="icon-plus w-6 h-6 text-[#cc9933] group-hover:text-white transition-colors"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="3"
                      d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                  </svg>
                  <svg
                    class="icon-minus w-6 h-6 text-white hidden"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="3"
                      d="M18 12H6"></path>
                  </svg>
                </div>
              </div>
            </button>
            <div
              class="faq-accordion-content"
              style="max-height: 0; overflow: hidden; transition: max-height 0.4s ease-out;"
            >
              <div class="p-8 pt-0 bg-gradient-to-b from-gray-50 to-white">
                <div class="border-l-4 border-[#cc9933] pl-6">
                  <p class="text-lg text-gray-700 mb-6 leading-relaxed">
                    We maintain high standards for our partner centers to ensure
                    quality care. Requirements include:
                  </p>
                  <div class="grid md:grid-cols-2 gap-4 mb-6">
                    <div
                      class="flex items-start gap-3 p-4 bg-white rounded-lg border border-gray-200"
                    >
                      <svg
                        class="w-6 h-6 text-[#cc9933] flex-shrink-0 mt-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                      </svg>
                      <span class="text-gray-700"
                        >ACR accreditation for all imaging modalities</span
                      >
                    </div>
                    <div
                      class="flex items-start gap-3 p-4 bg-white rounded-lg border border-gray-200"
                    >
                      <svg
                        class="w-6 h-6 text-[#cc9933] flex-shrink-0 mt-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                      </svg>
                      <span class="text-gray-700"
                        >Board-certified radiologists</span
                      >
                    </div>
                    <div
                      class="flex items-start gap-3 p-4 bg-white rounded-lg border border-gray-200"
                    >
                      <svg
                        class="w-6 h-6 text-[#cc9933] flex-shrink-0 mt-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                      </svg>
                      <span class="text-gray-700"
                        >Proper state/region licensing</span
                      >
                    </div>
                    <div
                      class="flex items-start gap-3 p-4 bg-white rounded-lg border border-gray-200"
                    >
                      <svg
                        class="w-6 h-6 text-[#cc9933] flex-shrink-0 mt-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                      </svg>
                      <span class="text-gray-700">Modern imaging equipment</span
                      >
                    </div>
                    <div
                      class="flex items-start gap-3 p-4 bg-white rounded-lg border border-gray-200"
                    >
                      <svg
                        class="w-6 h-6 text-[#cc9933] flex-shrink-0 mt-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                      </svg>
                      <span class="text-gray-700"
                        >Digital storage & transmission</span
                      >
                    </div>
                    <div
                      class="flex items-start gap-3 p-4 bg-white rounded-lg border border-gray-200"
                    >
                      <svg
                        class="w-6 h-6 text-[#cc9933] flex-shrink-0 mt-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                      </svg>
                      <span class="text-gray-700"
                        >Excellent patient experience</span
                      >
                    </div>
                  </div>
                  <div
                    class="mt-6 p-6 bg-blue-50 rounded-xl border-l-4 border-[#003087]"
                  >
                    <p class="text-gray-800">
                      <strong>Good news:</strong> Most established imaging centers
                      already meet these requirements. Our eligibility review process
                      will quickly determine if your center qualifies.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- FAQ 3 -->
        <div
          class="faq-item bg-white rounded-2xl shadow-xl border-2 border-gray-100 overflow-hidden mb-6 hover:border-[#cc9933] transition-all duration-300 hover:shadow-2xl"
          data-aos="fade-up"
          data-aos-delay="150"
        >
          <div class="faq-accordion">
            <button
              class="faq-accordion-button w-full p-8 text-left focus:outline-none flex justify-between items-center group"
            >
              <h3
                class="text-2xl font-bold text-[#003087] pr-6 group-hover:text-[#cc9933] transition-colors"
              >
                Are there any costs involved in joining USRad?
              </h3>
              <div class="flex-shrink-0">
                <div
                  class="w-12 h-12 rounded-full bg-[#cc9933]/10 flex items-center justify-center group-hover:bg-[#cc9933] transition-all"
