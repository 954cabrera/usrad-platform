---
// src/pages/provider/network-map.astro
// USRad — Provider Network Map
// Public page at /provider/network-map
//
// Design Contract:
//   §7.3  Hero: flat bg-[#003087] — NO gradients on content surfaces
//   §8.1  Gold (#C9A24D): B2B recruitment CTA only
//   §8.3  Gold max 2 elements per viewport
//   §2.5  No blue-*, indigo-*, purple-*, pink-*, slate-* tokens
//   §3.5  No backdrop-blur, bg-white/*, border-white/* on light surfaces
//   §15.2 Transitions ≤300ms, ease-in-out or ease-out only
//   §15.3 No animate-pulse, bounce, scale-on-hover, parallax, infinite loops
//   §15.8 prefers-reduced-motion respected
//
// Cross-app bridge:
//   Map iframe → ${REMIX_URL}/provider/market-map?embed=true
//   CTA links  → ${REMIX_URL}/signup
//
// Page family:
//   /provider              — Provider overview
//   /provider/portal-tour  — 4-step lifecycle walkthrough
//   /provider/smartmatch   — Recommendation engine explainer
//   /provider/network-map  — This page — market opportunity map

import CarbonLayout from "../../layouts/CarbonLayout.astro";

const REMIX_URL = import.meta.env.PUBLIC_REMIX_URL ?? "https://app.usrad.com";

export const prerender = true;
---

<CarbonLayout
  title="USRad Provider Network Map — Find Your Market"
  isHeroPage={false}
  hideNewsletter={true}
>
  <!-- ═══════════════════════════════════════════════════
    BACK LINK — matches portal-tour and smartmatch pattern
  ════════════════════════════════════════════════════ -->
  <div class="bg-[#003087] pt-20 pb-0 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <a
        href="/provider"
        class="inline-flex items-center gap-2 text-white/50 hover:text-white text-sm font-medium transition-colors duration-200 group"
      >
        <svg
          class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform duration-200"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Provider Overview
      </a>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════
    HERO — flat bg-[#003087] §7.3
    Static dot texture — not animated §3.5 §15.3
  ════════════════════════════════════════════════════ -->
  <section
    class="relative pt-24 pb-16 px-4 sm:px-6 overflow-hidden bg-[#003087]"
  >
    <div
      class="absolute inset-0 opacity-[0.05] pointer-events-none select-none"
      aria-hidden="true"
      style="background-image: radial-gradient(circle, rgba(255,255,255,0.9) 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>

    <div class="relative z-10 max-w-6xl mx-auto">
      <div
        class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-5 py-2 mb-10"
      >
        <span class="w-2 h-2 rounded-full bg-[#C9A24D]"></span>
        <span
          class="text-sm font-semibold text-white/80 tracking-widest uppercase"
          >USRad Network Intelligence</span
        >
      </div>

      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h1
            class="text-5xl sm:text-6xl font-bold text-white leading-[1.08] tracking-tight mb-6"
          >
            See Your Market.<br />
            <span class="text-white/55 font-normal">Claim Your Position.</span>
          </h1>

          <p class="text-lg text-white/55 mb-8 max-w-md leading-relaxed">
            Some markets are already forming. Others are still unclaimed.<br />
            <span class="text-white/40 text-base"
              >The difference is timing — not eligibility.</span
            >
          </p>

          <div class="usrad-step-rail mb-10">
            <div class="usrad-step-item">
              <span class="usrad-step-dot">1</span>
              <span class="usrad-step-text">Select your state</span>
            </div>
            <div class="usrad-step-item">
              <span class="usrad-step-dot">2</span>
              <span class="usrad-step-text">Define your service</span>
            </div>
            <button
              class="usrad-step-item usrad-step-btn is-active"
              onclick="window.scrollToMap()"
              aria-label="Scroll to market map"
            >
              <span class="usrad-step-dot">3</span>
              <span class="usrad-step-text">Evaluate your territory</span>
            </button>
          </div>

          <p class="text-sm text-white/40 mt-2 mb-8">
            Click any cluster to reveal real market conditions
          </p>

          <div class="flex items-center gap-4 flex-wrap">
            <!-- Gold CTA #1 — §8.1 B2B recruitment. Max 2 gold per viewport §8.3 -->
            <a
              href={`${REMIX_URL}/signup`}
              class="inline-flex items-center gap-2 bg-[#C9A24D] hover:bg-[#b8901f] text-white font-semibold px-8 py-3.5 rounded-lg transition-colors duration-200"
            >
              Apply to Join USRad
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a
              href="/provider/portal-tour"
              class="text-white/55 hover:text-white font-medium text-sm border-b border-white/20 hover:border-white/55 pb-px transition-colors duration-200"
            >
              See how it works →
            </a>
          </div>

          <p class="text-xs text-white/25 mt-3">
            No commitment required · ACR accreditation required · Activating by
            market
          </p>
        </div>

        <!-- Stat cluster — bg-white/10 on navy §4.5 permits -->
        <div class="hidden lg:grid grid-cols-2 gap-3">
          {
            [
              {
                num: "26,900+",
                label: "ACR-accredited centers in our national dataset",
              },
              {
                num: "50",
                label: "States — accepting applications nationwide",
              },
              {
                num: "FL",
                label: "First active market — now onboarding providers",
              },
              {
                num: "3–6 wks",
                label: "Average credentialing window to go live",
              },
            ].map((s) => (
              <div class="bg-white/10 border border-white/15 rounded-xl p-5">
                <p class="text-2xl font-bold text-white mb-1">{s.num}</p>
                <p class="text-xs text-white/45 leading-snug">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
    TOP FRAMING SECTION
    Guides provider before they interact with the map.
    Two-column: context copy left, map legend right.
    bg-white §3.3 — no gradients on content surface §7.1
  ════════════════════════════════════════════════════ -->
  <section class="bg-white border-b border-gray-200 py-12 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Left: context copy -->
        <div>
          <div
            class="inline-flex items-center gap-2 bg-[#E8EDF5] border border-[#003087]/15 rounded-full px-4 py-1.5 mb-5"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-[#003087]"></span>
            <span
              class="text-xs font-semibold text-[#003087] tracking-widest uppercase"
              >Market Intelligence</span
            >
          </div>

          <h2
            class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight mb-4"
          >
            Your Market, Visualized
          </h2>

          <p class="text-gray-600 leading-relaxed mb-6 max-w-lg">
            Each cluster represents real imaging centers already operating in
            your region. This is not a simulation — it is the current market
            landscape.
          </p>

          <ul class="space-y-3 mb-6">
            {
              [
                "Click any cluster to inspect your opportunity",
                "See how many centers are already active in your area",
                "Identify whether your market is still unclaimed",
              ].map((item) => (
                <li class="flex items-start gap-3">
                  <span class="w-5 h-5 rounded-full bg-[#E8EDF5] flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg
                      class="w-3 h-3 text-[#003087]"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      stroke-width="3"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </span>
                  <span class="text-sm text-gray-700">{item}</span>
                </li>
              ))
            }
          </ul>

          <p class="text-xs text-gray-400 italic">
            Early providers define the market. Later providers compete within
            it.
          </p>
        </div>

        <!-- Right: map legend -->
        <div class="lg:pt-2">
          <p
            class="text-xs font-semibold text-gray-500 uppercase tracking-widest mb-4"
          >
            How to read the map
          </p>

          <div
            class="bg-gray-50 border border-gray-200 rounded-xl p-5 space-y-4"
          >
            <div class="flex items-start gap-4">
              <div
                class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0"
                style="background: #1E3A5F; opacity: 0.88; border: 1.5px solid #2D5A8E;"
              >
                <span class="text-white text-xs font-bold" style="opacity: 1;"
                  >24</span
                >
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-900 mb-0.5">
                  Navy cluster — Available market density
                </p>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Count of ACR-accredited centers offering your selected
                  modality. Click to reveal the full opportunity signal.
                </p>
              </div>
            </div>

            <div class="border-t border-gray-200"></div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 pt-0.5">
                <svg
                  width="22"
                  height="28"
                  viewBox="0 0 12 15"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M 6 14.5 C 6 14.5 1 10 1 6 A 5 5 0 1 1 11 6 C 11 10 6 14.5 6 14.5 Z"
                    fill="#CC9933"
                    stroke="white"
                    stroke-width="1"></path>
                  <circle cx="6" cy="6" r="3.2" fill="white" opacity="0.95"
                  ></circle>
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-900 mb-0.5">
                  Gold marker — USRad contracted provider
                </p>
                <p class="text-xs text-gray-500 leading-relaxed">
                  A credentialed USRad partner is active here and receiving
                  patient referrals.
                </p>
              </div>
            </div>

            <div class="border-t border-gray-200"></div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 pt-0.5">
                <svg
                  width="22"
                  height="28"
                  viewBox="0 0 12 15"
                  xmlns="http://www.w3.org/2000/svg"
                  style="opacity: 0.75;"
                >
                  <path
                    d="M 6 14.5 C 6 14.5 1 10 1 6 A 5 5 0 1 1 11 6 C 11 10 6 14.5 6 14.5 Z"
                    fill="#B0B8C8"
                    stroke="#8A96A8"
                    stroke-width="1"></path>
                  <circle cx="6" cy="6" r="2.5" fill="#8A96A8" opacity="0.80"
                  ></circle>
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-900 mb-0.5">
                  Silver marker — Activating Provider (Credentialing in
                  Progress)
                </p>
                <p class="text-xs text-gray-500 leading-relaxed">
                  A provider has committed to this region and is completing
                  credentialing. This market is in motion — Founding Center
                  positioning in adjacent territories is still available.
                </p>
              </div>
            </div>

            <div class="border-t border-gray-200"></div>

            <div class="flex items-start gap-4">
              <div
                class="w-9 h-9 rounded-full border-2 border-dashed border-gray-300 flex items-center justify-center flex-shrink-0"
              >
                <span class="text-gray-400 text-base font-light leading-none"
                  >?</span
                >
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-900 mb-0.5">
                  No gold presence — Open market opportunity
                </p>
                <p class="text-xs text-gray-500 leading-relaxed">
                  No USRad partner has claimed this territory. Your market may
                  still be available.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
    MAP SECTION — iframe embed — UNCHANGED
    MapView logic, clustering, API calls not modified here.
  ════════════════════════════════════════════════════ -->
  <section class="bg-gray-50 border-b border-gray-200" id="market-map">
    <div
      class="relative w-full"
      style="height: calc(100vh - 80px); min-height: 600px;"
    >
      <div
        id="map-loader"
        class="absolute inset-0 flex items-center justify-center bg-gray-50 z-10"
        aria-hidden="true"
      >
        <div class="text-center">
          <div
            class="w-8 h-8 border-2 border-[#003087] border-t-transparent rounded-full mx-auto mb-3"
            style="animation: spin 0.8s linear infinite;"
          >
          </div>
          <p class="text-sm text-gray-500">Loading market map…</p>
        </div>
      </div>

      <iframe
        id="market-map-iframe"
        src={`${REMIX_URL}/provider/market-map?embed=true`}
        width="100%"
        height="100%"
        frameborder="0"
        title="USRad Provider Network Map"
        loading="lazy"
        style="display: block; border: none;"
        onload="document.getElementById('map-loader').style.display='none';"
      ></iframe>
    </div>
  </section>

  <!-- Authority line — map to context bridge -->
  <div class="bg-white border-b border-gray-100 py-5 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto text-center">
      <p class="text-sm text-gray-500 italic">
        This is the same intelligence layer used to expand the USRad network.
      </p>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════
    CONTEXT SECTION — below map
    Explains three visual states — bg-white border-b §3.3
  ════════════════════════════════════════════════════ -->
  <section class="bg-white border-b border-gray-100 py-16 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-3">
          What the map is telling you
        </h2>
        <p class="text-gray-500 max-w-xl mx-auto">
          Every element on this map has meaning. Here's how to read it.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <div class="flex items-center gap-3 mb-4">
            <svg
              width="32"
              height="40"
              viewBox="0 0 12 15"
              xmlns="http://www.w3.org/2000/svg"
              class="flex-shrink-0"
            >
              <path
                d="M 6 14.5 C 6 14.5 1 10 1 6 A 5 5 0 1 1 11 6 C 11 10 6 14.5 6 14.5 Z"
                fill="#CC9933"
                stroke="white"
                stroke-width="1"></path>
              <circle cx="6" cy="6" r="3.2" fill="white" opacity="0.95"
              ></circle>
            </svg>
            <h3 class="text-base font-semibold text-gray-900">
              Gold pin — Market taken
            </h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">
            A contracted USRad partner is active in this area. They have
            completed credentialing and are receiving patient referrals. This
            market already has coverage — but adjacent territories may still be
            open.
          </p>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <div class="flex items-center gap-3 mb-4">
            <svg
              width="32"
              height="40"
              viewBox="0 0 12 15"
              xmlns="http://www.w3.org/2000/svg"
              class="flex-shrink-0"
              style="opacity: 0.75;"
            >
              <path
                d="M 6 14.5 C 6 14.5 1 10 1 6 A 5 5 0 1 1 11 6 C 11 10 6 14.5 6 14.5 Z"
                fill="#B0B8C8"
                stroke="#8A96A8"
                stroke-width="1"></path>
              <circle cx="6" cy="6" r="2.5" fill="#8A96A8" opacity="0.80"
              ></circle>
            </svg>
            <h3 class="text-base font-semibold text-gray-900">
              Silver pin — Activating Provider (Credentialing in Progress)
            </h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">
            A USRad provider has committed to this region. Credentialing is
            already underway. Founding Center positioning in adjacent
            territories remains available — but closes as activation completes.
          </p>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <div class="flex items-center gap-3 mb-4">
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0"
              style="background: #1E3A5F; opacity: 0.88;"
            >
              <span class="text-white text-sm font-bold">47</span>
            </div>
            <h3 class="text-base font-semibold text-gray-900">
              Navy cluster — Your opportunity
            </h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">
            Each number represents ACR-accredited centers offering your selected
            modality. These are the centers in your potential market — and the
            patients they serve represent your pipeline once you join USRad.
          </p>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <div class="flex items-center gap-3 mb-4">
            <div
              class="w-8 h-8 rounded-full border-2 border-dashed border-gray-300 flex items-center justify-center flex-shrink-0"
            >
              <span class="text-gray-400 text-lg font-light leading-none"
                >+</span
              >
            </div>
            <h3 class="text-base font-semibold text-gray-900">
              No gold pin — Market open
            </h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">
            No USRad partner has claimed this territory yet. Click the cluster
            to see the exact opportunity signal — how many centers, how much
            demand, and whether you would be the first provider in this region.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
    BOTTOM CONVERSION SECTION
    flat bg-[#003087] §7.3
    Gold CTA #2 — §8.1 B2B context, max 2 per viewport §8.3
  ════════════════════════════════════════════════════ -->
  <!-- Bridge — insight to action -->
  <div class="bg-gray-50 border-b border-gray-200 py-6 px-4 sm:px-6">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-gray-600 text-base">
        If your market is still open, you're early.<br />
        <span class="text-gray-400 text-sm">That's where the advantage is.</span
        >
      </p>
    </div>
  </div>

  <section class="bg-[#003087] py-16 px-4 sm:px-6 text-center">
    <div class="max-w-2xl mx-auto">
      <p
        class="text-white/55 text-sm mb-2 tracking-widest uppercase font-semibold"
      >
        Ready to claim your position?
      </p>

      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Apply to Join USRad
      </h2>

      <p class="text-white/55 mb-8 leading-relaxed">
        If your market is still open, now is the time to establish your presence
        before benchmarks are set. Markets activate on a rolling basis — Florida
        is live now. Your market may be next.
      </p>

      <!-- Gold CTA #2 — §8.1 B2B recruitment context -->
      <a
        href={`${REMIX_URL}/signup`}
        class="inline-flex items-center gap-2 bg-[#C9A24D] hover:bg-[#b8901f] text-white font-semibold px-10 py-4 rounded-lg transition-colors duration-200 text-base"
      >
        Begin Provider Application
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>

      <p class="text-white/25 text-xs mt-4">
        No commitment required · ACR accreditation required · 10-day payment
        model
      </p>
    </div>
  </section>

  <!-- Spinner only — no other animation §15.3 -->
  <style>
    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: 0.01ms !important;
      }
    }

    /* ── USRad Step Rail ── */
    .usrad-step-rail {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding-left: 18px;
    }
    .usrad-step-rail::before {
      content: "";
      position: absolute;
      left: 8px;
      top: 4px;
      bottom: 4px;
      width: 1px;
      background: rgba(255, 255, 255, 0.12);
    }
    .usrad-step-item {
      display: flex;
      align-items: center;
      gap: 10px;
      opacity: 0.7;
      transition: opacity 200ms ease;
    }
    .usrad-step-item.is-active {
      opacity: 1;
    }
    .usrad-step-dot {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
      color: white;
      flex-shrink: 0;
    }
    .usrad-step-item.is-active .usrad-step-dot {
      background: #c9a24d;
    }
    .usrad-step-text {
      font-size: 13px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.75);
    }
    .usrad-step-item.is-active .usrad-step-text {
      color: white;
    }
    .usrad-step-btn {
      background: none;
      border: none;
      cursor: pointer;
      text-align: left;
    }
    .usrad-step-btn:hover {
      opacity: 1 !important;
    }
  </style>

  <!-- Phase 2.9: Step 3 → map scroll + hint trigger -->
  <script>
    window.scrollToMap = function () {
      const el = document.getElementById("market-map");
      if (!el) return;
      el.scrollIntoView({ behavior: "smooth", block: "start" });
      setTimeout(() => {
        const iframe = document.getElementById("market-map-iframe");
        if (iframe && iframe.contentWindow) {
          iframe.contentWindow.postMessage({ type: "usrad:map-focus" }, "*");
        }
      }, 600);
    };
  </script>
</CarbonLayout>
