<!-- ═══════════════════════════════════════════════════
    SCRIPT
    Scroll-driven — IntersectionObserver
    Scoring simulator — CSS transitions only
    §15.2 All transitions ≤300ms (CSS handles easing)
    §15.3 No parallax, no infinite loops
  ════════════════════════════════════════════════════ -->
<script>
  (function () {
    "use strict";

    // ── Factor configuration (public model only — no exact weights) ──
    const FACTORS = [
      {
        id: 0,
        name: "Price",
        fill: 88,
        label: "Competitive",
        section: "pre-factors",
      },
      {
        id: 1,
        name: "Proximity",
        fill: 76,
        label: "2.4 mi away",
        section: "pre-factors",
      },
      {
        id: 2,
        name: "Availability",
        fill: 82,
        label: "2-day avg",
        section: "pre-factors",
      },
      {
        id: 3,
        name: "Experience",
        fill: 93,
        label: "4.8★",
        section: "pre-factors",
      },
      {
        id: 4,
        name: "Accreditation",
        fill: 100,
        label: "ACR ✓",
        section: "pre-factors",
      },
    ];

    // Target score: 92 — displayed without any formula context
    const TARGET_SCORE = 92;

    // ── State ──
    let activeSection = 0;
    let activeFactors = 0; // how many factor bars are filled
    let currentScore = 0;
    let scoreRaf = null;

    // ── DOM refs ──
    const scoreNumEl = document.getElementById("pre-score-num");
    const scoreArcEl = document.getElementById("pre-score-arc");
    const recBadgeEl = document.getElementById("pre-rec-badge");
    const panelNoteEl = document.getElementById("pre-panel-note");
    const CIRCUM = 314; // 2π × 50

    // ── Update score arc ──
    function updateArc(score) {
      if (!scoreArcEl) return;
      const pct = score / 100;
      const offset = CIRCUM - CIRCUM * pct;
      scoreArcEl.style.strokeDashoffset = offset;
      // Color: navy below 70, gold at 90+
      scoreArcEl.style.stroke = score >= 90 ? "#C9A24D" : "#003087";
    }

    // ── Animate score number ──
    function animateScore(target) {
      if (scoreRaf) cancelAnimationFrame(scoreRaf);
      const start = currentScore;
      const diff = target - start;
      const duration = 600;
      const startTime = performance.now();

      function step(now) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        // ease-out
        const eased = 1 - Math.pow(1 - progress, 3);
        const val = Math.round(start + diff * eased);
        if (scoreNumEl) scoreNumEl.textContent = val;
        updateArc(val);
        if (progress < 1) {
          scoreRaf = requestAnimationFrame(step);
        } else {
          currentScore = target;
          scoreRaf = null;
        }
      }
      scoreRaf = requestAnimationFrame(step);
    }

    // ── Set factor bar state ──
    function setFactor(id, active) {
      const fillEl = document.getElementById("pre-fbar-fill-" + id);
      const statusEl = document.getElementById("pre-fbar-status-" + id);
      if (!fillEl || !statusEl) return;

      if (active) {
        fillEl.style.width = FACTORS[id].fill + "%";
        statusEl.textContent = FACTORS[id].label;
        statusEl.style.color = id === 0 ? "#b8901f" : "#003087";
      } else {
        fillEl.style.width = "0%";
        statusEl.textContent = "—";
        statusEl.style.color = "";
      }
    }

    // ── Apply state for a given number of active factors ──
    function applyFactors(n) {
      if (n === activeFactors) return;
      activeFactors = n;

      for (let i = 0; i < 5; i++) {
        setFactor(i, i < n);
      }

      // Score: each factor contributes a visible increment
      // Price (dominant) → large jump; each subsequent adds meaningfully
      const scores = [0, 38, 55, 70, 83, TARGET_SCORE];
      const target = scores[Math.min(n, 5)];
      animateScore(target);

      // Recommendation badge
      if (n >= 5) {
        recBadgeEl && recBadgeEl.classList.add("pre-rec-visible");
        recBadgeEl && recBadgeEl.removeAttribute("aria-hidden");
        if (panelNoteEl)
          panelNoteEl.textContent =
            "This center earns the primary recommendation in its market.";
      } else {
        recBadgeEl && recBadgeEl.classList.remove("pre-rec-visible");
        recBadgeEl && recBadgeEl.setAttribute("aria-hidden", "true");
        if (panelNoteEl) {
          const remaining = 5 - n;
          panelNoteEl.textContent =
            n === 0
              ? "Scroll through the factors to see how each signal builds your score."
              : remaining +
                " factor" +
                (remaining > 1 ? "s" : "") +
                " remaining.";
        }
      }
    }

    // ── Active factor card highlight ──
    function highlightFactor(idx) {
      document.querySelectorAll(".pre-factor").forEach(function (el, i) {
        if (i === idx) {
          el.classList.add("pre-factor-active");
        } else {
          el.classList.remove("pre-factor-active");
        }
      });
    }

    // ── Section nav active state ──
    const SECTION_IDS = [
      "pre-system",
      "pre-factors",
      "pre-patient",
      "pre-fairness",
      "pre-position",
      "pre-founding",
    ];
    function setNavActive(id) {
      document.querySelectorAll(".pre-snav-item").forEach(function (el) {
        const active = el.dataset.section === id;
        el.classList.toggle("pre-snav-active", active);
      });
    }

    // ── Intersection Observer for sections ──
    const sectionObs = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          const id = e.target.id;
          const idx = parseInt(e.target.dataset.section || "0", 10);

          setNavActive(id);
          activeSection = idx;

          // Simulator logic based on which section is in view
          if (id === "pre-system" && activeFactors === 0) {
            applyFactors(0);
          } else if (id === "pre-factors") {
            // Will be handled by factor-level observer below
            // Start with 1 factor filled to prompt curiosity
            if (activeFactors === 0) applyFactors(1);
          } else if (
            id === "pre-patient" ||
            id === "pre-fairness" ||
            id === "pre-position" ||
            id === "pre-founding"
          ) {
            applyFactors(5);
          }
        });
      },
      { threshold: 0.2, rootMargin: "-80px 0px" },
    );

    SECTION_IDS.forEach(function (id) {
      const el = document.getElementById(id);
      if (el) sectionObs.observe(el);
    });

    // ── Intersection Observer for individual factor cards ──
    // Each factor card entering view fills that factor in the panel
    const factorObs = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          const idx = parseInt(e.target.dataset.factor || "0", 10);
          // Fill all factors up to and including this one
          applyFactors(idx + 1);
          highlightFactor(idx);
        });
      },
      { threshold: 0.5, rootMargin: "-60px 0px" },
    );

    document
      .querySelectorAll(".pre-factor[data-factor]")
      .forEach(function (el) {
        factorObs.observe(el);
      });

    // ── Pill / nav scroll-to ──
    function scrollToSection(id) {
      const el = document.getElementById(id);
      if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    document.querySelectorAll(".pre-pill[data-goto]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        scrollToSection(btn.dataset.goto);
      });
    });

    document
      .querySelectorAll(".pre-snav-item[data-section]")
      .forEach(function (btn) {
        btn.addEventListener("click", function () {
          scrollToSection(btn.dataset.section);
        });
      });
  })();
</script>
