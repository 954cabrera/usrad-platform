<!-- Fixed Exit Intent Script - Place this in a separate <script> tag at the bottom of your file -->
<script>
  // Using regular script tag without is:inline to avoid TypeScript issues
  if (typeof window !== "undefined") {
    // Wrap everything in an IIFE to avoid global scope pollution
    (function () {
      "use strict";

      let exitIntentShown = false;
      let modalTimeout = null;

      console.log("Exit intent script loaded");

      function showExitModal() {
        const modal = document.getElementById("exit-modal");
        const modalContent = document.getElementById("exit-modal-content");

        if (modal && modalContent) {
          modal.classList.remove("hidden");

          // Fade in the backdrop
          setTimeout(() => {
            modal.classList.remove("opacity-0");
            modal.classList.add("opacity-100");
          }, 10);

          // Scale and fade in the modal
          setTimeout(() => {
            modalContent.classList.remove("scale-95", "opacity-0");
            modalContent.classList.add("scale-100", "opacity-100");
          }, 100);
        }
      }

      function closeExitModal() {
        const modal = document.getElementById("exit-modal");
        const modalContent = document.getElementById("exit-modal-content");

        if (modal && modalContent) {
          // Scale and fade out the modal
          modalContent.classList.add("scale-95", "opacity-0");
          modalContent.classList.remove("scale-100", "opacity-100");

          // Fade out the backdrop
          modal.classList.add("opacity-0");
          modal.classList.remove("opacity-100");

          // Hide completely after animation
          setTimeout(() => {
            modal.classList.add("hidden");
          }, 300);

          // Clear any pending timeout
          if (modalTimeout) {
            clearTimeout(modalTimeout);
            modalTimeout = null;
          }
        }
      }

      // Make functions globally available
      window.showExitModal = showExitModal;
      window.closeExitModal = closeExitModal;

      // Track mouse leave
      document.addEventListener("mouseleave", (e) => {
        console.log("Mouse left window at Y:", e.clientY);
        if (e.clientY <= 50 && !exitIntentShown) {
          console.log("Exit intent triggered!");
          exitIntentShown = true;
          showExitModal();

          // Auto-dismiss after 30 seconds
          modalTimeout = setTimeout(() => {
            closeExitModal();
          }, 30000);
        }
      });

      // Add event listeners for close buttons using IDs
      document.addEventListener("DOMContentLoaded", () => {
        // Close button (X)
        const closeX = document.getElementById("exit-modal-close-x");
        if (closeX) {
          closeX.addEventListener("click", () => {
            console.log("Close X clicked");
            closeExitModal();
          });
        }

        // "I'll risk waiting" button
        const closeBottom = document.getElementById("exit-modal-close-bottom");
        if (closeBottom) {
          closeBottom.addEventListener("click", () => {
            console.log("Risk waiting clicked");
            closeExitModal();
          });
        }

        // Close modal on backdrop click
        const modal = document.getElementById("exit-modal");
        if (modal) {
          modal.addEventListener("click", (e) => {
            if (e.target === e.currentTarget) {
              console.log("Backdrop clicked");
              closeExitModal();
            }
          });
        }

        // Close modal on Escape key
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            console.log("Escape key pressed");
            closeExitModal();
          }
        });

        // Add test button
        setTimeout(() => {
          console.log("Adding test button");
          const testButton = document.createElement("button");
          testButton.textContent = "Test Exit Modal";
          testButton.style.cssText =
            "position: fixed; bottom: 20px; right: 20px; z-index: 9999; padding: 10px 20px; background: #cc9933; color: white; border-radius: 8px; font-weight: bold; box-shadow: 0 4px 6px rgba(0,0,0,0.1); cursor: pointer;";
          testButton.onmouseover = () => {
            testButton.style.background = "#FFA500";
          };
          testButton.onmouseout = () => {
            testButton.style.background = "#cc9933";
          };
          testButton.onclick = () => {
            console.log("Test button clicked");
            exitIntentShown = false; // Reset the flag
            showExitModal();
          };
          document.body.appendChild(testButton);
        }, 1000);
      });

      // Reset exitIntentShown when user navigates back
      window.addEventListener("pageshow", (e) => {
        if (e.persisted) {
          exitIntentShown = false;
        }
      });

      // Reset after 5 minutes
      setTimeout(() => {
        exitIntentShown = false;
      }, 300000);
    })();
  }
</script>

