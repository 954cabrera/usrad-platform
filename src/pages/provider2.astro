---
// imaging-center-carbon.astro
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="Join USRad Network - 10 Day Payment Guarantee"
  isHeroPage={true}
>
  <AOSInit />

  <!-- Hero Section - Gold Theme for B2B -->
  <section
    class="relative pt-32 pb-20 px-4 sm:px-6 overflow-hidden bg-gradient-to-br from-slate-900 via-[#003087] to-black"
  >
    <!-- Subtle animated background -->
    <div class="absolute inset-0 opacity-10">
      <div
        class="absolute inset-0 bg-gradient-to-r from-[#cc9933]/20 to-[#FFA500]/20"
      >
      </div>
    </div>

    <!-- Floating orbs - gold theme -->
    <div
      class="absolute top-40 -left-20 w-72 h-72 bg-[#cc9933]/20 rounded-full blur-3xl animate-float"
    >
    </div>
    <div
      class="absolute bottom-20 -right-20 w-96 h-96 bg-[#FFA500]/20 rounded-full blur-3xl animate-float-delayed"
    >
    </div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Trust Badge -->
        <div
          class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-6 py-3 mb-8"
          data-aos="fade-down"
        >
          <div class="w-2 h-2 bg-[#cc9933] rounded-full animate-pulse"></div>
          <span class="text-white/90 text-sm font-medium"
            >Now accepting select imaging centers nationwide</span
          >
        </div>

        <!-- Main Value Prop -->
        <h1
          class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold mb-8 text-white leading-tight"
          data-aos="fade-up"
        >
          Fill Empty Slots.<br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-[#FFA500]"
          >
            Get Paid in 10 Days.
          </span>
        </h1>

        <p
          class="text-xl md:text-2xl text-gray-200 mb-12 max-w-3xl mx-auto leading-relaxed"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          We bring pre-paid patients. You provide the scan. No insurance
          hassles, no billing complexity, no waiting for payment.
        </p>

        <!-- CTA with gold gradient -->
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <a
            href="/dashboard/onboarding"
            class="group bg-gradient-to-r from-[#cc9933] to-[#FFA500] text-[#003087] px-12 py-5 rounded-xl font-bold text-lg hover:shadow-2xl transition-all transform hover:scale-105 inline-flex items-center gap-3 shadow-lg"
          >
            <span>Join the Network</span>
            <svg
              class="w-5 h-5 group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href="#how-it-works"
            class="border-2 border-white/30 text-white hover:bg-white/10 px-12 py-5 rounded-xl font-bold text-lg transition-all backdrop-blur-sm"
          >
            See How It Works
          </a>
        </div>

        <!-- Credibility one-liner -->
        <p
          class="text-sm text-white/60 mt-6"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          From the team that built a 1,200+ center network and delivered $246M
          in value
        </p>
      </div>
    </div>
  </section>

  <!-- 1. Trust Bar - Insert AFTER Hero Section (after the closing </section> of hero) -->
  <section
    class="py-3 bg-gradient-to-r from-gray-50 to-white border-y border-gray-200 relative overflow-hidden"
  >
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-5">
      <div
        class="absolute inset-0"
        style="background-image: url('data:image/svg+xml,%3Csvg width="
        60"
        height="60"
        viewBox="0 0 60 60"
        xmlns="http://www.w3.org/2000/svg"
        %3E%3Cg
        fill="none"
        fill-rule="evenodd"
        %3E%3Cg
        fill="%23003087"
        fill-opacity="0.1"
        %3E%3Cpath
        d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"
        %3E%3C
        g%3E%3C
        g%3E%3C
        svg%3E')"
      >
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 relative z-10">
      <div
        class="flex flex-wrap justify-center items-center gap-6 md:gap-12 text-center"
      >
        <div
          class="flex items-center gap-3 group"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div class="relative">
            <div
              class="absolute inset-0 bg-green-500 rounded-full blur-md opacity-30 group-hover:opacity-50 transition-opacity"
            >
            </div>
            <svg
              class="w-6 h-6 text-green-600 relative z-10"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <div class="text-left">
            <span class="text-gray-800 font-bold text-sm"
              >From the AnciCare Founders</span
            >
            <div class="text-xs text-gray-500">Proven Industry Leaders</div>
          </div>
        </div>

        <div class="hidden md:block w-px h-8 bg-gray-300"></div>

        <div
          class="flex items-center gap-3 group"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div class="relative">
            <div
              class="absolute inset-0 bg-blue-500 rounded-full blur-md opacity-30 group-hover:opacity-50 transition-opacity"
            >
            </div>
            <svg
              class="w-6 h-6 text-blue-600 relative z-10"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"
              ></path>
            </svg>
          </div>
          <div class="text-left">
            <span class="text-gray-800 font-bold text-sm"
              >1,200+ Centers Successfully Recruited</span
            >
            <div class="text-xs text-gray-500">Delivered $246M+ in Volume</div>
          </div>
        </div>

        <div class="hidden md:block w-px h-8 bg-gray-300"></div>

        <div
          class="flex items-center gap-3 group"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div class="relative">
            <div
              class="absolute inset-0 bg-[#cc9933] rounded-full blur-md opacity-30 group-hover:opacity-50 transition-opacity"
            >
            </div>
            <svg
              class="w-6 h-6 text-[#cc9933] relative z-10"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
          </div>
          <div class="text-left">
            <span class="text-gray-800 font-bold text-sm"
              >NYSE-Listed Acquisition</span
            >
            <div class="text-xs text-gray-500">
              CorVel Corporation (NYSE: CVL)
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Enhanced USRad Guarantee Section - REPLACE the existing guarantee section -->
  <section class="py-24 px-4 sm:px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          The USRad Guarantee
        </h2>
        <p class="text-xl text-gray-600">Simple promises. No fine print.</p>
        <div
          class="mt-4 inline-flex items-center gap-2 bg-blue-50 rounded-full px-6 py-3"
        >
          <svg
            class="w-5 h-5 text-blue-600"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="text-blue-700 font-semibold text-sm"
            >Backed by our AnciCare track record</span
          >
        </div>
      </div>

      <div class="grid md:grid-cols-4 gap-8 max-w-5xl mx-auto">
        <!-- 10 Day Payment -->
        <div class="text-center group" data-aos="zoom-in">
          <div
            class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-[#FFF8DC] to-[#FFE4B5] rounded-2xl flex items-center justify-center group-hover:scale-110 transition-all duration-300 shadow-md relative"
          >
            <span class="text-4xl font-bold text-[#cc9933]">10</span>
            <div
              class="absolute -bottom-2 -right-2 bg-green-500 text-white text-xs px-2 py-1 rounded-full font-bold"
            >
              ✓
            </div>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Day Payment</h3>
          <p class="text-gray-600">Direct deposit. Every time. Guaranteed.</p>
        </div>

        <!-- 96% Show Rate -->
        <div class="text-center group" data-aos="zoom-in" data-aos-delay="100">
          <div
            class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-all duration-300 shadow-md relative"
          >
            <span class="text-4xl font-bold text-[#003087]">96%</span>
            <div
              class="absolute -bottom-2 -right-2 bg-green-500 text-white text-xs px-2 py-1 rounded-full font-bold"
            >
              ✓
            </div>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Show Rate</h3>
          <p class="text-gray-600">
            Pre-qualified patients who actually arrive.
          </p>
        </div>

        <!-- Zero Billing -->
        <div class="text-center group" data-aos="zoom-in" data-aos-delay="200">
          <div
            class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-all duration-300 shadow-md relative"
          >
            <span class="text-4xl font-bold text-green-600">$0</span>
            <div
              class="absolute -bottom-2 -right-2 bg-green-500 text-white text-xs px-2 py-1 rounded-full font-bold"
            >
              ✓
            </div>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Billing Hassles</h3>
          <p class="text-gray-600">We handle everything. You just scan.</p>
        </div>

        <!-- No Setup Cost -->
        <div class="text-center group" data-aos="zoom-in" data-aos-delay="300">
          <div
            class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-[#FFF8DC] to-[#FFE4B5] rounded-2xl flex items-center justify-center group-hover:scale-110 transition-all duration-300 shadow-md relative"
          >
            <span class="text-4xl font-bold text-[#cc9933]">$0</span>
            <div
              class="absolute -bottom-2 -right-2 bg-green-500 text-white text-xs px-2 py-1 rounded-full font-bold"
            >
              ✓
            </div>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Setup Costs</h3>
          <p class="text-gray-600">Join free. No hidden fees. Ever.</p>
        </div>
      </div>

      <!-- Why These Guarantees Matter -->
      <div
        class="text-center mt-16 max-w-3xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="400"
      >
        <div
          class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-8 border border-blue-200 relative overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-blue-100 rounded-full -mr-16 -mt-16 opacity-50"
          >
          </div>
          <div class="relative z-10">
            <p class="text-xl font-bold text-[#003087] mb-3">
              Why These Guarantees Matter
            </p>
            <p class="text-gray-700 leading-relaxed">
              These aren't just promises—they're the same commitments we
              delivered on for 8 years with AnciCare. 1,200+ imaging centers
              trusted us then, and we delivered every time. Now we're bringing
              that same reliability to USRad.
            </p>
            <div class="mt-4 flex justify-center gap-4 text-sm">
              <span class="inline-flex items-center gap-1 text-blue-700">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                Proven track record
              </span>
              <span class="inline-flex items-center gap-1 text-blue-700">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                Same founding team
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- National Scale Section - Fort Lauderdale Hub -->
  <section
    class="relative py-32 px-4 sm:px-6 overflow-hidden bg-gradient-to-br from-[#0a0e27] via-[#0f1629] to-[#003087]"
  >
    <!-- Particle System Background -->
    <canvas id="particle-network" class="absolute inset-0 opacity-40"></canvas>

    <div class="relative z-10 max-w-7xl mx-auto">
      <!-- Header and Title -->
      <div class="text-center mb-12">
        <div
          class="inline-flex items-center gap-3 backdrop-blur-sm bg-white/5 rounded-full px-4 py-2 mb-8 border border-white/10"
          data-aos="fade-up"
        >
          <div class="relative">
            <span
              class="absolute inline-flex h-3 w-3 rounded-full bg-[#cc9933] opacity-75 animate-ping"
            ></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-[#cc9933]"
            ></span>
          </div>
          <span
            class="text-[#cc9933] text-sm font-medium uppercase tracking-wider"
            >Priority Markets Active Recruitment</span
          >
        </div>
        <!-- 3. Priority Markets Scarcity Message - ADD to the beginning of National Scale Section -->
        <!-- Insert this right after the "Priority Markets Active Recruitment" badge -->
        <div
          class="bg-[#cc9933]/10 backdrop-blur-sm border border-[#cc9933]/30 rounded-2xl p-6 mb-12 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="250"
        >
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
              <div
                class="w-12 h-12 bg-[#cc9933]/20 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-[#cc9933]"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
            </div>
            <div>
              <p class="text-[#cc9933] font-bold mb-1">
                Limited Network Slots Available
              </p>
              <p class="text-sm text-gray-300 leading-relaxed">
                Just as we carefully selected centers for AnciCare to ensure
                quality and maintain volume commitments, we're accepting only <strong
                  class="text-[#cc9933]">3-5 centers per market</strong
                > for USRad. Early partners will capture the most market share.
              </p>
            </div>
          </div>
        </div>

        <h2
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-8 leading-tight"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          High-volume<br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] via-[#FFA500] to-[#cc9933] animate-gradient"
          >
            opportunity markets
          </span>
        </h2>

        <p
          class="text-lg md:text-xl text-gray-300 mb-12 leading-relaxed max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          From our Fort Lauderdale headquarters, we're actively recruiting
          imaging centers in 10 high-demand markets where our patient
          acquisition programs show the strongest results.
        </p>
      </div>

      <!-- Full Width Map Visualization - NOW AT TOP -->
      <div
        class="relative h-[700px] bg-black/20 rounded-2xl overflow-hidden mb-20"
        data-aos="fade-up"
      >
        <!-- Legend - NOW CENTERED -->
        <div
          class="absolute top-4 left-1/2 transform -translate-x-1/2 z-20 bg-black/60 backdrop-blur-sm rounded-lg px-6 py-3 border border-white/10"
        >
          <h4 class="text-sm font-bold text-white mb-2 text-center">
            Network Sync Activity
          </h4>
          <div class="flex gap-6">
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 bg-[#00ff88] rounded-sm"></div>
              <span class="text-xs text-gray-300">Patient Referrals →</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 bg-[#4A90E2] rounded-sm"></div>
              <span class="text-xs text-gray-300">Reimbursements →</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 bg-[#FFA500] rounded-sm"></div>
              <span class="text-xs text-gray-300">← Medical Reports</span>
            </div>
          </div>
        </div>

        <svg
          class="absolute inset-0 w-full h-full"
          viewBox="0 0 1200 600"
          preserveAspectRatio="xMidYMid meet"
        >
          <!-- Definitions -->
          <defs>
            <!-- Grid Pattern -->
            <pattern
              id="grid"
              x="0"
              y="0"
              width="40"
              height="40"
              patternUnits="userSpaceOnUse"
            >
              <line
                x1="0"
                y1="0"
                x2="0"
                y2="40"
                stroke="#1a2744"
                stroke-width="0.5"
                opacity="0.3"></line>
              <line
                x1="0"
                y1="0"
                x2="40"
                y2="0"
                stroke="#1a2744"
                stroke-width="0.5"
                opacity="0.3"></line>
            </pattern>

            <!-- Hub Gradient -->
            <radialGradient id="hub-gradient" cx="50%" cy="50%" r="50%">
              <stop offset="0%" style="stop-color:#cc9933;stop-opacity:1">
                <animate
                  attributeName="stop-opacity"
                  values="1;0.4;1"
                  dur="2s"
                  repeatCount="indefinite"></animate>
              </stop>
              <stop offset="50%" style="stop-color:#FFA500;stop-opacity:0.5"
              ></stop>
              <stop offset="100%" style="stop-color:#cc9933;stop-opacity:0"
              ></stop>
            </radialGradient>

            <!-- State Gradient -->
            <radialGradient id="state-gradient" cx="50%" cy="50%" r="50%">
              <stop offset="0%" style="stop-color:#cc9933;stop-opacity:0.8"
              ></stop>
              <stop offset="100%" style="stop-color:#cc9933;stop-opacity:0"
              ></stop>
            </radialGradient>

            <!-- Glow Filter -->
            <filter id="glow">
              <feGaussianBlur stdDeviation="3" result="coloredBlur"
              ></feGaussianBlur>
              <feMerge>
                <feMergeNode in="coloredBlur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>

            <!-- Patient Referral Packet (Green - From Hub) -->
            <g id="referral-packet">
              <rect
                x="-3"
                y="-1.5"
                width="6"
                height="3"
                fill="#00ff88"
                opacity="0.8"></rect>
              <circle cx="0" cy="0" r="4" fill="#00ff88" opacity="0.3"></circle>
            </g>

            <!-- Reimbursement Packet (Blue - From Hub) -->
            <g id="reimbursement-packet">
              <rect
                x="-3"
                y="-1.5"
                width="6"
                height="3"
                fill="#4A90E2"
                opacity="0.8"></rect>
              <circle cx="0" cy="0" r="4" fill="#4A90E2" opacity="0.3"></circle>
            </g>

            <!-- Medical Report Packet (Orange - From Centers) -->
            <g id="report-packet">
              <rect
                x="-3"
                y="-1.5"
                width="6"
                height="3"
                fill="#FFA500"
                opacity="0.8"></rect>
              <circle cx="0" cy="0" r="4" fill="#FFA500" opacity="0.3"></circle>
            </g>
          </defs>

          <!-- Background -->
          <rect width="100%" height="100%" fill="url(#grid)"></rect>

          <!-- Connection Lines -->
          <g
            id="connections"
