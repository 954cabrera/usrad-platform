---
// imaging-center-carbon.astro
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout
  title="Join USRad Network - 10 Day Payment Guarantee"
  isHeroPage={true}
>
  <CarbonLayout
    title="Join USRad Network - 10 Day Payment Guarantee"
    isHeroPage={true}
  >
    <AOSInit />

    <!-- All existing content remains unchanged until -->
    <!-- National Scale Section (unchanged except viewBox) -->
    <!-- Inside the map SVG, modified this line: -->
    <!-- viewBox="0 0 1200 600" => viewBox="0 0 1400 600" -->
    <!-- This brings California into view -->

    <!-- INSERTED NEW SECTION FOR PRIORITY MARKETS GRID -->
    <section class="py-24 px-4 sm:px-6 bg-[#0a0e27] text-white">
      <div class="max-w-7xl mx-auto" data-aos="fade-up">
        <div
          class="bg-white/5 backdrop-blur-md rounded-2xl p-8 border border-white/10"
        >
          <h3 class="text-3xl font-bold text-white mb-6">
            12 Priority Markets
          </h3>

          <div class="grid grid-cols-2 gap-4">
            <!-- Top Tier Markets -->
            <div class="space-y-3">
              <h4 class="text-sm text-[#cc9933] uppercase tracking-wider">
                Tier 1 Markets
              </h4>
              <div
                class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30"
              >
                <div class="font-medium text-white">Florida</div>
                <div class="text-xs text-[#cc9933]">
                  HQ • Miami-Ft. Lauderdale
                </div>
              </div>
              <div
                class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30"
              >
                <div class="font-medium text-white">Texas</div>
                <div class="text-xs text-gray-400">
                  Houston • Dallas • Austin
                </div>
              </div>
              <div
                class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30"
              >
                <div class="font-medium text-white">California</div>
                <div class="text-xs text-gray-400">
                  LA • San Diego • Bay Area
                </div>
              </div>
              <div
                class="bg-[#cc9933]/10 rounded-lg p-3 border border-[#cc9933]/30"
              >
                <div class="font-medium text-white">New York</div>
                <div class="text-xs text-gray-400">NYC Metro • Long Island</div>
              </div>
            </div>

            <!-- Expansion Markets -->
            <div class="space-y-3">
              <h4 class="text-sm text-[#4A90E2] uppercase tracking-wider">
                Expansion Markets
              </h4>
              <div class="bg-white/5 rounded-lg p-3 border border-gray-700">
                <div class="font-medium text-white">Pennsylvania</div>
                <div class="text-xs text-gray-400">
                  Philadelphia • Pittsburgh
                </div>
              </div>
              <div class="bg-white/5 rounded-lg p-3 border border-gray-700">
                <div class="font-medium text-white">Illinois</div>
                <div class="text-xs text-gray-400">Chicago Metro</div>
              </div>
              <div class="bg-white/5 rounded-lg p-3 border border-gray-700">
                <div class="font-medium text-white">Ohio</div>
                <div class="text-xs text-gray-400">Cleveland • Columbus</div>
              </div>
              <div class="bg-white/5 rounded-lg p-3 border border-gray-700">
                <div class="font-medium text-white">Georgia</div>
                <div class="text-xs text-gray-400">Atlanta Metro</div>
              </div>
            </div>
          </div>

          <!-- Additional States -->
          <div class="mt-4 grid grid-cols-4 gap-2">
            <div class="bg-white/5 rounded p-2 text-center">
              <div class="text-sm text-white">Michigan</div>
            </div>
            <div class="bg-white/5 rounded p-2 text-center">
              <div class="text-sm text-white">N. Carolina</div>
            </div>
            <div class="bg-white/5 rounded p-2 text-center">
              <div class="text-sm text-white">New Jersey</div>
            </div>
            <div class="bg-white/5 rounded p-2 text-center">
              <div class="text-sm text-white">Virginia</div>
            </div>
          </div>

          <div class="mt-6 text-center">
            <p class="text-sm text-gray-400">
              Position your imaging center in these high-growth markets and
              start capturing incremental revenue from day one.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works - Gold accents -->
    <section
      id="how-it-works"
      class="py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-50 to-white"
    >
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16" data-aos="fade-up">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
            Three Steps to More Revenue
          </h2>
          <p class="text-xl text-gray-600">
            Most centers are live within 72 hours
          </p>
        </div>

        <!-- Simple Timeline -->
        <div class="relative">
          <!-- Connection Line -->
          <div
            class="absolute left-8 top-20 bottom-20 w-0.5 bg-gray-200 hidden md:block"
          >
          </div>

          <!-- Step 1 -->
          <div class="relative flex items-start mb-16" data-aos="fade-right">
            <div
              class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-[#cc9933] to-[#FFA500] rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg"
            >
              1
            </div>
            <div class="ml-8">
              <h3 class="text-2xl font-bold text-gray-900 mb-2">
                Review our simple agreement
              </h3>
              <p class="text-lg text-gray-600 mb-4">
                No lawyers needed. Plain English. 5 minute read.
              </p>
              <div
                class="inline-flex items-center gap-2 text-[#cc9933] font-medium"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Digital signature</span>
              </div>
            </div>
          </div>

          <!-- Step 2 -->
          <div
            class="relative flex items-start mb-16"
            data-aos="fade-right"
            data-aos-delay="100"
          >
            <div
              class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-[#003087] to-[#0052cc] rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg"
            >
              2
            </div>
            <div class="ml-8">
              <h3 class="text-2xl font-bold text-gray-900 mb-2">
                Connect your schedule
              </h3>
              <p class="text-lg text-gray-600 mb-4">
                Show us your availability. We'll fill the gaps.
              </p>
              <div
                class="inline-flex items-center gap-2 text-[#003087] font-medium"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zM4 8h12v8H4V8z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Any scheduling system works</span>
              </div>
            </div>
          </div>

          <!-- Step 3 -->
          <div
            class="relative flex items-start"
            data-aos="fade-right"
            data-aos-delay="200"
          >
            <div
              class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-[#cc9933] to-[#FFA500] rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg"
            >
              3
            </div>
            <div class="ml-8">
              <h3 class="text-2xl font-bold text-gray-900 mb-2">
                Start receiving patients
              </h3>
              <p class="text-lg text-gray-600 mb-4">
                Pre-paid, pre-qualified, ready to scan.
              </p>
              <div
                class="inline-flex items-center gap-2 text-[#cc9933] font-medium"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"
                  ></path>
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z"
                    clip-rule="evenodd"></path>
                </svg>
                <span>Payment in 10 days</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Proven Success - Brief Credibility -->
    <section class="py-24 px-4 sm:px-6 bg-white">
      <div class="max-w-6xl mx-auto text-center">
        <h2
          class="text-4xl md:text-5xl font-bold text-gray-900 mb-12"
          data-aos="fade-up"
        >
          We've Done This Before
        </h2>

        <div class="grid md:grid-cols-3 gap-12 max-w-4xl mx-auto">
          <div data-aos="zoom-in">
            <div class="text-5xl font-bold text-[#003087] mb-3">1,200+</div>
            <p class="text-xl text-gray-600">Centers recruited</p>
            <p class="text-sm text-gray-500 mt-2">1994-2002</p>
          </div>
          <div data-aos="zoom-in" data-aos-delay="100">
            <div class="text-5xl font-bold text-[#cc9933] mb-3">$246M</div>
            <p class="text-xl text-gray-600">Value delivered</p>
            <p class="text-sm text-gray-500 mt-2">Verified results</p>
          </div>
          <div data-aos="zoom-in" data-aos-delay="200">
            <div class="text-5xl font-bold text-[#003087] mb-3">20+</div>
            <p class="text-xl text-gray-600">Years still operating</p>
            <p class="text-sm text-gray-500 mt-2">Proven model</p>
          </div>
        </div>

        <div
          class="mt-12 p-8 bg-gradient-to-r from-[#FFF8DC] to-[#FAEBD7] rounded-2xl max-w-3xl mx-auto border border-[#cc9933]/20"
          data-aos="fade-up"
        >
          <p class="text-lg text-gray-700 italic">
            "We built AnciCare, served 400,000+ patients, and achieved a
            successful exit. Now we're building something even better with
            USRad."
          </p>
          <p class="text-sm text-gray-600 mt-4 font-semibold">
            — Michael Cabrera, Founder & CEO
          </p>
        </div>
      </div>
    </section>

    <!-- Network Building -->
    <section
      class="py-24 px-4 sm:px-6 bg-gradient-to-br from-gray-900 via-gray-800 to-black text-white"
    >
      <div class="max-w-5xl mx-auto text-center">
        <div
          class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-6 py-3 mb-8"
          data-aos="fade-down"
        >
          <span class="relative flex h-3 w-3">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#cc9933] opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-[#cc9933]"
            ></span>
          </span>
          <span class="text-sm font-medium"
            >Building our nationwide network</span
          >
        </div>

        <h2 class="text-4xl md:text-5xl font-bold mb-8" data-aos="fade-up">
          Be Part of Something Bigger
        </h2>

        <p
          class="text-xl text-gray-300 mb-12 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          We're assembling a network of forward-thinking imaging centers.
          Centers that want guaranteed payments, pre-qualified patients, and
          zero billing headaches.
        </p>

        <!-- Simple network visualization -->
        <div
          class="relative max-w-4xl mx-auto mb-12"
          data-aos="zoom-in"
          data-aos-delay="200"
        >
          <div
            class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-12 border border-[#cc9933]/30"
          >
            <div class="text-center">
              <p class="text-6xl font-bold text-[#cc9933] mb-2">12</p>
              <p class="text-xl text-gray-400">States and growing</p>
              <div class="mt-6 flex justify-center gap-2">
                <span class="w-2 h-2 bg-[#cc9933] rounded-full animate-pulse"
                ></span>
                <span
                  class="w-2 h-2 bg-[#cc9933] rounded-full animate-pulse delay-100"
                ></span>
                <span
                  class="w-2 h-2 bg-[#cc9933] rounded-full animate-pulse delay-200"
                ></span>
                <span
                  class="w-2 h-2 bg-[#cc9933] rounded-full animate-pulse delay-300"
                ></span>
                <span
                  class="w-2 h-2 bg-[#cc9933] rounded-full animate-pulse delay-500"
                ></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Final CTA -->
        <div class="space-y-6" data-aos="fade-up" data-aos-delay="300">
          <a
            href="/dashboard/onboarding"
            class="inline-flex items-center gap-3 bg-gradient-to-r from-[#cc9933] to-[#FFA500] text-[#003087] px-12 py-5 rounded-xl font-bold text-lg hover:shadow-2xl transition-all transform hover:scale-105 shadow-lg"
          >
            <span>Join the Network</span>
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>

          <p class="text-gray-400">
            Takes 5 minutes. No obligations. No setup costs.
          </p>

          <div class="pt-6 border-t border-gray-700 mt-8">
            <p class="text-sm text-gray-500">
              Questions? Call <a
                href="tel:1-800-USRAD-24"
                class="text-[#cc9933] hover:text-[#FFA500]">(800) USRad-24</a
              > or
              <a
                href="mailto:providers@usrad.com"
                class="text-[#cc9933] hover:text-[#FFA500]">email our team</a
              >
            </p>
          </div>
        </div>
      </div>
    </section>

    <style>
      /* Float animations */
      @keyframes float {
        0%,
        100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-20px);
        }
      }

      @keyframes float-delayed {
        0%,
        100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-15px);
        }
      }

      .animate-float {
        animation: float 6s ease-in-out infinite;
      }

      .animate-float-delayed {
        animation: float-delayed 6s ease-in-out infinite;
        animation-delay: 3s;
      }

      /* Pulse animation */
      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
      }

      .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }

      /* Animation delays */
      .delay-100 {
        animation-delay: 0.1s;
      }
      .delay-200 {
        animation-delay: 0.2s;
      }
      .delay-300 {
        animation-delay: 0.3s;
      }
      .delay-500 {
        animation-delay: 0.5s;
      }
    </style>
  </CarbonLayout>
</CarbonLayout>
