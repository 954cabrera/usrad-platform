---
// Email verification page for providers - Magic Link version
// File: /src/pages/providers/check-email.astro
import BrandLogo from "../../components/brand/BrandLogo.astro";
export const prerender = false;
const REMIX_URL =
  import.meta.env.PUBLIC_REMIX_URL || "https://usrad-portal.vercel.app";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Check Your Email | USRad Provider Network</title>

    <!-- Supabase Configuration -->
    <meta name="supabase-url" content={import.meta.env.PUBLIC_SUPABASE_URL} />
    <meta
      name="supabase-anon-key"
      content={import.meta.env.PUBLIC_SUPABASE_ANON_KEY}
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        margin: 0;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .verification-container {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
        max-width: 520px;
        width: 100%;
        padding: 3rem;
        text-align: center;
      }

      .logo {
        width: 150px;
        margin: 0 auto 2rem;
      }

      .email-icon {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        font-size: 3rem;
        animation: pulse 2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          opacity: 1;
        }
        50% {
          transform: scale(1.05);
          opacity: 0.8;
        }
      }

      h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1rem;
      }

      .subtitle {
        color: #64748b;
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 2rem;
      }

      .email-display {
        background: #f1f5f9;
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 2rem;
        font-weight: 600;
        color: #334155;
        word-break: break-all;
      }

      .instructions-box {
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        text-align: left;
      }

      .instructions-box h3 {
        color: #0369a1;
        font-size: 1rem;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .instructions-box ol {
        margin: 0;
        padding-left: 1.5rem;
        color: #475569;
        line-height: 1.8;
      }

      .instructions-box li {
        margin-bottom: 0.5rem;
      }

      .tips-section {
        background: #fef3c7;
        border: 1px solid #fde68a;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        text-align: left;
      }

      .tips-section h3 {
        color: #92400e;
        font-size: 1rem;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .tips-section ul {
        margin: 0;
        padding-left: 1.5rem;
        color: #78350f;
        line-height: 1.6;
      }

      .tips-section li {
        margin-bottom: 0.25rem;
      }

      .resend-section {
        padding-top: 1.5rem;
        border-top: 1px solid #e2e8f0;
      }

      .resend-text {
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 0.75rem;
      }

      .resend-button {
        background: #003087;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.2s;
      }

      .resend-button:hover:not(:disabled) {
        background: #002266;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(0, 48, 135, 0.3);
      }

      .resend-button:disabled {
        background: #94a3b8;
        cursor: not-allowed;
      }

      .timer {
        color: #64748b;
        font-size: 0.9rem;
        margin-top: 0.5rem;
      }

      .message {
        padding: 0.875rem 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .message.error {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
      }

      .message.success {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
      }

      .message.hidden {
        display: none;
      }

      .loading-spinner {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        border: 2px solid #ffffff;
        border-radius: 50%;
        border-top-color: transparent;
        animation: spin 0.8s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #64748b;
        text-decoration: none;
        font-size: 0.9rem;
        margin-top: 1.5rem;
        transition: color 0.2s;
      }

      .back-link:hover {
        color: #003087;
      }

      .check-email-animation {
        width: 120px;
        height: 120px;
        margin: 0 auto 2rem;
      }

      @media (max-width: 480px) {
        body {
          min-height: 100dvh;
        }

        .verification-container {
          padding: 2rem 1.5rem;
        }

        h1 {
          font-size: 1.5rem;
        }

        .subtitle {
          font-size: 1rem;
        }

        .resend-button {
          width: 100%;
          padding: 1rem;
        }
      }
    </style>
  </head>

  <body>
    <div class="verification-container">
      <BrandLogo branding="md" class="mx-auto mb-8" />

      <div class="email-icon">✉️</div>

      <h1>Check Your Email</h1>

      <p class="subtitle">We've sent a verification link to:</p>

      <div class="email-display" id="user-email">
        <!-- Email will be populated here -->
      </div>

      <!-- Messages -->
      <div id="error-message" class="message error hidden"></div>
      <div id="success-message" class="message success hidden"></div>

      <div class="instructions-box">
        <h3>
          <span>📬</span>
          <span>What to do next:</span>
        </h3>
        <ol>
          <li>Open your email inbox</li>
          <li>Find the email from <strong>USRad Provider Network</strong></li>
          <li>Click the <strong>Verify Email</strong> button in the email</li>
          <li>You'll be redirected to your provider portal</li>
        </ol>
      </div>

      <div class="tips-section">
        <h3>
          <span>💡</span>
          <span>Can't find the email?</span>
        </h3>
        <ul>
          <li>Check your spam or junk folder</li>
          <li>Make sure you entered the correct email address</li>
          <li>Wait a few minutes - emails can sometimes be delayed</li>
          <li>Add noreply@supabase.io to your contacts</li>
        </ul>
      </div>

      <div class="resend-section">
        <p class="resend-text">Still haven't received the email?</p>
        <button
          class="resend-button"
          id="resend-button"
          onclick="resendEmail()"
        >
          <span id="resend-text">Resend verification email</span>
          <span id="resend-loading" style="display: none;">
            <span class="loading-spinner"></span> Sending...
          </span>
        </button>
        <div class="timer hidden" id="resend-timer">
          Wait <span id="timer-seconds">60</span> seconds before resending
        </div>
      </div>

      <a href={`${REMIX_URL}/signup`} class="back-link">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Back to signup
      </a>
    </div>

    <script>
      // Get Supabase configuration
      const supabaseUrl = document.querySelector(
        'meta[name="supabase-url"]'
      )?.content;
      const supabaseAnonKey = document.querySelector(
        'meta[name="supabase-anon-key"]'
      )?.content;

      // Get email from URL params or session storage
      const urlParams = new URLSearchParams(window.location.search);
      const userEmail =
        urlParams.get("email") || sessionStorage.getItem("signup_email") || "";

      // Display the email
      document.getElementById("user-email").textContent =
        userEmail || "your email address";

      // Show/hide messages
      function showError(message) {
        const errorDiv = document.getElementById("error-message");
        const successDiv = document.getElementById("success-message");
        errorDiv.innerHTML = `<span>❌</span> ${message}`;
        errorDiv.classList.remove("hidden");
        successDiv.classList.add("hidden");
      }

      function showSuccess(message) {
        const errorDiv = document.getElementById("error-message");
        const successDiv = document.getElementById("success-message");
        successDiv.innerHTML = `<span>✅</span> ${message}`;
        successDiv.classList.remove("hidden");
        errorDiv.classList.add("hidden");
      }

      function hideMessages() {
        document.getElementById("error-message").classList.add("hidden");
        document.getElementById("success-message").classList.add("hidden");
      }

      // Resend email with timer
      let resendTimer = null;
      let resendSeconds = 0;

      function startResendTimer() {
        resendSeconds = 60;
        const button = document.getElementById("resend-button");
        const timer = document.getElementById("resend-timer");
        const seconds = document.getElementById("timer-seconds");

        button.disabled = true;
        timer.classList.remove("hidden");

        resendTimer = setInterval(() => {
          resendSeconds--;
          seconds.textContent = resendSeconds;

          if (resendSeconds <= 0) {
            clearInterval(resendTimer);
            button.disabled = false;
            timer.classList.add("hidden");
          }
        }, 1000);
      }

      // Resend verification email
      window.resendEmail = async function () {
        hideMessages();

        const button = document.getElementById("resend-button");
        const buttonText = document.getElementById("resend-text");
        const buttonLoading = document.getElementById("resend-loading");

        // Show loading state
        button.disabled = true;
        buttonText.style.display = "none";
        buttonLoading.style.display = "inline-flex";

        try {
          // Import Supabase
          const { createClient } = await import(
            "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm"
          );
          const supabase = createClient(supabaseUrl, supabaseAnonKey);

          // Resend verification email
          const { error } = await supabase.auth.resend({
            type: "signup",
            email: userEmail,
          });

          if (error) throw error;

          showSuccess("Verification email sent! Please check your inbox.");

          // Start timer
          startResendTimer();
        } catch (error) {
          console.error("Resend error:", error);

          if (error.message.includes("rate limit")) {
            showError("Too many requests. Please wait a moment and try again.");
          } else if (error.message.includes("already confirmed")) {
            showError(
              "This email is already verified. Try logging in instead."
            );
          } else {
            showError("Failed to resend email. Please try again later.");
          }
        } finally {
          button.disabled = false;
          buttonText.style.display = "inline";
          buttonLoading.style.display = "none";
        }
      };

      // Check if user is already verified (came back to this page)
      async function checkVerificationStatus() {
        try {
          const { createClient } = await import(
            "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm"
          );
          const supabase = createClient(supabaseUrl, supabaseAnonKey);

          const {
            data: { session },
          } = await supabase.auth.getSession();

          if (session) {
            // User is already verified and logged in
            showSuccess(
              "Your email is already verified! Redirecting to your portal..."
            );
            setTimeout(() => {
              window.location.href = "/providers/portal";
            }, 2000);
          }
        } catch (error) {
          console.error("Error checking verification status:", error);
        }
      }

      // Check verification status on page load
      checkVerificationStatus();
    </script>
  </body>
</html>
