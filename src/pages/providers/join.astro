---
// Enhanced provider signup with premium light theme
// File: /src/pages/providers/join.astro
export const prerender = false;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Join USRad Network | Premium Imaging Partnership</title>

    <!-- Supabase Configuration -->
    <meta name="supabase-url" content={import.meta.env.PUBLIC_SUPABASE_URL} />
    <meta
      name="supabase-anon-key"
      content={import.meta.env.PUBLIC_SUPABASE_ANON_KEY}
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Import styles -->
    <link rel="stylesheet" href="/src/styles/providers/signup.css" />
  </head>

  <body>
    <div class="signup-layout">
      <!-- Background decoration -->
      <div class="bg-decoration">
        <div class="gradient-sphere sphere-1"></div>
        <div class="gradient-sphere sphere-2"></div>
        <div class="gradient-sphere sphere-3"></div>
      </div>

      <!-- Import components -->
      <signup-branding></signup-branding>
      <signup-form></signup-form>
    </div>

    <!-- Exit Intent Modal -->
    <exit-intent-modal></exit-intent-modal>

    <!-- Import Web Components FIRST -->
    <script type="module">
      import "/src/components/Providers/Signup/SignupBranding.js";
      import "/src/components/Providers/Signup/SignupForm.js";
      import "/src/components/Providers/Signup/ExitIntentModal.js";
    </script>

    <!-- Then import the main script as a module -->
    <script type="module" src="/src/scripts/providers/signup.js"></script>
  </body>
</html>
