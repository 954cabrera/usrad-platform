---
// src/pages/providers/onboard.astro
import ProviderOnboardingLayout from "../../layouts/ProviderOnboardingLayout.astro";
import EnterpriseOnboarding from "../../components/providers/EnterpriseOnboarding.jsx";
import AOSInit from "../../components/AOSInit.astro";

export const prerender = true;
---

<ProviderOnboardingLayout
  title="Provider Onboarding | USRad Network"
  currentStep={2}
  totalSteps={3}
>
  <AOSInit />

  <!-- Focused Onboarding Section -->
  <section class="py-8 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Simple Header -->
      <div class="text-center mb-8" data-aos="fade-up">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">
          Register Your Imaging Centers
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Add your company information and all imaging centers. One agreement
          will cover all locations.
        </p>
      </div>

      <!-- Enterprise Onboarding Component -->
      <div data-aos="zoom-in">
        <EnterpriseOnboarding client:load />
      </div>
    </div>
  </section>

  <style>
    /* Remove any extra animations that might distract */
    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    /* Focus trap for modals */
    .modal-open {
      overflow: hidden;
    }
  </style>

  <!-- Auto-save integration script -->
  <script>
    // Listen for save events from the layout
    window.addEventListener("saveProgress", function () {
      console.log("Auto-saving provider onboarding progress...");

      // Trigger save in the React component
      var event = new CustomEvent("triggerSave", {
        detail: { source: "layout" },
      });
      window.dispatchEvent(event);
    });

    // Listen for auto-save events
    window.addEventListener("autoSave", function () {
      console.log("Auto-saving in background...");

      var event = new CustomEvent("triggerAutoSave", {
        detail: { source: "background" },
      });
      window.dispatchEvent(event);
    });
  </script>

  <!-- Schema Markup -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Provider Onboarding - USRad Network",
      "description": "Complete provider registration for USRad imaging network. Register multiple centers under one agreement.",
      "url": "https://usrad.com/providers/onboard",
      "provider": {
        "@type": "MedicalOrganization",
        "@id": "https://usrad.com/#organization"
      }
    }
  </script>
</ProviderOnboardingLayout>
