---
import ProviderLayout from "../../../layouts/ProviderLayout.astro";
import ProgressIndicator from "../../../components/Providers/Onboarding/Facilities/ProgressIndicator.astro";
import HeaderSection from "../../../components/Providers/Onboarding/Confirmation/HeaderSection.astro";
import OrganizationReview from "../../../components/Providers/Onboarding/Confirmation/OrganizationReview.astro";
import CentersReview from "../../../components/Providers/Onboarding/Confirmation/CentersReview.astro";
import PricingReview from "../../../components/Providers/Onboarding/Confirmation/PricingReview.astro";
import AgreementDetails from "../../../components/Providers/Onboarding/Confirmation/AgreementDetails.astro";
import ConfirmationChecklist from "../../../components/Providers/Onboarding/Confirmation/ConfirmationChecklist.astro";
import ActionButtons from "../../../components/Providers/Onboarding/Confirmation/ActionButtons.astro";
import ExhibitBModal from "../../../components/Providers/Onboarding/Confirmation/ExhibitBModal.astro";

// Import the CSS file
import "../../../styles/providers/confirmation.css";
---

<ProviderLayout title="Review & Confirm">
  <ProgressIndicator currentStep={4} />

  <div class="confirmation-container">
    <HeaderSection />
    <OrganizationReview />
    <CentersReview />
    <PricingReview />
    <AgreementDetails />
    <ConfirmationChecklist />
    <ActionButtons />
  </div>

  <ExhibitBModal />

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      console.log("🎯 Simple confirmation script loading...");

      // Fix organization data with multiple attempts
      fixOrganizationData();
      setTimeout(fixOrganizationData, 500);
      setTimeout(fixOrganizationData, 1000);
      setTimeout(fixOrganizationData, 2000);

      // Set up dynamic pricing
      setupDynamicPricing();

      // Set up navigation functions
      setupNavigation();
    });

    function fixOrganizationData() {
      // Exit early if already fixed
      const orgNameEl = document.getElementById("org-name");
      if (
        orgNameEl &&
        orgNameEl.textContent !== "Loading..." &&
        !orgNameEl.textContent.includes("centers to be included")
      ) {
        return; // Already fixed
      }

      try {
        const orgData = JSON.parse(
          localStorage.getItem("provider_organization") || "null"
        );

        if (orgData) {
          // Update all organization fields
          if (orgNameEl) orgNameEl.textContent = orgData.legalName || "N/A";

          const orgContactEl = document.getElementById("org-contact");
          if (orgContactEl)
            orgContactEl.textContent = orgData.signer?.fullName || "N/A";

          const orgEmailEl = document.getElementById("org-email");
          if (orgEmailEl)
            orgEmailEl.textContent = orgData.signer?.email || "N/A";

          const orgPhoneEl = document.getElementById("org-phone");
          if (orgPhoneEl)
            orgPhoneEl.textContent = orgData.signer?.phone || "N/A";

          console.log("✅ Organization data loaded successfully");
        }
      } catch (error) {
        console.warn("Organization data load attempt failed:", error);
      }
    }

    function setupDynamicPricing() {
      console.log("🎯 Loading dynamic pricing strategy...");

      try {
        // Load pricing data from localStorage
        const multiSelection = JSON.parse(
          localStorage.getItem("usrad_multi_selection") || "{}"
        );
        const stateRates = JSON.parse(
          localStorage.getItem("usrad_state_rates") || "{}"
        );
        const role = localStorage.getItem("usrad_role") || "center-admin";
        const marketRate = localStorage.getItem("market_calculator_rate");

        console.log("Pricing data loaded:", {
          multiSelection,
          stateRates,
          role,
          marketRate,
        });

        // Determine pricing strategy
        const pricingStrategy = determinePricingStrategy(
          stateRates,
          multiSelection,
          marketRate
        );

        // Update displays
        updatePricingStrategyDisplay(pricingStrategy);
        updateExpectedVolumeAndRevenue(pricingStrategy);

        // Prepare PSA data
        prepareEnhancedPSAData(pricingStrategy);
      } catch (error) {
        console.error("Error setting up dynamic pricing:", error);
      }
    }

    function determinePricingStrategy(stateRates, multiSelection, marketRate) {
      const hasMultiState = Object.keys(stateRates).length > 1;
      const states = Object.keys(stateRates);

      if (hasMultiState) {
        return {
          type: "multi-state",
          states: states,
          stateRates: stateRates,
          averageRate: calculateAverageRate(stateRates, multiSelection),
          displayType: "state-based",
          facilities: multiSelection.projections?.totalFacilities || 21,
        };
      } else if (states.length === 1) {
        const singleState = states[0];
        const rate = stateRates[singleState];
        return {
          type: "single-state",
          state: singleState,
          rate: rate,
          displayType: rate === 100 ? "uniform" : "custom",
          facilities: multiSelection.projections?.totalFacilities || 1,
        };
      } else {
        const rate = parseInt(marketRate) || 100;
        return {
          type: "uniform",
          rate: rate,
          displayType: "uniform",
          facilities: 1,
        };
      }
    }

    function calculateAverageRate(stateRates, multiSelection) {
      const centerCounts = multiSelection.centerCounts || {};
      let totalWeightedRate = 0;
      let totalFacilities = 0;

      Object.entries(stateRates).forEach(([state, rate]) => {
        const facilityCount = centerCounts[state] || 1;
        totalWeightedRate += rate * facilityCount;
        totalFacilities += facilityCount;
      });

      return totalFacilities > 0
        ? Math.round(totalWeightedRate / totalFacilities)
        : 100;
    }

    function updatePricingStrategyDisplay(strategy) {
      const pricingSection = document.querySelector(
        '.pricing-strategy, [class*="pricing"]'
      );
      if (!pricingSection) {
        console.warn("Pricing strategy section not found");
        return;
      }

      const rateDisplay = pricingSection.querySelector(
        '.rate-percentage, [class*="rate"], h2, .display-rate, .pricing-rate'
      );
      const descriptionElement = pricingSection.querySelector(
        ".rate-description, p, .description, .pricing-description"
      );

      let displayHTML = "";
      let descriptionHTML = "";

      switch (strategy.type) {
        case "multi-state":
          displayHTML = generateMultiStateDisplay(strategy);
          descriptionHTML = `State-based Medicare rates across ${strategy.states.length} states`;
          break;
        case "single-state":
          displayHTML = `${strategy.rate}%`;
          descriptionHTML = `${strategy.rate}% of Medicare Rates in ${strategy.state}`;
          break;
        case "uniform":
        default:
          displayHTML = `${strategy.rate}%`;
          descriptionHTML = `${strategy.rate}% of Medicare Rates`;
          break;
      }

      if (rateDisplay) {
        if (strategy.type === "multi-state") {
          rateDisplay.innerHTML = displayHTML;
        } else {
          rateDisplay.textContent = displayHTML;
        }
      }

      if (descriptionElement) {
        descriptionElement.textContent = descriptionHTML;
      }

      console.log("✅ Updated pricing strategy display:", strategy.type);
    }

    function generateMultiStateDisplay(strategy) {
      const stateRatesList = Object.entries(strategy.stateRates)
        .map(([state, rate]) => `${state}: ${rate}%`)
        .join(", ");

      if (Object.entries(strategy.stateRates).length <= 3) {
        return `
      <div class="multi-state-rates">
        <div class="average-rate">${strategy.averageRate}% avg</div>
        <div class="state-breakdown">${stateRatesList}</div>
      </div>
    `;
      } else {
        return `
      <div class="multi-state-rates">
        <div class="average-rate">${strategy.averageRate}% avg</div>
        <div class="state-summary">${strategy.states.length} states configured</div>
      </div>
    `;
      }
    }

    function updateExpectedVolumeAndRevenue(strategy) {
      const volumeElement = document.querySelector(
        '.expected-volume, [class*="volume"]'
      );
      const revenueElement = document.querySelector(
        '.projected-revenue, [class*="revenue"]'
      );
      const effectiveRate = strategy.averageRate || strategy.rate || 100;

      let volumeLevel, volumeRange, annualRevenue;

      if (effectiveRate <= 100) {
        volumeLevel = "High";
        volumeRange = "15-20 patients/week";
        annualRevenue = (212000 * (effectiveRate / 100) * 17.5 * 52) / 52;
      } else if (effectiveRate <= 110) {
        volumeLevel = "Good";
        volumeRange = "10-15 patients/week";
        annualRevenue = (212000 * (effectiveRate / 100) * 12.5 * 52) / 52;
      } else if (effectiveRate <= 120) {
        volumeLevel = "Moderate";
        volumeRange = "6-10 patients/week";
        annualRevenue = (212000 * (effectiveRate / 100) * 8 * 52) / 52;
      } else {
        volumeLevel = "Lower";
        volumeRange = "4-8 patients/week";
        annualRevenue = (212000 * (effectiveRate / 100) * 6 * 52) / 52;
      }

      if (volumeElement) {
        const volumeText =
          volumeElement.querySelector(".volume-text") || volumeElement;
        volumeText.textContent = `${volumeLevel} (${volumeRange})`;
      }

      if (revenueElement) {
        const revenueText =
          revenueElement.querySelector(".revenue-amount") || revenueElement;
        const formattedRevenue = new Intl.NumberFormat("en-US", {
          style: "currency",
          currency: "USD",
          maximumFractionDigits: 0,
        }).format(annualRevenue);
        revenueText.textContent = formattedRevenue;
      }

      console.log(
        "✅ Updated volume and revenue projections for",
        effectiveRate + "%"
      );
    }

    function prepareEnhancedPSAData(strategy) {
      const facilities = JSON.parse(localStorage.getItem("facilities") || "[]");
      const orgData = JSON.parse(
        localStorage.getItem("organization_form_data") || "{}"
      );

      const psaPayload = {
        provider_name: orgData.organization_name || orgData.name || "Provider",
        provider_email: orgData.email || "",
        provider_phone: orgData.phone || "",
        tax_id: orgData.tax_id || "",
        primary_contact_name: orgData.primary_contact_name || "",
        primary_contact_email: orgData.primary_contact_email || "",
        primary_contact_phone: orgData.primary_contact_phone || "",
        total_facilities: facilities.length,
        pricing_structure: strategy.type,
        average_reimbursement_rate: strategy.averageRate || strategy.rate,
        agreement_date: new Date().toISOString().split("T")[0],
        role_type: localStorage.getItem("usrad_role") || "center-admin",
      };

      localStorage.setItem("enhanced_psa_data", JSON.stringify(psaPayload));
      console.log("✅ Enhanced PSA data prepared:", psaPayload);
    }

    function setupNavigation() {
      // Set up all navigation functions
      window.editOrganization = () => {
        window.location.href = "/providers/join";
      };

      window.editCenters = () => {
        window.location.href = "/providers/onboarding/facilities";
      };

      window.editPricing = () => {
        window.location.href = "/providers/onboarding/market-calculator";
      };

      window.goBack = () => {
        window.location.href = "/providers/onboarding/market-calculator";
      };

      window.proceedToSign = () => {
        console.log("Proceeding to PSA signing...");
        localStorage.setItem("psa_confirmation_completed", "true");
        window.location.href = "/providers/onboarding/psa-signing";
      };

      // Modal functions
      window.previewExhibitB = () => {
        const modal = document.getElementById("exhibit-modal");
        if (modal) {
          showSimpleExhibitPreview();
          modal.style.display = "block";
        }
      };

      window.closeModal = () => {
        const modal = document.getElementById("exhibit-modal");
        if (modal) {
          modal.style.display = "none";
        }
      };
    }

    function showSimpleExhibitPreview() {
      const centers = JSON.parse(localStorage.getItem("facilities") || "[]");
      const exhibitList = document.getElementById("exhibit-centers-list");

      if (exhibitList && centers.length > 0) {
        const html = `
      <div class="exhibit-preview">
        <h3>Facility List (${centers.length} centers)</h3>
        ${centers
          .slice(0, 10)
          .map(
            (center, index) => `
          <div class="exhibit-center">
            <strong>CENTER ${index + 1}: ${center.name || "Unnamed Center"}</strong><br>
            ${center.address}, ${center.city}, ${center.state} ${center.zipCode || center.zip_code}
          </div>
        `
          )
          .join("")}
        ${centers.length > 10 ? `<p><em>...and ${centers.length - 10} more centers</em></p>` : ""}
      </div>
    `;
        exhibitList.innerHTML = html;
      }
    }
  </script>

  <!-- Enhanced CSS for multi-state display -->
  <style>
    .multi-state-rates {
      text-align: center;
    }

    .average-rate {
      font-size: 2.5rem;
      font-weight: bold;
      color: #1e40af;
      line-height: 1;
    }

    .state-breakdown {
      font-size: 0.875rem;
      color: #64748b;
      margin-top: 0.5rem;
      font-weight: 500;
    }

    .state-summary {
      font-size: 0.875rem;
      color: #64748b;
      margin-top: 0.5rem;
      font-style: italic;
    }

    @media (max-width: 640px) {
      .average-rate {
        font-size: 2rem;
      }

      .state-breakdown {
        font-size: 0.8rem;
      }
    }
  </style>
</ProviderLayout>
