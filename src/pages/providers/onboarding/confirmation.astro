---
import ProviderLayout from "../../../layouts/ProviderLayout.astro";
import ProgressIndicator from "../../../components/Providers/Onboarding/Facilities/ProgressIndicator.astro";
import HeaderSection from "../../../components/Providers/Onboarding/Confirmation/HeaderSection.astro";
import OrganizationReview from "../../../components/Providers/Onboarding/Confirmation/OrganizationReview.astro";
import CentersReview from "../../../components/Providers/Onboarding/Confirmation/CentersReview.astro";
import PricingReview from "../../../components/Providers/Onboarding/Confirmation/PricingReview.astro";
import AgreementDetails from "../../../components/Providers/Onboarding/Confirmation/AgreementDetails.astro";
import ConfirmationChecklist from "../../../components/Providers/Onboarding/Confirmation/ConfirmationChecklist.astro";
import ActionButtons from "../../../components/Providers/Onboarding/Confirmation/ActionButtons.astro";
import ExhibitBModal from "../../../components/Providers/Onboarding/Confirmation/ExhibitBModal.astro";

// Import the CSS file
import "../../../styles/providers/confirmation.css";
---

<ProviderLayout title="Review & Confirm">
  <ProgressIndicator currentStep={4} />

  <div class="confirmation-container">
    <HeaderSection />
    <OrganizationReview />
    <CentersReview />
    <PricingReview />
    <AgreementDetails />
    <ConfirmationChecklist />
    <ActionButtons />
  </div>

  <ExhibitBModal />

  <script>
    /************* PROD-SAFE CONFIRMATION SCRIPT (FINAL) *************/

    // --- Helpers ---
    const getJSON = (key, fallback = null) => {
      try {
        const raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : fallback;
      } catch {
        return fallback;
      }
    };

    // --- Organization Data Resolver ---
    function getOrgData() {
      const a = getJSON("provider_organization", {}) || {};
      const b = getJSON("organization_form_data", {}) || {};
      const c = getJSON("usrad_org", {}) || {};

      const legalName =
        a.legalName || b.organization_name || b.name || c.legalName || "";
      const contactName =
        (a.signer && a.signer.fullName) ||
        b.primary_contact_name ||
        c.primary_contact_name ||
        "";
      const contactEmail =
        (a.signer && a.signer.email) ||
        b.primary_contact_email ||
        b.email ||
        c.primary_contact_email ||
        "";
      const contactPhone =
        (a.signer && a.signer.phone) ||
        b.primary_contact_phone ||
        b.phone ||
        c.primary_contact_phone ||
        "";

      return { legalName, contactName, contactEmail, contactPhone };
    }

    // --- Organization Info Fill (targets exact IDs in OrganizationReview.astro) ---
    function fillOrganizationInfo(data) {
      const container = document.getElementById("organization-info");
      if (!container) {
        console.warn(
          "Organization info container (#organization-info) not found"
        );
        return;
      }

      const map = {
        "org-name": data.legalName,
        "org-contact": data.contactName,
        "org-email": data.contactEmail,
        "org-phone": data.contactPhone,
      };

      let updated = 0;
      for (const [id, value] of Object.entries(map)) {
        const el = document.getElementById(id);
        if (el && value) {
          el.textContent = value;
          updated++;
        }
      }
      console.log(`✅ Organization fields updated: ${updated}`, data);
    }

    // --- Minimal globals to satisfy existing onclick handlers ---
    window.editOrganization =
      window.editOrganization ||
      (() => (location.href = "/providers/onboarding/organization"));
    window.editCenters =
      window.editCenters ||
      (() => (location.href = "/providers/onboarding/facilities"));
    window.editPricing =
      window.editPricing ||
      (() => (location.href = "/providers/onboarding/pricing"));
    window.goBack = window.goBack || (() => history.back());
    window.proceedToSign =
      window.proceedToSign ||
      (() => (location.href = "/providers/onboarding/sign"));
    window.previewExhibitB =
      window.previewExhibitB ||
      (() => {
        const m = document.querySelector("#exhibitBModal");
        if (m) m.style.display = "block";
      });
    window.closeModal =
      window.closeModal ||
      (() => {
        const m = document.querySelector("#exhibitBModal");
        if (m) m.style.display = "none";
      });

    /************* DYNAMIC PRICING (unchanged core, no imports) *************/
    class DynamicPricingManager {
      constructor() {
        this.multiSelection = {};
        this.stateRates = {};
        this.role = "";
        this.marketRate = "";
      }
      init() {
        console.log("🎯 Loading dynamic pricing strategy...");
        this.multiSelection = getJSON("usrad_multi_selection", {}) || {};
        this.stateRates = getJSON("usrad_state_rates", {}) || {};
        this.role = localStorage.getItem("usrad_role") || "center-admin";
        this.marketRate = localStorage.getItem("market_calculator_rate");

        const strategy = this.determinePricingStrategy();
        this.updatePricingStrategyDisplay(strategy);
        this.updateExpectedVolumeAndRevenue(strategy);
        this.prepareEnhancedPSAData(strategy);
      }
      determinePricingStrategy() {
        const states = Object.keys(this.stateRates);
        if (states.length > 1) {
          return {
            type: "multi-state",
            states,
            stateRates: this.stateRates,
            averageRate: this.calculateAverageRate(),
            displayType: "state-based",
            facilities: this.multiSelection.projections?.totalFacilities || 21,
          };
        } else if (states.length === 1) {
          const s = states[0],
            r = this.stateRates[s];
          return {
            type: "single-state",
            state: s,
            rate: r,
            displayType: r === 100 ? "uniform" : "custom",
            facilities: this.multiSelection.projections?.totalFacilities || 1,
          };
        }
        const r = parseInt(this.marketRate) || 100;
        return {
          type: "uniform",
          rate: r,
          displayType: "uniform",
          facilities: 1,
        };
      }
      calculateAverageRate() {
        const counts = this.multiSelection.centerCounts || {};
        let tw = 0,
          tf = 0;
        Object.entries(this.stateRates).forEach(([s, r]) => {
          const n = counts[s] || 1;
          tw += r * n;
          tf += n;
        });
        return tf > 0 ? Math.round(tw / tf) : 100;
      }
      updatePricingStrategyDisplay(strategy) {
        const sec = document.querySelector(
          '.pricing-strategy, [class*="pricing"]'
        );
        if (!sec) return;
        const rateEl = sec.querySelector(
          '.rate-percentage, [class*="rate"], h2, .display-rate, .pricing-rate'
        );
        const descEl = sec.querySelector(
          ".rate-description, p, .description, .pricing-description"
        );

        let rateHTML = "",
          descText = "";
        if (strategy.type === "multi-state") {
          const list = Object.entries(strategy.stateRates)
            .map(([s, r]) => `${s}: ${r}%`)
            .join(", ");
          rateHTML = `
          <div class="multi-state-rates">
            <div class="average-rate">${strategy.averageRate}% avg</div>
            <div class="state-breakdown">${list}</div>
          </div>`;
          descText = `State-based Medicare rates across ${strategy.states.length} states`;
        } else if (strategy.type === "single-state") {
          rateHTML = `${strategy.rate}%`;
          descText = `${strategy.rate}% of Medicare Rates in ${strategy.state}`;
        } else {
          rateHTML = `${strategy.rate}%`;
          descText = `${strategy.rate}% of Medicare Rates`;
        }

        if (rateEl) {
          if (strategy.type === "multi-state") rateEl.innerHTML = rateHTML;
          else rateEl.textContent = rateHTML;
        }
        if (descEl) descText && (descEl.textContent = descText);
        console.log("✅ Pricing display:", strategy.type);
      }
      updateExpectedVolumeAndRevenue(strategy) {
        const volEl = document.querySelector(
          '.expected-volume, [class*="volume"]'
        );
        const revEl = document.querySelector(
          '.projected-revenue, [class*="revenue"]'
        );
        const eff = strategy.averageRate || strategy.rate || 100;

        let level, range, annual;
        if (eff <= 100) {
          level = "High";
          range = "15-20 patients/week";
          annual = 212000 * (eff / 100) * 17.5;
        } else if (eff <= 110) {
          level = "Good";
          range = "10-15 patients/week";
          annual = 212000 * (eff / 100) * 12.5;
        } else if (eff <= 120) {
          level = "Moderate";
          range = "6-10 patients/week";
          annual = 212000 * (eff / 100) * 8;
        } else {
          level = "Lower";
          range = "4-8 patients/week";
          annual = 212000 * (eff / 100) * 6;
        }

        if (volEl)
          (volEl.querySelector(".volume-text") || volEl).textContent =
            `${level} (${range})`;
        if (revEl)
          (revEl.querySelector(".revenue-amount") || revEl).textContent =
            new Intl.NumberFormat("en-US", {
              style: "currency",
              currency: "USD",
              maximumFractionDigits: 0,
            }).format(annual);

        console.log("✅ Volume/Revenue updated:", eff + "%");
      }
      prepareEnhancedPSAData(strategy) {
        const facilities = getJSON("facilities", []) || [];
        const org = getJSON("organization_form_data", {}) || {};
        const payload = {
          provider_name: org.organization_name || org.name || "Provider",
          provider_email: org.email || "",
          provider_phone: org.phone || "",
          tax_id: org.tax_id || "",
          primary_contact_name: org.primary_contact_name || "",
          primary_contact_email: org.primary_contact_email || "",
          primary_contact_phone: org.primary_contact_phone || "",
          total_facilities: facilities.length,
          facility_count_breakdown: this.generateFacilityBreakdown(facilities),
          pricing_structure: strategy.type,
          reimbursement_rates: JSON.stringify(this.stateRates),
          average_reimbursement_rate: strategy.averageRate || strategy.rate,
          exhibit_b_content: this.generateExhibitB(strategy, facilities),
          agreement_date: new Date().toISOString().split("T")[0],
          role_type: this.role,
          ...(strategy.type === "multi-state" && {
            state_breakdown: JSON.stringify(strategy.stateRates),
            multi_state_structure: true,
          }),
        };
        localStorage.setItem("enhanced_psa_data", JSON.stringify(payload));
        console.log("✅ PSA payload ready");
      }
      generateFacilityBreakdown(facilities) {
        const b = {};
        facilities.forEach((f) => {
          const s = f.state || f.address_state || "Unknown";
          b[s] = (b[s] || 0) + 1;
        });
        return b;
      }
      generateExhibitB(strategy, facilities) {
        const b = this.generateFacilityBreakdown(facilities),
          total = facilities.length;
        if (strategy.type === "multi-state") {
          const lines = Object.entries(strategy.stateRates)
            .map(([s, r]) => {
              const n = b[s] || 1,
                p = n === 1 ? "facility" : "facilities";
              return `${s}: ${r}% of Medicare Allowable (${n} ${p})`;
            })
            .join("\n");
          return `EXHIBIT B: REIMBURSEMENT RATES

State-Based Reimbursement Structure:
${lines}

Total Authorized Locations: ${total}
Portfolio Average Rate: ${strategy.averageRate}% of Medicare Allowable`;
        }
        if (strategy.type === "single-state") {
          const n = b[strategy.state] || total,
            p = n === 1 ? "facility" : "facilities";
          return `EXHIBIT B: REIMBURSEMENT RATES

Reimbursement Rate: ${strategy.rate}% of Medicare Allowable
State: ${strategy.state} (${n} ${p})
Total Authorized Locations: ${total}`;
        }
        return `EXHIBIT B: REIMBURSEMENT RATES

Standard reimbursement at ${strategy.rate}% of Medicare Allowable rates.
Total Authorized Locations: ${total}`;
      }
    }

    // --- Bootstrap ---
    document.addEventListener("DOMContentLoaded", () => {
      const data = getOrgData();
      console.log("Org data resolved from localStorage:", data);
      fillOrganizationInfo(data); // <- direct to #organization-info + child IDs
      new DynamicPricingManager().init(); // keep pricing working
    });
  </script>

  <!-- Enhanced CSS for multi-state display -->
  <style>
    .multi-state-rates {
      text-align: center;
    }

    .average-rate {
      font-size: 2.5rem;
      font-weight: bold;
      color: #1e40af;
      line-height: 1;
    }

    .state-breakdown {
      font-size: 0.875rem;
      color: #64748b;
      margin-top: 0.5rem;
      font-weight: 500;
    }

    .state-summary {
      font-size: 0.875rem;
      color: #64748b;
      margin-top: 0.5rem;
      font-style: italic;
    }

    @media (max-width: 640px) {
      .average-rate {
        font-size: 2rem;
      }

      .state-breakdown {
        font-size: 0.8rem;
      }
    }
  </style>
</ProviderLayout>
