---
import ProviderLayout from "../../../layouts/ProviderLayout.astro";
import ProgressIndicator from "../../../components/Providers/Onboarding/Facilities/ProgressIndicator.astro";
import HeaderSection from "../../../components/Providers/Onboarding/Confirmation/HeaderSection.astro";
import OrganizationReview from "../../../components/Providers/Onboarding/Confirmation/OrganizationReview.astro";
import CentersReview from "../../../components/Providers/Onboarding/Confirmation/CentersReview.astro";
import PricingReview from "../../../components/Providers/Onboarding/Confirmation/PricingReview.astro";
import AgreementDetails from "../../../components/Providers/Onboarding/Confirmation/AgreementDetails.astro";
import ConfirmationChecklist from "../../../components/Providers/Onboarding/Confirmation/ConfirmationChecklist.astro";
import ActionButtons from "../../../components/Providers/Onboarding/Confirmation/ActionButtons.astro";
import ExhibitBModal from "../../../components/Providers/Onboarding/Confirmation/ExhibitBModal.astro";

// Import the CSS file
import "../../../styles/providers/confirmation.css";
---

<ProviderLayout title="Review & Confirm">
  <ProgressIndicator currentStep={4} />

  <div class="confirmation-container">
    <HeaderSection />
    <OrganizationReview />
    <CentersReview />
    <PricingReview />
    <AgreementDetails />
    <ConfirmationChecklist />
    <ActionButtons />
  </div>

  <ExhibitBModal />

  <script>
    import { CONFIRMATION_CONFIG } from "../../../scripts/providers/confirmation/confirmation.config.js";
    import {
      OrganizationLoader,
      CentersLoader,
      PricingLoader,
      ChecklistManager,
      NavigationManager,
      ExhibitBManager,
    } from "../../../scripts/providers/confirmation/modules/index.js";

    class ConfirmationPage {
      constructor() {
        this.config = CONFIRMATION_CONFIG;
        this.organizationLoader = new OrganizationLoader();
        this.centersLoader = new CentersLoader();
        this.pricingLoader = new PricingLoader();
        this.checklistManager = new ChecklistManager();
        this.navigationManager = new NavigationManager();
        this.exhibitBManager = new ExhibitBManager();
      }

      init() {
        this.loadAllData();
        this.setupEventListeners();
        this.exposeGlobalFunctions();
      }

      async loadAllData() {
        await this.organizationLoader.load();
        this.centersLoader.load();
        this.pricingLoader.load();
      }

      setupEventListeners() {
        this.checklistManager.init();
      }

      exposeGlobalFunctions() {
        // Expose navigation functions globally
        window.editOrganization = () =>
          this.navigationManager.editOrganization();
        window.editCenters = () => this.navigationManager.editCenters();
        window.editPricing = () => this.navigationManager.editPricing();
        window.goBack = () => this.navigationManager.goBack();
        window.proceedToSign = () => this.navigationManager.proceedToSign();

        // Expose modal functions
        window.previewExhibitB = () => this.exhibitBManager.preview();
        window.closeModal = () => this.exhibitBManager.close();
      }
    }

    // Initialize on DOM load
    document.addEventListener("DOMContentLoaded", () => {
      const confirmationPage = new ConfirmationPage();
      confirmationPage.init();
    });
  </script>
</ProviderLayout>
