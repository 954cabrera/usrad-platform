---
import ProviderLayout from "../../../layouts/ProviderLayout.astro";
import ProgressIndicator from "../../../components/Providers/Onboarding/Facilities/ProgressIndicator.astro";
import HeaderSection from "../../../components/Providers/Onboarding/Confirmation/HeaderSection.astro";
import OrganizationReview from "../../../components/Providers/Onboarding/Confirmation/OrganizationReview.astro";
import CentersReview from "../../../components/Providers/Onboarding/Confirmation/CentersReview.astro";
import PricingReview from "../../../components/Providers/Onboarding/Confirmation/PricingReview.astro";
import AgreementDetails from "../../../components/Providers/Onboarding/Confirmation/AgreementDetails.astro";
import ConfirmationChecklist from "../../../components/Providers/Onboarding/Confirmation/ConfirmationChecklist.astro";
import ActionButtons from "../../../components/Providers/Onboarding/Confirmation/ActionButtons.astro";
import ExhibitBModal from "../../../components/Providers/Onboarding/Confirmation/ExhibitBModal.astro";

// Import the CSS file
import "../../../styles/providers/confirmation.css";
---

<ProviderLayout title="Review & Confirm">
  <ProgressIndicator currentStep={4} />

  <div class="confirmation-container">
    <HeaderSection />
    <OrganizationReview />
    <CentersReview />
    <PricingReview />
    <AgreementDetails />
    <ConfirmationChecklist />
    <ActionButtons />
  </div>

  <ExhibitBModal />

  <script>
    // -------- VANILLA, PROD-SAFE CONFIRMATION SCRIPT --------
    // Purpose: render Organization Info from localStorage, keep dynamic pricing,
    // and avoid any module imports that can break in production.

    // --- Helpers ---
    const getJSON = (key, fallback = null) => {
      try {
        return JSON.parse(
          localStorage.getItem(key) ||
            (fallback === null ? "null" : JSON.stringify(fallback))
        );
      } catch {
        return fallback;
      }
    };
    const setText = (sel, value) => {
      const el = document.querySelector(sel);
      if (el && value) el.textContent = value;
    };

    // --- Organization Info Loader (vanilla) ---
    function loadOrganizationInfo() {
      // Try multiple shapes/keys you’ve used across the app
      const orgA = getJSON("provider_organization", {});
      const orgB = getJSON("organization_form_data", {});
      const orgC = getJSON("usrad_org", {}); // optional fallback if ever used

      const legalName =
        orgA.legalName ||
        orgB.organization_name ||
        orgB.name ||
        orgC.legalName ||
        "Organization";

      const contactName =
        (orgA.signer && orgA.signer.fullName) ||
        orgB.primary_contact_name ||
        orgC.primary_contact_name ||
        "";

      const contactEmail =
        (orgA.signer && orgA.signer.email) ||
        orgB.primary_contact_email ||
        orgB.email ||
        orgC.primary_contact_email ||
        "";

      const contactPhone =
        (orgA.signer && orgA.signer.phone) ||
        orgB.primary_contact_phone ||
        orgB.phone ||
        orgC.primary_contact_phone ||
        "";

      // Target elements used on the Review page
      setText("#org-name", legalName);
      setText("#org-contact", contactName);
      setText("#org-email", contactEmail);
      setText("#org-phone", contactPhone);

      // If you also mirror into any “loading…” spans within the card:
      setText('[data-org="name"]', legalName);
      setText('[data-org="contact"]', contactName);
      setText('[data-org="email"]', contactEmail);
      setText('[data-org="phone"]', contactPhone);

      console.log("✅ Organization info rendered (vanilla).", {
        legalName,
        contactName,
        contactEmail,
        contactPhone,
      });
    }

    // --- Minimal globals so existing buttons/links don’t error ---
    // If your page binds onclick="editOrganization()" etc., these prevent runtime errors.
    window.editOrganization =
      window.editOrganization ||
      (() => (location.href = "/providers/onboarding/organization"));
    window.editCenters =
      window.editCenters ||
      (() => (location.href = "/providers/onboarding/facilities"));
    window.editPricing =
      window.editPricing ||
      (() => (location.href = "/providers/onboarding/pricing"));
    window.goBack = window.goBack || (() => history.back());
    window.proceedToSign =
      window.proceedToSign ||
      (() => (location.href = "/providers/onboarding/sign"));
    window.previewExhibitB =
      window.previewExhibitB ||
      (() => {
        const modal = document.querySelector("#exhibitBModal");
        if (modal) modal.style.display = "block";
      });
    window.closeModal =
      window.closeModal ||
      (() => {
        const modal = document.querySelector("#exhibitBModal");
        if (modal) modal.style.display = "none";
      });

    // --- Dynamic Pricing Manager (kept from your original, no imports needed) ---
    class DynamicPricingManager {
      constructor() {
        this.multiSelection = {};
        this.stateRates = {};
        this.role = "";
        this.marketRate = "";
      }

      init() {
        console.log("🎯 Loading dynamic pricing strategy...");
        this.loadPricingData();
        const pricingStrategy = this.determinePricingStrategy();
        this.updatePricingStrategyDisplay(pricingStrategy);
        this.updateExpectedVolumeAndRevenue(pricingStrategy);
        this.prepareEnhancedPSAData(pricingStrategy);
      }

      loadPricingData() {
        this.multiSelection = getJSON("usrad_multi_selection", {});
        this.stateRates = getJSON("usrad_state_rates", {});
        this.role = localStorage.getItem("usrad_role") || "center-admin";
        this.marketRate = localStorage.getItem("market_calculator_rate");

        console.log("Pricing data loaded:", {
          multiSelection: this.multiSelection,
          stateRates: this.stateRates,
          role: this.role,
          marketRate: this.marketRate,
        });
      }

      determinePricingStrategy() {
        const hasMultiState = Object.keys(this.stateRates).length > 1;
        const states = Object.keys(this.stateRates);

        if (hasMultiState) {
          return {
            type: "multi-state",
            states,
            stateRates: this.stateRates,
            averageRate: this.calculateAverageRate(),
            displayType: "state-based",
            facilities: this.multiSelection.projections?.totalFacilities || 21,
          };
        } else if (states.length === 1) {
          const singleState = states[0];
          const rate = this.stateRates[singleState];
          return {
            type: "single-state",
            state: singleState,
            rate,
            displayType: rate === 100 ? "uniform" : "custom",
            facilities: this.multiSelection.projections?.totalFacilities || 1,
          };
        } else {
          const rate = parseInt(this.marketRate) || 100;
          return {
            type: "uniform",
            rate,
            displayType: "uniform",
            facilities: 1,
          };
        }
      }

      calculateAverageRate() {
        const centerCounts = this.multiSelection.centerCounts || {};
        let totalWeightedRate = 0;
        let totalFacilities = 0;

        Object.entries(this.stateRates).forEach(([state, rate]) => {
          const facilityCount = centerCounts[state] || 1;
          totalWeightedRate += rate * facilityCount;
          totalFacilities += facilityCount;
        });

        return totalFacilities > 0
          ? Math.round(totalWeightedRate / totalFacilities)
          : 100;
      }

      updatePricingStrategyDisplay(strategy) {
        const pricingSection = document.querySelector(
          '.pricing-strategy, [class*="pricing"]'
        );
        if (!pricingSection) return;

        const rateDisplay = pricingSection.querySelector(
          '.rate-percentage, [class*="rate"], h2, .display-rate, .pricing-rate'
        );
        const descriptionElement = pricingSection.querySelector(
          ".rate-description, p, .description, .pricing-description"
        );

        let displayHTML = "";
        let descriptionHTML = "";

        switch (strategy.type) {
          case "multi-state":
            displayHTML = this.generateMultiStateDisplay(strategy);
            descriptionHTML = `State-based Medicare rates across ${strategy.states.length} states`;
            break;
          case "single-state":
            displayHTML = `${strategy.rate}%`;
            descriptionHTML = `${strategy.rate}% of Medicare Rates in ${strategy.state}`;
            break;
          default:
            displayHTML = `${strategy.rate}%`;
            descriptionHTML = `${strategy.rate}% of Medicare Rates`;
        }

        if (rateDisplay) {
          if (strategy.type === "multi-state")
            rateDisplay.innerHTML = displayHTML;
          else rateDisplay.textContent = displayHTML;
        }
        if (descriptionElement)
          descriptionElement.textContent = descriptionHTML;

        console.log("✅ Updated pricing strategy display:", strategy.type);
      }

      generateMultiStateDisplay(strategy) {
        const stateRatesList = Object.entries(strategy.stateRates)
          .map(([state, rate]) => `${state}: ${rate}%`)
          .join(", ");

        if (Object.entries(strategy.stateRates).length <= 3) {
          return `
          <div class="multi-state-rates">
            <div class="average-rate">${strategy.averageRate}% avg</div>
            <div class="state-breakdown">${stateRatesList}</div>
          </div>
        `;
        }
        return `
        <div class="multi-state-rates">
          <div class="average-rate">${strategy.averageRate}% avg</div>
          <div class="state-summary">${strategy.states.length} states configured</div>
        </div>
      `;
      }

      updateExpectedVolumeAndRevenue(strategy) {
        const volumeElement = document.querySelector(
          '.expected-volume, [class*="volume"]'
        );
        const revenueElement = document.querySelector(
          '.projected-revenue, [class*="revenue"]'
        );

        const effectiveRate = strategy.averageRate || strategy.rate || 100;

        let volumeLevel, volumeRange, annualRevenue;
        if (effectiveRate <= 100) {
          volumeLevel = "High";
          volumeRange = "15-20 patients/week";
          annualRevenue = 212000 * (effectiveRate / 100) * 17.5;
        } else if (effectiveRate <= 110) {
          volumeLevel = "Good";
          volumeRange = "10-15 patients/week";
          annualRevenue = 212000 * (effectiveRate / 100) * 12.5;
        } else if (effectiveRate <= 120) {
          volumeLevel = "Moderate";
          volumeRange = "6-10 patients/week";
          annualRevenue = 212000 * (effectiveRate / 100) * 8;
        } else {
          volumeLevel = "Lower";
          volumeRange = "4-8 patients/week";
          annualRevenue = 212000 * (effectiveRate / 100) * 6;
        }

        if (volumeElement)
          (
            volumeElement.querySelector(".volume-text") || volumeElement
          ).textContent = `${volumeLevel} (${volumeRange})`;
        if (revenueElement)
          (
            revenueElement.querySelector(".revenue-amount") || revenueElement
          ).textContent = new Intl.NumberFormat("en-US", {
            style: "currency",
            currency: "USD",
            maximumFractionDigits: 0,
          }).format(annualRevenue);

        console.log("✅ Updated volume & revenue for", effectiveRate + "%");
      }

      prepareEnhancedPSAData(strategy) {
        const facilities = getJSON("facilities", []);
        const orgData = getJSON("organization_form_data", {});

        const psaPayload = {
          provider_name:
            orgData.organization_name || orgData.name || "Provider",
          provider_email: orgData.email || "",
          provider_phone: orgData.phone || "",
          tax_id: orgData.tax_id || "",
          primary_contact_name: orgData.primary_contact_name || "",
          primary_contact_email: orgData.primary_contact_email || "",
          primary_contact_phone: orgData.primary_contact_phone || "",
          total_facilities: facilities.length,
          facility_count_breakdown: this.generateFacilityBreakdown(facilities),
          pricing_structure: strategy.type,
          reimbursement_rates: JSON.stringify(this.stateRates),
          average_reimbursement_rate: strategy.averageRate || strategy.rate,
          exhibit_b_content: this.generateExhibitB(strategy, facilities),
          agreement_date: new Date().toISOString().split("T")[0],
          role_type: this.role,
          ...(strategy.type === "multi-state" && {
            state_breakdown: JSON.stringify(strategy.stateRates),
            multi_state_structure: true,
          }),
        };

        localStorage.setItem("enhanced_psa_data", JSON.stringify(psaPayload));
        console.log("✅ Enhanced PSA data prepared:", psaPayload);
      }

      generateFacilityBreakdown(facilities) {
        const breakdown = {};
        facilities.forEach((f) => {
          const state = f.state || f.address_state || "Unknown";
          breakdown[state] = (breakdown[state] || 0) + 1;
        });
        return breakdown;
      }

      generateExhibitB(strategy, facilities) {
        const facilityBreakdown = this.generateFacilityBreakdown(facilities);
        const totalFacilities = facilities.length;

        if (strategy.type === "multi-state") {
          const stateLines = Object.entries(strategy.stateRates)
            .map(([state, rate]) => {
              const n = facilityBreakdown[state] || 1;
              const plural = n === 1 ? "facility" : "facilities";
              return `${state}: ${rate}% of Medicare Allowable (${n} ${plural})`;
            })
            .join("\n");

          return `EXHIBIT B: REIMBURSEMENT RATES

State-Based Reimbursement Structure:
${stateLines}

Total Authorized Locations: ${totalFacilities}
Portfolio Average Rate: ${strategy.averageRate}% of Medicare Allowable`;
        }

        if (strategy.type === "single-state") {
          const n = facilityBreakdown[strategy.state] || totalFacilities;
          const plural = n === 1 ? "facility" : "facilities";
          return `EXHIBIT B: REIMBURSEMENT RATES

Reimbursement Rate: ${strategy.rate}% of Medicare Allowable
State: ${strategy.state} (${n} ${plural})
Total Authorized Locations: ${totalFacilities}`;
        }

        return `EXHIBIT B: REIMBURSEMENT RATES

Standard reimbursement at ${strategy.rate}% of Medicare Allowable rates.
Total Authorized Locations: ${totalFacilities}`;
      }
    }

    // --- Bootstrap ---
    document.addEventListener("DOMContentLoaded", () => {
      loadOrganizationInfo(); // critical fix
      new DynamicPricingManager().init(); // keep pricing working
    });
  </script>

  <!-- Enhanced CSS for multi-state display -->
  <style>
    .multi-state-rates {
      text-align: center;
    }

    .average-rate {
      font-size: 2.5rem;
      font-weight: bold;
      color: #1e40af;
      line-height: 1;
    }

    .state-breakdown {
      font-size: 0.875rem;
      color: #64748b;
      margin-top: 0.5rem;
      font-weight: 500;
    }

    .state-summary {
      font-size: 0.875rem;
      color: #64748b;
      margin-top: 0.5rem;
      font-style: italic;
    }

    @media (max-width: 640px) {
      .average-rate {
        font-size: 2rem;
      }

      .state-breakdown {
        font-size: 0.8rem;
      }
    }
  </style>
</ProviderLayout>
