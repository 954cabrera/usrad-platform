---
import ProviderLayout from "../../../layouts/ProviderLayout.astro";
---

<ProviderLayout title="Review & Confirm">
  <!-- Progress Indicator -->
  <div class="progress-container">
    <div class="progress-steps">
      <div class="step completed">
        <div class="step-number">✓</div>
        <div class="step-label">Account</div>
      </div>
      <div class="step completed">
        <div class="step-number">✓</div>
        <div class="step-label">Centers</div>
      </div>
      <div class="step completed">
        <div class="step-number">✓</div>
        <div class="step-label">Pricing</div>
      </div>
      <div class="step active">
        <div class="step-number">4</div>
        <div class="step-label">Review</div>
      </div>
      <div class="step">
        <div class="step-number">5</div>
        <div class="step-label">Sign</div>
      </div>
    </div>
  </div>

  <div class="confirmation-container">
    <!-- Header -->
    <div class="header-section">
      <div class="success-icon">
        <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
          <circle cx="30" cy="30" r="30" fill="#D1FAE5"></circle>
          <path
            d="M20 30L26 36L40 22"
            stroke="#059669"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
      <h1 class="page-title">Almost There! Let's Review</h1>
      <p class="page-subtitle">
        Please confirm your information before proceeding to sign the Provider
        Service Agreement
      </p>
    </div>

    <!-- Organization Summary -->
    <div class="review-section">
      <div class="section-header">
        <h2 class="section-title">Organization Information</h2>
        <button class="edit-link" onclick="editOrganization()">Edit</button>
      </div>
      <div class="info-grid" id="organization-info">
        <div class="info-item">
          <span class="info-label">Organization Name</span>
          <span class="info-value" id="org-name">Loading...</span>
        </div>
        <div class="info-item">
          <span class="info-label">Primary Contact</span>
          <span class="info-value" id="org-contact">Loading...</span>
        </div>
        <div class="info-item">
          <span class="info-label">Email</span>
          <span class="info-value" id="org-email">Loading...</span>
        </div>
        <div class="info-item">
          <span class="info-label">Phone</span>
          <span class="info-value" id="org-phone">Loading...</span>
        </div>
      </div>
    </div>

    <!-- Centers Summary -->
    <div class="review-section">
      <div class="section-header">
        <h2 class="section-title">Imaging Centers</h2>
        <button class="edit-link" onclick="editCenters()">Edit</button>
      </div>

      <div class="centers-summary">
        <div class="summary-stats">
          <div class="stat">
            <span class="stat-number" id="total-centers">0</span>
            <span class="stat-label">Total Centers</span>
          </div>
          <div class="stat">
            <span class="stat-number" id="total-states">0</span>
            <span class="stat-label">States</span>
          </div>
          <div class="stat">
            <span class="stat-number" id="total-equipment">0</span>
            <span class="stat-label">Equipment Types</span>
          </div>
        </div>

        <div id="centers-list" class="centers-review-list">
          <!-- Centers will be populated here -->
        </div>
      </div>
    </div>

    <!-- Pricing Strategy Summary -->
    <div class="review-section">
      <div class="section-header">
        <h2 class="section-title">Pricing Strategy</h2>
        <button class="edit-link" onclick="editPricing()">Edit</button>
      </div>

      <div class="pricing-summary">
        <div class="pricing-display">
          <div class="rate-percentage">
            <span id="rate-value">100</span>%
          </div>
          <div class="rate-description">of Medicare Rates</div>
        </div>

        <div class="impact-preview">
          <div class="impact-item positive">
            <div
              class="progress-icon"
              style="display: flex; justify-content: center; align-items: center;"
            >
              <img
                src="/images/icons/trend.svg"
                alt="Trend"
                width="48"
                height="48"
              />
            </div>
            <div>
              <div class="impact-title">Expected Volume</div>
              <div class="impact-value" id="expected-volume">
                High (15-20 patients/week)
              </div>
            </div>
          </div>
          <div class="impact-item">
            <div
              class="progress-icon"
              style="display: flex; justify-content: center; align-items: center;"
            >
              <img
                src="/images/icons/money.svg"
                alt="Projected Annual Revenues"
                width="48"
                height="48"
              />
            </div>
            <div>
              <div class="impact-title">Projected Annual Revenue</div>
              <div class="impact-value" id="projected-revenue">$351,000</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Agreement Details -->
    <div class="review-section agreement-section">
      <div class="section-header">
        <h2 class="section-title">Agreement Details</h2>
      </div>

      <div class="agreement-info">
        <div class="agreement-structure">
          <div class="doc-item">
            <img
              src="/images/icons/contract-2.svg"
              alt="PSA Agreement"
              width="48"
              height="48"
            />
            <div class="doc-details">
              <h3>Provider Service Agreement (PSA)</h3>
              <p>Standard agreement covering all your centers</p>
              <span class="doc-meta">10 pages • Digital signature required</span
              >
            </div>
          </div>

          <div class="doc-item">
            <img
              src="/images/icons/list.svg"
              alt="Facility Details"
              width="48"
              height="48"
            />
            <div class="doc-details">
              <h3>Exhibit B - Facility Details</h3>
              <p>
                Lists all <span id="exhibit-count">0</span> of your imaging centers
              </p>
              <span class="doc-meta"
                >Delivered separately after PSA signing</span
              >
            </div>
          </div>
        </div>

        <button class="preview-button" onclick="previewExhibitB()">
          Preview How Your Centers Will Appear in Exhibit B
        </button>
      </div>
    </div>

    <!-- Confirmation Checkboxes -->
    <div class="review-section">
      <h2 class="section-title">Please Confirm</h2>

      <div class="confirmation-list">
        <label class="confirmation-item">
          <input
            type="checkbox"
            class="confirmation-checkbox"
            data-confirm="info"
          />
          <span class="checkbox-custom"></span>
          <span class="confirmation-text">
            All information above is accurate and complete
          </span>
        </label>

        <label class="confirmation-item">
          <input
            type="checkbox"
            class="confirmation-checkbox"
            data-confirm="authorized"
          />
          <span class="checkbox-custom"></span>
          <span class="confirmation-text">
            I am authorized to sign agreements on behalf of this organization
          </span>
        </label>

        <label class="confirmation-item">
          <input
            type="checkbox"
            class="confirmation-checkbox"
            data-confirm="terms"
          />
          <span class="checkbox-custom"></span>
          <span class="confirmation-text">
            I understand the pricing terms and payment structure
          </span>
        </label>

        <label class="confirmation-item">
          <input
            type="checkbox"
            class="confirmation-checkbox"
            data-confirm="exhibit"
          />
          <span class="checkbox-custom"></span>
          <span class="confirmation-text">
            I understand Exhibit B will be delivered after PSA signing
          </span>
        </label>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="action-section">
      <button class="btn-secondary" onclick="goBack()">
        ← Back to Pricing
      </button>
      <button
        class="btn-primary"
        id="continue-btn"
        disabled
        onclick="proceedToSign()"
      >
        Proceed to Digital Signature →
      </button>
    </div>
  </div>

  <!-- Exhibit B Preview Modal -->
  <div class="modal-overlay" id="exhibit-modal" style="display: none;">
    <div class="modal-container">
      <div class="modal-header">
        <h2>Exhibit B Preview</h2>
        <button class="modal-close" onclick="closeModal()">×</button>
      </div>
      <div class="modal-content">
        <div class="exhibit-preview">
          <h3>EXHIBIT B - AUTHORIZED IMAGING CENTERS</h3>
          <p class="exhibit-intro">
            The following imaging centers are authorized to provide services
            under this agreement:
          </p>
          <div id="exhibit-centers-list">
            <!-- Centers will be populated here -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Progress Indicator */
    .progress-container {
      max-width: 800px;
      margin: 2rem auto 3rem;
      padding: 0 2rem;
    }

    .progress-steps {
      display: flex;
      justify-content: space-between;
      position: relative;
    }

    .progress-steps::before {
      content: "";
      position: absolute;
      top: 20px;
      left: 0;
      right: 0;
      height: 2px;
      background: #e5e7eb;
      z-index: -1;
    }

    .step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      position: relative;
      background: white;
      padding: 0 0.5rem;
    }

    .step-number {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #e5e7eb;
      color: #6b7280;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 0.875rem;
      transition: all 0.3s ease;
    }

    .step.completed .step-number {
      background: #10b981;
      color: white;
    }

    .step.active .step-number {
      background: #3b82f6;
      color: white;
      box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }

    .step-label {
      font-size: 0.875rem;
      color: #6b7280;
      font-weight: 500;
    }

    .step.active .step-label {
      color: #1f2937;
      font-weight: 600;
    }

    /* Container */
    .confirmation-container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem;
    }

    /* Header */
    .header-section {
      text-align: center;
      margin-bottom: 3rem;
    }

    .success-icon {
      margin-bottom: 1.5rem;
    }

    .page-title {
      font-size: 2.5rem;
      font-weight: 700;
      color: #111827;
      margin-bottom: 1rem;
    }

    .page-subtitle {
      font-size: 1.125rem;
      color: #6b7280;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Review Sections */
    .review-section {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
      margin-bottom: 2rem;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .section-title {
      font-size: 1.5rem;
      font-weight: 600;
      color: #1f2937;
      margin: 0;
    }

    .edit-link {
      color: #3b82f6;
      font-size: 0.875rem;
      font-weight: 600;
      background: none;
      border: none;
      cursor: pointer;
      text-decoration: underline;
    }

    .edit-link:hover {
      color: #2563eb;
    }

    /* Info Grid */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .info-item {
      display: flex;
      flex-direction: column;
    }

    .info-label {
      font-size: 0.875rem;
      color: #6b7280;
      margin-bottom: 0.25rem;
    }

    .info-value {
      font-size: 1rem;
      color: #1f2937;
      font-weight: 600;
    }

    /* Centers Summary */
    .summary-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .stat {
      text-align: center;
      padding: 1rem;
      background: #f9fafb;
      border-radius: 8px;
    }

    .stat-number {
      display: block;
      font-size: 2rem;
      font-weight: 700;
      color: #1f2937;
    }

    .stat-label {
      display: block;
      font-size: 0.875rem;
      color: #6b7280;
      margin-top: 0.25rem;
    }

    .centers-review-list {
      display: grid;
      gap: 0.75rem;
    }

    .center-review-item {
      padding: 1rem;
      background: #f9fafb;
      border-radius: 8px;
      border: 1px solid #e5e7eb;
    }

    .center-review-item.primary {
      border-color: #3b82f6;
      background: #eff6ff;
    }

    .center-name {
      font-weight: 600;
      color: #1f2937;
      margin-bottom: 0.25rem;
    }

    .center-location {
      font-size: 0.875rem;
      color: #6b7280;
    }

    .center-admin {
      font-size: 0.875rem;
      color: #6b7280;
      margin-top: 0.25rem;
    }

    /* Pricing Summary */
    .pricing-display {
      text-align: center;
      padding: 2rem;
      background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
      border-radius: 12px;
      margin-bottom: 1.5rem;
    }

    .rate-percentage {
      font-size: 3rem;
      font-weight: 700;
      color: #1e3a8a;
    }

    .rate-description {
      font-size: 1.125rem;
      color: #3730a3;
    }

    .impact-preview {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .impact-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
      background: #f9fafb;
      border-radius: 8px;
    }

    .impact-item.positive {
      background: #d1fae5;
    }

    .impact-icon {
      font-size: 2rem;
    }

    .impact-title {
      font-size: 0.875rem;
      color: #6b7280;
      margin-bottom: 0.25rem;
    }

    .impact-value {
      font-weight: 600;
      color: #1f2937;
    }

    /* Agreement Section */
    .agreement-section {
      background: #fef3c7;
      border: 2px solid #f59e0b;
    }

    .agreement-structure {
      display: grid;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .doc-item {
      display: flex;
      gap: 1rem;
      padding: 1rem;
      background: white;
      border-radius: 8px;
    }

    .doc-icon {
      font-size: 2rem;
    }

    .doc-details h3 {
      font-size: 1rem;
      font-weight: 600;
      color: #1f2937;
      margin-bottom: 0.25rem;
    }

    .doc-details p {
      font-size: 0.875rem;
      color: #6b7280;
      margin-bottom: 0.25rem;
    }

    .doc-meta {
      font-size: 0.75rem;
      color: #9ca3af;
    }

    .preview-button {
      width: 100%;
      padding: 0.75rem;
      background: white;
      color: #f59e0b;
      border: 2px solid #f59e0b;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .preview-button:hover {
      background: #fef3c7;
    }

    /* Confirmation List */
    .confirmation-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .confirmation-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      cursor: pointer;
      padding: 1rem;
      background: #f9fafb;
      border-radius: 8px;
      transition: background 0.2s;
    }

    .confirmation-item:hover {
      background: #f3f4f6;
    }

    .confirmation-checkbox {
      position: absolute;
      opacity: 0;
    }

    .checkbox-custom {
      width: 24px;
      height: 24px;
      border: 2px solid #d1d5db;
      border-radius: 6px;
      transition: all 0.2s;
      position: relative;
      flex-shrink: 0;
    }

    .confirmation-checkbox:checked + .checkbox-custom {
      background: #3b82f6;
      border-color: #3b82f6;
    }

    .confirmation-checkbox:checked + .checkbox-custom::after {
      content: "✓";
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: white;
      font-weight: 600;
    }

    .confirmation-text {
      color: #374151;
    }

    /* Action Buttons */
    .action-section {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 3rem;
    }

    .btn-primary {
      background: #3b82f6;
      color: white;
      padding: 0.875rem 2rem;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-primary:hover:not(:disabled) {
      background: #2563eb;
    }

    .btn-primary:disabled {
      background: #9ca3af;
      cursor: not-allowed;
    }

    .btn-secondary {
      background: white;
      color: #6b7280;
      padding: 0.875rem 2rem;
      border: 2px solid #e5e7eb;
      border-radius: 8px;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-secondary:hover {
      border-color: #d1d5db;
      background: #f9fafb;
    }

    /* Modal */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      padding: 2rem;
    }

    .modal-container {
      background: white;
      border-radius: 16px;
      max-width: 800px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem;
      border-bottom: 1px solid #e5e7eb;
    }

    .modal-header h2 {
      font-size: 1.5rem;
      font-weight: 600;
      color: #1f2937;
    }

    .modal-close {
      width: 32px;
      height: 32px;
      border: none;
      background: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: #6b7280;
      border-radius: 6px;
      transition: all 0.2s;
    }

    .modal-close:hover {
      background: #f3f4f6;
      color: #1f2937;
    }

    .modal-content {
      padding: 2rem;
    }

    .exhibit-preview {
      font-family: "Courier New", monospace;
      background: #f9fafb;
      padding: 2rem;
      border-radius: 8px;
    }

    .exhibit-preview h3 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 1rem;
      text-align: center;
    }

    .exhibit-intro {
      margin-bottom: 1.5rem;
      font-style: italic;
    }

    .exhibit-center {
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 4px;
    }

    .exhibit-center-header {
      font-weight: 700;
      margin-bottom: 0.5rem;
    }

    .exhibit-center-detail {
      margin-left: 1rem;
      font-size: 0.875rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .info-grid {
        grid-template-columns: 1fr;
      }

      .summary-stats {
        grid-template-columns: 1fr;
      }

      .impact-preview {
        grid-template-columns: 1fr;
      }

      .action-section {
        flex-direction: column-reverse;
        gap: 1rem;
      }

      .btn-primary,
      .btn-secondary {
        width: 100%;
      }

      .progress-steps {
        overflow-x: auto;
        padding-bottom: 0.5rem;
      }

      .step-label {
        font-size: 0.75rem;
        white-space: nowrap;
      }
    }

    @media (max-width: 640px) {
      .page-title {
        font-size: 2rem;
      }

      .confirmation-container {
        padding: 1rem;
      }

      .review-section {
        padding: 1.5rem;
      }
    }
  </style>

  <script>
    // Load data on page load
    document.addEventListener("DOMContentLoaded", function () {
      loadOrganizationInfo();
      loadCenters();
      loadPricingStrategy();
      setupCheckboxes();
    });

    // Load organization info from Supabase auth
    async function loadOrganizationInfo() {
      try {
        // Get from Supabase auth metadata or localStorage
        const savedData = localStorage.getItem("provider_signup_data");
        if (savedData) {
          const data = JSON.parse(savedData);
          document.getElementById("org-name").textContent =
            data.organizationName || "N/A";
          document.getElementById("org-contact").textContent =
            data.fullName || "N/A";
          document.getElementById("org-email").textContent =
            data.email || "N/A";
          document.getElementById("org-phone").textContent =
            data.phone || "N/A";
        }
      } catch (error) {
        console.error("Error loading organization info:", error);
      }
    }

    // Load centers
    function loadCenters() {
      const centers = JSON.parse(
        localStorage.getItem("provider_centers") || "[]"
      );

      // Update stats
      document.getElementById("total-centers").textContent = centers.length;
      document.getElementById("exhibit-count").textContent = centers.length;

      // Count unique states
      const states = new Set(centers.map((c) => c.state));
      document.getElementById("total-states").textContent = states.size;

      // Count unique equipment types
      const equipment = new Set();
      centers.forEach((c) => c.equipment.forEach((e) => equipment.add(e)));
      document.getElementById("total-equipment").textContent = equipment.size;

      // Display centers
      const centersList = document.getElementById("centers-list");
      centersList.innerHTML = centers
        .map(
          (center, index) => `
        <div class="center-review-item ${center.isPrimary ? "primary" : ""}">
          <div class="center-name">
            ${center.name} ${center.isPrimary ? '<span style="color: #3B82F6; font-size: 0.75rem;">(Primary)</span>' : ""}
          </div>
          <div class="center-location">
            ${center.address}, ${center.city}, ${center.state} ${center.zipCode}
          </div>
          <div class="center-admin">
            Administrator: ${center.administrator.name} (${center.administrator.email})
          </div>
        </div>
      `
        )
        .join("");
    }

    // Load pricing strategy
    function loadPricingStrategy() {
      const strategy = JSON.parse(
        localStorage.getItem("selected_rate_strategy") || "{}"
      );
      const percentage = strategy.percentage || 100;

      document.getElementById("rate-value").textContent = percentage;

      // Update expected volume and revenue based on percentage
      let volume, revenue;
      if (percentage <= 100) {
        volume = "High (15-20 patients/week)";
        revenue = "$351,000";
      } else if (percentage <= 110) {
        volume = "Good (8-12 patients/week)";
        revenue = "$280,000";
      } else if (percentage <= 120) {
        volume = "Moderate (4-6 patients/week)";
        revenue = "$156,000";
      } else {
        volume = "Low (2-3 patients/week)";
        revenue = "$87,750";
      }

      document.getElementById("expected-volume").textContent = volume;
      document.getElementById("projected-revenue").textContent = revenue;
    }

    // Setup checkboxes
    function setupCheckboxes() {
      const checkboxes = document.querySelectorAll(".confirmation-checkbox");
      const continueBtn = document.getElementById("continue-btn");

      checkboxes.forEach((checkbox) => {
        checkbox.addEventListener("change", () => {
          const allChecked = Array.from(checkboxes).every((cb) => cb.checked);
          continueBtn.disabled = !allChecked;
        });
      });
    }

    // Navigation functions
    window.editOrganization = function () {
      window.location.href = "/providers/join";
    };

    window.editCenters = function () {
      window.location.href = "/providers/onboarding/facilities";
    };

    window.editPricing = function () {
      window.location.href = "/providers/onboarding/market-calculator";
    };

    window.goBack = function () {
      window.location.href = "/providers/onboarding/market-calculator";
    };

    window.proceedToSign = function () {
      // Save confirmation status
      localStorage.setItem("psa_confirmation_completed", "true");

      // Navigate to PSA signing
      window.location.href = "/providers/onboarding/psa-signing";
    };

    // Exhibit B Preview
    window.previewExhibitB = function () {
      const centers = JSON.parse(
        localStorage.getItem("provider_centers") || "[]"
      );
      const exhibitList = document.getElementById("exhibit-centers-list");

      exhibitList.innerHTML = centers
        .map(
          (center, index) => `
        <div class="exhibit-center">
          <div class="exhibit-center-header">
            CENTER ${index + 1}: ${center.name.toUpperCase()}
          </div>
          <div class="exhibit-center-detail">
            Address: ${center.address}, ${center.city}, ${center.state} ${center.zipCode}<br>
            Phone: ${center.phone}<br>
            Administrator: ${center.administrator.name}<br>
            Contact: ${center.administrator.email} | ${center.administrator.phone}<br>
            Equipment: ${center.equipment.join(", ")}<br>
            ${center.isPrimary ? "PRIMARY LOCATION" : ""}
          </div>
        </div>
      `
        )
        .join("");

      document.getElementById("exhibit-modal").style.display = "flex";
    };

    window.closeModal = function () {
      document.getElementById("exhibit-modal").style.display = "none";
    };
  </script>
</ProviderLayout>
