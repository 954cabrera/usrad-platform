---
import ProviderLayout from "../../../layouts/ProviderLayout.astro";
---

<ProviderLayout title="Register Your Imaging Centers">
  <!-- Progress Indicator -->
  <div class="progress-container">
    <div class="progress-steps">
      <div class="step completed">
        <div class="step-number">✓</div>
        <div class="step-label">Account</div>
      </div>
      <div class="step active">
        <div class="step-number">2</div>
        <div class="step-label">Centers</div>
      </div>
      <div class="step">
        <div class="step-number">3</div>
        <div class="step-label">Pricing</div>
      </div>
      <div class="step">
        <div class="step-number">4</div>
        <div class="step-label">Review</div>
      </div>
      <div class="step">
        <div class="step-number">5</div>
        <div class="step-label">Sign</div>
      </div>
    </div>
  </div>

  <div class="facilities-container">
    <!-- Header -->
    <div class="header-section">
      <h1 class="page-title">Register Your Imaging Centers</h1>
      <p class="page-subtitle">
        Add the imaging centers that will be part of the USRad network. You can
        add more centers later.
      </p>
    </div>

    <!-- Quick Stats -->
    <div class="quick-stats">
      <div class="stat-card">
        <div class="stat-icon">
          <img src="/images/icons/check-mark.svg" alt="Hospital icon" />
        </div>
        <div class="stat-content">
          <div class="stat-number" id="center-count">0</div>
          <div class="stat-label">Centers Added</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">
          <img src="/images/icons/usa-map.svg" alt="Location icon" />
        </div>
        <div class="stat-content">
          <div class="stat-number" id="state-count">0</div>
          <div class="stat-label">States Covered</div>
        </div>
      </div>
      <div class="stat-card highlight">
        <div class="stat-icon">
          <img src="/images/icons/revenue.svg" alt="Revenue icon" />
        </div>
        <div class="stat-content">
          <div class="stat-number">$180M+</div>
          <div class="stat-label">Revenue Delivered</div>
        </div>
      </div>
    </div>

    <!-- Add Center Form -->
    <div class="add-center-section" id="add-center-form">
      <div class="section-header">
        <h2 class="section-title">Add Your First Center</h2>
        <p class="section-description">
          Start with your primary imaging center. You can add additional
          locations after.
        </p>
      </div>

      <form id="facility-form" class="facility-form">
        <!-- Pre-populate Toggle -->
        <div class="form-group full-width" id="prepopulate-section">
          <label class="toggle-label">
            <input type="checkbox" id="use-org-info" />
            <span class="toggle-text"
              >Use organization address and contact information</span
            >
          </label>
          <p class="toggle-hint">
            Auto-fill this form with your organization details
          </p>
        </div>

        <div class="form-grid">
          <!-- Center Name -->
          <div class="form-group full-width">
            <label class="form-label">
              Center Name <span class="required">*</span>
            </label>
            <input
              type="text"
              name="centerName"
              class="form-input"
              placeholder="Advanced Imaging of Miami"
              required
            />
          </div>

          <!-- Address -->
          <div class="form-group full-width">
            <label class="form-label">
              Street Address <span class="required">*</span>
            </label>
            <input
              type="text"
              name="address"
              class="form-input"
              placeholder="123 Medical Plaza Drive"
              required
            />
          </div>

          <!-- City -->
          <div class="form-group">
            <label class="form-label">
              City <span class="required">*</span>
            </label>
            <input
              type="text"
              name="city"
              class="form-input"
              placeholder="Miami"
              required
            />
          </div>

          <!-- State -->
          <div class="form-group">
            <label class="form-label">
              State <span class="required">*</span>
            </label>
            <select name="state" class="form-input" required>
              <option value="">Select State</option>
              <optgroup label="Targeted States">
                <option value="FL">Florida</option>
                <option value="GA">Georgia</option>
                <option value="TX">Texas</option>
                <option value="CA">California</option>
                <option value="NY">New York</option>
                <option value="IL">Illinois</option>
                <option value="PA">Pennsylvania</option>
                <option value="OH">Ohio</option>
                <option value="NC">North Carolina</option>
                <option value="MI">Michigan</option>
              </optgroup>
              <optgroup label="All Other States">
                <option value="AL">Alabama</option>
                <option value="AK">Alaska</option>
                <option value="AZ">Arizona</option>
                <option value="AR">Arkansas</option>
                <option value="CO">Colorado</option>
                <option value="CT">Connecticut</option>
                <option value="DE">Delaware</option>
                <option value="DC">District of Columbia</option>
                <option value="HI">Hawaii</option>
                <option value="ID">Idaho</option>
                <option value="IN">Indiana</option>
                <option value="IA">Iowa</option>
                <option value="KS">Kansas</option>
                <option value="KY">Kentucky</option>
                <option value="LA">Louisiana</option>
                <option value="ME">Maine</option>
                <option value="MD">Maryland</option>
                <option value="MA">Massachusetts</option>
                <option value="MN">Minnesota</option>
                <option value="MS">Mississippi</option>
                <option value="MO">Missouri</option>
                <option value="MT">Montana</option>
                <option value="NE">Nebraska</option>
                <option value="NV">Nevada</option>
                <option value="NH">New Hampshire</option>
                <option value="NJ">New Jersey</option>
                <option value="NM">New Mexico</option>
                <option value="ND">North Dakota</option>
                <option value="OK">Oklahoma</option>
                <option value="OR">Oregon</option>
                <option value="RI">Rhode Island</option>
                <option value="SC">South Carolina</option>
                <option value="SD">South Dakota</option>
                <option value="TN">Tennessee</option>
                <option value="UT">Utah</option>
                <option value="VT">Vermont</option>
                <option value="VA">Virginia</option>
                <option value="WA">Washington</option>
                <option value="WV">West Virginia</option>
                <option value="WI">Wisconsin</option>
                <option value="WY">Wyoming</option>
              </optgroup>
            </select>
          </div>

          <!-- ZIP -->
          <div class="form-group">
            <label class="form-label">
              ZIP Code <span class="required">*</span>
            </label>
            <input
              type="text"
              name="zipCode"
              class="form-input"
              placeholder="33101"
              pattern="[0-9]{5}"
              maxlength="5"
              required
            />
          </div>

          <!-- Phone -->
          <div class="form-group">
            <label class="form-label">
              Center Phone <span class="required">*</span>
            </label>
            <input
              type="tel"
              name="phone"
              class="form-input"
              placeholder="(305) 555-0123"
              required
            />
          </div>

          <!-- Administrator/Contact Section Header -->
          <div class="form-group full-width">
            <h3 class="subsection-title">Center Administrator</h3>
            <p class="subsection-description">
              Who should we contact about this location?
            </p>
          </div>

          <!-- Admin Name -->
          <div class="form-group">
            <label class="form-label">
              Contact Name <span class="required">*</span>
            </label>
            <input
              type="text"
              name="adminName"
              class="form-input"
              placeholder="Dr. Jane Smith"
              required
            />
          </div>

          <!-- Admin Title -->
          <div class="form-group">
            <label class="form-label">
              Title/Role <span class="required">*</span>
            </label>
            <input
              type="text"
              name="adminTitle"
              class="form-input"
              placeholder="Center Director"
              required
            />
          </div>

          <!-- Admin Email -->
          <div class="form-group">
            <label class="form-label">
              Contact Email <span class="required">*</span>
            </label>
            <input
              type="email"
              name="adminEmail"
              class="form-input"
              placeholder="jane.smith@imagingcenter.com"
              title="Please enter a valid email address"
              required
            />
          </div>

          <!-- Admin Phone -->
          <div class="form-group">
            <label class="form-label">
              Direct Phone <span class="required">*</span>
            </label>
            <input
              type="tel"
              name="adminPhone"
              class="form-input"
              placeholder="(305) 555-0124"
              required
            />
          </div>

          <!-- Equipment -->
          <div class="form-group full-width">
            <label class="form-label">
              Available Equipment <span class="required">*</span>
            </label>
            <div class="equipment-grid">
              <label class="equipment-option">
                <input type="checkbox" name="equipment" value="MRI" />
                <div class="equipment-card">
                  <div class="equipment-icon">
                    <img src="/images/icons/mri-machine.svg" alt="MRI" />
                  </div>
                  <div class="equipment-name">MRI</div>
                </div>
              </label>
              <label class="equipment-option">
                <input type="checkbox" name="equipment" value="CT" />
                <div class="equipment-card">
                  <div class="equipment-icon">
                    <img src="/images/icons/ct-scan-1.svg" alt="CT Scan" />
                  </div>
                  <div class="equipment-name">CT Scan</div>
                </div>
              </label>
              <label class="equipment-option">
                <input type="checkbox" name="equipment" value="X-Ray" />
                <div class="equipment-card">
                  <div class="equipment-icon">
                    <img src="/images/icons/x-ray.svg" alt="X-Ray" />
                  </div>
                  <div class="equipment-name">X-Ray</div>
                </div>
              </label>
              <label class="equipment-option">
                <input type="checkbox" name="equipment" value="Ultrasound" />
                <div class="equipment-card">
                  <div class="equipment-icon">
                    <img
                      src="/images/icons/ultrasound (1).svg"
                      alt="Ultrasound"
                    />
                  </div>
                  <div class="equipment-name">Ultrasound</div>
                </div>
              </label>
              <label class="equipment-option">
                <input type="checkbox" name="equipment" value="PET" />
                <div class="equipment-card">
                  <div class="equipment-icon">
                    <img src="/images/icons/pet-scan.svg" alt="PET Scan" />
                  </div>
                  <div class="equipment-name">PET Scan</div>
                </div>
              </label>
              <label class="equipment-option">
                <input type="checkbox" name="equipment" value="Mammography" />
                <div class="equipment-card">
                  <div class="equipment-icon">
                    <img src="/images/icons/screening.svg" alt="Mammography" />
                  </div>
                  <div class="equipment-name">Mammography</div>
                </div>
              </label>
            </div>
            <p class="form-hint">
              Select all equipment available at this location
            </p>
          </div>

          <!-- Equipment Details Section -->
          <div
            class="form-group full-width"
            id="equipment-details-section"
            style="display: none;"
          >
            <h3 class="subsection-title">
              Equipment Details <span class="optional">(Optional)</span>
            </h3>
            <p class="subsection-description">
              Add specific details about your equipment to help patients find
              the right center
            </p>

            <div id="equipment-details-container">
              <!-- Equipment details will be dynamically added here -->
            </div>
          </div>

          <!-- Primary Center -->
          <div class="form-group full-width">
            <label class="checkbox-label">
              <input type="checkbox" name="isPrimary" checked />
              <span>This is my primary imaging center</span>
            </label>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary" id="submit-btn">
            Add Center
          </button>
        </div>
      </form>
    </div>

    <!-- Centers List -->
    <div class="centers-list" id="centers-list" style="display: none;">
      <div class="section-header">
        <h2 class="section-title">Your Imaging Centers</h2>
        <button class="btn-secondary" id="add-another-btn">
          + Add Another Center
        </button>
      </div>

      <div id="centers-container" class="centers-container">
        <!-- Centers will be added here dynamically -->
      </div>
    </div>

    <!-- Continue Button -->
    <div class="continue-section" id="continue-section" style="display: none;">
      <div class="continue-content">
        <p class="continue-text">
          Great! You've added <span id="final-count">0</span> imaging center(s) to
          your network.
        </p>
        <button onclick="continueToNext()" class="btn-continue">
          Continue to Pricing Strategy →
        </button>
      </div>
    </div>
  </div>

  <style>
    /* Progress Indicator */
    .progress-container {
      max-width: 800px;
      margin: 2rem auto 3rem;
      padding: 0 2rem;
    }

    .progress-steps {
      display: flex;
      justify-content: space-between;
      position: relative;
    }

    .progress-steps::before {
      content: "";
      position: absolute;
      top: 20px;
      left: 0;
      right: 0;
      height: 2px;
      background: #e5e7eb;
      z-index: -1;
    }

    .step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      position: relative;
      background: white;
      padding: 0 0.5rem;
    }

    .step-number {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #e5e7eb;
      color: #6b7280;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 0.875rem;
      transition: all 0.3s ease;
    }

    .step.completed .step-number {
      background: #10b981;
      color: white;
    }

    .step.active .step-number {
      background: #3b82f6;
      color: white;
      box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }

    .step-label {
      font-size: 0.875rem;
      color: #6b7280;
      font-weight: 500;
    }

    .step.active .step-label {
      color: #1f2937;
      font-weight: 600;
    }

    /* Container */
    .facilities-container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem;
    }

    /* Header */
    .header-section {
      text-align: center;
      margin-bottom: 3rem;
    }

    .page-title {
      font-size: 2.5rem;
      font-weight: 700;
      color: #111827;
      margin-bottom: 1rem;
    }

    .page-subtitle {
      font-size: 1.125rem;
      color: #6b7280;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Quick Stats */
    .quick-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .stat-card {
      background: white;
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      transition: all 0.3s ease;
    }

    .stat-card.highlight {
      background: #fef3c7;
      border-color: #f59e0b;
    }

    .stat-icon {
      font-size: 2rem;
    }

    .stat-number {
      font-size: 1.75rem;
      font-weight: 700;
      color: #1f2937;
    }

    .stat-card.highlight .stat-number {
      color: #92400e;
    }

    .stat-label {
      font-size: 0.875rem;
      color: #6b7280;
    }

    /* Form Section */
    .add-center-section {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
      margin-bottom: 2rem;
    }

    /* Pre-populate Toggle */
    #prepopulate-section {
      background: #eff6ff;
      border: 2px solid #3b82f6;
      border-radius: 8px;
      padding: 1rem;
      margin-bottom: 1.5rem;
    }

    .toggle-label {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      cursor: pointer;
      font-weight: 600;
      color: #1f2937;
    }

    .toggle-label input[type="checkbox"] {
      width: 20px;
      height: 20px;
      cursor: pointer;
    }

    .toggle-hint {
      font-size: 0.875rem;
      color: #3b82f6;
      margin-top: 0.5rem;
      margin-left: 2rem;
    }

    .section-header {
      margin-bottom: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .section-title {
      font-size: 1.5rem;
      font-weight: 600;
      color: #1f2937;
    }

    .section-description {
      color: #6b7280;
      margin-top: 0.5rem;
    }

    /* Form Grid */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group.full-width {
      grid-column: 1 / -1;
    }

    .form-label {
      font-weight: 600;
      color: #374151;
      margin-bottom: 0.5rem;
      font-size: 0.875rem;
    }

    .required {
      color: #ef4444;
    }

    .optional {
      color: #6b7280;
      font-weight: 400;
      font-size: 0.875rem;
    }

    .form-input {
      padding: 0.75rem 1rem;
      border: 2px solid #e5e7eb;
      border-radius: 8px;
      font-size: 1rem;
      transition: border-color 0.2s;
    }

    .form-input:focus {
      outline: none;
      border-color: #3b82f6;
    }

    .form-input.error {
      border-color: #ef4444;
      background-color: #fef2f2;
    }

    .error-message {
      display: block;
      color: #ef4444;
      font-size: 0.75rem;
      margin-top: 0.25rem;
    }

    .form-hint {
      font-size: 0.75rem;
      color: #6b7280;
      margin-top: 0.25rem;
    }

    /* Subsection Headers */
    .subsection-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: #1f2937;
      margin-bottom: 0.5rem;
    }

    .subsection-description {
      font-size: 0.875rem;
      color: #6b7280;
      margin-bottom: 0;
    }

    /* Equipment Grid */
    .equipment-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .equipment-option {
      position: relative;
      cursor: pointer;
    }

    .equipment-option input {
      position: absolute;
      opacity: 0;
    }

    .equipment-card {
      background: #f9fafb;
      border: 2px solid #e5e7eb;
      border-radius: 8px;
      padding: 1rem;
      text-align: center;
      transition: all 0.2s;
    }

    .equipment-option input:checked + .equipment-card {
      background: #dbeafe;
      border-color: #3b82f6;
    }

    .equipment-icon {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .equipment-name {
      font-size: 0.875rem;
      font-weight: 500;
      color: #374151;
    }

    /* Equipment Details */
    #equipment-details-section {
      background: #f9fafb;
      border-radius: 12px;
      padding: 1.5rem;
      margin-top: 1rem;
    }

    .equipment-detail-group {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 1rem;
      margin-bottom: 1rem;
    }

    .equipment-detail-title {
      font-weight: 600;
      color: #1f2937;
      margin-bottom: 0.75rem;
      font-size: 0.9375rem;
    }

    .detail-options {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 0.5rem;
    }

    .detail-option {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      background: #f3f4f6;
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .detail-option input[type="radio"],
    .detail-option input[type="checkbox"] {
      margin: 0;
    }

    .detail-option:has(input:checked) {
      background: #dbeafe;
      border-color: #3b82f6;
      color: #1e40af;
    }

    .other-input {
      margin-top: 0.5rem;
      padding: 0.5rem;
      border: 1px solid #e5e7eb;
      border-radius: 4px;
      font-size: 0.875rem;
      width: 100%;
    }

    /* Checkbox */
    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    }

    .checkbox-label input {
      width: 1.25rem;
      height: 1.25rem;
    }

    /* Form Actions */
    .form-actions {
      margin-top: 2rem;
      display: flex;
      justify-content: flex-end;
    }

    /* Buttons */
    .btn-primary {
      background: #3b82f6;
      color: white;
      padding: 0.75rem 2rem;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-primary:hover {
      background: #2563eb;
    }

    .btn-secondary {
      background: white;
      color: #3b82f6;
      padding: 0.625rem 1.5rem;
      border: 2px solid #3b82f6;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-secondary:hover {
      background: #eff6ff;
    }

    /* Centers List */
    .centers-list {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
      margin-bottom: 2rem;
    }

    .centers-container {
      display: grid;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .center-card {
      background: #f9fafb;
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: start;
    }

    .center-card.primary {
      border-color: #3b82f6;
      background: #eff6ff;
    }

    .center-info h3 {
      font-size: 1.125rem;
      font-weight: 600;
      color: #1f2937;
      margin-bottom: 0.5rem;
    }

    .center-address {
      color: #6b7280;
      font-size: 0.875rem;
      margin-bottom: 0.5rem;
    }

    .center-admin {
      color: #374151;
      font-size: 0.875rem;
      margin: 0.5rem 0;
      padding: 0.75rem;
      background: #f3f4f6;
      border-radius: 6px;
    }

    .admin-contact {
      font-size: 0.8125rem;
      color: #6b7280;
    }

    .center-equipment {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-top: 0.5rem;
    }

    .equipment-tag {
      background: #e5e7eb;
      color: #374151;
      padding: 0.25rem 0.75rem;
