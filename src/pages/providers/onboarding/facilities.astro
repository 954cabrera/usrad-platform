---
import ProviderLayout from "../../../layouts/ProviderLayout.astro";
import ProgressIndicator from "../../../components/Providers/Onboarding/Facilities/ProgressIndicator.astro";
import QuickStats from "../../../components/Providers/Onboarding/Facilities/QuickStats.astro";
import AddCenterForm from "../../../components/Providers/Onboarding/Facilities/AddCenterForm.astro";
import CentersList from "../../../components/Providers/Onboarding/Facilities/CentersList.astro";
import ContinueSection from "../../../components/Providers/Onboarding/Facilities/ContinueSection.astro";
import "../../../styles/providers/facilities.css";
---

<ProviderLayout title="Register Your Imaging Centers">
  <!-- Progress Indicator -->
  <ProgressIndicator />

  <div class="facilities-container">
    <!-- Header -->
    <div class="header-section">
      <h1 class="page-title">Register Your Imaging Centers</h1>
      <p class="page-subtitle">
        Add the imaging centers that will be part of the USRad network. You can
        add more centers later.
      </p>
    </div>

    <!-- Quick Stats -->
    <QuickStats />

    <!-- Add Center Form -->
    <AddCenterForm />

    <!-- Centers List -->
    <CentersList />

    <!-- Continue Button -->
    <ContinueSection />
  </div>
</ProviderLayout>

<script src="../../../scripts/providers/facilities.js"></script>
