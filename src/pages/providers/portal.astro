---
// src/pages/providers/portal.astro
import ProviderLayout from "../../layouts/ProviderLayout.astro";
import ProviderPortalDashboard from "../../components/providers/ProviderPortalDashboard.jsx";
import AOSInit from "../../components/AOSInit.astro";

export const prerender = true;
---

<ProviderLayout title="Provider Portal | USRad Network" showBackToMain={true}>
  <AOSInit />

  <!-- Portal Hero Section - Unicorn Style -->
  <section
    class="relative pt-32 pb-20 px-4 sm:px-6 min-h-[500px] flex items-center overflow-hidden"
  >
    <!-- Subtle gradient background matching your theme -->
    <div class="absolute inset-0 z-0">
      <div
        class="absolute inset-0 bg-gradient-to-br from-[#003087]/5 via-white to-[#cc9933]/5"
      >
      </div>
    </div>

    <!-- Floating Elements - Minimal like your other pages -->
    <div
      class="absolute top-20 right-10 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl animate-float"
    >
    </div>
    <div
      class="absolute bottom-20 left-10 w-80 h-80 bg-[#cc9933]/5 rounded-full blur-3xl animate-float-delayed"
    >
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto w-full">
      <div class="max-w-4xl">
        <!-- Welcome Message -->
        <div
          class="inline-flex items-center gap-2 bg-green-50 border border-green-200 rounded-full px-4 py-2 mb-8"
          data-aos="fade-down"
        >
          <span class="w-2 h-2 bg-green-500 rounded-full"></span>
          <span class="text-green-700 text-sm font-medium"
            >Welcome to your provider portal</span
          >
        </div>

        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-8 text-gray-900 leading-tight"
          data-aos="fade-up"
        >
          Your Gateway to the<br />
          <span class="text-[#003087]">USRad Network</span>
        </h1>

        <p
          class="text-xl md:text-2xl text-gray-600 leading-relaxed max-w-3xl mb-12"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          Manage your partnership with the network that's transformed healthcare
          for 200+ imaging centers. Complete onboarding, track progress, and
          access everything you need to succeed.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Portal Dashboard -->
  <section
    class="py-12 px-4 sm:px-6 bg-gradient-to-br from-gray-50/50 to-white"
  >
    <div class="max-w-7xl mx-auto">
      <ProviderPortalDashboard client:load />
    </div>
  </section>

  <!-- Trust Section - Matching your other pages -->
  <section class="py-24 px-4 sm:px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6"
        >
          Trusted by 200+ Centers
        </h2>
        <p class="text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto">
          Join the network that's delivered $246 Million in savings and
          revolutionized imaging access for patients nationwide.
        </p>
      </div>

      <!-- Stats Grid - Clean like your other pages -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div data-aos="fade-up">
          <div class="text-4xl md:text-5xl font-bold text-[#003087] mb-2">
            200+
          </div>
          <p class="text-gray-600">Partner Centers</p>
        </div>
        <div data-aos="fade-up" data-aos-delay="100">
          <div class="text-4xl md:text-5xl font-bold text-[#cc9933] mb-2">
            168K+
          </div>
          <p class="text-gray-600">Scans Completed</p>
        </div>
        <div data-aos="fade-up" data-aos-delay="200">
          <div class="text-4xl md:text-5xl font-bold text-green-600 mb-2">
            4.9★
          </div>
          <p class="text-gray-600">Patient Rating</p>
        </div>
        <div data-aos="fade-up" data-aos-delay="300">
          <div class="text-4xl md:text-5xl font-bold text-blue-600 mb-2">
            48hr
          </div>
          <p class="text-gray-600">Average Booking</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Support Section - Minimal like your theme -->
  <section
    class="py-20 px-4 sm:px-6 bg-gradient-to-br from-gray-50/30 to-white"
  >
    <div class="max-w-4xl mx-auto text-center">
      <h2
        class="text-3xl md:text-4xl font-bold text-gray-900 mb-6"
        data-aos="fade-up"
      >
        Need Assistance?
      </h2>
      <p
        class="text-lg text-gray-600 mb-10"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Our provider relations team is here to help you succeed in the USRad
        network.
      </p>

      <div
        class="grid md:grid-cols-2 gap-6 max-w-2xl mx-auto"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <a
          href="tel:+1-800-USR-ADIO"
          class="flex items-center justify-center gap-3 bg-[#003087] text-white px-6 py-4 rounded-xl font-semibold hover:bg-[#002266] transition-all transform hover:scale-105"
        >
          <span>📞</span>
          <span>(800) USR-ADIO</span>
        </a>
        <a
          href="mailto:providers@usrad.com"
          class="flex items-center justify-center gap-3 bg-white border-2 border-gray-200 text-gray-700 px-6 py-4 rounded-xl font-semibold hover:border-gray-300 transition-all transform hover:scale-105"
        >
          <span>✉️</span>
          <span>Email Support</span>
        </a>
      </div>

      <p
        class="text-sm text-gray-500 mt-6"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        Average response time: Under 30 minutes during business hours
      </p>
    </div>
  </section>

  <style>
    /* Float animations matching your other pages */
    @keyframes float {
      0%,
      100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    @keyframes float-delayed {
      0%,
      100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-15px);
      }
    }

    .animate-float {
      animation: float 6s ease-in-out infinite;
    }

    .animate-float-delayed {
      animation: float-delayed 6s ease-in-out infinite;
      animation-delay: 3s;
    }

    /* Mobile responsive adjustments */
    @media (max-width: 768px) {
      .text-4xl {
        font-size: 2rem;
      }
      .text-5xl {
        font-size: 2.5rem;
      }
      .text-6xl {
        font-size: 3rem;
      }
      .text-7xl {
        font-size: 3.5rem;
      }
    }

    /* Focus states for accessibility */
    button:focus,
    a:focus {
      outline: 2px solid #003087;
      outline-offset: 2px;
    }
  </style>
</ProviderLayout>
