// TEMPORARY: Use test data instead
const provider = {
  id: "test-123",
  user_id: "test-user-123",
  organization_name: "Test Medical Center",
  email: "test@example.com",
  legalName: "Test Medical Center LLC",
  created_at: new Date().toISOString(),
};

// TEMPORARY: Use empty arrays for test data
const recentDocs = [
  {
    id: "doc-1",
    provider_id: "test-123",
    document_type: "PSA",
    signed_date: new Date().toISOString(),
    created_at: new Date().toISOString(),
  },
];

const recentActivity = [
  {
    id: "activity-1",
    provider_id: "test-123",
    action: "PSA_SIGNED",
    created_at: new Date().toISOString(),
  },
];

// Store provider info in localStorage for the layout
if (typeof window !== "undefined") {
  localStorage.setItem("provider_organization", JSON.stringify(provider));
}
---

<ProviderLayout title="Provider Portal">
  <PortalLayout currentPage="dashboard" client:load>
    <DashboardHome
      provider={provider}
      recentDocuments={recentDocs}
      recentActivity={recentActivity}
      client:load
    />
  </PortalLayout>
</ProviderLayout>

<script>
  // Simulate loading state
  const dashboard = document.querySelector(".dashboard-home");
  if (dashboard) {
    // Show skeleton for 1 second on page load
    dashboard.classList.add("loading");
    setTimeout(() => {
      dashboard.classList.remove("loading");
    }, 1000);
  }
</script>

<style>
  .dashboard-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .dashboard-wrapper {
      gap: 1rem;
    }
  }
</style>
