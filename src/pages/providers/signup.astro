---
// src/pages/providers/signup.astro
import ProviderLayout from "../../layouts/ProviderLayout.astro";
---

<ProviderLayout title="Sign Up">
  <div class="signup-container">
    <div class="signup-card">
      <h1>Create Test Account</h1>
      <form id="signupForm">
        <input type="email" id="email" placeholder="Email" required />
        <input type="password" id="password" placeholder="Password" required />
        <button type="submit">Sign Up</button>
      </form>
      <div id="message"></div>
    </div>
  </div>

  <style>
    .signup-container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0a0f1b;
    }
    .signup-card {
      background: rgba(255, 255, 255, 0.05);
      padding: 2rem;
      border-radius: 16px;
      width: 300px;
    }
    h1 {
      color: white;
      margin-bottom: 1rem;
    }
    input {
      width: 100%;
      padding: 0.5rem;
      margin-bottom: 1rem;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: white;
      border-radius: 8px;
    }
    button {
      width: 100%;
      padding: 0.5rem;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }
    #message {
      margin-top: 1rem;
      color: white;
    }
  </style>

  <script>
    import { supabase } from "../../lib/supabase";

    const form = document.getElementById("signupForm");
    const message = document.getElementById("message");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const email = document.getElementById("email").value;
      const password = document.getElementById("password").value;

      try {
        // Sign up
        const { data: signUpData, error: signUpError } =
          await supabase.auth.signUp({
            email,
            password,
          });

        if (signUpError) throw signUpError;

        // Create provider record
        const {
          data: { user },
        } = await supabase.auth.getUser();

        if (user) {
          const { error: providerError } = await supabase
            .from("providers")
            .insert({
              user_id: user.id,
              email: email,
              organization_name: "Test Provider",
              created_at: new Date().toISOString(),
            });

          if (providerError) throw providerError;

          message.textContent = "Account created! Redirecting...";
          setTimeout(() => {
            window.location.href = "/providers/portal/";
          }, 2000);
        }
      } catch (error) {
        message.textContent = "Error: " + error.message;
      }
    });
  </script>
</ProviderLayout>
