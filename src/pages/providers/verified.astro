---
// Provider email verification success page
// File: /src/pages/providers/verified.astro
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verified | Welcome to USRad Network</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        background: #ffffff;
        color: #0f172a;
        overflow-x: hidden;
      }

      /* Premium Light Theme with Subtle Gradients */
      .verification-layout {
        min-height: 100vh;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: linear-gradient(135deg, #fafafa 0%, #f3f4f6 100%);
      }

      /* Animated Background Elements - matching join.astro */
      .bg-decoration {
        position: absolute;
        pointer-events: none;
        overflow: hidden;
        inset: 0;
      }

      .gradient-sphere {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.15;
        animation: float 20s ease-in-out infinite;
      }

      .sphere-1 {
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, #667eea 0%, transparent 70%);
        top: -200px;
        left: -200px;
      }

      .sphere-2 {
        width: 800px;
        height: 800px;
        background: radial-gradient(circle, #764ba2 0%, transparent 70%);
        bottom: -300px;
        right: -300px;
        animation-delay: -7s;
      }

      .sphere-3 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, #f093fb 0%, transparent 70%);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        animation-delay: -14s;
      }

      @keyframes float {
        0%,
        100% {
          transform: translate(0, 0) scale(1);
        }
        33% {
          transform: translate(30px, -30px) scale(1.1);
        }
        66% {
          transform: translate(-20px, 20px) scale(0.9);
        }
      }

      /* Glass Card Effect */
      .verification-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.9);
        box-shadow:
          0 20px 40px rgba(0, 0, 0, 0.05),
          inset 0 1px 1px rgba(255, 255, 255, 0.9);
        padding: 3rem;
        max-width: 600px;
        width: 100%;
        text-align: center;
        position: relative;
        overflow: hidden;
        animation: cardEntrance 0.8s ease-out;
      }

      .verification-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.8),
          transparent
        );
      }

      @keyframes cardEntrance {
        from {
          opacity: 0;
          transform: translateY(30px) scale(0.95);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      /* Success Animation */
      .success-animation {
        width: 120px;
        height: 120px;
        margin: 0 auto 2.5rem;
        position: relative;
      }

      .success-circle {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        box-shadow: 0 20px 40px rgba(102, 126, 234, 0.3);
        animation: successPulse 2s ease-in-out infinite;
      }

      @keyframes successPulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 20px 40px rgba(102, 126, 234, 0.3);
        }
        50% {
          transform: scale(1.05);
          box-shadow: 0 25px 50px rgba(102, 126, 234, 0.4);
        }
      }

      .success-circle::before {
        content: "";
        position: absolute;
        inset: -20px;
        background: radial-gradient(
          circle,
          rgba(102, 126, 234, 0.2) 0%,
          transparent 70%
        );
        border-radius: 50%;
        animation: rippleOut 3s linear infinite;
      }

      @keyframes rippleOut {
        0% {
          transform: scale(0.8);
          opacity: 1;
        }
        100% {
          transform: scale(1.5);
          opacity: 0;
        }
      }

      .checkmark {
        color: white;
        font-size: 3rem;
        font-weight: 300;
        animation: checkmarkDraw 0.6s ease-out 0.3s both;
      }

      @keyframes checkmarkDraw {
        from {
          transform: scale(0) rotate(-45deg);
          opacity: 0;
        }
        to {
          transform: scale(1) rotate(0deg);
          opacity: 1;
        }
      }

      /* Content Styling */
      .verification-content h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
        animation: fadeInUp 0.8s ease-out 0.4s both;
      }

      .verification-content .subtitle {
        font-size: 1.25rem;
        color: #64748b;
        margin-bottom: 2rem;
        line-height: 1.6;
        animation: fadeInUp 0.8s ease-out 0.5s both;
      }

      .verification-content .description {
        font-size: 1.1rem;
        color: #64748b;
        margin-bottom: 2.5rem;
        line-height: 1.7;
        animation: fadeInUp 0.8s ease-out 0.6s both;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Premium Badge */
      .welcome-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 0.625rem 1.25rem;
        border-radius: 50px;
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 2rem;
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.25);
        animation: fadeInUp 0.8s ease-out 0.2s both;
      }

      /* Account Setup Status */
      .setup-status {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 12px;
        padding: 1rem;
        margin: 1.5rem 0;
        display: none;
        animation: fadeInUp 0.5s ease-out;
      }

      .setup-status.visible {
        display: block;
      }

      .setup-status.loading {
        background: rgba(59, 130, 246, 0.1);
        border-color: rgba(59, 130, 246, 0.2);
      }

      .setup-status.error {
        background: rgba(245, 158, 11, 0.1);
        border-color: rgba(245, 158, 11, 0.2);
      }

      .setup-status p {
        margin: 0;
        font-size: 0.875rem;
        color: #047857;
        font-weight: 500;
      }

      .setup-status.loading p {
        color: #1e40af;
      }

      .setup-status.error p {
        color: #92400e;
      }

      /* Revenue Banner - matching join.astro style */
      .revenue-banner {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 2rem;
        margin: 2rem 0;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(102, 126, 234, 0.25);
        animation: fadeInUp 0.8s ease-out 0.7s both;
      }

      .revenue-banner::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(
          45deg,
          transparent 30%,
          rgba(255, 255, 255, 0.1) 50%,
          transparent 70%
        );
        animation: shimmer 3s infinite;
      }

      @keyframes shimmer {
        0% {
          transform: translateX(-100%);
        }
        100% {
          transform: translateX(100%);
        }
      }

      .revenue-amount {
        font-size: 2.5rem;
        font-weight: 800;
        color: white;
        margin-bottom: 0.5rem;
        letter-spacing: -0.03em;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        position: relative;
        z-index: 1;
      }

      .revenue-text {
        color: rgba(255, 255, 255, 0.95);
        font-size: 1.1rem;
        font-weight: 500;
        position: relative;
        z-index: 1;
      }

      /* Action Buttons - matching join.astro style */
      .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        animation: fadeInUp 0.8s ease-out 0.8s both;
      }

      .primary-button {
        width: 100%;
        padding: 1rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        font-family: "Inter", sans-serif;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
      }

      .primary-button::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.2),
          transparent
        );
        transition: left 0.5s ease;
      }

      .primary-button:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
      }

      .primary-button:hover:not(:disabled)::before {
        left: 100%;
      }

      .primary-button:active:not(:disabled) {
        transform: translateY(0);
      }

      .secondary-button {
        width: 100%;
        padding: 0.875rem;
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(10px);
        border: 2px solid rgba(0, 0, 0, 0.05);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: #374151;
        font-family: "Inter", sans-serif;
        text-decoration: none;
      }

      .secondary-button:hover {
        background: rgba(255, 255, 255, 0.8);
        border-color: rgba(0, 0, 0, 0.1);
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
      }

      /* Features Grid */
      .network-features {
        margin-top: 2.5rem;
        padding-top: 2.5rem;
        border-top: 1px solid rgba(0, 0, 0, 0.05);
        animation: fadeInUp 0.8s ease-out 0.9s both;
      }

      .features-title {
        color: #1e293b;
        font-size: 1.25rem;
        margin-bottom: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
      }

      .feature-item {
        text-align: center;
        padding: 1.25rem 1rem;
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
      }

      .feature-item:hover {
        background: rgba(255, 255, 255, 0.8);
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      }

      .feature-icon {
        font-size: 2rem;
        margin-bottom: 0.75rem;
        display: block;
      }

      .feature-text {
        font-size: 0.875rem;
        color: #64748b;
        font-weight: 600;
      }

      /* Loading state */
      .primary-button.loading {
        pointer-events: none;
        opacity: 0.8;
      }

      .primary-button.loading .button-text {
        opacity: 0;
      }

      .primary-button.loading::after {
        content: "";
        position: absolute;
        width: 20px;
        height: 20px;
        border: 2px solid transparent;
        border-top: 2px solid white;
        border-radius: 50%;
        animation: buttonSpin 1s linear infinite;
      }

      @keyframes buttonSpin {
        to {
          transform: rotate(360deg);
        }
      }

      /* Confetti */
      .confetti {
        position: fixed;
        width: 10px;
        height: 10px;
        background: #667eea;
        position: absolute;
        animation: confettiFall 3s ease-out forwards;
        z-index: 1000;
      }

      @keyframes confettiFall {
        to {
          transform: translateY(100vh) rotate(720deg);
          opacity: 0;
        }
      }

      /* Mobile Responsive */
      @media (max-width: 768px) {
        .verification-layout {
          padding: 1.5rem;
          min-height: 100dvh;
        }

        .verification-card {
          padding: 2rem 1.5rem;
        }

        .success-animation {
          width: 100px;
          height: 100px;
          margin-bottom: 2rem;
        }

        .checkmark {
          font-size: 2.5rem;
        }

        .verification-content h1 {
          font-size: 2rem;
        }

        .verification-content .subtitle {
          font-size: 1.1rem;
        }

        .revenue-amount {
          font-size: 2rem;
        }

        .features-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .action-buttons {
          gap: 0.875rem;
        }

        .primary-button,
        .secondary-button {
          padding: 1.125rem;
        }
      }

      @media (max-width: 480px) {
        .verification-card {
          padding: 1.75rem 1.25rem;
        }

        .verification-content h1 {
          font-size: 1.75rem;
        }

        .features-grid {
          gap: 0.75rem;
        }
      }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 10px;
      }

      ::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.02);
      }

      ::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.1);
        border-radius: 5px;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: rgba(0, 0, 0, 0.2);
      }

      /* Selection color */
      ::selection {
        background: rgba(102, 126, 234, 0.2);
        color: #334155;
      }
    </style>
  </head>
  <body>
    <div class="verification-layout">
      <!-- Background decoration -->
      <div class="bg-decoration">
        <div class="gradient-sphere sphere-1"></div>
        <div class="gradient-sphere sphere-2"></div>
        <div class="gradient-sphere sphere-3"></div>
      </div>

      <div class="verification-card">
        <div class="welcome-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M9 11H7a5 5 0 0 1 0-10h2m6 0h2a5 5 0 0 1 0 10h-2m-7-5h8"
              stroke="currentColor"
              stroke-width="2"
              fill="none"></path>
          </svg>
          Welcome to USRad Network
        </div>

        <div class="success-animation">
          <div class="success-circle">
            <div class="checkmark">✓</div>
          </div>
        </div>

        <div class="verification-content">
          <h1>Email Verified Successfully!</h1>
          <p class="subtitle">Your provider account is now active</p>
          <p class="description">
            You're officially part of the USRad Provider Network. Access your
            dashboard to complete onboarding, register your imaging centers, and
            start receiving guaranteed-payment patients.
          </p>

          <!-- Account setup status indicator -->
          <div id="setup-status" class="setup-status">
            <p>Setting up your account...</p>
          </div>

          <!-- Revenue reminder -->
          <div class="revenue-banner">
            <div class="revenue-amount">$60M+</div>
            <div class="revenue-text">
              Join providers who've already benefited from our proven model
            </div>
          </div>

          <div class="action-buttons">
            <a
              href="/providers/pre-portal"
              class="primary-button"
              id="accessPortalButton"
            >
              <span class="button-text">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                  <polyline points="10 17 15 12 10 7"></polyline>
                  <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                Access Provider Portal
              </span>
            </a>
            <a href="/providers" class="secondary-button">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M19 12H5M12 19l-7-7 7-7"></path>
              </svg>
              Learn More About USRad
            </a>
          </div>

          <div class="network-features">
            <h3 class="features-title">Your Next Steps</h3>
            <div class="features-grid">
              <div class="feature-item">
                <div class="feature-icon">🏥</div>
                <div class="feature-text">Register Centers</div>
              </div>
              <div class="feature-item">
                <div class="feature-icon">📄</div>
                <div class="feature-text">Review PSA</div>
              </div>
              <div class="feature-item">
                <div class="feature-icon">✍️</div>
                <div class="feature-text">Sign Agreement</div>
              </div>
              <div class="feature-item">
                <div class="feature-icon">💰</div>
                <div class="feature-text">Start Earning</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Supabase Integration Script -->
    <!-- Add this BEFORE the module script -->
    <script
      define:vars={{
        SUPABASE_URL: import.meta.env.PUBLIC_SUPABASE_URL,
        SUPABASE_KEY: import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
      }}
    >
      // Make env vars available globally
      window.PUBLIC_SUPABASE_URL = SUPABASE_URL;
      window.PUBLIC_SUPABASE_ANON_KEY = SUPABASE_KEY;
    </script>

    <script type="module">
      import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm";

      // Initialize Supabase and seed corporate entity after verification
      async function initializeVerifiedUser() {
        console.log("🎉 Email verified, initializing...");

        // Get Supabase credentials
        const supabaseUrl =
          import.meta.env?.PUBLIC_SUPABASE_URL || window.PUBLIC_SUPABASE_URL;
        const supabaseAnonKey =
          import.meta.env?.PUBLIC_SUPABASE_ANON_KEY ||
          window.PUBLIC_SUPABASE_ANON_KEY;

        const statusDiv = document.getElementById("setup-status");

        if (!supabaseUrl || !supabaseAnonKey) {
          console.error("Missing Supabase configuration");
          statusDiv.classList.add("visible", "error");
          statusDiv.innerHTML =
            "<p>⚠️ Configuration issue - you can complete setup in the next step</p>";
          return;
        }

        try {
          const supabase = createClient(supabaseUrl, supabaseAnonKey);

          // Check if we have a token to verify
          const params = new URLSearchParams(window.location.search);
          const token_hash = params.get("token_hash");
          const type = params.get("type");

          if (token_hash && type) {
            // Verify the token first
            const { data, error } = await supabase.auth.verifyOtp({
              token_hash,
              type: type,
            });

            if (error) {
              console.error("Token verification failed:", error);
              // Handle error - maybe redirect to login
            } else {
              console.log("✅ Email verified via token");
              // Continue with seeding organization
            }
          }

          // Get the current user
          const {
            data: { user },
            error,
          } = await supabase.auth.getUser();

          if (error || !user) {
            console.warn("⚠️ User not authenticated");
            // Don't show error, just proceed - user might be authenticated differently
            return;
          }

          console.log("✅ User authenticated:", user.email);

          // Show setup status
          statusDiv.classList.add("visible", "loading");
          statusDiv.innerHTML =
            "<p>🔄 Setting up your organization profile...</p>";

          // Get signup data from session storage or user metadata
          const orgName =
            sessionStorage.getItem("signup_org") ||
            user.user_metadata?.organization_name;
          const phone =
            sessionStorage.getItem("signup_phone") || user.user_metadata?.phone;
          const email = user.email;

          if (orgName) {
            try {
              // Check if organization already exists
              const { data: existingOrg } = await supabase
                .from("corporate_entities")
                .select("id, legal_name")
                .eq("user_id", user.id)
                .single();

              if (existingOrg) {
                console.log(
                  "✅ Organization already exists:",
                  existingOrg.legal_name
                );
                statusDiv.classList.remove("loading");
                statusDiv.classList.add("visible");
                statusDiv.innerHTML = "<p>✅ Account setup complete!</p>";
              } else {
                // Create the corporate entity
                const { data, error: seedError } = await supabase
                  .from("corporate_entities")
                  .insert({
                    user_id: user.id,
                    owner_user_id: user.id,
                    legal_name: orgName,
                    email: email,
                    phone: phone?.replace(/\D/g, ""), // Clean phone number
                    is_active: true,
                    schema_version: 1,
                  })
                  .select()
                  .single();

                if (seedError) {
                  console.error("Failed to seed organization:", seedError);
                  statusDiv.classList.remove("loading");
                  statusDiv.classList.add("visible", "error");
                  statusDiv.innerHTML =
                    "<p>⚠️ Organization setup pending - you can complete it in the next step</p>";
                } else {
                  console.log("✅ Organization created:", data);
                  statusDiv.classList.remove("loading");
                  statusDiv.classList.add("visible");
                  statusDiv.innerHTML = "<p>✅ Account setup complete!</p>";
                }
              }
            } catch (err) {
              console.error("Setup error:", err);
              statusDiv.classList.remove("loading");
              statusDiv.classList.add("visible", "error");
              statusDiv.innerHTML =
                "<p>⚠️ Setup will be completed in the next step</p>";
            }
          } else {
            // No org name in session, user will complete in pre-portal
            console.log("ℹ️ Organization info will be collected in next step");
            statusDiv.style.display = "none";
          }

          // Clear session storage
          sessionStorage.removeItem("signup_org");
          sessionStorage.removeItem("signup_phone");
          sessionStorage.removeItem("signup_email");
        } catch (err) {
          console.error("Initialization error:", err);
          statusDiv.classList.add("visible", "error");
          statusDiv.innerHTML =
            "<p>⚠️ Setup will be completed in the next step</p>";
        }
      }

      // Run initialization when DOM is ready
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeVerifiedUser);
      } else {
        initializeVerifiedUser();
      }
    </script>

    <!-- Original Interactive Scripts -->
    <script>
      // Add loading state to portal button
      document
        .getElementById("accessPortalButton")
        ?.addEventListener("click", function (e) {
          this.classList.add("loading");
        });

      // Add interactive elements
      document.addEventListener("DOMContentLoaded", function () {
        // Stagger feature item animations
        const featureItems = document.querySelectorAll(".feature-item");
        featureItems.forEach((item, index) => {
          item.style.animation = `fadeInUp 0.6s ease-out ${0.9 + index * 0.1}s both`;
        });

        // Celebration confetti
        setTimeout(() => {
          const colors = ["#667eea", "#764ba2", "#f093fb", "#10b981"];
          const confettiCount = 50;

          for (let i = 0; i < confettiCount; i++) {
            const confetti = document.createElement("div");
            confetti.className = "confetti";
            confetti.style.left = Math.random() * 100 + "%";
            confetti.style.top = "-10px";
            confetti.style.background =
              colors[Math.floor(Math.random() * colors.length)];
            confetti.style.width = Math.random() * 10 + 5 + "px";
            confetti.style.height = confetti.style.width;
            confetti.style.animationDelay = Math.random() * 0.5 + "s";
            confetti.style.animationDuration = Math.random() * 2 + 3 + "s";
            document.body.appendChild(confetti);

            setTimeout(() => confetti.remove(), 5000);
          }
        }, 500);

        // Add hover effect to success circle
        const successCircle = document.querySelector(".success-circle");
        if (successCircle) {
          successCircle.addEventListener("mouseenter", function () {
            this.style.transform = "scale(1.1)";
          });

          successCircle.addEventListener("mouseleave", function () {
            this.style.transform = "scale(1)";
          });
        }
      });
    </script>
  </body>
</html>
