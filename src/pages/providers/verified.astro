---
// Provider email verification success page
// File: /src/pages/providers/verified.astro
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verified | Welcome to USRad Provider Network</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        background: linear-gradient(
          135deg,
          #f8f2e1 0%,
          #ffffff 50%,
          #f0f9ff 100%
        );
        overflow-x: hidden;
      }

      .verification-layout {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        position: relative;
      }

      /* Animated background elements */
      .verification-layout::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image:
          radial-gradient(
            circle at 20% 20%,
            rgba(0, 48, 135, 0.03) 0%,
            transparent 50%
          ),
          radial-gradient(
            circle at 80% 80%,
            rgba(230, 195, 120, 0.05) 0%,
            transparent 50%
          ),
          radial-gradient(
            circle at 40% 60%,
            rgba(0, 48, 135, 0.02) 0%,
            transparent 50%
          );
        animation: backgroundShift 8s ease-in-out infinite;
        z-index: 0;
      }

      @keyframes backgroundShift {
        0%,
        100% {
          transform: translate(0, 0) scale(1);
        }
        33% {
          transform: translate(-20px, -10px) scale(1.02);
        }
        66% {
          transform: translate(10px, -20px) scale(0.98);
        }
      }

      .verification-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 24px;
        box-shadow:
          0 32px 64px rgba(0, 48, 135, 0.1),
          0 16px 32px rgba(0, 0, 0, 0.05),
          inset 0 1px 0 rgba(255, 255, 255, 0.4);
        padding: 3rem;
        max-width: 580px;
        width: 100%;
        text-align: center;
        position: relative;
        z-index: 1;
        animation: cardEntrance 1s ease-out;
      }

      @keyframes cardEntrance {
        from {
          opacity: 0;
          transform: translateY(30px) scale(0.95);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      .success-icon-container {
        margin-bottom: 2rem;
        position: relative;
      }

      .success-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow:
          0 8px 32px rgba(16, 185, 129, 0.3),
          0 4px 16px rgba(16, 185, 129, 0.2);
        animation: iconPulse 2s ease-in-out infinite;
        position: relative;
      }

      @keyframes iconPulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow:
            0 8px 32px rgba(16, 185, 129, 0.3),
            0 4px 16px rgba(16, 185, 129, 0.2);
        }
        50% {
          transform: scale(1.05);
          box-shadow:
            0 12px 40px rgba(16, 185, 129, 0.4),
            0 6px 20px rgba(16, 185, 129, 0.3);
        }
      }

      .success-icon::before {
        content: "";
        position: absolute;
        top: -10px;
        left: -10px;
        right: -10px;
        bottom: -10px;
        background: linear-gradient(
          135deg,
          rgba(16, 185, 129, 0.2) 0%,
          rgba(5, 150, 105, 0.1) 100%
        );
        border-radius: 50%;
        animation: ripple 3s linear infinite;
        z-index: -1;
      }

      @keyframes ripple {
        0% {
          transform: scale(1);
          opacity: 1;
        }
        100% {
          transform: scale(1.5);
          opacity: 0;
        }
      }

      .checkmark {
        color: white;
        font-size: 2rem;
        font-weight: 700;
        animation: checkmarkDraw 0.8s ease-out 0.5s both;
      }

      @keyframes checkmarkDraw {
        from {
          transform: scale(0) rotate(-45deg);
          opacity: 0;
        }
        to {
          transform: scale(1) rotate(0deg);
          opacity: 1;
        }
      }

      .verification-content h1 {
        font-size: 2.25rem;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
        animation: slideUp 0.8s ease-out 0.3s both;
      }

      .verification-content p.subtitle {
        font-size: 1.2rem;
        color: #64748b;
        margin-bottom: 2rem;
        line-height: 1.6;
        animation: slideUp 0.8s ease-out 0.4s both;
      }

      .verification-content p.description {
        font-size: 1rem;
        color: #64748b;
        margin-bottom: 2.5rem;
        line-height: 1.6;
        animation: slideUp 0.8s ease-out 0.5s both;
      }

      @keyframes slideUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        animation: slideUp 0.8s ease-out 0.6s both;
      }

      .primary-button {
        background: linear-gradient(135deg, #003087 0%, #002268 100%);
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        box-shadow: 0 4px 16px rgba(0, 48, 135, 0.2);
        position: relative;
        overflow: hidden;
      }

      .primary-button::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.2),
          transparent
        );
        transition: left 0.5s ease;
      }

      .primary-button:hover::before {
        left: 100%;
      }

      .primary-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 48, 135, 0.3);
      }

      .primary-button:active {
        transform: translateY(0);
      }

      .secondary-button {
        background: transparent;
        color: #64748b;
        border: 1.5px solid #e2e8f0;
        padding: 0.875rem 2rem;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
      }

      .secondary-button:hover {
        border-color: #003087;
        color: #003087;
        background: rgba(0, 48, 135, 0.05);
      }

      .welcome-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(
          135deg,
          rgba(230, 195, 120, 0.1) 0%,
          rgba(230, 195, 120, 0.05) 100%
        );
        border: 1px solid rgba(230, 195, 120, 0.3);
        color: #92400e;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 1.5rem;
        animation: slideUp 0.8s ease-out 0.2s both;
      }

      .revenue-highlight {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        border-radius: 16px;
        padding: 1.5rem;
        margin: 2rem 0;
        animation: slideUp 0.8s ease-out 0.55s both;
      }

      .revenue-amount {
        font-size: 2rem;
        font-weight: 700;
        color: #92400e;
        margin-bottom: 0.25rem;
      }

      .revenue-text {
        color: #78350f;
        font-weight: 500;
      }

      .network-features {
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(0, 48, 135, 0.1);
        animation: slideUp 0.8s ease-out 0.7s both;
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
      }

      .feature-item {
        text-align: center;
        padding: 1rem;
        background: rgba(0, 48, 135, 0.02);
        border-radius: 12px;
        border: 1px solid rgba(0, 48, 135, 0.05);
        transition: all 0.3s ease;
      }

      .feature-item:hover {
        background: rgba(0, 48, 135, 0.05);
        transform: translateY(-2px);
      }

      .feature-icon {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
      }

      .feature-text {
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 500;
      }

      /* Mobile adjustments */
      @media (max-width: 768px) {
        body {
          min-height: 100dvh; /* Dynamic viewport height */
        }

        .verification-layout {
          padding: 1rem;
          min-height: 100dvh;
        }

        .verification-card {
          padding: 2rem 1.5rem;
          border-radius: 20px;
        }

        .verification-content h1 {
          font-size: 1.75rem;
        }

        .verification-content p.subtitle {
          font-size: 1.1rem;
        }

        .verification-content p.description {
          font-size: 0.95rem;
        }

        .success-icon {
          width: 70px;
          height: 70px;
        }

        .features-grid {
          grid-template-columns: repeat(2, 1fr); /* 2 columns on mobile */
          gap: 0.75rem;
        }

        .feature-item {
          padding: 0.875rem;
        }

        .action-buttons {
          gap: 0.875rem;
        }

        .primary-button,
        .secondary-button {
          padding: 1.125rem 1.5rem; /* Larger touch targets */
          font-size: 1rem;
        }

        .revenue-amount {
          font-size: 1.75rem;
        }

        .revenue-highlight {
          padding: 1.25rem;
        }

        /* Ensure no zoom on iOS */
        input,
        button,
        select,
        textarea {
          font-size: 16px;
          -webkit-text-size-adjust: 100%;
        }
      }

      @media (max-width: 480px) {
        .features-grid {
          grid-template-columns: 1fr; /* Single column on very small screens */
        }

        .verification-card {
          padding: 1.75rem 1.25rem;
        }

        .verification-content h1 {
          font-size: 1.5rem;
        }
      }

      /* Loading state for button */
      .primary-button.loading {
        pointer-events: none;
        opacity: 0.8;
      }

      .primary-button.loading .button-text {
        opacity: 0;
      }

      .primary-button.loading::after {
        content: "";
        position: absolute;
        width: 20px;
        height: 20px;
        border: 2px solid transparent;
        border-top: 2px solid white;
        border-radius: 50%;
        animation: buttonSpin 1s linear infinite;
      }

      @keyframes buttonSpin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
    </style>
  </head>
  <body>
    <div class="verification-layout">
      <div class="verification-card">
        <div class="welcome-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"
            ></path>
          </svg>
          Welcome to USRad Provider Network
        </div>

        <div class="success-icon-container">
          <div class="success-icon">
            <div class="checkmark">✓</div>
          </div>
        </div>

        <div class="verification-content">
          <h1>Email Verified Successfully!</h1>
          <p class="subtitle">Your provider account is now active</p>
          <p class="description">
            You're officially part of the USRad Provider Network. Access your
            dashboard to complete onboarding, register your imaging centers, and
            start receiving guaranteed-payment patients.
          </p>

          <!-- Revenue reminder -->
          <div class="revenue-highlight">
            <div class="revenue-amount">$180+ Million</div>
            <div class="revenue-text">
              Join providers who've already benefited from our proven model
            </div>
          </div>

          <div class="action-buttons">
            <a
              href="/providers/portal"
              class="primary-button"
              id="accessPortalButton"
            >
              <span class="button-text">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                  <polyline points="10,17 15,12 10,7"></polyline>
                  <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                Access Provider Portal
              </span>
            </a>
            <a href="/providers" class="secondary-button">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M19 12H5M12 19l-7-7 7-7"></path>
              </svg>
              Learn More About USRad
            </a>
          </div>

          <div class="network-features">
            <h3
              style="color: #1e293b; font-size: 1.1rem; margin-bottom: 1rem; font-weight: 600;"
            >
              Your Next Steps
            </h3>
            <div class="features-grid">
              <div class="feature-item">
                <div class="feature-icon">🏥</div>
                <div class="feature-text">Register Centers</div>
              </div>
              <div class="feature-item">
                <div class="feature-icon">📄</div>
                <div class="feature-text">Review PSA</div>
              </div>
              <div class="feature-item">
                <div class="feature-icon">✍️</div>
                <div class="feature-text">Sign Agreement</div>
              </div>
              <div class="feature-item">
                <div class="feature-icon">💰</div>
                <div class="feature-text">Start Earning</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Add loading state to portal button
      document
        .getElementById("accessPortalButton")
        .addEventListener("click", function (e) {
          this.classList.add("loading");
        });

      // Add some interactive polish
      document.addEventListener("DOMContentLoaded", function () {
        // Stagger feature item animations
        const featureItems = document.querySelectorAll(".feature-item");
        featureItems.forEach((item, index) => {
          item.style.animation = `slideUp 0.6s ease-out ${0.8 + index * 0.1}s both`;
        });

        // Add particle effect on success icon hover
        const successIcon = document.querySelector(".success-icon");
        successIcon.addEventListener("mouseenter", function () {
          this.style.transform = "scale(1.1)";
          this.style.transition = "transform 0.3s ease";
        });

        successIcon.addEventListener("mouseleave", function () {
          this.style.transform = "scale(1)";
        });

        // Celebrate with confetti (optional - you can remove if too much)
        setTimeout(() => {
          // Simple confetti effect
          const colors = ["#003087", "#cc9933", "#10b981", "#667eea"];
          for (let i = 0; i < 30; i++) {
            const confetti = document.createElement("div");
            confetti.style.position = "fixed";
            confetti.style.width = "10px";
            confetti.style.height = "10px";
            confetti.style.background =
              colors[Math.floor(Math.random() * colors.length)];
            confetti.style.left = Math.random() * 100 + "%";
            confetti.style.top = "-10px";
            confetti.style.opacity = "0.8";
            confetti.style.transform = `rotate(${Math.random() * 360}deg)`;
            confetti.style.transition = "all 3s ease-out";
            confetti.style.pointerEvents = "none";
            confetti.style.zIndex = "1000";
            document.body.appendChild(confetti);

            setTimeout(() => {
              confetti.style.top = "100%";
              confetti.style.opacity = "0";
              confetti.style.transform = `rotate(${Math.random() * 720}deg) translateX(${Math.random() * 200 - 100}px)`;
            }, 100);

            setTimeout(() => {
              confetti.remove();
            }, 3100);
          }
        }, 500);
      });
    </script>
  </body>
</html>
