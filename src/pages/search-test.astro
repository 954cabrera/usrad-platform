        align-items: center;
        gap: 6px;
      }

      .action {
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 0.5px;
      }

      .savings {
        font-size: 28px;
        font-weight: 900;
        color: #fef3c7;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        line-height: 1;
      }

      .btn-subtitle {
        font-size: 13px;
        opacity: 0.95;
