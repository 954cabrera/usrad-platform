            closeModal();
          }
        });

        // Add keyboard support (Escape key)
        document.addEventListener("keydown", function escapeHandler(e) {
          if (e.key === "Escape") {
            closeModal();
            document.removeEventListener("keydown", escapeHandler);
          }
        });
      }

      function proceedToBooking() {
        closeModal();

        if (selectedProvider && selectedProvider.data) {
          alert(
            `Proceeding to booking for ${selectedProvider.data.name}...\nSavings: $${Math.round(selectedProvider.data.pricing.patient_savings)}\nPrice: $${selectedProvider.data.pricing.patient_price.toFixed(2)}`
          );
          // Replace with actual navigation when ready:
          // window.location.href = `/booking/${selectedProvider.id}`;
        }
      }

      function closeModal() {
        const modal = document.querySelector(".selection-modal");
        if (modal) {
          modal.remove();
        }
      }

      // Enhanced helper functions
      function getBorderClass(index) {
        if (index === 0) return "border-yellow-400"; // Best deal
        if (index === 1) return "border-green-400"; // Second best
        if (index === 2) return "border-blue-400"; // Third best
        return "border-gray-200"; // Others
      }

      function getBadge(index) {
        if (index === 0)
          return '<span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-xs font-bold">🥇 Best Deal</span>';
        if (index === 1)
          return '<span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-xs font-bold">🥈 Great Value</span>';
        if (index === 2)
          return '<span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-xs font-bold">🥉 Good Choice</span>';
        return "";
      }

      // Add this to show success feedback
      function showSuccessFeedback(count) {
        const summary = document.getElementById("searchSummary");
        summary.style.transform = "scale(1.02)";
        summary.style.transition = "transform 0.3s ease";

        setTimeout(() => {
          summary.style.transform = "scale(1)";
        }, 300);

        // Add a subtle green glow
        summary.classList.add("ring-2", "ring-green-200");
        setTimeout(() => {
          summary.classList.remove("ring-2", "ring-green-200");
        }, 2000);
      }

      // Sorting function
      function applySorting(sortBy) {
        renderResults(allProviders, sortBy);
        // Re-add markers to maintain consistency
        addMapMarkers(allProviders);
      }

      // Price filtering function
      function applyPriceFilter(range) {
        let filteredProviders = [...allProviders];
        switch (range) {
          case "under_300":
            filteredProviders = allProviders.filter(
              (p) => p.pricing.patient_price < 300
            );
            break;
          case "300_400":
            filteredProviders = allProviders.filter(
              (p) =>
                p.pricing.patient_price >= 300 && p.pricing.patient_price <= 400
            );
            break;
          case "over_400":
            filteredProviders = allProviders.filter(
              (p) => p.pricing.patient_price > 400
            );
            break;
          default:
            filteredProviders = allProviders;
        }

        renderResults(
          filteredProviders,
          document.getElementById("sortBy").value
        );
        addMapMarkers(filteredProviders);
      }

      // Error state display
      function showErrorState(message) {
        const container = document.getElementById("providerResults");
        container.innerHTML = `
  <div class="text-center py-12 bg-gradient-to-br from-red-50 to-orange-50 rounded-lg border border-red-200">
    <div class="text-red-400 mb-4 animate-pulse">
      <svg class="w-16 h-16 mx-auto" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
      </svg>
    </div>
    <h3 class="text-lg font-medium text-gray-900 mb-2">Oops! Something went wrong</h3>
    <p class="text-gray-500 mb-4">${message}</p>
    <button onclick="searchProviders()" class="bg-gradient-to-r from-blue-600 to-blue-700 text-white px-6 py-3 rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all duration-200 transform hover:scale-105 shadow-lg">
      🔄 Try Again
    </button>
  </div>
  `;
      }
      // Event listeners setup
      document.addEventListener("DOMContentLoaded", function () {
        console.log("🔍 DOM loaded, setting up event listeners...");

        // FIRST: Set up form validation prevention
        const zipCodeInput = document.getElementById("zipCode");
        if (zipCodeInput) {
          zipCodeInput.removeAttribute("required"); // Remove if present
          zipCodeInput.value = ""; // Ensure empty on page load
          zipCodeInput.setAttribute("autocomplete", "off");

          // Add Enter key support for ZIP code
          zipCodeInput.addEventListener("keypress", function (e) {
            if (e.key === "Enter") {
              e.preventDefault();
              console.log("⏎ Enter key pressed in ZIP field");
              searchProviders(true); // Show validation for manual searches
            }
          });
        }

        // SECOND: Set up search button
        const searchBtn = document.getElementById("searchBtn");
        if (searchBtn) {
          searchBtn.type = "button"; // Prevent form submission

          // Add click event listener to search button
          searchBtn.addEventListener("click", function (e) {
            e.preventDefault();
            e.stopPropagation();
            console.log("🖱️ Search button clicked via event listener");
            searchProviders(true); // Show validation for manual searches
          });
        }

        // Add event listeners for sorting and filtering
        const sortBy = document.getElementById("sortBy");
        if (sortBy) {
          sortBy.addEventListener("change", function () {
            applySorting(this.value);
          });
        }

        const priceRange = document.getElementById("priceRange");
        if (priceRange) {
          priceRange.addEventListener("change", function () {
            applyPriceFilter(this.value);
          });
        }

        // Modified auto-trigger - NO popup, only runs if ZIP exists
        setTimeout(() => {
          const zipCode = document.getElementById("zipCode").value.trim();
          if (zipCode && zipCode !== "") {
            console.log("🚀 Auto-triggering search for demo...");
            searchProviders(false); // Pass false = no popup
          } else {
            console.log("🔍 No ZIP code provided - skipping auto-search");
          }
        }, 1000);
      });

      // Debug: Check when Google Maps tries to call initMap
      console.log(
        "🚀 Script loaded - initMap defined as:",
        typeof window.initMap
      );
    </script>

    <!-- Google Maps API -->
    <script
      define:vars={{
        googleMapsApiKey: import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY,
      }}
    >
      // Now googleMapsApiKey is available in the script
      if (googleMapsApiKey) {
        const script = document.createElement("script");
        script.src = `https://maps.googleapis.com/maps/api/js?key=${googleMapsApiKey}&callback=initMap&libraries=places`;
        script.async = true;
        script.defer = true;
        document.head.appendChild(script);
      } else {
        console.error("Google Maps API key not found in environment variables");
      }
    </script>
    <script>
      window.addEventListener("load", function () {
        const zipInput = document.getElementById("zipCode");
        const procedureSelect = document.getElementById("procedure");
        const resultsContainer = document.getElementById("results");

        if (zipInput) {
          zipInput.value = "";
          zipInput.setAttribute("autocomplete", "off");
        }

        if (procedureSelect) {
          procedureSelect.selectedIndex = 0;
        }

        if (resultsContainer) {
          resultsContainer.innerHTML = "";
          resultsContainer.style.display = "none";
        }

        console.log("✅ Form reset - clean slate for new visitor");
      });

      document.addEventListener("visibilitychange", function () {
        if (!document.hidden) {
          const zipInput = document.getElementById("zipCode");
          if (zipInput && zipInput.value === "33330") {
            zipInput.value = "";
            console.log("✅ Cleared cached ZIP code");
          }
        }
      });
    </script>
  </div>
</MainPatientLayout>
