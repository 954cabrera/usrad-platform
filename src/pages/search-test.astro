      // Enhanced geocoding with user marker - UPDATED VERSION
      async function geocodeZipCode(zipCode) {
        if (!zipCode) return null;

        return new Promise((resolve) => {
          ensureMapReady(async () => {
            if (!window.google || !window.google.maps) {
              console.error("❌ Google Maps API not available for geocoding");
              resolve(null);
              return;
            }

            const geocoder = new google.maps.Geocoder();

            try {
              const result = await new Promise(
                (geocodeResolve, geocodeReject) => {
                  geocoder.geocode(
                    { address: zipCode + ", USA" },
                    (results, status) => {
                      if (status === "OK" && results[0]) {
                        geocodeResolve(results[0]);
                      } else {
                        geocodeReject(new Error("Geocoding failed"));
                      }
                    }
                  );
                }
              );

              const location = result.geometry.location;

              // Remove existing user marker
              if (window.userMarker) {
                window.userMarker.setMap(null);
              }

              // Make sure we have a valid map reference
              const currentMap = window.map;
              if (!currentMap) {
                console.error("❌ No valid map instance for user marker");
                resolve(null);
                return;
              }

              // Add enhanced user location marker
              window.userMarker = new google.maps.Marker({
                position: location,
                map: currentMap,
                title: `Your location: ${zipCode}`,
                icon: {
                  path: google.maps.SymbolPath.CIRCLE,
                  scale: 8,
                  fillColor: "#1D4ED8",
                  fillOpacity: 1,
                  strokeColor: "#ffffff",
                  strokeWeight: 3,
                },
              });

              // Add user location info window
              const userInfoWindow = new google.maps.InfoWindow({
                content: `
              <div style="padding: 10px; text-align: center; font-family: system-ui;">
                <div style="font-weight: 600; color: #1f2937; margin-bottom: 4px;">📍 Your Location</div>
                <div style="color: #6b7280; font-size: 13px;">${zipCode}</div>
              </div>
            `,
              });

              window.userMarker.addListener("click", () => {
                userInfoWindow.open(currentMap, window.userMarker);
              });

              // Update the global userMarker variable for backward compatibility
              if (typeof userMarker !== "undefined") {
                userMarker = window.userMarker;
              }

              console.log("✅ User location marker added successfully");
              resolve(location);
            } catch (error) {
              console.error("Geocoding error:", error);
              resolve(null);
            }
          });
        });
      }

