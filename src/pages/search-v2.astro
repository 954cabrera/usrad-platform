---
// ===========================================
// src/pages/search-v2.astro
// Enhanced search page with React islands for dynamic filtering
// ===========================================

import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ProviderList from "../components/provider/ProviderList.jsx";

const title = "USRad Provider Search Test";
const description = "Test your Medicare pricing engine with real provider data";

// Get initial search parameters from URL
const urlParams = Astro.url.searchParams;
const initialSearch = {
  zipCode: urlParams.get("zip") || "",
  state: urlParams.get("state") || "FL",
  procedure: urlParams.get("procedure") || "70551",
};
---

<MainPatientLayout title={title} description={description}>
  <div class="min-h-screen bg-gray-50">
    <!-- Header Section -->
    <div class="bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="py-6">
          <h1 class="text-2xl font-bold text-gray-900">
            USRad Provider Search Test
          </h1>
          <p class="mt-1 text-gray-600">
            Test your Medicare pricing engine with real provider data
          </p>
        </div>
      </div>
    </div>

    <!-- Main Content Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Search Form -->
      <div
        class="bg-white rounded-lg shadow-sm p-6 mb-8 border border-gray-200"
      >
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <label
              for="zipCode"
              class="block text-sm font-medium text-gray-700 mb-2"
            >
              ZIP Code
            </label>
            <input
              type="text"
              id="zipCode"
              placeholder="Try: 33012 (Miami), 33330 (Fort Lauderdale)"
              value={initialSearch.zipCode}
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900"
            />
            <p class="text-xs text-gray-500 mt-1">
              Try: 33012 (Miami), 33330 (Fort Lauderdale)
            </p>
          </div>

          <div>
            <label
              for="procedure"
              class="block text-sm font-medium text-gray-700 mb-2"
            >
              Procedure
            </label>
            <select
              id="procedure"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900"
            >
              <option value="70551" selected>MRI Brain without contrast</option>
              <option value="72148">MRI Lumbar Spine</option>
              <option value="73721">MRI Knee</option>
              <option value="74177">CT Abdomen/Pelvis</option>
            </select>
          </div>

          <div>
            <label
              for="state"
              class="block text-sm font-medium text-gray-700 mb-2"
            >
              State
            </label>
            <select
              id="state"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-900"
            >
              <option value="FL" selected>Florida</option>
              <option value="GA">Georgia</option>
            </select>
          </div>

          <div class="flex items-end">
            <button
              id="searchBtn"
              class="w-full bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-200 font-medium"
            >
              Search Providers
            </button>
          </div>
        </div>
      </div>

      <!-- Loading State -->
      <div id="loadingState" class="hidden">
        <div
          class="bg-white rounded-lg shadow-sm p-8 mb-8 text-center border border-gray-200"
        >
          <div class="inline-flex items-center">
            <div
              class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mr-3"
            >
            </div>
            <span class="text-lg text-gray-700 font-medium">
              🔍 Searching providers<span class="loading-dots"></span>
            </span>
          </div>
          <p class="text-sm text-gray-500 mt-2">
            Analyzing Medicare rates across our network of 1,500+ centers
          </p>
        </div>
      </div>

      <!-- Results Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Provider Results (Left 2/3) -->
        <div class="lg:col-span-2">
          <div id="resultsContainer" class="hidden">
            <!-- React Island for Provider List with Real-time Filtering -->
            <ProviderList
              client:visible
              initialResults={[]}
              searchCriteria={initialSearch}
              onProviderSelect="handleProviderSelection"
            />
          </div>

          <!-- Error State -->
          <div id="errorState" class="hidden">
            <div
              class="bg-red-50 border border-red-200 rounded-lg p-6 text-center"
            >
              <div class="text-red-600 mb-2">
                <span class="text-2xl mr-2">❌</span>
                <span id="errorMessage">An error occurred</span>
              </div>
              <button
                onclick="retrySearch()"
                class="mt-4 bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 transition-colors"
              >
                Try Again
              </button>
            </div>
          </div>
        </div>

        <!-- Map (Right 1/3) -->
        <div class="lg:col-span-1">
          <div
            class="bg-white rounded-lg shadow-sm overflow-hidden sticky top-4 border border-gray-200"
          >
            <div class="p-4 bg-gray-50 border-b">
              <h3 class="text-lg font-semibold text-gray-900">
                Provider Locations
              </h3>
              <p id="mapStatus" class="text-sm text-gray-600">
                10 centers found • 76% avg savings
              </p>
            </div>
            <div id="map" class="h-96 bg-gray-100 relative">
              <!-- Map will be initialized here -->
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="text-gray-400 text-center">
                  <svg
                    class="w-16 h-16 mx-auto mb-2"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fillRule="evenodd"
                      d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                      clipRule="evenodd"></path>
                  </svg>
                  <p class="text-sm">Map will load after search</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Selection Modal -->
    <div id="selectionModal" class="modal-overlay hidden">
      <div class="modal-content">
        <h3 id="modalTitle">Confirm Provider Selection</h3>
        <p id="modalMessage">Ready to book your appointment?</p>
        <div id="modalProviderInfo" class="my-4 p-4 bg-gray-50 rounded-lg">
        </div>

        <div class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg">
          <p class="text-sm text-blue-700 mb-2">
            <strong>🧪 Test Mode:</strong> This modal confirms provider selection
          </p>
          <button
            id="testCloseModal"
            class="bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600 text-sm"
          >
            ❌ Close Modal (Testing)
          </button>
        </div>

        <div class="modal-actions">
          <button
            id="confirmSelection"
            class="bg-green-600 text-white px-6 py-2 rounded-md hover:bg-green-700"
          >
            📅 Book Appointment
          </button>
          <button
            id="cancelSelection"
            class="bg-gray-300 text-gray-700 px-6 py-2 rounded-md hover:bg-gray-400"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Enhanced CSS -->
  <style>
    /* Form input visibility fixes */
    input[type="text"],
    select {
      color: #374151 !important;
      background-color: white !important;
      border: 1px solid #d1d5db !important;
    }

    input[type="text"]:focus,
    select:focus {
      color: #111827 !important;
      border-color: #3b82f6 !important;
      background-color: white !important;
    }

    input[type="text"]::placeholder {
      color: #9ca3af !important;
      opacity: 1 !important;
    }

    select option {
      color: #374151 !important;
      background-color: white !important;
    }

    /* Loading dots animation */
    .loading-dots::after {
      content: "";
      animation: loading-dots 1.5s infinite;
    }

    @keyframes loading-dots {
      0%,
      20% {
        content: "";
      }
      40% {
        content: ".";
      }
      60% {
        content: "..";
      }
      80%,
      100% {
        content: "...";
      }
    }

    /* Enhanced provider card hover effects */
    .provider-card {
      transition: all 0.3s ease;
    }

    .provider-card:hover {
      transform: translateY(-2px);
      box-shadow:
        0 20px 25px -5px rgba(0, 0, 0, 0.1),
        0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    /* Modal styles */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      backdrop-filter: blur(4px);
    }

    .modal-content {
      background: white;
      padding: 32px;
      border-radius: 16px;
      max-width: 400px;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .modal-content h3 {
      color: #059669;
      font-size: 1.5rem;
      margin-bottom: 16px;
    }

    .modal-actions {
      display: flex;
      gap: 12px;
      margin-top: 24px;
    }

    .modal-actions button {
      flex: 1;
      padding: 12px 16px;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.2s ease;
    }

    /* Responsive design */
    @media (max-width: 768px) {
      .grid.grid-cols-1.md\\:grid-cols-4 {
        grid-template-columns: 1fr;
      }

      .lg\\:col-span-2,
      .lg\\:col-span-1 {
        grid-column: span 1;
      }
    }
  </style>

  <!-- Enhanced JavaScript Controller -->
  <script define:vars={{ initialSearch }}>
    class EnhancedSearchController {
      constructor() {
        this.currentResults = [];
        this.currentSearch = initialSearch;
        this.init();
      }

      async init() {
        this.setupEventHandlers();
        this.setupModalHandlers();

        // Auto-search if we have initial parameters
        if (initialSearch.zipCode) {
          setTimeout(() => this.handleSearch(), 500);
        }

        console.log("✅ Enhanced Search Controller initialized");
      }

      setupEventHandlers() {
        // Search button
        document
          .getElementById("searchBtn")
          ?.addEventListener("click", () => this.handleSearch());

        // Enter key on ZIP code
        document
          .getElementById("zipCode")
          ?.addEventListener("keypress", (e) => {
            if (e.key === "Enter") this.handleSearch();
          });
      }

      setupModalHandlers() {
        const confirmBtn = document.getElementById("confirmSelection");
        const cancelBtn = document.getElementById("cancelSelection");
        const testCloseBtn = document.getElementById("testCloseModal");
        const modal = document.getElementById("selectionModal");

        if (confirmBtn) {
          confirmBtn.onclick = () => this.confirmSelection();
        }

        if (cancelBtn) {
          cancelBtn.onclick = () => this.hideModal();
        }

        if (testCloseBtn) {
          testCloseBtn.onclick = () => this.hideModal();
        }

        if (modal) {
          modal.onclick = (e) => {
            if (e.target === modal) this.hideModal();
          };
        }

        // ESC key to close modal
        document.addEventListener("keydown", (e) => {
          if (
            e.key === "Escape" &&
            modal &&
            !modal.classList.contains("hidden")
          ) {
            this.hideModal();
          }
        });
      }

      async handleSearch() {
        try {
          const zipCode = document.getElementById("zipCode")?.value?.trim();
          const state = document.getElementById("state")?.value;
          const procedure = document.getElementById("procedure")?.value;

          console.log("🔍 Enhanced search initiated:", {
            zipCode,
            state,
            procedure,
          });

          if (!zipCode) {
            alert("Please enter a ZIP code");
            return;
          }

          this.currentSearch = { zipCode, state, procedure };

          // Notify React component that search is starting
          this.dispatchSearchEvent("searchStarted", {
            searchCriteria: this.currentSearch,
          });

          this.showLoading();

          // API call with enhanced error handling
          const apiUrl = `/api/centers/search-with-pricing?state=${encodeURIComponent(state)}&cptCode=${encodeURIComponent(procedure)}${zipCode ? `&zip=${encodeURIComponent(zipCode)}` : ""}`;

          console.log("📡 API URL:", apiUrl);

          const response = await fetch(apiUrl);

          if (!response.ok) {
            throw new Error(
              `API returned ${response.status}: ${response.statusText}`
            );
          }

          const data = await response.json();

          console.log("📋 API Response:", data);

          if (data.error) {
            throw new Error(data.error);
          }

          if (!data.results || data.results.length === 0) {
            this.showNoResults();
            return;
          }

          // Pass results to React component
          this.displayResults(data);
          this.updateURL();
        } catch (error) {
          console.error("❌ Search failed:", error);
          this.dispatchSearchEvent("searchError", { error: error.message });
          this.showError(`Search failed: ${error.message}`);
        }
      }

      dispatchSearchEvent(eventName, data) {
        const event = new CustomEvent(eventName, { detail: data });
        window.dispatchEvent(event);
        console.log(`📡 Dispatched ${eventName}:`, data);
      }

      showLoading() {
        document.getElementById("loadingState")?.classList.remove("hidden");
        document.getElementById("resultsContainer")?.classList.add("hidden");
        document.getElementById("errorState")?.classList.add("hidden");
      }

      displayResults(data) {
        this.currentResults = data.results || [];

        // Hide loading, show results
        document.getElementById("loadingState")?.classList.add("hidden");
        document.getElementById("resultsContainer")?.classList.remove("hidden");
        document.getElementById("errorState")?.classList.add("hidden");

        // Send results to React component
        this.dispatchSearchEvent("updateProviderResults", {
          results: data.results,
          searchCriteria: this.currentSearch,
          summary: {
            totalResults: data.results.length,
            averageSavings: Math.round(
              data.results.reduce(
                (sum, p) => sum + (p.pricing?.patient_savings || 0),
                0
              ) / data.results.length
            ),
            averagePrice: Math.round(
              data.results.reduce(
                (sum, p) => sum + (p.pricing?.patient_price || 0),
                0
              ) / data.results.length
            ),
          },
        });

        // Update map status
        const mapStatus = document.getElementById("mapStatus");
        if (mapStatus) {
          const avgSavings = Math.round(
            this.currentResults.reduce(
              (sum, p) => sum + (p.pricing?.savings_percentage || 0),
              0
            ) / this.currentResults.length
          );
          mapStatus.textContent = `${this.currentResults.length} centers found • ${avgSavings}% avg savings`;
        }

        console.log(
          "✅ Enhanced search results displayed:",
          this.currentResults.length,
          "providers"
        );
      }

      showNoResults() {
        document.getElementById("loadingState")?.classList.add("hidden");
        document.getElementById("resultsContainer")?.classList.add("hidden");
        document.getElementById("errorState")?.classList.add("hidden");

        this.dispatchSearchEvent("updateProviderResults", {
          results: [],
          searchCriteria: this.currentSearch,
          summary: { totalResults: 0, averageSavings: 0, averagePrice: 0 },
        });

        console.log("ℹ️ No results found");
      }

      showError(message) {
        document.getElementById("loadingState")?.classList.add("hidden");
        document.getElementById("resultsContainer")?.classList.add("hidden");
        document.getElementById("errorState")?.classList.remove("hidden");

        const errorMessage = document.getElementById("errorMessage");
        if (errorMessage) {
          errorMessage.textContent = message;
        }
      }

      updateURL() {
        const url = new URL(window.location);
        url.searchParams.set("zip", this.currentSearch.zipCode);
        url.searchParams.set("state", this.currentSearch.state);
        url.searchParams.set("procedure", this.currentSearch.procedure);
        window.history.pushState({}, "", url);
      }

      hideModal() {
        const modal = document.getElementById("selectionModal");
        if (modal) {
          modal.classList.add("hidden");
          modal.style.display = "none"; // Force hide
          console.log("✅ Modal closed");
        }
      }

      confirmSelection() {
        this.hideModal();
        alert(
          "🎉 Booking confirmed! In production, this would redirect to the booking flow."
        );
        console.log("✅ Selection confirmed");
      }
    }

    // Global functions
    window.handleProviderSelection = function (provider, index) {
      const modal = document.getElementById("selectionModal");
      const modalTitle = document.getElementById("modalTitle");
      const modalMessage = document.getElementById("modalMessage");
      const modalInfo = document.getElementById("modalProviderInfo");

      if (modal && modalTitle && modalMessage && modalInfo) {
        modalTitle.textContent = `Book at ${provider.facility_name || provider.name}`;
        modalMessage.textContent = `Save ${Math.round(provider.pricing?.savings_percentage || 0)}% vs hospital pricing!`;
        modalInfo.innerHTML = `
          <div class="text-left">
            <p><strong>Price:</strong> ${(provider.pricing?.patient_price || 0).toFixed(2)}</p>
            <p><strong>Location:</strong> ${provider.city}, ${provider.state}</p>
            <p><strong>Savings:</strong> ${Math.round(provider.pricing?.patient_savings || 0)}</p>
          </div>
        `;

        modal.classList.remove("hidden");
        modal.style.display = "flex"; // Ensure it shows
      }
    };

    window.retrySearch = function () {
      if (window.searchController) {
        window.searchController.handleSearch();
      }
    };

    // Force close modal function for debugging
    window.forceCloseModal = function () {
      const modal = document.getElementById("selectionModal");
      if (modal) {
        modal.classList.add("hidden");
        modal.style.display = "none";
        console.log("🔧 Force closed modal");
      }
    };

    // Initialize controller
    document.addEventListener("DOMContentLoaded", function () {
      window.searchController = new EnhancedSearchController();
    });
  </script>

  <!-- Google Maps API (placeholder) -->
  <script
    async
    defer
    src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&callback=initMap"
  ></script>
</MainPatientLayout>
