---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

const REMIX_URL = import.meta.env.PUBLIC_REMIX_URL || "https://app.usrad.com";

export const prerender = true;
---

<CarbonLayout title="SMS Messaging Terms - USRad" isHeroPage={false}>
  <AOSInit />

  <!-- Clean Hero Section -->
  <section
    class="relative bg-gradient-to-b from-blue-50 to-white py-24 overflow-hidden"
  >
    <!-- Dot pattern background -->
    <div class="absolute inset-0 opacity-[0.15]">
      <div
        class="absolute inset-0"
        style="background-image: radial-gradient(circle at 1px 1px, #003087 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl" data-aos="fade-up">
        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 mb-6"
        >
          USRad SMS Messaging Terms
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 mb-8">
          Terms governing text message communications from USRad about your
          medical imaging appointments.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Effective Date -->
      <div class="text-center mb-16" data-aos="fade-up">
        <p class="text-gray-600">Effective Date</p>
        <p class="text-2xl font-bold text-gray-900">April 22, 2026</p>
        <p class="text-sm text-gray-500 mt-1">Last Updated: April 22, 2026</p>
      </div>

      <!-- Program Description -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Program Description
        </h2>
        <p class="text-gray-600">
          USRad operates an SMS messaging program to communicate with members
          about their medical imaging appointments booked through our platform.
          By providing your mobile number and opting in, you agree to receive
          text messages from USRad at the number you provided.
        </p>
      </div>

      <!-- Message Types -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Message Types</h2>
        <p class="text-gray-600 mb-6">
          Messages you may receive include:
        </p>
        <div class="bg-gray-50 rounded-xl p-8">
          <div class="space-y-3 text-gray-600">
            <p>• Appointment confirmations</p>
            <p>• Appointment reminders</p>
            <p>• Scheduling changes and cancellations</p>
            <p>• Booking status updates</p>
            <p>• Payment confirmations</p>
            <p>
              • Other account or service-related communications regarding
              imaging services you have booked or requested through USRad
            </p>
          </div>
        </div>
      </div>

      <!-- Message Frequency -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Message Frequency
        </h2>
        <p class="text-gray-600">
          Message frequency varies based on your activity with USRad. You may
          receive messages as often as daily around the time of a scheduled
          appointment, or less frequently during periods without active
          bookings.
        </p>
      </div>

      <!-- Costs -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Costs</h2>
        <p class="text-gray-600">
          Message and data rates may apply according to your mobile carrier
          plan. USRad does not charge for SMS messages, but your carrier may.
        </p>
      </div>

      <!-- Consent Not Required -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Consent Is Not a Condition of Service
        </h2>
        <div class="bg-[#003087] text-white rounded-xl p-8">
          <div class="flex items-start gap-4">
            <svg
              class="w-8 h-8 text-[#cc9933] flex-shrink-0 mt-1"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                clip-rule="evenodd"></path>
            </svg>
            <div>
              <h3 class="text-xl font-semibold mb-2">Important</h3>
              <p class="text-white/90">
                You are not required to consent to SMS messaging to use USRad's
                services. If you do not opt in, USRad will communicate with you
                through other channels such as email or phone.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- How to Opt Out -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">How to Opt Out</h2>
        <p class="text-gray-600">
          Reply <strong>STOP</strong> to any USRad text message to unsubscribe.
          After you reply STOP, you will receive a single confirmation message
          and will not receive further SMS messages from USRad. You may opt back
          in at any time by replying <strong>START</strong> or by updating your
          preferences in your USRad account.
        </p>
      </div>

      <!-- How to Get Help -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">How to Get Help</h2>
        <p class="text-gray-600">
          Reply <strong>HELP</strong> to any USRad text message for assistance,
          or contact USRad support at
          <a
            href="mailto:support@usrad.com"
            class="text-[#003087] hover:text-[#002266] font-medium"
            >support@usrad.com</a
          >
          or
          <a
            href="tel:1-866-877-2324"
            class="text-[#003087] hover:text-[#002266] font-medium"
            >1-866-USRad-24</a
          >.
        </p>
      </div>

      <!-- Supported Carriers -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Supported Carriers
        </h2>
        <p class="text-gray-600">
          USRad's SMS program is compatible with major U.S. wireless carriers
          including AT&T, T-Mobile, Verizon, and US Cellular. Carriers are not
          liable for delayed or undelivered messages.
        </p>
      </div>

      <!-- Privacy -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Privacy</h2>
        <p class="text-gray-600 mb-4">
          USRad handles information collected through SMS in accordance with our
          <a
            href="/privacy"
            class="text-[#003087] hover:text-[#002266] font-medium"
            >Privacy Policy</a
          >. Protected Health Information is handled in accordance with HIPAA
          and USRad's Notice of Privacy Practices.
        </p>
      </div>

      <!-- Changes -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Changes to These Terms
        </h2>
        <p class="text-gray-600">
          USRad may update these SMS Terms from time to time. Material changes
          will be communicated through the USRad website or directly to enrolled
          members. Continued participation after changes take effect constitutes
          acceptance of the updated terms.
        </p>
      </div>

      <!-- Contact -->
      <div
        class="mt-20 text-center py-16 border-t border-gray-200"
        data-aos="fade-up"
      >
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Questions About SMS Terms?
        </h2>
        <p class="text-xl text-gray-600 mb-8">
          We're here to help clarify anything.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="mailto:support@usrad.com"
            class="inline-flex items-center gap-2 text-[#003087] hover:text-[#002266] font-medium text-lg transition"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            support@usrad.com
          </a>
          <span class="text-gray-400 hidden sm:inline">&bull;</span>
          <a
            href="tel:1-866-877-2324"
            class="inline-flex items-center gap-2 text-[#003087] hover:text-[#002266] font-medium text-lg transition"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            1-866-USRad-24
          </a>
        </div>

        <p class="mt-8 text-gray-500 text-sm">
          U.S. Radiology of Florida LLC &middot; support@usrad.com &middot;
          1-866-USRad-24 &middot;
          <a
            href="https://usrad.com"
            class="text-[#003087] hover:text-[#002266]">usrad.com</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- Simple CTA -->
  <section class="py-16 px-4 sm:px-6 bg-[#003087] text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Save on Medical Imaging?</h2>
      <p class="text-xl mb-8 text-white/80">
        Start your journey to affordable healthcare.
      </p>
      <a
        href={`${REMIX_URL}/pbs/search`}
        class="bg-white text-[#003087] px-8 py-3 rounded-lg font-medium hover:bg-gray-100 transition inline-block"
      >
        Find Imaging Centers
      </a>
    </div>
  </section>

  <style>
    /* Clean, minimal styles */
    .prose a {
      text-decoration: none;
    }

    .prose a:hover {
      text-decoration: underline;
    }
  </style>
</CarbonLayout>
