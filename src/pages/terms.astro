---
import CarbonLayout from "../layouts/CarbonLayout.astro";
import AOSInit from "../components/AOSInit.astro";

export const prerender = true;
---

<CarbonLayout title="Terms of Service - USRad" isHeroPage={false}>
  <AOSInit />

  <!-- Clean Hero Section -->
  <section
    class="relative bg-gradient-to-b from-blue-50 to-white py-24 overflow-hidden"
  >
    <!-- Wave pattern background -->
    <div class="absolute inset-0 opacity-10">
      <svg
        class="absolute bottom-0 w-full h-48"
        preserveAspectRatio="none"
        viewBox="0 0 1440 48"
      >
        <path
          fill="#003087"
          d="M0,32L80,37.3C160,43,320,53,480,48C640,43,800,21,960,16C1120,11,1280,21,1360,26.7L1440,32L1440,48L1360,48C1280,48,1120,48,960,48C800,48,640,48,480,48C320,48,160,48,80,48L0,48Z"
        ></path>
      </svg>
    </div>
    <div
      class="absolute inset-0"
      style="background-image: url('data:image/svg+xml,%3Csvg width="
      60"
      height="60"
      viewBox="0 0 60 60"
      xmlns="http://www.w3.org/2000/svg"
      %3E%3Cg
      fill="none"
      fill-rule="evenodd"
      %3E%3Cg
      fill="%23003087"
      fill-opacity="0.03"
      %3E%3Cpath
      d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"
      %3E%3C
      g%3E%3C
      g%3E%3C
      svg%3E');
      background-size:
      30px
      30px;"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl" data-aos="fade-up">
        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 mb-6"
        >
          Terms of Service
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 mb-8">
          Please read these terms carefully before using USRad's services.
        </p>
        <div class="text-sm text-gray-500">Effective Date: January 2025</div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Effective Date -->
      <div class="text-center mb-16" data-aos="fade-up">
        <p class="text-gray-600">Effective Date</p>
        <p class="text-2xl font-bold text-gray-900">May 13, 2025</p>
        <p class="text-sm text-gray-500 mt-1">Last Updated: December 2024</p>
      </div>

      <!-- Introduction -->
      <div class="prose prose-lg max-w-none mb-20" data-aos="fade-up">
        <p class="text-xl text-gray-700 leading-relaxed">
          These Terms of Service ("Terms") govern your use of the USRad website
          at
          <a
            href="https://usrad.com"
            class="text-[#003087] hover:text-[#002266] font-medium">usrad.com</a
          >. By using our site, you agree to these terms.
        </p>
      </div>

      <!-- Section 1: Using Our Site -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Using Our Site</h2>

        <div class="prose prose-lg max-w-none text-gray-600 mb-8">
          <p>
            Our site helps you find and book affordable medical imaging. Here's
            what you need to know:
          </p>
        </div>

        <div class="space-y-8">
          <!-- Acceptable Use -->
          <div>
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              Acceptable Use
            </h3>
            <div class="grid md:grid-cols-2 gap-x-12 gap-y-4">
              <div class="flex items-start gap-3">
                <div
                  class="w-1 h-6 bg-[#003087] rounded-full flex-shrink-0 mt-0.5"
                >
                </div>
                <p class="text-gray-700">Search and compare imaging centers</p>
              </div>
              <div class="flex items-start gap-3">
                <div
                  class="w-1 h-6 bg-[#003087] rounded-full flex-shrink-0 mt-0.5"
                >
                </div>
                <p class="text-gray-700">Book appointments online</p>
              </div>
              <div class="flex items-start gap-3">
                <div
                  class="w-1 h-6 bg-[#003087] rounded-full flex-shrink-0 mt-0.5"
                >
                </div>
                <p class="text-gray-700">Access your imaging results</p>
              </div>
              <div class="flex items-start gap-3">
                <div
                  class="w-1 h-6 bg-[#003087] rounded-full flex-shrink-0 mt-0.5"
                >
                </div>
                <p class="text-gray-700">
                  Share results with healthcare providers
                </p>
              </div>
            </div>
          </div>

          <!-- Prohibited Activities -->
          <div>
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              Prohibited Activities
            </h3>
            <div class="bg-gray-50 rounded-xl p-8">
              <p class="text-gray-700 mb-4">
                To maintain a safe and secure platform for all users, the
                following activities are strictly prohibited:
              </p>
              <div class="space-y-3 text-gray-600">
                <p>
                  • Attempting to breach, test, or circumvent our security
                  measures
                </p>
                <p>
                  • Using automated systems, bots, or scrapers without
                  permission
                </p>
                <p>• Creating false identities or impersonating others</p>
                <p>
                  • Engaging in any activity that violates applicable laws or
                  regulations
                </p>
                <p>• Interfering with other users' access to our services</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: Our Content -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Our Content</h2>

        <div class="bg-gray-50 rounded-xl p-8">
          <p class="text-gray-700 mb-4">
            Everything on our site - the design, logos, text, and code - belongs
            to USRad or our partners and is protected by law.
          </p>
          <p class="text-gray-600 text-sm">
            <span class="font-semibold">In simple terms:</span> You can use our site
            for personal healthcare needs, but you can't copy our stuff for your
            own business.
          </p>
        </div>
      </div>

      <!-- Section 3: Medical Disclaimer -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">
          Medical Disclaimer
        </h2>

        <div class="bg-[#003087] text-white rounded-xl p-8">
          <div class="flex items-start gap-4">
            <svg
              class="w-8 h-8 text-[#cc9933] flex-shrink-0 mt-1"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                clip-rule="evenodd"></path>
            </svg>
            <div>
              <h3 class="text-xl font-semibold mb-2">Important</h3>
              <p class="text-white/90">
                We help you find imaging services, but we don't provide medical
                advice. Always consult your doctor for health decisions.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 4: How We Work Together -->
      <div class="mb-20" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">
          How We Work Together
        </h2>

        <div class="space-y-4">
          <div class="flex items-center gap-4 p-6 bg-gray-50 rounded-xl">
            <div
              class="w-16 h-16 bg-white rounded-xl flex items-center justify-center flex-shrink-0"
            >
              <span class="text-2xl">🤝</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">
                We provide the platform
              </h3>
              <p class="text-gray-600">
                Connect you with quality imaging centers at fair prices
              </p>
            </div>
          </div>

          <div class="flex items-center gap-4 p-6 bg-gray-50 rounded-xl">
            <div
              class="w-16 h-16 bg-white rounded-xl flex items-center justify-center flex-shrink-0"
            >
              <span class="text-2xl">🏥</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">
                Centers provide the service
              </h3>
              <p class="text-gray-600">
                Professional imaging with board-certified radiologists
              </p>
            </div>
          </div>

          <div class="flex items-center gap-4 p-6 bg-gray-50 rounded-xl">
            <div
              class="w-16 h-16 bg-white rounded-xl flex items-center justify-center flex-shrink-0"
            >
              <span class="text-2xl">👨‍⚕️</span>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">
                Your doctor provides care
              </h3>
              <p class="text-gray-600">
                Reviews results and guides your treatment
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Other Important Stuff -->
      <div class="space-y-16">
        <!-- Privacy -->
        <div data-aos="fade-up">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Your Privacy</h2>
          <p class="text-gray-600 mb-4">
            Your privacy is protected by our comprehensive Privacy Policy. We
            take data security seriously.
          </p>
          <a
            href="/privacy-policy-carbon"
            class="inline-flex items-center gap-2 text-[#003087] hover:text-[#002266] font-medium transition"
          >
            Read Privacy Policy
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- External Links -->
        <div data-aos="fade-up">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            Links to Other Sites
          </h2>
          <p class="text-gray-600">
            We sometimes link to other websites. We're not responsible for their
            content - make sure you trust them before sharing any information.
          </p>
        </div>

        <!-- Changes -->
        <div data-aos="fade-up">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            Changes to These Terms
          </h2>
          <p class="text-gray-600">
            We may update these terms occasionally. We'll always show the date
            at the top so you know when they last changed.
          </p>
        </div>

        <!-- Liability -->
        <div data-aos="fade-up">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            Limitation of Liability
          </h2>
          <p class="text-gray-600">
            We work hard to provide a great service, but we can't be held liable
            for damages beyond what the law allows. We're a platform connecting
            you with imaging centers, not the provider of medical services.
          </p>
        </div>
      </div>

      <!-- Contact Section -->
      <div
        class="mt-20 text-center py-16 border-t border-gray-200"
        data-aos="fade-up"
      >
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Questions About These Terms?
        </h2>
        <p class="text-xl text-gray-600 mb-8">
          We're here to help clarify anything.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="mailto:legal@usrad.com"
            class="inline-flex items-center gap-2 text-[#003087] hover:text-[#002266] font-medium text-lg transition"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            legal@usrad.com
          </a>
          <span class="text-gray-400 hidden sm:inline">•</span>
          <a
            href="tel:1-866-872-7324"
            class="inline-flex items-center gap-2 text-[#003087] hover:text-[#002266] font-medium text-lg transition"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            1-866-USRad-24
          </a>
        </div>
      </div>

      <!-- Agreement Note -->
      <div
        class="mt-16 text-center p-8 bg-gray-50 rounded-xl"
        data-aos="fade-up"
      >
        <p class="text-gray-600">
          By using USRad, you agree to these terms. Thanks for choosing us for
          your medical imaging needs.
        </p>
      </div>
    </div>
  </section>

  <!-- Simple CTA -->
  <section class="py-16 px-4 sm:px-6 bg-[#003087] text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Save on Medical Imaging?</h2>
      <p class="text-xl mb-8 text-white/80">
        Start your journey to affordable healthcare.
      </p>
      <a
        href="/search-results"
        class="bg-white text-[#003087] px-8 py-3 rounded-lg font-medium hover:bg-gray-100 transition inline-block"
      >
        Find Imaging Centers
      </a>
    </div>
  </section>

  <style>
    /* Clean, minimal styles */
    .prose a {
      text-decoration: none;
    }

    .prose a:hover {
      text-decoration: underline;
    }
  </style>
</CarbonLayout>
