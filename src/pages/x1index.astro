---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import FadeIn from "../components/FadeIn.astro";
import AOSInit from "../components/AOSInit.astro";
import FAQPreview from "../components/FAQPreview.astro";
import CoreBenefits from "../components/CoreBenefits.astro";
import TrustBadgesBar from "../components/TrustBadgesBar.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import ClinicalIntroWithImage from "../components/ClinicalIntroWithImage.astro";
import ClinicalCredentialsGrid from "../components/ClinicalCredentialsGrid.astro";
import SecondaryButton from "../components/SecondaryButton.astro";
import HeroSearchForm from "../components/HeroSearchForm.astro";
import ProofSection from "../components/ProofSection.astro";
import HeroVideoSection from "../components/HeroVideoSection.astro";
import NetworkMapPins from "../components/NetworkMapPins.astro";

const showPatientHeader = true;
---

<MainPatientLayout showPatientHeader={true}>
  <AOSInit />

  <!-- BIG STARTUP VIDEO HERO -->
  <FadeIn effect="fade" delay={0}>
    <HeroVideoSection
      headlineText={`<span class="text-white">Your MRI: </span><span class="text-[#cc9933] font-bold">$325</span><br /><span class="text-white text-5xl">Not $3,000</span>`}
      subText={`<span class="text-white/90">Book today. Scan this week. Save thousands.</span><br class="hidden sm:block" /><span class="text-white/80 text-lg">Transparent pricing from quality imaging centers nationwide</span>`}
      credibilityText=""
      videoSources={[
        {
          src: "/videos/home-hero-mri-mobile.mp4",
          type: "video/mp4",
          media: "(max-width: 768px)",
        },
        { src: "/videos/home-hero-mri.mp4", type: "video/mp4" },
        { src: "/videos/home-hero-mri.webm", type: "video/webm" },
      ]}
      posterUrl="/images/home-hero-mri.webp?v=2.1"
      primaryCTA={{
        label: "Find Imaging Centers",
        href: "/search-results",
      }}
      secondaryCTA={{ label: "Check Prices", id: "heroSearchToggle" }}
      showSearchForm={true}
      trustIndicators={[
        {
          icon: `<div class='w-3 h-3 bg-green-400 rounded-full animate-pulse'></div>`,
          text: "Next appointment: Tomorrow",
        },
        {
          icon: `<svg class='w-4 h-4 text-[#cc9933]' fill='currentColor' viewBox='0 0 20 20'><path fill-rule='evenodd' d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z' clip-rule='evenodd'></path></svg>`,
          text: "Average savings: 80%",
        },
        {
          icon: `<svg class='w-4 h-4 text-green-400' fill='currentColor' viewBox='0 0 20 20'><path fill-rule='evenodd' d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z' clip-rule='evenodd'></path></svg>`,
          text: "No insurance needed",
        },
      ]}
    />

    <!-- PROOF SECTION - Confidence Building -->
    <section class="bg-white py-8 border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-6">
        <div
          class="flex flex-wrap justify-center items-center gap-8 text-sm text-gray-600"
        >
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Board-Certified Radiologists</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>ACR Accredited Centers</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Results in 24-48 Hours</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-green-500"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Secure Digital Delivery</span>
          </div>
        </div>
      </div>
    </section>

    <!-- THE PROBLEM - Enterprise Style -->
    <section class="bg-gradient-to-b from-gray-50 to-white py-20 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-5xl font-bold text-[#003087] mb-6" data-aos="fade-up">
            Healthcare's Pricing Crisis Ends Now
          </h2>
          <p
            class="text-2xl text-gray-600 max-w-4xl mx-auto"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            90 million Americans delay or skip medical imaging due to cost.
            We're changing that.
          </p>
        </div>

        <!-- Visual Comparison -->
        <div class="grid md:grid-cols-2 gap-12 max-w-6xl mx-auto">
          <!-- Traditional Healthcare -->
          <div class="relative" data-aos="fade-right">
            <div
              class="bg-white rounded-2xl shadow-xl p-8 border-t-4 border-red-500"
            >
              <h3 class="text-2xl font-bold text-gray-900 mb-6">
                Traditional Healthcare
              </h3>
              <div class="space-y-4">
                <div class="flex justify-between items-center">
                  <span class="text-gray-600">MRI Brain</span>
                  <span class="text-2xl font-bold text-red-600"
                    >$3,000-$8,000</span
                  >
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-600">CT Scan</span>
                  <span class="text-2xl font-bold text-red-600"
                    >$2,000-$4,000</span
                  >
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-600">Ultrasound</span>
                  <span class="text-2xl font-bold text-red-600"
                    >$800-$1,500</span
                  >
                </div>
                <div class="pt-4 space-y-2 text-sm text-gray-500">
                  <p>+ Hidden facility fees</p>
                  <p>+ Separate radiologist bills</p>
                  <p>+ 3-4 week wait times</p>
                </div>
              </div>
            </div>
          </div>

          <!-- USRad -->
          <div class="relative" data-aos="fade-left">
            <div
              class="bg-gradient-to-br from-[#003087] to-[#0052cc] rounded-2xl shadow-xl p-8 text-white"
            >
              <h3 class="text-2xl font-bold mb-6">USRad Network</h3>
              <div class="space-y-4">
                <div class="flex justify-between items-center">
                  <span class="text-white/90">MRI Brain</span>
                  <span class="text-2xl font-bold text-[#cc9933]">$325</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-white/90">CT Scan</span>
                  <span class="text-2xl font-bold text-[#cc9933]">$195</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-white/90">Ultrasound</span>
                  <span class="text-2xl font-bold text-[#cc9933]">$125</span>
                </div>
                <div class="pt-4 space-y-2 text-sm text-white/80">
                  <p>✓ All-inclusive pricing</p>
                  <p>✓ No hidden fees ever</p>
                  <p>✓ Same week appointments</p>
                </div>
              </div>
            </div>
            <div
              class="absolute -bottom-4 -right-4 bg-[#cc9933] text-[#003087] px-6 py-2 rounded-full font-bold shadow-lg"
            >
              Save up to 90%
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS - Uber Simple -->
    <section class="bg-white py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <h2
          class="text-4xl font-bold text-center text-[#003087] mb-16"
          data-aos="fade-up"
        >
          Book Quality Imaging in Minutes
        </h2>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center" data-aos="fade-up">
            <div class="mb-6">
              <div
                class="w-20 h-20 bg-[#003087] text-white rounded-2xl flex items-center justify-center text-3xl font-bold mx-auto shadow-lg"
              >
                1
              </div>
            </div>
            <h3 class="text-xl font-bold text-[#003087] mb-3">Search</h3>
            <p class="text-gray-600">Enter your location and scan type</p>
          </div>

          <div class="text-center" data-aos="fade-up" data-aos-delay="100">
            <div class="mb-6">
              <div
                class="w-20 h-20 bg-[#003087] text-white rounded-2xl flex items-center justify-center text-3xl font-bold mx-auto shadow-lg"
              >
                2
              </div>
            </div>
            <h3 class="text-xl font-bold text-[#003087] mb-3">Compare</h3>
            <p class="text-gray-600">View transparent prices instantly</p>
          </div>

          <div class="text-center" data-aos="fade-up" data-aos-delay="200">
            <div class="mb-6">
              <div
                class="w-20 h-20 bg-[#cc9933] text-white rounded-2xl flex items-center justify-center text-3xl font-bold mx-auto shadow-lg"
              >
                ✓
              </div>
            </div>
            <h3 class="text-xl font-bold text-[#003087] mb-3">Book</h3>
            <p class="text-gray-600">Confirm your appointment online</p>
          </div>
        </div>
      </div>
    </section>

    <!-- LIVE PRICING - Like Uber Surge Map -->
    <section class="bg-gray-50 py-20 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-[#003087] mb-4" data-aos="fade-up">
            Real-Time Transparent Pricing
          </h2>
          <p
            class="text-xl text-gray-600"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            See exact prices from imaging centers near you
          </p>
        </div>

        <!-- Interactive Pricing Display -->
        <div
          class="bg-white rounded-2xl shadow-xl overflow-hidden"
          data-aos="fade-up"
        >
          <div class="bg-[#003087] text-white p-6">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-2xl font-bold">MRI - Brain without Contrast</h3>
                <p class="opacity-80">CPT Code: 70551</p>
              </div>
              <div class="text-right">
                <p class="text-sm opacity-80">Your location:</p>
                <p class="text-lg font-semibold">Miami, FL 33131</p>
              </div>
            </div>
          </div>

          <div class="p-6">
            <!-- Price List -->
            <div class="space-y-4">
              <div
                class="flex items-center justify-between p-4 bg-green-50 rounded-lg border border-green-200"
              >
                <div>
                  <h4 class="font-semibold text-[#003087]">
                    Advanced Imaging Center
                  </h4>
                  <p class="text-sm text-gray-600">
                    2.3 miles • Tomorrow 9:00 AM available
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-3xl font-bold text-green-600">$325</p>
                  <button
                    class="text-sm bg-green-600 text-white px-4 py-1 rounded-full mt-1"
                    >Book Now</button
                  >
                </div>
              </div>

              <div
                class="flex items-center justify-between p-4 bg-gray-50 rounded-lg"
              >
                <div>
                  <h4 class="font-semibold text-[#003087]">
                    Diagnostic Imaging Associates
                  </h4>
                  <p class="text-sm text-gray-600">
                    3.8 miles • Thursday available
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-3xl font-bold text-[#003087]">$380</p>
                  <button
                    class="text-sm bg-[#003087] text-white px-4 py-1 rounded-full mt-1"
                    >Book Now</button
                  >
                </div>
              </div>

              <div
                class="flex items-center justify-between p-4 bg-gray-50 rounded-lg"
              >
                <div>
                  <h4 class="font-semibold text-[#003087]">
                    Premier Medical Imaging
                  </h4>
                  <p class="text-sm text-gray-600">
                    5.1 miles • Wednesday available
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-3xl font-bold text-[#003087]">$425</p>
                  <button
                    class="text-sm bg-[#003087] text-white px-4 py-1 rounded-full mt-1"
                    >Book Now</button
                  >
                </div>
              </div>

              <!-- Hospital Comparison -->
              <div
                class="flex items-center justify-between p-4 bg-red-50 rounded-lg border border-red-200 opacity-75"
              >
                <div>
                  <h4 class="font-semibold text-gray-700">
                    Local Hospital (Comparison)
                  </h4>
                  <p class="text-sm text-gray-600">
                    Insurance required • 3-4 week wait
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-3xl font-bold text-red-600 line-through">
                    $3,200
                  </p>
                  <p class="text-sm text-gray-500">Not in network</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- QUALITY ASSURANCE - Enterprise Level -->
    <section class="bg-white py-20 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div data-aos="fade-right">
            <h2 class="text-4xl font-bold text-[#003087] mb-6">
              Quality Without Compromise
            </h2>
            <p class="text-xl text-gray-600 mb-8">
              Every imaging center in our network meets rigorous quality
              standards. Same equipment. Same expertise. Better price.
            </p>

            <div class="grid grid-cols-2 gap-6">
              <div class="text-center p-6 bg-gray-50 rounded-xl">
                <div class="text-4xl font-bold text-[#003087] mb-2">100%</div>
                <p class="text-sm text-gray-600">
                  Board-Certified Radiologists
                </p>
              </div>
              <div class="text-center p-6 bg-gray-50 rounded-xl">
                <div class="text-4xl font-bold text-[#003087] mb-2">24hr</div>
                <p class="text-sm text-gray-600">Results Turnaround</p>
              </div>
              <div class="text-center p-6 bg-gray-50 rounded-xl">
                <div class="text-4xl font-bold text-[#003087] mb-2">ACR</div>
                <p class="text-sm text-gray-600">Accredited Centers</p>
              </div>
              <div class="text-center p-6 bg-gray-50 rounded-xl">
                <div class="text-4xl font-bold text-[#003087] mb-2">3.0T</div>
                <p class="text-sm text-gray-600">Latest MRI Technology</p>
              </div>
            </div>
          </div>

          <div data-aos="fade-left">
            <img
              src="/images/website/trust-duo.webp"
              loading="lazy"
              alt="Medical professionals with patient"
              class="w-full h-auto rounded-2xl shadow-xl"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- NATIONWIDE NETWORK -->
    <NetworkMapPins />

    <!-- PATIENT PROTECTION -->
    <section class="bg-[#003087] text-white py-20 px-6">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="text-4xl font-bold mb-6" data-aos="fade-up">
          Your Rights. Protected.
        </h2>
        <p
          class="text-xl mb-12 opacity-90 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Transparent healthcare starts with clear guarantees
        </p>

        <div class="grid md:grid-cols-3 gap-8">
          <div
            class="bg-white/10 backdrop-blur rounded-2xl p-8"
            data-aos="fade-up"
          >
            <div
              class="w-16 h-16 bg-[#cc9933] rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">Price Guarantee</h3>
            <p class="opacity-80">
              The price you see is the price you pay. No surprise bills. Ever.
            </p>
          </div>

          <div
            class="bg-white/10 backdrop-blur rounded-2xl p-8"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <div
              class="w-16 h-16 bg-[#cc9933] rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">Quality Guarantee</h3>
            <p class="opacity-80">
              If your scan doesn't meet standards, we'll arrange a re-scan at no
              cost.
            </p>
          </div>

          <div
            class="bg-white/10 backdrop-blur rounded-2xl p-8"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <div
              class="w-16 h-16 bg-[#cc9933] rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-white"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M10 2a5 5 0 00-5 5v2a2 2 0 00-2 2v5a2 2 0 002 2h10a2 2 0 002-2v-5a2 2 0 00-2-2H7V7a3 3 0 015.905-.75 1 1 0 001.937-.5A5.002 5.002 0 0010 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-3">Privacy Protected</h3>
            <p class="opacity-80">
              HIPAA compliant. Your medical information stays secure and
              confidential.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PATIENT SUCCESS METRICS -->
    <section class="bg-gradient-to-br from-[#fefbf5] to-white py-20 px-6">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="text-4xl font-bold text-[#003087] mb-4" data-aos="fade-up">
          Healthcare That Works for You
        </h2>
        <p
          class="text-xl text-gray-600 mb-12 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Transparent pricing. Quality care. No surprises.
        </p>

        <div class="grid md:grid-cols-4 gap-6">
          <div class="bg-white rounded-2xl p-6 shadow-lg" data-aos="fade-up">
            <div class="text-5xl font-bold text-[#cc9933] mb-2">80%</div>
            <p class="text-gray-700 font-semibold">Average Savings</p>
            <p class="text-sm text-gray-600 mt-1">vs. hospital pricing</p>
          </div>

          <div
            class="bg-white rounded-2xl p-6 shadow-lg"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <div class="text-5xl font-bold text-[#003087] mb-2">2-3</div>
            <p class="text-gray-700 font-semibold">Day Appointments</p>
            <p class="text-sm text-gray-600 mt-1">not 3-4 weeks</p>
          </div>

          <div
            class="bg-white rounded-2xl p-6 shadow-lg"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <div class="text-5xl font-bold text-[#cc9933] mb-2">24hr</div>
            <p class="text-gray-700 font-semibold">Results Delivery</p>
            <p class="text-sm text-gray-600 mt-1">digital access</p>
          </div>

          <div
            class="bg-white rounded-2xl p-6 shadow-lg"
            data-aos="fade-up"
            data-aos-delay="300"
          >
            <div class="text-5xl font-bold text-[#003087] mb-2">$0</div>
            <p class="text-gray-700 font-semibold">Hidden Fees</p>
            <p class="text-sm text-gray-600 mt-1">guaranteed</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Preview -->
    <FAQPreview />

    <!-- FINAL CTA - Enterprise Style -->
    <FadeIn effect="fade" delay={100}>
      <section
        class="relative bg-gradient-to-r from-[#003087] via-[#0052cc] to-[#003087] text-white py-24 px-6 overflow-hidden"
        data-aos="fade-up"
      >
        <!-- Dynamic background -->
        <div class="absolute inset-0">
          <div
            class="absolute inset-0 bg-gradient-to-br from-transparent via-[#cc9933]/10 to-transparent animate-pulse"
          >
          </div>
        </div>

        <div class="max-w-5xl mx-auto text-center relative z-10">
          <h2 class="text-5xl font-bold mb-6">
            Stop Overpaying for Medical Imaging
          </h2>
          <p class="text-2xl mb-12 opacity-90">
            Join the healthcare pricing revolution. Save thousands on your next
            scan.
          </p>

