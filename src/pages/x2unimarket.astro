---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import FadeIn from "../components/FadeIn.astro";
import AOSInit from "../components/AOSInit.astro";
import FAQPreview from "../components/FAQPreview.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import SecondaryButton from "../components/SecondaryButton.astro";
import HeroSearchForm from "../components/HeroSearchForm.astro";
import NetworkMapPins from "../components/NetworkMapPins.astro";

const showPatientHeader = true;
---

<MainPatientLayout showPatientHeader={true}>
  <AOSInit />

  <!-- HEALTH TECH MARKETPLACE HERO -->
  <section class="relative min-h-screen flex items-center bg-white">
    <div class="max-w-7xl mx-auto px-6 py-20 w-full">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Messaging -->
        <div data-aos="fade-right">
          <div class="mb-6">
            <span
              class="inline-flex items-center gap-2 text-sm font-medium text-[#003087] bg-blue-50 px-4 py-2 rounded-full"
            >
              <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"
              ></span>
              Now booking appointments for this week
            </span>
          </div>

          <h1
            class="text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 mb-6 leading-tight"
          >
            MRI scans from
            <span class="text-[#003087] block">$325</span>
          </h1>

          <p class="text-2xl text-gray-600 mb-8">
            Skip the $3,000 hospital bill. Book quality imaging at honest
            prices.
          </p>

          <!-- Search Widget -->
          <div class="bg-gray-50 rounded-2xl p-6 mb-8 border border-gray-200">
            <div class="flex flex-col sm:flex-row gap-4">
              <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700 mb-2"
                  >Where are you?</label
                >
                <input
                  type="text"
                  placeholder="Enter ZIP code"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-[#003087] focus:ring-2 focus:ring-[#003087]/20 transition-all"
                />
              </div>
              <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700 mb-2"
                  >What do you need?</label
                >
                <select
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-[#003087] focus:ring-2 focus:ring-[#003087]/20 transition-all"
                >
                  <option>MRI Scan</option>
                  <option>CT Scan</option>
                  <option>Ultrasound</option>
                  <option>X-Ray</option>
                </select>
              </div>
            </div>
            <button
              class="w-full mt-4 bg-[#003087] hover:bg-[#002266] text-white py-4 rounded-xl font-semibold text-lg transition-all transform hover:scale-[1.02]"
            >
              Show Prices & Availability →
            </button>
          </div>

          <!-- Trust Indicators -->
          <div class="flex flex-wrap gap-6 text-sm text-gray-600">
            <div class="flex items-center gap-2">
              <svg
                class="w-5 h-5 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>No insurance needed</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                class="w-5 h-5 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>Board-certified radiologists</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                class="w-5 h-5 text-green-500"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              <span>Results in 24 hours</span>
            </div>
          </div>
        </div>

        <!-- Right: Visual -->
        <div class="relative" data-aos="fade-left">
          <div class="relative">
            <img
              src="/images/website/brain.webp"
              alt="Patient booking scan on tablet"
              class="w-full rounded-2xl shadow-2xl"
            />

            <!-- Floating Price Cards -->
            <div
              class="absolute -left-4 top-1/4 bg-white rounded-xl shadow-xl p-4 transform -rotate-3 hover:rotate-0 transition-transform"
            >
              <div class="text-xs text-gray-500 line-through">
                Hospital Price
              </div>
              <div class="text-2xl font-bold text-red-500">$3,200</div>
            </div>

            <div
              class="absolute -right-4 bottom-1/4 bg-white rounded-xl shadow-xl p-4 transform rotate-3 hover:rotate-0 transition-transform"
            >
              <div class="text-xs text-gray-500">USRad Price</div>
              <div class="text-2xl font-bold text-green-500">$325</div>
              <div class="text-xs text-green-600 font-semibold mt-1">
                Save $2,875
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF BAR -->
  <section class="bg-[#003087] text-white py-6">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-wrap justify-center items-center gap-8 text-center">
        <div>
          <div class="text-2xl font-bold">1,500+</div>
          <div class="text-sm opacity-90">imaging centers</div>
        </div>
        <div class="w-px h-8 bg-white/20"></div>
        <div>
          <div class="text-2xl font-bold">50-90%</div>
          <div class="text-sm opacity-90">average savings</div>
        </div>
        <div class="w-px h-8 bg-white/20"></div>
        <div>
          <div class="text-2xl font-bold">24-48hr</div>
          <div class="text-sm opacity-90">results delivery</div>
        </div>
        <div class="w-px h-8 bg-white/20"></div>
        <div>
          <div class="text-2xl font-bold">4.9★</div>
          <div class="text-sm opacity-90">patient rating</div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS - VISUAL -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4" data-aos="fade-up">
          Healthcare made simple
        </h2>
        <p
          class="text-xl text-gray-600"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Book your scan like you'd book anything else online
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="relative" data-aos="fade-up">
          <div
            class="bg-blue-50 rounded-2xl p-8 text-center h-full border-2 border-transparent hover:border-[#003087] transition-all"
          >
            <div
              class="w-16 h-16 bg-[#003087] text-white rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-4"
            >
              1
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Compare prices</h3>
            <p class="text-gray-600">
              See real prices from quality centers near you. No guessing, no
              surprises.
            </p>
          </div>
        </div>

        <div class="relative" data-aos="fade-up" data-aos-delay="100">
          <div
            class="bg-green-50 rounded-2xl p-8 text-center h-full border-2 border-transparent hover:border-green-500 transition-all"
          >
            <div
              class="w-16 h-16 bg-green-500 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-4"
            >
              2
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Book instantly</h3>
            <p class="text-gray-600">
              Choose your time and confirm. Get appointment details immediately.
            </p>
          </div>
        </div>

        <div class="relative" data-aos="fade-up" data-aos-delay="200">
          <div
            class="bg-purple-50 rounded-2xl p-8 text-center h-full border-2 border-transparent hover:border-purple-500 transition-all"
          >
            <div
              class="w-16 h-16 bg-purple-500 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-4"
            >
              3
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">
              Get results fast
            </h3>
            <p class="text-gray-600">
              Secure digital delivery in 24-48 hours. Share with any doctor.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LIVE PRICING SHOWCASE -->
  <section class="py-20 px-6 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div data-aos="fade-right">
          <h2 class="text-4xl font-bold text-gray-900 mb-6">
            Real prices.<br />Real savings.<br />Really simple.
          </h2>
          <p class="text-xl text-gray-600 mb-8">
            No more calling around. No more insurance confusion. Just clear,
            upfront pricing from accredited imaging centers.
          </p>

          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div
                class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-[#003087]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">
                  All-inclusive pricing
                </h3>
                <p class="text-gray-600">
                  Scan, radiologist review, and report included
                </p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div
                class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-green-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Quality guaranteed</h3>
                <p class="text-gray-600">ACR accredited centers only</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div
                class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-purple-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">
                  Book today, scan tomorrow
                </h3>
                <p class="text-gray-600">Most appointments within 48 hours</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Pricing Display -->
        <div data-aos="fade-left">
          <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            <div class="p-6 border-b border-gray-200">
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-gray-900">
                  MRI prices near Miami, FL
                </h3>
                <button
                  class="text-[#003087] hover:text-[#002266] font-medium text-sm"
                  >Change location</button
                >
              </div>
            </div>

            <div class="divide-y divide-gray-200">
              <div class="p-6 hover:bg-gray-50 transition-colors">
                <div class="flex items-center justify-between">
                  <div>
                    <h4 class="font-semibold text-gray-900">
                      Advanced Diagnostics Miami
                    </h4>
                    <div
                      class="flex items-center gap-4 mt-1 text-sm text-gray-600"
                    >
                      <span>2.1 miles away</span>
                      <span>•</span>
                      <span class="text-green-600">Tomorrow 9:30 AM</span>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-3xl font-bold text-[#003087]">$325</div>
                    <button
                      class="mt-2 bg-[#003087] hover:bg-[#002266] text-white px-6 py-2 rounded-lg text-sm font-medium transition-colors"
                    >
                      Book now
                    </button>
                  </div>
                </div>
              </div>

              <div class="p-6 hover:bg-gray-50 transition-colors">
                <div class="flex items-center justify-between">
                  <div>
                    <h4 class="font-semibold text-gray-900">
                      Precision Imaging Center
                    </h4>
                    <div
                      class="flex items-center gap-4 mt-1 text-sm text-gray-600"
                    >
                      <span>3.5 miles away</span>
                      <span>•</span>
                      <span class="text-green-600">Today 3:00 PM</span>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-3xl font-bold text-[#003087]">$380</div>
                    <button
                      class="mt-2 bg-[#003087] hover:bg-[#002266] text-white px-6 py-2 rounded-lg text-sm font-medium transition-colors"
                    >
                      Book now
                    </button>
                  </div>
                </div>
              </div>

              <div class="p-6 hover:bg-gray-50 transition-colors">
                <div class="flex items-center justify-between">
                  <div>
                    <h4 class="font-semibold text-gray-900">
                      Medical Arts Imaging
                    </h4>
                    <div
                      class="flex items-center gap-4 mt-1 text-sm text-gray-600"
                    >
                      <span>5.2 miles away</span>
                      <span>•</span>
                      <span>Wednesday available</span>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-3xl font-bold text-[#003087]">$425</div>
                    <button
                      class="mt-2 bg-[#003087] hover:bg-[#002266] text-white px-6 py-2 rounded-lg text-sm font-medium transition-colors"
                    >
                      Book now
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div class="p-4 bg-gray-50">
              <p class="text-center text-sm text-gray-600">
                Compare to hospital average: <span
                  class="font-semibold text-red-600">$3,200</span
                >
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY USRAD -->
  <section class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4" data-aos="fade-up">
          Why people choose USRad
        </h2>
        <p
          class="text-xl text-gray-600 max-w-3xl mx-auto"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          We believe healthcare should be transparent, accessible, and
          affordable for everyone
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="text-center" data-aos="fade-up">
          <div
            class="w-20 h-20 bg-gradient-to-br from-blue-100 to-blue-200 rounded-3xl flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-10 h-10 text-[#003087]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Save thousands</h3>
          <p class="text-gray-600">
            Pay 50-90% less than hospital prices. No insurance markup. No
            facility fees.
          </p>
        </div>

        <div class="text-center" data-aos="fade-up" data-aos-delay="100">
          <div
            class="w-20 h-20 bg-gradient-to-br from-green-100 to-green-200 rounded-3xl flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-10 h-10 text-green-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Skip the wait</h3>
          <p class="text-gray-600">
            Get appointments this week, not next month. Most scans available
            within 48 hours.
          </p>
        </div>

        <div class="text-center" data-aos="fade-up" data-aos-delay="200">
          <div
            class="w-20 h-20 bg-gradient-to-br from-purple-100 to-purple-200 rounded-3xl flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-10 h-10 text-purple-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">
            Quality guaranteed
          </h3>
          <p class="text-gray-600">
            Board-certified radiologists. Accredited centers. Same quality,
            better experience.
          </p>
        </div>

        <div class="text-center" data-aos="fade-up" data-aos-delay="300">
          <div
            class="w-20 h-20 bg-gradient-to-br from-yellow-100 to-yellow-200 rounded-3xl flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-10 h-10 text-yellow-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">
            Your privacy protected
          </h3>
          <p class="text-gray-600">
            HIPAA compliant. Bank-level encryption. Your health data stays
            yours.
          </p>
        </div>

        <div class="text-center" data-aos="fade-up" data-aos-delay="400">
          <div
            class="w-20 h-20 bg-gradient-to-br from-red-100 to-red-200 rounded-3xl flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-10 h-10 text-red-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Human support</h3>
          <p class="text-gray-600">
            Real people answer your questions. Help with booking, prep, and
            results.
          </p>
        </div>

        <div class="text-center" data-aos="fade-up" data-aos-delay="500">
          <div
            class="w-20 h-20 bg-gradient-to-br from-indigo-100 to-indigo-200 rounded-3xl flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-10 h-10 text-indigo-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">
            Digital convenience
          </h3>
          <p class="text-gray-600">
            Book online 24/7. Get results digitally. Share with any doctor
            instantly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- NATIONWIDE COVERAGE -->
  <NetworkMapPins />

  <!-- FAQ PREVIEW -->
  <FAQPreview />

  <!-- FINAL CTA -->
  <section class="bg-[#003087] text-white py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6" data-aos="fade-up">
        Ready to save on your medical imaging?
      </h2>
      <p
        class="text-xl md:text-2xl mb-10 opacity-90"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        Join thousands discovering healthcare that actually makes sense
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center"
        data-aos="fade-up"
        data-aos-delay="200"
      >
        <a
          href="/search-results"
          class="bg-white hover:bg-gray-100 text-[#003087] px-8 py-4 rounded-xl font-bold text-lg transition-all inline-flex items-center gap-2"
        >
          Find imaging centers
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
