---
import MainLayout from "../layouts/MainLayout.astro";
import HeroEmployer from "../components/employer/HeroEmployer.astro";
---

<MainLayout>
  <!-- Hero Section with Video Background -->
  <section
    class="relative min-h-screen overflow-hidden bg-gradient-to-br from-[#0a0e27] via-[#0f1629] to-[#003087]"
  >
    <!-- Background Video -->
    <div class="absolute inset-0 z-0">
      <video
        id="partnerHeroVideo"
        autoplay
        muted
        loop
        playsinline
        class="absolute inset-0 w-full h-full object-cover opacity-60"
        poster="/images/partner-hero-fallback-enhanced.webp"
      >
        <source
          src="/videos/partner-hero-softblur-mobile.mp4"
          type="video/mp4"
          media="(max-width: 768px)"
        />
        <source src="/videos/partner-hero-softblur.mp4" type="video/mp4" />
        <source src="/videos/partner-hero-softblur.webm" type="video/webm" />
      </video>

      <!-- Video Overlay -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-black/40"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#0a0e27]/90 via-transparent to-[#0a0e27]/50"
      >
      </div>
    </div>

    <!-- Animated Background Elements -->
    <div class="absolute inset-0 z-10">
      <div
        class="absolute top-20 left-10 w-96 h-96 bg-[#cc9933] rounded-full filter blur-[150px] opacity-20 animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-20 right-10 w-96 h-96 bg-[#4A90E2] rounded-full filter blur-[150px] opacity-20 animate-pulse"
        style="animation-delay: 2s;"
      >
      </div>
    </div>

    <!-- Hero Content -->
    <div
      class="relative z-20 flex items-center justify-center min-h-screen px-4 sm:px-6 lg:px-8"
    >
      <div class="max-w-7xl mx-auto text-center py-20">
        <!-- Trust Badge -->
        <div class="mb-12" data-aos="fade-down">
          <div
            class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-md rounded-full px-8 py-4 border border-white/20"
          >
            <div class="relative">
              <span
                class="absolute inline-flex h-3 w-3 rounded-full bg-[#cc9933] opacity-75 animate-ping"
              ></span>
              <span
                class="relative inline-flex h-3 w-3 rounded-full bg-[#cc9933]"
              ></span>
            </div>
            <span
              class="text-white text-sm md:text-base font-medium tracking-wide"
              >PROVEN PIONEERS • $400M+ SAVED • NYSE-LISTED EXIT</span
            >
          </div>
        </div>

        <!-- Main Heading -->
        <h1
          class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold text-white mb-8 leading-tight"
          data-aos="fade-up"
        >
          Remember Us?<br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] via-[#FFA500] to-[#cc9933] animate-gradient"
          >
            We're Back.
          </span>
        </h1>

        <p
          class="text-2xl md:text-3xl text-gray-300 max-w-4xl mx-auto mb-16 leading-relaxed"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          The same team that revolutionized imaging costs for Fortune 500
          companies is now transforming diagnostic access for <strong
            class="text-white">all employers</strong
          >.
        </p>

        <!-- CTAs -->
        <div
          class="flex flex-col sm:flex-row gap-6 justify-center mb-20"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <a
            href="/employer/schedule"
            class="group relative bg-gradient-to-r from-[#cc9933] to-[#FFA500] text-[#003087] px-10 py-5 rounded-xl font-bold text-lg hover:shadow-2xl hover:shadow-[#cc9933]/25 transition-all transform hover:scale-105 overflow-hidden"
          >
            <span class="relative z-10">Let's Reconnect →</span>
            <div
              class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity"
            >
            </div>
          </a>
          <a
            href="#proven-impact"
            class="border-2 border-white/30 text-white px-10 py-5 rounded-xl font-bold text-lg hover:bg-white/10 hover:border-white/50 transition-all"
          >
            See Our Impact
          </a>
        </div>

        <!-- Scroll Indicator -->
        <div
          class="absolute bottom-10 left-1/2 transform -translate-x-1/2 text-white/60 animate-bounce"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Proven Impact Section -->
  <section id="proven-impact" class="py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-[#003087] mb-8"
        >
          Our Track Record Speaks
        </h2>
        <p class="text-2xl text-gray-600 max-w-3xl mx-auto">
          From conference floors to boardrooms, we've been transforming
          healthcare costs for decades
        </p>
      </div>

      <!-- Impact Numbers -->
      <div class="grid md:grid-cols-4 gap-8 mb-24">
        <div class="text-center" data-aos="fade-up" data-aos-delay="100">
          <div
            class="text-6xl md:text-7xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-[#FFA500] mb-4"
          >
            400K+
          </div>
          <div class="text-xl text-gray-700">Claims Processed</div>
          <div class="text-sm text-gray-500 mt-2">1994-2002</div>
        </div>
        <div class="text-center" data-aos="fade-up" data-aos-delay="200">
          <div
            class="text-6xl md:text-7xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-[#FFA500] mb-4"
          >
            $400M+
          </div>
          <div class="text-xl text-gray-700">Total Savings</div>
          <div class="text-sm text-gray-500 mt-2">Verified Results</div>
        </div>
        <div class="text-center" data-aos="fade-up" data-aos-delay="300">
          <div
            class="text-6xl md:text-7xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-[#FFA500] mb-4"
          >
            1,200+
          </div>
          <div class="text-xl text-gray-700">Centers Built</div>
          <div class="text-sm text-gray-500 mt-2">Nationwide Network</div>
        </div>
        <div class="text-center" data-aos="fade-up" data-aos-delay="400">
          <div
            class="text-6xl md:text-7xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] to-[#FFA500] mb-4"
          >
            2002
          </div>
          <div class="text-xl text-gray-700">NYSE Exit</div>
          <div class="text-sm text-gray-500 mt-2">CorVel Corp</div>
        </div>
      </div>

      <!-- Success Story -->
      <div class="max-w-4xl mx-auto">
        <div
          class="bg-gradient-to-br from-gray-50 to-white rounded-3xl p-12 shadow-xl border border-gray-100"
          data-aos="fade-up"
        >
          <div class="text-6xl text-[#cc9933] opacity-20 mb-6">"</div>
          <blockquote
            class="text-2xl text-gray-700 italic mb-8 leading-relaxed"
          >
            We didn't just reduce imaging costs—we transformed the entire
            experience. Faster appointments meant faster return-to-work.
            Predictable pricing meant budget certainty. That's why our model
            achieved a successful exit and is still operating 20+ years later.
          </blockquote>
          <div class="text-gray-600">— The USRad Founding Team</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Help Section -->
  <section class="py-32 bg-gradient-to-br from-[#fcf9f0] to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-[#003087] mb-8"
        >
          Transform Your Imaging Benefits
        </h2>
        <p class="text-2xl text-gray-600 max-w-3xl mx-auto">
          The same proven approach, now modernized with AI and digital
          innovation
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10">
        <!-- Benefit 1 -->
        <div class="group" data-aos="fade-up" data-aos-delay="100">
          <div
            class="bg-white rounded-2xl p-8 h-full shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2"
          >
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#cc9933] to-[#FFA500] rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-4">50%+ Savings</h3>
            <p class="text-gray-600 mb-6">
              Replace inflated hospital charges with transparent, Medicare-based
              pricing
            </p>
            <div class="text-sm text-[#cc9933] font-semibold">
              Proven: $400M+ saved
            </div>
          </div>
        </div>

        <!-- Benefit 2 -->
        <div class="group" data-aos="fade-up" data-aos-delay="200">
          <div
            class="bg-white rounded-2xl p-8 h-full shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2"
          >
            <div
              class="w-20 h-20 bg-gradient-to-br from-[#4A90E2] to-[#00CED1] rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-4">
              48-Hour Access
            </h3>
            <p class="text-gray-600 mb-6">
              Digital scheduling ensures appointments within 2 days vs. 2 weeks
            </p>
            <div class="text-sm text-[#4A90E2] font-semibold">
              400K+ served successfully
            </div>
          </div>
        </div>

        <!-- Benefit 3 -->
        <div class="group" data-aos="fade-up" data-aos-delay="300">
          <div
            class="bg-white rounded-2xl p-8 h-full shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2"
          >
            <div
              class="w-20 h-20 bg-gradient-to-br from-green-500 to-green-400 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-4">
              Zero Friction
            </h3>
            <p class="text-gray-600 mb-6">
              No surprise bills, no denials, no member complaints
            </p>
            <div class="text-sm text-green-500 font-semibold">
              100% satisfaction rate
            </div>
          </div>
        </div>

        <!-- Benefit 4 -->
        <div class="group" data-aos="fade-up" data-aos-delay="400">
          <div
            class="bg-white rounded-2xl p-8 h-full shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-2"
          >
            <div
              class="w-20 h-20 bg-gradient-to-br from-purple-500 to-purple-400 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#003087] mb-4">Instant ROI</h3>
            <p class="text-gray-600 mb-6">
              Real-time dashboards show savings on every single scan
            </p>
            <div class="text-sm text-purple-500 font-semibold">
              NYSE-validated model
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Types Section -->
  <section class="py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-[#003087] mb-8"
        >
          Who We Serve
        </h2>
        <p class="text-2xl text-gray-600 max-w-3xl mx-auto">
          From Fortune 500 to growing companies, we're transforming imaging
          benefits
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-12">
        <!-- Self-Funded -->
        <div class="group relative" data-aos="fade-up" data-aos-delay="100">
          <div
            class="absolute inset-0 bg-gradient-to-r from-[#003087] to-[#0052cc] rounded-3xl blur-xl opacity-0 group-hover:opacity-30 transition-all duration-500"
          >
          </div>
          <div
            class="relative bg-white rounded-3xl p-10 shadow-xl hover:shadow-2xl transition-all border border-gray-100"
          >
            <div
              class="w-24 h-24 bg-gradient-to-br from-[#003087] to-[#0052cc] rounded-2xl flex items-center justify-center mb-8 mx-auto"
            >
              <svg
                class="w-12 h-12 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"
                ></path>
              </svg>
            </div>
            <h3 class="text-3xl font-bold text-[#003087] mb-6 text-center">
              Self-Funded Employers
            </h3>
            <p class="text-gray-600 text-lg text-center mb-8">
              Cut imaging costs by 50%+ while improving employee satisfaction.
              No contracts, no minimums.
            </p>
            <div class="text-center">
              <span class="text-[#003087] font-bold text-lg"
                >500+ companies</span
              >
            </div>
          </div>
        </div>

        <!-- TPAs -->
        <div class="group relative" data-aos="fade-up" data-aos-delay="200">
          <div
            class="absolute inset-0 bg-gradient-to-r from-[#cc9933] to-[#FFA500] rounded-3xl blur-xl opacity-0 group-hover:opacity-30 transition-all duration-500"
          >
          </div>
          <div
            class="relative bg-white rounded-3xl p-10 shadow-xl hover:shadow-2xl transition-all border border-gray-100"
          >
            <div
              class="w-24 h-24 bg-gradient-to-br from-[#cc9933] to-[#FFA500] rounded-2xl flex items-center justify-center mb-8 mx-auto"
            >
              <svg
                class="w-12 h-12 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-3xl font-bold text-[#003087] mb-6 text-center">
              Third-Party Administrators
            </h3>
            <p class="text-gray-600 text-lg text-center mb-8">
              White-label our network and technology. Add value for your clients
              instantly.
            </p>
            <div class="text-center">
              <span class="text-[#cc9933] font-bold text-lg"
                >API-ready platform</span
              >
            </div>
          </div>
        </div>

        <!-- Digital Health -->
        <div class="group relative" data-aos="fade-up" data-aos-delay="300">
          <div
            class="absolute inset-0 bg-gradient-to-r from-purple-500 to-purple-400 rounded-3xl blur-xl opacity-0 group-hover:opacity-30 transition-all duration-500"
          >
          </div>
          <div
            class="relative bg-white rounded-3xl p-10 shadow-xl hover:shadow-2xl transition-all border border-gray-100"
          >
            <div
              class="w-24 h-24 bg-gradient-to-br from-purple-500 to-purple-400 rounded-2xl flex items-center justify-center mb-8 mx-auto"
            >
              <svg
                class="w-12 h-12 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-3xl font-bold text-[#003087] mb-6 text-center">
              Digital Health Platforms
            </h3>
            <p class="text-gray-600 text-lg text-center mb-8">
              Embed transparent imaging into your care navigation experience
              seamlessly.
            </p>
            <div class="text-center">
              <span class="text-purple-500 font-bold text-lg"
                >Revenue share available</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality Section -->
  <section class="py-32 bg-gradient-to-br from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20">
        <h2
          class="text-5xl md:text-6xl lg:text-7xl font-bold text-[#003087] mb-8"
        >
          Quality Without Compromise
        </h2>
        <p class="text-2xl text-gray-600 max-w-3xl mx-auto">
          The same rigorous standards that earned us a NYSE-listed acquisition
        </p>
      </div>

      <div class="max-w-5xl mx-auto">
        <div
          class="bg-gradient-to-r from-[#003087] to-[#0052cc] rounded-3xl p-16 text-white text-center shadow-2xl"
          data-aos="zoom-in"
        >
          <h3 class="text-4xl font-bold mb-12">Our Unwavering Standards</h3>

          <div class="grid md:grid-cols-3 gap-12">
            <div>
              <div class="text-6xl font-bold text-[#cc9933] mb-4">100%</div>
              <div class="text-xl">ACR Accredited</div>
              <div class="text-sm opacity-80 mt-2">
                Board-certified radiologists
              </div>
            </div>
            <div>
              <div class="text-6xl font-bold text-[#cc9933] mb-4">48hr</div>
              <div class="text-xl">Report Turnaround</div>
              <div class="text-sm opacity-80 mt-2">Guaranteed results</div>
            </div>
            <div>
              <div class="text-6xl font-bold text-[#cc9933] mb-4">99.7%</div>
              <div class="text-xl">Satisfaction Rate</div>
              <div class="text-sm opacity-80 mt-2">Member experience</div>
            </div>
          </div>

          <div class="mt-12 pt-12 border-t border-white/20">
            <p class="text-xl opacity-90">
              "Quality isn't just a standard—it's our foundation. That's why our
              model is still operating successfully 20+ years later."
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section
    class="py-32 bg-gradient-to-br from-[#0a0e27] via-[#0f1629] to-[#003087] text-white"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-8">
        Ready to Transform Your<br />
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc9933] via-[#FFA500] to-[#cc9933] animate-gradient"
        >
          Imaging Benefits?
        </span>
      </h2>

      <p class="text-2xl mb-12 text-gray-300 max-w-3xl mx-auto">
        Join the employers already saving millions while delivering a better
        member experience.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center mb-16">
        <a
          href="/employer/schedule"
          class="group relative bg-gradient-to-r from-[#cc9933] to-[#FFA500] text-[#003087] px-12 py-6 rounded-xl font-bold text-xl hover:shadow-2xl hover:shadow-[#cc9933]/25 transition-all transform hover:scale-105 overflow-hidden"
        >
          <span class="relative z-10">Schedule a Strategy Call →</span>
          <div
            class="absolute inset-0 bg-white opacity-0 group-hover:opacity-20 transition-opacity"
          >
          </div>
        </a>
        <a
          href="/employer/roi-calculator"
          class="border-2 border-white/30 text-white px-12 py-6 rounded-xl font-bold text-xl hover:bg-white/10 hover:border-white/50 transition-all"
        >
          Calculate Your Savings
        </a>
      </div>

      <!-- Contact Options -->
      <div class="grid md:grid-cols-3 gap-8 max-w-3xl mx-auto">
        <div
          class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20"
        >
          <svg
            class="w-10 h-10 text-[#cc9933] mx-auto mb-4"
