---
import MainLayout from "../layouts/MainLayout.astro";
import HealthcareCoverageCrisisGraph from "../components/HealthcareCoverageCrisisGraph.jsx";
import AOSInit from "../components/AOSInit.astro";
---

<MainLayout>
  <AOSInit />

  <!-- Enhanced Hero Section with Provider-Focused Messaging -->
  <section
    class="relative w-full min-h-[700px] bg-[#fcf9f0] overflow-hidden mt-0 pt-0"
  >
    <!-- Background Image -->
    <img
      src="/images/managed-care-hero.webp"
      alt="Healthcare coordinator helping patient with imaging scheduling - true managed care approach"
      class="absolute inset-0 w-full h-full object-cover object-center md:object-left"
      loading="eager"
    />

    <!-- Enhanced Gradient Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#fcf9f0]/95 via-white/90 to-[#003087]/10 z-0"
    >
    </div>

    <!-- Credibility Banner for Providers -->
    <div
      class="absolute top-0 left-0 right-0 bg-gradient-to-r from-[#cc9933] to-[#003087] text-white py-2 px-4 text-center z-20"
    >
      <p class="text-sm font-medium">
        🏆 <strong>PROVEN MANAGED CARE PIONEERS:</strong> Built the first imaging
        carve-out (1994-2002) • 1,200+ centers recruited • $240M+ in volume delivered
        • Successful healthcare exit
      </p>
    </div>

    <!-- Enhanced Content Wrapper -->
    <div
      class="relative z-10 max-w-7xl mx-auto px-6 sm:px-12 py-24 md:py-32 flex flex-col md:flex-row items-center md:items-start mt-8"
    >
      <div class="w-full md:w-1/2 text-center md:text-left">
        <!-- Provider-Focused Credibility Badge -->
        <div class="mb-6" data-aos="fade-up" data-aos-delay="50">
          <span
            class="inline-flex items-center gap-2 px-6 py-3 bg-white/95 backdrop-blur-sm rounded-full shadow-lg border border-[#cc9933]/30"
          >
            <svg
              class="w-5 h-5 text-[#cc9933]"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="text-[#003087] font-bold text-sm"
              >TRUE MANAGED CARE • NOT A BOOKING PLATFORM</span
            >
          </span>
        </div>

        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-[#003087] mb-6 leading-tight"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          The <span class="text-[#cc9933]">Real</span> Managed Care Model
        </h1>

        <!-- Enhanced Rotating Text Block for Providers -->
        <div
          class="text-2xl sm:text-3xl font-bold mb-6 flex justify-center md:justify-start items-center gap-2 tracking-tight"
          data-aos="fade-up"
          data-aos-delay="150"
        >
          <span>Built for</span>
          <span class="relative h-[40px] w-[14ch] overflow-hidden inline-block">
            <span
              id="rotating-container"
              class="absolute top-0 left-0 font-extrabold text-[#cc9933]"
            >
              <span class="block text-left h-[40px] leading-[40px]"
                >Imaging Centers</span
              >
              <span class="block text-left h-[40px] leading-[40px]"
                >Self-Pay Patients</span
              >
              <span class="block text-left h-[40px] leading-[40px]"
                >Volume Growth</span
              >
            </span>
          </span>
        </div>

        <p
          class="text-lg sm:text-xl text-[#003087] mb-6 max-w-xl"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          USRad operates as a <strong>true managed care organization</strong> focused
          on diagnostic imaging— not a booking platform or referral marketplace.
          We handle everything from patient acquisition to payment processing, using
          the same proven approach that delivered exceptional results.
        </p>

        <p
          class="text-lg text-[#003087]/80 mb-8 max-w-xl"
          data-aos="fade-up"
          data-aos-delay="250"
        >
          The same proven approach that recruited 1,200+ centers and delivered
          $240M+ in volume, now expanded to serve the 90 million uninsured and
          underinsured Americans.
        </p>

        <!-- Enhanced Success Metrics for Providers -->
        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-2xl mx-auto md:mx-0 mb-8"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div
            class="bg-white/90 backdrop-blur-sm rounded-xl p-3 shadow-lg text-center"
          >
            <div class="text-xl font-bold text-[#cc9933]">1,200+</div>
            <div class="text-xs text-[#003087] font-medium">
              Centers Recruited
            </div>
            <div class="text-xs text-blue-600">Proven Track Record</div>
          </div>
          <div
            class="bg-white/90 backdrop-blur-sm rounded-xl p-3 shadow-lg text-center"
          >
            <div class="text-xl font-bold text-[#cc9933]">$240M+</div>
            <div class="text-xs text-[#003087] font-medium">
              Volume Delivered
            </div>
            <div class="text-xs text-green-600">Verified Results</div>
          </div>
          <div
            class="bg-white/90 backdrop-blur-sm rounded-xl p-3 shadow-lg text-center"
          >
            <div class="text-xl font-bold text-[#cc9933]">90M+</div>
            <div class="text-xs text-[#003087] font-medium">
              Target Patients
            </div>
            <div class="text-xs text-purple-600">Market Opportunity</div>
          </div>
          <div
            class="bg-white/90 backdrop-blur-sm rounded-xl p-3 shadow-lg text-center"
          >
            <div class="text-xl font-bold text-[#cc9933]">2002</div>
            <div class="text-xs text-[#003087] font-medium">
              Successful Exit
            </div>
            <div class="text-xs text-orange-600">NYSE-Listed</div>
          </div>
        </div>

        <!-- Provider-Focused CTAs -->
        <div
          class="flex flex-col sm:flex-row justify-center md:justify-start gap-3 sm:gap-4"
          data-aos="fade-up"
          data-aos-delay="400"
        >
          <a
            href="/imaging-center"
            class="bg-[#cc9933] hover:bg-[#b8862e] text-[#003087] px-6 sm:px-8 py-4 rounded-xl font-semibold transition-all text-center text-base sm:text-lg min-h-[48px] flex items-center justify-center shadow-lg transform hover:scale-105"
          >
            🏥 Join Our Provider Network
          </a>
          <a
            href="#proven-model"
            class="border-2 border-[#003087] text-[#003087] hover:bg-[#003087] hover:text-white px-6 sm:px-8 py-4 rounded-xl font-semibold transition-all text-center text-base sm:text-lg min-h-[48px] flex items-center justify-center"
          >
            📊 See Our Proven Model
          </a>
        </div>

        <div
          class="mt-4 text-sm text-[#003087]/70"
          data-aos="fade-up"
          data-aos-delay="450"
        >
          The same team that built the managed care imaging industry
        </div>
      </div>
    </div>

    <!-- Rotating Text Script -->
    <script>
      const container = document.getElementById("rotating-container");
      const wordHeight = 40;
      let index = 0;

      setInterval(() => {
        index++;
        container.style.transition = "transform 0.2s ease-in-out";
        container.style.transform = `translateY(-${index * wordHeight}px)`;

        if (index === 2) {
          setTimeout(() => {
            container.style.transition = "none";
            container.style.transform = "translateY(0)";
            index = 0;
          }, 600);
        }
      }, 3000);
    </script>
  </section>

  <!-- NEW: True Managed Care vs Booking Platform Section -->
  <section
    class="py-20 bg-white text-[#003087] px-6 sm:px-12"
    data-aos="fade-up"
  >
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold mb-4">
          Why Imaging Centers Choose True Managed Care
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          The difference between USRad's managed care model and typical booking
          platforms is night and day for provider partners.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Booking Platforms -->
        <div
          class="bg-red-50 border border-red-200 p-8 rounded-xl shadow-lg"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <div class="flex items-center mb-6">
            <div
              class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mr-4"
            >
              <svg
                class="w-6 h-6 text-red-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-red-700">
              Typical Booking Platforms
            </h3>
          </div>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <span class="text-red-500 font-bold">×</span>
              <p class="text-gray-700">
                <strong>Just a marketplace:</strong> Connect patients to centers,
                then you handle everything else
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-red-500 font-bold">×</span>
              <p class="text-gray-700">
                <strong>Complex billing:</strong> You still deal with insurance,
                collections, and payment delays
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-red-500 font-bold">×</span>
              <p class="text-gray-700">
                <strong>No patient management:</strong> Limited screening, qualification,
                or support
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-red-500 font-bold">×</span>
              <p class="text-gray-700">
                <strong>Fee-for-service:</strong> Pay per lead or percentage of revenue
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-red-500 font-bold">×</span>
              <p class="text-gray-700">
                <strong>No guarantee:</strong> Patients may not show up or pay
              </p>
            </div>
          </div>
        </div>

        <!-- USRad Managed Care -->
        <div
          class="bg-green-50 border border-green-200 p-8 rounded-xl shadow-lg"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div class="flex items-center mb-6">
            <div
              class="w-12 h-12 bg-[#cc9933]/20 rounded-full flex items-center justify-center mr-4"
            >
              <svg
                class="w-6 h-6 text-[#cc9933]"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[#003087]">
              USRad True Managed Care
            </h3>
          </div>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <span class="text-green-600 font-bold">✓</span>
              <p class="text-gray-700">
                <strong>Full-service organization:</strong> We handle patient acquisition,
                scheduling, screening, and payment processing
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-green-600 font-bold">✓</span>
              <p class="text-gray-700">
                <strong>Zero billing complexity:</strong> Simple flat-rate payments,
                no insurance hassles, 15-day payment guarantee
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-green-600 font-bold">✓</span>
              <p class="text-gray-700">
                <strong>Complete patient management:</strong> Pre-qualified, pre-paid
                patients with full care navigation support
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-green-600 font-bold">✓</span>
              <p class="text-gray-700">
                <strong>Partnership model:</strong> Contracted rates, volume commitments,
                shared success
              </p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-green-600 font-bold">✓</span>
              <p class="text-gray-700">
                <strong>Performance guarantee:</strong> 96% show-up rate, 100% payment
                collection
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Credibility Proof -->
      <div
        class="mt-12 bg-gradient-to-r from-blue-50 to-green-50 rounded-xl p-8"
        data-aos="fade-up"
        data-aos-delay="300"
      >
        <div class="text-center">
          <h3 class="text-2xl font-bold text-[#003087] mb-4">
            The Industry Pioneer Proof
          </h3>
          <p class="text-lg text-gray-700 mb-6">
            We didn't just create managed care imaging—we perfected it through
            AnciCare (1994-2002). The model was so successful that CorVel
            Corporation (NYSE: CVL) acquired us and
            <strong>still operates our approach 20+ years later</strong>.
          </p>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-white rounded-lg p-4">
              <div class="text-2xl font-bold text-blue-600">1,200+</div>
              <div class="text-sm text-gray-600">
                Centers Successfully Recruited
              </div>
            </div>
            <div class="bg-white rounded-lg p-4">
              <div class="text-2xl font-bold text-green-600">$240 Million+</div>
              <div class="text-sm text-gray-600">
                Volume Delivered to Partners
              </div>
            </div>
            <div class="bg-white rounded-lg p-4">
              <div class="text-2xl font-bold text-purple-600">20+ Years</div>
              <div class="text-sm text-gray-600">Model Still Operating</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Enhanced Proven Model Section -->
  <section
    id="proven-model"
    class="py-20 bg-gradient-to-br from-[#003087] to-[#0052cc] text-white px-6 sm:px-12"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          The Proven Managed Care Model That Works
        </h2>
        <p class="text-xl text-blue-100 max-w-4xl mx-auto">
          We built the first managed care imaging carve-out through our previous
          venture (1994-2002). Here's how we delivered $240 Million+ in value to
          imaging center partners like you:
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
        <!-- Model Components -->
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold"
            >
              1
            </div>
            <div>
              <h3 class="text-xl font-semibold text-[#cc9933] mb-2">
                Patient Acquisition & Screening
              </h3>
              <p class="text-blue-100">
                We identify, acquire, and pre-qualify self-pay patients who need
                imaging services. No time wasted on unqualified leads.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold"
            >
              2
            </div>
            <div>
              <h3 class="text-xl font-semibold text-[#cc9933] mb-2">
                Care Navigation & Scheduling
              </h3>
              <p class="text-blue-100">
                Complete patient support from consultation to appointment
                scheduling. We handle all patient communication and
                coordination.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold"
            >
              3
            </div>
            <div>
              <h3 class="text-xl font-semibold text-[#cc9933] mb-2">
                Payment Processing & Guarantee
              </h3>
              <p class="text-blue-100">
                Flat-rate pricing, pre-payment collection, and guaranteed
                reimbursement within 15 days. Zero billing complexity for you.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-[#cc9933] rounded-full flex items-center justify-center flex-shrink-0 text-white font-bold"
            >
              4
            </div>
            <div>
              <h3 class="text-xl font-semibold text-[#cc9933] mb-2">
                Quality Assurance & Support
              </h3>
              <p class="text-blue-100">
                Ongoing partnership management, quality monitoring, and
                continuous optimization to maximize your success.
              </p>
            </div>
          </div>
        </div>

        <!-- Results Box -->
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8">
          <h3 class="text-2xl font-bold text-center mb-6">
            Proven Results (1994-2002)
          </h3>
          <div class="grid grid-cols-2 gap-6">
            <div class="text-center">
              <div class="text-3xl font-bold text-[#cc9933]">1,200+</div>
              <div class="text-sm text-blue-100">Imaging Centers</div>
              <div class="text-xs text-blue-200">Successfully Partnered</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-[#cc9933]">400,000+</div>
              <div class="text-sm text-blue-100">Patients</div>
              <div class="text-xs text-blue-200">Successfully Served</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-[#cc9933]">$240M+</div>
              <div class="text-sm text-blue-100">Total Volume</div>
              <div class="text-xs text-blue-200">Delivered to Partners</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-[#cc9933]">96%+</div>
              <div class="text-sm text-blue-100">Show Rate</div>
              <div class="text-xs text-blue-200">Patient Reliability</div>
            </div>
          </div>

          <div class="mt-6 p-4 bg-[#cc9933]/20 rounded-lg text-center">
            <div class="text-lg font-bold text-[#cc9933]">
              NYSE-Listed Acquisition
            </div>
            <div class="text-sm text-blue-100">
              Model validated and still operating 20+ years later
            </div>
          </div>
        </div>
      </div>

      <!-- Provider Value Proposition -->
      <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 text-center">
        <h3 class="text-2xl font-bold mb-6">
          What This Means for Your Imaging Center
        </h3>
        <div class="grid md:grid-cols-4 gap-6">
          <div class="bg-white/10 rounded-lg p-4">
            <div class="text-2xl font-bold text-[#cc9933] mb-2">20-40%</div>
            <div class="text-sm text-blue-100">Volume Increase</div>
            <div class="text-xs text-blue-200">Typical Partner Experience</div>
          </div>
          <div class="bg-white/10 rounded-lg p-4">
            <div class="text-2xl font-bold text-[#cc9933] mb-2">100%</div>
            <div class="text-sm text-blue-100">Payment Collection</div>
            <div class="text-xs text-blue-200">Guaranteed Performance</div>
          </div>
          <div class="bg-white/10 rounded-lg p-4">
            <div class="text-2xl font-bold text-[#cc9933] mb-2">15 Days</div>
            <div class="text-sm text-blue-100">Payment Timeline</div>
            <div class="text-xs text-blue-200">Guaranteed Reimbursement</div>
          </div>
          <div class="bg-white/10 rounded-lg p-4">
            <div class="text-2xl font-bold text-[#cc9933] mb-2">Zero</div>
            <div class="text-sm text-blue-100">Billing Hassles</div>
            <div class="text-xs text-blue-200">Complete Simplification</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Enhanced Market Opportunity Section -->
  <section
    class="py-20 bg-[#fcf9f0] text-[#003087] px-6 sm:px-12 text-center"
    data-aos="fade-up"
  >
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold mb-6">
        The 90 Million Patient Opportunity
      </h2>
      <p class="max-w-3xl mx-auto mb-10 text-lg">
        The same managed care model that served workers' compensation patients
        through our previous venture now addresses a much larger market: 90+
        million uninsured and underinsured Americans who need direct-pay imaging
        solutions.
      </p>
      <div class="max-w-5xl mx-auto">
        <HealthcareCoverageCrisisGraph client:visible />
      </div>

      <!-- Market Size Impact for Providers -->
      <div class="mt-12 grid md:grid-cols-3 gap-8">
        <div
          class="bg-white rounded-xl p-6 shadow-lg border-t-4 border-[#cc9933]"
        >
          <h3 class="text-xl font-bold mb-3">Available Market</h3>
          <div class="text-3xl font-bold text-[#cc9933] mb-2">90 Million+</div>
          <p class="text-gray-600">
            Uninsured & underinsured Americans needing direct-pay imaging
            options
          </p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-lg border-t-4 border-[#003087]"
        >
          <h3 class="text-xl font-bold mb-3">Current Utilization</h3>
          <div class="text-3xl font-bold text-[#003087] mb-2">35%</div>
          <p class="text-gray-600">
            Average imaging center appointment slot utilization rate
          </p>
        </div>
        <div
          class="bg-white rounded-xl p-6 shadow-lg border-t-4 border-[#cc9933]"
        >
          <h3 class="text-xl font-bold mb-3">Revenue Opportunity</h3>
          <div class="text-3xl font-bold text-[#cc9933] mb-2">$2.8B</div>
          <p class="text-gray-600">
            Addressable market for managed care imaging services
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Enhanced Platform Overview -->
  <section
    class="py-16 sm:py-20 bg-white text-[#003087] px-4 sm:px-6 lg:px-12"
    data-aos="fade-up"
  >
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          How USRad Delivers Volume to Your Center
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Our comprehensive managed care platform handles every aspect of
          patient acquisition and management, delivering qualified, pre-paid
          patients directly to your schedule.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        <!-- Platform Component 1 -->
        <div
          class="text-center bg-gradient-to-br from-blue-50 to-blue-100 p-6 sm:p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow"
          data-aos="zoom-in"
          data-aos-delay="100"
        >
          <div
            class="w-16 h-16 bg-[#003087] rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
