---
import MainPatientLayout from "../layouts/MainPatientLayout.astro";
import ChatbotToggle from "../components/ChatbotToggle.astro";
import FadeIn from "../components/FadeIn.astro";
import AOSInit from "../components/AOSInit.astro";
import ProviderSearchSection from "../components/ProviderSearchSection.jsx";
import TrustBadgesBar from "../components/TrustBadgesBar.astro";

const pageTitle =
  "The Evolution of Healthcare Savings - $400M+ Proven Model Now Digital | USRad";
const pageDescription =
  "The same pricing model that delivered $400M+ in savings, validated by professional financial review, now evolved with digital capabilities. Get transparent MRI, CT, and ultrasound pricing 30-70% below hospitals.";
const canonicalURL = Astro.site
  ? new URL("/pricing", Astro.site).toString()
  : "/pricing";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: "USRad",
  description: pageDescription,
  url:
    typeof canonicalURL === "string" ? canonicalURL : canonicalURL.toString(),
  logo: "/images/usrad-logo.png",
  priceRange: "$85-$325",
  medicalSpecialty: "Diagnostic Radiology",
};
---

<MainPatientLayout
  showPatientHeader={true}
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  structuredData={structuredData}
>
  <AOSInit />

  <!-- EVOLUTION BANNER -->
  <section
    class="bg-gradient-to-r from-[#003087] to-blue-700 text-white py-4 px-6"
  >
    <div class="max-w-7xl mx-auto">
      <div
        class="flex flex-col md:flex-row items-center justify-center gap-4 text-center md:text-left"
      >
        <div class="flex items-center gap-2">
          <svg
            class="w-5 h-5 text-[#cc9933]"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="font-bold">ECONOMIC EVOLUTION:</span>
        </div>
        <span class="text-sm font-medium">
          Proven Foundation (400K patients) → Digital Evolution (Real-time
          pricing) → Expanded Mission (90M Americans)
        </span>
      </div>
    </div>
  </section>

  <!-- HERO SECTION - EVOLUTION FOCUSED -->
  <FadeIn effect="fade" delay={0}>
    <section
      class="relative bg-gradient-to-br from-[#fefbf5] to-[#f8f5e8] py-24 px-6"
    >
      <div class="max-w-7xl mx-auto">
        <!-- Evolution Header -->
        <div class="text-center mb-12" data-aos="fade-up">
          <div
            class="inline-flex items-center gap-2 bg-[#cc9933] text-white px-6 py-3 rounded-full text-sm font-bold mb-6"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            FOUNDATION → EVOLUTION → MISSION
          </div>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6 text-[#003087]"
          >
            The Evolution of Healthcare Savings
            <span class="text-[#cc9933] block mt-2"
              >$400M+ Proven Model, Now Digital</span
            >
          </h1>

          <p
            class="text-lg sm:text-xl text-[#003087]/80 max-w-4xl mx-auto leading-relaxed mb-8"
          >
            The same transparent pricing model that delivered <strong
              class="text-[#cc9933]">$400 Million+ in savings</strong
            >
            through independently audited operations—now evolved with real-time market
            dynamics to serve everyone.
          </p>
        </div>

        <!-- Evolution Metrics -->
        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 mb-16"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div
            class="bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 border-[#cc9933] hover:shadow-xl transition-shadow"
          >
            <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
              $400M+
            </div>
            <div class="text-sm md:text-base text-[#003087] font-medium">
              Foundation Era Savings
            </div>
            <div class="text-xs text-[#003087]/60 mt-1">
              Professionally validated
            </div>
          </div>
          <div
            class="bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 border-[#cc9933] hover:shadow-xl transition-shadow"
          >
            <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
              1,500+
            </div>
            <div class="text-sm md:text-base text-[#003087] font-medium">
              Evolution Era Centers
            </div>
            <div class="text-xs text-[#003087]/60 mt-1">Market dynamics</div>
          </div>
          <div
            class="bg-white rounded-2xl p-6 shadow-lg text-center border-t-4 border-[#cc9933] hover:shadow-xl transition-shadow"
          >
            <div class="text-3xl md:text-4xl font-bold text-[#cc9933] mb-2">
              90M
            </div>
            <div class="text-sm md:text-base text-[#003087] font-medium">
              Mission Era Target
            </div>
            <div class="text-xs text-[#003087]/60 mt-1">Americans to serve</div>
          </div>
          <div
