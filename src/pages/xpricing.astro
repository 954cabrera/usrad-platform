              24/7
            </div>
            <div class="text-sm md:text-base text-[#003087] font-medium">
              Digital Access
            </div>
            <div class="text-xs text-[#003087]/60 mt-1">Evolution benefit</div>
          </div>
        </div>

        <!-- Economic Evolution Story -->
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Text Content -->
