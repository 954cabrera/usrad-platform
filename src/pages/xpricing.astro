            </ul>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#cc9933] mb-4">
              Enhanced with Evolution
            </h3>
            <ul class="space-y-3">
              <li class="flex items-start">
                <span class="text-[#cc9933] mr-2">⚡</span>
