              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </FadeIn>

  <!-- ECONOMIC EVOLUTION SECTION - NEW -->
  <section class="bg-white py-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl md:text-4xl font-bold text-[#003087] mb-4">
          The Evolution of Healthcare Economics
        </h2>
        <p class="text-lg text-[#003087]/80 max-w-3xl mx-auto">
          How we transformed our proven pricing model for the digital age
