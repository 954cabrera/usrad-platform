                  <div>
                    <div class="font-bold text-[#003087]">
                      Foundation (1994-2002)
                    </div>
                    <div class="text-sm text-[#003087]/70">
                      Created transparent pricing model
                    </div>
                  </div>
                </div>
                <div class="flex items-center">
                  <div
                    class="w-12 h-12 bg-[#003087] rounded-full flex items-center justify-center text-white font-bold mr-4"
